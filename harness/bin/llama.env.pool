# laguna-bench STANDARD single-GPU pooling config (2026-10-16): Laguna S Q5_K_M + DFlash n4 on Poolside fork, 4 slots, unified 440k KV pool (96.3/97.9 GB), slot similarity 0.85. Pair with shim SHIM_SERIAL=1 (one request upstream at a time). Copy to gpu:/opt/bench/llama.env and restart tmux "llama".
GGUF=/opt/dlami/nvme/gguf/Laguna-S-2.1-Q5_K_M/Laguna-S-2.1-Q5_K_M-00001-of-00003.gguf
SERVED_NAME=laguna-s-2.1-q5km
CTX=440000
NP=4
EXTRA='-md /opt/dlami/nvme/gguf/laguna-s-2.1-DFlash-BF16.gguf -ngld 999 --spec-type draft-dflash --spec-draft-n-max 4 --spec-draft-override-tensor .*=CUDA0 --cache-ram 65536 --kv-unified --slot-prompt-similarity 0.85'
LLAMA_BIN=/opt/dlami/nvme/src/llama.cpp-poolside/build/bin/llama-server
