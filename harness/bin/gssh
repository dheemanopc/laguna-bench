#!/usr/bin/env bash
# gssh — ssh to the GPU instance via the shared multiplexed connection, retrying with backoff (hotspot drops)
for d in 0 5 15 30 60; do sleep $d; ssh -F $HOME/laguna-bench/ssh_config gpu "$@"; rc=$?; [ $rc -ne 255 ] && exit $rc; $HOME/laguna-bench/bin/ip_guard.sh >/dev/null 2>&1; done; exit 255
