#!/bin/bash
# laguna-bench — llama.cpp server for GGUF models on the single-GPU spot box (same port contract as vLLM: 127.0.0.1:8000).
# Env (from /opt/bench/llama.env): GGUF (first shard path), SERVED_NAME, CTX (total), NP (slots), EXTRA (e.g. --n-cpu-moe N)
set -f   # EXTRA may hold regex patterns (e.g. .*=CUDA0) — no glob expansion
. /opt/bench/llama.env
exec ${LLAMA_BIN:-/opt/dlami/nvme/src/llama.cpp/build/bin/llama-server} -m "$GGUF" --alias "$SERVED_NAME" --host 127.0.0.1 --port 8000 \
  -ngl 999 -c "$CTX" -np "$NP" -fa on -ctk q8_0 -ctv q8_0 --jinja --temp 1.0 --top-k 20 --cache-reuse 256 --metrics $EXTRA
