[Unit]
Description=laguna-bench vLLM server, second replica (GPU1, :8001)
After=network-online.target
[Service]
User=ubuntu
Environment=VLLM_ENV=/opt/bench/vllm2.env
ExecStart=/opt/bench/serve.sh
StandardOutput=append:/opt/bench/vllm2.log
StandardError=append:/opt/bench/vllm2.log
Restart=on-failure
RestartSec=20
