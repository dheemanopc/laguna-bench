diff --git a/src/mem_mcp/memory/versioning.py b/src/mem_mcp/memory/versioning.py
index 0695098..1df9bf2 100644
--- a/src/mem_mcp/memory/versioning.py
+++ b/src/mem_mcp/memory/versioning.py
@@ -6,7 +6,20 @@ exists so other modules can import the constants/types they'll need.
 
 from __future__ import annotations
 
+from datetime import datetime
 from typing import Final
 
 VERSIONED_TYPES: Final[frozenset[str]] = frozenset({"decision", "fact"})
 NON_VERSIONED_TYPES: Final[frozenset[str]] = frozenset({"note", "snippet", "question"})
+
+
+def revision_token(updated_at: datetime | None) -> str | None:
+    """Opaque optimistic-concurrency token for one memory row.
+
+    Derived from ``memories.updated_at`` (microsecond precision), which every
+    mutating path bumps. Callers must treat it as opaque and only compare it for
+    equality; memory_update(expected_revision=...) rejects a stale token.
+    """
+    if updated_at is None:
+        return None
+    return updated_at.isoformat()
