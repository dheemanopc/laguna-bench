+class TestMindmapResolveInputValidation:
+    """Input validation for MindmapResolveInput."""
+
+    def test_summary_required(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(
+                map_key="test-map",
+                node_id=uuid4(),
+                resolution_summary="",  # empty string fails min_length=1
+            )
+
+    def test_summary_max_500(self) -> None:
+        MindmapResolveInput(
+            map_key="test-map",
+            node_id=uuid4(),
+            resolution_summary="x" * 500,
+        )
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(
+                map_key="test-map",
+                node_id=uuid4(),
+                resolution_summary="x" * 501,
+            )
+
+    def test_disposition_default(self) -> None:
+        inp = MindmapResolveInput(
+            map_key="test-map",
+            node_id=uuid4(),
+            resolution_summary="resolved",
+        )
+        assert inp.disposition == "resolved"
+
+    def test_disposition_dropped(self) -> None:
