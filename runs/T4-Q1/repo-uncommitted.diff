+class TestTruncation:
+    """Truncation logic for summary depth."""
+
+    def test_exact_200_chars_no_truncation(self) -> None:
+        content = "x" * SUMMARY_CONTENT_CHARS
+        result, truncated = _truncate_content(content, "summary")
+        assert result == content
+        assert truncated is False
+
+    def test_201_chars_truncated(self) -> None:
+        content = "x" * (SUMMARY_CONTENT_CHARS + 1)
+        result, truncated = _truncate_content(content, "summary")
+        assert len(result) == SUMMARY_CONTENT_CHARS + 1  # 200 chars + "…"
+        assert result == "x" * SUMMARY_CONTENT_CHARS + "…"
+        assert truncated is True
+
+    def test_short_untouched(self) -> None:
+        content = "short text"
+        result, truncated = _truncate_content(content, "summary")
+        assert result == content
+        assert truncated is False
+
+    def test_full_depth_untouched(self) -> None:
+        long_content = "x" * 10000
+        result, truncated = _truncate_content(long_content, "full")
+        assert result == long_content
+        assert truncated is False
+
+    def test_empty_content(self) -> None:
+        result, truncated = _truncate_content("", "summary")
+        assert result == ""
+        assert truncated is False
+
+    def test_ellipsis_is_single_char(self) -> None:
+        """The ellipsis must be exactly U+2026 (not three dots)."""
+        content = "x" * (SUMMARY_CONTENT_CHARS + 1)
+        result, _ = _truncate_content(content, "summary")
+        assert result[-1] == "…"
