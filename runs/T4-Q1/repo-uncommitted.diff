+# ── Test 7: get defaults and truncation ──────────────────────────────────────
+
+
+async def test_get_defaults_and_truncation(pg_pool: Any) -> None:
+    """include=open → resolved node absent from nodes, present in resolved.
+    include=all → present in nodes with status.
+    Long content truncated with … by default; depth=full returns full content."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(pg_pool, tenant, client_id)
+
+    try:
+        opened = await MindmapOpenTool()(ctx, MindmapOpenInput(title="Test", root_question="Why?"))
+        n1 = await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(
+                map_key=opened.map_key, content="Short node", node_role="position"
+            ),
+        )
+        long_content = "x" * 300  # longer than 200
+        n2 = await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(
+                map_key=opened.map_key, content=long_content, node_role="position"
+            ),
+        )
+
+        # Resolve n1
+        await MindmapResolveTool()(
+            ctx,
+            MindmapResolveInput(
+                map_key=opened.map_key,
+                node_id=n1.node_id,
+                disposition="resolved",
+                resolution_summary="Settled",
+                resolved_by_party="model",
+            ),
+        )
+
+        # include=open (default)
+        got_open = await MindmapGetTool()(ctx, MindmapGetInput(map_key=opened.map_key))
+        # Resolved node should NOT be in nodes
+        node_ids_in_nodes = {n.memory_id for n in got_open.nodes}
+        assert n1.node_id not in node_ids_in_nodes
+        # Resolved node should be in resolved list
+        assert len(got_open.resolved) >= 1
+        resolved_entry = [r for r in got_open.resolved if r.memory_id == n1.node_id]
+        assert len(resolved_entry) == 1
+        assert resolved_entry[0].status == "resolved"
+        assert resolved_entry[0].resolution_summary == "Settled"
+        assert resolved_entry[0].resolved_by_party == "model"
+
+        # n2 with long content should be truncated
+        n2_node = [n for n in got_open.nodes if n.memory_id == n2.node_id]
+        assert len(n2_node) == 1
+        assert n2_node[0].truncated is True
+        assert n2_node[0].content.endswith("…")
+        assert len(n2_node[0].content) == 201  # 200 + "…"
+
+        # include=all
+        got_all = await MindmapGetTool()(
+            ctx, MindmapGetInput(map_key=opened.map_key, include="all")
+        )
+        assert len(got_all.resolved) == 0
+        node_ids_in_all = {n.memory_id for n in got_all.nodes}
+        assert n1.node_id in node_ids_in_all
+        n1_node = next(n for n in got_all.nodes if n.memory_id == n1.node_id)
+        assert n1_node.status == "resolved"
+
+        # depth=full → no truncation
+        got_full = await MindmapGetTool()(
+            ctx, MindmapGetInput(map_key=opened.map_key, depth="full")
+        )
+        n2_full = [n for n in got_full.nodes if n.memory_id == n2.node_id]
+        assert len(n2_full) == 1
+        assert n2_full[0].truncated is False
+        assert len(n2_full[0].content) == 300
+    finally:
+        await _cleanup(pg_pool, tenant, team, client_id)
