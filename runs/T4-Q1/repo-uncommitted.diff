+            await MindmapResolveTool()(
+                ctx,
+                MindmapResolveInput(
+                    map_key=opened.map_key,
+                    node_id=n_other.node_id,
+                    resolution_summary="test",
+                ),
+            )
+        assert exc_info.value.code == -32602
+        # Verify the other node is still open
+        async with pg_pool.acquire() as conn:
+            await conn.execute("SELECT set_config('app.current_tenant_id', $1, true)", str(tenant))
+            mem = await conn.fetchrow(
+                "SELECT status FROM memory_map_membership WHERE memory_id = $1", n_other.node_id
+            )
+            assert mem["status"] == "open"
+
+        # ---- Archived map (no-reopen) ----
+        await MindmapCloseTool()(
+            ctx,
+            MindmapCloseInput(map_key=opened.map_key),
+        )
+        with pytest.raises(JsonRpcError) as exc_info:
+            await MindmapResolveTool()(
+                ctx,
+                MindmapResolveInput(
+                    map_key=opened.map_key,
+                    node_id=n1.node_id,
+                    resolution_summary="test",
+                ),
+            )
+        assert exc_info.value.code == -32602
+        assert exc_info.value.data.get("code") == "map_not_live"
+
+        # ---- Unknown resolver id ----
+        opened3 = await MindmapOpenTool()(
+            ctx,
+            MindmapOpenInput(title="Test 3", root_question="When?"),
