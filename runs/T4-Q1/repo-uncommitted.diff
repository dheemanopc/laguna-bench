+# ── Branch-status helpers (migration 0044) ───────────────────────────────────
+
+
+async def get_membership(
+    conn: asyncpg.Connection, *, memory_id: UUID, root_memory_id: UUID, tenant_id: UUID
+) -> dict[str, Any] | None:
+    """Fetch a single membership row (or None).
+
+    Called to validate that a node belongs to a specific map before
+    allowing operations like resolve.
+    """
+    row = await conn.fetchrow(
+        """
+        SELECT memory_id, root_memory_id, tenant_id, node_role, status,
+               resolution_summary, resolved_by_memory_id, resolved_by_party, resolved_at
+        FROM memory_map_membership
+        WHERE memory_id = $1 AND root_memory_id = $2 AND tenant_id = $3
+        """,
+        memory_id,
+        root_memory_id,
+        tenant_id,
+    )
+    return dict(row) if row else None
+
+
+async def lock_live_map(conn: asyncpg.Connection, *, root_memory_id: UUID, tenant_id: UUID) -> bool:
+    """Lock the map row and return True only if it is live.
+
+    The FOR UPDATE lock serialises resolve vs close operations.
+    """
+    row = await conn.fetchrow(
+        """
+        SELECT state FROM memory_maps
+        WHERE root_memory_id = $1 AND tenant_id = $2
+        FOR UPDATE
+        """,
+        root_memory_id,
+        tenant_id,
+    )
+    return row is not None and row["state"] == "live"
+
+
+async def set_branch_status(
+    conn: asyncpg.Connection,
+    *,
+    memory_id: UUID,
+    root_memory_id: UUID,
+    tenant_id: UUID,
+    status: str,
+    resolution_summary: str | None = None,
+    resolved_by_memory_id: UUID | None = None,
+    resolved_by_party: str | None = None,
+) -> bool:
+    """Update the branch-status columns on a membership row.
+
+    Returns True if a row was updated (False → no-op / already set / root node).
+    Tenant scoping and root-node exclusion are enforced in SQL.
+    """
+    result = await conn.fetchval(
+        """
+        UPDATE memory_map_membership
+           SET status = $4,
+               resolution_summary = $5,
+               resolved_by_memory_id = $6,
+               resolved_by_party = $7,
+               resolved_at = now()
+        WHERE memory_id = $1 AND root_memory_id = $2 AND tenant_id = $3
+          AND node_role <> 'root'
+        RETURNING memory_id
+        """,
+        memory_id,
+        root_memory_id,
+        tenant_id,
+        status,
+        resolution_summary,
+        resolved_by_memory_id,
+        resolved_by_party,
+    )
+    return result is not None
+
+
+async def current_cursor(conn: asyncpg.Connection, *, root_memory_id: UUID) -> int:
+    """Return MAX(id) of memory_map_events for this map (0 if none)."""
+    val = await conn.fetchval(
+        "SELECT COALESCE(MAX(id), 0) FROM memory_map_events WHERE root_memory_id = $1",
+        root_memory_id,
+    )
+    return int(val) if val else 0
+
+
+async def fetch_touched_member_ids(
+    conn: asyncpg.Connection, *, root_memory_id: UUID, since: int
+) -> set[UUID]:
+    """Member IDs whose membership row is referenced by a map event with id > since.
+
+    For link events the ``payload->>'target'`` (if it is a valid UUID) also
+    counts.  Invalid casts are silently skipped by guarding with a UUID
+    pattern regex.
+    """
+    uuid_pat = r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]" r"{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
+    rows = await conn.fetch(
+        """
+        SELECT memory_id FROM memory_map_events
+        WHERE root_memory_id = $1 AND id > $2
+        UNION
+        SELECT (payload->>'target')::uuid
+        FROM memory_map_events
+        WHERE root_memory_id = $1 AND id > $2
+          AND event = 'link'
+          AND payload ? 'target'
+          AND payload->>'target' ~ $3
+        """,
+        root_memory_id,
+        since,
+        uuid_pat,
+    )
+    return {r["memory_id"] for r in rows if r["memory_id"] is not None}
+
+
+async def fetch_member_ids(
+    conn: asyncpg.Connection, *, root_memory_id: UUID, tenant_id: UUID
+) -> list[UUID]:
+    """All member IDs for a map (tenant + deleted_at filter)."""
+    rows = await conn.fetch(
+        """
+        SELECT mm.memory_id
+        FROM memory_map_membership mm
+        JOIN memories m ON m.id = mm.memory_id
+        WHERE mm.root_memory_id = $1
+          AND mm.tenant_id = $2
+          AND m.tenant_id = $2
+          AND m.deleted_at IS NULL
+        """,
+        root_memory_id,
+        tenant_id,
+    )
+    return [r["memory_id"] for r in rows]
+
+
+async def fetch_window_members(
+    conn: asyncpg.Connection,
+    *,
+    root_memory_id: UUID,
+    tenant_id: UUID,
+    since: int | None = None,
+) -> list[dict[str, Any]]:
+    """All members in the since-window.
+
+    - *since* = None → every (non-deleted) member.
+    - *since* = N → only members touched by events with id > N.
+    - Returns [] if no events match.
+    """
+    if since is None:
+        rows = await conn.fetch(
+            """
+            SELECT mm.memory_id, mm.node_role, mm.added_at, mm.status,
+                   mm.resolution_summary, mm.resolved_by_party,
+                   m.content, m.type, m.metadata, m.created_at
+            FROM memory_map_membership mm
+            JOIN memories m ON m.id = mm.memory_id
+            WHERE mm.root_memory_id = $1
+              AND mm.tenant_id = $2
+              AND m.tenant_id = $2
+              AND m.deleted_at IS NULL
+            ORDER BY mm.added_at ASC
+            """,
+            root_memory_id,
+            tenant_id,
+        )
+    else:
+        touched = await fetch_touched_member_ids(conn, root_memory_id=root_memory_id, since=since)
+        if not touched:
+            return []
+        touched_arr = list(touched)
+        rows = await conn.fetch(
+            """
+            SELECT mm.memory_id, mm.node_role, mm.added_at, mm.status,
+                   mm.resolution_summary, mm.resolved_by_party,
+                   m.content, m.type, m.metadata, m.created_at
+            FROM memory_map_membership mm
+            JOIN memories m ON m.id = mm.memory_id
+            WHERE mm.root_memory_id = $1
+              AND mm.memory_id = ANY($2::uuid[])
+              AND mm.tenant_id = $3
+              AND m.tenant_id = $3
+              AND m.deleted_at IS NULL
+            ORDER BY mm.added_at ASC
+            """,
+            root_memory_id,
+            touched_arr,
+            tenant_id,
+        )
+    out: list[dict[str, Any]] = []
+    for r in rows:
+        d = dict(r)
+        d["metadata"] = _as_dict(d.get("metadata"))
+        out.append(d)
+    return out
+
+
+async def fetch_edges_touching(
+    conn: asyncpg.Connection, *, member_ids: list[UUID], touched_ids: list[UUID]
+) -> list[dict[str, Any]]:
+    """Edges where at least one endpoint is in *touched_ids* and both endpoints
+    are members of the map (*member_ids*)."""
+    if not member_ids or not touched_ids:
+        return []
+    rows = await conn.fetch(
+        """
+        SELECT source_memory_id, target_memory_id, reference_kind, created_at
+        FROM memory_references
+        WHERE source_memory_id = ANY($1::uuid[])
+          AND target_memory_id = ANY($1::uuid[])
+          AND (source_memory_id = ANY($2::uuid[])
+               OR target_memory_id = ANY($2::uuid[]))
+        ORDER BY created_at ASC
+        """,
+        member_ids,
+        touched_ids,
+    )
+    return [dict(r) for r in rows]
+
+
+async def fetch_open_loop_ids(
+    conn: asyncpg.Connection,
+    *,
+    root_memory_id: UUID,
+    tenant_id: UUID,
+) -> list[UUID]:
+    """Open-loop node IDs.
+
+    Queries the membership rows with open status and their full metadata,
+    then filters in Python (avoids SQL jsonb->> issues with the store's
+    double-encoded metadata format).
+    """
+    rows = await conn.fetch(
+        """
+        SELECT mm.memory_id, m.metadata
+        FROM memory_map_membership mm
+        JOIN memories m ON m.id = mm.memory_id
+        WHERE mm.root_memory_id = $1
+          AND mm.tenant_id = $2
+          AND mm.status = 'open'
+          AND m.tenant_id = $2
+          AND m.deleted_at IS NULL
+        ORDER BY mm.added_at ASC
+        """,
+        root_memory_id,
+        tenant_id,
+    )
+    out: list[UUID] = []
+    for r in rows:
+        metadata = _as_dict(r.get("metadata"))
+        if metadata.get("responsible_party") in RESPONSIBLE_PARTIES:
+            out.append(r["memory_id"])
+    return out
+
+
+async def fetch_node_team_id(
+    conn: asyncpg.Connection, *, memory_id: UUID, tenant_id: UUID
+) -> UUID | None:
+    """Return the team_id for a memory row (used for insert_reference FK)."""
+    val: UUID | None = await conn.fetchval(
+        "SELECT team_id FROM memories WHERE id = $1 AND tenant_id = $2",
+        memory_id,
+        tenant_id,
+    )
+    return val
