+async def test_since_cursor_with_link_displaced(pg_pool: Any) -> None:
+    """since=<cursor> after writing a NEW node with links=[{target_memory_id: older,
+    reference_kind: "displaced-from"}]: nodes contains the new node; edges contain
+    the new→older edge; open_loops still contains an OLDER open node with
+    responsible_party="owner"."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(pg_pool, tenant, client_id)
+
+    try:
+        opened = await MindmapOpenTool()(ctx, MindmapOpenInput(title="Test", root_question="Why?"))
+        # Older open node with responsible_party
+        older = await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(
+                map_key=opened.map_key,
+                content="Old position",
+                node_role="position",
+                responsible_party="owner",
+            ),
+        )
+
+        # Get cursor after older node
+        got0 = await MindmapGetTool()(ctx, MindmapGetInput(map_key=opened.map_key))
+        cursor0 = got0.cursor
+
+        # Write a NEW node that links back to the older one with displaced-from
+        new = await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(
+                map_key=opened.map_key,
+                content="New position",
+                node_role="position",
+                links=[
+                    {
+                        "target_memory_id": older.node_id,
+                        "reference_kind": "displaced-from",
+                    }
+                ],
+            ),
+        )
+
+        # since=cursor0: new node should appear
+        got1 = await MindmapGetTool()(ctx, MindmapGetInput(map_key=opened.map_key, since=cursor0))
+        node_ids = {n.memory_id for n in got1.nodes}
+        assert new.node_id in node_ids
+
+        # edges should contain the new→older link
+        edge_tuples = {
+            (e.source_memory_id, e.target_memory_id, e.reference_kind) for e in got1.edges
+        }
+        assert (new.node_id, older.node_id, "displaced-from") in edge_tuples
+
+        # open_loops should still contain older (it has responsible_party=owner)
+        # open_loops is whole-map, so older is included
+        assert older.node_id in got1.open_loops
+    finally:
+        await _cleanup(pg_pool, tenant, team, client_id)
