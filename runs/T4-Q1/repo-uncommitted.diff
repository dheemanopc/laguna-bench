+"""Unit tests for mindmap_resolve / mindmap_get Pydantic models and helpers.
+
+DB-free: exercises input validation, output shape, and truncation logic.
+"""
+
+from __future__ import annotations
+
+from uuid import uuid4
+
+import pytest
+from pydantic import ValidationError
+
+from mem_mcp.mcp.tools.mindmap_get import MindmapGetInput, _truncate_content
+from mem_mcp.mcp.tools.mindmap_resolve import MindmapResolveInput
+from mem_mcp.mindmap import SUMMARY_CONTENT_CHARS
+
