+"""Add branch-status columns to memory_map_membership.
+
+Branch status is the ONLY source of truth for whether a mindmap node is
+"settled" (resolved / dropped) versus still open. We never infer status
+from memory_references reference_kind; an edge alone never settles a branch.
+
+Why: prior to this, mindmap_get returned every node in full on every call,
+there was no per-branch status, and open_loops grew unbounded because
+resolved/dropped nodes were never removed from the open set. The new columns
+let mindmap_resolve settle individual branches and mindmap_get filter to
+only open loops or a since-cursor window.
+
+Revision ID: 0044_mindmap_branch_status
+Revises: 0043_backfill_personal_teams
+Create Date: 2026-10-16
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0044_mindmap_branch_status"
+down_revision = "0043_backfill_personal_teams"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+            ADD COLUMN status TEXT NOT NULL DEFAULT 'open'
+                        CONSTRAINT memory_map_membership_status_check
+                            CHECK (status IN ('open', 'resolved', 'dropped'))
+        """)
+    )
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+            ADD COLUMN resolution_summary TEXT NULL
+                        CONSTRAINT memory_map_membership_resolution_summary_check
+                            CHECK (
+                                resolution_summary IS NULL
+                                OR char_length(resolution_summary) BETWEEN 1 AND 500
+                            )
+        """)
+    )
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+            ADD COLUMN resolved_by_memory_id UUID NULL
+                        REFERENCES memories(id) ON DELETE SET NULL
+        """)
+    )
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+            ADD COLUMN resolved_by_party TEXT NULL
+                        CONSTRAINT memory_map_membership_resolved_by_party_check
+                            CHECK (resolved_by_party IN ('owner', 'model'))
+        """)
+    )
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+            ADD COLUMN resolved_at TIMESTAMPTZ NULL
+        """)
+    )
+    # Consistency CHECK: when status='open' then summary/party/resolved_at/resolved_by_memory_id are NULL;
+    # when status is resolved/dropped then summary, party, resolved_at are NOT NULL.
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+            ADD CONSTRAINT memory_map_membership_status_consistency_check
+            CHECK (
+                (status = 'open'
+                 AND resolution_summary IS NULL
+                 AND resolved_by_memory_id IS NULL
+                 AND resolved_by_party IS NULL
+                 AND resolved_at IS NULL)
+                OR
+                (status IN ('resolved', 'dropped')
+                 AND resolution_summary IS NOT NULL
+                 AND resolved_by_party IS NOT NULL
+                 AND resolved_at IS NOT NULL)
+            )
+        """)
+    )
+    # Index to serve cursor reads (since=N): MAX(id) and id > N per map.
+    op.execute(
+        sa.text(
+            "CREATE INDEX memory_map_events_root_id_idx " "ON memory_map_events(root_memory_id, id)"
+        )
+    )
+
+
+def downgrade() -> None:
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership DROP CONSTRAINT IF EXISTS memory_map_membership_status_consistency_check"
+        )
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership DROP CONSTRAINT IF EXISTS memory_map_membership_resolved_by_party_check"
+        )
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership DROP CONSTRAINT IF EXISTS memory_map_membership_resolution_summary_check"
+        )
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership DROP CONSTRAINT IF EXISTS memory_map_membership_status_check"
+        )
+    )
+    op.execute(sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolved_at"))
+    op.execute(sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolved_by_party"))
+    op.execute(
+        sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolved_by_memory_id")
+    )
+    op.execute(
+        sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolution_summary")
+    )
+    op.execute(sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS status"))
+    op.execute(sa.text("DROP INDEX IF EXISTS memory_map_events_root_id_idx"))
