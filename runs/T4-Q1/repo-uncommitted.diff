+            ctx,
+            MindmapWriteNodeInput(map_key=opened.map_key, content="Node A", node_role="position"),
+        )
+
+        # ---- Unknown map ----
+        with pytest.raises(JsonRpcError) as exc_info:
+            await MindmapResolveTool()(
+                ctx,
+                MindmapResolveInput(
+                    map_key="nonexistent-map",
+                    node_id=n1.node_id,
+                    resolution_summary="test",
+                ),
+            )
+        assert exc_info.value.code == -32602
+        assert exc_info.value.message == "map not found"
+
+        # Verify nothing changed
+        async with pg_pool.acquire() as conn:
+            await conn.execute("SELECT set_config('app.current_tenant_id', $1, true)", str(tenant))
+            mem = await conn.fetchrow(
+                "SELECT status FROM memory_map_membership WHERE memory_id = $1", n1.node_id
+            )
+            assert mem["status"] == "open"
+
+        # ---- Root node ----
+        # Get root_memory_id from opened
+        with pytest.raises(JsonRpcError) as exc_info:
+            await MindmapResolveTool()(
+                ctx,
+                MindmapResolveInput(
+                    map_key=opened.map_key,
+                    node_id=opened.root_memory_id,
+                    resolution_summary="test",
+                ),
+            )
+        assert exc_info.value.code == -32602
+
+        # ---- Node of a different map (same tenant) ----
+        opened2 = await MindmapOpenTool()(
+            ctx, MindmapOpenInput(title="Test 2", root_question="How?")
+        )
+        n_other = await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(
+                map_key=opened2.map_key, content="Other node", node_role="position"
