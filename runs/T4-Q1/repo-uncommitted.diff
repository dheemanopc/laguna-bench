+# ── Test 1: resolve with resolving node ──────────────────────────────────────
+
+
+async def test_resolve_with_resolver(pg_pool: Any) -> None:
+    """Resolve with a resolver node → status/summary/party set; edge created; event logged; cursor increased."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(pg_pool, tenant, client_id)
+
+    try:
+        # Open map and write nodes
+        opened = await MindmapOpenTool()(ctx, MindmapOpenInput(title="Test", root_question="Why?"))
+        # Node to resolve
+        n1 = await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(
+                map_key=opened.map_key, content="Position A", node_role="position"
+            ),
+        )
+        # Resolver node
+        n2 = await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(
+                map_key=opened.map_key, content="Position B (resolver)", node_role="position"
+            ),
+        )
+
+        # Get current cursor
+        got_before = await MindmapGetTool()(ctx, MindmapGetInput(map_key=opened.map_key))
+        cursor_before = got_before.cursor
+
+        # Resolve n1 with n2 as resolver
+        resolved = await MindmapResolveTool()(
+            ctx,
+            MindmapResolveInput(
+                map_key=opened.map_key,
+                node_id=n1.node_id,
+                disposition="resolved",
+                resolution_summary="Settled by Position B",
+                resolved_by_memory_id=n2.node_id,
+                resolved_by_party="model",
+            ),
+        )
+        assert resolved.status == "resolved"
+        assert resolved.resolution_summary == "Settled by Position B"
+        assert resolved.cursor > cursor_before
+
+        # Verify DB state: membership row
+        async with pg_pool.acquire() as conn:
+            await conn.execute("SELECT set_config('app.current_tenant_id', $1, true)", str(tenant))
+            mem = await conn.fetchrow(
+                "SELECT status, resolution_summary, resolved_by_party, resolved_at "
+                "FROM memory_map_membership WHERE memory_id = $1",
+                n1.node_id,
+            )
+            assert mem["status"] == "resolved"
+            assert mem["resolution_summary"] == "Settled by Position B"
+            assert mem["resolved_by_party"] == "model"
+            assert mem["resolved_at"] is not None
+
+            # Edge: n2 resolves-under n1
+            edge = await conn.fetchval(
+                "SELECT reference_kind FROM memory_references "
+                "WHERE source_memory_id = $1 AND target_memory_id = $2",
+                n2.node_id,
+                n1.node_id,
+            )
+            assert edge == "resolves-under"
+
+            # Event
+            evt = await conn.fetchrow(
+                "SELECT event, actor FROM memory_map_events "
+                "WHERE memory_id = $1 ORDER BY id DESC LIMIT 1",
+                n1.node_id,
+            )
+            assert evt["event"] == "resolve"
+            assert evt["actor"] == "model"
+    finally:
+        await _cleanup(pg_pool, tenant, team, client_id)
