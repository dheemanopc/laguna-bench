+# ── Test 8: since=cursor semantics ───────────────────────────────────────────
+
+
+async def test_since_cursor_semantics(pg_pool: Any) -> None:
+    """since=cursor with no change → empty. After writing → only that node.
+    After resolving → appears in resolved."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(pg_pool, tenant, client_id)
+
+    try:
+        opened = await MindmapOpenTool()(ctx, MindmapOpenInput(title="Test", root_question="Why?"))
+        n1 = await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(map_key=opened.map_key, content="Node 1", node_role="position"),
+        )
+
+        # Get cursor after initial state
+        got0 = await MindmapGetTool()(ctx, MindmapGetInput(map_key=opened.map_key))
+        cursor0 = got0.cursor
+
+        # Since=cursor0 with no change → empty
+        got_empty = await MindmapGetTool()(
+            ctx, MindmapGetInput(map_key=opened.map_key, since=cursor0)
+        )
+        assert got_empty.nodes == []
+        assert got_empty.resolved == []
+        assert got_empty.cursor == cursor0
+
+        # Write another node → cursor advances
+        await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(map_key=opened.map_key, content="Node 2", node_role="position"),
+        )
+        got1 = await MindmapGetTool()(ctx, MindmapGetInput(map_key=opened.map_key, since=cursor0))
+        assert len(got1.nodes) >= 1  # at least n2 (and maybe n1 if it appeared in events)
+        # The cursor should have advanced
+        assert got1.cursor > cursor0
+
+        # Resolve n1 → it appears in resolved for that window
+        cursor_before_resolve = got1.cursor
+        await MindmapResolveTool()(
+            ctx,
+            MindmapResolveInput(
+                map_key=opened.map_key,
+                node_id=n1.node_id,
+                disposition="resolved",
+                resolution_summary="Done",
+                resolved_by_party="model",
+            ),
+        )
+        got_resolved = await MindmapGetTool()(
+            ctx, MindmapGetInput(map_key=opened.map_key, since=cursor_before_resolve)
+        )
+        assert len(got_resolved.resolved) >= 1
+        resolved_ids = {r.memory_id for r in got_resolved.resolved}
+        assert n1.node_id in resolved_ids
+    finally:
+        await _cleanup(pg_pool, tenant, team, client_id)
