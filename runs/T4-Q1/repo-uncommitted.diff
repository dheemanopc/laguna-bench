diff --git a/src/mem_mcp/mcp/tools/mindmap_resolve.py b/src/mem_mcp/mcp/tools/mindmap_resolve.py
new file mode 100644
index 0000000..15700ed
--- /dev/null
+++ b/src/mem_mcp/mcp/tools/mindmap_resolve.py
@@ -0,0 +1,192 @@
+"""mindmap_resolve — settle a single branch (resolve or drop) within a live map.
+
+Branch status lives in memory_map_membership.status; resolving a node never
+creates a map-level state change. The only source of truth for "settled" is
+the status column — a memory_references edge alone does NOT settle a branch.
+"""
+
+from __future__ import annotations
+
+from typing import ClassVar, Literal
+from uuid import UUID
+
+from pydantic import BaseModel, Field
+
+from mem_mcp.db import system_tx, tenant_tx
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tool_descriptions import TOOL_DESCRIPTIONS
+from mem_mcp.mcp.tools._base import BaseTool, ToolContext
+from mem_mcp.mcp.tools._mindmap_common import resolve_team_id
+from mem_mcp.mindmap import (
+    DISPOSITION_TO_REFERENCE_KIND,
+    service,
+)
+from mem_mcp.teams.references import (
+    ReferenceTargetNotFoundError,
+    insert_reference,
+    resolve_reference_target,
+)
+
+
+class MindmapResolveInput(BaseModel):
+    map_key: str = Field(..., min_length=1, max_length=64)
+    node_id: UUID
+    disposition: Literal["resolved", "dropped"] = Field(default="resolved")
+    resolution_summary: str = Field(..., min_length=1, max_length=500)
+    resolved_by_memory_id: UUID | None = None
+    resolved_by_party: Literal["owner", "model"] = Field(default="model")
+    team_id: UUID | None = None
+
+
+class MindmapResolveOutput(BaseModel):
+    node_id: UUID
+    status: str
+    resolution_summary: str
+    cursor: int
+    request_id: str
+
+
+class MindmapResolveTool(BaseTool):
+    name: ClassVar[str] = "mindmap_resolve"
+    description: ClassVar[str] = TOOL_DESCRIPTIONS["mindmap_resolve"]
+    required_scope: ClassVar[str] = "memory.write"
+    InputModel: ClassVar[type[BaseModel]] = MindmapResolveInput
+    OutputModel: ClassVar[type[BaseModel]] = MindmapResolveOutput
+
+    async def __call__(self, ctx: ToolContext, inp: BaseModel) -> BaseModel:
+        assert isinstance(inp, MindmapResolveInput)
+
+        async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+            team_id = await resolve_team_id(conn, ctx, inp.team_id)
+            root_id = await service.resolve_map_root(conn, team_id=team_id, map_key=inp.map_key)
+            if root_id is None:
+                raise JsonRpcError(-32602, "map not found", data={"errors": [{"path": "map_key"}]})
+
+            # Map must be live (also acquires FOR UPDATE for serialization)
+            if not await service.lock_live_map(
+                conn, root_memory_id=root_id, tenant_id=ctx.tenant_id
+            ):
+                raise JsonRpcError(
+                    -32602, "map already archived (no-reopen)", data={"code": "map_not_live"}
+                )
+
+            # node_id must be a member of THIS map
+            membership = await service.get_membership(
+                conn, memory_id=inp.node_id, root_memory_id=root_id, tenant_id=ctx.tenant_id
+            )
+            if membership is None:
+                raise JsonRpcError(
+                    -32602,
+                    "node is not a member of this map",
+                    data={"errors": [{"path": "node_id"}]},
+                )
+            # Root node cannot be resolved
+            if membership["node_role"] == "root":
+                raise JsonRpcError(
+                    -32602, "root node cannot be resolved", data={"errors": [{"path": "node_id"}]}
+                )
+
+        # Validate resolved_by_memory_id (outside the tenant_tx so we can
+        # use system_tx for resolve_reference_target).
+        if inp.resolved_by_memory_id is not None:
+            if inp.resolved_by_memory_id == inp.node_id:
+                raise JsonRpcError(
+                    -32602,
+                    "resolved_by_memory_id must differ from node_id",
+                    data={"errors": [{"path": "resolved_by_memory_id"}]},
+                )
+            async with system_tx(ctx.db_pool) as sys_conn:
+                try:
+                    await resolve_reference_target(
+                        sys_conn,
+                        target_uuid=inp.resolved_by_memory_id,
+                        caller_user_id=ctx.tenant_id,
+                    )
+                except ReferenceTargetNotFoundError as exc:
+                    raise JsonRpcError(
+                        -32602,
+                        "reference target not found or not accessible",
+                        data={"code": "memory_not_accessible"},
+                    ) from exc
+
+        # All validation passed — perform the write atomically.
+        # Acquire the FOR UPDATE lock via lock_live_map (serialises resolve
+        # vs close). The membership-level lock from lock_live_map protects
+        # the window between validation and write.
+        async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+            # 0. Re-check live (map could have closed between txs)
+            if not await service.lock_live_map(
+                conn, root_memory_id=root_id, tenant_id=ctx.tenant_id
+            ):
+                raise JsonRpcError(
+                    -32602, "map already archived (no-reopen)", data={"code": "map_not_live"}
+                )
+
+            # 1. Update the membership row (now with tenant_id; returns bool)
+            ok = await service.set_branch_status(
+                conn,
+                memory_id=inp.node_id,
+                root_memory_id=root_id,
+                tenant_id=ctx.tenant_id,
+                status=inp.disposition,
+                resolution_summary=inp.resolution_summary,
+                resolved_by_memory_id=inp.resolved_by_memory_id,
+                resolved_by_party=inp.resolved_by_party,
+            )
+            if not ok:
+                raise JsonRpcError(
+                    -32602,
+                    "failed to set branch status (node may be root or already locked)",
+                    data={"errors": [{"path": "node_id"}]},
+                )
+
+            # 2. If a resolving node is named: insert the edge
+            # Fetch team_id inside this write tx (needs tenant_id filter).
+            target_team = await service.fetch_node_team_id(
+                conn, memory_id=inp.node_id, tenant_id=ctx.tenant_id
+            )
+            if target_team is None:
+                raise JsonRpcError(
+                    -32602,
+                    "node vanished between validation and write",
+                    data={"errors": [{"path": "node_id"}]},
+                )
+            reference_kind = None
+            if inp.resolved_by_memory_id is not None:
+                reference_kind = DISPOSITION_TO_REFERENCE_KIND[inp.disposition]
+                await insert_reference(
+                    conn,
+                    source_memory_id=inp.resolved_by_memory_id,
+                    target_memory_id=inp.node_id,
+                    target_team_id=target_team,
+                    reference_kind=reference_kind,
+                )
+
+            # 3. Append a map event
+            event_type = "resolve" if inp.disposition == "resolved" else "drop"
+            await service.log_event(
+                conn,
+                root_memory_id=root_id,
+                tenant_id=ctx.tenant_id,
+                event=event_type,
+                actor=inp.resolved_by_party,
+                memory_id=inp.node_id,
+                payload={
+                    "disposition": inp.disposition,
+                    "resolved_by_memory_id": str(inp.resolved_by_memory_id)
+                    if inp.resolved_by_memory_id
+                    else None,
+                    "reference_kind": reference_kind,
+                },
+            )
+
+            # 4. Read the new cursor
+            new_cursor = await service.current_cursor(conn, root_memory_id=root_id)
+
+        return MindmapResolveOutput(
+            node_id=inp.node_id,
+            status=inp.disposition,
+            resolution_summary=inp.resolution_summary,
+            cursor=new_cursor,
+            request_id=ctx.request_id,
+        )
