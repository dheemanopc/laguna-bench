+class MindmapWorkflowUpdateTool(BaseTool):
+    """Create a new workflow version and promote it to live."""
+
+    name: ClassVar[str] = "mindmap_workflow_update"
+    description: ClassVar[str] = TOOL_DESCRIPTIONS["mindmap_workflow_update"]
+    required_scope: ClassVar[str] = "memory.write"
