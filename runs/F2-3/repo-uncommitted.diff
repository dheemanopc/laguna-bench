+# -------------------------------------------------------------------------
+# Workflow version management (R1/R4)
+# -------------------------------------------------------------------------
+
+
+async def create_workflow_version(
+    conn: asyncpg.Connection,
+    *,
+    team_id: UUID,
+    statuses: list[str],
+    transitions: dict[str, dict[str, dict[str, Any]]],
+    created_by: UUID,
+    reject_if_orphans: bool = True,
+) -> WorkflowDef:
+    """Create a new frozen workflow version for a team and promote it to live.
+
+    E1: when ``reject_if_orphans`` is true (the default), the call refuses if any
+    existing work_items carry a status absent from the proposed ``statuses`` list.
+    Pass ``reject_if_orphans=False`` to allow dropping statuses.
+    """
+    live = await get_live_workflow(conn, team_id=team_id, created_by=created_by)
+
+    if reject_if_orphans:
+        current_statuses = {s for s in statuses}
+        orphans = await conn.fetch(
+            "SELECT DISTINCT status FROM work_items WHERE team_id = $1",
+            team_id,
+        )
+        orphan_statuses = [r["status"] for r in orphans if r["status"] not in current_statuses]
+        if orphan_statuses:
+            raise OrphanStatusError(orphan_statuses)
+
+    version_number = live.version_number + 1
+    version_id = await conn.fetchval(
+        """
+        INSERT INTO team_workflow_versions
+            (team_id, version_number, statuses, transitions, created_by)
+        VALUES ($1, $2, $3, $4, $5)
+        RETURNING id
+        """,
+        team_id,
+        version_number,
+        statuses,
+        _dumps_json(transitions),
+        created_by,
+    )
+    await conn.execute(
+        """
+        UPDATE team_workflows
+        SET current_version_id = $1, updated_at = now(), updated_by = $2
+        WHERE team_id = $3
+        """,
+        version_id,
+        created_by,
+        team_id,
+    )
+    return await get_workflow_version(conn, version_id)
+
+
+# -------------------------------------------------------------------------
+# Sign-off rejection & listing
+# -------------------------------------------------------------------------
+
+
+async def reject_signoff(
+    conn: asyncpg.Connection,
+    *,
+    request_id: UUID,
+    actor_identity_id: UUID,
+    channel: str = "mcp",
+    reason: str | None = None,
+) -> SignoffState:
+    """Reject (close) a pending sign-off request without applying the move.
+
+    §2.4: marks the request ``superseded`` so no further approvals can be
+    recorded; the work-item ``status`` is left unchanged. Appends a
+    ``signoff_decided`` history row.
+    """
+    req = await conn.fetchrow(
+        """
+        SELECT r.request_id, r.work_item_id, r.team_id, r.from_status,
+               r.to_status, r.min_signoffs, r.eligible_role_classes, r.status
+        FROM work_item_signoff_requests r
+        WHERE r.request_id = $1
+        FOR UPDATE
+        """,
+        request_id,
+    )
+    if req is None:
+        raise WorkflowNotFoundError()
+    if req["status"] != "pending":
+        raise SignoffRequestClosedError(req["request_id"])
+
+    await conn.execute(
+        """
+        UPDATE work_item_signoff_requests
+        SET status = 'superseded'
+        WHERE request_id = $1 AND team_id = $2
+        """,
+        request_id,
+        req["team_id"],
+    )
+
+    await _record_signoff_history(
+        conn,
+        work_item_id=req["work_item_id"],
+        team_id=req["team_id"],
+        actor_id=actor_identity_id,
+        channel=channel,
+        change_type="signoff_decided",
+        from_status=req["from_status"],
+        to_status=req["to_status"],
+        reason=reason,
+    )
+
+    return await _signoff_state_raw(
+        conn,
+        request_id=request_id,
+        status="superseded",
+        from_status=req["from_status"],
+        to_status=req["to_status"],
+        min_signoffs=int(req["min_signoffs"]),
+        approvals=await _count_approvals(conn, request_id),
+        eligible_role_classes=list(req["eligible_role_classes"]),
+    )
+
+
+async def list_eligible_signoff_requests(
+    conn: asyncpg.Connection,
+    *,
+    team_id: UUID,
+    caller_identity_id: UUID,
+) -> list[SignoffState]:
+    """List pending sign-off requests where ``caller_identity_id`` is an eligible approver.
+
+    R8: a caller sees only requests for which they hold an active role in
+    ``eligible_role_classes`` and are neither the mover nor the item owner.
+    """
+    role = await get_team_role(conn, caller_identity_id, team_id)
+    if role is None:
+        return []
+
+    rows = await conn.fetch(
+        """
+        SELECT r.request_id, r.status, r.from_status, r.to_status,
+               r.min_signoffs, r.eligible_role_classes, r.created_by,
+               wi.assignee_id, wi.created_by AS item_creator
+        FROM work_item_signoff_requests r
+        JOIN work_items wi ON wi.memory_id = r.work_item_id AND wi.team_id = r.team_id
+        WHERE r.team_id = $1 AND r.status = 'pending'
+        ORDER BY r.created_at DESC
+        """,
+        team_id,
+    )
+    result: list[SignoffState] = []
+    for row in rows:
+        eligible = list(row["eligible_role_classes"])
+        # Exclude mover and item owner from their own approvals.
+        if caller_identity_id == row["created_by"]:
+            continue
+        if caller_identity_id == (row["assignee_id"] or row["item_creator"]):
+            continue
+        if role not in eligible:
+            continue
+        approvals = await _count_approvals(conn, row["request_id"])
+        approvers = await conn.fetch(
+            "SELECT DISTINCT approver_identity_id FROM work_item_signoff_approvals "
+            "WHERE request_id = $1",
+            row["request_id"],
+        )
+        result.append(
+            await _signoff_state_raw(
+                conn,
+                request_id=row["request_id"],
+                status=row["status"],
+                from_status=row["from_status"],
+                to_status=row["to_status"],
+                min_signoffs=int(row["min_signoffs"]),
+                approvals=approvals,
+                eligible_role_classes=eligible,
+            )
+        )
+    return result
+
+
