@@ -0,0 +1,100 @@
+"""mindmap_work_list — list work items for a team or map with optional filters."""
+
+from __future__ import annotations
+
+from typing import ClassVar
+from uuid import UUID
+
+from pydantic import BaseModel, Field
+
+from mem_mcp.db import tenant_tx
+from mem_mcp.mcp.tool_descriptions import TOOL_DESCRIPTIONS
+from mem_mcp.mcp.tools._base import BaseTool, ToolContext
+from mem_mcp.mcp.tools._mindmap_common import resolve_team_id
+from mem_mcp.mcp.tools._work_item_common import WorkItemCollectionOutput, map_work_item_error, work_item_to_output
+from mem_mcp.mindmap import work_items as work_item_service
+from mem_mcp.auth.rbac import get_team_role
+
+
+class MindmapWorkListInput(BaseModel):
+    """Input for listing work items."""
+
+    team_id: UUID | None = Field(default=None, description="Team UUID; defaults to caller's default team")
+    map_key: str | None = Field(default=None, description="Restrict to a single map; omit for team-wide")
+    status: str | None = Field(default=None, description="Filter by status")
+    kind: str | None = Field(default=None, description="Filter by kind (story|epic|milestone)")
+    assignee_id: UUID | None = Field(default=None, description="Filter by assignee")
+    unassigned: bool = Field(default=False, description="Only items without an assignee")
+    waiting_on_me: bool = Field(default=False, description="Only items where the caller is an eligible approver on a pending sign-off")
+    limit: int = Field(default=100, ge=1, le=500)
+
+
+class MindmapWorkListTool(BaseTool):
+    """List work items for a team or map, with filters."""
+
+    name: ClassVar[str] = "mindmap_work_list"
+    description: ClassVar[str] = TOOL_DESCRIPTIONS["mindmap_work_list"]
+    required_scope: ClassVar[str] = "memory.read"
+    InputModel: ClassVar[type[BaseModel]] = MindmapWorkListInput
+    OutputModel: ClassVar[type[BaseModel]] = WorkItemCollectionOutput
+
+    async def __call__(self, ctx: ToolContext, inp: BaseModel) -> BaseModel:
+        assert isinstance(inp, MindmapWorkListInput)
+
+        async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+            team_id = await resolve_team_id(conn, ctx, inp.team_id)
+
+            try:
+                items = await work_item_service.list_work_items(
+                    conn,
+                    tenant_id=ctx.tenant_id,
+                    team_id=team_id,
+                    map_key=inp.map_key,
+                    status=inp.status,
+                    kind=inp.kind,
+                    assignee_id=inp.assignee_id,
+                    unassigned=inp.unassigned,
+                    limit=inp.limit,
+                )
+            except work_item_service.WorkItemError as e:
+                raise map_work_item_error(e) from e
+
+            # R8: waiting_on_me filters to items where the caller holds an
+            # active role in the pending sign-off request's eligible_role_classes
+            # and is neither the mover nor the item owner.
+            if inp.waiting_on_me:
+                caller_role = await get_team_role(conn, ctx.identity_id, team_id)
+                eligible_role = caller_role if caller_role else ""
+                filtered = []
+                for item in items:
+                    ss = item.signoff_state
+                    if ss is None or ss.status != "pending":
+                        continue
+                    if ctx.identity_id == item.created_by:
+                        continue
+                    if ctx.identity_id == (item.assignee_id or item.created_by):
+                        continue
+                    if eligible_role in ss.eligible_role_classes:
+                        filtered.append(item)
+                items = filtered
+
+            if ctx.deps is not None:
+                await ctx.deps.audit.audit(
+                    conn,
+                    action="memory.list",
+                    result="success",
+                    tenant_id=ctx.tenant_id,
+                    identity_id=ctx.identity_id,
+                    client_id=ctx.client_id,
+                    request_id=ctx.request_id,
+                    details={
+                        "team_id": str(team_id),
+                        "map_key": inp.map_key or "",
+                        "count": len(items),
+                    },
+                )
+
+            return WorkItemCollectionOutput(
+                items=[work_item_to_output(item, request_id=ctx.request_id) for item in items],
+                count=len(items),
+            )
