+        # Trigger signoff: todo → done requires 1 member approval
+        result = await MindmapWorkSetStatusTool()(
+            ctx_a,
+            MindmapWorkSetStatusInput(
+                map_key=map_key,
+                node_id=node_id,
+                status="done",
+                reason="completing",
+            ),
+        )
+        assert result.signoff_state is not None
+        assert result.signoff_state.status == "pending"
+        request_id = result.signoff_state.request_id
+
+        # Reject the signoff (mover can reject — reject_signoff has no
+        # eligibility check beyond the request being pending)
+        reject_result = await MindmapWorkSignoffRejectTool()(
