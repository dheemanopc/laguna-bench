+class TestCursorEncoding:
+    """Tests for _encode_cursor function."""
+
+    def test_raises_on_none_value(self) -> None:
+        with pytest.raises(ValueError, match="order_by_value cannot be None"):
+            _encode_cursor(None, uuid4())
+
+    def test_encodes_datetime_as_iso(self) -> None:
+        dt = datetime(2025, 5, 1, 12, 30, 45, tzinfo=UTC)
+        id_ = uuid4()
+        cursor = _encode_cursor(dt, id_)
+
+        # Decode and verify
+        decoded = json.loads(base64.urlsafe_b64decode(cursor))
+        assert decoded[0] == "2025-05-01T12:30:45+00:00"
+        assert decoded[1] == str(id_)
+
+    def test_cursor_is_urlsafe_base64(self) -> None:
+        dt = datetime(2025, 1, 1, 0, 0, 0, tzinfo=UTC)
+        id_ = uuid4()
+        cursor = _encode_cursor(dt, id_)
+
+        # Should only contain URL-safe base64 chars
+        for c in cursor:
+            assert c in "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_="
+
