+class TestRenderExtras:
+    """Additional tests for _render function from order-2.md section 5."""
+
+    def test_repeated_key_substitution(self) -> None:
+        """Repeated key references should all be substituted."""
+        text = _render("{x} and {x}", {"x": "same"})
+        assert text == "same and same"
+
+    def test_int_value_coerced_to_string(self) -> None:
+        """Integer values should be coerced via str()."""
+        text = _render("count={n}", {"n": 42})
+        assert text == "count=42"
+
+    def test_none_value_coerced_to_string(self) -> None:
+        """None values should be coerced via str()."""
+        text = _render("value={v}", {"v": None})
+        assert text == "value=None"
+
+    def test_list_value_coerced_to_string(self) -> None:
+        """List values should be coerced via str()."""
+        text = _render("items={lst}", {"lst": [1, 2, 3]})
+        assert text == "items=[1, 2, 3]"
+
+    def test_template_truncation_on_missing_key(self, caplog: pytest.LogCaptureFixture) -> None:
+        """Warning should include truncated template (max 120 chars)."""
+        import logging
+
+        long_template = "x" * 200 + " {missing}"
+        with caplog.at_level(logging.WARNING):
+            _render(long_template, {})
+
+        for record in caplog.records:
+            if "notice_template_missing_key" in record.message:
+                # Check template is truncated to 120 chars
+                assert len(record.template) == 120  # type: ignore[attr-defined]
+                assert record.key == "missing"  # type: ignore[attr-defined]
+
+    def test_brace_patterns_untouched(self) -> None:
+        """{1a}, { a }, {} patterns should be untouched (not valid identifiers)."""
+        text = _render("Not {1a} or { a } or {}", {})
+        assert text == "Not {1a} or { a } or {}"
+
