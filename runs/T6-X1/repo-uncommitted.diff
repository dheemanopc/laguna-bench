+            _render("{a}, {b}, {c}", {})
+
+        warnings = [r for r in caplog.records if "notice_template_missing_key" in r.message]
+        # Should have 3 warnings, one for each missing key
+        assert len(warnings) == 3
+        missing_keys = {r.key for r in warnings}  # type: ignore[attr-defined]
+        assert missing_keys == {"a", "b", "c"}
