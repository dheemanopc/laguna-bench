+class TestPaginationWalk:
+    """Test cursor-based pagination with full walk."""
+
+    @pytest.mark.xfail(
+        strict=True,
+        reason="BUG: cursor timestamp passed to SQL as ISO str; asyncpg rejects it, so page 2 can never be fetched",
+    )
+    @pytest.mark.asyncio
+    async def test_pagination_walk_created_at_desc(
+        self, pg_pool: Any, list_setup: dict[str, Any]
+    ) -> None:
+        """Following next_cursor should return all memories in correct order (created_at desc)."""
+        tenant_id = list_setup["tenant_id"]
+        team_id = list_setup["team_id"]
+
+        # Insert 10 memories with distinct created_at times
+        base = datetime(2025, 1, 1, 0, 0, tzinfo=UTC)
+        expected_ids = []
+        for i in range(10):
+            mem_id = await insert_memory(
+                pg_pool,
+                tenant_id=tenant_id,
+                content=f"memory {i}",
+                team_id=team_id,
+                created_at=base + timedelta(minutes=i),
+            )
+            expected_ids.append(mem_id)
+
+        tool = MemoryListTool()
+        ctx = _build_ctx(
+            pg_pool, tenant_id, list_setup["identity_id"], "req-pager-desc"
+        )
+
+        # Walk through pages
+        all_ids: list[UUID] = []
+        cursor: str | None = None
+        seen_ids: set[UUID] = set()
+
+        while True:
+            result = await tool(ctx, MemoryListInput(order="desc", limit=3, cursor=cursor))
+            for mem in result.results:
+                assert mem.id not in seen_ids, f"Duplicate id {mem.id} encountered"
+                seen_ids.add(mem.id)
+                all_ids.append(mem.id)
+            cursor = result.next_cursor
+            if cursor is None:
+                break
+
+        # Verify we got all memories with no duplicates and no skips
+        assert set(all_ids) == set(expected_ids), "Missing or extra ids in pagination"
+        # Verify order is descending (newest first)
+        # In desc order, the first memory should be the one with latest created_at (i=9)
+        assert all_ids[0] == expected_ids[9], "First id in desc order should be newest"
+        # Verify the ids follow the expected descending order
+        for i, mid in enumerate(all_ids):
+            assert mid == expected_ids[9 - i], f"Position {i}: expected {expected_ids[9-i]}, got {mid}"
