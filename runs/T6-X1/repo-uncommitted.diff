+        tool = MemoryListTool()
+        mock_conn = AsyncMock()
+        mock_conn.fetch = AsyncMock(return_value=[])
+        _patch_tenant_tx(monkeypatch, mock_conn)
+
+        ctx = _build_ctx()
+        with pytest.raises(JsonRpcError) as exc_info:
+            await tool(ctx, MemoryListInput(cursor="invalid!!!"))
+
+        assert exc_info.value.data is not None
+        assert "errors" in exc_info.value.data
+        errors = exc_info.value.data["errors"]
+        assert isinstance(errors, list)
+
+    @pytest.mark.asyncio
+    async def test_error_data_has_cursor_path(
+        self, monkeypatch: pytest.MonkeyPatch
+    ) -> None:
+        """Error data should indicate cursor field error."""
+        tool = MemoryListTool()
+        mock_conn = AsyncMock()
+        mock_conn.fetch = AsyncMock(return_value=[])
+        _patch_tenant_tx(monkeypatch, mock_conn)
+
+        ctx = _build_ctx()
+        with pytest.raises(JsonRpcError) as exc_info:
+            await tool(ctx, MemoryListInput(cursor="invalid!!!"))
+
+        errors = exc_info.value.data["errors"]
+        # Should have an error for the cursor field
+        cursor_error = next((e for e in errors if e.get("path") == "cursor"), None)
