+class TestSinceUntilBoundaries:
+    """Test since and until filter boundaries."""
+
+    @pytest.mark.asyncio
+    async def test_since_includes_boundary(
+        self, pg_pool: Any, list_setup: dict[str, Any]
+    ) -> None:
+        """since should include memories with created_at exactly equal to since."""
+        tenant_id = list_setup["tenant_id"]
+        team_id = list_setup["team_id"]
+
+        exact_time = datetime(2025, 6, 1, 12, 0, tzinfo=UTC)
+
+        mem_inside = await insert_memory(
+            pg_pool,
+            tenant_id=tenant_id,
+            content="memory inside since boundary",
+            team_id=team_id,
+            created_at=exact_time,
+        )
+        mem_before = await insert_memory(
+            pg_pool,
+            tenant_id=tenant_id,
+            content="memory before since boundary",
+            team_id=team_id,
+            created_at=exact_time - timedelta(hours=1),
+        )
+
+        tool = MemoryListTool()
+        ctx = _build_ctx(
+            pg_pool, tenant_id, list_setup["identity_id"], "req-since-boundary"
+        )
+
+        result = await tool(ctx, MemoryListInput(since=exact_time, limit=10))
+
+        result_ids = {r.id for r in result.results}
+        assert mem_inside in result_ids
+        assert mem_before not in result_ids
+
+    @pytest.mark.asyncio
+    async def test_until_includes_boundary(
+        self, pg_pool: Any, list_setup: dict[str, Any]
+    ) -> None:
