+def _build_ctx(
+    *, db_pool: Any = None, deps: ToolDeps | None = None
+) -> ToolContext:
+    """Build a minimal ToolContext for testing."""
+    if deps is None:
+        deps = ToolDeps(
+            embeddings=MagicMock(),
+            audit=NoopAuditLogger(),
+            quotas=NoopQuotas(),
+        )
+    return ToolContext(
+        request_id=str(uuid4()),
+        tenant_id=uuid4(),
+        identity_id=uuid4(),
+        client_id="test-client",
+        scopes=frozenset(["memory.read"]),
+        db_pool=db_pool or MagicMock(),
+        deps=deps,
+    )
+
+
+class CapturingAuditLogger:
+    """Audit logger that captures calls for assertion."""
+
+    def __init__(self) -> None:
+        self.calls: list[dict[str, Any]] = []
+
+    async def audit(
+        self,
+        conn: Any,
+        *,
+        action: str,
+        result: str,
+        tenant_id: UUID,
+        identity_id: str | None = None,
+        client_id: str | None = None,
+        target_id: Any = None,
+        target_kind: str | None = None,
+        ip_address: str | None = None,
+        user_agent: str | None = None,
+        request_id: str | None = None,
+        error_code: str | None = None,
+        details: dict[str, Any] | None = None,
+    ) -> None:
+        self.calls.append(
+            {
+                "action": action,
+                "result": result,
+                "tenant_id": tenant_id,
+                "identity_id": identity_id,
+                "client_id": client_id,
+                "target_id": target_id,
+                "target_kind": target_kind,
+                "ip_address": ip_address,
+                "user_agent": user_agent,
+                "request_id": request_id,
+                "error_code": error_code,
+                "details": details,
+            }
+        )
+
+
+def _patch_tenant_tx(
+    monkeypatch: pytest.MonkeyPatch, conn: AsyncMock
+) -> None:
+    """Patch tenant_tx to yield our fake conn."""
+
+    @asynccontextmanager
+    async def fake_tx(pool: Any, tenant_id: Any) -> Any:
+        yield conn
+
+    monkeypatch.setattr("mem_mcp.mcp.tools.list.tenant_tx", fake_tx)
+
