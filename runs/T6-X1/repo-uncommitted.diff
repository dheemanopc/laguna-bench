+# --------------------------------------------------------------------------
+# Tenant isolation tests
+# --------------------------------------------------------------------------
+
+
+class TestTenantIsolation:
+    """Test that memories are isolated by tenant."""
+
+    @pytest.mark.asyncio
+    async def test_tenant_filter_isolation(
+        self, pg_pool: Any, list_setup: dict[str, Any]
+    ) -> None:
+        """Memories from different tenants should not mix."""
+        tenant_id = list_setup["tenant_id"]
+        team_id = list_setup["team_id"]
+
+        # Insert memory in tenant A
+        mem_a = await insert_memory(
+            pg_pool, tenant_id=tenant_id, content="tenant A memory", team_id=team_id
+        )
+
+        tool = MemoryListTool()
+        ctx = _build_ctx(
+            pg_pool, tenant_id, list_setup["identity_id"], "req-tenant-iso"
+        )
+
+        result = await tool(ctx, MemoryListInput(limit=10))
+
+        result_ids = {r.id for r in result.results}
+        assert mem_a in result_ids
+
