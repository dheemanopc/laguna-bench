+# mypy: disable-error-code="attr-defined"
+# BaseTool.__call__ is declared to return BaseModel, so mypy cannot see the
+# concrete output models' fields. Suppressed at module level; the assertions
+# themselves are what give these tests value.
+"""Behaviour integration tests for memory_list tool.
+
+These tests exercise the real Postgres database with tenant isolation,
+verifying filtering, pagination, and output behavior.
+
+Uses the pg_pool fixture and sets up tenant + team + identity + oauth_client
+per test following the test_mindmap_e2e.py pattern.
+"""
+
+from __future__ import annotations
+
+from collections.abc import AsyncIterator
+from datetime import UTC, datetime, timedelta
+from typing import Any
+from unittest.mock import MagicMock
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.audit.logger import NoopAuditLogger
+from mem_mcp.db.tenant_tx import system_tx
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.list import MemoryListInput, MemoryListTool
+
+# --------------------------------------------------------------------------
+# Test helpers
+# --------------------------------------------------------------------------
+
+
+class RecordingAuditLogger:
+    """Audit logger that records calls for verification."""
+
+    def __init__(self) -> None:
+        self.calls: list[dict[str, Any]] = []
+
+    async def audit(
+        self,
+        conn: Any,
+        *,
+        action: str,
+        result: str,
+        tenant_id: UUID,
+        identity_id: str | None = None,
+        client_id: str | None = None,
+        target_id: Any = None,
+        target_kind: str | None = None,
+        ip_address: str | None = None,
+        user_agent: str | None = None,
+        request_id: str | None = None,
+        error_code: str | None = None,
+        details: dict[str, Any] | None = None,
+    ) -> None:
+        self.calls.append(
+            {
+                "action": action,
+                "result": result,
+                "tenant_id": tenant_id,
+                "identity_id": identity_id,
+                "client_id": client_id,
+                "target_id": target_id,
+                "target_kind": target_kind,
+                "ip_address": ip_address,
+                "user_agent": user_agent,
+                "request_id": request_id,
+                "error_code": error_code,
+                "details": details,
+            }
+        )
+
+
+def _build_ctx(
+    pool: Any,
+    tenant_id: UUID,
+    identity_id: UUID,
+    request_id: str,
+    client_id: str = "test-client",
+    deps: ToolDeps | None = None,
+) -> ToolContext:
+    """Build a ToolContext with real DB pool."""
+    if deps is None:
+        deps = ToolDeps(
+            embeddings=MagicMock(),
+            audit=NoopAuditLogger(),
+            quotas=NoopQuotas(),
+        )
+    return ToolContext(
+        request_id=request_id,
+        tenant_id=tenant_id,
+        identity_id=identity_id,
+        client_id=client_id,
+        scopes=frozenset(["memory.read"]),
+        db_pool=pool,
+        deps=deps,
+    )
+
+
+async def insert_memory(
+    pool: Any,
+    tenant_id: UUID,
+    content: str,
+    team_id: UUID | None = None,
+    created_at: datetime | None = None,
+    updated_at: datetime | None = None,
+    type: str = "note",
+    tags: list[str] | None = None,
+    indexable: bool = True,
+    parent_id: UUID | None = None,
+) -> UUID:
+    """Insert a memory row for testing. Returns the new memory ID."""
+    now = datetime.now(tz=UTC)
+    created = created_at or now
+    updated = updated_at or now
+    tag_list = tags or []
+    parent_val = parent_id
+
+    async with system_tx(pool) as conn:
+        mem_id = await conn.fetchval(
+            """
+            INSERT INTO memories (tenant_id, team_id, content, content_hash, embedding, source_kind, type, tags, created_at, updated_at, visibility, indexable, parent_id)
+            VALUES ($1, $2, $3, encode(digest($3, 'sha256'), 'hex'), array_fill(0::real, ARRAY[1024])::vector, 'api', $4, $5, $6, $7, 'team', $8, $9)
+            RETURNING id
+            """,
+            tenant_id,
+            team_id,
+            content,
+            type,
+            tag_list,
+            created,
+            updated,
+            indexable,
+            parent_val,
+        )
+    assert mem_id is not None
+    return UUID(str(mem_id))
+
