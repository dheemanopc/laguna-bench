+# BaseTool.__call__ is declared to return BaseModel, so mypy cannot see the
+# concrete output models' fields. Suppressed at module level; the assertions
+# themselves are what give these tests value.
+"""Behavioural contract tests for memory_list tool.
+
+Tests the InputModel validation, cursor helpers, SQL generation,
+audit details, deps-missing error, and output model structure.
+Pure/mocked tests - no real DB required.
+"""
