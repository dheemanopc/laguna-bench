+        """Missing key should log warning with key and truncated template."""
+        with caplog.at_level(logging.WARNING):
+            _render("Hello {name}, your {missing} is ready", {"name": "World"})
+
+        warnings = [r for r in caplog.records if "notice_template_missing_key" in r.message]
+        assert len(warnings) == 1
+        # Check extra contains key and template (added via logging extra=)
+        assert warnings[0].key == "missing"  # type: ignore[attr-defined]
+        # Template should be truncated to 120 chars
+        assert len(warnings[0].template) <= 120  # type: ignore[attr-defined]
+
+    def test_template_truncation_at_120_chars(
+        self, caplog: pytest.LogCaptureFixture
+    ) -> None:
+        """Template in warning should be truncated to exactly 120 chars."""
+        long_template = "x" * 200
+        with caplog.at_level(logging.WARNING):
+            _render(f"Template: {long_template} and {{missing}} more", {})
+
+        warnings = [r for r in caplog.records if "notice_template_missing_key" in r.message]
+        assert len(warnings) == 1
+        # Check template truncation - should be exactly 120 chars
+        template_in_warning = warnings[0].template  # type: ignore[attr-defined]
+        assert len(template_in_warning) == 120  # type: ignore[attr-defined]
+
+    def test_multiple_missing_keys_each_logs_warning(
+        self, caplog: pytest.LogCaptureFixture
+    ) -> None:
