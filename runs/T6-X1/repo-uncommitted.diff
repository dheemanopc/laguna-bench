+async def list_setup(pg_pool: Any) -> AsyncIterator[dict[str, Any]]:
+    """Set up tenant, team, identity, and oauth_client for testing."""
+    from mem_mcp.teams.assignments import assign_role
+
+    tenant_id = uuid4()
+    team_id = uuid4()
+    identity_id = uuid4()
+    client_id = f"client:tenant-{tenant_id.hex[:8]}"
+
+    async with system_tx(pg_pool) as conn:
+        await conn.execute(
+            "INSERT INTO tenants (id, email, status) VALUES ($1, $2, 'active')",
+            tenant_id,
+            f"tenant-test-{tenant_id.hex[:8]}@test.invalid",
+        )
+        await conn.execute(
+            "INSERT INTO teams (id, name, created_by_tenant_id) VALUES ($1, $2, $3)",
+            team_id,
+            f"team-test-{tenant_id.hex[:8]}",
+            tenant_id,
+        )
+        await assign_role(
+            conn,
+            parent_team_id=team_id,
+            member_kind="user",
+            member_id=tenant_id,
+            role_key="member",
+            assigned_by_user_id=tenant_id,
+        )
+        await conn.execute(
+            """
+            INSERT INTO tenant_identities
+            (id, tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+            VALUES ($1, $2, $3, $4, $5, true, $6)
+            """,
+            identity_id,
+            tenant_id,
+            f"sub-{tenant_id.hex[:8]}",
+            "cognito",
+            f"tenant-test-{identity_id.hex[:8]}@test.invalid",
+            team_id,
+        )
+        await conn.execute(
+            """
+            INSERT INTO oauth_clients
+            (id, redirect_uris, scope, registration_payload, review_status)
+            VALUES ($1, ARRAY[]::text[], 'memory.read memory.write', '{}'::jsonb, 'auto_allowed')
+            """,
+            client_id,
+        )
+
+    yield {
+        "tenant_id": tenant_id,
+        "team_id": team_id,
+        "identity_id": identity_id,
+        "client_id": client_id,
+    }
+
+    # Cleanup
+    async with system_tx(pg_pool) as conn:
+        await conn.execute("DELETE FROM memories WHERE tenant_id = $1", tenant_id)
+        await conn.execute(
+            "DELETE FROM team_role_assignments WHERE parent_team_id = $1", team_id
+        )
+        await conn.execute(
+            "DELETE FROM tenant_identities WHERE tenant_id = $1", tenant_id
+        )
+        await conn.execute("DELETE FROM teams WHERE id = $1", team_id)
+        await conn.execute("DELETE FROM tenants WHERE id = $1", tenant_id)
+        await conn.execute("DELETE FROM oauth_clients WHERE id = $1", client_id)
