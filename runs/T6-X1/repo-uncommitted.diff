+
+    @pytest.mark.asyncio
+    async def test_multiple_tags_and_semantics(
+        self, pg_pool: Any, list_setup: dict[str, Any]
+    ) -> None:
+        """Multiple tags should use AND semantics - memory must have ALL tags."""
+        tenant_id = list_setup["tenant_id"]
+        team_id = list_setup["team_id"]
+
+        await insert_memory(
+            pg_pool,
+            tenant_id=tenant_id,
+            content="memory with both tags",
+            team_id=team_id,
+            tags=["tag1", "tag2"],
