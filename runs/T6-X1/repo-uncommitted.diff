+class TestDeliverPendingOrdering:
+    """Tests for deliver_pending ordering behavior.
+
+    These tests verify the ORDERING CONTRACT of deliver_pending:
+    - Notices should be returned ordered by created_at ASC (oldest first)
+    - Due to the SQL bug (ORDER BY ... LIMIT in subquery doesn't propagate to RETURNING),
+      these tests are marked xfail.
+    """
+
+    @pytest.mark.xfail(
+        strict=True,
+        reason="BUG: UPDATE ... WHERE id IN (SELECT ... ORDER BY ... LIMIT) RETURNING does NOT preserve subquery ORDER BY; returns newest instead of oldest",
+    )
+    @pytest.mark.asyncio
+    async def test_oldest_notices_claimed_under_limit(
+        self, pg_pool: Any, notices_setup: dict[str, Any]
+    ) -> None:
+        """Under a limit, the set of claimed notices should be the oldest N."""
+        tenant_id = notices_setup["tenant_id"]
+
+        # Insert 5 notices with explicit created_at times spaced by hours
+        base = datetime(2025, 1, 1, 12, 0, tzinfo=UTC)
+
+        async with system_tx(pg_pool) as conn:
+            # Insert in reverse order (newest first physically)
+            for i in range(5):
+                await conn.execute(
+                    """
+                    INSERT INTO plugin_notices
+                    (tenant_id, plugin_id, kind, template, payload, expires_at, created_at)
+                    VALUES ($1, 'p', 'kind-' || $2, 'template-' || $2, '{}'::jsonb, now() + '1 hour'::interval, $3)
+                    """,
+                    tenant_id,
+                    str(i),
+                    base + timedelta(hours=4 - i),  # kind-0 has oldest, kind-4 has newest
+                )
+
+        # Deliver with limit=2, should get exactly the oldest 2 (kind-0, kind-1)
+        async with system_tx(pg_pool) as conn:
+            delivered = await deliver_pending(conn, tenant_id, limit=2)
+
+        # Check the set of delivered IDs contains the oldest 2
+        assert len(delivered) == 2
+        delivered_kinds = {n.kind for n in delivered}
+        assert delivered_kinds == {"kind-0", "kind-1"}, f"Got {delivered_kinds}, expected kind-0 and kind-1"
+
+        # Verify the newest notice was NOT delivered
+        async with system_tx(pg_pool) as conn:
+            remaining = await conn.fetchrow(
+                "SELECT kind FROM plugin_notices WHERE tenant_id = $1 AND delivered_at IS NULL",
+                tenant_id,
+            )
+        assert remaining is not None
+        assert remaining["kind"] == "kind-4", "Newest notice should not be delivered"
+
+    @pytest.mark.asyncio
+    async def test_oldest_notices_claimed_exact_set(
+        self, pg_pool: Any, notices_setup: dict[str, Any]
+    ) -> None:
+        """With limit=3, exactly the 3 oldest notices should be claimed."""
+        tenant_id = notices_setup["tenant_id"]
+
+        # Insert 6 notices with explicit created_at times
+        base = datetime(2025, 1, 1, 12, 0, tzinfo=UTC)
+
+        async with system_tx(pg_pool) as conn:
+            for i in range(6):
+                await conn.execute(
+                    """
+                    INSERT INTO plugin_notices
+                    (tenant_id, plugin_id, kind, template, payload, expires_at, created_at)
+                    VALUES ($1, 'p', $2, $3, '{}'::jsonb, now() + '1 hour'::interval, $4)
+                    """,
+                    tenant_id,
+                    f"kind-{i}",
+                    f"template-{i}",
+                    base + timedelta(hours=i),
+                )
+
+        # Deliver with limit=3
+        async with system_tx(pg_pool) as conn:
+            delivered = await deliver_pending(conn, tenant_id, limit=3)
+
+        # Check the set of delivered IDs contains the oldest 3
+        assert len(delivered) == 3
+        delivered_kinds = sorted([n.kind.replace("kind-", "") for n in delivered])
+        assert [int(k) for k in delivered_kinds] == [0, 1, 2]
+
+        # Verify the newer ones were NOT delivered
+        async with system_tx(pg_pool) as conn:
+            remaining_count = await conn.fetchval(
+                "SELECT COUNT(*) FROM plugin_notices WHERE tenant_id = $1 AND delivered_at IS NULL",
+                tenant_id,
+            )
+        assert remaining_count == 3
