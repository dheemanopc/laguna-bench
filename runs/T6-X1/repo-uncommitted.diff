+
+    Per order-2.md section 3, invalid cursor bugs are reframed at the TOOL level.
+    The contract is: an invalid cursor passed to MemoryListTool must raise
+    JsonRpcError code -32602, message "invalid cursor".
+    """
+
+    @pytest.mark.asyncio
+    async def test_garbage_non_base64_raises_jsonrpc_error(
+        self, monkeypatch: pytest.MonkeyPatch
+    ) -> None:
+        """Garbage non-base64 should raise JsonRpcError with code -32602."""
+        tool = MemoryListTool()
+        mock_conn = AsyncMock()
+        mock_conn.fetch = AsyncMock(return_value=[])
+        _patch_tenant_tx(monkeypatch, mock_conn)
+
+        ctx = _build_ctx()
+        with pytest.raises(JsonRpcError) as exc_info:
+            await tool(ctx, MemoryListInput(cursor="not valid base64!!!"))
+
+        assert exc_info.value.code == -32602
+        assert "invalid cursor" in exc_info.value.message
