+class TestCursorDecoding:
+    """Tests for _decode_cursor function."""
+
+    def test_round_trip(self) -> None:
+        dt = datetime(2025, 6, 15, 14, 22, 33, tzinfo=UTC)
+        id_ = uuid4()
+        encoded = _encode_cursor(dt, id_)
+        result_dt, result_id = _decode_cursor(encoded)
+
+        assert result_id == str(id_)
+        assert result_dt == dt.isoformat()
+
+    def test_decodes_correct_types(self) -> None:
+        dt = datetime(2025, 1, 1, 12, 0, 0, tzinfo=UTC)
+        id_ = uuid4()
+        encoded = _encode_cursor(dt, id_)
+        dt_iso, id_str = _decode_cursor(encoded)
+
+        # dt_iso is a string, id_str is a string
+        assert isinstance(dt_iso, str)
+        assert isinstance(id_str, str)
+
+    def test_non_base64_garbage_raises_valueerror(self) -> None:
+        with pytest.raises(ValueError):
+            _decode_cursor("not valid base64!!!")
+
+    def test_base64_non_json_raises_valueerror(self) -> None:
+        # Valid base64 that doesn't decode to JSON
+        garbage = base64.urlsafe_b64encode(b"not json").decode()
+        with pytest.raises(ValueError):
+            _decode_cursor(garbage)
+
+    def test_base64_json_array_missing_elements(self) -> None:
+        # Base64 of JSON array with wrong structure
+        payload = base64.urlsafe_b64encode(json.dumps([]).encode()).decode()
+        with pytest.raises(ValueError):
+            _decode_cursor(payload)
+
+    # These three xfails removed per order-2.md section 3
+
