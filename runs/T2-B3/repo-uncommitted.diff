+            outsider_sdk = sdk_client_factory(
+                tenant_id=outsider_setup["tenant"], plugin_id=PLUGIN_ID
+            )
+
+            # Outsider cites owner's team memory — should succeed via cache row
+            citer_id = await outsider_sdk.write(
+                content="outsider cites team memory",
+                type="note",
+                references=[
+                    ReferenceInput(target_uuid=target_id, reference_kind="cites")
+                ],
