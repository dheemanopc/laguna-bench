+"""Unit tests for the shared memory access rule in teams.references.
+
+Focused tests for ``caller_can_access_memory`` (the single-SQL EXISTS helper)
+and ``caller_can_access_memory_row`` (the row-based variant used when the
+memory row is already fetched).
+
+Run:  pytest -q -p no:cacheprovider tests/unit/test_references_access_rule.py
+"""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from typing import TYPE_CHECKING, Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.teams.references import (
+    caller_can_access_memory,
+    caller_can_access_memory_row,
+)
+
+if TYPE_CHECKING:
+    import asyncpg  # type: ignore[import-untyped]
+
+
+pytestmark = pytest.mark.asyncio
+
+PLUGIN_ID = "plugin:refs-rule-test"
+
+
+# ── Shared helpers ────────────────────────────────────────────────────
+
+
+async def _insert_memory(
+    conn: asyncpg.Connection,
+    *,
+    owner_tenant_id: UUID,
+    team_id: UUID | None,
+    content: str = "test memory",
+    type_: str = "note",
+    deleted: bool = False,
+) -> UUID:
+    """Insert a memory row directly via raw SQL (bypasses SDK write tool)."""
+    mem_id = await conn.fetchval(
+        "INSERT INTO memories "
+        "(tenant_id, team_id, content, content_hash, embedding, source_kind, type, visibility, deleted_at) "
+        "VALUES ($1, $2, $3, $4, array_fill(0::real, ARRAY[1024])::vector, 'api', $5, $6, $7) "
+        "RETURNING id",
+        owner_tenant_id,
+        team_id,
+        content,
+        f"hash-{uuid4().hex}",
+        type_,
+        "team",
+        datetime.now(UTC) if deleted else None,
+    )
+    assert isinstance(mem_id, UUID)
+    return mem_id
+
+
+async def _insert_tenant(conn: asyncpg.Connection, label: str) -> UUID:
+    """Insert a tenant row and return its UUID."""
+    tid = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"{label}-{uuid4()}@example.test",
+    )
+    assert isinstance(tid, UUID)
+    return tid
+
+
+async def _insert_team(conn: asyncpg.Connection, owner_tenant_id: UUID, label: str) -> UUID:
+    """Insert a personal team owned by owner_tenant_id and return its UUID."""
+    tid = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id, team_type) "
+        "VALUES ($1, $2, 'personal') RETURNING id",
+        f"{label}-{uuid4().hex[:8]}",
+        owner_tenant_id,
+    )
+    assert isinstance(tid, UUID)
+    return tid
+
+
+async def _insert_owner_assignment(
+    conn: asyncpg.Connection, *, team_id: UUID, tenant_id: UUID
+) -> None:
+    """Raw SQL owner assignment — NO sync_refresh_on_user_assignment, so no
+    user_effective_team_access cache row. Mimics 0026 backfill provisioning."""
+    role_id = await conn.fetchval(
+        "SELECT id FROM roles_catalog WHERE role_key = 'owner' AND plugin_id IS NULL"
+    )
+    await conn.execute(
+        """
+        INSERT INTO team_role_assignments
+            (parent_team_id, member_kind, member_id, role_id, status, assigned_by_user_id)
+        VALUES ($1, 'user', $2, $3, 'active', $2)
+        """,
+        team_id,
+        tenant_id,
+        role_id,
+    )
+
+
+async def _insert_cache_row(
+    conn: asyncpg.Connection, *, user_id: UUID, team_id: UUID, role_class: str = "external"
+) -> None:
+    """Manually insert a user_effective_team_access cache row (simulates the
+    reconciler or sync_refresh having already run)."""
+    await conn.execute(
+        """
+        INSERT INTO user_effective_team_access
+            (user_id, resource_team_id, effective_role_class,
+             effective_perms, path_count, refreshed_at)
+        VALUES ($1, $2, $3, ARRAY['memory.read']::text[], 1, now())
+        """,
+        user_id,
+        team_id,
+        role_class,
+    )
+
+
+# ── caller_can_access_memory: owner branch ───────────────────────────
+
+
+class TestCallerCanAccessMemoryOwner:
+    async def test_owner_can_access_own_memory_without_cache(self, pg_pool: Any) -> None:
+        """Owner (tenant_id match) can access their own memory — no cache row needed.
+
+        This is the core regression: 0026-backfill-provisioned users have a
+        team_role_assignments row but NO user_effective_team_access row.
+        The old code checked only the cache (missed the owner). The fix adds
+        the ``m.tenant_id = $2`` owner check directly in SQL.
+        """
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                owner = await _insert_tenant(conn, "owner")
+                team = await _insert_team(conn, owner, "own")
+                await _insert_owner_assignment(conn, team_id=team, tenant_id=owner)
+                mem_id = await _insert_memory(
+                    conn, owner_tenant_id=owner, team_id=team, content="owned"
+                )
+
+                result = await caller_can_access_memory(
+                    conn, memory_id=mem_id, caller_user_id=owner
