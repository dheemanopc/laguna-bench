+# ── Shared access rule ──────────────────────────────────────────────
+#
+# A caller can access a memory if:
+#   (1) They are the owner — memories.tenant_id = caller_user_id. This
+#       matches what memory_get lets the caller read via tenant_tx + the
+#       RLS memories_select policy (tenant_id = app.current_tenant_id).
+#       Critical for raw-SQL-provisioned users (migration 0026 backfill
+#       style) who have a tenant + personal-team + owner role assignment
+#       and a primary tenant_identities row, but NO user_effective_team_access
+#       cache row — that cache is only populated by the team-management API
+#       (sync_refresh_on_user_assignment) or the periodic reconciler job.
+#   (2) The memory has a non-NULL team_id AND the caller has an effective-
+#       access row in user_effective_team_access for that team. Preserves
+#       existing cross-tenant team sharing.
+#
+# NULL team_id: only (1) can grant access — a non-owner can NEVER see a
+# NULL-team memory. This closes a leak in the old code which skipped the
+# check entirely when team_id was NULL, making cross-tenant NULL-team
+# memories accessible to anyone.
+#
+# The rule lives in exactly ONE place: caller_can_access_memory_row.
+# caller_can_access_memory fetches the row and delegates to it.
+#
+# NOTE on tenant scoping: these helpers query `memories` ACROSS tenants
+# because references can legitimately point at memories owned by a DIFFERENT
+# tenant in a shared/cross-team context. The visibility-gating is via the
+# owner check (tenant_id = caller) + user_effective_team_access, not via a
+# same-tenant filter. The tenant-scope linter exempts this module for that
+# reason (see tools/lint_tenant_scope.py EXEMPT_PREFIXES).
+
+
+async def caller_can_access_memory_row(
+    conn: asyncpg.Connection,
+    *,
+    memory_tenant_id: UUID,
+    memory_team_id: UUID | None,
+    caller_user_id: UUID,
+) -> bool:
+    """THE single source of truth for the memory access rule.
+
+    A caller can access a memory if:
+      (1) They are the owner (``memory_tenant_id == caller_user_id``) — cheap
+          Python ``==``, no extra query. Matches what ``memory_get`` lets the
+          caller read via tenant_tx + RLS (tenant_id = app.current_tenant_id).
+      (2) The memory has a non-NULL team_id AND the caller has an
+          ``user_effective_team_access`` row for that team (SQL ``EXISTS``).
+
+    NULL ``memory_team_id``: only (1) can grant access — a non-owner is NEVER
+    admitted. This closes a leak in the old code which skipped the check
+    entirely when team_id was NULL, making cross-tenant NULL-team memories
+    accessible to anyone.
+
+    Used by call sites that already have the memory row (via JOIN or prior
+    fetch) and therefore already have ``tenant_id`` / ``team_id`` in hand.
+    """
+    if memory_tenant_id == caller_user_id:
+        return True
+    if memory_team_id is None:
+        return False
+    return bool(
+        await conn.fetchval(
+            "SELECT EXISTS ("
+            "    SELECT 1 FROM user_effective_team_access "
+            "    WHERE user_id = $1 AND resource_team_id = $2"
+            ")",
+            caller_user_id,
+            memory_team_id,
+        )
+    )
+
+
+async def caller_can_access_memory(
+    conn: asyncpg.Connection,
+    *,
+    memory_id: UUID,
+    caller_user_id: UUID,
+    include_deleted: bool = False,
+) -> bool:
+    """Return True if *caller_user_id* can see the memory identified by *memory_id*.
+
+    Fetches the memory's ``tenant_id`` / ``team_id`` (respecting
+    *include_deleted*) and delegates to :func:`caller_can_access_memory_row`
+    so the access rule lives in exactly one place.
+
+    Returns ``False`` if no row exists (memory absent, deleted, or filtered).
+
+    *include_deleted*: when ``True`` the ``deleted_at IS NULL`` filter is
+    omitted — use when the caller may legitimately address a soft-deleted
+    memory (e.g. hard-delete protection, refs_in/refs_out where the caller
+    owns the memory and can still read it via ``memory_get`` which does not
+    filter on ``deleted_at``).
+    """
+    deleted_clause = "" if include_deleted else "AND m.deleted_at IS NULL"
+    row = await conn.fetchrow(
+        f"""
+        SELECT tenant_id, team_id
+        FROM memories m
+        WHERE m.id = $1
+          {deleted_clause}
+        """,
+        memory_id,
+    )
+    if row is None:
+        return False
+    return await caller_can_access_memory_row(
+        conn,
+        memory_tenant_id=row["tenant_id"],
+        memory_team_id=row["team_id"],
+        caller_user_id=caller_user_id,
+    )
+
