new file mode 100644
index 0000000..a6103f5
--- /dev/null
+++ b/tests/integration/test_references_access_rule.py
@@ -0,0 +1,678 @@
+"""Integration tests for the shared memory access rule in teams.references.
+
+Covers the 0026-backfill-user access bug: a user provisioned via raw SQL
+(no ``user_effective_team_access`` cache row) can reference their OWN memory.
+Also covers the NULL-team leak closure, IT-08 opaque-error contract,
+cross-tenant cite via team-access cache row, and refs_in/refs_out +
+check_hard_delete filtering.
+
+Run:  pytest -q -p no:cacheprovider tests/integration/test_references_access_rule.py
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.mcp.tools.write import ReferenceInput
+from mem_mcp.plugins.contract import PluginValidationError
+from mem_mcp.teams.assignments import assign_role
+from mem_mcp.teams.references import (
+    HardDeleteBlockedError,
+    check_hard_delete_with_filtered_citers,
+    insert_reference,
+)
+
+pytestmark = pytest.mark.asyncio
+
+PLUGIN_ID = "refs-rule-test"
+
+
+# ── Shared helpers ────────────────────────────────────────────────────
+
+
+async def _provision_user_like_backfill(
+    conn: Any, label: str = "rule"
+) -> dict[str, Any]:
+    """Tenant + personal team + owner assignment + primary identity via raw SQL
+    (the 0026 backfill pattern — no user_effective_team_access cache row).
+
+    The caller is the owner of their personal team via a direct
+    ``team_role_assignments`` row, but ``sync_refresh_on_user_assignment``
+    is never called, so there is NO ``user_effective_team_access`` row.
+    This is the exact gap that caused the original bug.
+    """
+    tenant = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"{label}-{uuid4()}@example.test",
+    )
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id, team_type) "
+        "VALUES ($1, $2, 'personal') RETURNING id",
+        f"{label}-{uuid4().hex[:8]}",
+        tenant,
+    )
+    owner_role_id = await conn.fetchval(
+        "SELECT id FROM roles_catalog WHERE role_key = 'owner' AND plugin_id IS NULL"
+    )
+    await conn.execute(
+        """
+        INSERT INTO team_role_assignments
+            (parent_team_id, member_kind, member_id, role_id, status, assigned_by_user_id)
+        VALUES ($1, 'user', $2, $3, 'active', $2)
+        """,
+        team,
+        tenant,
+        owner_role_id,
+    )
+    await conn.execute(
+        """
+        INSERT INTO tenant_identities
+        (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+        VALUES ($1, $2, 'cognito', $3, true, $4)
+        """,
+        tenant,
+        f"sub-{label}-{tenant}",
+        f"{label}-{tenant}@example.test",
+        team,
+    )
+    await conn.execute(
+        """
+        INSERT INTO oauth_clients
+        (id, redirect_uris, scope, registration_payload, review_status)
+        VALUES ($1, ARRAY[]::text[], 'memory.read memory.write',
+                '{}'::jsonb, 'auto_allowed')
+        ON CONFLICT (id) DO NOTHING
+        """,
+        f"plugin:{PLUGIN_ID}",
+    )
+    return {"tenant": tenant, "team": team}
+
+
+async def _insert_memory(
+    conn: Any,
+    *,
+    owner_tenant_id: UUID,
+    team_id: UUID | None,
+    type_: str = "note",
+    content: str = "test memory",
+    visibility: str = "team",
+) -> UUID:
+    """Insert a memory row directly via raw SQL (bypasses SDK write tool)."""
+    mem_id = await conn.fetchval(
+        "INSERT INTO memories "
+        "(tenant_id, team_id, content, content_hash, embedding, source_kind, type, visibility) "
+        "VALUES ($1, $2, $3, $4, array_fill(0::real, ARRAY[1024])::vector, 'api', $5, $6) "
+        "RETURNING id",
+        owner_tenant_id,
+        team_id,
+        content,
+        f"hash-{uuid4().hex}",
+        type_,
+        visibility,
+    )
+    assert isinstance(mem_id, UUID)
+    return mem_id
+
+
+async def _cleanup(pool: Any, tenant: UUID, team: UUID) -> None:
+    """Clean up all data for a provisioned tenant + team (idempotent)."""
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute(
+                """
+                DELETE FROM memory_references
+                WHERE source_memory_id IN (SELECT id FROM memories WHERE tenant_id = $1)
+                   OR target_memory_id IN (SELECT id FROM memories WHERE tenant_id = $1)
+                """,
+                tenant,
+            )
+            await conn.execute("DELETE FROM slugs WHERE team_id = $1", team)
+            await conn.execute("DELETE FROM memories WHERE tenant_id = $1", tenant)
+            await conn.execute(
+                "DELETE FROM team_role_assignments WHERE parent_team_id = $1", team
+            )
+            await conn.execute(
+                "DELETE FROM team_role_assignments WHERE member_id = $1 AND member_kind = 'user'",
+                tenant,
+            )
+            await conn.execute(
+                "DELETE FROM user_effective_team_access WHERE user_id = $1", tenant
+            )
+            await conn.execute("DELETE FROM tenant_identities WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM teams WHERE id = $1", team)
+            await conn.execute("DELETE FROM tenants WHERE id = $1", tenant)
+
+
+# ── Scenario 1: own-memory cite by UUID ──────────────────────────────
+
+
+class TestOwnMemoryCiteByUuid:
+    async def test_citing_own_memory_by_uuid_succeeds(
+        self, pg_pool: Any, sdk_client_factory: Any
+    ) -> None:
+        """0026-backfill user cites their own memory by UUID — succeeds.
+
+        Regression: previously raised ``memory_not_accessible`` because the
+        references machinery only checked ``user_effective_team_access`` (a
+        cache the raw-SQL-provisioned user has no row in). The owner check
+        in the shared access rule covers this case.
+        """
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                setup = await _provision_user_like_backfill(conn, label="own-uuid")
+        try:
+            sdk = sdk_client_factory(tenant_id=setup["tenant"], plugin_id=PLUGIN_ID)
+
+            target_id = await sdk.write(content="target memory for ref", type="note")
+            assert target_id is not None
+
+            # The memory is readable by its owner...
+            got = await sdk.get(memory_id=target_id)
+            assert got is not None
+            assert str(got["id"]) == str(target_id)
+
+            # ...so citing it from a new memory of the same user must work.
+            citer_id = await sdk.write(
+                content="citer memory with reference",
+                type="note",
+                references=[
+                    ReferenceInput(target_uuid=target_id, reference_kind="cites")
+                ],
+            )
+            assert citer_id is not None
+
+            async with pg_pool.acquire() as vconn:
+                n = await vconn.fetchval(
+                    "SELECT COUNT(*) FROM memory_references "
+                    "WHERE source_memory_id = $1 AND target_memory_id = $2",
+                    citer_id,
+                    target_id,
+                )
+            assert n == 1
