+                mem_id = await _insert_memory(
+                    conn,
+                    owner_tenant_id=owner,
+                    team_id=team,
+                    content="to be deleted",
+                    deleted=True,
+                )
+
+                # Default: deleted_at IS NULL filter → owner can't see it
+                assert await caller_can_access_memory(
+                    conn, memory_id=mem_id, caller_user_id=owner
+                ) is False
+
+                # include_deleted=True → owner can see it (tenant_id match)
+                assert await caller_can_access_memory(
+                    conn, memory_id=mem_id, caller_user_id=owner, include_deleted=True
+                ) is True
