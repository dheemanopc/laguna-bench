+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                owner_setup = await _provision_user_like_backfill(conn, label="ta-owner")
+                outsider_setup = await _provision_user_like_backfill(
+                    conn, label="ta-outsider"
+                )
+                # Add outsider as member of owner's personal team via assign_role
+                # → sync_refresh_on_user_assignment populates user_effective_team_access
+                await assign_role(
+                    conn,
+                    parent_team_id=owner_setup["team"],
+                    member_kind="user",
+                    member_id=outsider_setup["tenant"],
+                    role_key="member",
+                    assigned_by_user_id=outsider_setup["tenant"],
