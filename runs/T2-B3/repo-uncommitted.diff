+# ── Scenario 3: cross-tenant rejection (IT-08 opaque) ────────────────
+
+
+class TestCrossTenantOpaqueRejection:
+    async def test_cross_tenant_cite_rejected_with_byte_identical_error(
+        self, pg_pool: Any, sdk_client_factory: Any
+    ) -> None:
+        """Outsider citing A's team memory → memory_not_accessible, byte-identical
+        to citing a UUID that doesn't exist (IT-08 opaque contract).
+
+        Both 'no access' and 'not found' must produce the same ``code``,
+        same ``message``, and same structured ``data`` — otherwise the write
+        tool becomes an existence oracle.
+        """
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                owner_setup = await _provision_user_like_backfill(conn, label="ct-owner")
+                outsider_setup = await _provision_user_like_backfill(
+                    conn, label="ct-outsider"
+                )
+                # A writes a memory in their personal team
+                target_id = await _insert_memory(
+                    conn,
+                    owner_tenant_id=owner_setup["tenant"],
+                    team_id=owner_setup["team"],
+                    content="owner's memory",
+                )
+        try:
+            outsider_sdk = sdk_client_factory(
+                tenant_id=outsider_setup["tenant"], plugin_id=PLUGIN_ID
+            )
+
+            # --- Outsider cites owner's memory (no access) ---
+            err_no_access: PluginValidationError | None = None
+            try:
+                await outsider_sdk.write(
+                    content="attempt to cite owner memory",
+                    type="note",
+                    references=[
+                        ReferenceInput(target_uuid=target_id, reference_kind="cites")
+                    ],
+                )
+            except PluginValidationError as e:
+                err_no_access = e
+
+            # --- Outsider cites a UUID that doesn't exist ---
+            err_miss: PluginValidationError | None = None
+            try:
+                await outsider_sdk.write(
+                    content="attempt to cite nonexistent",
+                    type="note",
+                    references=[
+                        ReferenceInput(target_uuid=uuid4(), reference_kind="cites")
+                    ],
+                )
+            except PluginValidationError as e:
+                err_miss = e
+
+            assert err_no_access is not None, "expected memory_not_accessible"
+            assert err_miss is not None, "expected memory_not_accessible"
+
+            # IT-08: identical code + message + data
+            assert err_no_access.code == err_miss.code
+            assert err_no_access.message == err_miss.message
+            assert err_no_access.data == err_miss.data
+            assert err_no_access.code == "memory_not_accessible"
+            assert err_no_access.message == "reference target not found or not accessible"
+
+            # And the outsider should NOT have created any reference rows
+            async with pg_pool.acquire() as vconn:
+                n = await vconn.fetchval(
+                    "SELECT COUNT(*) FROM memory_references WHERE target_memory_id = $1",
+                    target_id,
+                )
+            assert n == 0
+        finally:
+            await _cleanup(pg_pool, owner_setup["tenant"], owner_setup["team"])
+            await _cleanup(pg_pool, outsider_setup["tenant"], outsider_setup["team"])
+
