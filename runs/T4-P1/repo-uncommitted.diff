+               mm.status, mm.resolution_summary, mm.resolved_by_memory_id,
+               mm.resolved_by_party, mm.resolved_at
         FROM memory_map_membership mm
         JOIN memories m ON m.id = mm.memory_id
         WHERE mm.root_memory_id = $1 AND m.tenant_id = $2 AND m.deleted_at IS NULL
@@ -239,3 +243,110 @@ async def fetch_recent_events(
         d["payload"] = _as_dict(d.get("payload"))
         out.append(d)
     return out
+
+
+async def settle_branch(
+    conn: asyncpg.Connection,
+    *,
+    root_memory_id: UUID,
+    tenant_id: UUID,
+    memory_id: UUID,
+    status: str,
+    resolution_summary: str,
+    resolved_by_memory_id: UUID | None,
+    resolved_by_party: str,
+) -> dict[str, Any]:
+    """Settle a branch (resolved or dropped). Returns the updated row."""
+    # Validate status
+    if status not in ("open", "resolved", "dropped"):
+        raise ValueError(f"Invalid status: {status}")
+
+    # Update the membership record
+    row = await conn.fetchrow(
+        """
+        UPDATE memory_map_membership
+        SET status = $1,
+            resolution_summary = $2,
+            resolved_by_memory_id = $3,
+            resolved_by_party = $4,
+            resolved_at = now()
+        WHERE memory_id = $5
+          AND root_memory_id = $6
+          AND tenant_id = $7
+          AND node_role <> 'root'
+        RETURNING *
+        """,
+        status,
+        resolution_summary,
+        resolved_by_memory_id,
+        resolved_by_party,
+        memory_id,
+        root_memory_id,
+        tenant_id,
+    )
+
+    if row is None:
+        from mem_mcp.mindmap.service import MapNodeNotFoundError
+        raise MapNodeNotFoundError(f"Node {memory_id} is not a member of map {root_memory_id}")
+
+    return dict(row)
+
+
+async def current_cursor(
+    conn: asyncpg.Connection, *, root_memory_id: UUID, tenant_id: UUID
+) -> int:
+    """Get the current cursor (max event id) for a map."""
+    return await conn.fetchval(
+        """
+        SELECT COALESCE(MAX(id), 0) FROM memory_map_events
+        WHERE root_memory_id = $1
+        """,
+        root_memory_id,
+    )
+
+
+async def touched_since(
+    conn: asyncpg.Connection, *, root_memory_id: UUID, tenant_id: UUID, since: int
+) -> set[UUID]:
+    """Get memory ids touched by events with id > since for this map."""
+    if since < 0:
+        raise ValueError("since must be non-negative")
+
+    rows = await conn.fetch(
+        """
+        SELECT DISTINCT mm.memory_id
+        FROM memory_map_membership mm
+        JOIN memory_map_events mme ON mm.root_memory_id = mme.root_memory_id
+        WHERE mm.root_memory_id = $1
+          AND mme.id > $2
+          AND (mme.memory_id IS NOT NULL
+               OR (mme.event = 'link' AND mme.payload->>'target' IS NOT NULL))
+        """,
+        root_memory_id,
+        since,
+    )
+
+    # Also need to get target memory ids from link events
+    target_rows = await conn.fetch(
+        """
+        SELECT DISTINCT (payload->>'target')::uuid
+        FROM memory_map_events
+        WHERE root_memory_id = $1
+          AND id > $2
+          AND event = 'link'
+          AND (payload->>'target') IS NOT NULL
+        """,
+        root_memory_id,
+        since,
+    )
+
+    # Combine both sets
+    memory_ids = {row["memory_id"] for row in rows}
+    target_ids = {row["?column?"] for row in target_rows if row["?column?"] is not None}
+
+    return memory_ids.union(target_ids)
+
+
+class MapNodeNotFoundError(Exception):
+    """Raised when attempting to settle a node that is not a member of the map."""
+    pass
