@@ -6,7 +6,49 @@ exists so other modules can import the constants/types they'll need.
 
 from __future__ import annotations
 
+from datetime import datetime, timedelta
+from hashlib import sha256
 from typing import Final
+from uuid import UUID
 
 VERSIONED_TYPES: Final[frozenset[str]] = frozenset({"decision", "fact"})
 NON_VERSIONED_TYPES: Final[frozenset[str]] = frozenset({"note", "snippet", "question"})
+
+# Unix epoch for microsecond calculations
+_EPOCH = datetime(1970, 1, 1, tzinfo=None)
+
+
+def compute_revision(memory_id: UUID | str, updated_at: datetime | None) -> str:
+    """Compute an opaque revision token for a memory row.
+
+    The revision is derived from the memory_id and updated_at timestamp,
+    providing optimistic concurrency control. Callers can use it to detect
+    when a memory has changed since they last read it.
+
+    Args:
+        memory_id: The UUID of the memory (or string representation).
+        updated_at: The updated_at timestamp, or None (treated as epoch).
+
+    Returns:
+        A 24-character hex string (first 24 chars of SHA-256 hash).
+    """
+    # Convert to string if UUID
+    id_str = str(memory_id) if isinstance(memory_id, UUID) else memory_id
+
+    # Compute microseconds since epoch (treat None as 0)
+    if updated_at is None:
+        micros = 0
+    elif updated_at.tzinfo is not None:
+        # Convert to UTC naive for consistent arithmetic
+        offset = updated_at.tzinfo.utcoffset(updated_at)
+        assert offset is not None
+        utc_naive = updated_at.replace(tzinfo=None) - offset
+        micros = int((utc_naive - _EPOCH) // timedelta(microseconds=1))
+    else:
+        # Naive datetime, treat as UTC
+        micros = int((updated_at - _EPOCH) // timedelta(microseconds=1))
+
+    # Compute hash and return first 24 hex chars
+    hash_input = f"{id_str}:{micros}"
+    hash_bytes = sha256(hash_input.encode("utf-8")).hexdigest()
+    return hash_bytes[:24]
