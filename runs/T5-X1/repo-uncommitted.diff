+class TestComputeRevision:
+    """Tests for compute_revision helper."""
+
+    def test_deterministic_same_args(self) -> None:
+        """Same (id, updated_at) from Python/asyncpg always yields same string."""
+        memory_id = uuid4()
+        updated_at = datetime(2024, 1, 15, 10, 30, 0, tzinfo=UTC)
+
+        r1 = compute_revision(memory_id, updated_at)
+        r2 = compute_revision(memory_id, updated_at)
+
+        assert r1 == r2
+        assert r1 == compute_revision(str(memory_id), updated_at)
+
+    def test_non_empty_string(self) -> None:
+        """Revision is always a non-empty string."""
+        memory_id = uuid4()
+
+        # With valid datetime
+        r1 = compute_revision(memory_id, datetime(2024, 1, 1, 0, 0, 0))
+        assert r1 and isinstance(r1, str) and len(r1) > 0
+
+        # With None
+        r2 = compute_revision(memory_id, None)
+        assert r2 and isinstance(r2, str) and len(r2) > 0
+
+        # With naive datetime
+        r3 = compute_revision(memory_id, datetime(2024, 1, 1, 0, 0, 0))
+        assert r3 and isinstance(r3, str) and len(r3) > 0
+
+    def test_length(self) -> None:
+        """Revision is exactly 24 hex characters."""
+        memory_id = uuid4()
+        r1 = compute_revision(memory_id, datetime.now(UTC))
+        r2 = compute_revision(memory_id, None)
+
+        assert len(r1) == 24
+        assert len(r2) == 24
+        # Verify it's valid hex
+        int(r1, 16)
+        int(r2, 16)
+
+    def test_changes_when_updated_at_increments_by_1us(self) -> None:
+        """A 1 microsecond change in updated_at changes the revision."""
+        memory_id = uuid4()
+        base_dt = datetime(2024, 1, 15, 10, 30, 0, 0)
+        later_dt = base_dt + timedelta(microseconds=1)
+
+        r1 = compute_revision(memory_id, base_dt)
+        r2 = compute_revision(memory_id, later_dt)
+
+        assert r1 != r2
+
+    def test_differs_by_id(self) -> None:
+        """Different memory IDs produce different revisions."""
+        dt = datetime(2024, 1, 15, 10, 30, 0)
+        id1 = uuid4()
+        id2 = uuid4()
+
+        r1 = compute_revision(id1, dt)
+        r2 = compute_revision(id2, dt)
+
+        assert r1 != r2
+
+    def test_naive_datetime_treated_as_utc(self) -> None:
+        """Naive datetime is treated as UTC for consistent hashing."""
+        memory_id = uuid4()
+
+        # Same wall-clock time, one UTC-aware, one naive
+        utc_aware = datetime(2024, 1, 15, 10, 30, 0, tzinfo=UTC)
+        naive = datetime(2024, 1, 15, 10, 30, 0)
+
+        r1 = compute_revision(memory_id, utc_aware)
+        r2 = compute_revision(memory_id, naive)
+
+        # They should be the same since naive is treated as UTC
+        assert r1 == r2
+
+    def test_none_treated_as_epoch(self) -> None:
+        """None updated_at is treated as epoch (0 microseconds)."""
+        memory_id = uuid4()
+
+        r_none = compute_revision(memory_id, None)
+        r_epoch = compute_revision(memory_id, datetime(1970, 1, 1, 0, 0, 0))
+
+        # None should give the same result as epoch
+        assert r_none == r_epoch
+
+    def test_microsecond_precision(self) -> None:
+        """Revision reflects microsecond precision in timestamp."""
+        memory_id = uuid4()
+        dt1 = datetime(2024, 1, 15, 10, 30, 0, 0)
+        dt2 = datetime(2024, 1, 15, 10, 30, 0, 1)  # +1 microsecond
+        dt3 = datetime(2024, 1, 15, 10, 30, 0, 1000)  # +1000 microseconds
+
+        r1 = compute_revision(memory_id, dt1)
+        r2 = compute_revision(memory_id, dt2)
+        r3 = compute_revision(memory_id, dt3)
+
+        assert r1 != r2
+        assert r1 != r3
+        assert r2 != r3
