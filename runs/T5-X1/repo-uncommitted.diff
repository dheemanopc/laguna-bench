+        """10 concurrent distinct content updates to a note → all succeed, last-writer-wins."""
+        tenant_info = await _setup_tenant_and_memory(db_pool)
+        tenant_id = tenant_info["tenant_id"]
+        team_id = tenant_info["team_id"]
+
+        # Create a note
+        memory_id = await _create_note(db_pool, tenant_id, "Original content")
+
+        try:
+            distinct_contents = [f"Content-{i}" for i in range(10)]
+
+            async def update_content(content: str) -> MemoryUpdateOutput:
+                ctx = ToolContext(
+                    request_id=f"req-{uuid4().hex[:8]}",
+                    tenant_id=tenant_id,
+                    identity_id=tenant_id,
+                    client_id="test-concurrent",
+                    scopes=frozenset(["memory.write"]),
+                    db_pool=db_pool,
+                    deps=_build_deps(),
+                )
+                inp = MemoryUpdateInput(id=memory_id, content=content)
+                tool = MemoryUpdateTool()
+                return await tool(ctx, inp)
+
+            results = await asyncio.gather(
+                *[update_content(content) for content in distinct_contents],
+                return_exceptions=False,
+            )
+
+            # All 10 updates should succeed (in-place on note)
+            assert len(results) == 10
+            for result in results:
+                assert isinstance(result, MemoryUpdateOutput)
+                assert result.is_new_version is False
+
+            # All revisions should be different (each update bumps updated_at)
+            revisions = {r.revision for r in results}
+            assert len(revisions) == 10, f"Expected 10 unique revisions, got {len(revisions)}"
+
+            # Final content should be one of the submitted contents
+            ctx = ToolContext(
+                request_id="req-final",
+                tenant_id=tenant_id,
+                identity_id=tenant_id,
+                client_id="test-concurrent",
+                scopes=frozenset(["memory.read"]),
+                db_pool=db_pool,
+                deps=_build_deps(),
+            )
+            get_out = await MemoryGetTool()(ctx, MemoryGetInput(id=memory_id))
+
+            assert get_out.memory.content in distinct_contents, (
+                f"Final content {get_out.memory.content} not in submitted contents"
+            )
+
+            # Final revision should equal one of the successful outputs
+            final_revisions = {r.revision for r in results}
+            assert get_out.memory.revision in final_revisions, (
+                f"Final revision {get_out.memory.revision} not in any output revision"
+            )
+
+        finally:
+            await _cleanup(db_pool, tenant_id, team_id)
