+async def _cleanup(pool: asyncpg.Pool, tenant_id: UUID, team_id: UUID) -> None:
+    """Clean up test data."""
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute(
+                "DELETE FROM memory_references WHERE source_memory_id IN "
+                "(SELECT id FROM memories WHERE tenant_id = $1) "
+                "OR target_memory_id IN (SELECT id FROM memories WHERE tenant_id = $1)",
+                tenant_id,
+            )
+            # Slugs reference memories, delete first
+            await conn.execute("DELETE FROM slugs WHERE team_id = $1", team_id)
+            await conn.execute("DELETE FROM memories WHERE tenant_id = $1", tenant_id)
+            await conn.execute(
+                "DELETE FROM tenant_identities WHERE tenant_id = $1", tenant_id
+            )
+            await conn.execute("DELETE FROM teams WHERE id = $1", team_id)
+            await conn.execute("DELETE FROM tenants WHERE id = $1", tenant_id)
+
+
+async def _get_memory_revision(pool: asyncpg.Pool, tenant_id: UUID, memory_id: UUID) -> str:
+    """Get the current revision of a memory via memory_get."""
+    ctx = ToolContext(
+        request_id=f"req-{uuid4().hex[:8]}",
+        tenant_id=tenant_id,
+        identity_id=tenant_id,
+        client_id="test-concurrent",
+        scopes=frozenset(["memory.read"]),
+        db_pool=pool,
+        deps=_build_deps(),
+    )
+    tool = MemoryGetTool()
+    out = await tool(ctx, MemoryGetInput(id=memory_id))
+    assert isinstance(out.memory, MemoryRecord)
+    return out.memory.revision
