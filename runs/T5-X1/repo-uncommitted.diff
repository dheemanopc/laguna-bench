+                    request_id=f"req-tag-{uuid4().hex[:8]}",
+                    tenant_id=tenant_id,
+                    identity_id=tenant_id,
+                    client_id="test-concurrent",
+                    scopes=frozenset(["memory.write"]),
+                    db_pool=db_pool,
+                    deps=_build_deps(),
+                )
+                inp = MemoryUpdateInput(id=memory_id, tags=[tag], tags_op="add")
+                tool = MemoryUpdateTool()
+                try:
+                    return ("tag", await tool(ctx, inp))
+                except JsonRpcError as e:
+                    return ("tag", e)
+
+            # Gather all 6 operations: 1 content update + 5 tags adds
+            all_ops = [do_content_update()] + [do_tags_add(tag) for tag in distinct_tags]
+            gathered = await asyncio.gather(*all_ops, return_exceptions=False)
+
+            # Separate successes and conflicts
+            successes = []
+            conflicts = []
+            for op_type, result in gathered:
+                if isinstance(result, MemoryUpdateOutput):
+                    successes.append((op_type, result))
+                elif isinstance(result, JsonRpcError):
+                    conflicts.append((op_type, result))
+
+            # The content update is the only content update on a current decision, so it
+            # can never be refused — tag adds may be refused only if they ran after the
+            # version bump (i.e., after the content update won the race).
+            content_outputs = [(t, r) for t, r in successes if t == "content"]
+            assert len(content_outputs) == 1, f"Expected exactly 1 content update success, got {len(content_outputs)}"
+            content_tag, content_output = content_outputs[0]
+            assert content_output.is_new_version is True
+
+            # All conflicts should be tag-add operations with current_id pointing to content_output
+            tag_conflicts = [(t, c) for t, c in conflicts if t == "tag"]
+            for op_type, conflict in tag_conflicts:
+                assert conflict.code == -32000, f"Expected -32000 for {op_type} conflict"
+                assert conflict.data["code"] == "update_conflict"  # type: ignore[index]
+                assert conflict.data["current_id"] == str(content_output.id)  # type: ignore[index]
+
+            # Verify exactly one current row in the chain
+            async with db_pool.acquire() as conn:
+                async with conn.transaction():
+                    count = await conn.fetchval(
+                        """
+                        SELECT COUNT(*) FROM memories
+                        WHERE tenant_id = $1 AND is_current = true AND deleted_at IS NULL
+                        """,
+                        tenant_id,
+                    )
+                    assert count == 1, f"Expected 1 current row, got {count}"
+
+            # Get the final state from the current row of the chain
+            # If content update succeeded, use its output id; otherwise use memory_id
+            ctx = ToolContext(
+                request_id="req-final",
+                tenant_id=tenant_id,
+                identity_id=tenant_id,
+                client_id="test-concurrent",
+                scopes=frozenset(["memory.read"]),
+                db_pool=db_pool,
+                deps=_build_deps(),
+            )
+            get_out = await MemoryGetTool()(ctx, MemoryGetInput(id=content_output.id))
+
+            # Verify tags from successful tag-add calls are present on the current row
+            for op_type, result in successes:
+                if op_type == "tag":
+                    assert result.tags is not None
+                    for tag in result.tags:
+                        assert tag in get_out.memory.tags, f"Tag {tag} from successful operation not in final state"
+
+        finally:
+            await _cleanup(db_pool, tenant_id, team_id)
+
