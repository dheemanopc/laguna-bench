+                UNION ALL
+                -- Follow superseded_by chain to newer versions
+                SELECT m.id, m.superseded_by, m.is_current
+                FROM memories m
+                JOIN chain c ON m.id = c.superseded_by
+                WHERE m.tenant_id = $2 AND c.superseded_by IS NOT NULL
+            )
+            -- Find the current version in the chain, pick highest version
+            SELECT id, updated_at FROM memories
+            WHERE id = ANY(SELECT id FROM chain)
+              AND tenant_id = $2
+              AND is_current = true
+              AND deleted_at IS NULL
+            ORDER BY version DESC NULLS LAST
+            LIMIT 1
+            """,
+            start_id,
+            tenant_id,
+        )
+
+        if row is None:
+            return None, None
+
