+class TestConcurrentTagsOperations:
+    """Tests for concurrent tags_op="add"/"remove" operations."""
+
+    async def test_concurrent_add_tags_all_preserved(self, db_pool: asyncpg.Pool) -> None:
+        """10 concurrent tags_op='add' each adding distinct tags → all preserved."""
+        tenant_info = await _setup_tenant_and_memory(db_pool)
+        tenant_id = tenant_info["tenant_id"]
+        team_id = tenant_info["team_id"]
+
+        # Create a decision with no tags
+        memory_id = await _create_decision(db_pool, tenant_id, "Test decision content")
+
+        try:
+            # 10 concurrent add operations, each adding a distinct tag
+            num_concurrent = 10
+            distinct_tags = [f"tag-{i}" for i in range(num_concurrent)]
+
+            async def add_tag(tag: str) -> MemoryUpdateOutput:
+                ctx = ToolContext(
+                    request_id=f"req-{uuid4().hex[:8]}",
+                    tenant_id=tenant_id,
+                    identity_id=tenant_id,
+                    client_id="test-concurrent",
+                    scopes=frozenset(["memory.write"]),
+                    db_pool=db_pool,
+                    deps=_build_deps(),
+                )
+                inp = MemoryUpdateInput(id=memory_id, tags=[tag], tags_op="add")
+                tool = MemoryUpdateTool()
+                return await tool(ctx, inp)
+
+            results = await asyncio.gather(
+                *[add_tag(tag) for tag in distinct_tags],
+                return_exceptions=True,
+            )
+
+            # All should succeed (no exceptions)
+            errors = [r for r in results if isinstance(r, Exception)]
+            assert len(errors) == 0, f"Some operations failed: {errors}"
+
+            # Verify all tags are present
+            ctx = ToolContext(
+                request_id=f"req-{uuid4().hex[:8]}",
+                tenant_id=tenant_id,
+                identity_id=tenant_id,
+                client_id="test-concurrent",
+                scopes=frozenset(["memory.read"]),
+                db_pool=db_pool,
+                deps=_build_deps(),
+            )
+            out = await MemoryGetTool()(ctx, MemoryGetInput(id=memory_id))
+
+            final_tags = set(out.memory.tags)
+            expected_tags = set(distinct_tags)
+
+            assert final_tags == expected_tags, f"Tags mismatch: {final_tags} vs {expected_tags}"
+
+        finally:
+            await _cleanup(db_pool, tenant_id, team_id)
+
