+"""Integration tests for memory_update concurrency control (T-7.2).
+
+Tests for revision tokens, row locks, and conflict detection with real Postgres.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import os
+from typing import Any
+from uuid import UUID, uuid4
+
+import asyncpg  # type: ignore[import-untyped]
+import pytest
+
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopAuditLogger, NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.get import MemoryGetInput, MemoryGetTool, MemoryRecord
+from mem_mcp.mcp.tools.update import MemoryUpdateInput, MemoryUpdateOutput, MemoryUpdateTool
+from mem_mcp.mcp.tools.write import MemoryWriteInput, MemoryWriteOutput, MemoryWriteTool
+
+pytestmark = pytest.mark.asyncio
+
+
+def _build_deps() -> Any:
+    """Build stub dependencies for tool invocation."""
+    class _StubEmbed:
+        async def embed(self, content: str) -> Any:
+            from mem_mcp.embeddings.bedrock import EmbedResult
+
+            return EmbedResult(vector=[0.0] * 1024, input_tokens=max(1, len(content) // 4))
+
+    return ToolDeps(embeddings=_StubEmbed(), audit=NoopAuditLogger(), quotas=NoopQuotas())
+
+
<email>
+async def db_pool() -> asyncpg.Pool:
+    """Dedicated larger pool (12 connections) for concurrent database operations."""
+    dsn = os.environ.get("MEM_MCP_TEST_DSN")
+    if not dsn:
+        pytest.skip("MEM_MCP_TEST_DSN env not set; skipping live-DB test")
+    from mem_mcp.db.pool import _init_connection
+
+    pool = await asyncpg.create_pool(
+        dsn=dsn,
+        min_size=12,
+        max_size=12,
+        init=_init_connection,
+    )
+    yield pool
+    # Wait for background tasks to drain
+    await asyncio.sleep(0.2)
+    await pool.close()
+
+
+async def _setup_tenant_and_memory(pool: asyncpg.Pool) -> dict[str, Any]:
+    """Create a tenant, team, and memory for testing.
+
+    Returns dict with tenant_id, team_id, client_id, default_team_id.
+    """
+    tenant_id = uuid4()
+
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            # Insert tenant
+            await conn.execute(
+                "INSERT INTO tenants (id, email, status) VALUES ($1, $2, 'active')",
+                tenant_id,
+                f"test-{tenant_id}@example.test",
+            )
+
+            # Insert team and get the generated id
+            team_id = await conn.fetchval(
+                "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+                f"test-team-{tenant_id.hex[:8]}",
+                tenant_id,
+            )
+
+            # Insert primary identity with default_team_id
+            await conn.execute(
+                """
+                INSERT INTO tenant_identities
+                (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+                VALUES ($1, $2, 'cognito', $3, true, $4)
+                """,
+                tenant_id,
+                f"sub-{tenant_id}",
+                f"test-{tenant_id}@example.test",
+                team_id,
+            )
+
+            # Insert oauth_clients row for plugin client
+            await conn.execute(
+                """
+                INSERT INTO oauth_clients
+                (id, redirect_uris, scope, registration_payload, review_status)
+                VALUES ($1, ARRAY[]::text[], 'memory.read memory.write', '{}'::jsonb, 'auto_allowed')
+                ON CONFLICT (id) DO NOTHING
+                """,
+                "test-concurrent",
+            )
+
+    return {
+        "tenant_id": tenant_id,
+        "team_id": team_id,
+        "client_id": "test-concurrent",
+    }
+
+
+async def _create_decision(pool: asyncpg.Pool, tenant_id: UUID, content: str) -> UUID:
+    """Create a decision memory using MemoryWriteTool."""
+    ctx = ToolContext(
+        request_id=f"req-{uuid4().hex[:8]}",
+        tenant_id=tenant_id,
+        identity_id=tenant_id,
+        client_id="test-concurrent",
+        scopes=frozenset(["memory.read", "memory.write"]),
+        db_pool=pool,
+        deps=_build_deps(),
+    )
+    tool = MemoryWriteTool()
+    out = await tool(
+        ctx,
+        MemoryWriteInput(content=content, type="decision", slug_clue="test-decision"),
+    )
+    assert isinstance(out, MemoryWriteOutput)
+    return out.id
+
+
+async def _create_note(pool: asyncpg.Pool, tenant_id: UUID, content: str) -> UUID:
+    """Create a note memory using MemoryWriteTool."""
+    ctx = ToolContext(
+        request_id=f"req-{uuid4().hex[:8]}",
+        tenant_id=tenant_id,
+        identity_id=tenant_id,
+        client_id="test-concurrent",
+        scopes=frozenset(["memory.read", "memory.write"]),
+        db_pool=pool,
+        deps=_build_deps(),
+    )
+    tool = MemoryWriteTool()
+    out = await tool(
+        ctx,
+        MemoryWriteInput(content=content, type="note"),
+    )
+    assert isinstance(out, MemoryWriteOutput)
+    return out.id
+
