index 0000000..a68ef6e
--- /dev/null
+++ b/src/mem_mcp/mcp/tools/mindmap_work_assign.py
@@ -0,0 +1,92 @@
+"""mindmap_work_assign — assign a work item to a team member (or unassign)."""
+
+from __future__ import annotations
+
+from typing import ClassVar
+from uuid import UUID
+
+from pydantic import BaseModel, Field
+
+from mem_mcp.db import tenant_tx
+from mem_mcp.mcp.tool_descriptions import TOOL_DESCRIPTIONS
+from mem_mcp.mcp.tools._base import BaseTool, ToolContext
+from mem_mcp.mcp.tools._mindmap_common import resolve_team_id
+from mem_mcp.mcp.tools._work_item_common import (
+    WorkItemOutput,
+    map_work_item_error,
+)
+from mem_mcp.mindmap import work_items as work_item_service
+
+
+class MindmapWorkAssignInput(BaseModel):
+    """Input for assigning a work item (or unassigning with null)."""
+
+    map_key: str = Field(..., min_length=1, max_length=64)
+    node_id: UUID
+    assignee_id: UUID | None = Field(
+        ..., description="Assignee UUID; pass null to unassign (field required, no default)"
+    )
+    reason: str | None = Field(default=None, max_length=2000)
+    team_id: UUID | None = Field(default=None)
+
+
+class MindmapWorkAssignTool(BaseTool):
+    """Assign a work item to a team member, or unassign (pass null)."""
+
+    name: ClassVar[str] = "mindmap_work_assign"
+    description: ClassVar[str] = TOOL_DESCRIPTIONS["mindmap_work_assign"]
+    required_scope: ClassVar[str] = "memory.write"
+    InputModel: ClassVar[type[BaseModel]] = MindmapWorkAssignInput
+    OutputModel: ClassVar[type[BaseModel]] = WorkItemOutput
+
+    async def __call__(self, ctx: ToolContext, inp: BaseModel) -> BaseModel:
+        assert isinstance(inp, MindmapWorkAssignInput)
+
+        async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+            team_id = await resolve_team_id(conn, ctx, inp.team_id)
+
+            try:
+                result = await work_item_service.assign_work_item(
+                    conn,
+                    tenant_id=ctx.tenant_id,
+                    team_id=team_id,
+                    map_key=inp.map_key,
+                    node_id=inp.node_id,
+                    assignee_id=inp.assignee_id,
+                    reason=inp.reason,
+                    channel="mcp",
+                )
+            except work_item_service.WorkItemError as e:
+                raise map_work_item_error(e) from e
+
+            # Audit the assignee change
+            if ctx.deps is not None:
+                await ctx.deps.audit.audit(
+                    conn,
+                    action="mindmap.work_item_changed",
+                    result="success",
+                    tenant_id=ctx.tenant_id,
+                    identity_id=ctx.identity_id,
+                    client_id=ctx.client_id,
+                    request_id=ctx.request_id,
+                    details={
+                        "node_id": str(result.memory_id),
+                        "change": "owner",  # "assignee" in user-facing terms, but "owner" in model
+                        "map_key": inp.map_key,
+                    },
+                )
+
+            return WorkItemOutput(
+                node_id=result.memory_id,
+                map_key=inp.map_key,
+                map_state=result.map_state,
+                kind=result.kind,
+                status=result.status,
+                assignee_id=result.assignee_id,
+                title=result.title,
+                created_by=result.created_by,
+                created_at=result.created_at,
+                updated_at=result.updated_at,
+                status_changed_at=result.status_changed_at,
+                request_id=ctx.request_id,
+            )
