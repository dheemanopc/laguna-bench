+    if root_memory_id is None:
+        raise WorkItemMapNotFoundError()
+
+    map_row = await service.get_map_row(conn, root_memory_id=root_memory_id)
+    if map_row is None:
+        raise WorkItemMapNotFoundError()
+
+    # Check caller has role on team
+    caller_role = await get_team_role(conn, tenant_id, team_id)
+    if caller_role is None:
+        raise WorkItemMapNotFoundError()
+
+    # Get work item (includes root_memory_id to prevent cross-map access)
+    wi_row = await conn.fetchrow(
+        """
+        SELECT * FROM work_items
+        WHERE memory_id = $1 AND tenant_id = $2 AND team_id = $3 AND root_memory_id = $4
+        """,
+        node_id,
+        tenant_id,
+        team_id,
+        root_memory_id,
+    )
+    if wi_row is None:
+        # Check if node exists in this map's membership (with deleted_at filter)
+        membership = await conn.fetchrow(
+            """
+            SELECT 1 FROM memory_map_membership mm
+            JOIN memories m ON m.id = mm.memory_id AND m.tenant_id = mm.tenant_id
+            WHERE mm.memory_id = $1 AND mm.root_memory_id = $2 AND mm.tenant_id = $3
+            AND m.deleted_at IS NULL
+            """,
+            node_id,
+            root_memory_id,
+            tenant_id,
+        )
+        if membership is None:
+            raise NodeNotInMapError()
+        raise NotAWorkItemError()
+
+    # Get node content for title
+    node_row = await conn.fetchrow(
+        "SELECT content FROM memories WHERE id = $1 AND tenant_id = $2",
+        node_id,
+        tenant_id,
+    )
+    title = _extract_title(node_row["content"]) if node_row else ""
+
+    return WorkItem(
+        memory_id=wi_row["memory_id"],
+        root_memory_id=wi_row["root_memory_id"],
+        map_key=map_key,
+        map_state=map_row["state"],
+        team_id=wi_row["team_id"],
+        kind=wi_row["kind"],
+        status=wi_row["status"],
+        assignee_id=wi_row["assignee_id"],
+        title=title,
+        created_by=wi_row["created_by"],
+        created_at=wi_row["created_at"],
+        updated_at=wi_row["updated_at"],
+        status_changed_at=wi_row["status_changed_at"],
+    )
