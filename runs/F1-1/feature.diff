+        FOR UPDATE
+        """,
+        node_id,
+        tenant_id,
+        team_id,
+        root_memory_id,
+    )
+    if wi_row is None:
+        # Check if node exists in this map's membership (with deleted_at filter)
+        await _check_node_membership(conn, node_id, root_memory_id, tenant_id)
+        raise NotAWorkItemError()
