+async def test_mark_race_condition_unique_violation(
+    pg_pool: asyncpg.Pool,
+    tenant_a: UUID,
+    team_a: UUID,
+    map_setup: tuple[UUID, UUID, str],
+) -> None:
+    """Concurrent mark on same node should raise AlreadyWorkItemError."""
+    from mem_mcp.mindmap import work_items
+
+    root_mem_id, node_id, map_key = map_setup
+
+    # Pre-get history count before first mark
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        initial_count = await conn.fetchval(
+            "SELECT COUNT(*) FROM work_item_history WHERE memory_id = $1",
+            node_id,
+        )
+
+    # Simulate a race condition by inserting a work_items row directly
+    # This bypasses the pre-check, simulating concurrent access
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        await conn.execute(
+            """
+            INSERT INTO work_items
+                (memory_id, root_memory_id, tenant_id, team_id, kind, assignee_id,
+                 created_by, status, status_changed_at)
+            VALUES ($1, $2, $3, $4, 'story', NULL, $3, 'todo', now())
+            """,
+            node_id,
+            root_mem_id,
+            tenant_a,
+            team_a,
+        )
+
+    # Now mark_work_item should fail with AlreadyWorkItemError
+    # due to UniqueViolationError from the INSERT
+    with pytest.raises(AlreadyWorkItemError):
+        async with tenant_tx(pg_pool, tenant_a) as conn:
+            await work_items.mark_work_item(
+                conn,
+                tenant_id=tenant_a,
+                team_id=team_a,
+                map_key=map_key,
+                node_id=node_id,
+                kind="story",
+            )
+
+    # History count should be unchanged (no new history row created)
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        final_count = await conn.fetchval(
+            "SELECT COUNT(*) FROM work_item_history WHERE memory_id = $1",
+            node_id,
+        )
+    assert final_count == initial_count  # No new history row
