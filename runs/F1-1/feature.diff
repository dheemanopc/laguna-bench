diff --git a/src/mem_mcp/mcp/tools/_work_item_common.py b/src/mem_mcp/mcp/tools/_work_item_common.py
new file mode 100644
index 0000000..eef348d
--- /dev/null
+++ b/src/mem_mcp/mcp/tools/_work_item_common.py
@@ -0,0 +1,195 @@
+"""Shared orchestration and models for mindmap work item tools.
+
+Work items allow marking map nodes as tasks with kind, status, and assignee.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime
+from uuid import UUID
+
+from pydantic import BaseModel
+
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mindmap.work_items import (
+    AlreadyWorkItemError,
+    AssigneeUnchangedError,
+    InvalidAssigneeError,
+    InvalidKindError,
+    InvalidStatusError,
+    InvalidTransitionError,
+    KindUnchangedError,
+    MapNotLiveError,
+    NodeNotInMapError,
+    NotAWorkItemError,
+    ReasonRequiredError,
+    RootNodeNotAllowedError,
+    StatusConflictError,
+    StatusUnchangedError,
+    WorkItemError,
+    WorkItemMapNotFoundError,
+    WorkItemPermissionDeniedError,
+)
+
+# Canonical order for error messages
+KIND_ORDER = ("story", "epic", "milestone")
+STATUS_ORDER = ("todo", "in_progress", "blocked", "done", "cancelled")
+
+
+class WorkItemOutput(BaseModel):
+    """Output model for work item tools."""
+
+    node_id: UUID
+    map_key: str
+    map_state: str
+    kind: str
+    status: str
+    assignee_id: UUID | None
+    title: str
+    created_by: UUID
+    created_at: datetime  # asyncpg returns datetime, Pydantic serializes to ISO 8601
+    updated_at: datetime
+    status_changed_at: datetime
+    request_id: str
+
+
+def map_work_item_error(e: Exception) -> JsonRpcError:
+    """Map a work item service exception to JsonRpcError.
+
+    Non-WorkItemError exceptions propagate unchanged (re-raised).
+    """
+    if not isinstance(e, WorkItemError):
+        raise e
+
+    # Dispatch: map each exception type to its handler
+    if isinstance(e, WorkItemMapNotFoundError):
+        return JsonRpcError(-32602, "map not found", data={"errors": [{"path": "map_key"}]})
+    if isinstance(e, WorkItemPermissionDeniedError):
+        return JsonRpcError(
+            -32603,
+            "permission denied",
+            data={"missing_permission": e.permission.value},
+        )
+    if isinstance(e, NodeNotInMapError):
+        return JsonRpcError(
+            -32602,
+            "node is not a member of this map",
+            data={"errors": [{"path": "node_id"}]},
+        )
+    if isinstance(e, NotAWorkItemError):
+        return JsonRpcError(
+            -32602,
+            "not a work item",
+            data={"code": "not_a_work_item", "errors": [{"path": "node_id"}]},
+        )
+    if isinstance(e, RootNodeNotAllowedError):
+        return JsonRpcError(
+            -32602,
+            "cannot mark the root question node as a work item",
+            data={"code": "root_node_not_allowed", "errors": [{"path": "node_id"}]},
+        )
+    if isinstance(e, AlreadyWorkItemError):
+        return JsonRpcError(
+            -32602,
+            "node is already a work item",
+            data={"code": "already_work_item", "errors": [{"path": "node_id"}]},
+        )
+    if isinstance(e, MapNotLiveError):
+        return JsonRpcError(
+            -32602,
+            "map is archived; archived maps are no-reopen",
+            data={"code": "map_not_live", "errors": [{"path": "map_key"}]},
+        )
+    if isinstance(e, InvalidKindError):
+        allowed = [k for k in KIND_ORDER if k in e.allowed]
+        return JsonRpcError(
+            -32602,
+            f"kind must be one of: {', '.join(allowed)}",
+            data={
+                "code": "invalid_work_item_kind",
+                "errors": [{"path": "kind", "message": f"kind must be one of: {', '.join(allowed)}"}],
+                "allowed": allowed,
+            },
+        )
+    if isinstance(e, InvalidStatusError):
+        allowed = [s for s in STATUS_ORDER if s in e.allowed]
+        return JsonRpcError(
+            -32602,
+            f"status must be one of: {', '.join(allowed)}",
+            data={
+                "code": "invalid_work_item_status",
+                "errors": [{"path": "status", "message": f"status must be one of: {', '.join(allowed)}"}],
+                "allowed": allowed,
+            },
+        )
+    if isinstance(e, InvalidTransitionError):
+        return JsonRpcError(
+            -32602,
+            f"cannot change work item status from {e.current} to {e.requested}",
+            data={
+                "code": "invalid_transition",
+                "current_status": e.current,
+                "requested_status": e.requested,
+                "errors": [{"path": "status"}],
+            },
+        )
+    if isinstance(e, ReasonRequiredError):
+        return JsonRpcError(
+            -32602,
+            f"a reason is required to change work item status from {e.current} to {e.requested}",
+            data={
+                "code": "reason_required",
+                "errors": [{"path": "reason"}],
+                "current_status": e.current,
+                "requested_status": e.requested,
+            },
+        )
+    if isinstance(e, StatusUnchangedError):
+        return JsonRpcError(
+            -32602,
+            "status is already set to the requested value",
+            data={
+                "code": "status_unchanged",
+                "current_status": e.current,
+                "errors": [{"path": "status"}],
+            },
+        )
+    if isinstance(e, StatusConflictError):
+        return JsonRpcError(
+            -32602,
+            f"status conflict: expected {e.expected} but actual is {e.actual}",
+            data={
+                "code": "status_conflict",
+                "current_status": e.actual,
+                "expected_status": e.expected,
+                "errors": [{"path": "expected_status"}],
+            },
+        )
+    if isinstance(e, KindUnchangedError):
+        return JsonRpcError(
+            -32602,
+            "kind is already set to the requested value",
+            data={"code": "kind_unchanged", "errors": [{"path": "kind"}]},
+        )
+    if isinstance(e, AssigneeUnchangedError):
+        return JsonRpcError(
+            -32602,
+            "assignee is already set to the requested value",
+            data={"code": "assignee_unchanged", "errors": [{"path": "assignee_id"}]},
+        )
+    if isinstance(e, InvalidAssigneeError):
+        return JsonRpcError(
+            -32602,
+            "assignee must be a current owner, admin or member of the map's team",
+            data={
+                "code": "invalid_assignee",
+                "errors": [{"path": "assignee_id"}],
+            },
+        )
+
+    # Fallback for unknown WorkItemError
+    raise JsonRpcError(
+        -32602,
+        "work item error",
+        data={"code": "work_item_error"},
+    )
