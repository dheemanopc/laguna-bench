+++ b/alembic/versions/0046_2026_10_16_mindmap_work_items.py
@@ -0,0 +1,164 @@
+"""mindmap work items — task tracking on nodes.
+
+A mind-map node can be marked as a "work item" (kind story|epic|milestone;
+status todo|in_progress|blocked|done|cancelled; optional assignee = a team member)
+with an append-only history.
+
+- `work_items`: tracks the current state of a work item on a node.
+- `work_item_history`: append-only audit of all state changes (created, status,
+  owner, kind transitions).
+
+RLS follows the canonical `safe_current_tenant_id()` pattern (migration 0034).
+
+assignee_id deliberately has NO FK to tenants.id. This allows a removed member
+to remain visible as assignee for historical context — their identity stays
+referenced even after their role is revoked.
+
+work_item_history is append-only by design: UPDATE/DELETE are disallowed
+to maintain an immutable audit trail. We do not grant UPDATE/DELETE on this
+table to prevent accidental corruption of the history.
+
+Revision ID: 0046_mindmap_work_items
+Revises: 0045_fix_turn_backfill
+Create Date: 2026-10-16
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0046_mindmap_work_items"
+down_revision = "0045_fix_turn_backfill"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    # ---- work_items ---------------------------------------------------------
+    op.execute(
+        sa.text("""
+        CREATE TABLE work_items (
+            memory_id           UUID PRIMARY KEY REFERENCES memories(id) ON DELETE CASCADE,
+            root_memory_id      UUID NOT NULL REFERENCES memory_maps(root_memory_id) ON DELETE CASCADE,
+            tenant_id           UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
+            team_id             UUID NOT NULL REFERENCES teams(id) ON DELETE CASCADE,
+            kind                TEXT NOT NULL CHECK (kind IN ('story','epic','milestone')),
+            status              TEXT NOT NULL DEFAULT 'todo'
+                              CHECK (status IN ('todo','in_progress','blocked','done','cancelled')),
+            assignee_id         UUID NULL,
+            created_by          UUID NOT NULL,
+            created_at          TIMESTAMPTZ NOT NULL DEFAULT now(),
+            updated_at          TIMESTAMPTZ NOT NULL DEFAULT now(),
+            status_changed_at   TIMESTAMPTZ NOT NULL DEFAULT now()
+        )
+    """)
+    )
+
+    # Index on (tenant_id, team_id, status) for filtering work items
+    op.execute(
+        sa.text(
+            "CREATE INDEX work_items_tenant_team_status_idx "
+            "ON work_items (tenant_id, team_id, status)"
+        )
+    )
+
+    # Index on root_memory_id for map-wide queries
+    op.execute(sa.text("CREATE INDEX work_items_root_memory_idx " "ON work_items (root_memory_id)"))
+
+    # Partial index for unassigned work items
+    op.execute(
+        sa.text(
+            "CREATE INDEX work_items_assignee_idx "
+            "ON work_items (assignee_id) "
+            "WHERE assignee_id IS NOT NULL"
+        )
+    )
+
+    # ---- work_item_history (append-only) ------------------------------------
+    op.execute(
+        sa.text("""
+        CREATE TABLE work_item_history (
+            id                  BIGSERIAL PRIMARY KEY,
+            memory_id           UUID NOT NULL REFERENCES memories(id) ON DELETE CASCADE,
+            root_memory_id      UUID NOT NULL,
+            tenant_id           UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
+            team_id             UUID NOT NULL,
+            change_type         TEXT NOT NULL CHECK (change_type IN ('created','status','owner','kind')),
+            -- Before/after snapshot (for 'created', all *_before are NULL)
+            kind_before         TEXT NULL,
+            kind_after          TEXT NOT NULL,
+            status_before       TEXT NULL,
+            status_after        TEXT NOT NULL,
+            assignee_before     UUID NULL,
+            assignee_after      UUID NULL,
+            actor_id            UUID NOT NULL,
+            channel             TEXT NOT NULL CHECK (channel IN ('mcp','web')),
+            reason              TEXT NULL,
+            created_at          TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp()
+        )
+    """)
+    )
+
+    # Index on (memory_id, id) for history lookup
+    op.execute(
+        sa.text("CREATE INDEX work_item_history_memory_idx " "ON work_item_history (memory_id, id)")
+    )
+
+    # Index on (tenant_id, actor_id, created_at) for tenant-scoped audit queries
+    op.execute(
+        sa.text(
+            "CREATE INDEX work_item_history_tenant_actor_idx "
+            "ON work_item_history (tenant_id, actor_id, created_at)"
+        )
+    )
+
+    # ---- RLS policies --------------------------------------------------------
+    for table in ("work_items", "work_item_history"):
+        op.execute(sa.text(f"ALTER TABLE {table} ENABLE ROW LEVEL SECURITY"))
+        op.execute(
+            sa.text(
+                f"CREATE POLICY {table}_select ON {table} FOR SELECT TO mem_app "
+                "USING (tenant_id = safe_current_tenant_id())"
+            )
+        )
+        op.execute(
+            sa.text(
+                f"CREATE POLICY {table}_insert ON {table} FOR INSERT TO mem_app "
+                "WITH CHECK (tenant_id = safe_current_tenant_id())"
+            )
+        )
+
+    # work_items needs UPDATE policy for status/kind changes
+    op.execute(
+        sa.text(
+            "CREATE POLICY work_items_update ON work_items FOR UPDATE TO mem_app "
+            "USING (tenant_id = safe_current_tenant_id()) "
+            "WITH CHECK (tenant_id = safe_current_tenant_id())"
+        )
+    )
+    op.execute(sa.text("GRANT SELECT, INSERT, UPDATE ON work_items TO mem_app"))
+
+    # work_item_history is append-only: SELECT + INSERT only
+    # Deny all UPDATE and DELETE to enforce append-only
+    op.execute(
+        sa.text(
+            "CREATE POLICY work_item_history_update_deny ON work_item_history "
+            "FOR UPDATE TO mem_app USING (false)"
+        )
+    )
+    op.execute(
+        sa.text(
+            "CREATE POLICY work_item_history_delete_deny ON work_item_history "
+            "FOR DELETE TO mem_app USING (false)"
+        )
+    )
+    op.execute(sa.text("GRANT SELECT, INSERT ON work_item_history TO mem_app"))
+    op.execute(sa.text("GRANT USAGE, SELECT ON SEQUENCE work_item_history_id_seq TO mem_app"))
+
+
+def downgrade() -> None:
+    # Drop in reverse order of creation
+    op.execute(sa.text("DROP TABLE IF EXISTS work_item_history"))
+    op.execute(sa.text("DROP TABLE IF EXISTS work_items"))
