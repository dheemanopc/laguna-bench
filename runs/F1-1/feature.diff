+async def test_allowed_status_transitions(
+    pg_pool: asyncpg.Pool,
+    tenant_a: UUID,
+    team_a: UUID,
+    map_setup: tuple[UUID, UUID, str],
+    current: str,
+    requested: str,
+    reason_required: bool,
+) -> None:
+    """Every allowed transition should succeed."""
+    from mem_mcp.mindmap import work_items
+
+    root_mem_id, node_id, map_key = map_setup
+
+    # Helper to get to a status from todo via valid path
+    async def setup_to_status(conn: asyncpg.Connection, target_status: str) -> None:
+        if target_status == "todo":
+            return  # Already at todo after marking
+        if target_status == "in_progress":
+            await work_items.set_work_item_status(
+                conn,
+                tenant_id=tenant_a,
+                team_id=team_a,
+                map_key=map_key,
+                node_id=node_id,
+                status="in_progress",
+            )
+        elif target_status == "blocked":
+            # Path: todo -> in_progress -> blocked (blocked requires reason)
+            await work_items.set_work_item_status(
+                conn,
+                tenant_id=tenant_a,
+                team_id=team_a,
+                map_key=map_key,
+                node_id=node_id,
+                status="in_progress",
+            )
+            await work_items.set_work_item_status(
+                conn,
+                tenant_id=tenant_a,
+                team_id=team_a,
+                map_key=map_key,
+                node_id=node_id,
+                status="blocked",
+                reason="setup to blocked",
+            )
+        elif target_status == "done":
+            # Path: todo -> in_progress -> done
+            await work_items.set_work_item_status(
+                conn,
+                tenant_id=tenant_a,
+                team_id=team_a,
+                map_key=map_key,
+                node_id=node_id,
+                status="in_progress",
+            )
+            await work_items.set_work_item_status(
+                conn,
+                tenant_id=tenant_a,
+                team_id=team_a,
+                map_key=map_key,
+                node_id=node_id,
+                status="done",
+            )
+        elif target_status == "cancelled":
+            # Path: todo -> cancelled (cancelled requires reason)
+            await work_items.set_work_item_status(
+                conn,
+                tenant_id=tenant_a,
+                team_id=team_a,
+                map_key=map_key,
+                node_id=node_id,
+                status="cancelled",
+                reason="setup to cancelled",
+            )
+
+    # First mark as work item (starts at todo)
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        wi = await work_items.mark_work_item(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            map_key=map_key,
+            node_id=node_id,
+            kind="story",
+            reason="initial",
+        )
+        assert wi.status == "todo"
+
+    # Set up initial status using valid path
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        await setup_to_status(conn, current)
+
+    # Now transition to requested status
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        wi = await work_items.set_work_item_status(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            map_key=map_key,
+            node_id=node_id,
+            status=requested,
+            reason="test reason" if reason_required else None,
+        )
+        assert wi.status == requested
+
+        # Verify history was created
+        history = await work_items.get_work_item_history(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            map_key=map_key,
+            node_id=node_id,
+        )
+        # At least the transition should be recorded
+        assert len(history) >= 1
+        assert history[-1].change_type == "status"
+
+
