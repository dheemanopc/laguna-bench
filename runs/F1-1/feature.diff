+async def test_history_append_only(
+    pg_pool: asyncpg.Pool,
+    tenant_a: UUID,
+    team_a: UUID,
+    map_setup: tuple[UUID, UUID, str],
+) -> None:
+    """history table should be append-only - verify RLS deny policies exist."""
+    from mem_mcp.mindmap import work_items
+
+    root_mem_id, node_id, map_key = map_setup
+
+    # Create a history entry
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        await work_items.mark_work_item(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            map_key=map_key,
+            node_id=node_id,
+            kind="story",
+        )
+
+    # Verify RLS policies exist and deny UPDATE/DELETE for mem_app
+    # The policies must be in place to ensure append-only history
+    async with pg_pool.acquire() as conn:
+        # Check that UPDATE deny policy exists
+        deny_update = await conn.fetchrow(
+            "SELECT polname FROM pg_policy "
+            "WHERE polrelid = 'work_item_history'::regclass AND polname = 'work_item_history_update_deny'"
+        )
+        assert deny_update is not None, "work_item_history_update_deny policy not found"
+
+        # Check that DELETE deny policy exists
+        deny_delete = await conn.fetchrow(
+            "SELECT polname FROM pg_policy "
+            "WHERE polrelid = 'work_item_history'::regclass AND polname = 'work_item_history_delete_deny'"
+        )
+        assert deny_delete is not None, "work_item_history_delete_deny policy not found"
+
+        # Verify SELECT and INSERT policies exist for mem_app
+        select_policy = await conn.fetchrow(
+            "SELECT 1 FROM pg_policy "
+            "WHERE polrelid = 'work_item_history'::regclass AND polname = 'work_item_history_select'"
+        )
+        assert select_policy is not None, "work_item_history_select policy not found"
+
+        insert_policy = await conn.fetchrow(
+            "SELECT 1 FROM pg_policy "
+            "WHERE polrelid = 'work_item_history'::regclass AND polname = 'work_item_history_insert'"
+        )
+        assert insert_policy is not None, "work_item_history_insert policy not found"
+
+        # Verify RLS is enabled
+        rls_enabled = await conn.fetchval(
+            "SELECT relrowsecurity FROM pg_class WHERE relname = 'work_item_history'"
+        )
+        assert rls_enabled, "RLS not enabled on work_item_history"
+
