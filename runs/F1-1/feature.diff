+async def mark_work_item(
+    conn: asyncpg.Connection,
+    *,
+    tenant_id: UUID,
+    team_id: UUID,
+    map_key: str,
+    node_id: UUID,
+    kind: str,
+    assignee_id: UUID | None = None,
+    reason: str | None = None,
+    channel: str = "mcp",
+) -> WorkItem:
+    """Mark a node as a work item.
+
+    Validates the node is in the map, not the root, not already marked,
+    and the map is live. Inserts work_items row and history entry.
+    """
+    # Load and validate map (includes permission check)
+    root_memory_id, map_row = await _load_map(conn, tenant_id, team_id, map_key)
+
+    # Check permission (owner, admin, or member)
+    await _check_permission(conn, tenant_id, team_id)
+
+    # Validate kind after permission checks
+    _validate_kind(kind)
+
+    # Root node not allowed
+    if node_id == root_memory_id:
+        raise RootNodeNotAllowedError()
+
+    # Check node is in membership table (not deleted)
+    await _check_node_membership(conn, node_id, root_memory_id, tenant_id)
+
+    # Check map is live
+    if map_row["state"] != "live":
+        raise MapNotLiveError()
+
+    # Check not already a work item with root_memory_id filter
+    existing = await conn.fetchrow(
+        "SELECT memory_id FROM work_items WHERE memory_id = $1 AND tenant_id = $2 "
+        "AND root_memory_id = $3",
+        node_id,
+        tenant_id,
+        root_memory_id,
+    )
+    if existing is not None:
+        raise AlreadyWorkItemError()
+
+    # Get node content for title extraction
+    node_row = await conn.fetchrow(
+        "SELECT content FROM memories WHERE id = $1 AND tenant_id = $2",
+        node_id,
+        tenant_id,
+    )
+    if node_row is None:
+        raise NodeNotInMapError()
+
+    title = _extract_title(node_row["content"])
+
+    # Validate assignee if provided
+    if assignee_id is not None:
+        assignee_role = await get_team_role(conn, assignee_id, team_id)
+        if assignee_role is None or assignee_role not in ASSIGNABLE_ROLES:
+            raise InvalidAssigneeError(assignee_id)
+
+    # Insert work_items row (wrap in savepoint to handle race conditions)
+    try:
+        async with conn.transaction():
+            result = await conn.fetchrow(
+                """
+                INSERT INTO work_items
+                    (memory_id, root_memory_id, tenant_id, team_id, kind, assignee_id,
+                     created_by, status, status_changed_at)
+                VALUES ($1, $2, $3, $4, $5, $6, $7, 'todo', now())
+                RETURNING memory_id, root_memory_id, tenant_id, team_id, kind, status,
+                          assignee_id, created_by, created_at, updated_at, status_changed_at
+                """,
+                node_id,
+                root_memory_id,
+                tenant_id,
+                team_id,
+                kind,
+                assignee_id,
+                tenant_id,  # created_by is the caller
+            )
+    except asyncpg.UniqueViolationError:
+        raise AlreadyWorkItemError() from None
+
+    assert result is not None
+
+    # Insert history entry using helper
+    cleaned_reason = _clean_reason(reason)
+    await _append_history(
+        conn,
+        node_id,
+        root_memory_id,
+        tenant_id,
+        team_id,
+        "created",
+        None,  # kind_before
+        kind,
+        None,  # status_before
+        "todo",
+        None,  # assignee_before
+        assignee_id,
+        tenant_id,  # actor_id
+        channel,
+        cleaned_reason,
+    )
+
+    # Record change event using helper
+    await _record_change(
+        conn,
+        root_memory_id=root_memory_id,
+        tenant_id=tenant_id,
+        event="work_item",
+        actor="model" if channel == "mcp" else "owner",
+        memory_id=node_id,
+        payload={
+            "change": "created",
+            "from": None,
+            "to": {
+                "kind": kind,
+                "status": "todo",
+                "assignee": str(assignee_id) if assignee_id else None,
+            },
+        },
+    )
+
+    return WorkItem(
+        memory_id=result["memory_id"],
+        root_memory_id=result["root_memory_id"],
+        map_key=map_key,
+        map_state=map_row["state"],
+        team_id=result["team_id"],
+        kind=result["kind"],
+        status=result["status"],
+        assignee_id=result["assignee_id"],
+        title=title,
+        created_by=result["created_by"],
+        created_at=result["created_at"],
+        updated_at=result["updated_at"],
+        status_changed_at=result["status_changed_at"],
+    )
+
+
+async def set_work_item_status(
+    conn: asyncpg.Connection,
+    *,
+    tenant_id: UUID,
+    team_id: UUID,
+    map_key: str,
+    node_id: UUID,
+    status: str,
+    reason: str | None = None,
+    expected_status: str | None = None,
+    channel: str = "mcp",
+) -> WorkItem:
+    """Set the status of a work item."""
+    # Load and validate map (includes permission check)
+    root_memory_id, map_row = await _load_map(conn, tenant_id, team_id, map_key)
+
+    # Check permission (owner, admin, or member)
+    await _check_permission(conn, tenant_id, team_id)
+
+    # Validate status after permission check
+    _validate_status(status)
+
+    # Load work item for update using helper
+    wi_row = await _load_work_item_for_update(conn, node_id, tenant_id, team_id, root_memory_id)
+
+    current_status = wi_row["status"]
+
+    # Check expected status if provided
+    if expected_status is not None and current_status != expected_status:
+        raise StatusConflictError(expected_status, current_status)
+
+    # Check status unchanged
+    if current_status == status:
+        raise StatusUnchangedError(current_status)
+
+    # Validate transition with cleaned reason
+    check_transition(current_status, status, _clean_reason(reason))
+
+    # Get node content for title
+    node_row = await conn.fetchrow(
+        "SELECT content FROM memories WHERE id = $1 AND tenant_id = $2",
+        node_id,
+        tenant_id,
+    )
+    title = _extract_title(node_row["content"]) if node_row else ""
+
+    # Get current kind and assignee for history
+    current_kind = wi_row["kind"]
+    current_assignee = wi_row["assignee_id"]
+
+    # Update status (includes root_memory_id to prevent cross-map access)
+    await conn.execute(
+        """
+        UPDATE work_items
+        SET status = $1, updated_at = now(), status_changed_at = now()
+        WHERE memory_id = $2 AND tenant_id = $3 AND team_id = $4 AND root_memory_id = $5
+        """,
+        status,
+        node_id,
+        tenant_id,
+        team_id,
+        root_memory_id,
+    )
+
+    # Append history using helper
+    cleaned_reason = _clean_reason(reason)
+    await _append_history(
+        conn,
+        node_id,
+        root_memory_id,
+        tenant_id,
+        team_id,
+        "status",
+        current_kind,
+        current_kind,
+        current_status,
+        status,
+        current_assignee,
+        current_assignee,
+        tenant_id,
+        channel,
+        cleaned_reason,
+    )
+
+    # Record change using helper
+    await _record_change(
+        conn,
+        root_memory_id=root_memory_id,
+        tenant_id=tenant_id,
+        event="work_item",
+        actor="model" if channel == "mcp" else "owner",
+        memory_id=node_id,
+        payload={"change": "status", "from": current_status, "to": status},
+    )
+
+    return WorkItem(
+        memory_id=wi_row["memory_id"],
+        root_memory_id=wi_row["root_memory_id"],
+        map_key=map_key,
+        map_state=map_row["state"],
+        team_id=wi_row["team_id"],
+        kind=wi_row["kind"],
+        status=status,
+        assignee_id=wi_row["assignee_id"],
+        title=title,
+        created_by=wi_row["created_by"],
+        created_at=wi_row["created_at"],
+        updated_at=wi_row["updated_at"],
+        status_changed_at=wi_row["status_changed_at"],
+    )
+
