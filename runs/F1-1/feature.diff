+async def _setup_map(
+    conn: asyncpg.Connection,
+    tenant_id: UUID,
+    team_id: UUID,
+    title: str = "Test Map",
+    state: str = "live",
+) -> tuple[UUID, UUID, str]:
+    """Create a live mind-map with a root memory and a child node.
+
+    Returns (root_memory_id, child_memory_id, map_key).
+    """
+    # Create root memory
+    root_mem_id = await conn.fetchval(
+        """
+        INSERT INTO memories (tenant_id, team_id, content, content_hash,
+                             embedding, source_kind, type, visibility)
+        VALUES ($1, $2, 'Root node content', $3,
+                array_fill(0::real, ARRAY[1024])::vector, 'api', 'question', 'team')
+        RETURNING id
+        """,
+        tenant_id,
+        team_id,
+        f"hash-root-{uuid4().hex}",
+    )
+
+    # Create child node
+    child_mem_id = await conn.fetchval(
+        """
+        INSERT INTO memories (tenant_id, team_id, content, content_hash,
+                             embedding, source_kind, type, visibility)
+        VALUES ($1, $2, 'Child node content', $3,
+                array_fill(0::real, ARRAY[1024])::vector, 'api', 'note', 'team')
+        RETURNING id
+        """,
+        tenant_id,
+        team_id,
+        f"hash-child-{uuid4().hex}",
+    )
+
+    # Insert into memory_maps (root_memory_id is PK and FK to memories)
+    await conn.execute(
+        """
+        INSERT INTO memory_maps
+            (root_memory_id, tenant_id, team_id, title, state)
+        VALUES ($1, $2, $3, $4, $5)
+        """,
+        root_mem_id,
+        tenant_id,
+        team_id,
+        title,
+        state,
+    )
+
+    # Add child to map via memory_map_membership
+    await conn.execute(
+        """
+        INSERT INTO memory_map_membership
+            (memory_id, root_memory_id, tenant_id, node_role, turn, authored_by)
+        VALUES ($1, $2, $3, 'position', 'owner', 'owner')
+        """,
+        child_mem_id,
+        root_mem_id,  # root_memory_id in membership = memory_maps.root_memory_id
+        tenant_id,
+    )
+
+    # Create slug for map_key
+    map_key = f"map-{uuid4().hex[:8]}"
+    await conn.execute(
+        """
+        INSERT INTO slugs
+            (memory_id, team_id, resource_type, slug, title)
+        VALUES ($1, $2, 'map', $3, $4)
+        """,
+        root_mem_id,
+        team_id,
+        map_key,
+        title,  # title is required
+    )
+
+    return root_mem_id, child_mem_id, map_key
