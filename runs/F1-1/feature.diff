+async def test_list_work_items_team_wide(
+    pg_pool: asyncpg.Pool,
+    tenant_a: UUID,
+    team_a: UUID,
+    map_setup: tuple[UUID, UUID, str],
+) -> None:
+    """list_work_items with map_key=None should list all work items in team."""
+    from mem_mcp.mindmap import work_items
+
+    root_mem_id, node_id, map_key = map_setup
+
+    # Create another node in the same map
+    other_node = await pg_pool.fetchval(
+        """
+        INSERT INTO memories (tenant_id, team_id, content, content_hash,
+                             embedding, source_kind, type, visibility)
+        VALUES ($1, $2, 'Another node', $3,
+                array_fill(0::real, ARRAY[1024])::vector, 'api', 'note', 'team')
+        RETURNING id
+        """,
+        tenant_a,
+        team_a,
+        f"hash-other-{uuid4().hex}",
+    )
+    await pg_pool.execute(
+        """
+        INSERT INTO memory_map_membership
+            (memory_id, root_memory_id, tenant_id, node_role, turn, authored_by)
+        VALUES ($1, $2, $3, 'position', 'owner', 'owner')
+        """,
+        other_node,
+        root_mem_id,
+        tenant_a,
+    )
+
+    # Mark both nodes as work items
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        await work_items.mark_work_item(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            map_key=map_key,
+            node_id=node_id,
+            kind="story",
+        )
+        await work_items.mark_work_item(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            map_key=map_key,
+            node_id=other_node,
+            kind="epic",
+        )
+
+    # List all work items for the team (map_key=None)
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        all_wis = await work_items.list_work_items(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            map_key=None,  # Team-wide listing
+        )
+        assert len(all_wis) == 2
+
+        # Verify both kinds are present
+        kinds = {wi.kind for wi in all_wis}
+        assert "story" in kinds
+        assert "epic" in kinds
+
