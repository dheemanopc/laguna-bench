diff --git a/src/mem_mcp/mindmap/work_items.py b/src/mem_mcp/mindmap/work_items.py
new file mode 100644
index 0000000..750a06b
--- /dev/null
+++ b/src/mem_mcp/mindmap/work_items.py
@@ -0,0 +1,1272 @@
+"""Work item service layer — task tracking on mind-map nodes.
+
+A mind-map node can be marked as a "work item" with kind (story|epic|milestone),
+status (todo|in_progress|blocked|done|cancelled), and optional assignee.
+All changes are append-only to work_item_history for auditability.
+
+Takes `asyncpg.Connection` from `tenant_tx`; never imports FastAPI or JsonRpcError.
+All SQL has explicit `tenant_id = $n` plus RLS (run `tools/lint_tenant_scope.py` via
+its unit test).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime
+from typing import Any, Literal
+from uuid import UUID
+
+import asyncpg  # type: ignore[import-untyped]
+
+from mem_mcp.auth.permissions import ROLE_PERMISSIONS, Permission
+from mem_mcp.auth.rbac import get_team_role
+from mem_mcp.mindmap import service
+
+# -------------------------------------------------------------------------
+# Constants
+# -------------------------------------------------------------------------
+
+WORK_KINDS = ("story", "epic", "milestone")
+WORK_STATUSES = ("todo", "in_progress", "blocked", "done", "cancelled")
+ASSIGNABLE_ROLES = frozenset({"owner", "admin", "member"})
+Channel = Literal["mcp", "web"]
+
+# Transition rules: (current, requested) -> reason_required
+# reason_required = True means a reason must be provided; False means not required
+TRANSITIONS: dict[tuple[str, str], bool] = {
+    ("todo", "in_progress"): False,
+    ("todo", "cancelled"): True,
+    ("in_progress", "blocked"): True,
+    ("in_progress", "done"): False,
+    ("in_progress", "todo"): False,
+    ("in_progress", "cancelled"): True,
+    ("blocked", "in_progress"): False,
+    ("blocked", "cancelled"): True,
+    ("done", "in_progress"): True,
+    ("cancelled", "todo"): True,
+}
+
+
+# -------------------------------------------------------------------------
+# Exceptions
+# -------------------------------------------------------------------------
+
+
+class WorkItemError(Exception):
+    """Base exception for work item operations."""
+
+    def __str__(self) -> str:
+        return self.args[0] if self.args else self.__class__.__name__
+
+
+class WorkItemMapNotFoundError(WorkItemError):
+    """Map key unknown OR caller has no role on the map's team."""
+
+    def __init__(self) -> None:
+        super().__init__("map not found or access denied")
+
+
+class WorkItemPermissionDeniedError(WorkItemError):
+    """Caller has a role but lacks TEAM_WRITE_MEMORY permission."""
+
+    def __init__(self, permission: Permission, team_id: UUID) -> None:
+        super().__init__(f"permission denied: {permission.value} required for team {team_id}")
+        self.permission = permission
+        self.team_id = team_id
+
+
+class NodeNotInMapError(WorkItemError):
+    """Node not a member of that map or deleted."""
+
+    def __init__(self) -> None:
+        super().__init__("node not in map or deleted")
+
+
+class NotAWorkItemError(WorkItemError):
+    """Node in map but not marked as a work item."""
+
+    def __init__(self) -> None:
+        super().__init__("node is not a work item")
+
+
+class InvalidKindError(WorkItemError):
+    """Invalid kind value."""
+
+    def __init__(self, kind: str, allowed: tuple[str, ...]) -> None:
+        super().__init__(f"invalid kind {kind!r}; allowed: {allowed}")
+        self.kind = kind
+        self.allowed = allowed
+
+
+class InvalidStatusError(WorkItemError):
+    """Invalid status value."""
+
+    def __init__(self, status: str, allowed: tuple[str, ...]) -> None:
+        super().__init__(f"invalid status {status!r}; allowed: {allowed}")
+        self.status = status
+        self.allowed = allowed
+
+
+class RootNodeNotAllowedError(WorkItemError):
+    """Cannot mark the root node as a work item."""
+
+    def __init__(self) -> None:
+        super().__init__("root node cannot be a work item")
+
+
+class AlreadyWorkItemError(WorkItemError):
+    """Node is already marked as a work item."""
+
+    def __init__(self) -> None:
+        super().__init__("node is already a work item")
+
+
+class MapNotLiveError(WorkItemError):
+    """Cannot mark on archived map."""
+
+    def __init__(self) -> None:
+        super().__init__("map is archived; cannot create work item")
+
+
+class InvalidTransitionError(WorkItemError):
+    """Status transition not allowed."""
+
+    def __init__(self, current: str, requested: str) -> None:
+        super().__init__(f"cannot transition from {current} to {requested}")
+        self.current = current
+        self.requested = requested
+
+
+class ReasonRequiredError(WorkItemError):
+    """Transition requires a reason."""
+
+    def __init__(self, current: str, requested: str) -> None:
+        super().__init__(f"transition from {current} to {requested} requires a reason")
+        self.current = current
+        self.requested = requested
+
+
+class StatusUnchangedError(WorkItemError):
+    """Status already matches requested value."""
+
+    def __init__(self, current: str) -> None:
+        super().__init__(f"status already {current}")
+        self.current = current
+
+
+class StatusConflictError(WorkItemError):
+    """Expected status differs from actual."""
+
+    def __init__(self, expected: str, actual: str) -> None:
+        super().__init__(f"status conflict: expected {expected}, actual {actual}")
+        self.expected = expected
+        self.actual = actual
+
+
+class KindUnchangedError(WorkItemError):
+    """Kind already matches requested value."""
+
+    def __init__(self, kind: str) -> None:
+        super().__init__(f"kind already {kind}")
+        self.kind = kind
+
+
+class AssigneeUnchangedError(WorkItemError):
+    """Assignee already matches requested value."""
+
+    def __init__(self, assignee_id: UUID | None) -> None:
+        super().__init__(f"assignee already {assignee_id or 'unassigned'}")
+        self.assignee_id = assignee_id
+
+
+class InvalidAssigneeError(WorkItemError):
+    """Assignee is not a valid team member or role."""
+
+    def __init__(self, assignee_id: UUID) -> None:
+        super().__init__(f"invalid assignee {assignee_id}")
+        self.assignee_id = assignee_id
+
+
+# -------------------------------------------------------------------------
+# Dataclasses
+# -------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class WorkItem:
+    """A work item on a mind-map node."""
+
+    memory_id: UUID
+    root_memory_id: UUID
+    map_key: str
+    map_state: str
+    team_id: UUID
+    kind: str
+    status: str
+    assignee_id: UUID | None
+    title: str
+    created_by: UUID
+    created_at: datetime
+    updated_at: datetime
+    status_changed_at: datetime
+
+
+@dataclass(frozen=True)
+class WorkItemHistoryEntry:
+    """A single history entry for a work item change."""
+
+    id: int
+    memory_id: UUID
+    change_type: str
+    kind_before: str | None
+    kind_after: str
+    status_before: str | None
+    status_after: str
+    assignee_before: UUID | None
+    assignee_after: UUID | None
+    actor_id: UUID
+    channel: str
+    reason: str | None
+    created_at: datetime
+
+
+# -------------------------------------------------------------------------
+# Validation helpers
+# -------------------------------------------------------------------------
+
+
+def _validate_kind(kind: str) -> None:
+    """Validate kind is one of the allowed values."""
+    if kind not in WORK_KINDS:
+        raise InvalidKindError(kind, WORK_KINDS)
+
+
+def _validate_status(status: str) -> None:
+    """Validate status is one of the allowed values."""
+    if status not in WORK_STATUSES:
+        raise InvalidStatusError(status, WORK_STATUSES)
+
+
+def check_transition(current: str, requested: str, reason: str | None) -> None:
+    """Validate a status transition is allowed.
+
+    Raises InvalidTransitionError if not allowed, ReasonRequiredError if
+    a reason is required but not provided.
+    """
+    if (current, requested) not in TRANSITIONS:
+        raise InvalidTransitionError(current, requested)
+
+    # Reason should be pre-cleaned
+    if TRANSITIONS[(current, requested)] and not reason:
+        raise ReasonRequiredError(current, requested)
+
+
+def _extract_title(content: str) -> str:
+    """Extract title from node content (first line, max 120 chars)."""
+    first_line = content.split("\n")[0] if content else ""
+    if len(first_line) > 120:
+        return first_line[:119] + "…"
+    return first_line
+
+
+def _clean_reason(reason: str | None) -> str | None:
+    """Clean reason: strip, blank→None, cap 2000 chars."""
+    if reason is None:
+        return None
+    cleaned = reason.strip()
+    return cleaned[:2000] if cleaned else None
+
+
+# -------------------------------------------------------------------------
+# Internal helper functions for code reuse
+# -------------------------------------------------------------------------
+
+
+async def _load_map(
+    conn: asyncpg.Connection,
+    tenant_id: UUID,
+    team_id: UUID,
+    map_key: str,
+) -> tuple[UUID, dict[str, Any]]:
+    """Resolve map and verify access.
+
+    Returns (root_memory_id, map_row).
+    Raises WorkItemMapNotFoundError if map doesn't exist or caller has no role on team.
+    """
+    root_memory_id = await service.resolve_map_root(conn, team_id=team_id, map_key=map_key)
+    if root_memory_id is None:
+        raise WorkItemMapNotFoundError()
+
+    map_row = await service.get_map_row(conn, root_memory_id=root_memory_id)
+    if map_row is None:
+        raise WorkItemMapNotFoundError()
+
+    # Check caller has role on team (non-member gets map not found)
+    caller_role = await get_team_role(conn, tenant_id, team_id)
+    if caller_role is None:
+        raise WorkItemMapNotFoundError()
+
+    return root_memory_id, map_row
+
+
+async def _check_permission(
+    conn: asyncpg.Connection,
+    tenant_id: UUID,
+    team_id: UUID,
+) -> None:
+    """Check caller has write permission on team.
+
+    Raises WorkItemMapNotFoundError if caller has no role on team.
+    Raises WorkItemPermissionDeniedError if role lacks TEAM_WRITE_MEMORY.
+    """
+    caller_role = await get_team_role(conn, tenant_id, team_id)
+    if caller_role is None:
+        raise WorkItemMapNotFoundError()
+    if Permission.TEAM_WRITE_MEMORY not in ROLE_PERMISSIONS.get(caller_role, set()):
+        raise WorkItemPermissionDeniedError(Permission.TEAM_WRITE_MEMORY, team_id)
+
+
+async def _check_node_membership(
+    conn: asyncpg.Connection,
+    node_id: UUID,
+    root_memory_id: UUID,
+    tenant_id: UUID,
+) -> None:
+    """Verify node is a member of the map and not deleted."""
+    membership = await conn.fetchrow(
+        """
+        SELECT 1 FROM memory_map_membership mm
+        JOIN memories m ON m.id = mm.memory_id AND m.tenant_id = mm.tenant_id
+        WHERE mm.memory_id = $1 AND mm.root_memory_id = $2 AND mm.tenant_id = $3
+        AND m.deleted_at IS NULL
+        """,
+        node_id,
+        root_memory_id,
+        tenant_id,
+    )
+    if membership is None:
+        raise NodeNotInMapError()
+
+
+async def _load_work_item_for_update(
+    conn: asyncpg.Connection,
+    node_id: UUID,
+    tenant_id: UUID,
+    team_id: UUID,
+    root_memory_id: UUID,
+) -> asyncpg.Record:
