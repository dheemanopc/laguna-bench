+async def assign_work_item(
+    conn: asyncpg.Connection,
+    *,
+    tenant_id: UUID,
+    team_id: UUID,
+    map_key: str,
+    node_id: UUID,
+    assignee_id: UUID | None,
+    reason: str | None = None,
+    channel: str = "mcp",
+) -> WorkItem:
+    """Assign or unassign a work item."""
+    # Load and validate map (includes permission check)
+    root_memory_id, map_row = await _load_map(conn, tenant_id, team_id, map_key)
+
+    # Check permission (owner, admin, or member)
+    await _check_permission(conn, tenant_id, team_id)
+
+    # Load work item for update using helper
+    wi_row = await _load_work_item_for_update(conn, node_id, tenant_id, team_id, root_memory_id)
+
+    current_kind = wi_row["kind"]
+    current_status = wi_row["status"]
+    current_assignee = wi_row["assignee_id"]
+    cleaned_reason = _clean_reason(reason)
+
+    # If unassigning (assignee_id is None)
+    if assignee_id is None:
+        if current_assignee is None:
+            raise AssigneeUnchangedError(current_assignee)
+
+        # Unassign
+        await conn.execute(
+            """
+            UPDATE work_items
+            SET assignee_id = NULL, updated_at = now()
+            WHERE memory_id = $1 AND tenant_id = $2 AND team_id = $3 AND root_memory_id = $4
+            """,
+            node_id,
+            tenant_id,
+            team_id,
+            root_memory_id,
+        )
+
+        # Append history using helper
+        await _append_history(
+            conn,
+            node_id,
+            root_memory_id,
+            tenant_id,
+            team_id,
+            "owner",
+            current_kind,
+            current_kind,
+            current_status,
+            current_status,
+            current_assignee,
+            None,  # assignee_after
+            tenant_id,
+            channel,
+            cleaned_reason,
+        )
+
+        # Record change using helper
+        await _record_change(
+            conn,
+            root_memory_id=root_memory_id,
+            tenant_id=tenant_id,
+            event="work_item",
+            actor="model" if channel == "mcp" else "owner",
+            memory_id=node_id,
+            payload={
+                "change": "owner",
+                "from": str(current_assignee) if current_assignee else None,
+                "to": None,
+            },
+        )
+
+    else:
+        # Check assignee unchanged
+        if current_assignee == assignee_id:
+            raise AssigneeUnchangedError(assignee_id)
+
+        # Validate assignee has an active role
+        assignee_role = await get_team_role(conn, assignee_id, team_id)
+        if assignee_role is None or assignee_role not in ASSIGNABLE_ROLES:
+            raise InvalidAssigneeError(assignee_id)
+
+        # Update assignee
+        await conn.execute(
+            """
+            UPDATE work_items
+            SET assignee_id = $1, updated_at = now()
+            WHERE memory_id = $2 AND tenant_id = $3 AND team_id = $4 AND root_memory_id = $5
+            """,
+            assignee_id,
+            node_id,
+            tenant_id,
+            team_id,
+            root_memory_id,
+        )
+
+        # Append history using helper
+        await _append_history(
+            conn,
+            node_id,
+            root_memory_id,
+            tenant_id,
+            team_id,
+            "owner",
+            current_kind,
+            current_kind,
+            current_status,
+            current_status,
+            current_assignee,
+            assignee_id,
+            tenant_id,
+            channel,
+            cleaned_reason,
+        )
+
+        # Record change using helper
+        await _record_change(
+            conn,
+            root_memory_id=root_memory_id,
+            tenant_id=tenant_id,
+            event="work_item",
+            actor="model" if channel == "mcp" else "owner",
+            memory_id=node_id,
+            payload={
+                "change": "owner",
+                "from": str(current_assignee) if current_assignee else None,
+                "to": str(assignee_id),
+            },
+        )
+
+    # Get node content for title
+    node_row = await conn.fetchrow(
+        "SELECT content FROM memories WHERE id = $1 AND tenant_id = $2",
+        node_id,
+        tenant_id,
+    )
+    title = _extract_title(node_row["content"]) if node_row else ""
+
+    # Return updated work item
+    updated = await conn.fetchrow(
+        "SELECT * FROM work_items WHERE memory_id = $1 AND tenant_id = $2 AND team_id = $3 AND root_memory_id = $4",
+        node_id,
+        tenant_id,
+        team_id,
+        root_memory_id,
+    )
+    assert updated is not None
+
+    return WorkItem(
+        memory_id=updated["memory_id"],
+        root_memory_id=updated["root_memory_id"],
+        map_key=map_key,
+        map_state=map_row["state"],
+        team_id=updated["team_id"],
+        kind=updated["kind"],
+        status=updated["status"],
+        assignee_id=updated["assignee_id"],
+        title=title,
+        created_by=updated["created_by"],
+        created_at=updated["created_at"],
+        updated_at=updated["updated_at"],
+        status_changed_at=updated["status_changed_at"],
+    )
+
