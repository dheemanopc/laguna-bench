+async def list_work_items(
+    conn: asyncpg.Connection,
+    *,
+    tenant_id: UUID,
+    team_id: UUID,
+    map_key: str | None = None,
+    status: str | None = None,
+    kind: str | None = None,
+    assignee_id: UUID | None = None,
+    unassigned: bool = False,
+    map_state: str | None = None,
+    limit: int = 100,
+) -> list[WorkItem]:
+    """List work items for a team or map.
+
+    If map_key is None, lists work items for the whole team.
+    Caller must have a role on the team.
+    Ordered by updated_at DESC, memory_id.
+    Excludes deleted nodes.
+    """
+    # Validate filter values
+    if status is not None and status not in WORK_STATUSES:
+        raise InvalidStatusError(status, WORK_STATUSES)
+    if kind is not None and kind not in WORK_KINDS:
+        raise InvalidKindError(kind, WORK_KINDS)
+    if map_state is not None and map_state not in ("live", "archived"):
+        raise ValueError(f"map_state must be 'live' or 'archived', got {map_state!r}")
+
+    # Mutually exclusive: assignee_id and unassigned
+    if assignee_id is not None and unassigned:
+        raise ValueError("assignee_id and unassigned are mutually exclusive")
+
+    # Clamp limit to 1..500
+    limit = max(1, min(limit, 500))
+
+    # Resolve map_key first (always check role when map_key is given)
+    root_memory_id = None
+    if map_key is not None:
+        root_memory_id = await service.resolve_map_root(conn, team_id=team_id, map_key=map_key)
+        if root_memory_id is None:
+            raise WorkItemMapNotFoundError()
+
+    # ALWAYS check caller has role on team
+    caller_role = await get_team_role(conn, tenant_id, team_id)
+    if caller_role is None:
+        raise WorkItemMapNotFoundError()
+
+    # Build query
+    clauses = ["wi.tenant_id = $1", "wi.team_id = $2"]
+    args: list[Any] = [tenant_id, team_id]
+
+    if root_memory_id is not None:
+        args.append(root_memory_id)
+        clauses.append(f"wi.root_memory_id = ${len(args)}")
+
+    if status is not None:
+        args.append(status)
+        clauses.append(f"wi.status = ${len(args)}")
+
+    if kind is not None:
+        args.append(kind)
+        clauses.append(f"wi.kind = ${len(args)}")
+
+    if assignee_id is not None:
+        args.append(assignee_id)
+        clauses.append(f"wi.assignee_id = ${len(args)}")
+
+    if unassigned:
+        clauses.append("wi.assignee_id IS NULL")
+
+    if map_state is not None:
+        args.append(map_state)
+        clauses.append(f"mp.state = ${len(args)}")
+
+    sql = f"""
+    SELECT wi.*, mp.state as map_state, s.slug as map_key, m.content
+    FROM work_items wi
+    JOIN memory_map_membership mm ON mm.memory_id = wi.memory_id AND mm.root_memory_id = wi.root_memory_id
+    JOIN memory_maps mp ON mp.root_memory_id = mm.root_memory_id
+    JOIN memories m ON m.id = wi.memory_id AND m.tenant_id = wi.tenant_id
+    LEFT JOIN slugs s ON s.memory_id = wi.root_memory_id AND s.team_id = wi.team_id AND s.resource_type = 'map'
+    WHERE {" AND ".join(clauses)}
+    ORDER BY wi.updated_at DESC NULLS LAST, wi.memory_id
+    LIMIT ${len(args) + 1}
+    """
+
+    rows = await conn.fetch(sql, *args, limit)
+
+    return [
+        WorkItem(
+            memory_id=r["memory_id"],
+            root_memory_id=r["root_memory_id"],
+            map_key=r["map_key"] or map_key or "",
+            map_state=r["map_state"],
+            team_id=r["team_id"],
+            kind=r["kind"],
+            status=r["status"],
+            assignee_id=r["assignee_id"],
+            title=_extract_title(r["content"]) if r["content"] else "",
+            created_by=r["created_by"],
+            created_at=r["created_at"],
+            updated_at=r["updated_at"],
+            status_changed_at=r["status_changed_at"],
+        )
+        for r in rows
+    ]
+
+
+async def get_work_item_history(
+    conn: asyncpg.Connection,
+    *,
+    tenant_id: UUID,
+    team_id: UUID,
+    map_key: str,
+    node_id: UUID,
+) -> list[WorkItemHistoryEntry]:
+    """Get the history of a work item (oldest first by id)."""
+    # Resolve map
+    root_memory_id = await service.resolve_map_root(conn, team_id=team_id, map_key=map_key)
+    if root_memory_id is None:
+        raise WorkItemMapNotFoundError()
+
+    map_row = await service.get_map_row(conn, root_memory_id=root_memory_id)
+    if map_row is None:
+        raise WorkItemMapNotFoundError()
+
+    # Check permission
+    caller_role = await get_team_role(conn, tenant_id, team_id)
+    if caller_role is None:
+        raise WorkItemMapNotFoundError()
+
+    # Ensure the node is in this map
+    membership = await conn.fetchrow(
+        """
+        SELECT 1 FROM memory_map_membership
+        WHERE memory_id = $1 AND root_memory_id = $2 AND tenant_id = $3
+        """,
+        node_id,
+        root_memory_id,
+        tenant_id,
+    )
+    if membership is None:
+        raise NodeNotInMapError()
+
+    # Check if the node is a work item (root_memory_id filter to prevent cross-map access)
+    wi_row = await conn.fetchrow(
+        "SELECT memory_id FROM work_items WHERE memory_id = $1 AND tenant_id = $2 AND root_memory_id = $3",
+        node_id,
+        tenant_id,
+        root_memory_id,
+    )
+    if wi_row is None:
+        raise NotAWorkItemError()
+
+    # Get history (ordered by id ascending for oldest-first)
+    rows = await conn.fetch(
+        """
+        SELECT id, memory_id, change_type, kind_before, kind_after,
+               status_before, status_after,
+               assignee_before, assignee_after, actor_id, channel, reason, created_at
+        FROM work_item_history
+        WHERE memory_id = $1 AND tenant_id = $2 AND root_memory_id = $3
+        ORDER BY id ASC
+        """,
+        node_id,
+        tenant_id,
+        root_memory_id,
+    )
+
+    # Return empty list if no history (not an error)
+    return [
+        WorkItemHistoryEntry(
+            id=r["id"],
+            memory_id=r["memory_id"],
+            change_type=r["change_type"],
+            kind_before=r["kind_before"],
+            kind_after=r["kind_after"],
+            status_before=r["status_before"],
+            status_after=r["status_after"],
+            assignee_before=r["assignee_before"],
+            assignee_after=r["assignee_after"],
+            actor_id=r["actor_id"],
+            channel=r["channel"],
+            reason=r["reason"],
+            created_at=r["created_at"],
+        )
+        for r in rows
+    ]
+
+
+async def work_items_for_nodes(
+    conn: asyncpg.Connection,
+    *,
+    tenant_id: UUID,
+    node_ids: list[UUID],
+) -> dict[UUID, tuple[str, str, UUID | None]]:
+    """Light lookup returning (kind, status, assignee_id) for each node.
+
+    Used for mindmap_get embedding to show work item info inline.
+    Excludes deleted nodes.
+    """
+    if not node_ids:
+        return {}
+
+    rows = await conn.fetch(
+        """
+        SELECT wi.memory_id, wi.kind, wi.status, wi.assignee_id
+        FROM work_items wi
+        JOIN memories m ON m.id = wi.memory_id AND m.tenant_id = wi.tenant_id
+        WHERE wi.tenant_id = $1 AND wi.memory_id = ANY($2::uuid[]) AND m.deleted_at IS NULL
+        """,
+        tenant_id,
+        node_ids,
+    )
+
+    return {r["memory_id"]: (r["kind"], r["status"], r["assignee_id"]) for r in rows}
