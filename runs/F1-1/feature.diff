+async def test_cross_tenant_assignee_rejected(
+    pg_pool: asyncpg.Pool,
+    tenant_a: UUID,
+    team_a: UUID,
+    tenant_b: UUID,  # Different tenant - not on same team
+    map_setup: tuple[UUID, UUID, str],
+) -> None:
+    """Assigning someone from another tenant should be rejected."""
+    from mem_mcp.mindmap import work_items
+
+    root_mem_id, node_id, map_key = map_setup
+
+    # Mark as work item
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        await work_items.mark_work_item(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            map_key=map_key,
+            node_id=node_id,
+            kind="story",
+        )
+
+    # tenant_b is on team_b, not team_a - cannot be assignee
+    with pytest.raises(InvalidAssigneeError) as exc_info:
+        async with tenant_tx(pg_pool, tenant_a) as conn:
+            await work_items.assign_work_item(
+                conn,
+                tenant_id=tenant_a,
+                team_id=team_a,
+                map_key=map_key,
+                node_id=node_id,
+                assignee_id=tenant_b,  # From different tenant/team
+            )
+
+    assert exc_info.value.assignee_id == tenant_b
+
