+async def test_migration_check_rejects_bogus_status(world: Any) -> None:
+    pool, tenant, n1 = world["pool"], world["tenant"], world["n1_id"]
+    with pytest.raises(asyncpg.exceptions.CheckViolationError):
+        async with tenant_tx(pool, tenant) as conn:
+            await conn.execute(
+                "UPDATE memory_map_membership SET status = 'bogus' WHERE memory_id = $1",
+                n1,
+            )
+
