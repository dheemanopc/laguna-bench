@@ -0,0 +1,777 @@
+"""End-to-end integration tests for mindmap_resolve + the open_loops / cheap-read
+contracts it underpins.
+
+Reuses the fixture pattern from tests/integration/test_mindmap_e2e.py
+(UUID-suffixed tenant/team, stub embedder, ToolContext built from pg_pool).
+
+Covers (work order §Tests):
+- resolve → stored status + resolver edge (resolves-under) + resolve event +
+  cursor (the high-water mark). resolved and dropped paths both.
+- re-resolve overwrites status; new edge row when the kind changes.
+- no-resolver resolve settles the branch but writes NO edge (resolver edge is
+  purely the optional citation).
+- Error paths that must leave the branch untouched (status stays open, no edge,
+  no new event): unknown map, settling the root, node not a member of the map
+  (cross-map), resolver not a member of the map, archived map.
+- open_loops semantics: owner+model open nodes; excludes unresourced nodes,
+  excludes resolved nodes, and — critically — a bare mindmap_link carrying a
+  `resolves-under` kind does NOT settle a branch.
+- mindmap_get defaults: settled branches compact into `resolved` (not nodes);
+  include="all" surfaces status on every node; summary depth truncates >200
+  chars with a U+2026 ellipsis and sets `truncated`; full depth is verbatim.
+- cheap delta via since/cursor: a second get with the echoed cursor returns an
+  empty delta.
+- migration 0044 CHECK reject status='bogus'.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID, uuid4
+
+import asyncpg  # type: ignore[import-untyped]
+import pytest
+
+from mem_mcp.db import tenant_tx
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools.mindmap_get import MindmapGetInput, MindmapGetTool
+from mem_mcp.mcp.tools.mindmap_link import MindmapLinkInput, MindmapLinkTool
+from mem_mcp.mcp.tools.mindmap_open import MindmapOpenInput, MindmapOpenTool
+from mem_mcp.mcp.tools.mindmap_resolve import MindmapResolveInput, MindmapResolveTool
+from mem_mcp.mcp.tools.mindmap_write_node import MindmapWriteNodeInput, MindmapWriteNodeTool
+from mem_mcp.mindmap import service
+from mem_mcp.teams.assignments import assign_role
+
+pytestmark = pytest.mark.asyncio
+
+_RESOLVES_UNDER = "resolves-under"
+_DROPPED_UNDER = "dropped-under"
+
