+async def fetch_touched_since(
+    conn: asyncpg.Connection, *, root_memory_id: UUID, tenant_id: UUID, since: int
+) -> set[UUID]:
+    """Memory ids touched by this map's events with id > ``since``.
+
+    Collects: the event's ``memory_id``, plus ``payload->>'target'`` (link
+    events, as mindmap_link logs them), and ``payload->>'node_id'`` if any
+    future event kind carries one. The caller intersects this with the map's
+    actual members — events may reference memories that are not (or no longer)
+    members of the map.
+    """
+    # All three branches select a uuid so the UNION is type-consistent (a bare
+    # payload->>'target' is text and would mismatch the memory_id uuid column).
+    rows = await conn.fetch(
+        """
+        SELECT memory_id FROM (
+            SELECT memory_id FROM memory_map_events
+            WHERE root_memory_id = $1 AND tenant_id = $2 AND id > $3
+              AND memory_id IS NOT NULL
+            UNION ALL
+            SELECT (payload->>'target')::uuid FROM memory_map_events
+            WHERE root_memory_id = $1 AND tenant_id = $2 AND id > $3
+              AND (payload->>'target') IS NOT NULL
+            UNION ALL
+            SELECT (payload->>'node_id')::uuid FROM memory_map_events
+            WHERE root_memory_id = $1 AND tenant_id = $2 AND id > $3
+              AND (payload->>'node_id') IS NOT NULL
+        ) AS touched(memory_id)
+        """,
+        root_memory_id,
+        tenant_id,
+        since,
+    )
+    touched: set[UUID] = set()
+    for r in rows:
+        raw = r[0]
+        if raw is not None:
+            touched.add(raw if isinstance(raw, UUID) else UUID(str(raw)))
+    return touched
