+async def test_cross_tenant_resolve_rejected(world: Any) -> None:
+    pool = world["pool"]
+    # a second tenant/team on the same DB
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            s2 = await _setup(conn)
+    ctx2 = _ctx(pool, s2["tenant"], s2["client_id"])
+    before_cursor = await _cursor(pool, world["tenant"], world["root_id"])
+
+    # tenant 2 names tenant 1's map_key + node_id, with tenant 1's team_id forced
+    # so the rejection hits the membership RLS (not just slug visibility).
+    with pytest.raises(JsonRpcError) as ei:
+        await MindmapResolveTool()(
+            ctx2,
+            MindmapResolveInput(
+                map_key=world["map_key"],
+                node_id=world["n1_id"],
+                resolution_summary="should not persist",
+                team_id=world["team"],
+            ),
+        )
+    assert ei.value.code == -32602
+
+    # tenant 1's map is untouched: no event, no edge, status still open.
+    assert await _cursor(pool, world["tenant"], world["root_id"]) == before_cursor
+    assert await _resolve_edges_for(pool, world["tenant"], world["n1_id"]) == []
+    assert (await _membership(pool, world["tenant"], world["n1_id"]))["status"] == "open"
+
+    await _cleanup(pool, s2["tenant"], s2["team"], s2["client_id"])
+
