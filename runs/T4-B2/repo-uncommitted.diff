+class MindmapResolveOutput(BaseModel):
+    node_id: UUID
+    status: str
+    resolution_summary: str
+    cursor: int
+    request_id: str
+
+
+class MindmapResolveTool(BaseTool):
+    name: ClassVar[str] = "mindmap_resolve"
+    description: ClassVar[str] = TOOL_DESCRIPTIONS["mindmap_resolve"]
+    required_scope: ClassVar[str] = "memory.write"
+    InputModel: ClassVar[type[BaseModel]] = MindmapResolveInput
+    OutputModel: ClassVar[type[BaseModel]] = MindmapResolveOutput
+
+    async def __call__(self, ctx: ToolContext, inp: BaseModel) -> BaseModel:
+        assert isinstance(inp, MindmapResolveInput)
+
+        edge_target_memory_id: UUID | None = None
+        edge_target_team_id: UUID | None = None
+        # Bind once; branching on `is not None` narrows to UUID for mypy across
+        # all phases (validate, resolve, re-check + edge write). Replaces the
+        # `will_resolve_with_edge` bool so the resolver id stays narrowed.
+        resolver_id: UUID | None = inp.resolved_by_memory_id
+
+        # --- Phase 1: validation reads (read-only tenant_tx). -------------------
+        # Resolve team + map, assert live, validate node membership. A failure
+        # here aborts before any write so the branch is never left half-settled.
+        async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+            team_id = await resolve_team_id(conn, ctx, inp.team_id)
+            root_id = await service.resolve_map_root(conn, team_id=team_id, map_key=inp.map_key)
+            if root_id is None:
+                raise JsonRpcError(
+                    -32602, "map not found", data={"errors": [{"path": "map_key"}]}
+                )
+            row = await service.get_map_row(conn, root_memory_id=root_id)
+            assert row is not None
+            # No-reopen lifecycle rule: archived maps are immutable.
+            if row["state"] != "live":
+                raise JsonRpcError(
+                    -32602,
+                    "map is archived; closed maps are immutable",
+                    data={"code": "map_not_live"},
+                )
+
+            # node_id must be a member of THIS map (opaque across maps/tenant).
+            membership = await service.get_membership(
+                conn,
+                memory_id=inp.node_id,
+                root_memory_id=root_id,
+                tenant_id=ctx.tenant_id,
+            )
+            if membership is None:
+                raise JsonRpcError(
+                    -32602,
+                    "node is not a member of this map",
+                    data={
+                        "errors": [
+                            {
+                                "path": "node_id",
+                                "message": "node is not a member of this map",
+                            }
+                        ]
+                    },
+                )
+            # Settling the root settles the whole map — that is mindmap_close.
+            if membership["node_role"] == "root":
