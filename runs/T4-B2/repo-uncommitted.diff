+            # membership row vanished between Phase 1 and now, the WHERE matches
+            # nothing and `updated` is False.
+            updated = await service.set_branch_status(
+                conn,
+                memory_id=inp.node_id,
+                root_memory_id=root_id,
+                tenant_id=ctx.tenant_id,
+                status=inp.disposition,
+                resolution_summary=inp.resolution_summary,
+                resolved_by_memory_id=inp.resolved_by_memory_id,
+                resolved_by_party=inp.resolved_by_party,
+            )
+            if not updated:
+                raise JsonRpcError(
+                    -32602,
+                    "node is not a member of this map",
+                    data={
+                        "errors": [
+                            {
+                                "path": "node_id",
+                                "message": "node is not a member of this map",
+                            }
+                        ]
+                    },
+                )
+            if resolver_id is not None:
+                assert resolver_id is not None
+                assert edge_target_memory_id is not None
+                assert edge_target_team_id is not None
+                await insert_reference(
+                    conn,
+                    source_memory_id=resolver_id,
+                    target_memory_id=edge_target_memory_id,
+                    target_team_id=edge_target_team_id,
+                    reference_kind=edge_kind,
+                )
+            event_id = await service.log_event(
+                conn,
+                root_memory_id=root_id,
+                tenant_id=ctx.tenant_id,
+                event="resolve",
+                actor=inp.resolved_by_party,
+                memory_id=inp.node_id,
+                payload={
+                    "disposition": inp.disposition,
+                    "resolved_by_memory_id": str(inp.resolved_by_memory_id)
+                    if inp.resolved_by_memory_id
+                    else None,
+                    "reference_kind": edge_kind if resolver_id is not None else None,
+                },
+            )
+
+        return MindmapResolveOutput(
+            node_id=inp.node_id,
+            status=inp.disposition,
+            resolution_summary=inp.resolution_summary,
+            cursor=event_id,
+            request_id=ctx.request_id,
+        )
