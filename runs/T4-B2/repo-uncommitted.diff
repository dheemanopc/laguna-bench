+# --------------------------------------------------------------------------- #
+# Round-3 review coverage: cheap-read post-resolve, edge surface, cross-tenant,
+# and the truncation boundary (exactly SUMMARY_CONTENT_CHARS chars).
+# --------------------------------------------------------------------------- #
+
+
+async def test_since_after_resolve_compacts_and_echoes_cursor(world: Any) -> None:
+    ctx, pool, tenant = world["ctx"], world["pool"], world["tenant"]
+    map_key, root, n1 = world["map_key"], world["root_id"], world["n1_id"]
+
+    resolve_out = await MindmapResolveTool()(
+        ctx,
+        MindmapResolveInput(
+            map_key=map_key,
+            node_id=n1,
+            disposition="resolved",
+            resolution_summary="compacted",
+            resolved_by_memory_id=root,
+        ),
+    )
+    # since=0 drives the whole-map delta path: events 1 (open) and 2 (n1 write)
+    # touch root and n1, so BOTH are candidates. Settled under include="open" the
+    # n1 branch compacts into the `resolved` bucket; the open root stays in nodes.
+    got = await MindmapGetTool()(ctx, MindmapGetInput(map_key=map_key, since=0))
+    assert [r.memory_id for r in got.resolved] == [n1]
+    assert n1 not in {n.memory_id for n in got.nodes}
+    assert root in {n.memory_id for n in got.nodes}
+    assert resolve_out.cursor == got.cursor
+
+    # include="all" surfaces the settled status on the node; nothing is compacted.
+    got_all = await MindmapGetTool()(
+        ctx, MindmapGetInput(map_key=map_key, since=0, include="all")
+    )
+    by_id = {n.memory_id: n for n in got_all.nodes}
+    assert n1 in by_id
+    assert by_id[n1].status == "resolved"
+    assert got_all.resolved == []
+    assert got_all.cursor == resolve_out.cursor
+
+
+async def test_resolve_edge_visible_in_get_edges(world: Any) -> None:
+    ctx = world["ctx"]
+    root, n1 = world["root_id"], world["n1_id"]
+
+    await MindmapResolveTool()(
+        ctx,
+        MindmapResolveInput(
+            map_key=world["map_key"],
+            node_id=n1,
+            disposition="resolved",
+            resolution_summary="edge test",
+            resolved_by_memory_id=root,
+        ),
+    )
+    got = await MindmapGetTool()(ctx, MindmapGetInput(map_key=world["map_key"]))
+    triples = {(e.source_memory_id, e.target_memory_id, e.reference_kind) for e in got.edges}
+    # the settling node draws a typed edge onto the settled node
+    assert (root, n1, _RESOLVES_UNDER) in triples
+
