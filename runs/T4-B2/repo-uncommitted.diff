+    # settle n3 → it leaves the open-loop surface
+    await MindmapResolveTool()(
+        ctx,
+        MindmapResolveInput(
+            map_key=map_key,
+            node_id=n3.node_id,
+            disposition="resolved",
+            resolution_summary="decided",
+            resolved_by_memory_id=root,
+        ),
+    )
+    got2 = await MindmapGetTool()(ctx, MindmapGetInput(map_key=map_key))
+    assert set(got2.open_loops) == {n1, n2.node_id}
+    assert n3.node_id not in got2.open_loops
