+async def test_resolve_dropped_overwrites_status_and_edge(world: Any) -> None:
+    ctx, pool, tenant = world["ctx"], world["pool"], world["tenant"]
+    root, n1 = world["root_id"], world["n1_id"]
+
+    first = await MindmapResolveTool()(
+        ctx,
