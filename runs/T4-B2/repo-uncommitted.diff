+        edge_kind = (
+            REFERENCE_KIND_DROPPED_UNDER
+            if inp.disposition == BRANCH_STATUS_DROPPED
+            else REFERENCE_KIND_RESOLVES_UNDER
+        )
+
+        async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+            # Re-acquire a live view of the map under an exclusive row lock so a
+            # concurrent mindmap_close/mindmap_open cannot flip `state` past
+            # Phase 1's live-check. Phase-1 checks stay above for fail-fast abort
+            # before the system_tx; these re-checks are the race-safe guards.
+            live_state = await service.lock_map_state(
+                conn, root_memory_id=root_id, tenant_id=ctx.tenant_id
+            )
+            if live_state is None:
+                raise JsonRpcError(
+                    -32602, "map not found", data={"errors": [{"path": "map_key"}]}
+                )
+            if live_state != "live":
+                raise JsonRpcError(
+                    -32602,
+                    "map is archived; closed maps are immutable",
+                    data={"code": "map_not_live"},
+                )
+            # Resolver, if given, must still be a distinct member of this map.
+            if resolver_id is not None:
+                if resolver_id == inp.node_id:
+                    raise JsonRpcError(
+                        -32602,
+                        "resolved_by_memory_id must differ from node_id",
+                        data={"errors": [{"path": "resolved_by_memory_id"}]},
+                    )
+                resolver_mem = await service.get_membership(
+                    conn,
+                    memory_id=resolver_id,
+                    root_memory_id=root_id,
+                    tenant_id=ctx.tenant_id,
+                )
+                if resolver_mem is None:
+                    raise JsonRpcError(
+                        -32602,
+                        "resolved_by_memory_id is not a member of this map",
+                        data={"errors": [{"path": "resolved_by_memory_id"}]},
+                    )
