+    )
+    n3 = await _write_node(
+        ctx, map_key, "a note", node_role="note", responsible_party="owner"
+    )  # owner turn → loop candidate
+    n4 = await _write_node(ctx, map_key, "no party set")  # responsible_party None → NOT a loop
+
+    got = await MindmapGetTool()(ctx, MindmapGetInput(map_key=map_key))
+    # root has no responsible_party → not a loop; n4 unresourced → not a loop
+    assert set(got.open_loops) == {n1, n2.node_id, n3.node_id}
