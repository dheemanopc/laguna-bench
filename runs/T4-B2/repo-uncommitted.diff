+async def test_resolve_resolved_path_settles_branch(world: Any) -> None:
+    ctx, pool, tenant = world["ctx"], world["pool"], world["tenant"]
+    root, n1 = world["root_id"], world["n1_id"]
+
+    out = await MindmapResolveTool()(
+        ctx,
+        MindmapResolveInput(
+            map_key=world["map_key"],
+            node_id=n1,
+            disposition="resolved",
+            resolution_summary="went with Redis",
+            resolved_by_memory_id=root,
+            resolved_by_party="model",
+        ),
+    )
+    assert out.status == "resolved"
+    assert out.resolution_summary == "went with Redis"
+    assert out.cursor > 0
+
+    # stored branch status
+    mem = await _membership(pool, tenant, n1)
+    assert mem is not None
+    assert mem["status"] == "resolved"
+    assert mem["resolution_summary"] == "went with Redis"
+    assert mem["resolved_by_party"] == "model"
+    assert mem["resolved_by_memory_id"] == root
+    assert mem["resolved_at"] is not None
+
+    # resolver edge: root → n1, resolves-under
+    assert _RESOLVES_UNDER in await _resolve_edges_for(pool, tenant, n1)
+
+    # event logged as the resolve act; cursor == high-water mark
+    ev = await _last_event(pool, tenant, root)
+    assert ev["event"] == "resolve"
+    assert ev["actor"] == "model"
+    assert ev["memory_id"] == n1
+    assert ev["payload"]["disposition"] == "resolved"
+    assert ev["payload"]["reference_kind"] == _RESOLVES_UNDER
+    assert await _cursor(pool, tenant, root) == out.cursor
+
