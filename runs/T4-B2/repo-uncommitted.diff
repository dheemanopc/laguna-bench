+"""Branch settlement is stored state, not inferred.
+
+Per mind-map build design (docs/mindmap-v1-build-design.md) decision f5e52f08:
+open/closed status of a branch must be durable, queryable state so that
+`mindmap_get` can return cheap incremental reads (`since`/cursor) and so
+`open_loops` can be computed without scanning the unvalidated free-text
+`memory_references.reference_kind` column.
+
+Settlement must NEVER be inferred from `reference_kind`: that column is open
+text, zero schema enforcement, and an arbitrary edge label (e.g. a bare
+`mindmap_link` with a `resolves-under` kind) must NOT settle a branch. The
+only thing that settles a branch is an explicit `mindmap_resolve` write into
+the `status` column below. This migration adds that stored status to
+`memory_map_membership` and makes the consistency rules structural (DB CHECK,
+not application convention).
+
+Revision ID: 0044_mindmap_branch_status
+Revises: 0043_backfill_personal_teams
+Create Date: 2026-10-15
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0044_mindmap_branch_status"
+down_revision = "0043_backfill_personal_teams"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    # ---- stored branch settlement state -------------------------------------
+    # status defaults to 'open'; resolved/dropped rows are written by
+    # mindmap_resolve with the resolution_summary/party/edge populated.
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership ADD COLUMN status TEXT NOT NULL DEFAULT 'open'"
+        )
+    )
+    op.execute(
+        sa.text("ALTER TABLE memory_map_membership ADD COLUMN resolution_summary TEXT")
+    )
+    # FK to memories lets the resolver cite the settling node as a KB memory
+    # (ON DELETE SET NULL so resolving-party deletion doesn't corrupt history).
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership ADD COLUMN resolved_by_memory_id UUID "
+            "REFERENCES memories(id) ON DELETE SET NULL"
+        )
+    )
+    op.execute(
+        sa.text("ALTER TABLE memory_map_membership ADD COLUMN resolved_by_party TEXT")
+    )
+    op.execute(
+        sa.text("ALTER TABLE memory_map_membership ADD COLUMN resolved_at TIMESTAMPTZ")
+    )
+
+    # ---- named CHECK constraints --------------------------------------------
+    # Allowed status values.
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership "
+            "ADD CONSTRAINT memory_map_membership_status_check "
+            "CHECK (status IN ('open','resolved','dropped'))"
+        )
+    )
+    # resolution_summary length bound (empty string is NOT a valid summary).
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership "
+            "ADD CONSTRAINT memory_map_membership_resolution_summary_len CHECK "
+            "(resolution_summary IS NULL OR "
+            "(LENGTH(resolution_summary) >= 1 AND LENGTH(resolution_summary) <= 500))"
+        )
+    )
+    # resolved_by_party must be one of the two actors that can settle a branch.
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership "
+            "ADD CONSTRAINT memory_map_membership_resolved_by_party_check CHECK "
+            "(resolved_by_party IS NULL OR resolved_by_party IN ('owner','model'))"
+        )
+    )
+    # Cross-column consistency: the four resolution columns must be all-NULL
+    # for an open branch, and the three NOT-NULL-able ones must be present for
+    # a settled (resolved/dropped) branch. This is the structural guarantee
+    # that makes settlement never depend on reference_kind.
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership "
+            "ADD CONSTRAINT memory_map_membership_status_consistency CHECK ("
+            "  (status = 'open' AND resolution_summary IS NULL AND resolved_by_party IS NULL "
+            "   AND resolved_at IS NULL AND resolved_by_memory_id IS NULL)"
+            "  OR"
+            "  (status IN ('resolved','dropped') AND resolution_summary IS NOT NULL "
+            "   AND resolved_by_party IS NOT NULL AND resolved_at IS NOT NULL)"
+            ")"
+        )
+    )
+
+    # Existing RLS + GRANT policies on memory_map_membership (migration 0038)
+    # already scope every row to the current tenant, so the new columns are
+    # covered by the same row-level protection — no new policy needed.
+
+
+def downgrade() -> None:
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership DROP CONSTRAINT IF EXISTS "
+            "memory_map_membership_status_consistency"
+        )
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership DROP CONSTRAINT IF EXISTS "
+            "memory_map_membership_resolved_by_party_check"
+        )
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership DROP CONSTRAINT IF EXISTS "
+            "memory_map_membership_resolution_summary_len"
+        )
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership DROP CONSTRAINT IF EXISTS "
+            "memory_map_membership_status_check"
+        )
+    )
+    op.execute(sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolved_at"))
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolved_by_party"
+        )
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolved_by_memory_id"
+        )
+    )
+    op.execute(
+        sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolution_summary")
+    )
+    op.execute(sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS status"))
