+"""Unit tests for mindmap_resolve input validation + mindmap_get read levers.
+
+Covers (work order §Tests):
+- MindmapResolveInput: summary required + length bounds, disposition/party
+  enums, defaults, extra fields forbidden.
+- MindmapGetInput: defaults (since=None, include=open, depth=summary),
+  since ge=0 rejects negatives.
+- The content truncation helper at the 199/200/201 char boundary and full depth.
+"""
+
+from __future__ import annotations
+
+import pytest
+from pydantic import ValidationError
+from uuid import uuid4
+
+from mem_mcp.mcp.tools.mindmap_get import SUMMARY_CONTENT_CHARS, MindmapGetInput, _truncate_content
+from mem_mcp.mcp.tools.mindmap_resolve import MindmapResolveInput
+
+
+# --------------------------------------------------------------------------- #
+# MindmapResolveInput validation
+# --------------------------------------------------------------------------- #
+
+
+class TestMindmapResolveInput:
+    def _base(self, **overides: object) -> dict[str, object]:
+        d: dict[str, object] = {
+            "map_key": "caching-strategy",
+            "node_id": str(uuid4()),
+            "resolution_summary": "settled: went with Redis",
+        }
+        d.update(overides)
+        return d
+
+    def test_defaults(self) -> None:
+        inp = MindmapResolveInput(**self._base())  # type: ignore[arg-type]
+        assert inp.disposition == "resolved"
+        assert inp.resolved_by_party == "model"
+        assert inp.resolved_by_memory_id is None
+        assert inp.team_id is None
+
+    def test_summary_required(self) -> None:
+        bad = self._base()
+        del bad["resolution_summary"]
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(**bad)  # type: ignore[arg-type]
+
+    def test_summary_length_bounds(self) -> None:
+        # empty string rejected (min_length=1)
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(**self._base(resolution_summary=""))
+        # exactly 500 accepted
+        MindmapResolveInput(**self._base(resolution_summary="x" * 500))
+        # 501 rejected
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(**self._base(resolution_summary="x" * 501))
+
+    def test_bad_disposition_rejected(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(**self._base(disposition="maybe"))
+
+    def test_bad_party_rejected(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(**self._base(resolved_by_party="auditor"))
+
+    def test_extra_fields_forbidden(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(**self._base(not_a_field=True))  # type: ignore[arg-type]
+
+    def test_map_key_length(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(**self._base(map_key=""))
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(**self._base(map_key="k" * 65))
+        MindmapResolveInput(**self._base(map_key="k" * 64))  # boundary ok
+
+    def test_node_id_must_be_uuid(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(**self._base(node_id="not-a-uuid"))
+
+    def test_resolved_by_memory_id_uuid(self) -> None:
+        inp = MindmapResolveInput(
+            **self._base(resolved_by_memory_id=str(uuid4()))  # type: ignore[arg-type]
+        )
+        assert inp.resolved_by_memory_id is not None
+
+
+# --------------------------------------------------------------------------- #
+# MindmapGetInput defaults + cheap-read fields
+# --------------------------------------------------------------------------- #
+
+
+class TestMindmapGetInputDefaults:
+    def test_defaults_are_cheap(self) -> None:
+        inp = MindmapGetInput(map_key="caching-strategy")
+        assert inp.since is None
+        assert inp.include == "open"
+        assert inp.depth == "summary"
+        assert inp.team_id is None
+
+    def test_since_must_be_non_negative(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapGetInput(map_key="k", since=-1)
+        MindmapGetInput(map_key="k", since=0)
+
+    def test_include_options(self) -> None:
+        assert MindmapGetInput(map_key="k", include="open").include == "open"
+        assert MindmapGetInput(map_key="k", include="all").include == "all"
+        with pytest.raises(ValidationError):
+            MindmapGetInput(map_key="k", include="everything")
+
+    def test_depth_options(self) -> None:
+        assert MindmapGetInput(map_key="k", depth="summary").depth == "summary"
+        assert MindmapGetInput(map_key="k", depth="full").depth == "full"
+        with pytest.raises(ValidationError):
+            MindmapGetInput(map_key="k", depth="tiny")
+
+
+# --------------------------------------------------------------------------- #
+# Truncation helper
+# --------------------------------------------------------------------------- #
+
+
+class TestTruncateContent:
+    def test_under_limit_unchanged(self) -> None:
+        content = "x" * (SUMMARY_CONTENT_CHARS - 1)  # 199
+        out, trunc = _truncate_content(content, "summary")
+        assert out == content
+        assert trunc is False
+
+    def test_at_limit_unchanged(self) -> None:
+        content = "x" * SUMMARY_CONTENT_CHARS  # 200
+        out, trunc = _truncate_content(content, "summary")
+        assert out == content
+        assert trunc is False
+
+    def test_over_limit_truncated(self) -> None:
+        content = "x" * (SUMMARY_CONTENT_CHARS + 1)  # 201
+        out, trunc = _truncate_content(content, "summary")
+        assert len(out) == SUMMARY_CONTENT_CHARS + 1  # 200 + ellipsis
+        assert out.endswith("…")
+        assert trunc is True
+
+    def test_full_depth_never_truncates(self) -> None:
+        content = "x" * (SUMMARY_CONTENT_CHARS + 500)
+        out, trunc = _truncate_content(content, "full")
+        assert out == content
+        assert trunc is False
