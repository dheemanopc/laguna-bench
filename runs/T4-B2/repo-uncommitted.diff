+async def _membership(pool: Any, tenant: UUID, node_id: UUID) -> dict[str, Any] | None:
+    async with tenant_tx(pool, tenant) as conn:
+        row = await conn.fetchrow(
+            """
+            SELECT status, resolution_summary, resolved_by_memory_id,
+                   resolved_by_party, resolved_at
+            FROM memory_map_membership
+            WHERE memory_id = $1 AND tenant_id = $2
+            """,
+            node_id,
+            tenant,
+        )
+    return dict(row) if row else None
+
+
+async def _resolve_edges_for(pool: Any, tenant: UUID, node_id: UUID) -> list[str]:
+    """reference_kinds of resolves-under/dropped-under edges INTO node_id.
+
+    The memory_references PK includes reference_kind, so re-settling a branch
+    with a different kind leaves the prior edge row too — the caller sees both.
+    """
+    async with tenant_tx(pool, tenant) as conn:
+        rows = await conn.fetch(
+            """
+            SELECT reference_kind FROM memory_references
+            WHERE target_memory_id = $1
+              AND reference_kind IN ($2, $3)
+            ORDER BY reference_kind
+            """,
+            node_id,
+            _RESOLVES_UNDER,
+            _DROPPED_UNDER,
+        )
+    return [r[0] for r in rows]
+
+
+async def _last_event(pool: Any, tenant: UUID, root_id: UUID) -> dict[str, Any]:
+    async with tenant_tx(pool, tenant) as conn:
+        row = await conn.fetchrow(
+            """
+            SELECT id, event, actor, memory_id, payload
+            FROM memory_map_events
+            WHERE root_memory_id = $1 AND tenant_id = $2
+            ORDER BY id DESC LIMIT 1
+            """,
+            root_id,
+            tenant,
+        )
+    d = dict(row)
+    d["payload"] = service._as_dict(d.get("payload"))
+    return d
+
+
+async def _cursor(pool: Any, tenant: UUID, root_id: UUID) -> int:
+    async with tenant_tx(pool, tenant) as conn:
+        return await service.current_cursor(conn, root_memory_id=root_id, tenant_id=tenant)
+
+
+async def _archive_map(pool: Any, tenant: UUID, root_id: UUID) -> None:
+    async with tenant_tx(pool, tenant) as conn:
+        await conn.execute(
+            "UPDATE memory_maps SET state = 'archived', closed_at = now() "
+            "WHERE root_memory_id = $1 AND tenant_id = $2",
+            root_id,
+            tenant,
+        )
