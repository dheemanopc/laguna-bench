+async def world(pg_pool: Any) -> Any:
+    """A fresh live map with one open position node (owner's turn).
+
+    Yields a dict with: pool, tenant, team, client_id, ctx, map_key, root_id,
+    n1_id, n1_content.
+    """
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    ctx = _ctx(pg_pool, s["tenant"], s["client_id"])
+    opened = await MindmapOpenTool()(
+        ctx, MindmapOpenInput(title="Resolve e2e", root_question="which caching?")
+    )
+    n1 = await MindmapWriteNodeTool()(
+        ctx,
+        MindmapWriteNodeInput(
+            map_key=opened.map_key,
+            content="use Redis for the hot read path",
+            node_role="position",
+            responsible_party="owner",
+        ),
+    )
+    # root's own resolve event is not a "resolve"; the capture event is id 2,
+    # so the cursor sits at 2 before any test action.
+    yield {
+        "pool": pg_pool,
+        "tenant": s["tenant"],
+        "team": s["team"],
+        "client_id": s["client_id"],
+        "ctx": ctx,
+        "map_key": opened.map_key,
+        "root_id": opened.root_memory_id,
+        "n1_id": n1.node_id,
+        "n1_content": n1.node_id and "use Redis for the hot read path" or "",
+    }
+    await _cleanup(pg_pool, s["tenant"], s["team"], s["client_id"])
