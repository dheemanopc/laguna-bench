+            map_key=world["map_key"],
+            node_id=n1,
+            disposition="resolved",
+            resolution_summary="first pass",
+            resolved_by_memory_id=root,
+        ),
+    )
+    second = await MindmapResolveTool()(
+        ctx,
+        MindmapResolveInput(
+            map_key=world["map_key"],
+            node_id=n1,
+            disposition="dropped",
+            resolution_summary="actually no",
+            resolved_by_memory_id=root,
+        ),
+    )
+    assert second.status == "dropped"
+    assert second.cursor > first.cursor  # a new event was appended
+
+    mem = await _membership(pool, tenant, n1)
+    assert mem["status"] == "dropped"
+    assert mem["resolution_summary"] == "actually no"
+    # re-settling with a kind change (resolves-under → dropped-under) writes a
+    # 2nd edge row; both settlement edges now point into n1.
+    assert set(await _resolve_edges_for(pool, tenant, n1)) == {_RESOLVES_UNDER, _DROPPED_UNDER}
+
+    ev = await _last_event(pool, tenant, root)
+    assert ev["payload"]["disposition"] == "dropped"
