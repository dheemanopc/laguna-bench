+    write time, a member of this map). A False result lets the caller treat a
+    membership row that vanished between validation and write as "not a member".
+    """
+    tag = await conn.execute(
+        """
+        UPDATE memory_map_membership
+           SET status = $1,
+               resolution_summary = $2,
+               resolved_by_memory_id = $3,
+               resolved_by_party = $4,
+               resolved_at = CASE WHEN $1 IN ('resolved','dropped') THEN now() ELSE NULL END
+         WHERE memory_id = $5 AND root_memory_id = $6 AND tenant_id = $7
+        """,
+        status,
+        resolution_summary,
+        resolved_by_memory_id,
+        resolved_by_party,
+        memory_id,
+        root_memory_id,
+        tenant_id,
+    )
+    # asyncpg command tag looks like "UPDATE 1"; one matched row == a member.
+    parts = tag.split(" ")
