+async def test_get_summary_at_200_char_boundary(world: Any) -> None:
+    from mem_mcp.mcp.tools.mindmap_get import SUMMARY_CONTENT_CHARS
+
+    ctx, content = world["ctx"], "z" * SUMMARY_CONTENT_CHARS
+    big = await _write_node(ctx, world["map_key"], content)
+
+    got = await MindmapGetTool()(ctx, MindmapGetInput(map_key=world["map_key"]))
+    node = next(n for n in got.nodes if n.memory_id == big.node_id)
+    # exactly at the boundary: kept whole, not truncated (the >limit case is
+    # covered by test_get_summary_truncates_long_content).
+    assert node.truncated is False
+    assert node.content == content
+    assert len(node.content) == SUMMARY_CONTENT_CHARS
