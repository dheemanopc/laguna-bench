+    assert whole.cursor == base_cursor
+    assert {n.memory_id for n in whole.nodes} == {world["root_id"], n1}
+
+    # write a new node → one new event
+    n2 = await _write_node(ctx, map_key, "a fresh position", responsible_party="owner")
+    after = await _cursor(world["pool"], world["tenant"], world["root_id"])
