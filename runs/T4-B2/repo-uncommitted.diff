+    # settled set is empty in the delta window
+    assert delta.resolved == []
+
+    # echoing the new cursor back yields an empty delta
+    idle = await MindmapGetTool()(
+        ctx, MindmapGetInput(map_key=map_key, since=after)
+    )
+    assert idle.cursor == after
+    assert idle.nodes == []
+    assert idle.resolved == []
+    assert idle.edges == []
