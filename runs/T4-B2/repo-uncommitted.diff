--- /dev/null
+++ b/src/mem_mcp/mcp/tools/mindmap_resolve.py
@@ -0,0 +1,277 @@
+"""mindmap_resolve — settle a branch as resolved/dropped.
+
+A branch is a non-root member of a live map. Settling writes the durable
+``status`` column on ``memory_map_membership`` (open | resolved | dropped) so
+that ``mindmap_get`` and ``open_loops`` are driven by stored state, never by
+the unvalidated free-text ``memory_references.reference_kind`` — a bare
+``mindmap_link`` carrying a ``resolves-under`` kind does NOT settle a branch.
+
+When the settling node is itself a map member (``resolved_by_memory_id``), the
+resolve also draws a typed edge (resolves-under / dropped-under) from the
+resolving node onto the settled node — the same edge path as ``mindmap_link``.
+The whole settle + edge + event triple commits in one ``tenant_tx``.
+"""
+
+from __future__ import annotations
+
+from typing import ClassVar, Literal
+from uuid import UUID
+
+from pydantic import BaseModel, ConfigDict, Field
+
+from mem_mcp.db import system_tx, tenant_tx
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tool_descriptions import TOOL_DESCRIPTIONS
+from mem_mcp.mcp.tools._base import BaseTool, ToolContext
+from mem_mcp.mcp.tools._mindmap_common import resolve_team_id
+from mem_mcp.mindmap import (
+    BRANCH_STATUS_DROPPED,
+    REFERENCE_KIND_DROPPED_UNDER,
+    REFERENCE_KIND_RESOLVES_UNDER,
+    service,
