+async def _create_resolver_memory(pool: Any, tenant: UUID, team: UUID) -> UUID:
+    """Create a KB decision memory to use as a resolver."""
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            resolver_id = await conn.fetchval(
+                """
+                INSERT INTO memories (tenant_id, team_id, content, content_hash, embedding, source_kind, type, visibility)
+                VALUES ($1, $2, 'Resolver decision for caching', $3,
+                        array_fill(0::real, ARRAY[1024])::vector, 'api', 'decision', 'team')
+                RETURNING id
+                """,
+                tenant,
+                team,
+                f"hash-{uuid4().hex}",
+            )
+            # asyncpg returns UUID directly, not a string
+            return resolver_id  # type: ignore[no-any-return]
+
