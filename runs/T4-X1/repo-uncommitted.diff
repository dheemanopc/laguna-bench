+"""Unit tests for mindmap_resolve tool — input validation and helper logic.
+
+Tests Pydantic validation of input fields, the truncation helper, and
+ensures proper error handling for edge cases.
+"""
+
+from __future__ import annotations
+
+from uuid import uuid4
+
+import pytest
+from pydantic import ValidationError
+
+from mem_mcp.mcp.tools.mindmap_get import MindmapGetInput, MindmapNode, MindmapResolvedEntry
+from mem_mcp.mcp.tools.mindmap_resolve import (
+    MindmapResolveInput,
+    MindmapResolveOutput,
+)
+
