+class TestMindmapResolveInputValidation:
+    """Tests for MindmapResolveInput Pydantic validation."""
+
+    def test_required_fields(self) -> None:
+        """All required fields must be present."""
+        with pytest.raises(ValidationError):
+            MindmapResolveInput()  # missing all required fields
+
+    def test_map_key_length(self) -> None:
+        """map_key must be 1-64 chars."""
+        # Too short
+        with pytest.raises(ValidationError, match="String should have at least 1 character"):
+            MindmapResolveInput(map_key="", node_id=uuid4(), resolution_summary="test")
+
+        # Too long
+        long_key = "x" * 65
+        with pytest.raises(ValidationError, match="String should have at most 64 characters"):
+            MindmapResolveInput(map_key=long_key, node_id=uuid4(), resolution_summary="test")
+
+        # Valid
+        inp = MindmapResolveInput(map_key="test-key", node_id=uuid4(), resolution_summary="test")
+        assert inp.map_key == "test-key"
+
+    def test_node_id_must_be_uuid(self) -> None:
+        """node_id must be a valid UUID."""
+        input_data = {
+            "map_key": "test",
+            "node_id": "not-a-uuid",
+            "resolution_summary": "test",
+        }
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(**input_data)  # type: ignore[arg-type]
+
+    def test_disposition_must_be_literal(self) -> None:
+        """disposition must be 'resolved' or 'dropped'."""
+        # Invalid disposition
+        with pytest.raises(ValidationError, match="Input should be"):
+            MindmapResolveInput(
+                map_key="test",
+                node_id=uuid4(),
+                resolution_summary="test",
+                disposition="invalid",  # type: ignore[arg-type]
+            )
+
+        # Valid literals
+        inp1 = MindmapResolveInput(
+            map_key="test",
+            node_id=uuid4(),
+            resolution_summary="test",
+            disposition="resolved",
+        )
+        assert inp1.disposition == "resolved"
+
+        inp2 = MindmapResolveInput(
+            map_key="test",
+            node_id=uuid4(),
+            resolution_summary="test",
+            disposition="dropped",
+        )
+        assert inp2.disposition == "dropped"
+
+    def test_disposition_default(self) -> None:
+        """disposition defaults to 'resolved'."""
+        inp = MindmapResolveInput(
+            map_key="test",
+            node_id=uuid4(),
+            resolution_summary="test",
+        )
+        assert inp.disposition == "resolved"
+
+    def test_resolution_summary_length(self) -> None:
+        """resolution_summary must be 1-500 chars."""
+        # Too short (empty)
+        with pytest.raises(ValidationError, match="String should have at least 1 character"):
+            MindmapResolveInput(map_key="test", node_id=uuid4(), resolution_summary="")
+
+        # Too long
+        long_summary = "x" * 501
+        with pytest.raises(ValidationError, match="String should have at most 500 characters"):
+            MindmapResolveInput(map_key="test", node_id=uuid4(), resolution_summary=long_summary)
+
+        # Valid 1 char
+        inp = MindmapResolveInput(map_key="test", node_id=uuid4(), resolution_summary="x")
+        assert inp.resolution_summary == "x"
+
+        # Valid 500 chars
+        inp = MindmapResolveInput(
+            map_key="test",
+            node_id=uuid4(),
+            resolution_summary="x" * 500,
+        )
+        assert len(inp.resolution_summary) == 500
+
+    def test_resolved_by_party_must_be_literal(self) -> None:
+        """resolved_by_party must be 'owner' or 'model'."""
+        # Invalid party
+        with pytest.raises(ValidationError, match="Input should be"):
+            MindmapResolveInput(
+                map_key="test",
+                node_id=uuid4(),
+                resolution_summary="test",
+                resolved_by_party="invalid",  # type: ignore[arg-type]
+            )
+
+        # Valid literals
+        inp1 = MindmapResolveInput(
+            map_key="test",
+            node_id=uuid4(),
+            resolution_summary="test",
+            resolved_by_party="owner",
+        )
+        assert inp1.resolved_by_party == "owner"
+
+        inp2 = MindmapResolveInput(
+            map_key="test",
+            node_id=uuid4(),
+            resolution_summary="test",
+            resolved_by_party="model",
+        )
+        assert inp2.resolved_by_party == "model"
+
+    def test_resolved_by_party_default(self) -> None:
+        """resolved_by_party defaults to 'model'."""
+        inp = MindmapResolveInput(
+            map_key="test",
+            node_id=uuid4(),
+            resolution_summary="test",
+        )
+        assert inp.resolved_by_party == "model"
+
+    def test_resolved_by_memory_id_optional(self) -> None:
+        """resolved_by_memory_id is optional, defaults to None."""
+        inp = MindmapResolveInput(
+            map_key="test",
+            node_id=uuid4(),
+            resolution_summary="test",
+        )
+        assert inp.resolved_by_memory_id is None
+
+        # With explicit value
+        resolver_id = uuid4()
+        inp = MindmapResolveInput(
+            map_key="test",
+            node_id=uuid4(),
+            resolution_summary="test",
+            resolved_by_memory_id=resolver_id,
+        )
+        assert inp.resolved_by_memory_id == resolver_id
+
+    def test_team_id_optional(self) -> None:
+        """team_id is optional, defaults to None."""
+        inp = MindmapResolveInput(
+            map_key="test",
+            node_id=uuid4(),
+            resolution_summary="test",
+        )
+        assert inp.team_id is None
+
+        # With explicit value
+        team_id = uuid4()
+        inp = MindmapResolveInput(
+            map_key="test",
+            node_id=uuid4(),
+            resolution_summary="test",
+            team_id=team_id,
+        )
+        assert inp.team_id == team_id
