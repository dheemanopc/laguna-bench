+async def get_membership(
+    conn: asyncpg.Connection, *, memory_id: UUID, root_memory_id: UUID
+) -> dict[str, Any] | None:
+    """Fetch membership row for a specific memory within a map.
+
+    Returns the membership row with status columns, or None if the memory
+    is not a member of this map (or doesn't exist).
+    """
+    row = await conn.fetchrow(
+        """
+        SELECT mm.memory_id, mm.node_role, mm.added_at, mm.status,
+               mm.resolution_summary, mm.resolved_by_memory_id, mm.resolved_by_party, mm.resolved_at
+        FROM memory_map_membership mm
+        WHERE mm.memory_id = $1 AND mm.root_memory_id = $2
+        """,
+        memory_id,
+        root_memory_id,
+    )
+    return dict(row) if row else None
+
+
+async def settle_branch(
+    conn: asyncpg.Connection,
+    *,
+    memory_id: UUID,
+    root_memory_id: UUID,
+    status: str,
+    resolution_summary: str,
+    resolved_by_memory_id: UUID | None,
+    resolved_by_party: str,
+) -> None:
+    """Settle a branch with the given resolution.
+
+    Sets status, resolution_summary, resolved_by_memory_id, resolved_by_party,
+    and resolved_at (now()). Used by mindmap_resolve to mark a branch as
+    resolved or dropped.
+    """
+    await conn.execute(
+        """
+        UPDATE memory_map_membership
+           SET status = $1,
+               resolution_summary = $2,
+               resolved_by_memory_id = $3,
+               resolved_by_party = $4,
+               resolved_at = now()
+         WHERE memory_id = $5 AND root_memory_id = $6
+        """,
+        status,
+        resolution_summary,
+        resolved_by_memory_id,
+        resolved_by_party,
+        memory_id,
+        root_memory_id,
+    )
+
+
+async def current_cursor(conn: asyncpg.Connection, *, root_memory_id: UUID) -> int:
+    """Return the current event cursor for a map.
+
+    COALESCE(MAX(id), 0) from memory_map_events for the map.
+    """
+    result = await conn.fetchval(
+        """
+        SELECT COALESCE(MAX(id), 0) FROM memory_map_events WHERE root_memory_id = $1
+        """,
+        root_memory_id,
+    )
+    return int(result)
+
+
+async def touched_since(conn: asyncpg.Connection, *, root_memory_id: UUID, since: int) -> set[UUID]:
+    """Return memory IDs touched by this map's events with id > since.
+
+    Includes:
+    - the event's memory_id
+    - any memory UUID the event payload names as `target` (link events)
+    - resolved_by_memory_id from events
+
+    Returns a set of UUIDs (some may not be members; caller should intersect
+    with the member set).
+    """
+    rows = await conn.fetch(
+        """
+        SELECT memory_id as touched_id,
+               payload->>'target' as target_id,
+               payload->>'resolved_by_memory_id' as resolved_by_id
+        FROM memory_map_events
+        WHERE root_memory_id = $1 AND id > $2
+        """,
+        root_memory_id,
+        since,
+    )
+
+    touched: set[UUID] = set()
+    for row in rows:
+        if row["touched_id"] is not None:
+            touched.add(row["touched_id"])
+        if row["target_id"] is not None:
+            try:
+                touched.add(UUID(row["target_id"]))
+            except (ValueError, TypeError):
+                pass
+        if row["resolved_by_id"] is not None:
+            try:
+                touched.add(UUID(row["resolved_by_id"]))
+            except (ValueError, TypeError):
+                pass
+
+    return touched
