+class TestMindmapGetInputValidation:
+    """Tests for MindmapGetInput Pydantic validation (new fields)."""
+
+    def test_since_must_be_non_negative(self) -> None:
+        """since must be >= 0 or None."""
+        with pytest.raises(ValidationError, match="greater than or equal to 0"):
+            MindmapGetInput(map_key="test", since=-1)  # type: ignore[arg-type]
+
+        # Valid: None (default)
+        inp = MindmapGetInput(map_key="test")
+        assert inp.since is None
+
+        # Valid: 0
+        inp = MindmapGetInput(map_key="test", since=0)
+        assert inp.since == 0
+
+        # Valid: positive
+        inp = MindmapGetInput(map_key="test", since=123)
+        assert inp.since == 123
+
+    def test_include_must_be_literal(self) -> None:
+        """include must be 'open' or 'all'."""
+        with pytest.raises(ValidationError, match="Input should be"):
+            MindmapGetInput(map_key="test", include="invalid")  # type: ignore[arg-type]
+
+        inp1 = MindmapGetInput(map_key="test", include="open")
+        assert inp1.include == "open"
+
+        inp2 = MindmapGetInput(map_key="test", include="all")
+        assert inp2.include == "all"
+
+    def test_include_default(self) -> None:
+        """include defaults to 'open'."""
+        inp = MindmapGetInput(map_key="test")
+        assert inp.include == "open"
+
+    def test_depth_must_be_literal(self) -> None:
+        """depth must be 'summary' or 'full'."""
+        with pytest.raises(ValidationError, match="Input should be"):
+            MindmapGetInput(map_key="test", depth="invalid")  # type: ignore[arg-type]
+
+        inp1 = MindmapGetInput(map_key="test", depth="summary")
+        assert inp1.depth == "summary"
+
+        inp2 = MindmapGetInput(map_key="test", depth="full")
+        assert inp2.depth == "full"
+
+    def test_depth_default(self) -> None:
+        """depth defaults to 'summary'."""
+        inp = MindmapGetInput(map_key="test")
+        assert inp.depth == "summary"
