+"""branch status columns — settlement state for open-loop resolution.
+
+Tracks whether a map branch is open (awaiting resolution) or settled
+(resolved/dropped with a resolution_summary). This enables the `mindmap_resolve`
+tool to mark branches as closed and the `mindmap_get` tool to filter/resolve
+settled nodes efficiently.
+
+Existing rows default to status='open' (unsettled), maintaining the
+no-reopen lifecycle rule: only open branches may be modified via write operations.
+
+Revision ID: 0044_mindmap_branch_status
+Revises: 0043_backfill_personal_teams
+Create Date: 2026-10-19
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0044_mindmap_branch_status"
+down_revision = "0043_backfill_personal_teams"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    # Add status column
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership " "ADD COLUMN status TEXT NOT NULL DEFAULT 'open'"
+        )
+    )
+    # Add CHECK constraint for status values
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership "
+            "ADD CONSTRAINT memory_map_membership_status_check "
+            "CHECK (status IN ('open', 'resolved', 'dropped'))"
+        )
+    )
+
+    # Add resolution_summary column (nullable)
+    op.execute(
+        sa.text("ALTER TABLE memory_map_membership " "ADD COLUMN resolution_summary TEXT NULL")
+    )
+    # Add CHECK constraint for resolution_summary length
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership "
+            "ADD CONSTRAINT memory_map_membership_resolution_summary_len_check "
+            "CHECK (resolution_summary IS NULL OR char_length(resolution_summary) BETWEEN 1 AND 500)"
+        )
+    )
+
+    # Add resolved_by_memory_id with FK constraint
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership "
+            "ADD COLUMN resolved_by_memory_id UUID NULL "
+            "REFERENCES memories(id) ON DELETE SET NULL"
+        )
+    )
+
+    # Add resolved_by_party column
+    op.execute(
+        sa.text("ALTER TABLE memory_map_membership " "ADD COLUMN resolved_by_party TEXT NULL")
+    )
+    # Add CHECK constraint for resolved_by_party values
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership "
+            "ADD CONSTRAINT memory_map_membership_resolved_by_party_check "
+            "CHECK (resolved_by_party IN ('owner', 'model'))"
+        )
+    )
+
+    # Add resolved_at timestamp
+    op.execute(
+        sa.text("ALTER TABLE memory_map_membership " "ADD COLUMN resolved_at TIMESTAMPTZ NULL")
+    )
+
+    # Add consistency CHECK: status='open' iff settlement columns are all NULL
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership "
+            "ADD CONSTRAINT memory_map_membership_settlement_consistent_check "
+            "CHECK ("
+            "(status = 'open' AND resolution_summary IS NULL "
+            "  AND resolved_by_party IS NULL AND resolved_at IS NULL AND resolved_by_memory_id IS NULL) "
+            "OR "
+            "(status IN ('resolved', 'dropped') AND resolution_summary IS NOT NULL "
+            "  AND resolved_by_party IS NOT NULL AND resolved_at IS NOT NULL))"
+        )
+    )
+
+
+def downgrade() -> None:
+    # Drop the consistency CHECK constraint first
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership "
+            "DROP CONSTRAINT IF EXISTS memory_map_membership_settlement_consistent_check"
+        )
+    )
+    # Drop columns in reverse order (PostgreSQL allows this without FK issues)
+    op.execute(sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolved_at"))
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership "
+            "DROP CONSTRAINT IF EXISTS memory_map_membership_resolved_by_party_check"
+        )
+    )
+    op.execute(sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolved_by_party"))
+    op.execute(
+        sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolved_by_memory_id")
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership "
+            "DROP CONSTRAINT IF EXISTS memory_map_membership_resolution_summary_len_check"
+        )
+    )
+    op.execute(
+        sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolution_summary")
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership "
+            "DROP CONSTRAINT IF EXISTS memory_map_membership_status_check"
+        )
+    )
+    op.execute(sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS status"))
