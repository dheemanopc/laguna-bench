+class TestRender:
+    def test_render_simple_substitution(self) -> None:
+        """Test simple placeholder substitution."""
+        assert _render("Hello {name}", {"name": "World"}) == "Hello World"
+
+    def test_render_multiple_placeholders(self) -> None:
+        """Test multiple distinct placeholders."""
+        result = _render("{greeting} {name}!", {"greeting": "Hello", "name": "World"})
+        assert result == "Hello World!"
+
+    def test_render_repeated_placeholder(self) -> None:
+        """Test same placeholder used multiple times."""
+        result = _render("{x} and {x} again", {"x": "test"})
+        assert result == "test and test again"
+
+    def test_render_missing_key_empty_string(self, caplog: pytest.LogCaptureFixture) -> None:
+        """Test missing key renders as empty string and logs warning."""
+        with caplog.at_level(logging.WARNING):
+            result = _render("Hi {missing}", {})
+
+        assert result == "Hi "
+        assert any("notice_template_missing_key" in r.message for r in caplog.records)
+
+    def test_render_missing_key_logs_key(self, caplog: pytest.LogCaptureFixture) -> None:
+        """Test missing key warning includes the key in extra."""
+        with caplog.at_level(logging.WARNING):
+            _render("Template: {missing_key}", {})
+
+        record = next(r for r in caplog.records if "notice_template_missing_key" in r.message)
+        assert getattr(record, "key", None) == "missing_key"
+
+    def test_render_missing_key_logs_template_truncated(
+        self, caplog: pytest.LogCaptureFixture
+    ) -> None:
+        """Test missing key warning logs template truncated to 120 chars."""
+        long_template = "x" * 200
+        with caplog.at_level(logging.WARNING):
+            _render(f"{long_template}{{missing}}", {})
+
+        record = next(r for r in caplog.records if "notice_template_missing_key" in r.message)
+        template_attr = getattr(record, "template", None)
+        assert template_attr is not None
+        assert len(template_attr) == 120
+        assert template_attr == long_template[:120]
+
+    def test_render_non_string_value_via_str(self) -> None:
+        """Test non-string payload values converted via str()."""
+        result = _render(
+            "Count: {n}, Active: {b}, Item: {item}", {"n": 42, "b": True, "item": None}
+        )
+        assert result == "Count: 42, Active: True, Item: None"
+
+    def test_render_no_placeholders(self) -> None:
+        """Test template with no placeholders."""
+        result = _render("Just plain text", {})
+        assert result == "Just plain text"
+
+    def test_render_extra_payload_keys_ignored(self) -> None:
+        """Test extra payload keys are ignored."""
+        result = _render("Use {a}", {"a": "1", "b": "2", "c": "3"})
+        assert result == "Use 1"
+
+    def test_render_brace_not_placeholder(self) -> None:
+        """Test non-identifier braces not treated as placeholders."""
+        # {1}, {a-b}, {a.b} are not valid Python identifiers
+        assert _render("{1}", {}) == "{1}"
+        assert _render("{a-b}", {}) == "{a-b}"
+        assert _render("{a.b}", {}) == "{a.b}"
+
+    def test_render_valid_identifier_patterns(self) -> None:
+        """Test various valid identifier patterns in braces."""
+        payload = {
+            "user_id": "123",
+            "item_2": "val",
+            "_private": "secret",
+            "CamelCase": "mixed",
+        }
+        assert _render("{user_id}", payload) == "123"
+        assert _render("{item_2}", payload) == "val"
+        assert _render("{_private}", payload) == "secret"
+        assert _render("{CamelCase}", payload) == "mixed"
