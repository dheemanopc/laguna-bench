+                pg_pool,
+                tenant_id,
+                team_id,
+                content=m3_content,
+                created_at=base + timedelta(minutes=3),
+            )
+            m4_id = await _insert_memory(
+                pg_pool,
+                tenant_id,
+                team_id,
+                content=m4_content,
+                created_at=base + timedelta(minutes=4),
+            )
+
+            tool = MemoryListTool()
+            ctx = _build_ctx(pg_pool, tenant_id, setup["identity_id"], setup["client_id"])
+
+            # keywords="postgres" with desc order → [m4, m1] (created_at desc, not relevance)
+            result = await tool(ctx, MemoryListInput(keywords="postgres", order="desc"))
+            ids = [r.id for r in result.results]
+            assert ids == [m4_id, m1_id]
+            # Check preview contains highlighted keyword (m4: "the postgres planner", m1: "Postgres runs fast")
+            assert "**postgres**" in result.results[0].preview
+            assert "**Postgres**" in result.results[1].preview
+            # Check content is exact
+            assert result.results[0].content == m4_content
+            assert result.results[1].content == m1_content
+
+            # keywords="postgres", order="asc" → [m1, m4]
+            result = await tool(ctx, MemoryListInput(keywords="postgres", order="asc"))
+            ids = [r.id for r in result.results]
+            assert ids == [m1_id, m4_id]
+
+            # keywords="redis postgres" → [m4, m2, m1] (desc order, both keywords)
+            result = await tool(ctx, MemoryListInput(keywords="redis postgres", order="desc"))
+            ids = [r.id for r in result.results]
