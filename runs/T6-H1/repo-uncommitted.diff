+class TestJsonDefault:
+    def test_datetime_to_isoformat(self) -> None:
+        """Test datetime objects converted to isoformat strings."""
+        dt = datetime(2026, 6, 10, 12, 30, 45, tzinfo=UTC)
+        result = _json_default(dt)
+        assert result == "2026-06-10T12:30:45+00:00"
+
+    def test_date_to_isoformat(self) -> None:
+        """Test date objects converted to isoformat strings."""
+        d = date(2026, 6, 10)
+        result = _json_default(d)
+        assert result == "2026-06-10"
+
+    def test_uuid_to_string(self) -> None:
+        """Test UUID objects converted to string."""
+        u = uuid4()
+        result = _json_default(u)
+        assert result == str(u)
+
+    def test_other_types_via_str(self) -> None:
+        """Test other types (Decimal, int, etc.) converted via str()."""
+        from decimal import Decimal
+
+        d = Decimal("3.14")
+        assert _json_default(d) == "3.14"
+        assert _json_default(42) == "42"
+        assert _json_default(None) == "None"
+
+    def test_json_dumps_with_default(self) -> None:
+        """Test json.dumps(..., default=_json_default) works end-to-end."""
+        dt = datetime(2026, 6, 10, 12, 0, 0, tzinfo=UTC)
+        u = uuid4()
+        payload = {
+            "fire_at": dt,
+            "item_id": u,
+            "content": "test",
+        }
+        result = json.dumps(payload, default=_json_default)
+        parsed = json.loads(result)
+        assert parsed["fire_at"] == dt.isoformat()
+        assert parsed["item_id"] == str(u)
+        assert parsed["content"] == "test"
