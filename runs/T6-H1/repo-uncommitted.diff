+    @pytest.mark.asyncio
+    async def test_queue_exact_json_string(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        """Test queue() produces exact JSON string with complex types."""
+        conn = _CaptureConn()
+        _patch_system_tx(monkeypatch, conn)
+
+        tenant_id = uuid4()
+        client = NoticeClientImpl(MagicMock(), tenant_id, "p")
