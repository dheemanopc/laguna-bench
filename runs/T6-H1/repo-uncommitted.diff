+class TestNoticeClientQueue:
+    @pytest.mark.asyncio
+    async def test_queue_exact_params(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        """Test queue() calls execute with exact param order and types."""
+        conn = _CaptureConn()
+        _patch_system_tx(monkeypatch, conn)
+
+        tenant_id = uuid4()
+        client = NoticeClientImpl(MagicMock(), tenant_id, "reminders")
+
+        await client.queue(
+            "reminder_fired", "Reminder: {content}", {"content": "test"}, ttl_seconds=3600
+        )
+
+        assert len(conn.calls) == 1
+        query, args = conn.calls[0]
+
+        # Verify param positions and values
+        assert args[0] == tenant_id  # $1: tenant_id
+        assert args[1] == "reminders"  # $2: plugin_id
+        assert args[2] == "reminder_fired"  # $3: kind
+        assert args[3] == "Reminder: {content}"  # $4: template
+        # $5: payload (exact JSON string)
+        payload_json = args[4]
+        assert payload_json == '{"content": "test"}'  # Exact string
+        assert json.loads(payload_json) == {"content": "test"}
+        assert args[5] == "3600"  # $6: ttl_seconds as string
+
+    @pytest.mark.asyncio
+    async def test_queue_default_ttl(self, monkeypatch: pytest.MonkeyPatch) -> None:
