+        _patch_system_tx(monkeypatch, conn)
+
+        client = NoticeClientImpl(MagicMock(), uuid4(), "p")
+        await client.queue("k", "t", {})
+
+        _, args = conn.calls[0]
+        assert args[5] == "86400"  # Default TTL in seconds
+
