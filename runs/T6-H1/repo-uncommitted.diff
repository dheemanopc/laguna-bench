+    async def test_since_until_boundaries(self, pg_pool: Any) -> None:
+        """Test since/until are inclusive."""
+        setup = await _setup_tenant_and_team(pg_pool)
+        tenant_id = setup["tenant_id"]
+        team_id = setup["team_id"]
+
+        try:
+            base = datetime(2026, 6, 1, tzinfo=UTC)
+            m1 = await _insert_memory(
+                pg_pool, tenant_id, team_id, created_at=base - timedelta(days=1)
+            )
+            m2 = await _insert_memory(pg_pool, tenant_id, team_id, created_at=base)
+            m3 = await _insert_memory(
+                pg_pool, tenant_id, team_id, created_at=base + timedelta(days=1)
+            )
+            m4 = await _insert_memory(
+                pg_pool, tenant_id, team_id, created_at=base + timedelta(days=2)
+            )
+
+            tool = MemoryListTool()
+            ctx = _build_ctx(pg_pool, tenant_id, setup["identity_id"], setup["client_id"])
+
+            # since base to base+1 (inclusive)
+            result = await tool(
+                ctx,
+                MemoryListInput(
+                    since=base,
+                    until=base + timedelta(days=1),
+                ),
+            )
+
+            result_ids = {r.id for r in result.results}
+            assert result_ids == {m2, m3}  # base and base+1 inclusive
+
+        finally:
+            await _cleanup_tenant(pg_pool, tenant_id, team_id, setup["client_id"])
+
