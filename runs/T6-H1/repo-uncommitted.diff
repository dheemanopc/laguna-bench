+    async def test_since_only_until_only(self, pg_pool: Any) -> None:
+        """Test since/until date filtering."""
+        setup = await _setup_tenant_and_team(pg_pool)
+        tenant_id = setup["tenant_id"]
+        team_id = setup["team_id"]
+
+        try:
+            base = datetime(2026, 3, 1, 12, tzinfo=UTC)
+            p_id = await _insert_memory(
+                pg_pool, tenant_id, team_id, content="p", created_at=base - timedelta(seconds=1)
+            )
+            q_id = await _insert_memory(pg_pool, tenant_id, team_id, content="q", created_at=base)
+            r_id = await _insert_memory(
+                pg_pool, tenant_id, team_id, content="r", created_at=base + timedelta(seconds=1)
+            )
+
+            tool = MemoryListTool()
+            ctx = _build_ctx(pg_pool, tenant_id, setup["identity_id"], setup["client_id"])
+
+            # since=base → {q, r}
+            result = await tool(ctx, MemoryListInput(since=base, order="asc"))
+            ids = {r.id for r in result.results}
+            assert ids == {q_id, r_id}
+
+            # until=base → {p, q}
+            result = await tool(ctx, MemoryListInput(until=base, order="asc"))
+            ids = {r.id for r in result.results}
+            assert ids == {p_id, q_id}
+
+            # since=base+1μs → {r}
+            result = await tool(
+                ctx, MemoryListInput(since=base + timedelta(microseconds=1), order="asc")
+            )
+            ids = {r.id for r in result.results}
+            assert ids == {r_id}
+
+            # until=base-1μs → {p}
+            result = await tool(
+                ctx, MemoryListInput(until=base - timedelta(microseconds=1), order="asc")
+            )
+            ids = {r.id for r in result.results}
+            assert ids == {p_id}
+
+            # since=base, until=base → {q}
+            result = await tool(ctx, MemoryListInput(since=base, until=base, order="asc"))
+            ids = {r.id for r in result.results}
+            assert ids == {q_id}
+
+        finally:
+            await _cleanup_tenant(pg_pool, tenant_id, team_id, setup["client_id"])
