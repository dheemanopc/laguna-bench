+    async def test_tags_edge_cases(self, pg_pool: Any) -> None:
+        """Test tags filtering with AND semantics."""
+        setup = await _setup_tenant_and_team(pg_pool)
+        tenant_id = setup["tenant_id"]
+        team_id = setup["team_id"]
+
+        try:
+            # Create three unique tags
+            a = f"t-{uuid4().hex[:8]}"
+            b = f"t-{uuid4().hex[:8]}"
+            c = f"t-{uuid4().hex[:8]}"
+
+            # Insert memories with different tag combinations
+            ab_id = await _insert_memory(pg_pool, tenant_id, team_id, content="ab", tags=[a, b])
+            ma_id = await _insert_memory(pg_pool, tenant_id, team_id, content="ma", tags=[a])
+            mb_id = await _insert_memory(pg_pool, tenant_id, team_id, content="mb", tags=[b])
+            abc_id = await _insert_memory(
+                pg_pool, tenant_id, team_id, content="abc", tags=[a, b, c]
+            )
+            none_id = await _insert_memory(pg_pool, tenant_id, team_id, content="none", tags=[])
+
+            tool = MemoryListTool()
+            ctx = _build_ctx(pg_pool, tenant_id, setup["identity_id"], setup["client_id"])
+
+            # tags=[a,b] AND semantics → {ab, abc}
+            result = await tool(ctx, MemoryListInput(tags=[a, b]))
+            ids = {r.id for r in result.results}
+            assert ids == {ab_id, abc_id}
+
+            # tags=[b,a] (order irrelevant) → {ab, abc}
+            result = await tool(ctx, MemoryListInput(tags=[b, a]))
+            ids = {r.id for r in result.results}
+            assert ids == {ab_id, abc_id}
+
+            # tags=[a] → {ab, ma, abc}
+            result = await tool(ctx, MemoryListInput(tags=[a]))
+            ids = {r.id for r in result.results}
+            assert ids == {ab_id, ma_id, abc_id}
+
+            # tags=[a,b,c] → {abc}
+            result = await tool(ctx, MemoryListInput(tags=[a, b, c]))
+            ids = {r.id for r in result.results}
+            assert ids == {abc_id}
+
+            # tags=[] (no filter) → {ab, ma, mb, abc, none}
+            result = await tool(ctx, MemoryListInput(tags=[]))
+            ids = {r.id for r in result.results}
+            assert ids == {ab_id, ma_id, mb_id, abc_id, none_id}
+
+            # tags=[nonexistent] → set()
+            result = await tool(ctx, MemoryListInput(tags=[f"zzz-{uuid4().hex}"]))
+            ids = {r.id for r in result.results}
+            assert ids == set()
+
+        finally:
+            await _cleanup_tenant(pg_pool, tenant_id, team_id, setup["client_id"])
