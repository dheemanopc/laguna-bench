+    @pytest.mark.asyncio
+    async def test_queue_sql_statement_shape(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        """Test queue() executes INSERT with correct SQL shape."""
+        conn = _CaptureConn()
+        _patch_system_tx(monkeypatch, conn)
+
+        client = NoticeClientImpl(MagicMock(), uuid4(), "p")
+        await client.queue("k", "t", {})
