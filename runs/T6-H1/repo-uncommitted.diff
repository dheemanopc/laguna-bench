+class TestEncodeCursor:
+    def test_encode_cursor_exact_format(self) -> None:
+        """Test _encode_cursor produces exact base64(json([iso, id_str])) output."""
+        dt = datetime(2026, 5, 1, 12, 30, 45, tzinfo=UTC)
+        id_str = str(uuid4())
+        cursor = _encode_cursor(dt, id_str)
+        # Decode and verify structure
+        decoded = json.loads(base64.urlsafe_b64decode(cursor.encode()).decode())
+        assert decoded[0] == dt.isoformat()
+        assert decoded[1] == id_str
+
+    def test_encode_cursor_with_none_raises(self) -> None:
+        """Test _encode_cursor raises ValueError when order_by_value is None."""
+        with pytest.raises(ValueError, match="order_by_value cannot be None"):
+            _encode_cursor(None, uuid4())  # type: ignore[arg-type]
+
+    def test_decode_cursor_round_trip(self) -> None:
+        """Test decode_cursor round-trips with encode_cursor."""
+        dt = datetime(2026, 6, 15, 10, 20, 30, tzinfo=UTC)
+        id_str = str(uuid4())
+        cursor = _encode_cursor(dt, id_str)
+        decoded_iso, decoded_id = _decode_cursor(cursor)
+        assert decoded_iso == dt.isoformat()
+        assert decoded_id == id_str
+
+    def test_decode_cursor_invalid_base64(self) -> None:
+        """Test _decode_cursor with invalid base64."""
+        with pytest.raises(ValueError, match="Invalid cursor format"):
+            _decode_cursor("not-base64!!!")
+
+    def test_decode_cursor_non_json(self) -> None:
+        """Test _decode_cursor with valid base64 but non-JSON content."""
+        invalid = base64.urlsafe_b64encode(b"not json").decode()
+        with pytest.raises(ValueError, match="Invalid cursor format"):
+            _decode_cursor(invalid)
+
+    def test_decode_cursor_json_missing_index(self) -> None:
+        """Test _decode_cursor with JSON array too short."""
+        invalid = base64.urlsafe_b64encode(json.dumps(["only-one"]).encode()).decode()
+        with pytest.raises(ValueError, match="Invalid cursor format"):
+            _decode_cursor(invalid)
+
+    def test_decode_cursor_json_empty_list(self) -> None:
+        """Test _decode_cursor with empty JSON array."""
+        invalid = base64.urlsafe_b64encode(json.dumps([]).encode()).decode()
+        with pytest.raises(ValueError, match="Invalid cursor format"):
+            _decode_cursor(invalid)
+
+    @pytest.mark.xfail(strict=True, reason="BUG: KeyError not caught in _decode_cursor")
+    def test_decode_cursor_json_dict(self) -> None:
+        """Test _decode_cursor with JSON dict (wrong type)."""
+        # Should raise ValueError(-32602), not KeyError
+        invalid = base64.urlsafe_b64encode(json.dumps({}).encode()).decode()
+        with pytest.raises(ValueError, match="Invalid cursor format"):
+            _decode_cursor(invalid)
