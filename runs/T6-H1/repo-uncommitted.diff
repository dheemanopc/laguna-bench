+class RecordingSystemTx:
+    """System tx fake that records pool and conn calls."""
+
+    def __init__(self) -> None:
+        self.recorded_pool: Any = None
+        self.execute_calls: list[tuple[str, list[Any]]] = []
+
+    @asynccontextmanager
+    async def __call__(self, pool: Any) -> AsyncGenerator[Any, None]:
+        self.recorded_pool = pool
+
+        # Create fake conn
+        fake_conn = AsyncMock()
+
+        async def record_execute(query: str, *args: Any) -> None:
+            self.execute_calls.append((query, list(args)))
+
+        fake_conn.execute = record_execute
+        fake_conn.fetch = AsyncMock()
+        yield fake_conn
+
