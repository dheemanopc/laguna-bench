+
+            # keywords="running" (stemming: runs matches) → [m1]
+            result = await tool(ctx, MemoryListInput(keywords="running"))
+            ids = [r.id for r in result.results]
+            assert ids == [m1_id]
+
+            # keywords="the a" (stopwords?) → [] or only exact match
+            result = await tool(ctx, MemoryListInput(keywords="the a"))
+            ids = [r.id for r in result.results]
+            assert ids == []
+
+            # keywords="kubernetes" (not present) → []
+            result = await tool(ctx, MemoryListInput(keywords="kubernetes"))
+            ids = [r.id for r in result.results]
+            assert ids == []
+
+            # No keywords: preview should equal content for all
+            content_map = {
+                m1_id: m1_content,
+                m2_id: m2_content,
+                m3_id: m3_content,
+                m4_id: m4_content,
+            }
+            result = await tool(ctx, MemoryListInput(limit=100))
+            for item in result.results:
+                # When no keywords, preview == content == original
+                assert item.preview == item.content == content_map[item.id]
+
+        finally:
+            await _cleanup_tenant(pg_pool, tenant_id, team_id, setup["client_id"])
