+            m1_content = "Postgres runs fast"
+            m2_content = "we chose redis"
+            m3_content = "nothing relevant here"
+            m4_content = "the postgres planner"
+
+            m1_id = await _insert_memory(
+                pg_pool,
+                tenant_id,
+                team_id,
+                content=m1_content,
