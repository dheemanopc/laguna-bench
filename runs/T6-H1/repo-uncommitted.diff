+class RecordingAudit:
+    """Audit fake that records all calls."""
+
+    def __init__(self) -> None:
+        self.calls: list[tuple[Any, dict[str, Any]]] = []
+
+    async def audit(self, conn: Any, **kw: Any) -> None:
+        self.calls.append((conn, kw))
+
+
+class NoopQuotas:
+    """Quotas fake that does nothing."""
+
+    pass
+
+
+def _build_ctx(db_pool: Any, deps: Any | None = None) -> ToolContext:
+    """Build a ToolContext for testing."""
+    return ToolContext(
+        db_pool=db_pool,
+        tenant_id=TENANT_ID,
+        identity_id=IDENTITY_ID,
+        client_id=CLIENT_ID,
+        request_id=REQUEST_ID,
+        scopes=["memory.read"],
+        deps=deps,
+    )
+
+
+async def run(
+    inp: MemoryListInput, rows: list[dict[str, Any]] | None = None
+) -> tuple[Any, str, list[Any], RecordingAudit]:
+    """Run the tool with mocked DB and return output, query, params, audit."""
+    if rows is None:
+        rows = []
+
+    # Create mock connection
+    mock_conn = AsyncMock()
+    mock_conn.fetch = AsyncMock(return_value=rows)
+
+    # Create audit recorder
+    rec = RecordingAudit()
+
+    # Create tool deps
+    deps = MagicMock()
+    deps.audit = rec
+    deps.quotas = NoopQuotas()
+
+    # Patch tenant_tx to return our mock connection
+    import mem_mcp.mcp.tools.list as list_module
+
+    original_tenant_tx = list_module.tenant_tx
+
+    @asynccontextmanager
+    async def mock_tenant_tx(pool: Any, tenant_id: UUID) -> AsyncGenerator[Any, None]:
+        yield mock_conn
+
+    list_module.tenant_tx = mock_tenant_tx  # type: ignore
+
+    try:
+        tool = MemoryListTool()
+        ctx = _build_ctx(None, deps)
+        output = await tool(ctx, inp)
+
+        # Extract query and params from the mock call
+        query, *params = mock_conn.fetch.call_args.args
+
+        return output, query, params, rec
+    finally:
+        list_module.tenant_tx = original_tenant_tx  # type: ignore
