+"""Integration tests for notice pipeline (queue → deliver) against real Postgres.
+
+Tests queue and deliver_pending with real DB, jsonb codec, TTL calculation,
+and at-most-once delivery semantics.
+"""
+
+from __future__ import annotations
+
+import json
+from datetime import UTC, date, datetime, timedelta
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.db.tenant_tx import system_tx
+from mem_mcp.plugins.clients.notices import NoticeClientImpl
+from mem_mcp.plugins.notice_delivery import deliver_pending
+
+pytestmark = pytest.mark.asyncio
+
+
+async def _setup_tenant(pool: Any) -> UUID:
+    """Create a test tenant."""
+    async with pool.acquire() as conn:
+        tenant_id = await conn.fetchval(
+            "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+            f"notice-test-{uuid4()}@example.test",
+        )
+    return tenant_id
+
+
+async def _cleanup_tenant(pool: Any, tenant_id: UUID) -> None:
+    """Clean up test tenant and plugin_notices."""
+    async with pool.acquire() as conn:
+        await conn.execute("DELETE FROM plugin_notices WHERE tenant_id = $1", tenant_id)
+        await conn.execute("DELETE FROM tenants WHERE id = $1", tenant_id)
+
+
+async def _insert_notice(
+    pool: Any,
+    tenant_id: UUID,
+    *,
+    kind: str,
+    template: str = "t",
+    payload: dict | str = None,
+    created_at: datetime | None = None,
+    expires_at: datetime | None = None,
+    delivered_at: datetime | None = None,
+) -> UUID:
+    """Insert a test notice directly."""
+    if payload is None:
+        payload = {}
+    if isinstance(payload, dict):
+        payload_json = json.dumps(payload)
+    else:
+        payload_json = payload
+
+    async with pool.acquire() as conn:
+        notice_id = await conn.fetchval(
+            """
+            INSERT INTO plugin_notices
+                (tenant_id, plugin_id, kind, template, payload, created_at, expires_at, delivered_at)
+            VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8)
+            RETURNING id
+            """,
+            tenant_id,
+            "test_plugin",
+            kind,
+            template,
+            payload_json,
+            created_at,
+            expires_at,
+            delivered_at,
+        )
+    return notice_id
+
+
+class TestNoticeQueue:
+    async def test_queue_creates_row(self, pg_pool: Any) -> None:
+        """Test NoticeClientImpl.queue creates a row in plugin_notices."""
+        tenant_id = await _setup_tenant(pg_pool)
+
+        try:
+            client = NoticeClientImpl(pg_pool, tenant_id, "test_plugin")
+            await client.queue("test_kind", "test_template", {"key": "value"})
+
+            async with pg_pool.acquire() as conn:
+                row = await conn.fetchrow(
+                    "SELECT * FROM plugin_notices WHERE tenant_id = $1",
+                    tenant_id,
+                )
+
+            assert row is not None
+            assert row["tenant_id"] == tenant_id
+            assert row["plugin_id"] == "test_plugin"
+            assert row["kind"] == "test_kind"
+            assert row["template"] == "test_template"
+            assert row["delivered_at"] is None
+
+        finally:
+            await _cleanup_tenant(pg_pool, tenant_id)
