+async def test_include_flags_are_independent(env: Env) -> None:
+    ok = await add(env)
+    deleted_expired = await add(env, deleted_at=t(1), expires_at=PAST)
+    deleted_hist = await add(env, deleted_at=t(1), is_current=False)
+    expired_hist = await add(env, expires_at=PAST, is_current=False)
+    everything = await add(env, deleted_at=t(1), expires_at=PAST, is_current=False)
+
+    assert ids(await run(env)) == [ok]
+    assert set(ids(await run(env, include_deleted=True))) == {ok}
+    assert set(ids(await run(env, include_expired=True))) == {ok}
+    assert set(ids(await run(env, include_history=True))) == {ok}
+    assert set(ids(await run(env, include_deleted=True, include_expired=True))) == {
+        ok,
+        deleted_expired,
+    }
+    assert set(ids(await run(env, include_deleted=True, include_history=True))) == {
+        ok,
+        deleted_hist,
+    }
+    assert set(ids(await run(env, include_expired=True, include_history=True))) == {
+        ok,
+        expired_hist,
+    }
+    assert set(
+        ids(await run(env, include_deleted=True, include_expired=True, include_history=True))
+    ) == {ok, deleted_expired, deleted_hist, expired_hist, everything}
