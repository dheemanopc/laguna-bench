+# --------------------------------------------------------------------------- queue shaping
+
+
+class _CaptureConn:
+    def __init__(self) -> None:
+        self.calls: list[tuple[str, tuple[Any, ...]]] = []
+
+    async def execute(self, query: str, *args: Any) -> str:
+        self.calls.append((query, args))
+        return "INSERT 0 1"
+
+
+def _patch(monkeypatch: pytest.MonkeyPatch, conn: _CaptureConn) -> list[Any]:
+    pools: list[Any] = []
+
+    @asynccontextmanager
+    async def fake_tx(pool: Any) -> Any:
+        pools.append(pool)
+        yield conn
+
+    monkeypatch.setattr("mem_mcp.plugins.clients.notices.system_tx", fake_tx)
+    return pools
+
+
+class TestQueueArguments:
+    async def test_exact_positional_args_and_default_ttl(
+        self, monkeypatch: pytest.MonkeyPatch
+    ) -> None:
+        conn = _CaptureConn()
+        pool = MagicMock()
+        pools = _patch(monkeypatch, conn)
+        tenant = uuid4()
+        await NoticeClientImpl(pool, tenant, "reminders").queue(
+            "due", "Hello {name}", {"name": "Ada", "n": 1}
+        )
+        assert pools == [pool]
+        assert len(conn.calls) == 1
+        sql, args = conn.calls[0]
+        assert args == (tenant, "reminders", "due", "Hello {name}", '{"name": "Ada", "n": 1}', "86400")
+        assert "INSERT INTO plugin_notices" in sql
+        assert "$5::jsonb" in sql
+        assert "now() + ($6 || ' seconds')::interval" in sql
+
+    async def test_ttl_is_passed_as_string(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        conn = _CaptureConn()
+        _patch(monkeypatch, conn)
+        await NoticeClientImpl(MagicMock(), uuid4(), "p").queue("k", "t", {}, ttl_seconds=3600)
+        assert conn.calls[0][1][5] == "3600"
+        assert conn.calls[0][1][4] == "{}"
+
+    async def test_ttl_is_keyword_only(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        conn = _CaptureConn()
+        _patch(monkeypatch, conn)
+        with pytest.raises(TypeError):
+            await NoticeClientImpl(MagicMock(), uuid4(), "p").queue("k", "t", {}, 60)  # type: ignore[misc]
+
+    async def test_payload_json_uses_default_serializer(
+        self, monkeypatch: pytest.MonkeyPatch
+    ) -> None:
+        conn = _CaptureConn()
+        _patch(monkeypatch, conn)
+        u = uuid4()
+        await NoticeClientImpl(MagicMock(), uuid4(), "p").queue(
+            "k",
+            "t",
+            {"d": date(2024, 2, 29), "u": u, "x": Decimal("2.5"), "n": {"when": datetime(2024, 1, 1, tzinfo=UTC)}},
+        )
+        assert json.loads(conn.calls[0][1][4]) == {
+            "d": "2024-02-29",
+            "u": str(u),
+            "x": "2.5",
+            "n": {"when": "2024-01-01T00:00:00+00:00"},
+        }
+
+    async def test_logs_info_with_extras(
+        self, monkeypatch: pytest.MonkeyPatch, caplog: pytest.LogCaptureFixture
+    ) -> None:
+        conn = _CaptureConn()
+        _patch(monkeypatch, conn)
+        with caplog.at_level(logging.INFO, logger="mem_mcp.plugins.clients.notices"):
+            await NoticeClientImpl(MagicMock(), uuid4(), "plug").queue("kind-x", "t", {})
+        recs = [r for r in caplog.records if r.name == "mem_mcp.plugins.clients.notices"]
+        assert len(recs) == 1
+        rec = recs[0]
+        assert rec.levelno == logging.INFO
+        assert rec.getMessage() == "plugin_notice_queued"
+        assert rec.plugin_id == "plug"  # type: ignore[attr-defined]
+        assert rec.kind == "kind-x"  # type: ignore[attr-defined]
+
+    async def test_returns_none(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        conn = _CaptureConn()
+        _patch(monkeypatch, conn)
+        result = await NoticeClientImpl(MagicMock(), uuid4(), "p").queue("k", "t", {})  # type: ignore[func-returns-value]
+        assert result is None
+
+    async def test_log_only_after_insert(
+        self, monkeypatch: pytest.MonkeyPatch, caplog: pytest.LogCaptureFixture
+    ) -> None:
+        class _Boom(_CaptureConn):
+            async def execute(self, query: str, *args: Any) -> str:
+                raise RuntimeError("db down")
+
+        _patch(monkeypatch, _Boom())
+        with caplog.at_level(logging.INFO, logger="mem_mcp.plugins.clients.notices"):
+            with pytest.raises(RuntimeError, match="db down"):
+                await NoticeClientImpl(MagicMock(), uuid4(), "p").queue("k", "t", {})
+        assert not [r for r in caplog.records if r.getMessage() == "plugin_notice_queued"]
+
