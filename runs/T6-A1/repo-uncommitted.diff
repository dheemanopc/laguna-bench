+async def test_since_until_inclusive(env: Env) -> None:
+    rows = [await add(env, created=t(i)) for i in range(5)]
+    assert set(ids(await run(env, since=t(2)))) == set(rows[2:])
+    assert set(ids(await run(env, until=t(2)))) == set(rows[:3])
+    assert set(ids(await run(env, since=t(1), until=t(3)))) == set(rows[1:4])
+    assert ids(await run(env, since=t(2), until=t(2))) == [rows[2]]
+    assert ids(await run(env, since=t(5))) == []
+    assert ids(await run(env, until=t(-1))) == []
+
