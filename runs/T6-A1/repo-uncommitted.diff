+async def env(pg_pool: Any) -> Any:
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            tenant = await conn.fetchval(
+                "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                f"mlist-{uuid4()}@example.test",
+            )
+            other = await conn.fetchval(
+                "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                f"mlist-other-{uuid4()}@example.test",
+            )
+            team = await conn.fetchval(
+                "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+                f"mlist-team-{uuid4().hex[:8]}",
+                tenant,
+            )
+            await assign_role(
+                conn,
+                parent_team_id=team,
+                member_kind="user",
+                member_id=tenant,
+                role_key="member",
+                assigned_by_user_id=tenant,
+            )
+            await conn.execute(
+                """
+                INSERT INTO tenant_identities
+                    (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+                VALUES ($1, $2, 'cognito', $3, true, $4)
+                """,
+                tenant,
+                f"sub-{tenant}",
+                f"mlist-{tenant}@example.test",
+                team,
+            )
+            client_id = f"client:mlist-{uuid4().hex[:8]}"
+            await conn.execute(
+                """
+                INSERT INTO oauth_clients
+                    (id, redirect_uris, scope, registration_payload, review_status)
+                VALUES ($1, ARRAY[]::text[], 'memory.read', '{}'::jsonb, 'auto_allowed')
+                """,
+                client_id,
+            )
+    e = Env(pool=pg_pool, tenant=tenant, team=team, client_id=client_id, other_tenant=other)
+    try:
+        yield e
+    finally:
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                await conn.execute(
+                    "DELETE FROM memories WHERE tenant_id = ANY($1::uuid[])",
+                    [tenant, other],
+                )
+                await conn.execute(
+                    "DELETE FROM team_role_assignments WHERE member_id = $1 "
+                    "OR parent_team_id IN (SELECT id FROM teams WHERE created_by_tenant_id = $1)",
+                    tenant,
+                )
+                await conn.execute("DELETE FROM tenant_identities WHERE tenant_id = $1", tenant)
+                await conn.execute("DELETE FROM teams WHERE created_by_tenant_id = $1", tenant)
+                await conn.execute(
+                    "DELETE FROM tenants WHERE id = ANY($1::uuid[])", [tenant, other]
+                )
+                await conn.execute("DELETE FROM oauth_clients WHERE id = $1", client_id)
+
+
+async def add(
+    env: Env,
+    content: str = "plain content",
+    *,
+    tenant: UUID | None = None,
+    created: datetime = T0,
+    updated: datetime | None = None,
+    **cols: Any,
+) -> UUID:
+    """Insert one memory row with fully explicit, deterministic column values."""
+    row: dict[str, Any] = {
+        "id": uuid4(),
+        "tenant_id": tenant or env.tenant,
+        "content": content,
+        "content_hash": uuid4().hex,
+        "source_kind": "api",
+        "embedding_status": "ok",
+        "created_at": created,
+        "updated_at": updated if updated is not None else created,
+    }
+    row.update(cols)
+    names = ", ".join(row)
+    holders = ", ".join(f"${i + 1}" for i in range(len(row)))
+    async with env.pool.acquire() as conn:
+        await conn.execute(f"INSERT INTO memories ({names}) VALUES ({holders})", *row.values())
+    return row["id"]  # type: ignore[no-any-return]
+
+
+async def new_team(env: Env) -> UUID:
+    async with env.pool.acquire() as conn:
+        team = await conn.fetchval(
+            "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+            f"mlist-extra-{uuid4().hex[:8]}",
+            env.tenant,
+        )
+    env.extra_teams.append(team)
+    return team  # type: ignore[no-any-return]
+
+
+async def run(env: Env, **kw: Any) -> Any:
+    return await MemoryListTool()(env.ctx(), MemoryListInput(**kw))
+
+
+def ids(out: Any) -> list[UUID]:
+    return [r.id for r in out.results]
+
+
+def b64(raw: str) -> str:
+    return base64.urlsafe_b64encode(raw.encode()).decode()
+
