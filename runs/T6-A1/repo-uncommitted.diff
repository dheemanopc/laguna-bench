+def datetime_cursor(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Emulate a fix for the str-timestamp cursor bug so that the *remaining*
+    pagination defects (boundary row skipped, tie-break direction) can be
+    exercised independently of it."""
+    real = list_mod._decode_cursor
+
+    def fake(cursor: str) -> Any:
+        ts, id_ = real(cursor)
+        return datetime.fromisoformat(ts), id_
+
+    monkeypatch.setattr(list_mod, "_decode_cursor", fake)
+
