+async def test_tenant_scoping(env: Env) -> None:
+    a = await add(env, created=t(1))
+    b = await add(env, created=t(2))
+    await add(env, tenant=env.other_tenant, created=t(3))
+    await add(env, tenant=env.other_tenant, created=t(4), tags=["a"])
+    out = await run(env)
+    assert set(ids(out)) == {a, b}
+    assert len(out.results) == 2
+
