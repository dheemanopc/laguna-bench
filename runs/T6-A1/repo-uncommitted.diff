+async def test_tags_and_semantics(env: Env) -> None:
+    ab = await add(env, tags=["a", "b"])
+    ba = await add(env, tags=["b", "a"])
+    only_a = await add(env, tags=["a"])
+    only_b = await add(env, tags=["b"])
+    ac = await add(env, tags=["a", "c"])
+    abc = await add(env, tags=["a", "b", "c"])
+    none = await add(env, tags=[])
+    other = await add(env, tenant=env.other_tenant, tags=["a", "b"])
+
+    assert set(ids(await run(env, tags=["a", "b"]))) == {ab, ba, abc}
+    assert set(ids(await run(env, tags=["a"]))) == {ab, ba, only_a, ac, abc}
+    assert set(ids(await run(env, tags=["b"]))) == {ab, ba, only_b, abc}
+    assert set(ids(await run(env, tags=["a", "c"]))) == {ac, abc}
+    assert ids(await run(env, tags=["nobody-has-this"])) == []
+    assert set(ids(await run(env, tags=[]))) == {ab, ba, only_a, only_b, ac, abc, none}
+    assert other not in ids(await run(env, tags=["a", "b"]))
