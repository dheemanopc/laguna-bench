+# ruff: noqa: N802  (test_BUG_* names are intentionally greppable)
+"""Behavioural tests for the plugin-notice pipeline against a live DB.
+
+Covers ``NoticeClientImpl.queue`` (insert, TTL, JSON serialisation, logging) and
+``deliver_pending`` (ordering, limit, at-most-once, expiry, tenant isolation,
+template rendering, payload decoding). Each test owns a throw-away tenant so the
+file is safe under parallel workers sharing one database.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+from datetime import UTC, date, datetime, timedelta
+from decimal import Decimal
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.plugins.clients.notices import NoticeClientImpl
+from mem_mcp.plugins.notice_delivery import RenderedNotice, deliver_pending
+
+T0 = datetime(2024, 1, 1, tzinfo=UTC)
+PAST = datetime(2020, 1, 1, tzinfo=UTC)
+FUTURE = datetime(2099, 1, 1, tzinfo=UTC)
+
+NOTICES_LOGGER = "mem_mcp.plugins.clients.notices"
+DELIVERY_LOGGER = "mem_mcp.plugins.notice_delivery"
+
+
+def t(n: int) -> datetime:
+    return T0 + timedelta(minutes=n)
+
+
<email>
+async def tenant(pg_pool: Any) -> Any:
+    async with pg_pool.acquire() as conn:
+        tid = await conn.fetchval(
+            "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+            f"notices-{uuid4()}@example.test",
+        )
+        other = await conn.fetchval(
+            "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+            f"notices-other-{uuid4()}@example.test",
+        )
+    ns = _Tenants(tid, other)
+    try:
+        yield ns
+    finally:
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                await conn.execute(
+                    "DELETE FROM plugin_notices WHERE tenant_id = ANY($1::uuid[])", [tid, other]
+                )
+                await conn.execute("DELETE FROM tenants WHERE id = ANY($1::uuid[])", [tid, other])
+
+
+class _Tenants:
+    def __init__(self, main: UUID, other: UUID) -> None:
+        self.main = main
+        self.other = other
+
