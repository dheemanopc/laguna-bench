+
+
+class TestRenderEdges:
+    def test_repeated_placeholder(self) -> None:
+        assert _render("{a}-{a}-{a}", {"a": "x"}) == "x-x-x"
+
+    def test_adjacent_placeholders(self) -> None:
+        assert _render("{a}{b}{c}", {"a": "1", "b": "2", "c": "3"}) == "123"
+
+    def test_none_value_renders_none(self) -> None:
+        assert _render("v={a}", {"a": None}) == "v=None"
+
+    def test_underscore_prefixed_key(self) -> None:
+        assert _render("{_private}", {"_private": "s"}) == "s"
+        assert _render("{__x1}", {"__x1": "y"}) == "y"
+
+    def test_uppercase_and_mixed_case_keys(self) -> None:
+        assert _render("{ABC} {Abc}", {"ABC": "up", "Abc": "mixed"}) == "up mixed"
+
+    def test_keys_are_case_sensitive(self, caplog: pytest.LogCaptureFixture) -> None:
+        with caplog.at_level(logging.WARNING):
+            assert _render("{ABC}", {"abc": "x"}) == ""
+        assert [r.key for r in caplog.records if r.getMessage() == "notice_template_missing_key"] == [  # type: ignore[attr-defined]
+            "ABC"
+        ]
+
+    def test_spaces_inside_braces_not_a_placeholder(self) -> None:
+        assert _render("{ a }", {"a": "x"}) == "{ a }"
+        assert _render("{a }", {"a": "x"}) == "{a }"
+        assert _render("{ a}", {"a": "x"}) == "{ a}"
+
+    def test_double_braces_inner_is_substituted(self) -> None:
+        # The regex has no escape handling: the inner {a} matches, outer braces stay.
+        assert _render("{{a}}", {"a": "X"}) == "{X}"
+        assert _PLACEHOLDER_RE.findall("{{a}}") == ["a"]
+
+    def test_double_braces_missing_key(self, caplog: pytest.LogCaptureFixture) -> None:
+        with caplog.at_level(logging.WARNING):
+            assert _render("{{a}}", {}) == "{}"
+
+    def test_value_is_not_re_expanded(self) -> None:
+        assert _render("{a}", {"a": "{b}", "b": "Z"}) == "{b}"
+
+    def test_empty_template(self) -> None:
+        assert _render("", {"a": "x"}) == ""
+
+    def test_unmatched_braces_untouched(self) -> None:
+        assert _render("{a", {"a": "x"}) == "{a"
+        assert _render("a}", {"a": "x"}) == "a}"
+        assert _render("{}", {"a": "x"}) == "{}"
+
+    def test_dotted_and_dashed_keys_not_placeholders(self) -> None:
+        assert _render("{a.b} {a-b} {a b}", {"a": "x", "a.b": "y"}) == "{a.b} {a-b} {a b}"
+
+    def test_leading_digit_not_placeholder(self) -> None:
+        assert _render("{1a}", {"1a": "x"}) == "{1a}"
+
+    def test_multiline_template(self) -> None:
+        assert _render("line1 {a}\nline2 {b}", {"a": "1", "b": "2"}) == "line1 1\nline2 2"
+
+    def test_non_ascii_text_preserved(self) -> None:
+        assert _render("héllo {a} ✓", {"a": "wörld"}) == "héllo wörld ✓"
+
+    def test_key_with_empty_string_value_does_not_warn(
+        self, caplog: pytest.LogCaptureFixture
+    ) -> None:
+        with caplog.at_level(logging.WARNING):
+            assert _render("[{a}]", {"a": ""}) == "[]"
+        assert not [r for r in caplog.records if r.getMessage() == "notice_template_missing_key"]
+
+    def test_false_and_zero_values_are_rendered(self) -> None:
+        assert _render("{a}/{b}", {"a": False, "b": 0}) == "False/0"
+
+    def test_datetime_value_uses_str(self) -> None:
+        dt = datetime(2024, 1, 2, 3, 4, 5, tzinfo=UTC)
+        assert _render("{a}", {"a": dt}) == "2024-01-02 03:04:05+00:00"
+
+    def test_missing_key_warns_once_per_occurrence(self, caplog: pytest.LogCaptureFixture) -> None:
+        with caplog.at_level(logging.WARNING):
+            assert _render("{m}{m}", {}) == ""
+        recs = [r for r in caplog.records if r.getMessage() == "notice_template_missing_key"]
+        assert len(recs) == 2
+        assert all(r.levelno == logging.WARNING for r in recs)
+
+    def test_warning_extras_and_template_truncation(self, caplog: pytest.LogCaptureFixture) -> None:
+        template = "a" * 119 + "b" + "c" * 30 + "{gone}"
