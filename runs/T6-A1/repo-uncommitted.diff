+# mypy: disable-error-code="attr-defined"
+# ruff: noqa: N802  (test_BUG_* names are intentionally greppable)
+"""Behavioural (mutation-oriented) tests for the ``memory_list`` tool.
+
+Every test builds its own tenant/team/identity/oauth client with UUID-suffixed
+names and inserts memories with plain SQL at fixed, distinct timestamps so that
+ordering is fully deterministic and safe under parallel workers sharing one DB.
+
+Tests marked ``xfail(strict=True)`` assert the *correct* contract and document a
+real defect in ``list.py`` that was verified against the live DB.
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+from dataclasses import dataclass, field
+from datetime import UTC, datetime, timedelta
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+from pydantic import ValidationError
+
+import mem_mcp.mcp.tools.list as list_mod
+from mem_mcp.audit.logger import NoopAuditLogger
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.list import (
+    MemoryListInput,
+    MemoryListTool,
+    _decode_cursor,
+    _encode_cursor,
+)
+from mem_mcp.memory.hybrid_query import PREVIEW_FALLBACK_CHARS, PREVIEW_MAX_CHARS
+from mem_mcp.teams.assignments import assign_role
+
+T0 = datetime(2024, 1, 1, tzinfo=UTC)
+PAST = datetime(2020, 1, 1, tzinfo=UTC)
+FUTURE = datetime(2099, 1, 1, tzinfo=UTC)
+
+
+def t(n: int) -> datetime:
+    """Fixed, distinct timestamp: 2024-01-01 + n minutes."""
+    return T0 + timedelta(minutes=n)
+
+
+class _StubEmbed:
+    async def embed(self, content: str) -> Any:  # pragma: no cover - never called
+        raise AssertionError("embedder must not be used by memory_list")
+
+
+class RecordingAudit(NoopAuditLogger):
+    def __init__(self) -> None:
+        self.calls: list[dict[str, Any]] = []
+
+    async def audit(self, conn: Any, **kwargs: Any) -> None:
+        self.calls.append(kwargs)
+
+
+@dataclass
+class Env:
+    pool: Any
+    tenant: UUID
+    team: UUID
+    client_id: str
+    other_tenant: UUID
+    audit: RecordingAudit = field(default_factory=RecordingAudit)
+    extra_teams: list[UUID] = field(default_factory=list)
+
+    def ctx(self, *, deps: bool = True) -> ToolContext:
+        return ToolContext(
+            request_id=f"req-{uuid4().hex[:8]}",
+            tenant_id=self.tenant,
+            identity_id=self.tenant,
+            client_id=self.client_id,
+            scopes=frozenset({"memory.read"}),
+            db_pool=self.pool,
+            deps=(
+                ToolDeps(embeddings=_StubEmbed(), audit=self.audit, quotas=NoopQuotas())
+                if deps
+                else None
+            ),
+        )
+
