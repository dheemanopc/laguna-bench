+async def add_notice(
+    pool: Any,
+    tenant_id: UUID,
+    *,
+    template: str = "t",
+    payload: Any = None,
+    created_at: datetime = T0,
+    expires_at: datetime = FUTURE,
+    kind: str = "k",
+    plugin_id: str = "p",
+    delivered_at: datetime | None = None,
+) -> UUID:
+    nid = uuid4()
+    async with pool.acquire() as conn:
+        await conn.execute(
+            """
+            INSERT INTO plugin_notices
+                (id, tenant_id, plugin_id, kind, template, payload,
+                 created_at, expires_at, delivered_at)
+            VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
+            """,
+            nid,
+            tenant_id,
+            plugin_id,
+            kind,
+            template,
+            {} if payload is None else payload,
+            created_at,
+            expires_at,
+            delivered_at,
+        )
+    return nid
+
+
+async def deliver(pool: Any, tenant_id: UUID, **kw: Any) -> list[RenderedNotice]:
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            return await deliver_pending(conn, tenant_id, **kw)
+
+
+async def rows_for(pool: Any, tenant_id: UUID) -> list[Any]:
+    async with pool.acquire() as conn:
+        return list(
+            await conn.fetch(
+                "SELECT * FROM plugin_notices WHERE tenant_id = $1 ORDER BY created_at, id",
+                tenant_id,
+            )
+        )
+
+
+def as_dict(value: Any) -> Any:
+    """Decode a jsonb value that the pool codec may hand back as str."""
+    return json.loads(value) if isinstance(value, str) else value
+
