+    async def test_newest_first(self, pg_pool: Any) -> None:
+        token = uuid4().hex[:12]
+        base = datetime.now(UTC) - timedelta(days=1)
+        ids = []
+        async with pg_pool.acquire() as conn:
+            for i in range(3):
+                tid, _, _ = await make_tenant(
+                    conn,
