index 0000000..8e70b5d
--- /dev/null
+++ b/src/mem_mcp/admin/service.py
@@ -0,0 +1,166 @@
+"""Admin user lookup service — read-only, cross-tenant by design.
+
+Operators with the ``system_admin`` role need to answer "who is X and which
+teams are they in?" across every tenant. That is inherently cross-tenant, so
+these functions:
+
+* do NOT filter by the caller's tenant and never read ``app.current_tenant_id``
+  (after a rolled-back ``tenant_tx`` the GUC reads back ``''``, so reading it
+  would be both meaningless and fragile);
+* MUST be called on a ``system_tx`` connection (BYPASSRLS role in prod);
+* assume the **caller has already authorized** the operator
+  (``system.manage_tenants``). The MCP layer does this via ``AdminTool``;
+  authorization is deliberately not repeated here so the service stays
+  transport-agnostic.
+
+Team membership comes from ``team_role_assignments`` + ``roles_catalog`` (the
+RBAC source of truth), never the legacy ``team_members`` table.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime
+from typing import TYPE_CHECKING, Any
+from uuid import UUID
+
+from pydantic import BaseModel
+
+from mem_mcp.admin.errors import NotFoundError
+
+if TYPE_CHECKING:
+    import asyncpg  # type: ignore[import-untyped]
+
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+MIN_QUERY_LEN = 2
+
+
+class AdminUserSummary(BaseModel):
+    """One tenant plus its primary identity (identity fields null if none)."""
+
+    tenant_id: str
+    email: str
+    display_name: str | None
+    status: str
+    created_at: datetime
+    provider: str | None
+    workspace_domain: str | None
+    default_team_id: str | None
+
+
+class AdminUserTeam(BaseModel):
+    """A team the user actively belongs to, with their role in it."""
+
+    team_id: str
+    team_name: str
+    role_key: str
+
+
+class AdminUserDetail(AdminUserSummary):
+    """Summary plus system roles and team memberships."""
+
+    system_roles: list[str]
+    teams: list[AdminUserTeam]
+
+
+def _escape_like(raw: str) -> str:
+    """Escape LIKE metacharacters. Backslash first so we don't double-escape."""
+    return raw.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+
+
+def _clamp_limit(limit: int | None) -> int:
+    """Default None to DEFAULT_LIMIT and clamp into 1..MAX_LIMIT; never raises."""
+    if limit is None:
+        return DEFAULT_LIMIT
+    return max(1, min(MAX_LIMIT, limit))
+
+
+def _summary_fields(r: Any) -> dict[str, Any]:
+    return {
+        "tenant_id": str(r["id"]),
+        "email": r["email"],
+        "display_name": r["display_name"],
+        "status": r["status"],
+        "created_at": r["created_at"],
+        "provider": r["provider"],
+        "workspace_domain": r["workspace_domain"],
+        "default_team_id": str(r["default_team_id"]) if r["default_team_id"] else None,
+    }
+
+
+async def find_users(
+    conn: asyncpg.Connection,
+    *,
+    query: str,
+    limit: int | None = None,
+) -> list[AdminUserSummary]:
+    """Case-insensitive substring search over tenant email / display name.
+
+    Raises ``ValueError`` if the stripped query is shorter than 2 characters
+    (a 1-char substring would dump most of the table).
+    """
+    q = query.strip()
+    if len(q) < MIN_QUERY_LEN:
+        raise ValueError(f"query must be at least {MIN_QUERY_LEN} characters")
+
+    # ESCAPE '\' + _escape_like make the user's text a literal substring.
+    rows = await conn.fetch(
+        """
+        SELECT t.id, t.email, t.display_name, t.status, t.created_at,
+               ti.provider, ti.workspace_domain, ti.default_team_id
+        FROM tenants t
+        LEFT JOIN tenant_identities ti ON ti.tenant_id = t.id AND ti.is_primary
+        WHERE t.email ILIKE '%' || $1 || '%' ESCAPE '\\'
+           OR t.display_name ILIKE '%' || $1 || '%' ESCAPE '\\'
+        ORDER BY t.created_at DESC, t.id
+        LIMIT $2
+        """,
+        _escape_like(q),
+        _clamp_limit(limit),
+    )
+    return [AdminUserSummary(**_summary_fields(r)) for r in rows]
+
+
+async def get_user(conn: asyncpg.Connection, *, tenant_id: UUID) -> AdminUserDetail:
+    """Full admin view of one tenant. Raises ``NotFoundError`` if unknown."""
+    row = await conn.fetchrow(
+        """
+        SELECT t.id, t.email, t.display_name, t.status, t.created_at,
+               ti.provider, ti.workspace_domain, ti.default_team_id
+        FROM tenants t
+        LEFT JOIN tenant_identities ti ON ti.tenant_id = t.id AND ti.is_primary
+        WHERE t.id = $1
+        """,
+        tenant_id,
+    )
+    if row is None:
+        raise NotFoundError(f"user {tenant_id} not found")
+
+    role_rows = await conn.fetch(
+        "SELECT role FROM tenant_system_roles WHERE tenant_id = $1 ORDER BY role",
+        tenant_id,
+    )
+    team_rows = await conn.fetch(
+        """
+        SELECT tm.id AS team_id, tm.name AS team_name, rc.role_key
+        FROM team_role_assignments tra
+        JOIN roles_catalog rc ON rc.id = tra.role_id
+        JOIN teams tm ON tm.id = tra.parent_team_id
+        WHERE tra.member_kind = 'user'
+          AND tra.member_id = $1
+          AND tra.status = 'active'
+          AND tm.deleted_at IS NULL
+        ORDER BY tm.name, tm.id
+        """,
+        tenant_id,
+    )
+    return AdminUserDetail(
+        **_summary_fields(row),
+        system_roles=sorted(r["role"] for r in role_rows),
+        teams=[
+            AdminUserTeam(
+                team_id=str(r["team_id"]), team_name=r["team_name"], role_key=r["role_key"]
+            )
+            for r in team_rows
+        ],
+    )
