+class TestFindUsers:
+    async def test_case_insensitive_email_and_display_name(self, pg_pool: Any) -> None:
+        token = uuid4().hex[:12]
+        async with pg_pool.acquire() as conn:
+            by_email, _, _ = await make_tenant(conn, email=f"Manasi-{token}@Example.Test")
+            by_name, _, _ = await make_tenant(conn, display_name=f"Dr ZELDA {token}")
+        async with system_tx(pg_pool) as conn:
+            hits = await find_users(conn, query=f"MANASI-{token}")
+            assert [u.tenant_id for u in hits] == [str(by_email)]
+            hits = await find_users(conn, query=f"zelda {token}")
+            assert [u.tenant_id for u in hits] == [str(by_name)]
+            assert hits[0].display_name == f"Dr ZELDA {token}"
