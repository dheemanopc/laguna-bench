+"""AuthZ + audit tests for the admin MCP tools (memsys_admin_find_user / get_user)."""
+
+from __future__ import annotations
+
+from typing import Any, ClassVar
+from uuid import uuid4
+
+import pytest
+from pydantic import BaseModel
+
