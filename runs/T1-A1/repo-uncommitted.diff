+def test_team_roles_never_confer_system_permissions() -> None:
+    """Only system roles may hold system.*; team roles must never (privilege escalation)."""
+    system_roles = {"system_admin", "system_support"}
+    non_system = {k: v for k, v in ROLE_PERMISSIONS.items() if k not in system_roles}
+    assert non_system, "expected team roles in ROLE_PERMISSIONS"
+    for role_key, perms in non_system.items():
+        leaked = sorted(p.value for p in perms if p.value.startswith("system."))
+        assert leaked == [], f"role {role_key} grants system perms: {leaked}"
+    # sanity: the system roles do hold some
+    assert any(p.value.startswith("system.") for p in ROLE_PERMISSIONS["system_admin"])
