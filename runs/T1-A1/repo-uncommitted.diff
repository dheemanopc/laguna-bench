diff --git a/src/mem_mcp/mcp/tools/_admin_base.py b/src/mem_mcp/mcp/tools/_admin_base.py
new file mode 100644
index 0000000..6184ce2
--- /dev/null
+++ b/src/mem_mcp/mcp/tools/_admin_base.py
@@ -0,0 +1,156 @@
+"""AdminTool — base class for operator (system-role) MCP tools.
+
+Why a base class: every admin tool must (1) check an RBAC ``system.*``
+permission before touching any input-dependent data and (2) write exactly one
+audit row per call, attributed to the *caller*. Putting both in a final
+``__call__`` means a future admin tool cannot ship without them: subclasses
+implement ``run()`` only, and defining ``__call__`` is a TypeError at class
+definition time.
+
+Flow (see ``__call__``):
+  * permission check + denial audit share one ``system_tx`` that commits, so
+    the denied row survives; the error is raised after the block. Denial
+    happens before any lookup, so it is identical whether or not the target
+    record exists (no existence oracle).
+  * ``run()`` executes on a ``system_tx``; its success audit rides that tx.
+  * if ``run()`` raises, its tx rolls back (taking its audit with it), so an
+    ``error`` row is written on a fresh ``system_tx`` and the original
+    exception is re-raised unchanged.
+"""
+
+from __future__ import annotations
+
+from abc import ABC, abstractmethod
+from typing import TYPE_CHECKING, Any, ClassVar
+
+from pydantic import BaseModel
+
+from mem_mcp.audit.logger import AuditAction, AuditResult
+from mem_mcp.auth.permissions import Permission
+from mem_mcp.auth.rbac import has_permission
+from mem_mcp.db import system_tx
+from mem_mcp.logging_setup import get_logger
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+
+if TYPE_CHECKING:
+    import asyncpg  # type: ignore[import-untyped]
+
+_log = get_logger("mem_mcp.mcp.tools.admin")
+
+
+class AdminTool(ABC):
+    """Abstract base for tools gated by a ``system.*`` permission."""
+
+    name: ClassVar[str]
+    description: ClassVar[str]
+    # No `memory.admin` Cognito scope exists yet; the RBAC permission below is
+    # the real control, this scope is only the coarse OAuth gate.
+    required_scope: ClassVar[str] = "memory.read"
+    InputModel: ClassVar[type[BaseModel]]
+    OutputModel: ClassVar[type[BaseModel]]
+    required_permission: ClassVar[Permission]
+    audit_action: ClassVar[AuditAction]
+
+    def __init_subclass__(cls, **kwargs: Any) -> None:
+        super().__init_subclass__(**kwargs)
+        if "__call__" in cls.__dict__:
+            raise TypeError(
+                f"{cls.__name__} must not override __call__; AdminTool owns the "
+                "permission check and audit. Implement run() instead."
+            )
+        # Abstract intermediates may omit the attributes; concrete tools may not.
+        # (ABCMeta computes __abstractmethods__ only after this hook runs, so
+        # test `run` itself.)
+        if getattr(cls.run, "__isabstractmethod__", False):
+            return
+        perm = getattr(cls, "required_permission", None)
+        if not isinstance(perm, Permission) or not perm.value.startswith("system."):
+            raise TypeError(
+                f"{cls.__name__}.required_permission must be a system.* Permission, got {perm!r}"
+            )
+        action = getattr(cls, "audit_action", None)
+        if not isinstance(action, str) or not action.startswith("admin."):
+            raise TypeError(f"{cls.__name__}.audit_action must start with 'admin.', got {action!r}")
+
+    @abstractmethod
+    async def run(self, conn: asyncpg.Connection, ctx: ToolContext, inp: BaseModel) -> BaseModel:
+        """Do the work on a ``system_tx`` connection. Caller is already authorized."""
+
+    async def _audit(
+        self,
+        conn: asyncpg.Connection,
+        ctx: ToolContext,
+        *,
+        result: AuditResult,
+        error_code: str | None = None,
+        extra: dict[str, Any] | None = None,
+    ) -> None:
+        if ctx.deps is None:  # same convention as the other tools: no deps, no audit
+            return
+        details: dict[str, Any] = {
+            "via": "mcp",
+            "tool": self.name,
+            "required_permission": self.required_permission.value,
+        }
+        if extra:
+            details.update(extra)
+        await ctx.deps.audit.audit(
+            conn,
+            action=self.audit_action,
+            result=result,
+            tenant_id=ctx.tenant_id,
+            identity_id=ctx.identity_id,
+            client_id=ctx.client_id,
+            request_id=ctx.request_id,
+            error_code=error_code,
+            details=details,
+        )
+
+    async def __call__(self, ctx: ToolContext, inp: BaseModel) -> BaseModel:
+        perm = self.required_permission
+        try:
+            async with system_tx(ctx.db_pool) as conn:
+                allowed = await has_permission(conn, ctx.tenant_id, perm)
+                if not allowed:
+                    # Same tx; commits when we leave the block normally.
+                    await self._audit(conn, ctx, result="denied")
+        except Exception as exc:
+            # The check itself failed (DB error etc.): its tx rolled back, so
+            # no denied row exists. Re-raising here means the run() handler
+            # below can never also fire — exactly one row per call.
+            await self._audit_error(ctx, exc)
+            raise
+        if not allowed:
+            raise JsonRpcError(
+                -32603,
+                f"caller lacks required permission: {perm.value}",
+                data={"missing_permission": perm.value},
+            )
+
+        try:
+            async with system_tx(ctx.db_pool) as conn:
+                output = await self.run(conn, ctx, inp)
+                extra: dict[str, Any] = {}
+                count = getattr(output, "count", None)
+                if isinstance(count, int):
+                    extra["result_count"] = count
+                await self._audit(conn, ctx, result="success", extra=extra)
+                return output
+        except Exception as exc:
+            await self._audit_error(ctx, exc)
+            raise
+
+    async def _audit_error(self, ctx: ToolContext, exc: Exception) -> None:
+        """Best-effort ``error`` row on a fresh system_tx; never masks ``exc``."""
+        code = str(exc.code) if isinstance(exc, JsonRpcError) else type(exc).__name__
+        try:
+            async with system_tx(ctx.db_pool) as conn:
+                await self._audit(conn, ctx, result="error", error_code=code)
+        except Exception as audit_exc:
+            _log.warning(
+                "admin_error_audit_failed",
+                tool=self.name,
+                request_id=ctx.request_id,
+                error=type(audit_exc).__name__,
+            )
