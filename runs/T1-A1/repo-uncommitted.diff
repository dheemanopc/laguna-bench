+
+    async def test_literal_metacharacters_match_only_literal_user(self, pg_pool: Any) -> None:
+        token = uuid4().hex[:8]
+        name = f"{token} 50%_off\\x"
+        async with pg_pool.acquire() as conn:
+            tid, _, _ = await make_tenant(conn, display_name=name)
+            await make_tenant(conn, display_name=f"{token} 50Xaoffx")  # would match unescaped
+        async with system_tx(pg_pool) as conn:
+            hits = await find_users(conn, query=f"{token} 50%_off\\x")
+            assert [u.tenant_id for u in hits] == [str(tid)]
+            # `%`/`_` are literal: this must not wildcard-match the other user.
+            hits = await find_users(conn, query=f"{token} 50%_")
+            assert [u.tenant_id for u in hits] == [str(tid)]
+
+    async def test_limit_is_clamped(self, pg_pool: Any) -> None:
+        """Seed 105 matching tenants so the clamp is observable on a shared DB."""
+        token = uuid4().hex
+        async with pg_pool.acquire() as conn:
+            await conn.execute(
+                """
+                INSERT INTO tenants (id, email, status)
+                SELECT gen_random_uuid(), 'lim' || g || '-' || $1 || '@test.invalid', 'active'
+                FROM generate_series(1, 105) g
+                """,
+                token,
+            )
+        async with system_tx(pg_pool) as conn:
+            assert len(await find_users(conn, query=token, limit=9999)) == 100
+            assert len(await find_users(conn, query=token, limit=None)) == 20
+            assert len(await find_users(conn, query=token, limit=0)) == 1
+            assert len(await find_users(conn, query=token, limit=-5)) == 1
+            assert len(await find_users(conn, query=token, limit=50)) == 50
+
