+"""Shared DB-setup helpers for the admin-tool tests (not a test module).
+
+All rows use UUID-suffixed emails / names. The test DB is shared and not reset,
+so nothing here assumes empty tables and nothing is cleaned up (audit_log rows
+FK-reference identities, so deleting tenants afterwards is not possible anyway).
+"""
+
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Any
+from uuid import UUID, uuid4
+
+from mem_mcp.audit.logger import DbAuditLogger
+from mem_mcp.embeddings.bedrock import EmbedResult
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+
+
+class StubEmbeddings:
+    async def embed(self, text: str) -> EmbedResult:
+        return EmbedResult(vector=[0.0] * 1024, input_tokens=1)
+
+
+async def make_tenant(
+    conn: Any,
+    *,
+    email: str | None = None,
+    display_name: str | None = None,
+    created_at: datetime | None = None,
+    identity: bool = True,
+    system_role: str | None = None,
+    workspace_domain: str | None = None,
+) -> tuple[UUID, UUID | None, str]:
+    """Insert a tenant (+ primary identity). Returns (tenant_id, identity_id, email)."""
+    tenant_id = uuid4()
+    email = email or f"adm-{tenant_id}@test.invalid"
+    if created_at is None:
+        await conn.execute(
+            "INSERT INTO tenants (id, email, display_name, status) VALUES ($1, $2, $3, 'active')",
+            tenant_id,
+            email,
+            display_name,
+        )
+    else:
+        await conn.execute(
+            "INSERT INTO tenants (id, email, display_name, status, created_at) "
+            "VALUES ($1, $2, $3, 'active', $4)",
+            tenant_id,
+            email,
+            display_name,
+            created_at,
+        )
+    identity_id: UUID | None = None
+    if identity:
+        identity_id = uuid4()
+        await conn.execute(
+            """
+            INSERT INTO tenant_identities
+                (id, tenant_id, cognito_sub, provider, email, is_primary, workspace_domain)
+            VALUES ($1, $2, $3, 'google', $4, true, $5)
+            """,
+            identity_id,
+            tenant_id,
+            f"sub-{identity_id}",
+            email,
+            workspace_domain,
+        )
+    if system_role:
+        await conn.execute(
+            "INSERT INTO tenant_system_roles (tenant_id, role) VALUES ($1, $2)",
+            tenant_id,
+            system_role,
+        )
+    return tenant_id, identity_id, email
+
+
+async def make_team(conn: Any, creator: UUID, *, deleted: bool = False) -> tuple[UUID, str]:
+    team_id = uuid4()
+    name = f"admteam-{team_id}"
+    await conn.execute(
+        "INSERT INTO teams (id, name, created_by_tenant_id, deleted_at) "
+        "VALUES ($1, $2, $3, CASE WHEN $4 THEN now() ELSE NULL END)",
+        team_id,
+        name,
+        creator,
+        deleted,
+    )
+    return team_id, name
+
+
+async def assign_role(
+    conn: Any,
+    team_id: UUID,
+    tenant_id: UUID,
+    role_key: str,
+    *,
+    status: str = "active",
+    assigned_by: UUID | None = None,
+) -> None:
+    role_id = await conn.fetchval(
+        "SELECT id FROM roles_catalog WHERE role_key = $1 AND plugin_id IS NULL", role_key
+    )
+    assert role_id is not None, f"role {role_key} missing from roles_catalog"
+    await conn.execute(
+        """
+        INSERT INTO team_role_assignments
+            (parent_team_id, member_kind, member_id, role_id, status, assigned_by_user_id)
+        VALUES ($1, 'user', $2, $3, $4, $5)
+        """,
+        team_id,
+        tenant_id,
+        role_id,
+        status,
+        assigned_by or tenant_id,
+    )
+
+
+def make_ctx(pool: Any, tenant_id: UUID, identity_id: UUID | None) -> ToolContext:
+    """ToolContext with a unique request_id and real DB audit logging."""
+    assert identity_id is not None
+    return ToolContext(
+        request_id=f"adm-{uuid4()}",
+        tenant_id=tenant_id,
+        identity_id=identity_id,
+        client_id="test-client",
+        scopes=frozenset({"memory.read"}),
+        db_pool=pool,
+        deps=ToolDeps(embeddings=StubEmbeddings(), audit=DbAuditLogger(), quotas=NoopQuotas()),
+    )
+
+
+async def audit_rows(pool: Any, request_id: str) -> list[Any]:
+    async with pool.acquire() as conn:
+        return list(
+            await conn.fetch(
+                "SELECT action, result, error_code, tenant_id, actor_identity_id, "
+                "actor_client_id, details FROM audit_log WHERE request_id = $1",
+                request_id,
+            )
+        )
