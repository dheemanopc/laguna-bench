+class TestPooledConnectionAfterRollback:
+    async def test_service_works_after_rolled_back_tenant_tx(self) -> None:
+        """Regression: after ROLLBACK the tenant GUC reads back '' (not NULL);
+        the service must not depend on it and must still return correct rows."""
+        dsn = os.environ.get("MEM_MCP_TEST_DSN")
+        if not dsn:
+            pytest.skip("MEM_MCP_TEST_DSN env not set")
+        import asyncpg  # type: ignore[import-untyped]
+
+        from mem_mcp.db.pool import _init_connection
+
+        pool = await asyncpg.create_pool(dsn=dsn, min_size=1, max_size=1, init=_init_connection)
+        try:
+            async with pool.acquire() as conn:
+                tid, _, email = await make_tenant(conn, system_role="system_admin")
+            with pytest.raises(RuntimeError):
+                async with tenant_tx(pool, uuid4()):
+                    raise RuntimeError("force rollback")
+            async with system_tx(pool) as conn:  # same single physical connection
+                assert await conn.fetchval(
+                    "SELECT current_setting('app.current_tenant_id', true)"
+                ) in ("", None)
+                user = await get_user(conn, tenant_id=tid)
+                hits = await find_users(conn, query=email)
+            assert user.email == email
+            assert [u.tenant_id for u in hits] == [str(tid)]
+        finally:
+            await pool.close()
