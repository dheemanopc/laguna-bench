+"""Domain exceptions for the admin package.
+
+Transport layers (MCP tools, web handlers) map these to their own error
+types; this package never imports FastAPI or ``JsonRpcError``.
+"""
+
+from __future__ import annotations
+
+
+class AdminError(Exception):
+    """Base class for admin-service errors."""
+
+
+class NotFoundError(AdminError):
+    """The requested record does not exist."""
diff --git a/src/mem_mcp/admin/service.py b/src/mem_mcp/admin/service.py
