+async def test_sdk_reference_own_memory_by_slug_tuple(
+    pg_pool: Any, sdk_client_factory: Any, two_users: Any
+) -> None:
+    a, _ = two_users
+    sdk = sdk_client_factory(tenant_id=a["tenant"], plugin_id="rbw-refs")
+    target_id = await sdk.write(
+        content=f"slug target {uuid4()}", type="decision", slug_clue="sdk-own-slug"
+    )
+    async with pg_pool.acquire() as conn:
+        row = await conn.fetchrow(
+            "SELECT s.team_id, s.slug FROM slugs s WHERE s.memory_id = $1",
+            UUID(str(target_id)),
+        )
+    assert row is not None
+    slug = row["slug"]
+    citer = await sdk.write(
+        content=f"citer {uuid4()}",
+        type="note",
+        references=[
+            ReferenceInput(
+                target_team_id=row["team_id"],
+                target_resource_type="decision",
+                target_slug=slug,
+                reference_kind="cites",
+            )
+        ],
+    )
+    async with pg_pool.acquire() as conn:
+        n = await conn.fetchval(
+            "SELECT COUNT(*) FROM memory_references "
+            "WHERE source_memory_id = $1 AND target_memory_id = $2",
+            UUID(str(citer)),
+            UUID(str(target_id)),
+        )
+    assert n == 1
+
