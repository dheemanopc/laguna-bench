+async def accessible_memory_ids(
+    conn: asyncpg.Connection,
+    *,
+    memory_ids: Sequence[UUID],
+    caller_user_id: UUID,
+) -> set[UUID]:
+    """Return the subset of ``memory_ids`` the caller may read (one query).
+
+    Single canonical rule, evaluated DB-side by ``memory_readable_by()``
+    (migration 0035): the memory exists, is not soft-deleted, and the caller
+    either OWNS it or has a user_effective_team_access row for its team.
+    Missing/deleted ids are simply absent from the result.
+
+    Why not UEA alone: UEA is a materialised cache that lags raw-SQL
+    provisioning (e.g. the 0026 backfill), which made users' own memories
+    look inaccessible to the references machinery while memory_get read them.
+    """
+    if not memory_ids:
+        return set()
+    rows = await conn.fetch(
+        "SELECT id FROM unnest($1::uuid[]) AS id WHERE memory_readable_by(id, $2)",
+        list(memory_ids),
+        caller_user_id,
+    )
+    return {r["id"] for r in rows}
+
