+# --- SQL function ---------------------------------------------------------------
+
+
+async def test_memory_readable_by_sql_function(pg_pool: Any, two_users: Any) -> None:
+    a, b = two_users
+    async with pg_pool.acquire() as conn:
+        mine = await _mem(conn, a["tenant"], a["team"])
+        theirs = await _mem(conn, b["tenant"], b["team"])
+        deleted = await _mem(conn, a["tenant"], a["team"])
+        await conn.execute("UPDATE memories SET deleted_at = now() WHERE id = $1", deleted)
+
+        q = "SELECT memory_readable_by($1, $2)"
+        assert await conn.fetchval(q, mine, a["tenant"]) is True
+        assert await conn.fetchval(q, theirs, a["tenant"]) is False
+        assert await conn.fetchval(q, deleted, a["tenant"]) is False
+        assert await conn.fetchval(q, uuid4(), a["tenant"]) is False
+        # NULL user with no GUC set → false, no exception.
+        assert await conn.fetchval(q, mine, None) is False
+        assert await conn.fetchval("SELECT memory_readable_by($1)", mine) is False
+        # GUC fallback when user omitted.
+        async with conn.transaction():
+            await conn.execute(
+                "SELECT set_config('app.current_tenant_id', $1, true)", str(a["tenant"])
+            )
+            assert await conn.fetchval("SELECT memory_readable_by($1)", mine) is True
+
+        got = await accessible_memory_ids(
+            conn, memory_ids=[mine, theirs, deleted], caller_user_id=a["tenant"]
+        )
+    assert got == {mine}
+
