@@ -0,0 +1,84 @@
+"""Introduce memory_readable_by(): one canonical "can this user see memory X?" predicate.
+
+Incident: a user writes memory M1, reads it back with memory_get, but a second
+write citing M1 via `references=[...]` fails with `memory_not_accessible`.
+
+Root cause: the references machinery (write-time validator, hard-delete citer
+filter, refs_in, refs_out) decided per-memory visibility with a single rule —
+"there is a user_effective_team_access (UEA) row for (caller, memory.team_id)".
+UEA is a materialised cache (migration 0023) filled only by the team-management
+API paths or by the periodic reconciler. Users provisioned by raw SQL (exactly
+how migration 0026 backfilled existing users: tenant + personal team + owner
+team_role_assignments row) have no UEA row until the reconciler runs, so the
+caller was told their *own* memory was inaccessible. The read path
+(memory_get by id) never consults UEA — ownership is `memories.tenant_id =
+caller` — so the two paths disagreed.
+
+Fix: a single DB-side predicate used by every site.
+
+  memory_readable_by(p_memory_id, p_user_id DEFAULT NULL) -> boolean
+
+  true iff the memory exists, is not soft-deleted, and either
+    - the user owns it (memories.tenant_id = user), OR
+    - the user has a UEA row for the memory's team (existing cross-team
+      sharing semantics: a reference may legitimately target another tenant's
+      memory the caller has team access to).
+
+p_user_id NULL falls back to safe_current_tenant_id() (NULLIF-guarded GUC; see
+0034). A NULL user never matches anything, so the function returns false
+rather than raising.
+
+SECURITY DEFINER so it sees memories across tenants regardless of the calling
+role's RLS (it only ever returns a boolean, never row data). search_path is
+pinned. EXECUTE granted to PUBLIC, matching safe_current_tenant_id() in 0034.
+
+Revision ID: 0035_memory_readable_by
+Revises: 0034_safe_current_tenant_id
+Create Date: 2026-06-01
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0035_memory_readable_by"
+down_revision = "0034_safe_current_tenant_id"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    op.execute(
+        sa.text("""
+CREATE OR REPLACE FUNCTION memory_readable_by(
+    p_memory_id uuid,
+    p_user_id uuid DEFAULT NULL
+) RETURNS boolean
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = public
+AS $$
+    SELECT EXISTS (
+        SELECT 1 FROM memories m
+        WHERE m.id = p_memory_id
+          AND m.deleted_at IS NULL
+          AND (
+                m.tenant_id = COALESCE(p_user_id, safe_current_tenant_id())
+             OR EXISTS (
+                    SELECT 1 FROM user_effective_team_access uea
+                     WHERE uea.user_id = COALESCE(p_user_id, safe_current_tenant_id())
+                       AND uea.resource_team_id = m.team_id
+                )
+          )
+    )
+$$;
+        """)
+    )
+    op.execute(sa.text("GRANT EXECUTE ON FUNCTION memory_readable_by(uuid, uuid) TO PUBLIC"))
+
+
+def downgrade() -> None:
+    op.execute(sa.text("DROP FUNCTION IF EXISTS memory_readable_by(uuid, uuid)"))
