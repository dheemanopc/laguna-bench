+) -> tuple[list[dict[str, Any]], int]:
+    """Split reference rows into (accessible rows, inaccessible count).
+
+    ``memory_id_key`` names the column holding the memory to classify:
+    ``source_memory_id`` for inbound refs, ``target_memory_id`` for outbound.
+    Deleted/missing memories count as inaccessible.
+    """
+    readable = await accessible_memory_ids(
+        conn,
+        memory_ids=[r[memory_id_key] for r in refs],
+        caller_user_id=caller_user_id,
