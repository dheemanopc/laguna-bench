diff --git a/tests/integration/test_references_memory_readable_by.py b/tests/integration/test_references_memory_readable_by.py
new file mode 100644
index 0000000..eb96f26
--- /dev/null
+++ b/tests/integration/test_references_memory_readable_by.py
@@ -0,0 +1,423 @@
+"""Regression: referencing one's OWN memory failed with `memory_not_accessible`.
+
+Bug: the references machinery (resolve_reference_target,
+check_hard_delete_with_filtered_citers, refs_in, refs_out) decided per-memory
+visibility solely by a `user_effective_team_access` (UEA) row for the memory's
+team. UEA is a materialised cache that raw-SQL provisioning (the 0026 backfill)
+never fills, so a user's own memory looked inaccessible while `memory_get` read
+it fine. Fix: one canonical predicate, DB function `memory_readable_by()`
+(migration 0035), reached through `teams.references.accessible_memory_ids`.
+
+Users here are provisioned by raw SQL exactly like the backfill: no UEA rows.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools.refs_in import RefsInInput, RefsInTool
+from mem_mcp.mcp.tools.refs_out import RefsOutInput, RefsOutTool
+from mem_mcp.mcp.tools.write import ReferenceInput
+from mem_mcp.teams.effective_access import upsert_effective_access
+from mem_mcp.teams.references import (
+    HardDeleteBlockedError,
+    ReferenceTargetNotFoundError,
+    accessible_memory_ids,
+    check_hard_delete_with_filtered_citers,
+    insert_reference,
+    resolve_reference_target,
+)
+from mem_mcp.teams.slugs import insert_slug_with_retry
+
+pytestmark = pytest.mark.asyncio
+
+_MEM_INSERT = (
+    "INSERT INTO memories (tenant_id, team_id, content, content_hash, embedding, "
+    "source_kind, type) "
+    "VALUES ($1, $2, $3, $4, array_fill(0::real, ARRAY[1024])::vector, 'api', 'decision') "
+    "RETURNING id"
+)
+
+
+async def _provision_user(conn: Any) -> dict[str, Any]:
+    """Tenant + personal team + owner assignment + primary identity via raw SQL."""
+    tenant = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"rbw-{uuid4()}@example.test",
+    )
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id, team_type) "
+        "VALUES ($1, $2, 'personal') RETURNING id",
+        f"rbw-{uuid4().hex[:8]}",
+        tenant,
+    )
+    owner_role_id = await conn.fetchval(
+        "SELECT id FROM roles_catalog WHERE role_key = 'owner' AND plugin_id IS NULL"
+    )
+    await conn.execute(
+        """
+        INSERT INTO team_role_assignments
+            (parent_team_id, member_kind, member_id, role_id, status, assigned_by_user_id)
+        VALUES ($1, 'user', $2, $3, 'active', $2)
+        """,
+        team,
+        tenant,
+        owner_role_id,
+    )
+    await conn.execute(
+        """
+        INSERT INTO tenant_identities
+        (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+        VALUES ($1, $2, 'cognito', $3, true, $4)
+        """,
+        tenant,
+        f"sub-rbw-{tenant}",
+        f"rbw-{tenant}@example.test",
+        team,
+    )
+    await conn.execute(
+        """
+        INSERT INTO oauth_clients
+        (id, redirect_uris, scope, registration_payload, review_status)
+        VALUES ($1, ARRAY[]::text[], 'memory.read memory.write', '{}'::jsonb, 'auto_allowed')
+        ON CONFLICT (id) DO NOTHING
+        """,
+        "plugin:rbw-refs",
+    )
+    return {"tenant": tenant, "team": team}
+
+
+async def _mem(conn: Any, tenant: UUID, team: UUID | None, label: str = "m") -> UUID:
+    mid = await conn.fetchval(_MEM_INSERT, tenant, team, f"{label}-{uuid4()}", f"h-{uuid4().hex}")
+    assert isinstance(mid, UUID)
+    return mid
+
+
+async def _cleanup(pool: Any, users: list[dict[str, Any]]) -> None:
+    tenants = [u["tenant"] for u in users]
+    teams = [u["team"] for u in users]
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute(
+                """
+                DELETE FROM memory_references
+                WHERE source_memory_id IN (SELECT id FROM memories WHERE tenant_id = ANY($1))
+                   OR target_memory_id IN (SELECT id FROM memories WHERE tenant_id = ANY($1))
+                """,
+                tenants,
+            )
+            await conn.execute("DELETE FROM slugs WHERE team_id = ANY($1)", teams)
+            await conn.execute("DELETE FROM memories WHERE tenant_id = ANY($1)", tenants)
+            await conn.execute(
+                "DELETE FROM user_effective_team_access "
+                "WHERE user_id = ANY($1) OR resource_team_id = ANY($2)",
+                tenants,
+                teams,
+            )
+            await conn.execute(
+                "DELETE FROM team_role_assignments WHERE parent_team_id = ANY($1)", teams
+            )
+            await conn.execute("DELETE FROM tenant_identities WHERE tenant_id = ANY($1)", tenants)
+            await conn.execute("DELETE FROM teams WHERE id = ANY($1)", teams)
+            await conn.execute("DELETE FROM tenants WHERE id = ANY($1)", tenants)
+
+
<email>
+async def two_users(pg_pool: Any) -> Any:
+    """Two raw-SQL-provisioned users (no UEA rows), cleaned up afterwards."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            a = await _provision_user(conn)
+            b = await _provision_user(conn)
+    try:
+        yield a, b
+    finally:
+        await _cleanup(pg_pool, [a, b])
+
+
+def _ctx(pool: Any, tenant: UUID) -> ToolContext:
+    return ToolContext(
+        request_id=str(uuid4()),
+        tenant_id=tenant,
+        identity_id=uuid4(),
+        client_id="plugin:rbw-refs",
+        scopes=frozenset({"memory.read"}),
+        db_pool=pool,
+    )
+
+
+# --- resolve_reference_target ------------------------------------------------
+
+
+async def test_resolve_own_memory_by_uuid(pg_pool: Any, two_users: Any) -> None:
+    a, _ = two_users
+    async with pg_pool.acquire() as conn:
+        mid = await _mem(conn, a["tenant"], a["team"])
+        got = await resolve_reference_target(conn, target_uuid=mid, caller_user_id=a["tenant"])
+    assert got == {"memory_id": mid, "team_id": a["team"]}
+
+
+async def test_resolve_own_memory_by_slug_tuple(pg_pool: Any, two_users: Any) -> None:
+    a, _ = two_users
+    async with pg_pool.acquire() as conn:
+        mid = await _mem(conn, a["tenant"], a["team"])
+        slug = await insert_slug_with_retry(
+            conn,
+            team_id=a["team"],
+            resource_type="decision",
+            clue="own-slug",
+            memory_id=mid,
+            title="Own slug",
+        )
+        got = await resolve_reference_target(
+            conn,
+            target_team_id=a["team"],
+            target_resource_type="decision",
+            target_slug=slug,
+            caller_user_id=a["tenant"],
+        )
+    assert got["memory_id"] == mid
+
+
+async def test_resolve_own_memory_without_team(pg_pool: Any, two_users: Any) -> None:
+    a, b = two_users
+    async with pg_pool.acquire() as conn:
+        mid = await _mem(conn, a["tenant"], None)
+        got = await resolve_reference_target(conn, target_uuid=mid, caller_user_id=a["tenant"])
+        assert got == {"memory_id": mid, "team_id": None}
+        # Non-owner without a team is rejected: no NULL-team bypass.
+        with pytest.raises(ReferenceTargetNotFoundError):
+            await resolve_reference_target(conn, target_uuid=mid, caller_user_id=b["tenant"])
