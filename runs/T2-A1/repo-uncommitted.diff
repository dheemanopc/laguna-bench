+    caller_user_id: UUID,
+) -> bool:
+    """True iff the caller may read ``memory_id`` (see accessible_memory_ids)."""
+    ids = await accessible_memory_ids(conn, memory_ids=[memory_id], caller_user_id=caller_user_id)
+    return memory_id in ids
