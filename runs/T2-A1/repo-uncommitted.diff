+async def test_sdk_no_access_envelope_equals_nonexistent(
+    pg_pool: Any, sdk_client_factory: Any, two_users: Any
+) -> None:
+    a, b = two_users
+    async with pg_pool.acquire() as conn:
+        foreign = await _mem(conn, b["tenant"], b["team"])
+    sdk = sdk_client_factory(tenant_id=a["tenant"], plugin_id="rbw-refs")
+
+    async def _attempt(target: UUID) -> Exception:
+        try:
+            await sdk.write(
+                content=f"citer {uuid4()}",
+                type="note",
+                references=[ReferenceInput(target_uuid=target, reference_kind="cites")],
+            )
+        except Exception as exc:  # comparing error envelopes
+            return exc
+        raise AssertionError("write unexpectedly succeeded")
+
+    denied = await _attempt(foreign)
+    missing = await _attempt(uuid4())
+    assert type(denied) is type(missing)
+    assert getattr(denied, "code", None) == "memory_not_accessible"
+    assert getattr(denied, "code", None) == getattr(missing, "code", None)
+    assert str(denied) == str(missing)
