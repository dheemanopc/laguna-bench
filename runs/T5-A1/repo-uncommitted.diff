+
+async def _write(ctx: ToolContext, content: str, type_: str, tags: list[str] | None = None) -> UUID:
+    out = await MemoryWriteTool()(
+        ctx,
+        MemoryWriteInput(content=content, type=type_, tags=tags or [], force_new=True),  # type: ignore[arg-type]
+    )
+    return out.id  # type: ignore[no-any-return]
+
+
+async def _get(ctx: ToolContext, mid: UUID) -> Any:
+    return (await MemoryGetTool()(ctx, MemoryGetInput(id=mid))).memory
+
+
+async def _update(ctx: ToolContext, **kw: Any) -> Any:
+    return await MemoryUpdateTool()(ctx, MemoryUpdateInput(**kw))
+
+
+async def _try(ctx: ToolContext, **kw: Any) -> Any:
+    try:
+        return await _update(ctx, **kw)
+    except JsonRpcError as e:
+        return e
+
+
+def _is_conflict(r: Any) -> bool:
+    return (
+        isinstance(r, JsonRpcError)
+        and r.code == -32000
+        and (r.data or {}).get("code") == "update_conflict"
+    )
+
+
+async def test_concurrent_tag_add_and_remove_lose_nothing(env: dict[str, Any]) -> None:
+    ctx = env["ctx"]
+    mid = await _write(ctx, f"position {uuid4()}", "position")
+    tags = [f"t{i}" for i in range(10)]
+    res = await asyncio.gather(*[_update(ctx, id=mid, tags=[t], tags_op="add") for t in tags])
+    assert all(not isinstance(r, Exception) for r in res)
+    assert set((await _get(ctx, mid)).tags) == set(tags)
+
+    await asyncio.gather(*[_update(ctx, id=mid, tags=[t], tags_op="remove") for t in tags])
+    assert (await _get(ctx, mid)).tags == []
+
+
+async def _chain_state(pool: Any, tenant: UUID, v1: UUID) -> tuple[int, int]:
+    async with pool.acquire() as conn:
+        current = await conn.fetchval(
+            """
+            WITH RECURSIVE c AS (
+                SELECT id, is_current FROM memories WHERE id = $1 AND tenant_id = $2
+                UNION ALL
+                SELECT m.id, m.is_current FROM memories m JOIN c ON m.supersedes = c.id
+                WHERE m.tenant_id = $2
+            )
+            SELECT count(*) FROM c WHERE is_current
+            """,
+            v1,
+            tenant,
+        )
+        children = await conn.fetchval(
+            "SELECT count(*) FROM memories WHERE supersedes = $1 AND tenant_id = $2", v1, tenant
+        )
+    return int(current), int(children)
+
+
+async def test_concurrent_decision_updates_do_not_fork_chain(env: dict[str, Any]) -> None:
+    ctx = env["ctx"]
+    v1 = await _write(ctx, f"decision {uuid4()}", "decision")
+    res = await asyncio.gather(
+        *[_try(ctx, id=v1, content=f"revised {i} {uuid4()}") for i in range(N)]
+    )
+    wins = [r for r in res if not isinstance(r, JsonRpcError)]
+    losses = [r for r in res if isinstance(r, JsonRpcError)]
+    assert len(wins) == 1
+    assert wins[0].version == 2 and wins[0].is_new_version
+    assert len(losses) == N - 1
+    for r in losses:
+        assert _is_conflict(r)
+        assert (r.data or {})["current_id"] == str(wins[0].id)
+    current, children = await _chain_state(env["pool"], env["tenant"], v1)
+    assert (current, children) == (1, 1)
+
+
+async def test_update_superseded_id_is_refused(env: dict[str, Any]) -> None:
+    ctx = env["ctx"]
+    v1 = await _write(ctx, f"decision {uuid4()}", "decision")
+    v2 = (await _update(ctx, id=v1, content=f"v2 {uuid4()}")).id
+    r = await _try(ctx, id=v1, content=f"stale {uuid4()}")
+    assert _is_conflict(r)
+    assert r.data["current_id"] == str(v2)
+
+    note = await _write(ctx, f"note {uuid4()}", "note")
+    promoted = await _update(ctx, id=note, type="decision")
+    assert promoted.is_new_version
+    r = await _try(ctx, id=note, tags=["x"])
+    assert _is_conflict(r)
+    assert r.data["current_id"] == str(promoted.id)
+
