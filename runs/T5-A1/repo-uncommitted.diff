+async def test_concurrent_in_place_content_updates_last_writer_wins(env: dict[str, Any]) -> None:
+    ctx = env["ctx"]
+    note = await _write(ctx, f"note {uuid4()}", "note")
+    contents = [f"c{i} {uuid4()}" for i in range(N)]
+    res = await asyncio.gather(*[_update(ctx, id=note, content=c) for c in contents])
+    assert len(res) == N
+    assert len({r.revision for r in res}) == N  # strictly increasing updated_at
+    assert (await _get(ctx, note)).content in contents
