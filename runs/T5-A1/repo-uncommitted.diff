 """Versioning helpers for decision/fact memory types.
 
-Full implementation lands with memory.update (T-7.2). For now this module
-exists so other modules can import the constants/types they'll need.
+Also home of the optimistic-concurrency primitives for ``memory_update``:
+
+- ``memory_revision`` — an opaque revision token derived from ``(id, updated_at)``
+  (no schema change; every write path bumps ``updated_at`` strictly upward).
+- ``lock_memory_for_update`` — ``SELECT ... FOR UPDATE`` of the target row. The row
+  lock is what serializes concurrent updates (correctness lives in the database,
+  not in-process, because the server runs multiple workers).
+- ``resolve_current_id`` — follow ``superseded_by`` forward to the live version, so a
+  refused caller learns which id to update instead.
 """
 
 from __future__ import annotations
 
-from typing import Final
+import hashlib
+from datetime import UTC, datetime, timedelta
+from typing import TYPE_CHECKING, Any, Final
+from uuid import UUID
+
+if TYPE_CHECKING:
+    import asyncpg  # type: ignore[import-untyped]
 
 VERSIONED_TYPES: Final[frozenset[str]] = frozenset({"decision", "fact"})
 NON_VERSIONED_TYPES: Final[frozenset[str]] = frozenset({"note", "snippet", "question"})
+
+_EPOCH: Final[datetime] = datetime(1970, 1, 1, tzinfo=UTC)
+_ONE_US: Final[timedelta] = timedelta(microseconds=1)
+
+
+class UpdateConflictError(Exception):
+    """A memory update was refused because the target changed or was superseded."""
+
+    def __init__(
+        self,
+        message: str,
+        *,
+        current_id: UUID | None = None,
+        current_revision: str | None = None,
+    ) -> None:
+        super().__init__(message)
+        self.current_id = current_id
+        self.current_revision = current_revision
+
+
+def memory_revision(memory_id: UUID, updated_at: datetime) -> str:
+    """Opaque revision token for a memory row at a given ``updated_at``.
+
+    Uses integer microseconds since the Unix epoch so the result is independent of
+    the datetime's tz representation; naive datetimes are treated as UTC.
+    """
+    if updated_at.tzinfo is None:
+        updated_at = updated_at.replace(tzinfo=UTC)
+    us = (updated_at - _EPOCH) // _ONE_US
+    return "r" + hashlib.sha256(f"{memory_id}:{us}".encode()).hexdigest()[:24]
+
+
+async def lock_memory_for_update(conn: asyncpg.Connection, memory_id: UUID, tenant_id: UUID) -> Any:
+    """Fetch and row-lock a memory; later writers wait and re-read the committed row."""
+    return await conn.fetchrow(
+        """
+        SELECT id, type, content, version, tags, metadata, deleted_at,
+               is_current, superseded_by, updated_at
+        FROM memories
+        WHERE id = $1 AND tenant_id = $2
+        FOR UPDATE
+        """,
+        memory_id,
+        tenant_id,
+    )
+
+
+async def resolve_current_id(
+    conn: asyncpg.Connection, memory_id: UUID, tenant_id: UUID
+) -> UUID | None:
+    """Follow ``superseded_by`` forward to the current version of the chain.
+
+    Prefers a non-deleted ``is_current`` row; otherwise falls back to the last
+    row reached.
+    """
+    result = await conn.fetchval(
+        """
+        WITH RECURSIVE fwd AS (
+            SELECT id, superseded_by, is_current, deleted_at, 0 AS depth
+            FROM memories
+            WHERE id = $1 AND tenant_id = $2
+            UNION ALL
+            SELECT m.id, m.superseded_by, m.is_current, m.deleted_at, f.depth + 1
+            FROM memories m JOIN fwd f ON m.id = f.superseded_by
+            WHERE m.tenant_id = $2 AND f.depth < 10000
+        )
+        SELECT id FROM fwd
+        ORDER BY (is_current AND deleted_at IS NULL) DESC, depth DESC
+        LIMIT 1
+        """,
+        memory_id,
+        tenant_id,
+    )
+    return result  # type: ignore[no-any-return]
