+async def test_expected_revision_flow(env: dict[str, Any]) -> None:
+    ctx = env["ctx"]
+    mid = await _write(ctx, f"note {uuid4()}", "note")
+    rev0 = (await _get(ctx, mid)).revision
+    out = await _update(ctx, id=mid, content=f"edited {uuid4()}", expected_revision=rev0)
+    assert out.revision != rev0
+    assert out.revision == (await _get(ctx, mid)).revision
+
+    before = await _get(ctx, mid)
+    r = await _try(ctx, id=mid, content="should not apply", expected_revision=rev0)
+    assert _is_conflict(r)
+    assert r.data["current_revision"] == before.revision
+    assert r.data["current_id"] == str(mid)
+    after = await _get(ctx, mid)
+    assert after.content == before.content and after.revision == before.revision
+
+    # Two successive same-content updates never yield the same revision.
+    a = await _update(ctx, id=mid, content=before.content)
+    b = await _update(ctx, id=mid, content=before.content)
+    assert a.revision != b.revision
+
+    # Versioned path: output revision matches what memory_get reports.
+    dec = await _write(ctx, f"decision {uuid4()}", "decision")
+    drev = (await _get(ctx, dec)).revision
+    v2 = await _update(ctx, id=dec, content=f"v2 {uuid4()}", expected_revision=drev)
+    assert v2.is_new_version
+    assert v2.revision == (await _get(ctx, v2.id)).revision
+
