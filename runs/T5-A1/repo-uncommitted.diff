+async def test_concurrent_same_expected_revision_single_winner(env: dict[str, Any]) -> None:
+    ctx = env["ctx"]
+    note = await _write(ctx, f"note {uuid4()}", "note")
+    rev = (await _get(ctx, note)).revision
+    res = await asyncio.gather(
+        *[_try(ctx, id=note, content=f"n{i} {uuid4()}", expected_revision=rev) for i in range(N)]
+    )
+    assert sum(not isinstance(r, JsonRpcError) for r in res) == 1
+    assert sum(_is_conflict(r) for r in res) == N - 1
+
+    dec = await _write(ctx, f"decision {uuid4()}", "decision")
+    drev = (await _get(ctx, dec)).revision
+    res = await asyncio.gather(
+        *[_try(ctx, id=dec, content=f"d{i} {uuid4()}", expected_revision=drev) for i in range(N)]
+    )
+    assert sum(not isinstance(r, JsonRpcError) for r in res) == 1
+    assert sum(_is_conflict(r) for r in res) == N - 1
+
