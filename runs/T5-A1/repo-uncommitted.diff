+# mypy: disable-error-code="attr-defined"
+"""Concurrency / optimistic-locking tests for memory_update (work order 1).
+
+Regressions covered: lost tag updates under concurrent add/remove, forked
+decision version chains (concurrent and sequential), and the opt-in
+`expected_revision` compare-and-set. Uses its own pool (max_size >= 12) so each
+concurrent call really holds its own connection.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import os
+from collections.abc import AsyncIterator
+from datetime import UTC, datetime, timedelta, timezone
+from typing import Any
+from uuid import UUID, uuid4
+
+import asyncpg  # type: ignore[import-untyped]
+import pytest
+
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools.get import MemoryGetInput, MemoryGetTool, MemoryRecord
+from mem_mcp.mcp.tools.update import MemoryUpdateInput, MemoryUpdateTool
+from mem_mcp.mcp.tools.write import MemoryWriteInput, MemoryWriteTool
+from mem_mcp.memory.versioning import memory_revision
+from mem_mcp.teams.assignments import assign_role
+
+N = 8
+
+
+def _deps() -> Any:
+    from mem_mcp.audit.logger import NoopAuditLogger
+    from mem_mcp.embeddings.bedrock import EmbedResult
+    from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+
+    class _StubEmbed:
+        async def embed(self, content: str) -> Any:
+            return EmbedResult(vector=[0.0] * 1024, input_tokens=max(1, len(content) // 4))
+
+    return ToolDeps(embeddings=_StubEmbed(), audit=NoopAuditLogger(), quotas=NoopQuotas())
+
+
<email>
+async def env() -> AsyncIterator[dict[str, Any]]:
+    dsn = os.environ.get("MEM_MCP_TEST_DSN")
+    if not dsn:
+        pytest.skip("MEM_MCP_TEST_DSN env not set; skipping live-DB test")
+    from mem_mcp.db.pool import _init_connection
+
+    pool = await asyncpg.create_pool(dsn=dsn, min_size=2, max_size=14, init=_init_connection)
+    tenant = team = client_id = None
+    try:
+        async with pool.acquire() as conn:
+            async with conn.transaction():
+                tenant = await conn.fetchval(
+                    "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                    f"upd-conc-{uuid4()}@example.test",
+                )
+                team = await conn.fetchval(
+                    "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+                    f"upd-conc-team-{uuid4().hex[:8]}",
+                    tenant,
+                )
+                await assign_role(
+                    conn,
+                    parent_team_id=team,
+                    member_kind="user",
+                    member_id=tenant,
+                    role_key="member",
+                    assigned_by_user_id=tenant,
+                )
+                await conn.execute(
+                    """
+                    INSERT INTO tenant_identities
+                        (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+                    VALUES ($1, $2, 'cognito', $3, true, $4)
+                    """,
+                    tenant,
+                    f"sub-{tenant}",
+                    f"upd-conc-{tenant}@example.test",
+                    team,
+                )
+                client_id = f"client:updconc-{uuid4().hex[:8]}"
+                await conn.execute(
+                    """
+                    INSERT INTO oauth_clients
+                        (id, redirect_uris, scope, registration_payload, review_status)
+                    VALUES ($1, ARRAY[]::text[], 'memory.read memory.write', '{}'::jsonb,
+                            'auto_allowed')
+                    """,
+                    client_id,
+                )
+        ctx = ToolContext(
+            request_id=f"req-{uuid4().hex[:8]}",
+            tenant_id=tenant,
+            identity_id=tenant,
+            client_id=client_id,
+            scopes=frozenset({"memory.read", "memory.write"}),
+            db_pool=pool,
+            deps=_deps(),
+        )
+        yield {"pool": pool, "ctx": ctx, "tenant": tenant}
+    finally:
+        # Let memory_get's fire-and-forget access bump drain before tearing down.
+        from mem_mcp.memory import access_tracking
+
+        if access_tracking._inflight_tasks:
+            await asyncio.gather(*list(access_tracking._inflight_tasks), return_exceptions=True)
+        if tenant is not None:
