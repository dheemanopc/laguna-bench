+async def test_materialise_legacy_stages_and_transitions_match_hardcoded(
+    pg_pool: Any,
+    tenant_a: UUID,
+    team_a: UUID,
+) -> None:
+    """Legacy stages/transitions must mirror work_items.WORK_STATUSES/TRANSITIONS."""
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        wid = await materialise_legacy_workflow(conn, tenant_id=tenant_a, team_id=team_a)
+
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        stage_rows = await conn.fetch(
+            "SELECT name, ordinal, is_initial, is_terminal FROM workflow_stages "
+            "WHERE workflow_id = $1 AND tenant_id = $2 ORDER BY ordinal",
+            wid, tenant_a,
+        )
+    names = [r["name"] for r in stage_rows]
+    assert names == list(work_items.WORK_STATUSES)
+    assert [s["ordinal"] for s in stage_rows] == list(
+        range(1, len(work_items.WORK_STATUSES) + 1)
+    )
+    initials = [s["name"] for s in stage_rows if s["is_initial"]]
+    assert initials == ["todo"]
+    terminals = [s["name"] for s in stage_rows if s["is_terminal"]]
+    assert set(terminals) == {"done", "cancelled"}
+
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        trans_rows = await conn.fetch(
+            "SELECT sf.name AS from_stage, st.name AS to_stage, "
+            "wt.requires_reason, wt.requires_signoff, wt.signoff_min "
+            "FROM workflow_transitions wt "
+            "LEFT JOIN workflow_stages sf ON sf.stage_id = wt.from_stage_id "
+            "JOIN workflow_stages st ON st.stage_id = wt.to_stage_id "
+            "WHERE wt.workflow_id = $1 AND wt.tenant_id = $2",
+            wid, tenant_a,
+        )
+    assert len(trans_rows) == len(work_items.TRANSITIONS)
+    actual = {(r["from_stage"], r["to_stage"]): r for r in trans_rows}
+    for (frm, to), requires_reason in work_items.TRANSITIONS.items():
+        assert (frm, to) in actual
+        row = actual[(frm, to)]
+        assert row["requires_reason"] is requires_reason
+        assert row["requires_signoff"] is False
+        assert row["signoff_min"] == 1
+
