+async def work_items_on_map(
+    pg_pool: Any,
+    tenant_a: UUID,
+    team_a: UUID,
+) -> list[UUID]:
+    """Three work items on a live map, returned as node memory ids.
+
+    Items are created under tenant_a at status='todo' with ``current_stage`` NULL
+    (legacy, no workflow assigned); individual tests set ``current_stage`` as
+    needed before remapping.
+    """
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            root_mem_id = await conn.fetchval(
+                """
+                INSERT INTO memories (tenant_id, team_id, content, content_hash,
+                                     embedding, source_kind, type, visibility)
+                VALUES ($1, $2, 'Root', $3,
+                        array_fill(0::real, ARRAY[1024])::vector, 'api', 'question', 'team')
+                RETURNING id
+                """,
+                tenant_a, team_a, f"hash-root-{uuid4().hex}",
+            )
+            await conn.execute(
+                "INSERT INTO memory_maps (root_memory_id, tenant_id, team_id, title, state) "
+                "VALUES ($1, $2, $3, $4, 'live')",
+                root_mem_id, tenant_a, team_a, f"map-{uuid4().hex[:8]}",
+            )
+            map_key = f"map-{root_mem_id.hex[:8]}"
+            await conn.execute(
+                "INSERT INTO slugs (memory_id, team_id, resource_type, slug, title) "
+                "VALUES ($1, $2, 'map', $3, $4)",
+                root_mem_id, team_a, map_key, "Remap Map",
+            )
+            node_ids: list[UUID] = []
+            for i in range(3):
+                nid = await conn.fetchval(
+                    """
+                    INSERT INTO memories (tenant_id, team_id, content, content_hash,
+                                         embedding, source_kind, type, visibility)
+                    VALUES ($1, $2, $3, $4,
+                            array_fill(0::real, ARRAY[1024])::vector, 'api', 'note', 'team')
+                    RETURNING id
+                    """,
+                    tenant_a, team_a, f"node-{i}-{uuid4().hex}",
+                    f"hash-n{i}-{uuid4().hex}",
+                )
+                await conn.execute(
+                    "INSERT INTO memory_map_membership "
+                    "(memory_id, root_memory_id, tenant_id, node_role, turn, authored_by) "
+                    "VALUES ($1, $2, $3, 'position', 'owner', 'owner')",
+                    nid, root_mem_id, tenant_a,
+                )
+                await conn.execute(
+                    "INSERT INTO work_items "
+                    "(memory_id, root_memory_id, tenant_id, team_id, created_by, "
+                    "kind, status, status_changed_at) "
+                    "VALUES ($1, $2, $3, $4, $5, 'story', 'todo', now())",
+                    nid, root_mem_id, tenant_a, team_a, tenant_a,
+                )
+                node_ids.append(nid)
+            return node_ids
+
