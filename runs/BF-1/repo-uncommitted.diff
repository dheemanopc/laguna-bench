+async def test_create_inserts_inactive_version_one(
+    pg_pool: Any,
+    tenant_a: UUID,
+    team_a: UUID,
+) -> None:
+    """Created workflow is inactive, version=1, and carries the spec rows."""
+    stages, transitions = _sample_specs()
