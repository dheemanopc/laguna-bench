+async def test_activate_sets_active_and_deactivates_prior(
+    pg_pool: Any,
+    tenant_a: UUID,
+    team_a: UUID,
+) -> None:
+    """Activating B flips the prior active A inactive and bumps version."""
+    stages, transitions = _sample_specs()
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        wf_a = await create_team_workflow(
+            conn, tenant_id=tenant_a, team_id=team_a, name="wf-a",
+            stages=stages, transitions=transitions, created_by=tenant_a,
+        )
+        await activate_workflow(
+            conn, tenant_id=tenant_a, team_id=team_a, workflow_id=wf_a.workflow_id,
+            actor_tenant_id=tenant_a,
+        )
+        wf_b = await create_team_workflow(
+            conn, tenant_id=tenant_a, team_id=team_a, name="wf-b",
+            stages=stages, transitions=transitions, created_by=tenant_a,
+        )
+
+    # Only one active per team (partial UNIQUE).
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        active = await conn.fetchval(
+            "SELECT workflow_id FROM team_workflows "
+            "WHERE team_id = $1 AND tenant_id = $2 AND is_active = TRUE",
+            team_a, tenant_a,
+        )
+    assert active == wf_a.workflow_id
+
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        wf_b_activated = await activate_workflow(
+            conn, tenant_id=tenant_a, team_id=team_a, workflow_id=wf_b.workflow_id,
+            actor_tenant_id=tenant_a,
+        )
+    assert wf_b_activated.is_active is True
+    assert wf_b_activated.version == 2  # created at v1; activation bumps to v2
+
+    # The prior active (A) is now inactive; B is the sole active.
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        rows = await conn.fetch(
+            "SELECT workflow_id, is_active FROM team_workflows "
+            "WHERE team_id = $1 AND tenant_id = $2 ORDER BY name",
+            team_a, tenant_a,
+        )
+        n_active = await conn.fetchval(
+            "SELECT COUNT(*) FROM team_workflows WHERE team_id = $1 AND tenant_id = $2 AND is_active",
+            team_a, tenant_a,
+        )
+    by_id = {r["workflow_id"]: bool(r["is_active"]) for r in rows}
+    assert by_id[wf_a.workflow_id] is False
+    assert by_id[wf_b.workflow_id] is True
+    assert n_active == 1
+
