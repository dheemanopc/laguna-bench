+async def test_create_stages_ordered_and_transitions_resolved(
+    pg_pool: Any,
+    tenant_a: UUID,
+    team_a: UUID,
+) -> None:
+    """Returned stages are ordinal-ordered; transitions carry resolved names."""
+    stages, transitions = _sample_specs()
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        wf = await create_team_workflow(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            name="ordered",
+            stages=stages,
+            transitions=transitions,
+            created_by=tenant_a,
+        )
+    ordinals = [s.ordinal for s in wf.stages]
+    assert ordinals == [1, 2, 3]
+    names = [s.name for s in wf.stages]
+    assert names == ["backlog", "in_progress", "done"]
+
+    by_pair = {(t.from_stage, t.to_stage): t for t in wf.transitions}
+    entry = by_pair[(None, "backlog")]
+    assert entry.requires_reason is False
+    signalled = by_pair[("in_progress", "backlog")]
+    assert signalled.requires_reason is True
+    # Entry transition has a NULL from_stage_id; resolved name is None.
+    assert entry.from_stage is None
+    assert entry.to_stage == "backlog"
+
