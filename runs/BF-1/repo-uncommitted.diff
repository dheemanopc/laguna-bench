+async def test_materialise_legacy_idempotent(
+    pg_pool: Any,
+    tenant_a: UUID,
+    team_a: UUID,
+) -> None:
+    """Repeated calls return the same workflow_id and don't duplicate stages."""
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        wid1 = await materialise_legacy_workflow(conn, tenant_id=tenant_a, team_id=team_a)
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        wid2 = await materialise_legacy_workflow(conn, tenant_id=tenant_a, team_id=team_a)
+    assert wid1 == wid2
+
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        n_wf = await conn.fetchval(
+            "SELECT COUNT(*) FROM team_workflows "
+            "WHERE team_id = $1 AND tenant_id = $2 AND name = '_legacy'",
+            team_a, tenant_a,
+        )
+        n_stages = await conn.fetchval(
+            "SELECT COUNT(*) FROM workflow_stages WHERE workflow_id = $1 AND tenant_id = $2",
+            wid1, tenant_a,
+        )
+        n_trans = await conn.fetchval(
+            "SELECT COUNT(*) FROM workflow_transitions WHERE workflow_id = $1 AND tenant_id = $2",
+            wid1, tenant_a,
+        )
+    assert n_wf == 1
+    assert n_stages == len(work_items.WORK_STATUSES)
+    assert n_trans == len(work_items.TRANSITIONS)
