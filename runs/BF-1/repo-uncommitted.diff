+async def _set_current_stage(
+    pg_pool: Any, tenant_id: UUID, team_id: UUID, node_id: UUID, stage: str | None
+) -> None:
+    async with tenant_tx(pg_pool, tenant_id) as conn:
+        await conn.execute(
+            "UPDATE work_items SET current_stage = $1, updated_at = now() "
+            "WHERE memory_id = $2 AND tenant_id = $3 AND team_id = $4",
+            stage, node_id, tenant_id, team_id,
+        )
+
+
+async def _read_current_stage(
+    pg_pool: Any, tenant_id: UUID, team_id: UUID, node_id: UUID
+) -> str | None:
+    async with tenant_tx(pg_pool, tenant_id) as conn:
+        return await conn.fetchval(
+            "SELECT current_stage FROM work_items "
+            "WHERE memory_id = $1 AND tenant_id = $2 AND team_id = $3",
+            node_id, tenant_id, team_id,
+        )
