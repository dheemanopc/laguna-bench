+async def test_activate_version_bumps_each_time(
+    pg_pool: Any,
+    tenant_a: UUID,
+    team_a: UUID,
+) -> None:
+    """Re-activating a workflow bumps its version each time it is activated."""
+    stages, transitions = _sample_specs()
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        wf_a = await create_team_workflow(
+            conn, tenant_id=tenant_a, team_id=team_a, name="v-a",
+            stages=stages, transitions=transitions, created_by=tenant_a,
+        )
+        await activate_workflow(
+            conn, tenant_id=tenant_a, team_id=team_a, workflow_id=wf_a.workflow_id,
+            actor_tenant_id=tenant_a,
+        )
+        # Deactivate A by activating B, then re-activate A.
+        wf_b = await create_team_workflow(
+            conn, tenant_id=tenant_a, team_id=team_a, name="v-b",
+            stages=stages, transitions=transitions, created_by=tenant_a,
+        )
+        await activate_workflow(
+            conn, tenant_id=tenant_a, team_id=team_a, workflow_id=wf_b.workflow_id,
+            actor_tenant_id=tenant_a,
+        )
+        await activate_workflow(
+            conn, tenant_id=tenant_a, team_id=team_a, workflow_id=wf_a.workflow_id,
+            actor_tenant_id=tenant_a,
+        )
+
+    # version starts at 1; A is activated twice (1->2, then 2->3).
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        version_a = await conn.fetchval(
+            "SELECT version FROM team_workflows WHERE workflow_id = $1 AND tenant_id = $2",
+            wf_a.workflow_id, tenant_a,
+        )
+    assert version_a == 3
+
