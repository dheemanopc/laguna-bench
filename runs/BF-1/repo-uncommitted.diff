+async def test_create_requires_team_write_memory(
+    pg_pool: Any,
+    tenant_a: UUID,
+    team_a: UUID,
+    viewer_tenant: UUID,
+) -> None:
+    """A viewer (no TEAM_WRITE_MEMORY) is denied and nothing is written."""
+    stages, transitions = _sample_specs()
+    with pytest.raises(WorkflowPermissionDeniedError) as exc_info:
+        async with tenant_tx(pg_pool, viewer_tenant) as conn:
+            await create_team_workflow(
+                conn,
+                tenant_id=viewer_tenant,
+                team_id=team_a,
+                name="viewer-wf",
+                stages=stages,
+                transitions=transitions,
+                created_by=viewer_tenant,
+            )
+    assert exc_info.value.permission is not None
+    assert exc_info.value.team_id == team_a
+
+    counts = await _count_workflow_rows(pg_pool, viewer_tenant, team_a)
+    assert counts == {"workflows": 0, "stages": 0, "transitions": 0}
+
