+"""DB-backed unit tests for ``mem_mcp.mindmap.workflow_crud``.
+
+Covers the WP1-T2 acceptance surface:
+* ``create_team_workflow`` — TEAM_WRITE_MEMORY gate, atomic insert of
+  team_workflows + stages + transitions, is_active=false / version=1;
+* ``activate_workflow`` — TEAM_WRITE_MEMORY gate, one-active-per-team, version bump;
+* ``get_workflow`` — active workflow (ordered stages/transitions) or named id;
+* ``materialise_legacy_workflow`` — idempotent ``_legacy`` workflow whose
+  stages/transitions mirror ``WORK_STATUSES`` / ``TRANSITIONS``;
+* ``remap_workflow_stages`` — TEAM_WRITE_MEMORY gate, bulk current_stage remap + count.
+
+Fixtures mirror ``tests/unit/test_work_items_service.py`` (UUID-suffixed tenants /
+teams). Every read of a tenant-scoped table runs inside ``tenant_tx`` because the
+RLS policies use ``safe_current_tenant_id()``.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.db import tenant_tx
+from mem_mcp.mindmap import work_items
+from mem_mcp.mindmap.workflow_crud import (
+    StageSpec,
+    TransitionSpec,
+    Workflow,
+    activate_workflow,
+    create_team_workflow,
+    get_workflow,
+    materialise_legacy_workflow,
+    remap_workflow_stages,
+)
+from mem_mcp.mindmap.workflow_errors import (
+    KindNotAllowedError,
+    StageNotFoundError,
+    WorkflowAlreadyActiveError,
+    WorkflowError,
+    WorkflowNotFoundError,
+    WorkflowPermissionDeniedError,
+)
+from mem_mcp.teams.assignments import assign_role
+
+pytestmark = pytest.mark.asyncio
+
+
+# ---------------------------------------------------------------------------
+# Fixtures
+# ---------------------------------------------------------------------------
+
+
<email>
+async def tenant_a(pg_pool: Any) -> UUID:
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            tid = await conn.fetchval(
+                "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                f"tenant-a-{uuid4()}@example.test",
+            )
+            return tid  # type: ignore[no-any-return]
+
+
<email>
+async def team_a(pg_pool: Any, tenant_a: UUID) -> UUID:
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            tid = await conn.fetchval(
+                "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+                f"team-a-{uuid4().hex[:8]}",
+                tenant_a,
+            )
+            await assign_role(
+                conn,
+                parent_team_id=tid,
+                member_kind="user",
+                member_id=tenant_a,
+                role_key="owner",
+                assigned_by_user_id=tenant_a,
+            )
+            return tid  # type: ignore[no-any-return]
+
+
<email>
+async def viewer_tenant(pg_pool: Any, tenant_a: UUID, team_a: UUID) -> UUID:
+    """A different tenant, member of team_a as a read-only 'viewer'."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            tid = await conn.fetchval(
+                "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                f"viewer-{uuid4()}@example.test",
+            )
+            await assign_role(
+                conn,
