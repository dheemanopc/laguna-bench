<email>
+async def stranger_tenant(pg_pool: Any) -> UUID:
+    """A tenant that is NOT a member of team_a at all."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            tid = await conn.fetchval(
