+# ---------------------------------------------------------------------------
+# Shared spec / helpers
+# ---------------------------------------------------------------------------
+
+
+def _sample_specs() -> tuple[list[StageSpec], list[TransitionSpec]]:
+    """A small three-stage workflow with a reason requirement on one edge."""
+    stages = [
+        StageSpec(name="backlog", is_initial=True),
+        StageSpec(name="in_progress"),
+        StageSpec(name="done", is_terminal=True),
+    ]
+    transitions = [
+        TransitionSpec(from_stage=None, to_stage="backlog"),
+        TransitionSpec(from_stage="backlog", to_stage="in_progress"),
+        TransitionSpec(from_stage="in_progress", to_stage="done"),
+        TransitionSpec(from_stage="in_progress", to_stage="backlog", requires_reason=True),
+    ]
+    return stages, transitions
+
+
+async def _count_workflow_rows(
+    pg_pool: Any, tenant_id: UUID, team_id: UUID
+) -> dict[str, int]:
+    """Count workflow/stage/transition rows for a team, as seen by ``tenant_id``."""
+    async with tenant_tx(pg_pool, tenant_id) as conn:
+        return {
+            "workflows": await conn.fetchval(
+                "SELECT COUNT(*) FROM team_workflows WHERE tenant_id = $1 AND team_id = $2",
+                tenant_id,
+                team_id,
+            ),
+            "stages": await conn.fetchval(
+                "SELECT COUNT(*) FROM workflow_stages ws "
+                "JOIN team_workflows tw ON tw.workflow_id = ws.workflow_id "
+                "WHERE tw.tenant_id = $1 AND tw.team_id = $2",
+                tenant_id,
+                team_id,
+            ),
+            "transitions": await conn.fetchval(
+                "SELECT COUNT(*) FROM workflow_transitions wt "
+                "JOIN team_workflows tw ON tw.workflow_id = wt.workflow_id "
+                "WHERE tw.tenant_id = $1 AND tw.team_id = $2",
+                tenant_id,
+                team_id,
+            ),
+        }
+
+
+async def _read_workflow_row(
+    pg_pool: Any, tenant_id: UUID, workflow_id: UUID
+) -> dict[str, Any] | None:
+    async with tenant_tx(pg_pool, tenant_id) as conn:
+        row = await conn.fetchrow(
+            "SELECT workflow_id, team_id, name, is_active, version, created_by "
+            "FROM team_workflows WHERE workflow_id = $1 AND tenant_id = $2",
+            workflow_id,
+            tenant_id,
+        )
+        return dict(row) if row else None
+
