+async def test_create_invalid_kind_raises(
+    pg_pool: Any,
+    tenant_a: UUID,
+    team_a: UUID,
+) -> None:
+    """allowed_kinds must be a subset of WORK_KINDS."""
+    stages = [StageSpec(name="s1", is_initial=True), StageSpec(name="s2")]
+    transitions = [
+        TransitionSpec(
+            from_stage=None,
+            to_stage="s2",
+            allowed_kinds=["story", "not-a-kind"],
+        )
+    ]
+    with pytest.raises(KindNotAllowedError) as exc_info:
+        async with tenant_tx(pg_pool, tenant_a) as conn:
+            await create_team_workflow(
+                conn,
+                tenant_id=tenant_a,
+                team_id=team_a,
+                name="bad-kind",
+                stages=stages,
+                transitions=transitions,
+                created_by=tenant_a,
+            )
+    assert exc_info.value.kind == "not-a-kind"
+    assert "story" in exc_info.value.allowed
+    # Validation happens before insert -> nothing persisted.
+    counts = await _count_workflow_rows(pg_pool, tenant_a, team_a)
+    assert counts == {"workflows": 0, "stages": 0, "transitions": 0}
+
