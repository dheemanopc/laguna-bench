+async def test_remap_updates_mapped_and_returns_count(
+    pg_pool: Any,
+    tenant_a: UUID,
+    team_a: UUID,
+    work_items_on_map: list[UUID],
+) -> None:
+    n0, n1, n2 = work_items_on_map
+    await _set_current_stage(pg_pool, tenant_a, team_a, n0, "todo")
+    await _set_current_stage(pg_pool, tenant_a, team_a, n1, "in_progress")
+    await _set_current_stage(pg_pool, tenant_a, team_a, n2, "done")
+
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        count = await remap_workflow_stages(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            mappings={"todo": "queued", "in_progress": "doing"},
+            actor_tenant_id=tenant_a,
+        )
+    assert count == 2
+    assert await _read_current_stage(pg_pool, tenant_a, team_a, n0) == "queued"
+    assert await _read_current_stage(pg_pool, tenant_a, team_a, n1) == "doing"
+    # n2 mapped from 'done' -> untouched.
+    assert await _read_current_stage(pg_pool, tenant_a, team_a, n2) == "done"
