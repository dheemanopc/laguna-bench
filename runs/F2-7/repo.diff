+def test_remap_is_not_swallowed_as_a_workflow_id() -> None:
+    """/workflow/remap must hit the remap handler, not activate("remap").
+
+    Route order is load-bearing here: FastAPI matches in declaration order, so
+    a /{workflow_id}/activate route declared first would capture "remap" silently
+    and the endpoint would 404 as a missing workflow.
+    """
+    client = _client()
+    remap_out = MagicMock()
+    remap_out.model_dump.return_value = {"updated_count": 0}
+    activate_out = MagicMock()
+    activate_out.model_dump.return_value = {"is_active": True}
+    remap_called = False
+
+    async def fake_remap(ctx: Any, inp: Any) -> Any:
+        nonlocal remap_called
+        remap_called = True
+        return remap_out
+
+    async def fake_activate(ctx: Any, inp: Any) -> Any:
+        return activate_out
+
+    with (
+        patch("mem_mcp.web.handlers.mindmaps.lookup_session", AsyncMock(return_value=_session())),
+        patch(f"{_MOD}.MindmapWorkflowRemapTool") as remap_tool,
+        patch(f"{_MOD}.MindmapWorkflowActivateTool") as activate_tool,
+    ):
+        remap_tool.return_value = fake_remap
+        activate_tool.return_value = fake_activate
+        res = client.post(
+            f"/api/web/teams/{TEAM}/workflow/remap",
+            cookies={"mem_session": "s"},
+            json={"mappings": {}},
