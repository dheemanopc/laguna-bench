@@ -0,0 +1,150 @@
+import { notFound } from "next/navigation";
+import { serverApiFetchResult } from "@/lib/server-api";
+import { BoardRefreshProvider } from "./BoardContext";
+import BoardView from "./BoardView";
+
+interface WorkflowStage {
+  stage_id: string;
+  name: string;
+  ordinal: number;
+  is_initial: boolean;
+  is_terminal: boolean;
+}
+
+interface WorkflowTransition {
+  from_stage: string | null;
+  to_stage: string;
+  requires_reason: boolean;
+  requires_signoff: boolean;
+  signoff_min: number;
+  signoff_roles: string[];
+  allowed_kinds: string[];
+}
+
+interface WorkflowOutput {
+  workflow_id: string;
+  name: string;
+  is_active: boolean;
+  version: number;
+  stages: WorkflowStage[];
+  transitions: WorkflowTransition[];
+}
+
+interface AllowedMove {
+  to_stage: string;
+  transition_id: string;
+  blocked_reason: string | null;
+  request_id: string | null;
+  signatory_count: number;
+  signoff_min: number;
+  remaining: number;
+  eligible_to_sign: boolean;
+}
+
+interface PendingSignoff {
+  request_id: string;
+  signatory_count: number;
+  signoff_min: number;
+  remaining: number;
+  eligible_to_sign: boolean;
+}
+
+interface WorkItem {
+  node_id: string;
+  map_key: string;
+  map_state: string;
+  kind: string;
+  status: string;
+  assignee_id: string | null;
+  title: string;
+  created_by: string;
+  created_at: string;
+  updated_at: string;
+  status_changed_at: string;
+  current_stage: string | null;
+  allowed_moves: AllowedMove[];
+  blocked_reason: string | null;
+  pending_signoff: PendingSignoff | null;
+}
+
+interface WorkItemListOutput {
+  team_id: string;
+  items: WorkItem[];
+}
+
+export const dynamic = "force-dynamic";
+
+export default async function BoardPage({
+  params,
+}: {
+  params: Promise<{ key: string }>;
+}) {
+  const { key } = await params;
+  const mapKey = decodeURIComponent(key);
+
+  // Fetch work items list
+  const workItemsResult = await serverApiFetchResult<WorkItemListOutput>(
+    `/api/web/mindmaps/${encodeURIComponent(mapKey)}/work-items`,
+    { redirectTo: "/login" },
+  );
+
+  if (!workItemsResult.ok) {
+    if (workItemsResult.status === 404) {
+      notFound();
+    }
+    notFound();
+  }
+
+  const workItemsData = workItemsResult.data;
+  if (!workItemsData) {
+    notFound();
+  }
+
+  const teamId = workItemsData.team_id;
+
+  // Fetch workflow
+  const workflowResult = await serverApiFetchResult<WorkflowOutput>(
+    `/api/web/teams/${encodeURIComponent(teamId)}/workflow`,
+    { redirectTo: "/login" },
+  );
+
+  if (!workflowResult.ok) {
+    notFound();
+  }
+
+  const workflowData = workflowResult.data;
+  if (!workflowData) {
+    notFound();
+  }
+
+  // Sort stages by ordinal
+  const sortedStages = [...workflowData.stages].sort(
+    (a, b) => a.ordinal - b.ordinal,
+  );
+
+  return (
+    <main className="mx-auto max-w-full px-4 py-6">
+      <nav className="mb-4">
+        <a
+          href={`/mindmaps/${key}`}
+          className="text-sm text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200"
+        >
+          ← Back to map
+        </a>
+      </nav>
+
+      <h1 className="mb-6 text-2xl font-bold text-slate-900 dark:text-slate-100">
+        Board
+      </h1>
+
+      <BoardRefreshProvider>
+        <BoardView
+          mapKey={mapKey}
+          items={workItemsData.items}
+          stages={sortedStages}
+          teamId={teamId}
+        />
+      </BoardRefreshProvider>
+    </main>
+  );
+}
