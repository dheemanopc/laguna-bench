+interface SignoffResponse {
+  status: "committed" | "awaiting_signoff";
+  request_id: string;
+  signoff_min?: number;
+  signatory_count?: number;
+  remaining?: number;
+}
+
+interface ErrorResponse {
+  code: string;
+  message: string;
+}
+
+export default function WaitingOnYou({
+  mapKey,
+  teamId,
+  items = [],
+}: WaitingOnYouProps) {
+  const { bumpRefresh, refreshKey } = useBoardRefresh();
+  const [isOpen, setIsOpen] = useState(true);
+  const [pendingSignoffs, setPendingSignoffs] = useState<PendingSignoffRow[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [signingRequestId, setSigningRequestId] = useState<string | null>(null);
+  const [signoffError, setSignoffError] = useState<ErrorResponse | null>(null);
+
+  // Local state for signoff counts that have been updated
+  const [updatedCounts, setUpdatedCounts] = useState<
+    Map<string, { signatory_count: number; remaining: number }>
+  >(new Map());
+
+  // Build items map from props
+  const itemsMap = new Map<string, WorkItem>();
+  items.forEach((item) => {
+    itemsMap.set(item.node_id, {
+      node_id: item.node_id,
+      title: item.title,
+    });
+  });
+
+  useEffect(() => {
+    const fetchSignoffs = async () => {
+      try {
+        setLoading(true);
+        setError(null);
+
+        // Fetch pending signoffs
+        const signoffsResponse = await csrfFetch(
+          `/api/web/teams/${encodeURIComponent(teamId)}/workflow/pending-signoffs`,
+        );
+
+        if (!signoffsResponse.ok) {
+          setError("Failed to load pending signoffs");
+          return;
+        }
+
+        const data = await signoffsResponse.json();
+        setPendingSignoffs(data.items || []);
+      } catch (err) {
+        setError("Error loading data");
+        console.error(err);
+      } finally {
+        setLoading(false);
+      }
+    };
+
+    fetchSignoffs();
+  }, [mapKey, teamId, refreshKey]);
+
+  const handleSign = async (signoff: PendingSignoffRow) => {
+    const nodeId = signoff.node_id || signoff.memory_id;
+    if (!nodeId) {
+      setSignoffError({
+        code: "invalid_signoff",
+        message: "Cannot sign: missing node_id",
+      });
+      return;
+    }
+
+    setSigningRequestId(signoff.request_id);
+    setSignoffError(null);
+
+    try {
+      const response = await csrfFetch(
+        `/api/web/mindmaps/${encodeURIComponent(mapKey)}/work-items/${nodeId}/signoff`,
+        {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({
+            request_id: signoff.request_id,
+          }),
+        },
+      );
+
+      if (!response.ok) {
+        const error = await response.json();
+        setSignoffError({
+          code: error.code || "error",
+          message: error.message || "Failed to sign",
+        });
+        return;
+      }
+
+      const result: SignoffResponse = await response.json();
+
+      if (result.status === "committed") {
+        // Remove from pending list and refresh the board
+        setPendingSignoffs(pendingSignoffs.filter((p) => p.request_id !== signoff.request_id));
+        bumpRefresh();
+      } else if (result.status === "awaiting_signoff") {
+        // Update the counts locally
+        const signatory_count = result.signatory_count ?? signoff.signatory_count;
+        const remaining = result.remaining ?? signoff.remaining;
+        setUpdatedCounts((prev) => {
+          const newCounts = new Map(prev);
+          newCounts.set(signoff.request_id, {
+            signatory_count,
+            remaining,
+          });
+          return newCounts;
+        });
+      }
+    } catch (err) {
+      setSignoffError({
+        code: "error",
+        message: "Network error",
+      });
+      console.error(err);
+    } finally {
+      setSigningRequestId(null);
+    }
+  };
+
+  const getEffectiveCounts = (signoff: PendingSignoffRow) => {
+    const updated = updatedCounts.get(signoff.request_id);
+    if (updated) {
+      return {
+        signatory_count: updated.signatory_count,
+        remaining: updated.remaining,
+      };
+    }
+    return {
+      signatory_count: signoff.signatory_count,
+      remaining: signoff.remaining,
+    };
+  };
+
+  const getTitleSnippet = (nodeId?: string): string => {
+    if (!nodeId) return "(Unknown)";
+    const item = itemsMap.get(nodeId);
+    if (!item) return "(Item not found)";
+    return item.title.length > 40
+      ? item.title.slice(0, 40) + "…"
+      : item.title;
+  };
+
+  if (loading) {
+    return (
+      <div className="mt-8 rounded-lg border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800">
+        <div className="text-sm text-slate-600 dark:text-slate-400">
+          Loading pending signoffs...
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <div className="mt-8 space-y-4">
+      <button
+        onClick={() => setIsOpen(!isOpen)}
+        className="flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 w-full text-left"
+      >
+        <span className={`transition-transform ${isOpen ? "rotate-90" : ""}`}>
+          ▶
+        </span>
+        <h2 className="text-lg font-semibold text-slate-900 dark:text-slate-100">
+          Waiting on you ({pendingSignoffs.length})
+        </h2>
+      </button>
+
+      {isOpen && (
+        <div className="rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900">
+          {error && (
+            <div className="border-b border-slate-200 bg-red-50 p-4 text-sm text-red-800 dark:border-slate-700 dark:bg-red-900/20 dark:text-red-200">
+              {error}
+            </div>
+          )}
+
+          {signoffError && (
+            <div className={`border-b border-slate-200 p-4 text-sm dark:border-slate-700 ${
+              signoffError.code === "signoff_complete"
+                ? "bg-amber-50 text-amber-800 dark:bg-amber-900/20 dark:text-amber-200"
+                : "bg-red-50 text-red-800 dark:bg-red-900/20 dark:text-red-200"
+            }`}>
+              {signoffError.message}
+            </div>
+          )}
+
+          {pendingSignoffs.length === 0 ? (
+            <div className="p-4 text-sm text-slate-600 dark:text-slate-400">
+              No pending signoffs
+            </div>
+          ) : (
+            <div className="divide-y divide-slate-200 dark:divide-slate-700">
+              {pendingSignoffs.map((signoff) => {
+                const nodeId = signoff.node_id || signoff.memory_id;
+                const counts = getEffectiveCounts(signoff);
+                const isAwaitingMore = counts.remaining > 0;
+                const isSigning = signingRequestId === signoff.request_id;
+
+                return (
+                  <div
+                    key={signoff.request_id}
+                    className="flex items-start justify-between gap-4 p-4"
+                  >
+                    <div className="flex-1 min-w-0">
+                      <div className="text-sm font-medium text-slate-900 dark:text-slate-100">
+                        {signoff.from_stage} → {signoff.to_stage}
+                      </div>
+                      <div className="mt-1 text-sm text-slate-600 dark:text-slate-400">
+                        {getTitleSnippet(nodeId)}
+                      </div>
+                      {signoff.reason && (
+                        <div className="mt-1 text-xs text-slate-500 dark:text-slate-500">
+                          Reason: {signoff.reason}
+                        </div>
+                      )}
+                      <div className="mt-2 text-xs text-slate-600 dark:text-slate-400">
+                        {counts.signatory_count} of {signoff.signoff_min} signed
+                        {isAwaitingMore && ` (${counts.remaining} remaining)`}
+                      </div>
+                    </div>
+
+                    <button
+                      onClick={() => handleSign(signoff)}
+                      disabled={isSigning}
+                      className="whitespace-nowrap rounded bg-blue-600 px-3 py-2 text-xs font-medium text-white hover:bg-blue-700 disabled:bg-gray-400 dark:bg-blue-700 dark:hover:bg-blue-600 dark:disabled:bg-gray-600"
+                    >
+                      {isSigning ? "Signing..." : "Sign"}
+                    </button>
+                  </div>
+                );
+              })}
+            </div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
