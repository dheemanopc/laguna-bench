+/**
+ * Workflow settings page — server component that fetches the active workflow
+ * and team members, then renders WorkflowSettingsClient for create/activate/remap.
+ */
+
+import { serverApiFetchResult } from "@/lib/server-api";
+import { notFound } from "next/navigation";
+import { WorkflowSettingsClient } from "./WorkflowSettingsClient";
+
+interface WorkflowResponse {
+  workflow_id: string;
+  team_id: string;
+  name: string;
+  is_active: boolean;
+  version: number;
+  created_by: string;
+  created_at: string;
+  stages: Array<{
+    stage_id: string;
+    name: string;
+    ordinal: number;
+    is_initial: boolean;
+    is_terminal: boolean;
+  }>;
+  transitions: Array<{
+    transition_id: string;
+    from_stage: string | null;
+    to_stage: string;
+    requires_reason: boolean;
+    requires_signoff: boolean;
+    signoff_min: number;
+    signoff_roles: string[] | null;
+    allowed_kinds: string[] | null;
+  }>;
+}
+
+interface MembersResponse {
+  members: Array<{
+    tenant_id: string;
+    role: string;
+    status: string;
+    added_at: string;
+    identity_email: string;
+    provider: string;
+  }>;
+  invites: Array<{
+    email: string;
+    role: string;
+    status: string;
+    invited_at: string;
+    invited_by_tenant_id: string;
+  }>;
+}
+
+export default async function WorkflowSettingsPage({
+  params,
+}: {
+  params: Promise<{ team_id: string }>;
+}) {
+  const { team_id } = await params;
+
+  const workflowResult = await serverApiFetchResult<WorkflowResponse>(
+    `/api/web/teams/${encodeURIComponent(team_id)}/workflow`,
+    { redirectTo: `/teams/${team_id}/workflow` }
+  );
+
+  const membersResult = await serverApiFetchResult<MembersResponse>(
+    `/api/web/teams/${encodeURIComponent(team_id)}/members`,
+    { redirectTo: `/teams/${team_id}/workflow` }
+  );
+
+  if (!workflowResult.ok || !membersResult.ok) {
+    notFound();
+  }
+
+  const workflow = workflowResult.data!;
+  const members = membersResult.data!;
+
+  // Extract unique role keys from team members
+  const roleKeys = Array.from(new Set(members.members.map((m) => m.role)));
+
+  return (
+    <main className="mx-auto max-w-4xl px-4 py-12">
+      <h1 className="text-3xl font-bold mb-8">Workflow Settings</h1>
+
+      <WorkflowSettingsClient
+        teamId={team_id}
+        activeWorkflow={workflow}
+        teamRoles={roleKeys}
+      />
+    </main>
+  );
+}
diff --git a/web/lib/csrf.ts b/web/lib/csrf.ts
index 48d9a01..4538b37 100644
--- a/web/lib/csrf.ts
+++ b/web/lib/csrf.ts
@@ -23,3 +23,32 @@ export function csrfHeaders(
   const token = getCsrfToken();
   return token ? { ...extra, "X-CSRF-Token": token } : extra;
 }
+
+export interface FetchOptions extends Omit<RequestInit, "headers"> {
+  headers?: Record<string, string>;
+}
+
+/**
+ * Client-side fetch helper that includes CSRF headers and handles 401 redirects.
+ * On 401, redirects to /auth/login?next=<current-pathname>.
+ */
+export async function csrfFetch(
+  url: string,
+  options: FetchOptions = {},
+): Promise<Response> {
+  const { headers: extraHeaders = {}, ...init } = options;
+
+  const res = await fetch(url, {
+    credentials: "same-origin",
+    ...init,
+    headers: csrfHeaders({ ...extraHeaders }),
+  });
+
+  if (res.status === 401) {
+    window.location.href = `/auth/login?next=${encodeURIComponent(
+      window.location.pathname,
+    )}`;
+  }
+
+  return res;
+}
