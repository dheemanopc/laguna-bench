+"""Shape-contract tests for workflow web UI HTTP endpoints.
+
+Tests the exact JSON response shapes that WP4 (the web UI) consumes from WP3
+(the HTTP API). Seeds data via raw asyncpg against the 0048 schema (not via MCP
+tools), so the dependency is the HTTP layer only.
+
+Verifies:
+- GET /mindmaps/{map_key}/work-items: items carry node_id, team_id, current_stage,
+  allowed_moves, blocked_reason, pending_signoff; top-level response has team_id
+- GET /teams/{team_id}/workflow: returns workflow_id, name, is_active, version,
+  stages[] ordered by ordinal, transitions[]
+- GET /teams/{team_id}/workflow/pending-signoffs: rows carry node_id, from_stage,
+  to_stage, reason, signoff_min, signatory_count, remaining
+"""
+
+from __future__ import annotations
+
+import hashlib
+import secrets
+from datetime import UTC, datetime, timedelta
+from typing import Any
+from uuid import UUID, uuid4
+
+import asyncpg
+import pytest
+from fastapi.testclient import TestClient
+
+
+async def _setup_workflow_test_data(
+    conn: asyncpg.Connection,
+) -> dict[str, Any]:
+    """Set up test team, workflow, map, and work items.
+
+    Returns a dict with:
+    - tenant_a, tenant_b: UUID
+    - team: UUID
+    - workflow_id: UUID
+    - map_key: str
+    - node_id_1, node_id_2: UUID (work items in different stages)
+    - client_id: str
+    """
+    # Create tenants
+    tenant_a = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"workflow-test-a-{uuid4()}@example.test",
+    )
+    tenant_b = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"workflow-test-b-{uuid4()}@example.test",
+    )
+
+    # Create team
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+        f"workflow-test-team-{uuid4().hex[:8]}",
+        tenant_a,
+    )
+
+    # Assign roles: tenant_a is owner, tenant_b is member
+    await conn.execute(
+        """
+        INSERT INTO team_role_assignments (parent_team_id, member_kind, member_id, role_id, status, assigned_by_user_id)
+        SELECT $1, 'user', $2, (SELECT id FROM roles_catalog WHERE role_key = 'owner' ORDER BY id LIMIT 1), 'active', $2
+        """,
+        team,
+        tenant_a,
+    )
+    await conn.execute(
+        """
+        INSERT INTO team_role_assignments (parent_team_id, member_kind, member_id, role_id, status, assigned_by_user_id)
+        SELECT $1, 'user', $2, (SELECT id FROM roles_catalog WHERE role_key = 'member' ORDER BY id LIMIT 1), 'active', $2
+        """,
+        team,
+        tenant_b,
+    )
+
+    # Create primary identities
+    identity_a = await conn.fetchval(
+        """
+        INSERT INTO tenant_identities
+            (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+        VALUES ($1, $2, 'cognito', $3, true, $4)
+        RETURNING id
+        """,
+        tenant_a,
+        f"sub-workflow-test-a-{tenant_a}",
+        f"workflow-test-a-{tenant_a}@example.test",
+        team,
+    )
+    identity_b = await conn.fetchval(
+        """
+        INSERT INTO tenant_identities
+            (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+        VALUES ($1, $2, 'cognito', $3, true, $4)
+        RETURNING id
+        """,
+        tenant_b,
+        f"sub-workflow-test-b-{tenant_b}",
+        f"workflow-test-b-{tenant_b}@example.test",
+        team,
+    )
+
+    # Create OAuth client
+    client_id = f"client:workflow-test-{uuid4().hex[:8]}"
+    await conn.execute(
+        """
+        INSERT INTO oauth_clients (id, redirect_uris, scope, registration_payload, review_status)
+        VALUES ($1, ARRAY[]::text[], 'memory.read memory.write', '{}'::jsonb, 'auto_allowed')
+        """,
+        client_id,
+    )
+
+    # Create the root memory node
+    root_node_id = await conn.fetchval(
+        """
+        INSERT INTO memories (tenant_id, team_id, type, content, content_hash,
+                            source_kind, visibility, embedding)
+        VALUES ($1, $2, 'question', 'Root question', 'hash1',
+                'api', 'team', array_fill(0::real, ARRAY[1024])::vector)
+        RETURNING id
+        """,
+        tenant_a,
+        team,
+    )
+
+    # Create a slug/map_key for the map
+    map_key = f"test-workflow-{uuid4().hex[:8]}"
+
+    # Create a memory map
