+"use client";
+
+import { useState } from "react";
+import { useRouter } from "next/navigation";
+import { csrfHeaders } from "@/lib/csrf";
+import { WorkflowEditor } from "./WorkflowEditor";
+
+const WORK_KINDS = ["story", "epic", "milestone"] as const;
+
+interface Stage {
+  name: string;
+  is_initial: boolean;
+  is_terminal: boolean;
+}
+
+interface Transition {
+  from_stage: string | null;
+  to_stage: string;
+  requires_reason: boolean;
+  requires_signoff: boolean;
+  signoff_min: number;
+  signoff_roles: string[];
+  allowed_kinds: string[];
+}
+
+interface WorkflowResponse {
+  workflow_id: string;
+  team_id: string;
+  name: string;
+  is_active: boolean;
+  version: number;
+  created_by: string;
+  created_at: string;
+  stages: Array<{
+    stage_id: string;
+    name: string;
+    ordinal: number;
+    is_initial: boolean;
+    is_terminal: boolean;
+  }>;
+  transitions: Array<{
+    transition_id: string;
+    from_stage: string | null;
+    to_stage: string;
+    requires_reason: boolean;
+    requires_signoff: boolean;
+    signoff_min: number;
+    signoff_roles: string[] | null;
+    allowed_kinds: string[] | null;
+  }>;
+}
+
+interface WorkflowSettingsClientProps {
+  teamId: string;
+  activeWorkflow: WorkflowResponse;
+  teamRoles: string[];
+}
+
+type Tab = "active" | "create" | "remap";
+
+export function WorkflowSettingsClient({
+  teamId,
+  activeWorkflow,
+  teamRoles,
+}: WorkflowSettingsClientProps) {
+  const router = useRouter();
+  const [activeTab, setActiveTab] = useState<Tab>("active");
+
+  // Create tab state
+  const [createName, setCreateName] = useState("");
+  const [createStages, setCreateStages] = useState<Stage[]>([]);
+  const [createTransitions, setCreateTransitions] = useState<Transition[]>([]);
+  const [createStatus, setCreateStatus] = useState<
+    "idle" | "saving" | "success" | "error"
+  >("idle");
+  const [createError, setCreateError] = useState("");
+  const [createdWorkflowId, setCreatedWorkflowId] = useState<string | null>(null);
+
+  // Remap tab state
+  const [remapMappings, setRemapMappings] = useState<Record<string, string>>({});
+  const [remapStatus, setRemapStatus] = useState<
+    "idle" | "saving" | "success" | "error"
+  >("idle");
+  const [remapError, setRemapError] = useState("");
+  const [remapToastMessage, setRemapToastMessage] = useState("");
+
+  // Activate state
+  const [activateStatus, setActivateStatus] = useState<
+    "idle" | "saving" | "error"
+  >("idle");
+  const [activateError, setActivateError] = useState("");
+
+  async function handleCreateWorkflow() {
+    setCreateStatus("saving");
+    setCreateError("");
+
+    try {
+      // Build request body with ordinals inferred from position
+      const stagesWithOrdinals = createStages.map((stage, index) => ({
+        ...stage,
+        ordinal: index,
+      }));
+
+      const res = await fetch(
+        `/api/web/teams/${encodeURIComponent(teamId)}/workflow`,
+        {
+          method: "POST",
+          headers: csrfHeaders({ "Content-Type": "application/json" }),
+          body: JSON.stringify({
+            name: createName,
+            stages: stagesWithOrdinals,
+            transitions: createTransitions,
+          }),
+          credentials: "same-origin",
+        }
+      );
+
+      if (res.ok) {
+        const data = (await res.json()) as WorkflowResponse;
+        setCreatedWorkflowId(data.workflow_id);
+        setCreateStatus("success");
+        setCreateName("");
+        setCreateStages([]);
+        setCreateTransitions([]);
+        setTimeout(() => setCreateStatus("idle"), 3000);
+      } else if (res.status === 422) {
+        const body = (await res.json().catch(() => ({}))) as {
+          detail?: Array<{ loc?: string[]; msg?: string }> | string;
+        };
+        setCreateStatus("error");
+        setCreateError(
+          body.detail
+            ? Array.isArray(body.detail)
+              ? body.detail
+                  .map((e) => {
+                    const loc = Array.isArray(e.loc) ? e.loc.join(".") : "Field";
+                    return `${loc}: ${e.msg || "validation error"}`;
+                  })
+                  .join("; ")
+              : body.detail
+            : "Validation error"
+        );
+      } else {
+        const body = await res.json().catch(() => ({}));
+        setCreateStatus("error");
+        setCreateError(body.message || `Failed (HTTP ${res.status})`);
+      }
+    } catch (err) {
+      setCreateStatus("error");
+      setCreateError(err instanceof Error ? err.message : "Unknown error");
+    }
+  }
+
+  async function handleActivateWorkflow(workflowId: string) {
+    setActivateStatus("saving");
+    setActivateError("");
+
+    try {
+      const res = await fetch(
+        `/api/web/teams/${encodeURIComponent(teamId)}/workflow/${encodeURIComponent(
+          workflowId
+        )}/activate`,
+        {
+          method: "POST",
+          headers: csrfHeaders({ "Content-Type": "application/json" }),
+          credentials: "same-origin",
+        }
+      );
+
+      if (res.ok) {
+        setActivateStatus("idle");
+        router.refresh();
+      } else {
+        const body = await res.json().catch(() => ({}));
+        setActivateStatus("error");
+        setActivateError(body.message || `Failed (HTTP ${res.status})`);
+      }
+    } catch (err) {
+      setActivateStatus("error");
+      setActivateError(err instanceof Error ? err.message : "Unknown error");
+    }
+  }
+
+  async function handleRemapWorkflow() {
+    setRemapStatus("saving");
+    setRemapError("");
+    setRemapToastMessage("");
+
+    try {
+      const res = await fetch(
+        `/api/web/teams/${encodeURIComponent(teamId)}/workflow/remap`,
+        {
+          method: "POST",
+          headers: csrfHeaders({ "Content-Type": "application/json" }),
+          body: JSON.stringify({ mappings: remapMappings }),
+          credentials: "same-origin",
+        }
+      );
+
+      if (res.ok) {
+        const data = (await res.json()) as { updated_count: number };
+        setRemapStatus("success");
+        setRemapToastMessage(`Updated ${data.updated_count} item(s)`);
+        setRemapMappings({});
+        router.refresh();
+        setTimeout(() => setRemapStatus("idle"), 3000);
+      } else {
+        const body = await res.json().catch(() => ({}));
+        setRemapStatus("error");
+        setRemapError(body.message || `Failed (HTTP ${res.status})`);
+      }
+    } catch (err) {
+      setRemapStatus("error");
+      setRemapError(err instanceof Error ? err.message : "Unknown error");
+    }
+  }
+
+  const stageNames = activeWorkflow.stages
+    .sort((a, b) => a.ordinal - b.ordinal)
+    .map((s) => s.name);
+
+  return (
+    <div className="space-y-6">
+      {/* Tabs */}
+      <div className="flex border-b">
+        <button
+          onClick={() => setActiveTab("active")}
+          className={`px-4 py-2 font-medium border-b-2 ${
+            activeTab === "active"
+              ? "border-blue-600 text-blue-600"
+              : "border-transparent text-gray-600 hover:text-gray-900"
+          }`}
+        >
+          Active Workflow
+        </button>
+        <button
+          onClick={() => setActiveTab("create")}
+          className={`px-4 py-2 font-medium border-b-2 ${
+            activeTab === "create"
+              ? "border-blue-600 text-blue-600"
+              : "border-transparent text-gray-600 hover:text-gray-900"
+          }`}
+        >
+          Create New
+        </button>
+        <button
+          onClick={() => setActiveTab("remap")}
+          className={`px-4 py-2 font-medium border-b-2 ${
+            activeTab === "remap"
+              ? "border-blue-600 text-blue-600"
+              : "border-transparent text-gray-600 hover:text-gray-900"
+          }`}
+        >
+          Remap Stages
+        </button>
+      </div>
+
+      {/* Active Workflow Tab */}
+      {activeTab === "active" && (
+        <section className="space-y-6 border border-gray-300 rounded p-6">
+          <div>
+            <h2 className="text-2xl font-semibold mb-2">{activeWorkflow.name}</h2>
+            <p className="text-sm text-gray-600">
+              {activeWorkflow.is_active ? (
+                <span className="text-green-700 font-medium">Active</span>
+              ) : (
+                <span className="text-gray-700">Inactive</span>
+              )}
+              {" • "}Version {activeWorkflow.version}
+            </p>
+          </div>
+
+          {/* Stages */}
+          <div>
+            <h3 className="text-lg font-semibold mb-3">Stages</h3>
+            <div className="space-y-2">
+              {activeWorkflow.stages
+                .slice()
+                .sort((a, b) => a.ordinal - b.ordinal)
+                .map((stage) => (
+                  <div
+                    key={stage.stage_id}
+                    className="flex items-center gap-3 p-3 bg-gray-50 rounded"
+                  >
+                    <span className="font-mono text-sm text-gray-500 w-8">
+                      #{stage.ordinal + 1}
+                    </span>
+                    <span className="font-medium flex-1">{stage.name}</span>
+                    {stage.is_initial && (
+                      <span className="text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded">
+                        Initial
+                      </span>
+                    )}
+                    {stage.is_terminal && (
+                      <span className="text-xs bg-purple-100 text-purple-800 px-2 py-1 rounded">
+                        Terminal
+                      </span>
+                    )}
+                  </div>
+                ))}
+            </div>
+          </div>
+
+          {/* Transitions */}
+          <div>
+            <h3 className="text-lg font-semibold mb-3">Transitions</h3>
+            <div className="overflow-x-auto">
+              <table className="w-full text-sm border-collapse">
+                <thead>
+                  <tr className="bg-gray-50">
+                    <th className="border border-gray-300 p-3 text-left font-semibold">
+                      From
+                    </th>
+                    <th className="border border-gray-300 p-3 text-left font-semibold">
+                      To
+                    </th>
+                    <th className="border border-gray-300 p-3 text-left font-semibold">
+                      Reason
+                    </th>
+                    <th className="border border-gray-300 p-3 text-left font-semibold">
+                      Sign-off
+                    </th>
+                    <th className="border border-gray-300 p-3 text-left font-semibold">
+                      Min
+                    </th>
+                    <th className="border border-gray-300 p-3 text-left font-semibold">
+                      Roles
+                    </th>
+                    <th className="border border-gray-300 p-3 text-left font-semibold">
+                      Kinds
+                    </th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {activeWorkflow.transitions.map((trans) => (
+                    <tr key={trans.transition_id} className="hover:bg-gray-50">
+                      <td className="border border-gray-300 p-3">
+                        {trans.from_stage || "any"}
+                      </td>
+                      <td className="border border-gray-300 p-3">
+                        {trans.to_stage}
+                      </td>
+                      <td className="border border-gray-300 p-3">
+                        {trans.requires_reason ? "✓" : "–"}
+                      </td>
+                      <td className="border border-gray-300 p-3">
+                        {trans.requires_signoff ? "✓" : "–"}
+                      </td>
+                      <td className="border border-gray-300 p-3">
+                        {trans.requires_signoff ? trans.signoff_min : "–"}
+                      </td>
+                      <td className="border border-gray-300 p-3 text-xs">
+                        {trans.signoff_roles && trans.signoff_roles.length > 0
+                          ? trans.signoff_roles.join(", ")
+                          : "–"}
+                      </td>
+                      <td className="border border-gray-300 p-3 text-xs">
+                        {trans.allowed_kinds && trans.allowed_kinds.length > 0
+                          ? trans.allowed_kinds.join(", ")
+                          : "–"}
+                      </td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </div>
+          </div>
+        </section>
+      )}
+
+      {/* Create New Workflow Tab */}
+      {activeTab === "create" && (
+        <section className="space-y-6 border border-gray-300 rounded p-6">
+          <div>
+            <label htmlFor="create_name" className="block text-sm font-medium mb-2">
+              Workflow name
+            </label>
+            <input
+              id="create_name"
+              type="text"
+              value={createName}
+              onChange={(e) => setCreateName(e.target.value)}
+              placeholder="e.g., Development Process"
+              disabled={createStatus === "saving"}
+              className="w-full border rounded px-3 py-2"
+            />
+          </div>
+
+          <WorkflowEditor
+            stages={createStages.map((s) => s.name)}
+            teamRoles={teamRoles}
+            workKinds={WORK_KINDS}
+            onStagesChange={setCreateStages}
+            onTransitionsChange={setCreateTransitions}
+          />
+
+          <div className="flex gap-2">
+            <button
+              onClick={handleCreateWorkflow}
+              disabled={
+                !createName.trim() ||
+                createStages.length === 0 ||
+                createStatus === "saving"
+              }
+              className="bg-blue-600 text-white rounded px-4 py-2 disabled:opacity-50 hover:bg-blue-700"
+            >
+              {createStatus === "saving" ? "Creating…" : "Create Workflow"}
+            </button>
+          </div>
+
+          {createStatus === "success" && createdWorkflowId && (
+            <div className="space-y-3 p-4 bg-green-50 border border-green-300 rounded">
+              <p className="text-green-700 font-medium">Workflow created successfully!</p>
+              <button
+                onClick={() => handleActivateWorkflow(createdWorkflowId)}
+                disabled={activateStatus === "saving"}
+                className="bg-green-600 text-white rounded px-4 py-2 disabled:opacity-50 hover:bg-green-700"
+              >
+                {activateStatus === "saving"
+                  ? "Activating…"
+                  : "Activate Workflow"}
+              </button>
+              {activateError && (
+                <p className="text-red-700 text-sm">{activateError}</p>
+              )}
+            </div>
+          )}
+
+          {createStatus === "error" && (
+            <p className="text-red-700 text-sm p-3 bg-red-50 border border-red-300 rounded">
+              {createError}
+            </p>
+          )}
+        </section>
+      )}
+
+      {/* Remap Stages Tab */}
+      {activeTab === "remap" && (
+        <section className="space-y-6 border border-gray-300 rounded p-6">
+          <div>
+            <p className="text-sm text-gray-600 mb-4">
+              Map old stage names to new stage names. Items with unmapped stages
+              will be flagged on the board.
+            </p>
+
+            <div className="space-y-3">
+              {stageNames.map((stageName) => (
+                <div key={stageName} className="flex gap-3 items-center">
+                  <label className="text-sm font-medium w-32 text-right">
+                    {stageName}
+                  </label>
+                  <span className="text-gray-400">→</span>
+                  <input
+                    type="text"
+                    value={remapMappings[stageName] ?? ""}
+                    onChange={(e) =>
+                      setRemapMappings({
+                        ...remapMappings,
+                        [stageName]: e.target.value,
+                      })
+                    }
+                    placeholder="New stage name (or leave blank)"
+                    disabled={remapStatus === "saving"}
+                    className="flex-1 border rounded px-3 py-2 text-sm"
+                  />
+                </div>
+              ))}
+            </div>
+          </div>
+
+          <div className="flex gap-2">
+            <button
+              onClick={handleRemapWorkflow}
+              disabled={
+                Object.values(remapMappings).every((v) => !v) ||
+                remapStatus === "saving"
+              }
+              className="bg-blue-600 text-white rounded px-4 py-2 disabled:opacity-50 hover:bg-blue-700"
+            >
+              {remapStatus === "saving" ? "Remapping…" : "Apply Remap"}
+            </button>
+          </div>
+
+          {remapStatus === "success" && remapToastMessage && (
+            <p className="text-green-700 text-sm p-3 bg-green-50 border border-green-300 rounded">
+              {remapToastMessage}
+            </p>
+          )}
+
+          {remapStatus === "error" && (
+            <p className="text-red-700 text-sm p-3 bg-red-50 border border-red-300 rounded">
+              {remapError}
+            </p>
+          )}
+        </section>
+      )}
+    </div>
+  );
+}
