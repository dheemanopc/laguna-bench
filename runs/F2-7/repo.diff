@@ -0,0 +1,342 @@
+"use client";
+
+import { useState, useCallback } from "react";
+
+type Stage = {
+  name: string;
+  is_initial: boolean;
+  is_terminal: boolean;
+};
+
+type Transition = {
+  from_stage: string;
+  to_stage: string;
+  requires_reason: boolean;
+  requires_signoff: boolean;
+  signoff_min: number;
+  signoff_roles: string[];
+  allowed_kinds: string[];
+};
+
+interface WorkflowEditorProps {
+  stages: string[];
+  teamRoles: string[];
+  workKinds: readonly string[];
+  onStagesChange: (stages: Stage[]) => void;
+  onTransitionsChange: (transitions: Transition[]) => void;
+}
+
+export function WorkflowEditor({
+  stages: initialStages,
+  teamRoles,
+  workKinds,
+  onStagesChange,
+  onTransitionsChange,
+}: WorkflowEditorProps) {
+  const [stages, setStages] = useState<Stage[]>(
+    initialStages.map((name) => ({
+      name,
+      is_initial: false,
+      is_terminal: false,
+    }))
+  );
+
+  const [transitions, setTransitions] = useState<Transition[]>([]);
+
+  const updateStages = useCallback(
+    (newStages: Stage[]) => {
+      setStages(newStages);
+      onStagesChange(newStages);
+    },
+    [onStagesChange]
+  );
+
+  const updateTransitions = useCallback(
+    (newTransitions: Transition[]) => {
+      setTransitions(newTransitions);
+      onTransitionsChange(newTransitions);
+    },
+    [onTransitionsChange]
+  );
+
+  const addStage = () => {
+    const newStage: Stage = {
+      name: "",
+      is_initial: false,
+      is_terminal: false,
+    };
+    updateStages([...stages, newStage]);
+  };
+
+  const removeStage = (index: number) => {
+    updateStages(stages.filter((_, i) => i !== index));
+  };
+
+  const updateStage = (index: number, updates: Partial<Stage>) => {
+    const newStages = [...stages];
+    newStages[index] = { ...newStages[index], ...updates };
+    updateStages(newStages);
+  };
+
+  const addTransition = () => {
+    const newTransition: Transition = {
+      from_stage: "any",
+      to_stage: "",
+      requires_reason: false,
+      requires_signoff: false,
+      signoff_min: 1,
+      signoff_roles: [],
+      allowed_kinds: [],
+    };
+    updateTransitions([...transitions, newTransition]);
+  };
+
+  const removeTransition = (index: number) => {
+    updateTransitions(transitions.filter((_, i) => i !== index));
+  };
+
+  const updateTransition = (index: number, updates: Partial<Transition>) => {
+    const newTransitions = [...transitions];
+    newTransitions[index] = { ...newTransitions[index], ...updates };
+    updateTransitions(newTransitions);
+  };
+
+  const toggleRoleInTransition = (
+    transitionIndex: number,
+    role: string
+  ) => {
+    const transition = transitions[transitionIndex];
+    const roles = transition.signoff_roles;
+    const newRoles = roles.includes(role)
+      ? roles.filter((r) => r !== role)
+      : [...roles, role];
+    updateTransition(transitionIndex, { signoff_roles: newRoles });
+  };
+
+  const toggleKindInTransition = (
+    transitionIndex: number,
+    kind: string
+  ) => {
+    const transition = transitions[transitionIndex];
+    const kinds = transition.allowed_kinds;
+    const newKinds = kinds.includes(kind)
+      ? kinds.filter((k) => k !== kind)
+      : [...kinds, kind];
+    updateTransition(transitionIndex, { allowed_kinds: newKinds });
+  };
+
+  return (
+    <div className="space-y-6">
+      {/* Stages section */}
+      <div>
+        <h3 className="text-lg font-semibold mb-4">Stages</h3>
+        <div className="space-y-3">
+          {stages.map((stage, index) => (
+            <div key={index} className="flex gap-3 items-center p-3 border rounded">
+              <input
+                type="text"
+                value={stage.name}
+                onChange={(e) => updateStage(index, { name: e.target.value })}
+                placeholder="Stage name"
+                className="flex-1 border rounded px-3 py-2 text-sm"
+              />
+              <span className="text-xs text-gray-500 w-12 text-right">
+                #{index + 1}
+              </span>
+              <label className="flex items-center gap-2 text-sm">
+                <input
+                  type="checkbox"
+                  checked={stage.is_initial}
+                  onChange={(e) =>
+                    updateStage(index, { is_initial: e.target.checked })
+                  }
+                />
+                Initial
+              </label>
+              <label className="flex items-center gap-2 text-sm">
+                <input
+                  type="checkbox"
+                  checked={stage.is_terminal}
+                  onChange={(e) =>
+                    updateStage(index, { is_terminal: e.target.checked })
+                  }
+                />
+                Terminal
+              </label>
+              <button
+                onClick={() => removeStage(index)}
+                className="px-3 py-2 text-sm border border-red-300 text-red-600 rounded hover:bg-red-50"
+              >
+                Remove
+              </button>
+            </div>
+          ))}
+        </div>
+        <button
+          onClick={addStage}
+          className="mt-3 px-4 py-2 text-sm bg-blue-600 text-white rounded hover:bg-blue-700"
+        >
+          Add Stage
+        </button>
+      </div>
+
+      {/* Transitions section */}
+      <div>
+        <h3 className="text-lg font-semibold mb-4">Transitions</h3>
+        <div className="space-y-4">
+          {transitions.map((transition, index) => (
+            <div
+              key={index}
+              className="p-4 border rounded space-y-3"
+            >
+              <div className="grid grid-cols-2 gap-3">
+                <div>
+                  <label className="block text-xs font-medium text-gray-700 mb-1">
+                    From Stage
+                  </label>
+                  <select
+                    value={transition.from_stage}
+                    onChange={(e) =>
+                      updateTransition(index, { from_stage: e.target.value })
+                    }
+                    className="w-full border rounded px-3 py-2 text-sm"
+                  >
+                    <option value="any">any</option>
+                    {stages.map((stage, i) => (
+                      <option key={i} value={stage.name}>
+                        {stage.name || `(unnamed ${i + 1})`}
+                      </option>
+                    ))}
+                  </select>
+                </div>
+                <div>
+                  <label className="block text-xs font-medium text-gray-700 mb-1">
+                    To Stage
+                  </label>
+                  <select
+                    value={transition.to_stage}
+                    onChange={(e) =>
+                      updateTransition(index, { to_stage: e.target.value })
+                    }
+                    className="w-full border rounded px-3 py-2 text-sm"
+                  >
+                    <option value="">-- Select stage --</option>
+                    {stages.map((stage, i) => (
+                      <option key={i} value={stage.name}>
+                        {stage.name || `(unnamed ${i + 1})`}
+                      </option>
+                    ))}
+                  </select>
+                </div>
+              </div>
+
+              <div className="space-y-2">
+                <label className="flex items-center gap-2 text-sm">
+                  <input
+                    type="checkbox"
+                    checked={transition.requires_reason}
+                    onChange={(e) =>
+                      updateTransition(index, {
+                        requires_reason: e.target.checked,
+                      })
+                    }
+                  />
+                  Requires reason
+                </label>
+                <label className="flex items-center gap-2 text-sm">
+                  <input
+                    type="checkbox"
+                    checked={transition.requires_signoff}
+                    onChange={(e) =>
+                      updateTransition(index, {
+                        requires_signoff: e.target.checked,
+                      })
+                    }
+                  />
+                  Requires sign-off
+                </label>
+              </div>
+
+              {transition.requires_signoff && (
+                <>
+                  <div>
+                    <label className="block text-xs font-medium text-gray-700 mb-1">
+                      Min sign-offs required
+                    </label>
+                    <input
+                      type="number"
+                      min="1"
+                      value={transition.signoff_min}
+                      onChange={(e) =>
+                        updateTransition(index, {
+                          signoff_min: Math.max(
+                            1,
+                            parseInt(e.target.value, 10) || 1
+                          ),
+                        })
+                      }
+                      className="w-full border rounded px-3 py-2 text-sm"
+                    />
+                  </div>
+
+                  <div>
+                    <label className="block text-xs font-medium text-gray-700 mb-2">
+                      Allowed signoff roles
+                    </label>
+                    <div className="space-y-1">
+                      {teamRoles.map((role) => (
+                        <label key={role} className="flex items-center gap-2 text-sm">
+                          <input
+                            type="checkbox"
+                            checked={transition.signoff_roles.includes(role)}
+                            onChange={() =>
+                              toggleRoleInTransition(index, role)
+                            }
+                          />
+                          {role}
+                        </label>
+                      ))}
+                    </div>
+                  </div>
+                </>
+              )}
+
+              <div>
+                <label className="block text-xs font-medium text-gray-700 mb-2">
+                  Allowed work kinds
+                </label>
+                <div className="space-y-1">
+                  {workKinds.map((kind) => (
+                    <label key={kind} className="flex items-center gap-2 text-sm">
+                      <input
+                        type="checkbox"
+                        checked={transition.allowed_kinds.includes(kind)}
+                        onChange={() =>
+                          toggleKindInTransition(index, kind)
+                        }
+                      />
+                      {kind}
+                    </label>
+                  ))}
+                </div>
+              </div>
+
+              <button
+                onClick={() => removeTransition(index)}
+                className="px-3 py-2 text-sm border border-red-300 text-red-600 rounded hover:bg-red-50"
+              >
+                Remove transition
+              </button>
+            </div>
+          ))}
+        </div>
+        <button
+          onClick={addTransition}
+          className="mt-3 px-4 py-2 text-sm bg-blue-600 text-white rounded hover:bg-blue-700"
+        >
+          Add Transition
+        </button>
+      </div>
+    </div>
+  );
+}
