+async def test_get_workflow_returns_ordered_stages(pg_pool: asyncpg.Pool, tenant_a: UUID, team_a: UUID) -> None:
+    """Get returns active workflow with stages ordered by ordinal + transitions."""
+    stages = [
+        {"name": "done", "ordinal": 2, "is_initial": False, "is_terminal": True},
+        {"name": "todo", "ordinal": 0, "is_initial": True, "is_terminal": False},
+        {"name": "in_progress", "ordinal": 1, "is_initial": False, "is_terminal": False},
+    ]
+    transitions = [
+        {"from_stage": "todo", "to_stage": "in_progress"},
+        {"from_stage": "in_progress", "to_stage": "done"},
+    ]
+
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        wf = await create_team_workflow(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            name="test-flow",
+            stages=stages,
+            transitions=transitions,
+            created_by=tenant_a,
+        )
+        await activate_workflow(
+            conn, tenant_id=tenant_a, team_id=team_a, workflow_id=wf.workflow_id, actor_tenant_id=tenant_a
+        )
+
+        # Get active workflow
+        active = await get_workflow(conn, tenant_id=tenant_a, team_id=team_a, workflow_id=None)
+
+        # Stages must be ordered by ordinal
+        assert [s.name for s in active.stages] == ["todo", "in_progress", "done"]
+        assert [s.ordinal for s in active.stages] == [0, 1, 2]
+        # Transitions present
