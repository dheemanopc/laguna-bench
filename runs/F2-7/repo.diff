+"use client";
+
+import { useRouter } from "next/navigation";
+import { useEffect, useState } from "react";
+import ItemDetail from "./ItemDetail";
+import WaitingOnYou from "./WaitingOnYou";
+import { useBoardRefresh } from "./BoardContext";
+
+interface AllowedMove {
+  to_stage: string;
+  transition_id: string;
+  blocked_reason: string | null;
+  request_id: string | null;
+  signatory_count: number;
+  signoff_min: number;
+  remaining: number;
+  eligible_to_sign: boolean;
+}
+
+interface PendingSignoff {
+  request_id: string;
+  signatory_count: number;
+  signoff_min: number;
+  remaining: number;
+  eligible_to_sign: boolean;
+}
+
+interface WorkItem {
+  node_id: string;
+  map_key: string;
+  map_state: string;
+  kind: string;
+  status: string;
+  assignee_id: string | null;
+  title: string;
+  created_by: string;
+  created_at: string;
+  updated_at: string;
+  status_changed_at: string;
+  current_stage: string | null;
+  allowed_moves: AllowedMove[];
+  blocked_reason: string | null;
+  pending_signoff: PendingSignoff | null;
+}
+
+interface WorkflowStage {
+  stage_id: string;
+  name: string;
+  ordinal: number;
+  is_initial: boolean;
+  is_terminal: boolean;
+}
+
+const WORK_STATUSES: Record<string, string> = {
+  todo: "To Do",
+  in_progress: "In Progress",
+  blocked: "Blocked",
+  done: "Done",
+  cancelled: "Cancelled",
+};
+
+const STATUS_COLORS: Record<string, string> = {
+  todo: "bg-slate-100 text-slate-800 dark:bg-slate-700 dark:text-slate-100",
+  in_progress:
+    "bg-blue-100 text-blue-800 dark:bg-blue-700 dark:text-blue-100",
+  blocked: "bg-red-100 text-red-800 dark:bg-red-700 dark:text-red-100",
+  done: "bg-green-100 text-green-800 dark:bg-green-700 dark:text-green-100",
+  cancelled:
+    "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-100",
+};
+
+function truncateTitle(title: string, maxLength: number = 50): string {
+  return title.length > maxLength ? `${title.slice(0, maxLength)}…` : title;
+}
+
+function getBlockedBadgeText(
+  item: WorkItem
+): { text: string; title: string } | null {
+  if (item.pending_signoff) {
+    const { signoff_min, remaining } = item.pending_signoff;
+    return {
+      text: `awaiting ${remaining} of ${signoff_min}`,
+      title: `Waiting for ${remaining} more signature${remaining !== 1 ? "s" : ""}`,
+    };
+  }
+
+  if (item.blocked_reason === "reason_required") {
+    return {
+      text: "needs reason",
+      title: "This move requires a reason",
+    };
+  }
+  if (item.blocked_reason === "role_restricted") {
+    return {
+      text: "role-restricted",
+      title: "You do not have the required role for this move",
+    };
+  }
+  if (item.blocked_reason === "no_transition") {
+    return {
+      text: "no moves",
+      title: "No transitions available from current stage",
+    };
+  }
+
+  return null;
+}
+
+interface ColumnProps {
+  stage: WorkflowStage;
+  items: WorkItem[];
+  onSelectMove: (nodeId: string, toStage: string) => void;
+}
+
+function Column({ stage, items, onSelectMove }: ColumnProps) {
+  return (
+    <div className="flex min-w-[320px] flex-col gap-3 rounded-lg border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800">
+      <h3 className="text-sm font-semibold text-slate-900 dark:text-slate-100">
+        {stage.name}
+      </h3>
+      <div className="flex flex-col gap-2">
+        {items.map((item) => (
+          <div
+            key={item.node_id}
+            className="rounded border border-slate-300 bg-white p-3 dark:border-slate-600 dark:bg-slate-900"
+          >
+            <div className="mb-2 flex items-start justify-between">
+              <h4 className="flex-1 text-sm font-medium text-slate-900 dark:text-slate-100">
+                {truncateTitle(item.title)}
+              </h4>
+            </div>
+
+            <div className="mb-2 flex items-center gap-2">
+              <span
+                className={`inline-block rounded px-2 py-1 text-xs font-medium ${
+                  STATUS_COLORS[item.status] || STATUS_COLORS.todo
+                }`}
+              >
+                {WORK_STATUSES[item.status] || item.status}
+              </span>
+              {item.current_stage && (
+                <span className="text-xs text-slate-600 dark:text-slate-400">
+                  {item.current_stage}
+                </span>
+              )}
+            </div>
+
+            {getBlockedBadgeText(item) && (
+              <div className="mb-2">
+                <span
+                  title={getBlockedBadgeText(item)?.title}
+                  className="inline-block rounded bg-amber-100 px-2 py-1 text-xs font-medium text-amber-800 dark:bg-amber-900 dark:text-amber-100 cursor-help"
+                >
+                  {getBlockedBadgeText(item)?.text}
+                </span>
+              </div>
+            )}
+
+            {item.allowed_moves.length > 0 && (
+              <div className="mt-2">
+                <select
+                  value=""
+                  onChange={(e) => {
+                    if (e.target.value) {
+                      onSelectMove(item.node_id, e.target.value);
+                    }
+                  }}
+                  className="w-full rounded border border-slate-300 bg-white px-2 py-1 text-xs dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100"
+                >
+                  <option value="">Move to…</option>
+                  {item.allowed_moves.map((move) => (
+                    <option key={move.transition_id} value={move.to_stage}>
+                      {move.to_stage}
+                    </option>
+                  ))}
+                </select>
+              </div>
+            )}
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+}
+
+interface BoardViewProps {
+  mapKey: string;
+  items: WorkItem[];
+  stages: WorkflowStage[];
+  teamId: string;
+}
+
+export default function BoardView({ mapKey, items, stages, teamId }: BoardViewProps) {
+  const router = useRouter();
+  const { refreshKey } = useBoardRefresh();
+  const [selectedItem, setSelectedItem] = useState<{
+    nodeId: string;
+    toStage: string;
+  } | null>(null);
+
+  // Refresh page when refresh key changes (bumped by ItemDetail/WaitingOnYou after writes)
+  useEffect(() => {
+    router.refresh();
+  }, [refreshKey, router]);
+
+  // Group items by current_stage
+  const itemsByStage = new Map<string | null, WorkItem[]>();
+
+  // Initialize all stages
+  stages.forEach((stage) => {
+    itemsByStage.set(stage.name, []);
+  });
+  itemsByStage.set(null, []); // unmapped column
+
+  // Group items
+  items.forEach((item) => {
+    const stage = item.current_stage;
+    if (
+      stage === null ||
+      !stages.some((s) => s.name === stage)
+    ) {
+      // Unmapped
+      const unmapped = itemsByStage.get(null) || [];
+      unmapped.push(item);
+      itemsByStage.set(null, unmapped);
+    } else {
+      const stageItems = itemsByStage.get(stage) || [];
+      stageItems.push(item);
+      itemsByStage.set(stage, stageItems);
+    }
+  });
+
+  const handleSelectMove = (nodeId: string, toStage: string) => {
+    setSelectedItem({ nodeId, toStage });
+  };
+
+  return (
+    <div className="space-y-6">
+      <div className="flex overflow-x-auto gap-4 pb-4">
+        {stages.map((stage) => (
+          <Column
+            key={stage.stage_id}
+            stage={stage}
+            items={itemsByStage.get(stage.name) || []}
+            onSelectMove={handleSelectMove}
+          />
+        ))}
+
+        {(itemsByStage.get(null) || []).length > 0 && (
+          <Column
+            stage={{
+              stage_id: "unmapped",
+              name: "Unmapped",
+              ordinal: -1,
+              is_initial: false,
+              is_terminal: false,
+            }}
+            items={itemsByStage.get(null) || []}
+            onSelectMove={handleSelectMove}
+          />
+        )}
+      </div>
+
+      {selectedItem && (
+        <ItemDetail
+          mapKey={mapKey}
+          nodeId={selectedItem.nodeId}
+          toStage={selectedItem.toStage}
+          onClose={() => setSelectedItem(null)}
+        />
+      )}
+
+      <WaitingOnYou
+        mapKey={mapKey}
+        teamId={teamId}
+        items={items.map((item) => ({ node_id: item.node_id, title: item.title }))}
+      />
+    </div>
+  );
+}
