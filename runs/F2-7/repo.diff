+                {item.current_stage && (
+                  <span className="text-xs text-slate-600 dark:text-slate-400">
+                    Stage: {item.current_stage}
+                  </span>
+                )}
+              </div>
+            </div>
+            <button
+              onClick={onClose}
+              className="text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200"
