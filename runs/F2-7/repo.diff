+    captured: dict[str, Any] = {}
+
+    async def fake_call(ctx: Any, inp: Any) -> Any:
+        captured["map_key"] = inp.map_key
+        captured["status"] = inp.status
+        captured["kind"] = inp.kind
+        captured["assignee_id"] = inp.assignee_id
+        captured["unassigned"] = inp.unassigned
+        captured["map_state"] = inp.map_state
+        captured["limit"] = inp.limit
