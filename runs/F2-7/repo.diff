+def test_activate_workflow_delegates_to_activate_tool() -> None:
+    """POST /teams/{team_id}/workflow/{workflow_id}/activate delegates to MindmapWorkflowActivateTool."""
+    client = _client()
+    workflow_id = uuid4()
+    out = MagicMock()
+    out.model_dump.return_value = {"workflow_id": str(workflow_id), "is_active": True}
+    captured: dict[str, Any] = {}
