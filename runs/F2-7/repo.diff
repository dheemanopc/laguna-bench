+"""Web surface over the workflow tools — auth, routing, and error translation.
+
+The router deliberately holds no lifecycle logic: it resolves a session into a
+ToolContext and delegates to the same MCP tools. These tests pin that contract,
+because the moment the web path grows its own rules it will drift from the MCP
+path — which is exactly how the two provisioning paths diverged and left two
+users unable to log in.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from unittest.mock import AsyncMock, MagicMock, patch
+from uuid import uuid4
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.web.handlers.workflows import make_workflows_router
+
+_MOD = "mem_mcp.web.handlers.workflows"
+TENANT = uuid4()
+TEAM = uuid4()
+
+
+def _client() -> TestClient:
+    app = FastAPI()
+    app.include_router(make_workflows_router(pool=MagicMock(), deps=MagicMock()))
+    return TestClient(app)
+
+
+def _session() -> Any:
+    sess = MagicMock()
+    sess.tenant_id = TENANT
+    sess.identity_id = TENANT
+    return sess
+
+
+# --------------------------------------------------------------------------
+# Auth
+# --------------------------------------------------------------------------
+
+
<email>(
+    "method,path",
+    [
+        ("get", f"/api/web/teams/{TEAM}/workflow"),
+        ("post", f"/api/web/teams/{TEAM}/workflow"),
+        ("post", f"/api/web/teams/{TEAM}/workflow/{uuid4()}/activate"),
+        ("post", f"/api/web/teams/{TEAM}/workflow/remap"),
+        ("get", f"/api/web/teams/{TEAM}/workflow/pending-signoffs"),
+    ],
+)
+def test_every_endpoint_requires_a_session(method: str, path: str) -> None:
+    """No endpoint may be reachable without a session cookie."""
+    client = _client()
+    # POST bodies must be VALID here: FastAPI validates the body before the
+    # handler runs, so an invalid one returns 422 and would mask whether auth is
+    # enforced at all. (That ordering is framework behaviour and leaks nothing —
+    # no handler runs and no data is returned either way.)
+    bodies = {
+        f"/api/web/teams/{TEAM}/workflow": {
+            "name": "test-workflow",
+            "stages": [{"name": "todo", "ordinal": 0, "is_initial": True}],
+            "transitions": [],
+        },
+        f"/api/web/teams/{TEAM}/workflow/remap": {"mappings": {}},
+    }
+    kwargs: dict[str, Any] = {"json": bodies[path]} if method == "post" and path in bodies else {}
+    res = getattr(client, method)(path, **kwargs)
+    assert res.status_code == 401, f"{method.upper()} {path} did not require auth"
+
+
+def test_invalid_session_is_rejected() -> None:
+    client = _client()
+    # lookup_session is called from mindmaps._ctx_from_session, so patch there
+    with patch("mem_mcp.web.handlers.mindmaps.lookup_session", AsyncMock(return_value=None)):
+        res = client.get(f"/api/web/teams/{TEAM}/workflow", cookies={"mem_session": "bogus"})
+    assert res.status_code == 401
+
+
+# --------------------------------------------------------------------------
+# Routing & delegation
+# --------------------------------------------------------------------------
+
+
+def test_get_workflow_delegates_to_get_tool() -> None:
+    """GET /teams/{team_id}/workflow delegates to MindmapWorkflowGetTool."""
+    client = _client()
+    out = MagicMock()
+    out.model_dump.return_value = {"workflow_id": str(uuid4()), "team_id": str(TEAM)}
+    captured: dict[str, Any] = {}
+
+    async def fake_call(ctx: Any, inp: Any) -> Any:
+        captured["team_id"] = inp.team_id
+        captured["workflow_id"] = inp.workflow_id
+        return out
+
+    with (
+        patch("mem_mcp.web.handlers.mindmaps.lookup_session", AsyncMock(return_value=_session())),
+        patch(f"{_MOD}.MindmapWorkflowGetTool") as get_tool,
+    ):
+        get_tool.return_value = fake_call
+        res = client.get(f"/api/web/teams/{TEAM}/workflow", cookies={"mem_session": "s"})
+
+    assert res.status_code == 200
+    assert captured["team_id"] == TEAM
+    assert captured["workflow_id"] is None
+
+
+def test_create_workflow_delegates_to_create_tool() -> None:
+    """POST /teams/{team_id}/workflow delegates to MindmapWorkflowCreateTool."""
+    client = _client()
+    out = MagicMock()
+    out.model_dump.return_value = {"workflow_id": str(uuid4())}
+    captured: dict[str, Any] = {}
+
+    async def fake_call(ctx: Any, inp: Any) -> Any:
+        captured["team_id"] = inp.team_id
+        captured["name"] = inp.name
+        captured["stages"] = len(inp.stages)
+        captured["transitions"] = len(inp.transitions)
+        return out
+
+    with (
+        patch("mem_mcp.web.handlers.mindmaps.lookup_session", AsyncMock(return_value=_session())),
+        patch(f"{_MOD}.MindmapWorkflowCreateTool") as create_tool,
+    ):
+        create_tool.return_value = fake_call
+        res = client.post(
+            f"/api/web/teams/{TEAM}/workflow",
+            cookies={"mem_session": "s"},
+            json={
+                "name": "Test Workflow",
+                "stages": [
+                    {"name": "todo", "ordinal": 0, "is_initial": True},
+                    {"name": "done", "ordinal": 1, "is_terminal": True},
+                ],
+                "transitions": [
+                    {"from_stage": "todo", "to_stage": "done"},
+                ],
+            },
+        )
+
+    assert res.status_code == 200
+    assert captured["team_id"] == TEAM
+    assert captured["name"] == "Test Workflow"
+    assert captured["stages"] == 2
+    assert captured["transitions"] == 1
+
