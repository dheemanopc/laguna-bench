+async def _create_session(conn: asyncpg.Connection, tenant_id: UUID, identity_id: UUID) -> str:
+    """Create a web_sessions row and return the session cookie (the raw session, not the hash)."""
+    session_raw = secrets.token_urlsafe(32)
+    session_hash = hashlib.sha256(session_raw.encode()).hexdigest()
+    expires_at = datetime.now(tz=UTC) + timedelta(days=7)
+
+    await conn.execute(
+        """
+        INSERT INTO web_sessions (session_hash, tenant_id, identity_id, expires_at)
+        VALUES ($1, $2, $3, $4)
+        """,
+        session_hash,
+        tenant_id,
+        identity_id,
+        expires_at,
+    )
+
+    return session_raw
+
