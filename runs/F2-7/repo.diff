+
+              {/* Confirm Dialog */}
+              {showConfirm && requiresSignoff && (
+                <div className="rounded-lg border border-blue-300 bg-blue-50 p-3 dark:border-blue-900 dark:bg-blue-900/20">
+                  <div className="text-sm font-medium text-blue-900 dark:text-blue-100">
+                    This move requires {selectedMove?.signoff_min} sign-off
+                    {selectedMove?.signoff_min !== 1 ? "s" : ""} before it will be
+                    completed.
+                  </div>
+                  <div className="mt-3 flex gap-2">
+                    <button
+                      onClick={handleMove}
+                      disabled={isMoving}
+                      className="flex-1 rounded bg-blue-600 px-3 py-2 text-xs font-medium text-white hover:bg-blue-700 disabled:bg-gray-400 dark:bg-blue-700 dark:hover:bg-blue-600 dark:disabled:bg-gray-600"
+                    >
+                      {isMoving ? "Requesting..." : "Request"}
+                    </button>
+                    <button
+                      onClick={() => {
+                        setShowConfirm(false);
+                        setSelectedStage(undefined);
+                      }}
+                      disabled={isMoving}
+                      className="flex-1 rounded bg-slate-300 px-3 py-2 text-xs font-medium text-slate-900 hover:bg-slate-400 dark:bg-slate-600 dark:text-slate-100 dark:hover:bg-slate-500"
+                    >
+                      Cancel
+                    </button>
+                  </div>
+                </div>
+              )}
+
+              {/* Direct Move Button */}
+              {!requiresSignoff && canMove && !showConfirm && (
+                <button
+                  onClick={handleMove}
+                  disabled={!canMove || isMoving}
+                  className="w-full rounded bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-700 disabled:bg-gray-400 dark:bg-blue-700 dark:hover:bg-blue-600 dark:disabled:bg-gray-600"
+                >
+                  {isMoving ? "Moving..." : "Move"}
+                </button>
+              )}
+            </div>
+          )}
+
+          {/* Signoff Panel */}
+          {item.pending_signoff && (moveResult?.status === "awaiting_signoff" || !moveResult) && (
+            <div className="rounded-lg border border-blue-200 bg-blue-50 p-3 dark:border-blue-900 dark:bg-blue-900/20">
+              <div className="text-sm font-medium text-blue-900 dark:text-blue-100">
+                Awaiting sign-off
+              </div>
+              <div className="mt-1 text-xs text-blue-800 dark:text-blue-200">
+                {item.pending_signoff.signatory_count} of{" "}
+                {item.pending_signoff.signoff_min} signed
+                {item.pending_signoff.remaining > 0 &&
+                  ` (${item.pending_signoff.remaining} remaining)`}
+              </div>
+              {item.pending_signoff.eligible_to_sign && (
+                <button
+                  onClick={handleSignoff}
+                  disabled={isSigning}
+                  className="mt-3 w-full rounded bg-blue-600 px-3 py-2 text-xs font-medium text-white hover:bg-blue-700 disabled:bg-gray-400 dark:bg-blue-700 dark:hover:bg-blue-600 dark:disabled:bg-gray-600"
+                >
+                  {isSigning ? "Signing..." : "Sign"}
+                </button>
+              )}
+            </div>
+          )}
+
+          {/* History */}
+          {history.length > 0 && (
+            <div className="space-y-2">
+              <div className="text-sm font-medium text-slate-900 dark:text-slate-100">
+                History
+              </div>
+              <div className="space-y-2">
+                {history.map((event, i) => (
+                  <div
+                    key={i}
+                    className="rounded border border-slate-200 bg-slate-50 p-2 text-xs dark:border-slate-700 dark:bg-slate-800"
+                  >
+                    <div className="font-medium text-slate-900 dark:text-slate-100">
+                      {event.change_type}
+                    </div>
+                    {event.stage_before && event.stage_after && (
+                      <div className="text-slate-600 dark:text-slate-400">
+                        {event.stage_before} → {event.stage_after}
+                      </div>
+                    )}
+                    <div className="text-slate-500 dark:text-slate-500">
+                      {new Date(event.created_at).toLocaleString()}
+                    </div>
+                  </div>
+                ))}
+              </div>
+            </div>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
