+async def test_workflow_change_preserves_item_workflow_id(
+    pg_pool: asyncpg.Pool, tenant_a: UUID, team_a: UUID
+) -> None:
+    """After activating a new workflow, items keep their old workflow_id and stage."""
+    item_id: UUID
+    wf1_id: UUID
+    wf2_id: UUID
+
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        # Create first workflow and activate
+        wf1 = await create_team_workflow(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            name="flow-1",
+            stages=[
+                {"name": "todo", "ordinal": 0, "is_initial": True},
+                {"name": "done", "ordinal": 1, "is_terminal": True},
+            ],
+            transitions=[{"from_stage": "todo", "to_stage": "done"}],
+            created_by=tenant_a,
+        )
+        wf1_id = wf1.workflow_id
+        await activate_workflow(
+            conn, tenant_id=tenant_a, team_id=team_a, workflow_id=wf1_id, actor_tenant_id=tenant_a
+        )
+
+        # Create item and explicitly set its workflow_id to wf1
+        item_id = await _create_work_item(conn, tenant_a, team_a, "todo")
+        await conn.execute(
+            "UPDATE work_items SET workflow_id = $1 WHERE memory_id = $2",
+            wf1_id,
+            item_id,
+        )
+
+        # Create second workflow and activate it
+        wf2 = await create_team_workflow(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            name="flow-2",
+            stages=[
+                {"name": "start", "ordinal": 0, "is_initial": True},
+                {"name": "finish", "ordinal": 1, "is_terminal": True},
+            ],
+            transitions=[],
+            created_by=tenant_a,
+        )
+        wf2_id = wf2.workflow_id
+        await activate_workflow(
+            conn, tenant_id=tenant_a, team_id=team_a, workflow_id=wf2_id, actor_tenant_id=tenant_a
+        )
+
+        # Item should still have its original workflow_id and stage
+        item_row = await conn.fetchrow(
+            "SELECT workflow_id, current_stage FROM work_items WHERE memory_id = $1",
+            item_id,
+        )
+        assert item_row["workflow_id"] == wf1_id
