+"use client";
+
+import { createContext, useContext, useState, ReactNode } from "react";
+
+export const boardRefreshKey = "board-refresh-key";
+
+interface BoardContextType {
+  refreshKey: number;
+  bumpRefresh: () => void;
+}
+
+const BoardContext = createContext<BoardContextType | undefined>(undefined);
+
+export function BoardRefreshProvider({ children }: { children: ReactNode }) {
+  const [refreshKey, setRefreshKey] = useState(0);
+
+  const bumpRefresh = () => {
+    setRefreshKey((prev) => prev + 1);
+  };
+
+  return (
+    <BoardContext.Provider value={{ refreshKey, bumpRefresh }}>
+      {children}
+    </BoardContext.Provider>
+  );
+}
+
+export function useBoardRefresh(): BoardContextType {
+  const context = useContext(BoardContext);
+  if (!context) {
+    throw new Error("useBoardRefresh must be used within BoardRefreshProvider");
+  }
+  return context;
+}
