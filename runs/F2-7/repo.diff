+async def test_remap_workflow_stages_updates_mapped_stages(
+    pg_pool: asyncpg.Pool, tenant_a: UUID, team_a: UUID
+) -> None:
+    """Remap updates current_stage for mapped stage names + returns updated_count."""
+    item_ids = []
+
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            # Create items with different stages
+            item_ids.append(await _create_work_item(conn, tenant_a, team_a, "old_stage"))
+            item_ids.append(await _create_work_item(conn, tenant_a, team_a, "old_stage"))
+            item_ids.append(await _create_work_item(conn, tenant_a, team_a, "other_stage"))
+
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        count = await remap_workflow_stages(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            mappings={"old_stage": "new_stage"},
+            actor_tenant_id=tenant_a,
+        )
+
+        assert count == 2
+
+        # Verify mapped items
+        for item_id in item_ids[:2]:
+            stage = await conn.fetchval(
+                "SELECT current_stage FROM work_items WHERE memory_id = $1",
+                item_id,
+            )
+            assert stage == "new_stage"
+
+        # Verify unmapped item kept old stage
+        unmapped_stage = await conn.fetchval(
+            "SELECT current_stage FROM work_items WHERE memory_id = $1",
+            item_ids[2],
+        )
+        assert unmapped_stage == "other_stage"
