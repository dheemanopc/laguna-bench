+            </button>
+          </div>
+        </div>
+
+        {/* Content */}
+        <div className="space-y-4 p-4">
+          {/* Error Banner */}
+          {error && (
+            <div className="rounded-lg border border-red-300 bg-red-50 p-3 text-sm dark:border-red-900 dark:bg-red-900/20">
