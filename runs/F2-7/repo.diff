+async def _verify_signoff_request_belongs_to_node(
+    pool: asyncpg.Pool, tenant_id: UUID, request_id: UUID, map_key: str, node_id: UUID
+) -> bool:
+    """Verify a signoff request belongs to the specified node in the specified map.
+
+    Returns True if the request belongs to the node; raises HTTPException(404) if not.
+    The request_id itself is the source of truth (from a previous propose_move).
+    Just verify it exists for this tenant and hasn't been signed yet.
+    """
+    conn = await pool.acquire()
+    try:
+        # Verify request exists for this tenant and get the work item ID
+        request_node_id = await conn.fetchval(
+            """
+            SELECT work_item_memory_id
+            FROM workflow_signoff_requests
+            WHERE request_id = $1 AND tenant_id = $2 AND status = 'pending'
+            """,
+            request_id,
+            tenant_id,
+        )
+        if request_node_id is None:
+            raise HTTPException(status_code=404, detail="signoff request not found")
+
+        # Verify the work item matches the endpoint node_id
+        if request_node_id != node_id:
+            raise HTTPException(status_code=404, detail="signoff request not found")
+
+        # Verify the work item belongs to the specified map
+        item_map_key = await conn.fetchval(
+            """
+            SELECT s.slug
+            FROM work_items w
+            LEFT JOIN slugs s ON s.memory_id = w.root_memory_id AND s.team_id = w.team_id AND s.resource_type = 'map'
+            WHERE w.memory_id = $1 AND w.tenant_id = $2
+            """,
+            request_node_id,
+            tenant_id,
+        )
+        if item_map_key != map_key:
+            raise HTTPException(status_code=404, detail="signoff request not found")
+
+        return True
+    finally:
+        await pool.release(conn)
+
+
