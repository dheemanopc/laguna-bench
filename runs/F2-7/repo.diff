+"""Team workflows router — web surface over the workflow tools.
+
+Delegates to the WP2 workflow tools via ToolContext from the session cookie,
+reusing the same error translation and session-to-context bridge as mindmaps.py.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID
+
+from fastapi import APIRouter, Cookie
+from pydantic import BaseModel, Field
+
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._deps import ToolDeps
+from mem_mcp.mcp.tools.mindmap_workflow_activate import (
+    MindmapWorkflowActivateInput,
+    MindmapWorkflowActivateTool,
+)
+from mem_mcp.mcp.tools.mindmap_workflow_create import (
+    MindmapWorkflowCreateInput,
+    MindmapWorkflowCreateTool,
+    WorkflowStageInput,
+    WorkflowTransitionInput,
+)
+from mem_mcp.mcp.tools.mindmap_workflow_get import (
+    MindmapWorkflowGetInput,
+    MindmapWorkflowGetTool,
+)
+from mem_mcp.mcp.tools.mindmap_workflow_pending_signoffs import (
+    MindmapWorkflowPendingSignoffsInput,
+    MindmapWorkflowPendingSignoffsTool,
+)
+from mem_mcp.mcp.tools.mindmap_workflow_remap import (
+    MindmapWorkflowRemapInput,
+    MindmapWorkflowRemapTool,
+)
+from mem_mcp.mindmap.work_items import Pool
+from mem_mcp.web.handlers.mindmaps import (
+    _READ,
+    _WRITE,
+    _ctx_from_session,
+    _http_from_jsonrpc,
+)
+
+
+class WorkflowCreateBody(BaseModel):
+    """Request body for creating a workflow."""
+
+    name: str = Field(..., min_length=1, max_length=256)
+    stages: list[WorkflowStageInput] = Field(..., min_length=1, max_length=100)
+    transitions: list[WorkflowTransitionInput] = Field(..., max_length=500)
+
+
+class WorkflowRemapBody(BaseModel):
+    """Request body for remapping workflow stages."""
+
+    mappings: dict[str, str] = Field(..., description="Mapping of old stage names to new stage names")
+
+
+def make_workflows_router(*, pool: Pool, deps: ToolDeps) -> APIRouter:
+    """Factory for the /api/web/teams/{team_id}/workflow router."""
+    router = APIRouter()
+
+    @router.get("/api/web/teams/{team_id}/workflow")
+    async def get_workflow(
+        team_id: UUID,
+        mem_session: str | None = Cookie(default=None),
+    ) -> Any:
+        """Get the active workflow for a team."""
+        ctx = await _ctx_from_session(pool, mem_session, deps, scopes=_READ)
+        try:
+            out = await MindmapWorkflowGetTool()(
+                ctx,
+                MindmapWorkflowGetInput(team_id=team_id),
+            )
+        except JsonRpcError as exc:
+            raise _http_from_jsonrpc(exc) from exc
+        return out.model_dump(mode="json")
+
+    @router.post("/api/web/teams/{team_id}/workflow")
+    async def create_workflow(
+        team_id: UUID,
+        body: WorkflowCreateBody,
+        mem_session: str | None = Cookie(default=None),
+    ) -> Any:
+        """Create a new workflow for a team."""
+        ctx = await _ctx_from_session(pool, mem_session, deps, scopes=_WRITE)
+        try:
+            out = await MindmapWorkflowCreateTool()(
+                ctx,
+                MindmapWorkflowCreateInput(
+                    name=body.name,
+                    stages=body.stages,
+                    transitions=body.transitions,
+                    team_id=team_id,
+                ),
+            )
+        except JsonRpcError as exc:
+            raise _http_from_jsonrpc(exc) from exc
+        return out.model_dump(mode="json")
+
+    @router.post("/api/web/teams/{team_id}/workflow/remap")
+    async def remap_workflow(
+        team_id: UUID,
+        body: WorkflowRemapBody,
+        mem_session: str | None = Cookie(default=None),
+    ) -> Any:
+        """Remap workflow stage names when activating a new workflow.
+
+        Registered before /{workflow_id}/activate so "remap" is not swallowed as a workflow_id.
+        """
+        ctx = await _ctx_from_session(pool, mem_session, deps, scopes=_WRITE)
+        try:
+            out = await MindmapWorkflowRemapTool()(
+                ctx,
+                MindmapWorkflowRemapInput(
+                    # map_key="*" signals remap applies team-wide to all maps under this workflow
+                    map_key="*",
+                    mappings=body.mappings,
+                    team_id=team_id,
+                ),
+            )
+        except JsonRpcError as exc:
+            raise _http_from_jsonrpc(exc) from exc
+        return out.model_dump(mode="json")
+
+    @router.get("/api/web/teams/{team_id}/workflow/pending-signoffs")
+    async def get_pending_signoffs(
+        team_id: UUID,
+        mem_session: str | None = Cookie(default=None),
+    ) -> Any:
+        """Get pending workflow signoff requests waiting for the caller.
+
+        Registered before /{workflow_id}/activate so "pending-signoffs" is not swallowed as a workflow_id.
+        """
+        ctx = await _ctx_from_session(pool, mem_session, deps, scopes=_READ)
+        try:
+            out = await MindmapWorkflowPendingSignoffsTool()(
+                ctx,
+                MindmapWorkflowPendingSignoffsInput(team_id=team_id),
+            )
+        except JsonRpcError as exc:
+            raise _http_from_jsonrpc(exc) from exc
+        return out.model_dump(mode="json")
+
+    @router.post("/api/web/teams/{team_id}/workflow/{workflow_id}/activate")
+    async def activate_workflow(
+        team_id: UUID,
+        workflow_id: UUID,
+        mem_session: str | None = Cookie(default=None),
+    ) -> Any:
+        """Activate a workflow for a team."""
+        ctx = await _ctx_from_session(pool, mem_session, deps, scopes=_WRITE)
+        try:
+            out = await MindmapWorkflowActivateTool()(
+                ctx,
+                MindmapWorkflowActivateInput(
+                    workflow_id=workflow_id,
+                    team_id=team_id,
+                ),
+            )
+        except JsonRpcError as exc:
+            raise _http_from_jsonrpc(exc) from exc
+        return out.model_dump(mode="json")
+
+    return router
