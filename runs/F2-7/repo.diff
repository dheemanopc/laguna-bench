+"""Web surface over the work item tools — auth, routing, and error translation.
+
+Like test_web_mindmaps_router.py, these tests pin that the web surface delegates
+to the same MCP tools with no independent logic.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from unittest.mock import AsyncMock, MagicMock, patch
+from uuid import uuid4
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.web.handlers.mindmaps import make_mindmaps_router
+
+_MOD = "mem_mcp.web.handlers.mindmaps"
+TENANT = uuid4()
+MAP_KEY = "test-map"
+NODE_ID = uuid4()
+REQUEST_ID = uuid4()
+
+
+def _client() -> TestClient:
+    app = FastAPI()
+    app.include_router(make_mindmaps_router(pool=MagicMock(), deps=MagicMock()))
+    return TestClient(app)
+
+
+def _session() -> Any:
+    sess = MagicMock()
+    sess.tenant_id = TENANT
+    sess.identity_id = TENANT
+    return sess
+
+
+# --------------------------------------------------------------------------
+# Auth
+# --------------------------------------------------------------------------
+
+
<email>(
+    "method,path,body",
+    [
+        ("get", f"/api/web/mindmaps/{MAP_KEY}/work-items", None),
+        ("get", f"/api/web/mindmaps/{MAP_KEY}/work-items/{NODE_ID}", None),
+        ("get", f"/api/web/mindmaps/{MAP_KEY}/work-items/{NODE_ID}/history", None),
+        ("post", f"/api/web/mindmaps/{MAP_KEY}/work-items/{NODE_ID}/move", {"to_stage": "done"}),
+        ("post", f"/api/web/mindmaps/{MAP_KEY}/work-items/{NODE_ID}/signoff", {"request_id": str(REQUEST_ID)}),
+    ],
+)
+def test_work_items_endpoints_require_session(method: str, path: str, body: dict[str, Any] | None) -> None:
+    """All work item endpoints require a session cookie."""
+    client = _client()
+    kwargs: dict[str, Any] = {"json": body} if body is not None else {}
+    res = getattr(client, method)(path, **kwargs)
+    assert res.status_code == 401, f"{method.upper()} {path} did not require auth"
+
+
+def test_invalid_session_rejected_for_work_items() -> None:
+    client = _client()
+    with patch(f"{_MOD}.lookup_session", AsyncMock(return_value=None)):
+        res = client.get(f"/api/web/mindmaps/{MAP_KEY}/work-items", cookies={"mem_session": "bogus"})
+    assert res.status_code == 401
