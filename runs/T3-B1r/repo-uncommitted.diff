index 0000000..79a9f98
--- /dev/null
+++ b/tests/security/test_team_membership_authz.py
@@ -0,0 +1,1227 @@
+"""Security tests for the team member-management RBAC gate (Work Order 1).
+
+Threat: the member-management tools (memsys_add_team_member,
+memsys_assign_role, memsys_remove_team_member) previously ran under
+system_tx (RLS bypassed) with only a coarse OAuth scope check. Any token
+holder with memory.write could add themselves as owner, escalate within a
+team, or evict real members.
+
+Fix: each tool now calls ``require_team_permission(team.manage_members)``
+before any DB access. These tests verify the gate in both acceptance and
+denial directions, plus the no-existence-oracle and email-enumeration-oracle
+properties.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.auth.permissions import Permission
+from mem_mcp.auth.rbac import has_permission
+from mem_mcp.db import system_tx
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools.add_team_member import AddTeamMemberInput, AddTeamMemberTool
+from mem_mcp.mcp.tools.admin_find_user import AdminFindUserInput, AdminFindUserTool
+from mem_mcp.mcp.tools.assign_role import AssignRoleInput, AssignRoleTool
+from mem_mcp.mcp.tools.create_team import CreateTeamInput, CreateTeamTool
+from mem_mcp.mcp.tools.remove_team_member import RemoveTeamMemberInput, RemoveTeamMemberTool
+from mem_mcp.teams.assignments import assign_role
+
+pytestmark = pytest.mark.security
+
+
+# ── helpers ──────────────────────────────────────────────────────────────────
+
+
+async def _make_tenant(pool: Any, *, label: str) -> tuple[UUID, UUID, str]:
+    """Create a tenant + primary identity. Returns (tenant_id, identity_id, email)."""
+    tenant_id = uuid4()
+    identity_id = uuid4()
+    email = f"authz-{label}-{tenant_id}@sec.invalid"
+    async with system_tx(pool) as conn:
+        await conn.execute(
+            "INSERT INTO tenants (id, email, status) VALUES ($1, $2, 'active')",
+            tenant_id,
+            email,
+        )
+        await conn.execute(
+            """
+            INSERT INTO tenant_identities
+                (id, tenant_id, cognito_sub, provider, email, is_primary)
+            VALUES ($1, $2, $3, 'cognito', $4, true)
+            """,
+            identity_id,
+            tenant_id,
+            f"sub-{tenant_id}",
+            email,
+        )
+    return tenant_id, identity_id, email
+
+
+async def _setup_team_with_caller(
+    pool: Any,
+    *,
+    role_key: str = "owner",
+    label: str = "caller",
+    team_name: str = "authz-team",
+) -> tuple[ToolContext, UUID, UUID, str]:
+    """Create a tenant + team where the tenant has ``role_key`` on the team.
+
+    Returns (ctx, team_id, tenant_id, email).
+    """
+    tenant_id, identity_id, email = await _make_tenant(pool, label=label)
+    team_id = uuid4()
+    async with system_tx(pool) as conn:
+        await conn.execute(
+            """
+            INSERT INTO teams (id, name, workspace_domain, created_by_tenant_id)
+            VALUES ($1, $2, NULL, $3)
+            """,
+            team_id,
+            team_name,
+            tenant_id,
+        )
+        await assign_role(
+            conn,
+            parent_team_id=team_id,
+            member_kind="user",
+            member_id=tenant_id,
+            role_key=role_key,
+            assigned_by_user_id=tenant_id,
+        )
+    ctx = _ctx(pool, tenant_id, identity_id)
+    return ctx, team_id, tenant_id, email
+
+
+def _ctx(pool: Any, tenant_id: UUID, identity_id: UUID) -> ToolContext:
+    """Build a minimal ToolContext (deps omitted — tools under test don't use them)."""
+    return ToolContext(
+        request_id=str(uuid4()),
+        tenant_id=tenant_id,
+        identity_id=identity_id,
+        client_id="sec-test",
+        scopes=frozenset({"memory.read", "memory.write"}),
+        db_pool=pool,
+    )
+
+
+async def _teardown(
+    pool: Any, *, tenants: tuple[UUID, ...] = (), teams: tuple[UUID, ...] = ()
+) -> None:
+    """Best-effort cleanup of test-created rows (FK-safe ordering)."""
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            for team_id in teams:
+                await conn.execute(
+                    "DELETE FROM team_role_assignments WHERE parent_team_id = $1",
+                    team_id,
+                )
+                await conn.execute("DELETE FROM team_members WHERE team_id = $1", team_id)
+                await conn.execute("DELETE FROM slugs WHERE team_id = $1", team_id)
+                await conn.execute("DELETE FROM teams WHERE id = $1", team_id)
+            for tenant_id in tenants:
+                await conn.execute(
+                    "DELETE FROM team_role_assignments WHERE member_kind='user' AND member_id=$1",
+                    tenant_id,
+                )
+                await conn.execute("DELETE FROM team_members WHERE tenant_id = $1", tenant_id)
+                await conn.execute(
+                    "DELETE FROM user_effective_team_access WHERE user_id = $1",
+                    tenant_id,
+                )
+                await conn.execute("DELETE FROM tenant_identities WHERE tenant_id = $1", tenant_id)
+                await conn.execute("DELETE FROM tenants WHERE id = $1", tenant_id)
+
+
+async def _has_role_via_legacy(pool: Any, tenant_id: UUID, team_id: UUID) -> None:
+    """Insert a legacy team_members row (role='admin') with NO team_role_assignments
+    row, simulating a pre-migration membership that the fallback path will resolve."""
+    async with system_tx(pool) as conn:
+        await conn.execute(
+            """
+            INSERT INTO team_members (team_id, tenant_id, role, status, added_by_tenant_id)
+            VALUES ($1, $2, 'admin', 'active', $2)
+            """,
+            team_id,
+            tenant_id,
+        )
+
