+    async def test_removed_admin_loses_legacy_access(self, pg_pool: Any) -> None:
+        """An admin added via the legacy table (no team_role_assignments row)
+        is still found by has_permission. After remove_member, the legacy row
+        is gone and has_permission returns False (req 8).
+        """
+        # Alice: real owner via assign_role (team_role_assignments row exists).
+        alice_ctx, team_id, alice_id, _ = await _setup_team_with_caller(
+            pg_pool, role_key="owner", label="legacy-alice"
+        )
+        # Bob: legacy team_members row ONLY (no team_role_assignments row).
+        bob_id, _, _ = await _make_tenant(pg_pool, label="legacy-bob")
+        await _has_role_via_legacy(pg_pool, tenant_id=bob_id, team_id=team_id)
+
+        try:
+            # Precondition: Bob's legacy admin role resolves via fallback.
+            async with system_tx(pg_pool) as conn:
+                perms = await has_permission(
+                    conn, bob_id, Permission.TEAM_MANAGE_MEMBERS, team_id=team_id
+                )
+            assert perms is True
+
+            # Alice (owner) removes Bob.
+            await RemoveTeamMemberTool()(
+                alice_ctx,
+                RemoveTeamMemberInput(
+                    team_id=team_id,
+                    member_kind="user",
+                    member_id=bob_id,
+                ),
+            )
+
+            # Legacy row must be deleted.
+            async with system_tx(pg_pool) as conn:
+                legacy_row = await conn.fetchrow(
