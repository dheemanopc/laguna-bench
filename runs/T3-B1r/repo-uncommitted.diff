+    async def test_self_removal_bypasses_gate(self, pg_pool: Any) -> None:
+        """A sole owner calling remove_team_member on themselves is NOT blocked
+        by the permission gate — they get sole_owner_cannot_self_remove (-32000)
+        instead of a permission denial (-32603) (req 5).
+
+        Also verifies that a non-sole-owner self-removal succeeds.
+        """
+        # --- sole owner: gate bypassed, sole-owner invariant fires ---
+        ctx, team_id, sole_owner_id, _ = await _setup_team_with_caller(
+            pg_pool, role_key="owner", label="soleowner"
+        )
+        try:
+            with pytest.raises(JsonRpcError) as exc:
+                await RemoveTeamMemberTool()(
+                    ctx,
+                    RemoveTeamMemberInput(
+                        team_id=team_id,
+                        member_kind="user",
+                        member_id=sole_owner_id,
+                    ),
+                )
+            # Must NOT be a permission denial — the gate was bypassed.
+            assert exc.value.code != -32603 or (
+                exc.value.data is None or exc.value.data.get("missing_permission") is None
+            )
+            # The sole-owner invariant is a separate concern: -32000.
+            assert exc.value.code == -32000
+            assert "sole_owner" in exc.value.message
+        finally:
+            await _teardown(pg_pool, tenants=(sole_owner_id,), teams=(team_id,))
+
+        # --- two owners: self-removal succeeds ---
+        ctx2, team_id2, owner_a_id, _ = await _setup_team_with_caller(
+            pg_pool, role_key="owner", label="owner-a"
+        )
+        owner_b_id, _, _ = await _make_tenant(pg_pool, label="owner-b")
+        async with system_tx(pg_pool) as conn:
+            await assign_role(
+                conn,
+                parent_team_id=team_id2,
+                member_kind="user",
+                member_id=owner_b_id,
+                role_key="owner",
+                assigned_by_user_id=owner_a_id,
