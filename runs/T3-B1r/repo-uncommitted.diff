+"""Unit tests for the ``ROLE_PERMISSIONS`` matrix (Work Order 1, Change 1).
+
+Verifies that all 7 catalog team roles + 2 system roles are present with the
+correct permission sets, and that the namespaces are disjoint — no team role
+grants ``system.*`` permissions and no system role grants ``team.*`` permissions.
+
+These are pure-Python tests: no database required.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from mem_mcp.auth.permissions import ROLE_PERMISSIONS, Permission, Role
+
+# The 7 core team roles defined in roles_catalog (seeded by migration 0021).
+TEAM_ROLE_KEYS = frozenset(
+    {"owner", "admin", "member", "viewer", "vendor", "customer", "service-bot"}
+)
+SYSTEM_ROLE_KEYS = frozenset({Role.SYSTEM_ADMIN.value, Role.SYSTEM_SUPPORT.value})
+
+_ALL_SYSTEM = frozenset(p for p in Permission if p.value.startswith("system."))
+_ALL_TEAM = frozenset(p for p in Permission if p.value.startswith("team."))
+
+
+class TestMatrixCompleteness:
+    """Every expected role key is present in the matrix."""
+
+    def test_all_catalog_roles_present(self) -> None:
+        team_keys = set(ROLE_PERMISSIONS) - SYSTEM_ROLE_KEYS
+        assert team_keys == set(TEAM_ROLE_KEYS)
+
+    def test_system_roles_present(self) -> None:
+        for key in SYSTEM_ROLE_KEYS:
+            assert key in ROLE_PERMISSIONS, f"missing system role {key!r}"
+
+    def test_total_role_count(self) -> None:
+        assert len(ROLE_PERMISSIONS) == 9  # 7 team + 2 system
+
+    def test_no_unexpected_keys(self) -> None:
+        assert set(ROLE_PERMISSIONS) == TEAM_ROLE_KEYS | SYSTEM_ROLE_KEYS
+
+
+class TestNamespaceDisjointness:
+    """System and team permission namespaces must never overlap."""
+
+    def test_team_roles_hold_no_system_permissions(self) -> None:
+        for key in TEAM_ROLE_KEYS:
+            perms = ROLE_PERMISSIONS[key]
+            assert not any(
+                p.value.startswith("system.") for p in perms
+            ), f"team role {key!r} grants system permissions"
+
+    def test_system_roles_hold_no_team_permissions(self) -> None:
+        for key in SYSTEM_ROLE_KEYS:
+            perms = ROLE_PERMISSIONS[key]
+            assert not any(
+                p.value.startswith("team.") for p in perms
+            ), f"system role {key!r} grants team permissions"
+
+
+class TestSystemRoleMatrix:
+    def test_system_admin_gets_all_system(self) -> None:
+        assert ROLE_PERMISSIONS[Role.SYSTEM_ADMIN.value] == _ALL_SYSTEM
+
+    def test_system_support_gets_read_perms(self) -> None:
+        expected = {Permission.SYSTEM_REVIEW_SIGNUPS, Permission.SYSTEM_VIEW_AUDIT}
+        assert ROLE_PERMISSIONS[Role.SYSTEM_SUPPORT.value] == expected
+
+
+class TestTeamRoleMatrix:
+    @pytest.mark.parametrize("role_key", ["owner", "admin"])
+    def test_admin_roles_have_full_team_perms(self, role_key: str) -> None:
+        """owner and admin both map to the full team-permission set."""
+        assert ROLE_PERMISSIONS[role_key] == _ALL_TEAM
+
+    def test_member_has_write_perms(self) -> None:
+        expected = {Permission.TEAM_VIEW, Permission.TEAM_WRITE_MEMORY, Permission.TEAM_READ_MEMORY}
+        assert ROLE_PERMISSIONS["member"] == expected
+
+    @pytest.mark.parametrize("role_key", ["viewer", "vendor", "customer"])
+    def test_readonly_roles_have_view_perms(self, role_key: str) -> None:
+        """viewer, vendor, customer all get read-only team permissions."""
+        expected = {Permission.TEAM_VIEW, Permission.TEAM_READ_MEMORY}
+        assert ROLE_PERMISSIONS[role_key] == expected
+
+    def test_service_bot_has_member_perms(self) -> None:
+        expected = {Permission.TEAM_VIEW, Permission.TEAM_WRITE_MEMORY, Permission.TEAM_READ_MEMORY}
+        assert ROLE_PERMISSIONS["service-bot"] == expected
+
+
+class TestPermissionSetBoundaries:
+    """The permission constants must enforce the manage/write/read hierarchy."""
+
+    def test_admin_perms_include_manage_members(self) -> None:
+        admin_perms = ROLE_PERMISSIONS["owner"]
+        assert Permission.TEAM_MANAGE_MEMBERS in admin_perms
+
+    def test_member_perms_exclude_manage(self) -> None:
+        member_perms = ROLE_PERMISSIONS["member"]
+        assert Permission.TEAM_MANAGE_MEMBERS not in member_perms
+        assert Permission.TEAM_MANAGE_SETTINGS not in member_perms
+        assert Permission.TEAM_DELETE not in member_perms
+
+    def test_readonly_perms_exclude_all_writes(self) -> None:
+        for key in ("viewer", "vendor", "customer"):
+            perms = ROLE_PERMISSIONS[key]
+            assert Permission.TEAM_WRITE_MEMORY not in perms
+            assert Permission.TEAM_MANAGE_MEMBERS not in perms
+            assert Permission.TEAM_MANAGE_SETTINGS not in perms
+            assert Permission.TEAM_DELETE not in perms
+
+    def test_readonly_perms_include_view(self) -> None:
+        for key in ("viewer", "vendor", "customer"):
+            perms = ROLE_PERMISSIONS[key]
+            assert Permission.TEAM_VIEW in perms
+            assert Permission.TEAM_READ_MEMORY in perms
+
+    def test_service_bot_can_write_but_not_manage(self) -> None:
