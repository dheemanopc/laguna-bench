diff --git a/src/mem_mcp/teams/authz.py b/src/mem_mcp/teams/authz.py
new file mode 100644
index 0000000..8f77204
--- /dev/null
+++ b/src/mem_mcp/teams/authz.py
@@ -0,0 +1,62 @@
+"""Team-scoped authorization helpers.
+
+``require_team_permission`` is the shared gate used by the member-management
+MCP tools (``memsys_add_team_member``, ``memsys_assign_role``,
+``memsys_remove_team_member``). It lives in the ``teams`` domain layer so that
+both the MCP tools and the web handlers can call it without a circular import
+from ``mcp.tools``.
+
+The resolver (``has_permission``) queries ``team_role_assignments`` first and
+falls back to legacy ``team_members``. Because ``remove_member`` now deletes
+legacy rows too (see ``assignments.py``), a revoked member cannot re-grant
+themselves via the fallback path.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+from mem_mcp.auth.permissions import Permission
+
+if TYPE_CHECKING:
+    from uuid import UUID
+
+    import asyncpg  # type: ignore[import-untyped]
+
+
+class TeamPermissionDeniedError(Exception):
+    """Caller lacks a team-scoped permission.
+
+    Attributes:
+        permission: the missing permission key as a string (e.g.
+            ``"team.manage_members"``).
+    """
+
+    def __init__(self, permission: str | Permission) -> None:
+        perm = permission.value if isinstance(permission, Permission) else str(permission)
+        self.permission = perm
+        super().__init__(f"caller lacks required permission: {perm}")
+
+
+async def require_team_permission(
+    conn: asyncpg.Connection,
+    *,
+    caller_id: UUID,
+    team_id: UUID,
+    permission: Permission,
+) -> None:
+    """Raise ``TeamPermissionDeniedError`` if ``caller_id`` lacks ``permission``
+    on ``team_id``.
+
+    Delegates to ``has_permission`` (imported lazily below). The lazy import
+    keeps ``mem_mcp.auth.rbac`` — which pulls in FastAPI and
+    ``web.sessions`` at module level — out of the import graph of callers that
+    only need the pure-DB resolver.
+    """
+    # Lazy import: rbac.py imports FastAPI + web.sessions for its
+    # require_permission() dependency, neither of which the MCP path needs.
+    from mem_mcp.auth.rbac import has_permission
+
+    ok = await has_permission(conn, caller_id, permission, team_id=team_id)
+    if not ok:
+        raise TeamPermissionDeniedError(permission)
diff --git a/tests/security/test_team_membership_authz.py b/tests/security/test_team_membership_authz.py
