+                    team_id,
+                    bob_id,
+                )
+                assert legacy_row is None
+
+                # has_permission must now return False for Bob.
+                perms = await has_permission(
+                    conn, bob_id, Permission.TEAM_MANAGE_MEMBERS, team_id=team_id
+                )
+            assert perms is False
+
+            # And the team_role_assignments row must also be gone.
+            async with system_tx(pg_pool) as conn:
+                tra_row = await conn.fetchrow(
