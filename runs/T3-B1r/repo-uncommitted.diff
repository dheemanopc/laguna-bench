+        variant: str,
+        legacy_only: bool,
+    ) -> None:
+        """After removal, the former member's AddTeamMemberTool call is denied
+        — no team_role_assignments row survives (req: removed cannot re-add)."""
+        _owner_ctx, team_id, owner_id, _ = await _setup_team_with_caller(
+            pg_pool, role_key="owner", label=f"remadd-{variant}"
+        )
+        victim_id, _, _ = await _make_tenant(pg_pool, label=f"remadd-{variant}-vic")
+        if legacy_only:
+            # Legacy: team_members row ONLY (role='admin'), no team_role_assignments.
+            await _has_role_via_legacy(pg_pool, tenant_id=victim_id, team_id=team_id)
+        else:
+            # New table: team_role_assignments row (role='member'), no legacy row.
+            async with system_tx(pg_pool) as conn:
+                await assign_role(
+                    conn,
+                    parent_team_id=team_id,
+                    member_kind="user",
+                    member_id=victim_id,
+                    role_key="member",
+                    assigned_by_user_id=owner_id,
+                )
+        victim_ctx = _ctx(pg_pool, victim_id, victim_id)
+        try:
+            # Precondition: victim has TEAM_VIEW access before removal.
+            async with system_tx(pg_pool) as conn:
+                ok = await has_permission(
+                    conn,
+                    victim_id,
+                    Permission.TEAM_VIEW,
+                    team_id=team_id,
+                )
+            assert ok is True
+
+            # Owner removes the victim.
+            out = await RemoveTeamMemberTool()(
+                _owner_ctx,
+                RemoveTeamMemberInput(
+                    team_id=team_id,
+                    member_kind="user",
+                    member_id=victim_id,
+                ),
+            )
+            assert out.removed is True
+
+            if legacy_only:
+                # Key assertion: legacy team_members row MUST be deleted
+                # (the fix in remove_member) — otherwise the fallback path
+                # in get_team_role would resurrect the revoked member.
+                async with system_tx(pg_pool) as conn:
+                    row = await conn.fetchrow(
+                        "SELECT 1 FROM team_members WHERE team_id=$1 AND tenant_id=$2",
+                        team_id,
+                        victim_id,
+                    )
+                    assert row is None
+            else:
+                async with system_tx(pg_pool) as conn:
+                    row = await conn.fetchrow(
+                        "SELECT 1 FROM team_role_assignments "
+                        "WHERE parent_team_id=$1 AND member_kind='user' AND member_id=$2",
+                        team_id,
+                        victim_id,
+                    )
+                    assert row is None
+
+            # Post-removal: victim no longer has TEAM_VIEW.
+            async with system_tx(pg_pool) as conn:
+                ok = await has_permission(
+                    conn,
+                    victim_id,
+                    Permission.TEAM_VIEW,
+                    team_id=team_id,
+                )
+            assert ok is False
+
+            # Victim tries to re-add themselves → denied.
+            with pytest.raises(JsonRpcError) as exc:
+                await AddTeamMemberTool()(
+                    victim_ctx,
+                    AddTeamMemberInput(
+                        team_id=team_id,
+                        member_kind="user",
+                        member_id=victim_id,
+                        role_key="member",
+                    ),
+                )
+            assert exc.value.code == -32603
+            assert exc.value.data["missing_permission"] == Permission.TEAM_MANAGE_MEMBERS.value
+
+            # No row must have been inserted.
+            async with system_tx(pg_pool) as conn:
+                row = await conn.fetchrow(
+                    "SELECT 1 FROM team_role_assignments "
+                    "WHERE parent_team_id=$1 AND member_kind='user' AND member_id=$2",
+                    team_id,
+                    victim_id,
+                )
+                assert row is None
+        finally:
+            await _teardown(pg_pool, tenants=(owner_id, victim_id), teams=(team_id,))
