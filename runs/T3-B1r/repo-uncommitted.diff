--- /dev/null
+++ b/src/mem_mcp/mcp/tools/_team_authz.py
@@ -0,0 +1,29 @@
+"""Shared MCP-layer mapping for team member-management permission denials.
+
+Converts the domain-level ``TeamPermissionDeniedError`` (from
+``mem_mcp.teams.authz``) into the JSON-RPC error envelope that the
+``memsys_add_team_member``, ``memsys_assign_role``, and
+``memsys_remove_team_member`` tools return on denial. All three tools share
+this helper so the denial shape is identical and there is one place to audit
+(the same pattern as ``_admin_base.py``'s ``AdminTool`` gate).
+"""
+
+from __future__ import annotations
+
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.teams.authz import TeamPermissionDeniedError
+
+
+def team_permission_denied_error(err: TeamPermissionDeniedError) -> JsonRpcError:
+    """Build the ``-32603`` ``JsonRpcError`` for a team permission denial.
+
+    Mirrors ``_admin_base.AdminTool.__call__``: opaque to callers who lack
+    the permission, while surfacing the missing key in ``data`` for
+    authorised debugging. The caller chains with ``from None`` so no
+    internal traceback leaks.
+    """
+    return JsonRpcError(
+        -32603,
+        f"caller lacks required permission: {err.permission}",
+        data={"missing_permission": err.permission},
+    )
