+                MindmapWorkflowGetInput(workflow_id=None, team_id=team_id),
+            )
+        except JsonRpcError as exc:
+            raise _http_from_jsonrpc(exc) from exc
+        return out.model_dump(mode="json")
+
+    @router.post("/api/web/teams/{team_id}/workflow")
+    async def create_workflow(
+        team_id: UUID,
+        body: WorkflowCreateBody,
+        mem_session: str | None = Cookie(default=None),
+    ) -> Any:
+        ctx = await _ctx_from_session(pool, mem_session, deps, scopes=_WRITE)
+        try:
+            out = await MindmapWorkflowCreateTool()(
+                ctx,
+                MindmapWorkflowCreateInput(
+                    name=body.name,
+                    stages=body.stages,
+                    transitions=body.transitions,
+                    team_id=team_id,
+                ),
+            )
+        except JsonRpcError as exc:
+            raise _http_from_jsonrpc(exc) from exc
+        return out.model_dump(mode="json")
+
+    @router.post("/api/web/teams/{team_id}/workflow/{workflow_id}/activate")
