@@ -0,0 +1,302 @@
+"use client";
+
+import { useEffect, useState } from "react";
+
+export interface WorkflowTransition {
+  from_stage: string;
+  to_stage: string;
+  requires_reason: boolean;
+  requires_signoff: boolean;
+  signoff_min: number;
+  signoff_roles: string[];
+  allowed_kinds: string[];
+}
+
+interface StageRow {
+  name: string;
+  is_initial: boolean;
+  is_terminal: boolean;
+}
+
+interface WorkflowEditorProps {
+  stages: string[];
+  teamRoles: string[];
+  workKinds: readonly string[];
+  onStagesChange: (stages: string[]) => void;
+  onTransitionsChange: (transitions: WorkflowTransition[]) => void;
+  transitions?: WorkflowTransition[];
+}
+
+export function WorkflowEditor({
+  stages,
+  teamRoles,
+  workKinds,
+  onStagesChange,
+  onTransitionsChange,
+  transitions: initialTransitions,
+}: WorkflowEditorProps) {
+  const [stageRows, setStageRows] = useState<StageRow[]>(() =>
+    (stages ?? []).map((s) => ({ name: s, is_initial: false, is_terminal: false }))
+  );
+  const [transitionRows, setTransitionRows] = useState<WorkflowTransition[]>(
+    () => (initialTransitions ?? []).slice()
+  );
+
+  // Keep local stage rows in sync when the parent passes a different list.
+  useEffect(() => {
+    setStageRows((prev) => {
+      if (prev.length === stages.length && prev.every((r, i) => r.name === stages[i])) {
+        return prev;
+      }
+      return (stages ?? []).map((s) => {
+        const existing = prev.find((r) => r.name === s);
+        return existing
+          ? { ...existing, name: s }
+          : { name: s, is_initial: false, is_terminal: false };
+      });
+    });
+  }, [stages]);
+
+  // Notify parent of stage name changes.
+  useEffect(() => {
+    onStagesChange(stageRows.map((r) => r.name));
+  }, [stageRows, onStagesChange]);
+
+  // Notify parent of transition changes.
+  useEffect(() => {
+    onTransitionsChange(transitionRows);
+  }, [transitionRows, onTransitionsChange]);
+
+  const stageNames = stageRows.map((r) => r.name).filter((n) => n.trim() !== "");
+
+  function updateStage(index: number, patch: Partial<StageRow>) {
+    setStageRows((prev) =>
+      prev.map((r, i) => (i === index ? { ...r, ...patch } : r))
+    );
+  }
+
+  function addStage() {
+    setStageRows((prev) => [...prev, { name: "", is_initial: false, is_terminal: false }]);
+  }
+
+  function removeStage(index: number) {
+    setStageRows((prev) => prev.filter((_, i) => i !== index));
+  }
+
+  function addTransition() {
+    setTransitionRows((prev) => [
+      ...prev,
+      {
+        from_stage: "any",
+        to_stage: stageNames[0] ?? "",
+        requires_reason: false,
+        requires_signoff: false,
+        signoff_min: 1,
+        signoff_roles: [],
+        allowed_kinds: [],
+      },
+    ]);
+  }
+
+  function removeTransition(index: number) {
+    setTransitionRows((prev) => prev.filter((_, i) => i !== index));
+  }
+
+  function updateTransition(index: number, patch: Partial<WorkflowTransition>) {
+    setTransitionRows((prev) =>
+      prev.map((r, i) => (i === index ? { ...r, ...patch } : r))
+    );
+  }
+
+  function toggleMulti(
+    list: string[],
+    value: string
+  ): string[] {
+    return list.includes(value)
+      ? list.filter((v) => v !== value)
+      : [...list, value];
+  }
+
+  return (
+    <div className="space-y-6">
+      <section className="space-y-2">
+        <h3 className="text-lg font-semibold">Stages</h3>
+        <div className="space-y-2">
+          {stageRows.map((row, idx) => (
+            <div key={idx} className="flex items-center gap-2 border rounded p-2">
+              <span className="text-xs text-gray-500 w-6">{idx + 1}</span>
+              <input
+                type="text"
+                value={row.name}
+                onChange={(e) => updateStage(idx, { name: e.target.value })}
+                placeholder="stage name"
+                className="border rounded px-2 py-1 flex-1"
+              />
+              <label className="flex items-center gap-1 text-sm">
+                <input
+                  type="checkbox"
+                  checked={row.is_initial}
+                  onChange={(e) => updateStage(idx, { is_initial: e.target.checked })}
+                />
+                initial
+              </label>
+              <label className="flex items-center gap-1 text-sm">
+                <input
+                  type="checkbox"
+                  checked={row.is_terminal}
+                  onChange={(e) => updateStage(idx, { is_terminal: e.target.checked })}
+                />
+                terminal
+              </label>
+              <button
+                type="button"
+                onClick={() => removeStage(idx)}
+                className="text-red-600 text-sm"
+              >
+                remove
+              </button>
+            </div>
+          ))}
+        </div>
+        <button
+          type="button"
+          onClick={addStage}
+          className="bg-blue-600 text-white rounded px-3 py-1 text-sm"
+        >
+          Add stage
+        </button>
+      </section>
+
+      <section className="space-y-2">
+        <h3 className="text-lg font-semibold">Transitions</h3>
+        <div className="space-y-3">
+          {transitionRows.map((tr, idx) => (
+            <div key={idx} className="border rounded p-3 space-y-2">
+              <div className="flex items-center gap-2">
+                <select
+                  value={tr.from_stage}
+                  onChange={(e) => updateTransition(idx, { from_stage: e.target.value })}
+                  className="border rounded px-2 py-1"
+                >
+                  <option value="any">any</option>
+                  {stageNames.map((s) => (
+                    <option key={s} value={s}>
+                      {s}
+                    </option>
+                  ))}
+                </select>
+                <span>→</span>
+                <select
+                  value={tr.to_stage}
+                  onChange={(e) => updateTransition(idx, { to_stage: e.target.value })}
+                  className="border rounded px-2 py-1"
+                >
+                  {stageNames.map((s) => (
+                    <option key={s} value={s}>
+                      {s}
+                    </option>
+                  ))}
+                </select>
+                <button
+                  type="button"
+                  onClick={() => removeTransition(idx)}
+                  className="text-red-600 text-sm"
+                >
+                  remove
+                </button>
+              </div>
+
+              <div className="flex items-center gap-4 text-sm">
+                <label className="flex items-center gap-1">
+                  <input
+                    type="checkbox"
+                    checked={tr.requires_reason}
+                    onChange={(e) =>
+                      updateTransition(idx, { requires_reason: e.target.checked })
+                    }
+                  />
+                  requires reason
+                </label>
+                <label className="flex items-center gap-1">
+                  <input
+                    type="checkbox"
+                    checked={tr.requires_signoff}
+                    onChange={(e) =>
+                      updateTransition(idx, {
+                        requires_signoff: e.target.checked,
+                        signoff_min: e.target.checked ? Math.max(1, tr.signoff_min) : tr.signoff_min,
+                      })
+                    }
+                  />
+                  requires signoff
+                </label>
+                <label className="flex items-center gap-1">
+                  signoff min
+                  <input
+                    type="number"
+                    min={1}
+                    value={tr.signoff_min}
+                    disabled={!tr.requires_signoff}
+                    onChange={(e) =>
+                      updateTransition(idx, {
+                        signoff_min: Math.max(1, parseInt(e.target.value, 10) || 1),
+                      })
+                    }
+                    className="border rounded px-2 py-1 w-16"
+                  />
+                </label>
+              </div>
+
+              <div className="text-sm">
+                <div className="font-medium">signoff roles</div>
+                <div className="flex flex-wrap gap-2">
+                  {teamRoles.map((role) => (
+                    <label key={role} className="flex items-center gap-1">
+                      <input
+                        type="checkbox"
+                        checked={tr.signoff_roles.includes(role)}
+                        onChange={() =>
+                          updateTransition(idx, {
+                            signoff_roles: toggleMulti(tr.signoff_roles, role),
+                          })
+                        }
+                      />
+                      {role}
+                    </label>
+                  ))}
+                </div>
+              </div>
+
+              <div className="text-sm">
+                <div className="font-medium">allowed kinds</div>
+                <div className="flex flex-wrap gap-2">
+                  {workKinds.map((kind) => (
+                    <label key={kind} className="flex items-center gap-1">
+                      <input
+                        type="checkbox"
+                        checked={tr.allowed_kinds.includes(kind)}
+                        onChange={() =>
+                          updateTransition(idx, {
+                            allowed_kinds: toggleMulti(tr.allowed_kinds, kind),
+                          })
+                        }
+                      />
+                      {kind}
+                    </label>
+                  ))}
+                </div>
+              </div>
+            </div>
+          ))}
+        </div>
+        <button
+          type="button"
+          onClick={addTransition}
+          className="bg-blue-600 text-white rounded px-3 py-1 text-sm"
+        >
+          Add transition
+        </button>
+      </section>
+    </div>
+  );
+}
