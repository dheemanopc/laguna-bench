+"use client";
+
+import { createContext, useCallback, useContext, useState } from "react";
+
+interface BoardRefreshContextValue {
+  boardRefreshKey: number;
+  bumpRefresh: () => void;
+}
+
+const BoardRefreshContext = createContext<BoardRefreshContextValue | null>(null);
+
+export function BoardRefreshProvider({ children }: { children: React.ReactNode }) {
+  const [boardRefreshKey, setBoardRefreshKey] = useState(0);
+  const bumpRefresh = useCallback(() => setBoardRefreshKey((k) => k + 1), []);
+  return (
+    <BoardRefreshContext.Provider value={{ boardRefreshKey, bumpRefresh }}>
+      {children}
+    </BoardRefreshContext.Provider>
+  );
+}
+
+export function useBoardRefresh(): BoardRefreshContextValue {
+  const ctx = useContext(BoardRefreshContext);
+  if (!ctx) throw new Error("useBoardRefresh must be used within BoardRefreshProvider");
+  return ctx;
+}
