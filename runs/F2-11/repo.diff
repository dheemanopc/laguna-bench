+"use client";
+
+import { useEffect, useState } from "react";
+import { useRouter } from "next/navigation";
+import { useBoardRefresh } from "./BoardContext";
+import ItemDetail from "./ItemDetail";
+import WaitingOnYou from "./WaitingOnYou";
+
+export interface Stage {
+  stage_id: string;
+  name: string;
+  ordinal: number;
+  is_initial: boolean;
+  is_terminal: boolean;
+}
+
+export interface AllowedMove {
+  to_stage: string;
+}
+
+export interface BoardItem {
+  node_id: string;
+  title: string;
+  status: string;
+  current_stage: string | null;
+  allowed_moves: AllowedMove[];
+  blocked_reason: string | null;
+  pending_signoff: { signatory_count: number; signoff_min: number } | null;
+}
+
+export interface BoardViewProps {
+  items: BoardItem[];
+  stages: Stage[];
+  mapKey: string;
+  teamId: string;
+}
+
+export default function BoardView({ items, stages, mapKey, teamId }: BoardViewProps) {
+  const router = useRouter();
+  const { boardRefreshKey } = useBoardRefresh();
+  const [selectedId, setSelectedId] = useState<string | null>(null);
+  const selected = items.find((x) => x.node_id === selectedId) ?? null;
+
+  useEffect(() => {
+    if (boardRefreshKey > 0) router.refresh();
+  }, [boardRefreshKey, router]);
+
+  const sortedStages = [...stages].sort((a, b) => a.ordinal - b.ordinal);
+  const stageNames = new Set(sortedStages.map((s) => s.name));
+
+  const grouped: Record<string, BoardItem[]> = {};
+  for (const s of sortedStages) grouped[s.name] = [];
+  grouped.unmapped = [];
+  for (const it of items) {
+    const st = it.current_stage;
+    if (st && stageNames.has(st)) grouped[st].push(it);
+    else grouped.unmapped.push(it);
+  }
+
+  const columns = [...sortedStages.map((s) => s.name), "unmapped"];
+
+  return (
+    <div>
+      <div className="flex gap-4 overflow-x-auto">
+        {columns.map((col) => (
+          <div key={col} className="min-w-[220px] flex-1 rounded border p-2">
+            <h3 className="mb-2 font-semibold">{col}</h3>
+            {(grouped[col] ?? []).map((it) => (
+              <div key={it.node_id} className="mb-2 rounded border p-2">
+                <div className="truncate font-medium">{it.title}</div>
+                <div className="text-xs">{it.status}</div>
+                <div className="text-xs">{it.current_stage ?? "unmapped"}</div>
+                {it.blocked_reason && (
+                  <span className="text-xs text-rose-600">
+                    {it.blocked_reason === "reason_required"
+                      ? "needs reason"
+                      : it.blocked_reason === "role_restricted"
+                        ? "role-restricted"
+                        : it.blocked_reason === "no_transition"
+                          ? "no moves"
+                          : it.blocked_reason}
+                  </span>
+                )}
+                {it.pending_signoff && (
+                  <span className="text-xs text-amber-600">
+                    awaiting {it.pending_signoff.signatory_count} of {it.pending_signoff.signoff_min}
+                  </span>
+                )}
+                {it.allowed_moves.length > 0 && (
+                  <select
+                    className="mt-1 w-full text-xs"
+                    defaultValue=""
+                    onChange={(e) => {
+                      const v = e.target.value;
+                      if (v) {
+                        setSelectedId(it.node_id);
+                      }
+                      e.target.value = "";
+                    }}
+                  >
+                    <option value="" disabled>
+                      move…
+                    </option>
+                    {it.allowed_moves.map((m) => (
+                      <option key={m.to_stage} value={m.to_stage}>
+                        {m.to_stage}
+                      </option>
+                    ))}
+                  </select>
+                )}
+              </div>
+            ))}
+          </div>
+        ))}
+      </div>
+      {selected && (
+        <ItemDetail item={selected} mapKey={mapKey} stages={stages} onClose={() => setSelectedId(null)} />
+      )}
+      <WaitingOnYou mapKey={mapKey} teamId={teamId} items={items} />
+    </div>
+  );
+}
