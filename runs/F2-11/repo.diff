+"""Convenience re-export of workflow error types.
+
+``mem_mcp.mindmap.workflow`` is a thin alias over ``workflow_errors`` so callers
+can import ``WorkflowError`` (and friends) from a stable, shorter module path.
+"""
+
+from __future__ import annotations
+
+from mem_mcp.mindmap.workflow_errors import (
+    KindNotAllowedError,
+    MoveBlockedError,
+    SignoffAlreadySignedError,
+    SignoffCompleteError,
+    SignoffNotAllowedError,
+    SignoffRequiredError,
+    StageConflictError,
+    StageNotFoundError,
+    TransitionNotFoundError,
+    WorkflowAlreadyActiveError,
+    WorkflowError,
+    WorkflowNotActiveError,
+    WorkflowNotFoundError,
+    WorkflowPermissionDeniedError,
+)
+
+__all__ = [
+    "KindNotAllowedError",
+    "MoveBlockedError",
+    "SignoffAlreadySignedError",
+    "SignoffCompleteError",
+    "SignoffNotAllowedError",
+    "SignoffRequiredError",
+    "StageConflictError",
+    "StageNotFoundError",
+    "TransitionNotFoundError",
+    "WorkflowAlreadyActiveError",
+    "WorkflowError",
+    "WorkflowNotFoundError",
+    "WorkflowNotActiveError",
+    "WorkflowPermissionDeniedError",
+]
