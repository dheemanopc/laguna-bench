+"use client";
+
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+import { csrfHeaders } from "@/lib/csrf";
+import { WorkflowEditor, type WorkflowTransition } from "./WorkflowEditor";
+
+interface Stage {
+  stage_id: string;
+  workflow_id: string;
+  name: string;
+  ordinal: number;
+  is_initial: boolean;
+  is_terminal: boolean;
+}
+
+interface Transition {
+  transition_id: string;
+  workflow_id: string;
+  from_stage_id: string | null;
+  to_stage_id: string;
+  requires_reason: boolean;
+  requires_signoff: boolean;
+  signoff_min: number;
+  signoff_roles: string[] | null;
+  allowed_kinds: string[] | null;
+}
+
+interface Workflow {
+  workflow_id: string;
+  tenant_id: string;
+  team_id: string;
+  name: string;
+  is_active: boolean;
+  version: number;
+  created_by: string;
+  created_at: string;
+  stages: Stage[];
+  transitions: Transition[];
+}
+
+interface WorkflowSettingsClientProps {
+  workflow: Workflow;
+  teamRoles: string[];
+}
+
+const WORK_KINDS = ["story", "epic", "milestone"] as const;
+
+export function WorkflowSettingsClient({
+  workflow,
+  teamRoles,
+}: WorkflowSettingsClientProps) {
+  const router = useRouter();
+
+  // Active view state derived from workflow prop.
+  const stageById = new Map(workflow.stages.map((s) => [s.stage_id, s]));
+
+  // Create form state
+  const [createName, setCreateName] = useState("");
+  const [createStages, setCreateStages] = useState<string[]>([]);
+  const [createTransitions, setCreateTransitions] = useState<WorkflowTransition[]>([]);
+  const [createErrors, setCreateErrors] = useState<Record<string, string>>({});
+  const [createBanner, setCreateBanner] = useState("");
+  const [createdWorkflowId, setCreatedWorkflowId] = useState<string | null>(null);
+  const [activating, setActivating] = useState(false);
+  const [creating, setCreating] = useState(false);
+
+  // Remap form state
+  const [mapKey, setMapKey] = useState("");
+  const [remapRows, setRemapRows] = useState<{ old: string; neu: string }[]>([
+    { old: "", neu: "" },
+  ]);
+  const [remapBanner, setRemapBanner] = useState("");
+  const [remapToast, setRemapToast] = useState("");
+  const [remapping, setRemapping] = useState(false);
+
+  async function handleCreate(e: React.FormEvent) {
+    e.preventDefault();
+    setCreateErrors({});
+    setCreateBanner("");
+    setCreatedWorkflowId(null);
+    setCreating(true);
+    try {
+      const body = {
+        name: createName,
+        stages: createStages.map((name, idx) => ({
+          name,
+          ordinal: idx,
+          is_initial: false,
+          is_terminal: false,
+        })),
+        transitions: createTransitions.map((t) => ({
+          from_stage: t.from_stage === "any" ? null : t.from_stage,
+          to_stage: t.to_stage,
+          requires_reason: t.requires_reason,
+          requires_signoff: t.requires_signoff,
+          signoff_min: t.signoff_min,
+          signoff_roles: t.signoff_roles,
+          allowed_kinds: t.allowed_kinds,
+        })),
+      };
+      const res = await fetch(`/api/web/teams/${workflow.team_id}/workflow`, {
+        method: "POST",
+        headers: csrfHeaders({ "Content-Type": "application/json" }),
+        body: JSON.stringify(body),
+        credentials: "same-origin",
+      });
+      if (res.ok) {
+        const data = (await res.json()) as { workflow_id: string };
+        setCreatedWorkflowId(data.workflow_id);
+        router.refresh();
+      } else if (res.status === 422) {
+        const data = (await res.json()) as { detail?: unknown };
+        const errs: Record<string, string> = {};
+        if (Array.isArray(data.detail)) {
+          for (const d of data.detail as { loc?: unknown[]; msg?: string }[]) {
+            const path = Array.isArray(d.loc) ? d.loc.join(".") : "field";
+            errs[path] = d.msg ?? "invalid";
+          }
+        } else if (typeof data.detail === "string") {
+          setCreateBanner(data.detail);
+        }
+        setCreateErrors(errs);
+      } else {
+        const data = (await res.json().catch(() => ({}))) as {
+          message?: string;
+          code?: string;
+          detail?: unknown;
+        };
+        setCreateBanner(
+          data.code || data.message
+            ? `${data.code ?? ""} ${data.message ?? ""}`.trim()
+            : `HTTP ${res.status}`
+        );
+      }
+    } catch (err) {
+      setCreateBanner(err instanceof Error ? err.message : "unknown error");
+    } finally {
+      setCreating(false);
+    }
+  }
+
+  async function handleActivate() {
+    if (!createdWorkflowId) return;
+    setActivating(true);
+    setCreateBanner("");
+    try {
+      const res = await fetch(
+        `/api/web/teams/${workflow.team_id}/workflow/${createdWorkflowId}/activate`,
+        {
+          method: "POST",
+          headers: csrfHeaders(),
+          credentials: "same-origin",
+        }
+      );
+      if (res.ok) {
+        router.refresh();
+      } else {
+        const data = (await res.json().catch(() => ({}))) as {
+          message?: string;
+          code?: string;
+        };
+        setCreateBanner(
+          `${data.code ?? ""} ${data.message ?? ""}`.trim() || `HTTP ${res.status}`
+        );
+      }
+    } finally {
+      setActivating(false);
+    }
+  }
+
+  async function handleRemap(e: React.FormEvent) {
+    e.preventDefault();
+    setRemapBanner("");
+    setRemapToast("");
+    setRemapping(true);
+    try {
+      const mappings: Record<string, string> = {};
+      for (const row of remapRows) {
+        if (row.old.trim() && row.neu.trim()) {
+          mappings[row.old.trim()] = row.neu.trim();
+        }
+      }
+      const body = { map_key: mapKey, mappings };
+      const res = await fetch(`/api/web/teams/${workflow.team_id}/workflow/remap`, {
+        method: "POST",
+        headers: csrfHeaders({ "Content-Type": "application/json" }),
+        body: JSON.stringify(body),
+        credentials: "same-origin",
+      });
+      if (res.ok) {
+        const data = (await res.json()) as { updated_count: number };
+        setRemapToast(`Updated ${data.updated_count} items`);
+        router.refresh();
+      } else if (res.status === 422) {
+        const data = (await res.json()) as { detail?: unknown };
+        setRemapBanner(
+          typeof data.detail === "string" ? data.detail : `HTTP ${res.status}`
+        );
+      } else {
+        const data = (await res.json().catch(() => ({}))) as {
+          message?: string;
+          code?: string;
+        };
+        setRemapBanner(
+          `${data.code ?? ""} ${data.message ?? ""}`.trim() || `HTTP ${res.status}`
+        );
+      }
+    } catch (err) {
+      setRemapBanner(err instanceof Error ? err.message : "unknown error");
+    } finally {
+      setRemapping(false);
+    }
+  }
+
+  return (
+    <div className="space-y-8">
+      {/* Active view */}
+      <section className="space-y-3">
+        <h2 className="text-xl font-semibold">Active workflow: {workflow.name}</h2>
+        <div className="text-sm text-gray-600">
+          version {workflow.version} {workflow.is_active ? "(active)" : ""}
+        </div>
+        <div>
+          <h3 className="font-medium">Stages (ordered)</h3>
+          <ol className="list-decimal pl-5 space-y-1">
+            {workflow.stages
+              .slice()
+              .sort((a, b) => a.ordinal - b.ordinal)
+              .map((s) => (
+                <li key={s.stage_id}>
+                  {s.name}
+                  {s.is_initial ? " [initial]" : ""}
+                  {s.is_terminal ? " [terminal]" : ""} (ordinal {s.ordinal})
+                </li>
+              ))}
+          </ol>
+        </div>
+        <div>
+          <h3 className="font-medium">Transitions</h3>
+          <table className="w-full text-sm border">
+            <thead>
+              <tr>
+                <th className="border px-2">from</th>
+                <th className="border px-2">to</th>
+                <th className="border px-2">requires_reason</th>
+                <th className="border px-2">requires_signoff</th>
+                <th className="border px-2">signoff_min</th>
+                <th className="border px-2">signoff_roles</th>
+                <th className="border px-2">allowed_kinds</th>
+              </tr>
+            </thead>
+            <tbody>
+              {workflow.transitions.map((t) => (
+                <tr key={t.transition_id}>
+                  <td className="border px-2">
+                    {t.from_stage_id
+                      ? stageById.get(t.from_stage_id)?.name ?? t.from_stage_id
+                      : "any"}
+                  </td>
+                  <td className="border px-2">
+                    {stageById.get(t.to_stage_id)?.name ?? t.to_stage_id}
+                  </td>
+                  <td className="border px-2">{String(t.requires_reason)}</td>
+                  <td className="border px-2">{String(t.requires_signoff)}</td>
+                  <td className="border px-2">{t.signoff_min}</td>
+                  <td className="border px-2">
+                    {(t.signoff_roles ?? []).join(", ")}
+                  </td>
+                  <td className="border px-2">
+                    {(t.allowed_kinds ?? []).join(", ")}
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      </section>
+
+      {/* Create form */}
+      <section className="border rounded p-4 space-y-3">
+        <h2 className="text-xl font-semibold">Create workflow</h2>
+        <form onSubmit={handleCreate} className="space-y-3">
+          <div>
+            <label className="block text-sm font-medium">Name</label>
+            <input
+              type="text"
+              value={createName}
+              onChange={(e) => setCreateName(e.target.value)}
+              className="border rounded px-2 py-1 w-full"
+            />
+            {createErrors["body.name"] || createErrors["name"] ? (
+              <p className="text-red-600 text-xs">
+                {createErrors["body.name"] ?? createErrors["name"]}
+              </p>
+            ) : null}
+          </div>
+
+          <WorkflowEditor
+            stages={createStages}
+            teamRoles={teamRoles}
+            workKinds={WORK_KINDS}
+            onStagesChange={setCreateStages}
+            onTransitionsChange={setCreateTransitions}
+          />
+
+          {Object.keys(createErrors).length > 0 && (
+            <div className="text-red-600 text-xs">
+              {Object.entries(createErrors).map(([k, v]) => (
+                <div key={k}>
+                  {k}: {v}
+                </div>
+              ))}
+            </div>
+          )}
+          {createBanner && <p className="text-red-600 text-sm">{createBanner}</p>}
+
+          <button
+            type="submit"
+            disabled={creating}
+            className="bg-blue-600 text-white rounded px-4 py-2 disabled:opacity-50"
+          >
+            {creating ? "Creating…" : "Create"}
+          </button>
+        </form>
+
+        {createdWorkflowId && (
+          <div className="space-y-2">
+            <p className="text-green-700 text-sm">
+              Created workflow: {createdWorkflowId}
+            </p>
+            <button
+              type="button"
+              onClick={handleActivate}
+              disabled={activating}
+              className="bg-green-600 text-white rounded px-4 py-2 disabled:opacity-50"
+            >
+              {activating ? "Activating…" : "Activate"}
+            </button>
+          </div>
+        )}
+      </section>
+
+      {/* Remap form */}
+      <section className="border rounded p-4 space-y-3">
+        <h2 className="text-xl font-semibold">Remap stages</h2>
+        <form onSubmit={handleRemap} className="space-y-3">
+          <div>
+            <label className="block text-sm font-medium">Map key</label>
+            <input
+              type="text"
+              value={mapKey}
+              onChange={(e) => setMapKey(e.target.value)}
+              className="border rounded px-2 py-1 w-full"
+            />
+          </div>
+          <div className="space-y-2">
+            {remapRows.map((row, idx) => (
+              <div key={idx} className="flex gap-2">
+                <input
+                  type="text"
+                  placeholder="old stage"
+                  value={row.old}
+                  onChange={(e) => {
+                    const next = [...remapRows];
+                    next[idx] = { ...next[idx], old: e.target.value };
+                    setRemapRows(next);
+                  }}
+                  className="border rounded px-2 py-1 flex-1"
+                />
+                <span>→</span>
+                <input
+                  type="text"
+                  placeholder="new stage"
+                  value={row.neu}
+                  onChange={(e) => {
+                    const next = [...remapRows];
+                    next[idx] = { ...next[idx], neu: e.target.value };
+                    setRemapRows(next);
+                  }}
+                  className="border rounded px-2 py-1 flex-1"
+                />
+                <button
+                  type="button"
+                  onClick={() =>
+                    setRemapRows((prev) => prev.filter((_, i) => i !== idx))
+                  }
+                  className="text-red-600 text-sm"
+                >
+                  remove
+                </button>
+              </div>
+            ))}
+            <button
+              type="button"
+              onClick={() => setRemapRows((prev) => [...prev, { old: "", neu: "" }])}
+              className="bg-blue-600 text-white rounded px-3 py-1 text-sm"
+            >
+              Add mapping
+            </button>
+          </div>
+          {remapBanner && <p className="text-red-600 text-sm">{remapBanner}</p>}
+          {remapToast && <p className="text-green-700 text-sm">{remapToast}</p>}
+          <button
+            type="submit"
+            disabled={remapping}
+            className="bg-blue-600 text-white rounded px-4 py-2 disabled:opacity-50"
+          >
+            {remapping ? "Remapping…" : "Remap"}
+          </button>
+        </form>
+      </section>
+    </div>
+  );
+}
