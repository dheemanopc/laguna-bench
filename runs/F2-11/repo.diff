@@ -0,0 +1,75 @@
+import { notFound } from "next/navigation";
+import { serverApiFetchResult } from "@/lib/server-api";
+import { BoardRefreshProvider } from "./BoardContext";
+import BoardView, { type BoardItem, type Stage } from "./BoardView";
+
+export const dynamic = "force-dynamic";
+
+interface WorkListOutput {
+  team_id: string;
+  items: BoardItem[];
+}
+
+interface WorkflowOutput {
+  stages: Stage[];
+}
+
+export default async function BoardPage({
+  params,
+}: {
+  params: Promise<{ key: string }>;
+}) {
+  const { key } = await params;
+  const mapKey = decodeURIComponent(key);
+
+  const wl = await serverApiFetchResult<WorkListOutput>(
+    `/api/web/mindmaps/${encodeURIComponent(mapKey)}/work-items`,
+    { redirectTo: `/mindmaps/${key}/board` },
+  );
+
+  if (wl.status === 404 || !wl.ok || !wl.data) {
+    if (wl.status === 404) notFound();
+    // non-401/404 failure -> distinct error state
+    return (
+      <main className="mx-auto max-w-[1400px] px-4 py-6">
+        <div className="rounded border border-rose-300 bg-rose-50 px-4 py-3 text-rose-800">
+          Failed to load board ({wl.status}). Please retry.
+        </div>
+      </main>
+    );
+  }
+  // 401 handled by redirect inside helper
+  const workList = wl.data;
+
+  const teamId = workList.team_id;
+  const wf = await serverApiFetchResult<WorkflowOutput>(
+    `/api/web/teams/${teamId}/workflow`,
+    { redirectTo: `/mindmaps/${key}/board` },
+  );
+  // Fall back to empty stages on 404 / not-found / no active workflow.
+  let stages: Stage[] = [];
+  if (wf.ok && wf.data) {
+    stages = wf.data.stages ?? [];
+  } else if (wf.status !== 404 && wf.status !== 401) {
+    return (
+      <main className="mx-auto max-w-[1400px] px-4 py-6">
+        <div className="rounded border border-rose-300 bg-rose-50 px-4 py-3 text-rose-800">
+          Failed to load workflow ({wf.status}). Please retry.
+        </div>
+      </main>
+    );
+  }
+
+  return (
+    <main className="mx-auto max-w-[1400px] px-4 py-6">
+      <BoardRefreshProvider>
+        <BoardView
+          items={workList.items}
+          stages={stages}
+          mapKey={mapKey}
+          teamId={teamId}
+        />
+      </BoardRefreshProvider>
+    </main>
+  );
+}
