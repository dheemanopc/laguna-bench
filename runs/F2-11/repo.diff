+"use client";
+
+import { useEffect, useState } from "react";
+import { useRouter } from "next/navigation";
+import { useBoardRefresh } from "./BoardContext";
+import { csrfHeaders } from "@/lib/csrf";
+
+export interface ItemDetailProps {
+  item?: unknown;
+  mapKey?: string;
+  stages?: unknown[];
+  onClose?: () => void;
+}
+
+interface MoveItem {
+  to_stage: string;
+  signoff_min?: number;
+  blocked_reason?: string | null;
+  requires_signoff?: boolean;
+}
+
+interface PendingSignoff {
+  request_id?: string;
+  signatory_count: number;
+  signoff_min: number;
+  remaining?: number;
+}
+
+interface Item {
+  node_id: string;
+  title: string;
+  status: string;
+  current_stage: string | null;
+  allowed_moves: MoveItem[];
+  blocked_reason: string | null;
+  pending_signoff: PendingSignoff | null;
+  assignee_id?: string | null;
+  created_at?: string;
+  updated_at?: string;
+}
+
+interface HistoryEntry {
+  id: number;
+  change_type: string;
+  stage_before: string | null;
+  stage_after: string | null;
+  workflow_id: string | null;
+  status_before?: string | null;
+  status_after?: string;
+  created_at?: string;
+}
+
+export default function ItemDetail({ item, mapKey, onClose }: ItemDetailProps) {
+  const router = useRouter();
+  const { bumpRefresh } = useBoardRefresh();
+  const it = (item ?? {}) as Item;
+  const nodeId = it.node_id;
+  const mk = mapKey ?? "";
+
+  const [toStage, setToStage] = useState<string>(
+    it.allowed_moves?.[0]?.to_stage ?? "",
+  );
+  const [reason, setReason] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [confirmOpen, setConfirmOpen] = useState(false);
+  const [pending, setPending] = useState<PendingSignoff | null>(
+    it.pending_signoff ?? null,
+  );
+  const [history, setHistory] = useState<HistoryEntry[]>([]);
+
+  // Re-derive seeded state when the item changes (e.g. after refresh).
+  useEffect(() => {
+    setToStage(it.allowed_moves?.[0]?.to_stage ?? "");
+    setReason("");
+    setPending(it.pending_signoff ?? null);
+    setError(null);
+  }, [nodeId, it]);
+
+  useEffect(() => {
+    let cancelled = false;
+    (async () => {
+      try {
+        const res = await fetch(
+          `/api/web/mindmaps/${encodeURIComponent(mk)}/work-items/${nodeId}/history`,
+          { credentials: "same-origin" },
+        );
+        if (res.status === 401) {
+          router.push(`/auth/login?next=${encodeURIComponent(window.location.pathname)}`);
+          return;
+        }
+        if (!res.ok) {
+          const body = (await res.json().catch(() => null)) as
+            | { detail?: { message?: string }; message?: string }
+            | null;
+          const msg = body?.detail?.message ?? body?.message ?? `Failed (${res.status})`;
+          if (!cancelled) setError(msg);
+          return;
+        }
+        const data = await res.json();
+        if (!cancelled) {
+          setHistory(Array.isArray(data) ? (data as HistoryEntry[]) : []);
+        }
+      } catch {
+        if (!cancelled) setError("Network error");
+      }
+    })();
+    return () => {
+      cancelled = true;
+    };
+  }, [mk, nodeId]);
+
+  const selectedMove = it.allowed_moves?.find((m) => m.to_stage === toStage);
+  const needsReason =
+    selectedMove?.blocked_reason === "reason_required" ||
+    selectedMove?.blocked_reason === "reason-required";
+  const needsSignoff = (selectedMove?.signoff_min ?? 0) > 0 || !!selectedMove?.requires_signoff;
+
+  const humanBlocked = (code: string | null | undefined): string => {
+    switch (code) {
+      case "reason_required":
+        return "a reason is required";
+      case "role_restricted":
+        return "role-restricted";
+      case "no_transition":
+        return "no moves";
+      default:
+        return code ?? "";
+    }
+  };
+
+  async function doMove() {
+    setError(null);
+    setBusy(true);
+    try {
+      const res = await fetch(
+        `/api/web/mindmaps/${encodeURIComponent(mk)}/work-items/${nodeId}/move`,
+        {
+          method: "POST",
+          headers: csrfHeaders({ "Content-Type": "application/json" }),
+          credentials: "same-origin",
+          body: JSON.stringify({
+            to_stage: toStage,
+            reason: reason.trim() ? reason : undefined,
+            expected_stage: it.current_stage ?? undefined,
+          }),
+        },
+      );
+      if (res.status === 401) {
+        router.push(`/auth/login?next=${encodeURIComponent(window.location.pathname)}`);
+        return;
+      }
+      if (!res.ok) {
+        const body = await res.json().catch(() => null);
+        const code = body?.detail?.code;
+        const msg = body?.detail?.message;
+        setError(
+          code && msg ? `${code}: ${msg}` : msg ?? `Failed (${res.status})`,
+        );
+        return;
+      }
+      const data = await res.json();
+      if (data.awaiting_signoff) {
+        setPending({
+          request_id: data.request_id,
+          signatory_count: 0,
+          signoff_min: data.signoff_min ?? pending?.signoff_min ?? 0,
+          remaining: data.signoff_min ?? pending?.signoff_min ?? 0,
+        });
+        bumpRefresh();
+      } else {
+        bumpRefresh();
+        onClose?.();
+      }
+    } catch {
+      setError("Network error — nothing was written.");
+    } finally {
+      setBusy(false);
+      setConfirmOpen(false);
+    }
+  }
+
+  function handleMoveClick() {
+    if (needsSignoff && !confirmOpen) {
+      setConfirmOpen(true);
+      return;
+    }
+    doMove();
+  }
+
+  async function doSignoff() {
+    if (!pending?.request_id) return;
+    setError(null);
+    setBusy(true);
+    try {
+      const res = await fetch(
+        `/api/web/mindmaps/${encodeURIComponent(mk)}/work-items/${nodeId}/signoff`,
+        {
+          method: "POST",
+          headers: csrfHeaders({ "Content-Type": "application/json" }),
+          credentials: "same-origin",
+          body: JSON.stringify({ request_id: pending.request_id }),
+        },
+      );
+      if (res.status === 401) {
+        router.push(`/auth/login?next=${encodeURIComponent(window.location.pathname)}`);
+        return;
+      }
+      if (!res.ok) {
+        const body = await res.json().catch(() => null);
+        const code = body?.detail?.code;
+        const msg = body?.detail?.message;
+        setError(
+          code && msg
+            ? `${code}: ${msg}`
+            : msg ?? `Failed (${res.status})`,
+        );
+        return;
+      }
+      const data = await res.json();
+      if (data.committed) {
+        bumpRefresh();
+        onClose?.();
+      } else {
+        setPending((p) =>
+          p
+            ? {
+                ...p,
+                signatory_count: data.signed_count ?? p.signatory_count,
+                signoff_min: data.signoff_min ?? p.signoff_min,
+                remaining:
+                  (data.signoff_min ?? p.signoff_min) -
+                  (data.signed_count ?? p.signatory_count),
+              }
+            : p,
+        );
+        bumpRefresh();
+      }
+    } catch {
+      setError("Network error — nothing was written.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
+      <div className="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-lg bg-white p-4 shadow-xl dark:bg-slate-900">
+        <div className="mb-3 flex items-start justify-between">
+          <div>
+            <h2 className="text-lg font-semibold">{it.title}</h2>
+            <div className="text-xs text-slate-500">
+              {it.status} · {it.current_stage ?? "unmapped"} · assignee{" "}
+              {it.assignee_id ?? "—"}
+            </div>
+            <div className="text-xs text-slate-400">
+              {it.created_at && <>created {it.created_at} · </>}
+              {it.updated_at && <>updated {it.updated_at}</>}
+            </div>
+          </div>
+          <button
+            onClick={() => onClose?.()}
+            className="text-slate-500 hover:text-slate-900"
+          >
+            ✕
+          </button>
+        </div>
+
+        {error && (
+          <div className="mb-3 rounded border border-rose-300 bg-rose-50 px-3 py-2 text-sm text-rose-800">
+            {error}
+          </div>
+        )}
+
+        {it.blocked_reason && (
+          <div className="mb-3 text-xs text-rose-600">
+            blocked: {humanBlocked(it.blocked_reason)}
+          </div>
+        )}
+        {selectedMove?.blocked_reason && selectedMove.blocked_reason !== it.blocked_reason && (
+          <div className="mb-3 text-xs text-rose-600">
+            {humanBlocked(selectedMove.blocked_reason)}
+          </div>
+        )}
+
+        {/* Move section */}
+        <section className="mb-4">
+          <h3 className="mb-1 text-sm font-semibold">Move</h3>
+          <select
+            className="w-full rounded border p-1 text-sm"
+            value={toStage}
+            onChange={(e) => setToStage(e.target.value)}
+          >
+            {(it.allowed_moves ?? []).map((m) => (
+              <option key={m.to_stage} value={m.to_stage}>
+                {m.to_stage}
+              </option>
+            ))}
+          </select>
+          {needsReason && (
+            <textarea
+              className="mt-2 w-full rounded border p-2 text-sm"
+              rows={3}
+              value={reason}
+              onChange={(e) => setReason(e.target.value)}
+              placeholder="Reason (required)"
+            />
+          )}
+          {confirmOpen && needsSignoff && (
+            <div className="mt-2 rounded border border-amber-300 bg-amber-50 p-2 text-sm">
+              This move requires sign-off from {selectedMove?.signoff_min ?? 0}{" "}
+              person(s). Confirm?
+              <div className="mt-2 flex gap-2">
+                <button
+                  onClick={doMove}
+                  disabled={busy}
+                  className="rounded bg-slate-900 px-3 py-1 text-sm text-white disabled:opacity-40"
+                >
+                  {busy ? "…" : "Confirm"}
+                </button>
+                <button
+                  onClick={() => setConfirmOpen(false)}
+                  className="rounded px-3 py-1 text-sm"
+                >
+                  Cancel
+                </button>
+              </div>
+            </div>
+          )}
+          {!confirmOpen && (
+            <button
+              onClick={handleMoveClick}
+              disabled={busy || !toStage || (needsReason && !reason.trim())}
+              className="mt-2 rounded bg-slate-900 px-3 py-1.5 text-sm font-medium text-white disabled:opacity-40"
+            >
+              {busy ? "Moving…" : "Move"}
+            </button>
+          )}
+        </section>
+
+        {/* Signoff panel */}
+        {pending && (
+          <section className="mb-4 rounded border border-amber-200 bg-amber-50 p-2">
+            <h3 className="text-sm font-semibold">Pending sign-off</h3>
+            <div className="text-xs">
+              {pending.signatory_count} of {pending.signoff_min} signed
+              {typeof pending.remaining === "number" && (
+                <> · {pending.remaining} remaining</>
+              )}
+            </div>
+            <button
+              onClick={doSignoff}
+              disabled={busy}
+              className="mt-2 rounded bg-slate-900 px-3 py-1.5 text-sm font-medium text-white disabled:opacity-40"
+            >
+              {busy ? "…" : "Sign"}
+            </button>
+          </section>
+        )}
+
+        {/* History */}
+        <section>
+          <h3 className="mb-1 text-sm font-semibold">History</h3>
+          <ul className="space-y-1 text-xs">
+            {history.map((h) => (
+              <li key={h.id} className="rounded border p-1">
+                <span className="font-medium">{h.change_type}</span>
+                {h.stage_before != null || h.stage_after != null ? (
+                  <span>
+                    {" "}
+                    {h.stage_before ?? "—"} → {h.stage_after ?? "—"}
+                  </span>
+                ) : null}
+                {h.workflow_id && (
+                  <span className="ml-1 text-slate-400">
+                    (wf {h.workflow_id})
+                  </span>
+                )}
+              </li>
+            ))}
+            {history.length === 0 && (
+              <li className="text-slate-400">No history.</li>
+            )}
+          </ul>
+        </section>
+      </div>
+    </div>
+  );
+}
