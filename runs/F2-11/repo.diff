+import { notFound } from "next/navigation";
+import { serverApiFetchResult } from "@/lib/server-api";
+import { WorkflowSettingsClient } from "./WorkflowSettingsClient";
+
+interface Stage {
+  stage_id: string;
+  workflow_id: string;
+  name: string;
+  ordinal: number;
+  is_initial: boolean;
+  is_terminal: boolean;
+}
+
+interface Transition {
+  transition_id: string;
+  workflow_id: string;
+  from_stage_id: string | null;
+  to_stage_id: string;
+  requires_reason: boolean;
+  requires_signoff: boolean;
+  signoff_min: number;
+  signoff_roles: string[] | null;
+  allowed_kinds: string[] | null;
+}
+
+interface Workflow {
+  workflow_id: string;
+  tenant_id: string;
+  team_id: string;
+  name: string;
+  is_active: boolean;
+  version: number;
+  created_by: string;
+  created_at: string;
+  stages: Stage[];
+  transitions: Transition[];
+}
+
+interface Member {
+  tenant_id: string;
+  role: string;
+  status: string;
+  added_at: string;
+  identity_email: string | null;
+  provider: string | null;
+}
+
+interface MembersResponse {
+  members: Member[];
+  invites: unknown[];
+}
+
+export default async function WorkflowSettingsPage({
+  params,
+}: {
+  params: Promise<{ team_id: string }>;
+}) {
+  const { team_id } = await params;
+
+  const wfRes = await serverApiFetchResult<Workflow>(
+    `/api/web/teams/${team_id}/workflow`,
+    { redirectTo: `/teams/${team_id}/workflow` }
+  );
+  if (!wfRes.ok || !wfRes.data) {
+    if (wfRes.status === 404) notFound();
+    notFound();
+  }
+
+  const memRes = await serverApiFetchResult<MembersResponse>(
+    `/api/web/teams/${team_id}/members`,
+    { redirectTo: `/teams/${team_id}/workflow` }
+  );
+  if (!memRes.ok || !memRes.data) {
+    if (memRes.status === 404) notFound();
+    notFound();
+  }
+
+  const teamRoles = Array.from(
+    new Set(memRes.data.members.map((m) => m.role))
+  );
+
+  return (
+    <main className="mx-auto max-w-5xl px-4 py-8 space-y-6">
+      <h1 className="text-2xl font-bold">Team workflow</h1>
+      <WorkflowSettingsClient workflow={wfRes.data} teamRoles={teamRoles} />
+    </main>
+  );
+}
