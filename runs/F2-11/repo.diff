+"use client";
+
+import { useEffect, useState } from "react";
+import { useRouter } from "next/navigation";
+import { useBoardRefresh } from "./BoardContext";
+import { csrfHeaders } from "@/lib/csrf";
+
+export interface WaitingOnYouProps {
+  mapKey?: string;
+  teamId?: string;
+  items?: { node_id: string; title: string }[];
+}
+
+interface PendingRow {
+  request_id: string;
+  node_id: string;
+  from_stage: string;
+  to_stage: string;
+  reason: string | null;
+  signoff_min: number;
+  signatory_count: number;
+  remaining: number;
+}
+
+interface SignoffResponse {
+  committed: boolean;
+  signed_count: number;
+  signoff_min: number;
+}
+
+export default function WaitingOnYou({ mapKey, teamId, items }: WaitingOnYouProps) {
+  const router = useRouter();
+  const { boardRefreshKey, bumpRefresh } = useBoardRefresh();
+  const [open, setOpen] = useState(true);
+  const [rows, setRows] = useState<PendingRow[]>([]);
+  const [error, setError] = useState<string | null>(null);
+  const [signing, setSigning] = useState<string | null>(null);
+
+  const itemTitle = (nodeId: string): string => {
+    const it = (items ?? []).find((x) => x.node_id === nodeId);
+    return it?.title ?? nodeId;
+  };
+
+  useEffect(() => {
+    if (!teamId) return;
+    let cancelled = false;
+    async function load() {
+      try {
+        const res = await fetch(
+          `/api/web/teams/${encodeURIComponent(teamId!)}/workflow/pending-signoffs`,
+          { credentials: "same-origin" },
+        );
+        if (res.status === 401) {
+          router.push(`/auth/login?next=${encodeURIComponent(window.location.pathname)}`);
+          return;
+        }
+        if (!res.ok) {
+          const body = (await res.json().catch(() => null)) as { detail?: { message?: string } } | null;
+          if (!cancelled) setError(body?.detail?.message ?? `Failed (${res.status})`);
+          return;
+        }
+        const data = (await res.json()) as PendingRow[];
+        if (!cancelled) {
+          setRows(data);
+          setError(null);
+        }
+      } catch {
+        if (!cancelled) setError("Network error");
+      }
+    }
+    void load();
+    return () => {
+      cancelled = true;
+    };
+  }, [teamId, boardRefreshKey, router]);
+
+  async function sign(row: PendingRow) {
+    if (!mapKey) return;
+    setSigning(row.request_id);
+    setError(null);
+    try {
+      const res = await fetch(
+        `/api/web/mindmaps/${encodeURIComponent(mapKey)}/work-items/${encodeURIComponent(row.node_id)}/signoff`,
+        {
+          method: "POST",
+          headers: csrfHeaders({ "Content-Type": "application/json" }),
+          credentials: "same-origin",
+          body: JSON.stringify({ request_id: row.request_id }),
+        },
+      );
+      if (res.status === 401) {
+        router.push(`/auth/login?next=${encodeURIComponent(window.location.pathname)}`);
+        return;
+      }
+      if (!res.ok) {
+        const body = (await res.json().catch(() => null)) as
+          | { detail?: { code?: string; message?: string }; code?: string; message?: string }
+          | null;
+        const code = body?.detail?.code ?? body?.code;
+        const msg = body?.detail?.message ?? body?.message ?? `Failed (${res.status})`;
+        setError(code === "signoff_complete" ? `signoff_complete: ${msg}` : msg);
+        return;
+      }
+      const data = (await res.json()) as SignoffResponse;
+      if (data.committed) {
+        bumpRefresh();
+      } else {
+        setRows((prev) =>
+          prev.map((r) =>
+            r.request_id === row.request_id
+              ? {
+                  ...r,
+                  signatory_count: data.signed_count,
+                  signoff_min: data.signoff_min,
+                  remaining: data.signoff_min - data.signed_count,
+                }
+              : r,
+          ),
+        );
+      }
+    } catch {
+      setError("Network error");
+    } finally {
+      setSigning(null);
+    }
+  }
+
+  if (!teamId) return null;
+
+  return (
+    <div className="mt-4 rounded border p-2">
+      <button type="button" onClick={() => setOpen((o) => !o)} className="font-semibold">
+        {open ? "▼" : "▶"} Waiting on you ({rows.length})
+      </button>
+      {error && <div className="text-xs text-rose-600">{error}</div>}
+      {open && (
+        <ul className="mt-2 space-y-2">
+          {rows.map((r) => (
+            <li key={r.request_id} className="rounded border p-2 text-xs">
+              <div>
+                {r.from_stage} → {r.to_stage}
+              </div>
+              <div className="truncate">{itemTitle(r.node_id)}</div>
+              {r.reason && <div>{r.reason}</div>}
+              <div>
+                awaiting {r.signatory_count} of {r.signoff_min} (remaining {r.remaining})
+              </div>
+              <button
+                type="button"
+                disabled={signing === r.request_id}
+                onClick={() => void sign(r)}
+                className="mt-1 rounded bg-slate-900 px-2 py-1 text-white disabled:opacity-40"
+              >
+                {signing === r.request_id ? "Signing…" : "Sign"}
+              </button>
+            </li>
+          ))}
+          {rows.length === 0 && <li className="text-xs text-slate-500">Nothing waiting.</li>}
+        </ul>
+      )}
+    </div>
+  );
+}
