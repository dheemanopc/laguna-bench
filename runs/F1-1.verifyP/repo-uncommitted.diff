+"""
+V3 [BLOCKER] Full suite vs. pre-existing failures.
+Run the full test suite and compare failures with KNOWN_RED_BASE.txt.
+Any new failure (not in KNOWN_RED_BASE.txt) causes V3 to FAIL.
+"""
+import subprocess
+import sys
+import os
+import re
+
+
+def run_full_test_suite():
+    """Run the full test suite and return list of failed test names."""
+    cmd = [sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider"]
+    result = subprocess.run(
+        cmd,
+        capture_output=True,
+        text=True,
+        cwd="/home/anand/laguna-bench/runs/F1-1.verifyP/repo"
+    )
+    # Combine stdout and stderr to catch all output
+    output = result.stdout + result.stderr
+
+    # Parse failed tests from output
+    # Pattern: FAILED <module>::<class>::<test> or FAILED <module>::<test>
+    failed_tests = []
+    lines = output.split('\n')
+    for line in lines:
+        if line.startswith('FAILED'):
+            # Extract the test name after 'FAILED '
+            test_name = line.split('FAILED ', 1)[1].strip()
+            # Sometimes there are extra spaces or trailing info, take first part
+            test_name = test_name.split()[0]
+            failed_tests.append(test_name)
+        elif line.startswith('ERROR'):
+            # Also consider errors as failures for this check
+            test_name = line.split('ERROR ', 1)[1].strip()
+            test_name = test_name.split()[0]
+            failed_tests.append(test_name)
+
+    return failed_tests, output
+
+
+def read_known_red_base():
+    """Read KNOWN_RED_BASE.txt and return set of known failing test names."""
+    known_failures = set()
+    known_base_path = "/home/anand/laguna-bench/runs/F1-1.verifyP/repo/KNOWN_RED_BASE.txt"
+    if not os.path.exists(known_base_path):
+        return known_failures
+    with open(known_base_path, 'r') as f:
+        for line in f:
+            line = line.strip()
+            if line and not line.startswith('#'):
+                # Extract test name (first part before any spaces or colons?)
+                # The file contains full test IDs like:
+                # tests/security/test_scope_enforcement.py::TestStatsToolScopes::test_stats_tool_requires_read_scope
+                known_failures.add(line)
+    return known_failures
+
+
+def test_v3_full_vs_preexisting():
+    """Main test for V3."""
+    failed_tests, output = run_full_test_suite()
+    known_failures = read_known_red_base()
+
+    new_failures = []
+    for test in failed_tests:
+        if test not in known_failures:
+            new_failures.append(test)
+
+    # Print summary
+    print(f"Total tests run: check pytest output above")
+    print(f"Number of failed/error tests: {len(failed_tests)}")
+    print(f"Number of known pre-existing failures: {len(known_failures)}")
+    print(f"Number of new failures: {len(new_failures)}")
+
+    if new_failures:
+        print("New failures detected:")
+        for test in new_failures:
+            print(f"  {test}")
+        # Fail the test
+        assert False, f"Found {len(new_failures)} new test failures, see above"
+    else:
+        print("All failures are pre-existing (or no new failures).")
+        # Also check that we didn't miss any known failures? Not required.
+        # But we can note if there are known failures that are now passing (not required by spec)
+        pass
+
+
+if __name__ == "__main__":
+    test_v3_full_vs_preexisting()
