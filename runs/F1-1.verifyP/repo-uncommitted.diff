+import os
+
+
+def test_ruff_format_check():
+    """Check ruff format on new/changed files."""
+    changed_files = [
+        "alembic/versions/0046_2026_10_16_mindmap_work_items.py",
+        "alembic/versions/0047_2026_10_16_work_item_history_rls_fix.py",
+        "src/mem_mcp/audit/logger.py",
+        "src/mem_mcp/main.py",
+        "src/mem_mcp/mcp/tool_descriptions.py",
+        "src/mem_mcp/mcp/tools/_work_item_common.py",
+        "src/mem_mcp/mcp/tools/mindmap_work_assign.py",
+        "src/mem_mcp/mcp/tools/mindmap_work_mark.py",
+        "src/mem_mcp/mcp/tools/mindmap_work_set_kind.py",
+        "src/mem_mcp/mcp/tools/mindmap_work_set_status.py",
+        "src/mem_mcp/mindmap/work_items.py",
+        "tests/integration/test_mindmap_work_items_e2e.py",
+        "tests/unit/test_work_items_service.py"
+    ]
+
+    # Check each file individually to avoid bash redirection issues
+    all_passed = True
+    for file_path in changed_files:
+        if os.path.exists(file_path):
+            result = subprocess.run(
+                ["ruff", "check", file_path],
+                capture_output=True,
+                text=True,
+                cwd="/home/anand/laguna-bench/runs/F1-1.verifyP/repo"
+            )
+            if result.returncode != 0:
+                print(f"Ruff check failed for {file_path}: {result.stderr}")
+                all_passed = False
+            else:
+                print(f"Ruff check passed for {file_path}")
+        else:
+            print(f"File not found: {file_path}")
+
+    # Check format
+    result = subprocess.run(
+        ["ruff", "format", "--check"] + changed_files,
+        capture_output=True,
+        text=True,
+        cwd="/home/anand/laguna-bench/runs/F1-1.verifyP/repo"
+    )
+    if result.returncode != 0:
+        print(f"Ruff format check failed: {result.stderr}")
+        all_passed = False
+    else:
+        print("Ruff format check passed")
+
+    return all_passed
+
+
