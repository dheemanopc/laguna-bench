+"""Unit tests for mindmap_resolve input/output models and validation.
+
+Tests validation rules without a database: field requirements, literals, length
+constraints, truncation helper, etc.
+"""
+
+from __future__ import annotations
+
+from uuid import uuid4
+
+import pytest
+from pydantic import ValidationError
+
+from mem_mcp.mcp.tools.mindmap_get import MindmapNode
+from mem_mcp.mcp.tools.mindmap_resolve import MindmapResolveInput, MindmapResolveOutput
+
+
+class TestMindmapResolveInputValidation:
+    """Validate MindmapResolveInput model constraints."""
+
+    def test_summary_required(self) -> None:
+        """resolution_summary is required."""
+        with pytest.raises(ValidationError) as exc_info:
+            MindmapResolveInput(
+                map_key="test",
+                node_id=uuid4(),
+                resolution_summary="",  # Empty string
+            )
+        assert "resolution_summary" in str(exc_info.value)
+
+    def test_summary_min_length(self) -> None:
+        """resolution_summary must be at least 1 character."""
+        with pytest.raises(ValidationError) as exc_info:
+            MindmapResolveInput(
+                map_key="test",
+                node_id=uuid4(),
+                resolution_summary="",
+            )
+        assert "resolution_summary" in str(exc_info.value)
+
+    def test_summary_max_length(self) -> None:
+        """resolution_summary must be at most 500 characters."""
+        with pytest.raises(ValidationError) as exc_info:
+            MindmapResolveInput(
+                map_key="test",
+                node_id=uuid4(),
+                resolution_summary="x" * 501,
+            )
+        assert "resolution_summary" in str(exc_info.value)
+
+    def test_disposition_literal(self) -> None:
+        """disposition must be 'resolved' or 'dropped'."""
+        with pytest.raises(ValidationError) as exc_info:
+            MindmapResolveInput(
+                map_key="test",
+                node_id=uuid4(),
+                resolution_summary="test",
+                disposition="invalid",  # type: ignore[arg-type]
+            )
+        assert "disposition" in str(exc_info.value)
+
+    def test_resolved_by_party_literal(self) -> None:
+        """resolved_by_party must be 'owner' or 'model'."""
+        with pytest.raises(ValidationError) as exc_info:
+            MindmapResolveInput(
+                map_key="test",
+                node_id=uuid4(),
+                resolution_summary="test",
+                resolved_by_party="invalid",  # type: ignore[arg-type]
+            )
+        assert "resolved_by_party" in str(exc_info.value)
+
+    def test_map_key_length(self) -> None:
+        """map_key must be 1-64 characters."""
+        # Too short
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(
+                map_key="",
+                node_id=uuid4(),
+                resolution_summary="test",
+            )
+
+        # Too long
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(
+                map_key="x" * 65,
+                node_id=uuid4(),
+                resolution_summary="test",
+            )
+
+    def test_defaults(self) -> None:
+        """Test default values."""
+        inp = MindmapResolveInput(
+            map_key="test",
+            node_id=uuid4(),
+            resolution_summary="test summary",
+        )
+        assert inp.disposition == "resolved"
+        assert inp.resolved_by_party == "model"
+        assert inp.resolved_by_memory_id is None
+        assert inp.team_id is None
+
+    def test_extra_fields_forbidden(self) -> None:
+        """Extra fields should be forbidden."""
+        with pytest.raises(ValidationError) as exc_info:
+            MindmapResolveInput(  # type: ignore[misc]
+                map_key="test",
+                node_id=uuid4(),
+                resolution_summary="test",
+                extra_field="not allowed",
+            )
+        assert "extra" in str(exc_info.value).lower()
+
+
+class TestContentTruncation:
+    """Test content truncation logic for mindmap_get."""
+
+    def test_exactly_200_chars_unchanged(self) -> None:
+        """Content of exactly 200 chars should not be truncated."""
+        content = "x" * 200
+        node = MindmapNode(
+            memory_id=uuid4(),
+            node_role="position",
+            type="note",
+            content=content,
+            metadata={},
+            created_at="2026-01-01T00:00:00",
+            status="open",
+        )
+        # When depth="summary", truncation happens in the tool, not the model
+        # The model just stores the content
+        assert len(node.content) == 200
+        assert node.truncated is False
+
+    def test_201_chars_truncated(self) -> None:
+        """Content of 201 chars should be truncated to 200 + '…'."""
+        # This is tested in the tool logic, not the model
+        # The model accepts any content
+        content = "x" * 201
+        node = MindmapNode(
+            memory_id=uuid4(),
+            node_role="position",
+            type="note",
+            content=content,
+            metadata={},
+            created_at="2026-01-01T00:00:00",
+            status="open",
+        )
+        assert len(node.content) == 201
+
+    def test_full_depth_whole_content(self) -> None:
+        """When depth='full', whole content should be returned."""
+        # This is tested in the tool logic
+        content = "x" * 1000
+        node = MindmapNode(
+            memory_id=uuid4(),
+            node_role="position",
+            type="note",
+            content=content,
+            metadata={},
+            created_at="2026-01-01T00:00:00",
+            status="open",
+        )
+        assert len(node.content) == 1000
+
+
+class TestMindmapResolveOutput:
+    """Test MindmapResolveOutput structure."""
+
+    def test_output_structure(self) -> None:
+        """Output should have all required fields."""
+        output = MindmapResolveOutput(
+            node_id=uuid4(),
+            status="resolved",
+            resolution_summary="test",
+            cursor=123,
+            request_id="req-123",
+        )
+        assert output.node_id is not None
+        assert output.status == "resolved"
+        assert output.resolution_summary == "test"
+        assert output.cursor == 123
+        assert output.request_id == "req-123"
