+"""Add per-node branch status to memory_map_membership.
+
+Every mindmap_get currently returns every node in full, with no way to mark branches
+as settled. This adds a status column ('open', 'resolved', 'dropped') plus resolution
+metadata to memory_map_membership, making it the single source of truth for whether
+a branch is open or settled. This enables:
+
+- mindmap_resolve tool: settle individual branches without closing the whole map
+- open_loops fix: only count nodes with status='open' and metadata.responsible_party='owner'
+- cheap reads on mindmap_get: skip settled nodes by default, support since/cursor
+
+Status is the ONLY source of truth; never infer it from memory_references.reference_kind
+(unvalidated free text). An edge alone never settles a branch.
+
+Revision ID: 0044_mindmap_branch_status
+Revises: 0043_backfill_personal_teams
+Create Date: 2026-10-16
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0044_mindmap_branch_status"
+down_revision = "0043_backfill_personal_teams"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    # Add status and resolution fields to memory_map_membership
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+        ADD COLUMN status TEXT NOT NULL DEFAULT 'open'
+        CONSTRAINT mm_status_check CHECK (status IN ('open','resolved','dropped'))
+        """)
+    )
+
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+        ADD COLUMN resolution_summary TEXT NULL
+        CONSTRAINT mm_resolution_summary_check
+          CHECK (resolution_summary IS NULL OR char_length(resolution_summary) BETWEEN 1 AND 500)
+        """)
+    )
+
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+        ADD COLUMN resolved_by_memory_id UUID NULL
+        REFERENCES memories(id) ON DELETE SET NULL
+        """)
+    )
+
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+        ADD COLUMN resolved_by_party TEXT NULL
+        CONSTRAINT mm_resolved_by_party_check CHECK (resolved_by_party IS NULL OR resolved_by_party IN ('owner','model'))
