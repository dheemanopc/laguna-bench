+async def test_mindmap_get_since_cursor(
+    pg_pool: Any, tenant_setup: tuple[UUID, UUID, str]
+) -> None:
+    """since parameter enables cheap incremental reads."""
+    tenant_id, team_id, _ = tenant_setup
+
+    root_id = await _create_map(pool, tenant_id, team_id, "Test Map")
+
+    # Create initial node
+    node1_id = await _create_node(
+        pool, tenant_id, team_id, root_id, "Node 1", responsible_party="owner"
+    )
+
+    deps = _build_deps()
+    ctx = ToolContext(
+        db_pool=pool,
+        tenant_id=tenant_id,
+        request_id="test-request",
+        client_id="test-client",
+        deps=deps,
+    )
+
+    # First get - capture cursor
+    get_tool = MindmapGetTool()
+    get_inp = MindmapGetInput(map_key="test-map", team_id=team_id)
+    output1 = await get_tool(ctx, get_inp)
+    cursor1 = output1.cursor
+
+    assert len(output1.nodes) == 1
+    assert output1.nodes[0].memory_id == node1_id
+
+    # Get with since=cursor1 - should return nothing
+    get_inp2 = MindmapGetInput(map_key="test-map", team_id=team_id, since=cursor1)
+    output2 = await get_tool(ctx, get_inp2)
+
+    assert len(output2.nodes) == 0
+    assert len(output2.resolved) == 0
+    assert len(output2.edges) == 0
+    assert output2.cursor >= cursor1  # Cursor may have advanced
+
+    # Create a new node
+    node2_id = await _create_node(
+        pool, tenant_id, team_id, root_id, "Node 2", responsible_party="owner"
+    )
+
+    # Get with since=cursor1 - should return only node2
