+) -> None:
+    """Migration CHECK constraints prevent invalid states."""
+    tenant_id, team_id, _ = tenant_setup
+
+    root_id = await _create_map(pool, tenant_id, team_id, "Test Map")
+    node_id = await _create_node(pool, tenant_id, team_id, root_id, "Node")
+
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            # Try to set invalid status
+            with pytest.raises(asyncpg.exceptions.CheckViolationError):
+                await conn.execute(
+                    """
+                    UPDATE memory_map_membership
+                       SET status = 'invalid_status'
+                     WHERE memory_id = $1
+                    """,
+                    node_id,
+                )
+
+            # Try to set invalid party
+            with pytest.raises(asyncpg.exceptions.CheckViolationError):
+                await conn.execute(
+                    """
+                    UPDATE memory_map_membership
+                       SET status = 'resolved',
+                           resolution_summary = 'test',
+                           resolved_by_party = 'invalid',
+                           resolved_at = now()
+                     WHERE memory_id = $1
+                    """,
+                    node_id,
+                )
+
+            # Try to set open status with resolution fields
+            with pytest.raises(asyncpg.exceptions.CheckViolationError):
+                await conn.execute(
+                    """
+                    UPDATE memory_map_membership
+                       SET status = 'open',
+                           resolution_summary = 'test'
+                     WHERE memory_id = $1
+                    """,
+                    node_id,
+                )
+
+            # Try resolution_summary too long
+            with pytest.raises(asyncpg.exceptions.CheckViolationError):
+                await conn.execute(
+                    """
+                    UPDATE memory_map_membership
+                       SET resolution_summary = $1
+                     WHERE memory_id = $2
+                    """,
+                    "x" * 501,
+                    node_id,
+                )
