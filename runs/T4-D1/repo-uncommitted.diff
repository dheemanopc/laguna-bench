+    tenant_id: UUID,
+    status: str,
+    resolution_summary: str,
+    resolved_by_memory_id: UUID | None,
+    resolved_by_party: str,
+) -> None:
+    """Update a node's branch status.
+
+    Scoped by memory_id AND root_memory_id AND tenant_id to ensure the node
+    is a member of the specified map.
+    """
+    await conn.execute(
+        """
