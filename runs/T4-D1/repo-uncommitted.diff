+async def test_resolve_with_resolving_node(
+    pg_pool: Any, tenant_setup: tuple[UUID, UUID, str]
+) -> None:
+    """Resolve a node with a resolving node creates edge and logs event."""
+    tenant_id, team_id, _ = tenant_setup
+
+    # Create map and nodes
+    root_id = await _create_map(pg_pool, tenant_id, team_id, "Test Map")
+    node_id = await _create_node(pg_pool, tenant_id, team_id, root_id, "Challenge node")
+    resolver_id = await _create_node(pg_pool, tenant_id, team_id, root_id, "Resolver node")
+
+    # Create tool context
+    ctx = _ctx(pg_pool, tenant_id, "test-client")
+
+    # Resolve the node
+    tool = MindmapResolveTool()
+    inp = MindmapResolveInput(
+        map_key="test-map",
+        node_id=node_id,
+        disposition="resolved",
+        resolution_summary="Challenge resolved with solution X",
+        resolved_by_memory_id=resolver_id,
+        resolved_by_party="model",
+        team_id=team_id,
+    )
+
+    output = await tool(ctx, inp)
+
+    # Verify output
+    assert output.node_id == node_id
+    assert output.status == "resolved"
+    assert output.resolution_summary == "Challenge resolved with solution X"
+    assert output.cursor > 0
+
+    # Verify database state
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            # Check membership status
+            membership = await service.get_membership(
+                conn,
+                memory_id=node_id,
+                root_memory_id=root_id,
+                tenant_id=tenant_id,
+            )
+            assert membership is not None
+            assert membership["status"] == "resolved"
+            assert membership["resolution_summary"] == "Challenge resolved with solution X"
+            assert membership["resolved_by_memory_id"] == resolver_id
+            assert membership["resolved_by_party"] == "model"
+            assert membership["resolved_at"] is not None
+
+            # Check reference edge
+            refs = await conn.fetch(
+                """
+                SELECT * FROM memory_references
+                WHERE source_memory_id = $1 AND target_memory_id = $2
+                """,
+                resolver_id,
+                node_id,
+            )
+            assert len(refs) == 1
+            assert refs[0]["reference_kind"] == "resolves-under"
+
+            # Check event logged
+            events = await service.fetch_recent_events(conn, root_memory_id=root_id)
+            assert len(events) > 0
+            resolve_event = [e for e in events if e["event"] == "resolve"][0]
+            assert resolve_event["actor"] == "model"
+            assert resolve_event["memory_id"] == node_id
+            assert resolve_event["payload"]["disposition"] == "resolved"
+            assert resolve_event["payload"]["resolved_by_memory_id"] == str(resolver_id)
+            assert resolve_event["payload"]["reference_kind"] == "resolves-under"
+
