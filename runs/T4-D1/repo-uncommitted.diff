+async def memory_ids_touched_since(
+    conn: asyncpg.Connection, *, root_memory_id: UUID, since: int
+) -> set[UUID]:
+    """Return distinct memory_ids of events with id > since for a given map."""
+    rows = await conn.fetch(
+        """
+        SELECT DISTINCT memory_id
+        FROM memory_map_events
+        WHERE root_memory_id = $1 AND id > $2 AND memory_id IS NOT NULL
+        """,
+        root_memory_id,
+        since,
+    )
+    return {r["memory_id"] for r in rows if r["memory_id"] is not None}
