+async def get_membership(
+    conn: asyncpg.Connection,
+    *,
+    memory_id: UUID,
+    root_memory_id: UUID,
+    tenant_id: UUID,
+) -> dict[str, Any] | None:
+    """Fetch a single membership row (or None) with its memory's team_id.
+
+    Explicitly checks that the node is a member of THAT map (not another map
+    or deleted). Returns None if not found or deleted.
+    """
+    row = await conn.fetchrow(
+        """
+        SELECT mm.memory_id, mm.root_memory_id, mm.tenant_id, mm.node_role,
+               mm.status, mm.resolution_summary, mm.resolved_by_memory_id,
+               mm.resolved_by_party, mm.resolved_at,
+               m.team_id
+        FROM memory_map_membership mm
+        JOIN memories m ON m.id = mm.memory_id
+        WHERE mm.memory_id = $1 AND mm.root_memory_id = $2 AND mm.tenant_id = $3
+          AND m.deleted_at IS NULL
+        """,
+        memory_id,
+        root_memory_id,
+        tenant_id,
+    )
