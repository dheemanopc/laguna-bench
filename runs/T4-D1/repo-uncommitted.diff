+async def _create_map(
+    pg_pool: Any, tenant_id: UUID, team_id: UUID, title: str = "Test Map"
+) -> UUID:
+    """Create a mindmap and return its root_memory_id."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            # Create root memory
+            root_id = await conn.fetchval(
+                """
+                INSERT INTO memories (content, content_hash, embedding, source_kind, source_client_id, type, team_id, tenant_id, metadata, visibility)
+                VALUES ($1, $2, array_fill(0::real, ARRAY[1024])::vector, $3, $4, $5, $6, $7, $8::jsonb, $9)
+                RETURNING id
+                """,
+                title,
+                f"hash-{uuid4().hex}",
+                "api",
+                "client:test",
+                "note",
+                team_id,
+                tenant_id,
+                '{"map_role": "root"}',
+                "team",
+            )
+
+            # Create map
+            await service.insert_map(
+                conn,
+                root_memory_id=root_id,
+                tenant_id=tenant_id,
+                team_id=team_id,
+                title=title,
+                review_threshold=15,
+            )
+
+            # Add root to membership
+            await service.insert_membership(
+                conn,
+                memory_id=root_id,
+                root_memory_id=root_id,
+                tenant_id=tenant_id,
+                node_role="root",
+            )
+
+            return root_id
