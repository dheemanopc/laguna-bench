+
+    # Get with since=output3.cursor - should return node2 in resolved
+    get_inp4 = MindmapGetInput(
+        map_key="test-map", team_id=team_id, since=output3.cursor
+    )
+    output4 = await get_tool(ctx, get_inp4)
+
+    assert len(output4.nodes) == 0
+    assert len(output4.resolved) == 1
+    assert output4.resolved[0].memory_id == node2_id
