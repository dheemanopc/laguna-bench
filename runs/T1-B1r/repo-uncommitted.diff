+"""Exceptions raised by the admin service layer.
+
+These are domain exceptions (like ``RoleNotFoundError`` in teams/roles.py) —
+they carry NO FastAPI/JsonRpcError knowledge. The MCP tool layer maps each
+to the appropriate JSON-RPC error code.
+"""
+
+from __future__ import annotations
+
+
+class AdminError(Exception):
+    """Base exception for admin service failures (validation, bad input)."""
+
+
+class NotFoundError(AdminError):
+    """Requested resource (tenant/identity) was not found."""
diff --git a/src/mem_mcp/admin/service.py b/src/mem_mcp/admin/service.py
new file mode 100644
index 0000000..d0ce4a8
--- /dev/null
+++ b/src/mem_mcp/admin/service.py
@@ -0,0 +1,225 @@
+"""Cross-tenant admin lookup service.
+
+Read-only DB functions for system_admin operators to find and inspect tenants.
+Runs entirely under ``system_tx`` (no tenant GUC) and never reads
+``app.current_tenant_id`` — the caller's system permission is enforced at the
+tool layer (AdminTool.__call__) before any of these functions run.
+
+Tables queried (all non-RLS or queried without tenant scoping under system_tx):
+    tenants, tenant_identities, tenant_system_roles, teams,
+    team_role_assignments, roles_catalog.
+
+Design notes:
+- ``find_users`` searches tenants.email / tenants.display_name (ILIKE,
+  case-insensitive). One row per tenant via a LEFT JOIN on the primary
+  identity (no duplicate rows from multiple identities or system-role grants).
+  Ordered by created_at DESC (newest signup first), then t.id.
+- ``get_user`` looks up a single tenant by id, returns its primary identity
+  fields, system_roles (sorted, separate SELECT), and team memberships
+  (active assignments from team_role_assignments). A tenant without a primary
+  identity is still returned. NotFound only when no tenants row exists.
+- LIKE escape: PG LIKE with ESCAPE '\\' requires the escape char to survive
+  Python string parsing AND PG string parsing. In a normal triple-quoted
+  Python string, ``\\`` -> single backslash in the SQL text; with
+  ``standard_conforming_strings=on`` (PG16 default) that backslash is the
+  escape char. _escape_like escapes backslash FIRST, then %, then _.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime
+from typing import TYPE_CHECKING
+from uuid import UUID
+
+from pydantic import BaseModel
+
+from mem_mcp.admin.errors import NotFoundError
+
+if TYPE_CHECKING:
+    import asyncpg  # type: ignore[import-untyped]
+
+
+DEFAULT_LIMIT: int = 20
+MAX_LIMIT: int = 100
+
+
+class AdminUserSummary(BaseModel):
+    """One row from find_users — a compact tenant + primary-identity snapshot."""
+
+    tenant_id: str
+    email: str
+    display_name: str | None
+    status: str
+    created_at: datetime
+    provider: str | None          # primary identity
+    workspace_domain: str | None  # primary identity
+    default_team_id: str | None   # primary identity
+
+
+class AdminUserTeam(BaseModel):
+    """A team the target tenant belongs to, with their role."""
+
+    team_id: str
+    team_name: str
+    role_key: str
+
+
+class AdminUserDetail(AdminUserSummary):
+    """Full detail for a single tenant from get_user."""
+
+    system_roles: list[str]       # sorted, from tenant_system_roles
+    teams: list[AdminUserTeam]
+
+
+def _escape_like(raw: str) -> str:
+    r"""Escape a string for use as a literal operand inside ``LIKE`` / ``ESCAPE '\'``.
+
+    PostgreSQL LIKE treats backslash as the escape character (when ESCAPE '\'
+    is specified), so a literal backslash in the user's input must become
+    ``\\\\`` (escaped backslash -> matches one backslash), and literal ``%`` /
+    ``_`` must become ``\%`` / ``\_``.
+
+    Order matters: backslash first (so we don't double-escape the backslashes
+    we introduce for % and _), then %, then _.
+    """
+    raw = raw.replace("\\", "\\\\")
+    raw = raw.replace("%", "\\%")
+    raw = raw.replace("_", "\\_")
+    return raw
+
+
+def _clamp_limit(limit: int | None) -> int:
+    """Clamp a caller-supplied limit to ``[1, MAX_LIMIT]``.
+
+    ``None`` -> ``DEFAULT_LIMIT`` (20); otherwise ``max(1, min(MAX_LIMIT, limit))``.
+    """
+    if limit is None:
+        return DEFAULT_LIMIT
+    return max(1, min(MAX_LIMIT, limit))
+
+
+async def find_users(
+    conn: "asyncpg.Connection",
+    *,
+    query: str,
+    limit: int | None = None,
+) -> list[AdminUserSummary]:
+    """Cross-tenant tenant search by email or display_name.
+
+    Searches ``tenants.email`` and ``tenants.display_name`` (ILIKE,
+    case-insensitive) with LIKE-wildcard escaping so ``%`` and ``_`` match
+    literally. Returns one row per tenant (deduplicated via the LEFT JOIN on
+    the primary identity), ordered by ``created_at DESC, t.id``.
+
+    Raises:
+        ValueError: if ``query`` is fewer than 2 characters after stripping.
+    """
+    q = query.strip()
+    if len(q) < 2:
+        raise ValueError("query must be at least 2 characters")
+
+    clamped = _clamp_limit(limit)
+    pattern = f"%{_escape_like(q)}%"
+
+    rows = await conn.fetch(
+        """
+        SELECT t.id, t.email, t.display_name, t.status, t.created_at,
+               ti.provider, ti.workspace_domain, ti.default_team_id
+        FROM tenants t
+        LEFT JOIN tenant_identities ti ON ti.tenant_id = t.id AND ti.is_primary
+        WHERE t.email ILIKE $1 ESCAPE '\\'  OR  t.display_name ILIKE $1 ESCAPE '\\'
+        ORDER BY t.created_at DESC, t.id
+        LIMIT $2
+        """,
+        pattern,
+        clamped,
+    )
+
+    return [
+        AdminUserSummary(
+            tenant_id=str(r["id"]),
+            email=r["email"],
+            display_name=r["display_name"],
+            status=r["status"],
+            created_at=r["created_at"],
+            provider=r["provider"],
+            workspace_domain=r["workspace_domain"],
+            default_team_id=str(r["default_team_id"]) if r["default_team_id"] is not None else None,
+        )
+        for r in rows
+    ]
+
+
+async def get_user(
+    conn: "asyncpg.Connection",
+    *,
+    tenant_id: UUID,
+) -> AdminUserDetail:
+    """Fetch full detail for a single tenant by id.
+
+    Returns the tenant's primary identity fields, ``system_roles`` (sorted,
+    from a separate SELECT on ``tenant_system_roles``), and team memberships
+    (active assignments only from ``team_role_assignments`` joined to
+    ``roles_catalog``). Soft-deleted teams are excluded. A tenant without a
+    primary identity row is still returned (identity fields are NULL).
+
+    Raises:
+        NotFoundError: if no tenant with the given id exists.
+    """
+    row = await conn.fetchrow(
+        """
+        SELECT t.id, t.email, t.display_name, t.status, t.created_at,
+               ti.provider, ti.workspace_domain, ti.default_team_id
+        FROM tenants t
+        LEFT JOIN tenant_identities ti ON ti.tenant_id = t.id AND ti.is_primary
+        WHERE t.id = $1
+        """,
+        tenant_id,
+    )
+    if row is None:
+        raise NotFoundError(f"tenant not found: {tenant_id}")
+
+    # system_roles — separate SELECT, sorted.
+    sys_role_rows = await conn.fetch(
+        "SELECT role FROM tenant_system_roles WHERE tenant_id = $1 ORDER BY role",
+        tenant_id,
+    )
+    system_roles = [r["role"] for r in sys_role_rows]
+
+    # Active team memberships, excluding soft-deleted teams.
+    team_rows = await conn.fetch(
+        """
+        SELECT tm.id AS team_id,
+               tm.name AS team_name,
+               rc.role_key
+        FROM team_role_assignments tra
+        JOIN teams tm ON tm.id = tra.parent_team_id
+        JOIN roles_catalog rc ON rc.id = tra.role_id
+        WHERE tra.member_kind = 'user'
+          AND tra.member_id = $1
+          AND tra.status = 'active'
+          AND tm.deleted_at IS NULL
+        ORDER BY tm.name, tm.id
+        """,
+        tenant_id,
+    )
+
+    return AdminUserDetail(
+        tenant_id=str(row["id"]),
+        email=row["email"],
+        display_name=row["display_name"],
+        status=row["status"],
+        created_at=row["created_at"],
+        provider=row["provider"],
+        workspace_domain=row["workspace_domain"],
+        default_team_id=str(row["default_team_id"]) if row["default_team_id"] is not None else None,
+        system_roles=system_roles,
+        teams=[
+            AdminUserTeam(
+                team_id=str(tr["team_id"]),
+                team_name=tr["team_name"],
+                role_key=tr["role_key"],
+            )
+            for tr in team_rows
+        ],
+    )
