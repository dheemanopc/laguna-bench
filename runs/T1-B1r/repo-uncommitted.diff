@@ -0,0 +1,75 @@
+"""memsys_admin_get_user — cross-tenant tenant detail (system_admin only).
+
+Fetch full detail for one tenant by id: primary identity, system role,
+and team memberships. Gated by the ``system.manage_tenants`` permission
+(checked in AdminTool.__call__).
+"""
+
+from __future__ import annotations
+
+from typing import Any, ClassVar
+from uuid import UUID
+
+from pydantic import BaseModel, ConfigDict, Field
+
+from mem_mcp.admin.errors import AdminError, NotFoundError
+from mem_mcp.admin.service import AdminUserDetail, get_user
+from mem_mcp.auth.permissions import Permission
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tool_descriptions import TOOL_DESCRIPTIONS
+from mem_mcp.mcp.tools._admin_base import AdminTool
+from mem_mcp.mcp.tools._base import ToolContext
+
+
+class AdminGetUserInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    tenant_id: UUID = Field(...)
+
+
+class AdminGetUserOutput(BaseModel):
+    user: AdminUserDetail
+    request_id: str
+
+
+class AdminGetUserTool(AdminTool):
+    """Fetch full detail for one tenant (system_admin only)."""
+
+    name: ClassVar[str] = "memsys_admin_get_user"
+    description: ClassVar[str] = TOOL_DESCRIPTIONS["memsys_admin_get_user"]
+    required_scope: ClassVar[str] = "memory.read"
+    InputModel: ClassVar[type[BaseModel]] = AdminGetUserInput
+    OutputModel: ClassVar[type[BaseModel]] = AdminGetUserOutput
+    required_permission: ClassVar[Permission] = Permission.SYSTEM_MANAGE_TENANTS
+    audit_action: ClassVar[str] = "admin.get_user"
+    audit_target: ClassVar[str | None] = "tenant"
+
+    def _audit_target_id(
+        self, ctx: ToolContext, inp: BaseModel, exc: BaseException | None = None
+    ) -> UUID | None:
+        """The audited target is the tenant_id the caller asked about."""
+        if isinstance(inp, AdminGetUserInput):
+            return inp.tenant_id
+        return None
+
+    async def run(
+        self, conn: Any, ctx: ToolContext, inp: BaseModel
+    ) -> BaseModel:
+        assert isinstance(inp, AdminGetUserInput)
+        try:
+            user = await get_user(conn, tenant_id=inp.tenant_id)
+        except NotFoundError:
+            raise JsonRpcError(
+                -32602,
+                "user not found",
+                data={"errors": [{"path": "tenant_id", "message": "not found"}]},
+            )
+        except (AdminError, ValueError):
+            # Defensive: AdminError/ValueError shouldn't surface from get_user,
+            # but map them if they ever do.
+            raise JsonRpcError(
+                -32602,
+                "invalid tenant_id",
+                data={"errors": [{"path": "tenant_id", "message": "invalid"}]},
+            )
+        return AdminGetUserOutput(user=user, request_id=ctx.request_id)
diff --git a/tests/security/test_admin_tools_authz.py b/tests/security/test_admin_tools_authz.py
new file mode 100644
index 0000000..0489596
--- /dev/null
+++ b/tests/security/test_admin_tools_authz.py
@@ -0,0 +1,485 @@
+"""Security tests for admin tools: authorization + audit logging.
+
+Covers:
+- Access control (system_admin allowed, non-admin denied) for both find_user and get_user
+- Audit logging (success, denied, error paths) via AdminTool.__call__
+- run() not reached when caller is denied
+- ToolRegistry dispatch (scope check, permission, validation, not-found)
+"""
+
+from __future__ import annotations
+
+import json
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.registry import ToolRegistry
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools.admin_find_user import (
+    AdminFindUserInput,
+    AdminFindUserTool,
+)
+from mem_mcp.mcp.tools.admin_get_user import (
+    AdminGetUserInput,
+    AdminGetUserTool,
+)
+
+
+# ── Helpers ──────────────────────────────────────────────────────────────────
+
+
+def _make_ctx(
+    pg_pool: Any,
+    *,
+    scopes: frozenset[str] | None = None,
+    tenant_id: UUID | None = None,
+    identity_id: UUID | None = None,
+) -> ToolContext:
+    """Build a ToolContext without creating any DB rows."""
+    return ToolContext(
+        request_id=str(uuid4()),
+        tenant_id=tenant_id or uuid4(),
+        identity_id=identity_id or uuid4(),
+        client_id="test-client",
+        scopes=scopes if scopes is not None else frozenset({"memory.read"}),
+        db_pool=pg_pool,
+    )
+
+
+async def _create_admin_caller(pg_pool: Any) -> tuple[ToolContext, UUID]:
+    """Create a tenant WITH system_admin role + identity; return (ctx, tenant_id)."""
+    tid = uuid4()
+    iid = uuid4()
+    async with pg_pool.acquire() as conn:
+        await conn.execute(
+            "INSERT INTO tenants (id, email, status) VALUES ($1, $2, 'active')",
+            tid,
+            f"admin-{tid}@test.invalid",
+        )
+        await conn.execute(
+            """INSERT INTO tenant_identities
+               (id, tenant_id, cognito_sub, provider, email, is_primary)
+               VALUES ($1, $2, $3, 'cognito', $4, true)""",
+            iid,
+            tid,
+            f"sub-{iid}",
+            f"admin-{tid}@test.invalid",
+        )
+        await conn.execute(
+            "INSERT INTO tenant_system_roles "
+            "(tenant_id, role, granted_by_tenant_id) VALUES ($1, 'system_admin', NULL)",
+            tid,
+        )
+    return _make_ctx(pg_pool, tenant_id=tid, identity_id=iid), tid
+
+
+async def _create_regular_caller(pg_pool: Any) -> tuple[ToolContext, UUID]:
+    """Create a tenant WITHOUT system_admin role + identity; return (ctx, tenant_id)."""
+    tid = uuid4()
+    iid = uuid4()
+    async with pg_pool.acquire() as conn:
+        await conn.execute(
+            "INSERT INTO tenants (id, email, status) VALUES ($1, $2, 'active')",
+            tid,
+            f"user-{tid}@test.invalid",
+        )
+        await conn.execute(
+            """INSERT INTO tenant_identities
+               (id, tenant_id, cognito_sub, provider, email, is_primary)
+               VALUES ($1, $2, $3, 'cognito', $4, true)""",
+            iid,
+            tid,
+            f"sub-{iid}",
+            f"user-{tid}@test.invalid",
+        )
+    return _make_ctx(pg_pool, tenant_id=tid, identity_id=iid), tid
+
+
+async def _create_target_tenant(pg_pool: Any, marker: str) -> UUID:
+    """Create a searchable tenant with a primary identity."""
+    tid = uuid4()
+    email = f"target-{marker}@test.invalid"
+    async with pg_pool.acquire() as conn:
+        await conn.execute(
+            "INSERT INTO tenants (id, email, status) VALUES ($1, $2, 'active')",
+            tid,
+            email,
+        )
+        await conn.execute(
+            """INSERT INTO tenant_identities
+               (tenant_id, cognito_sub, provider, email, is_primary)
+               VALUES ($1, $2, 'cognito', $3, true)""",
+            tid,
+            f"sub-{tid}",
+            email,
+        )
+    return tid
+
+
+async def _cleanup_tenants(
+    pg_pool: Any,
+    *tenant_ids: UUID,
+    request_ids: list[str] | None = None,
+) -> None:
+    """Delete tenants, identities, system roles, teams, assignments, audit rows."""
+    tids = list(tenant_ids)
+    async with pg_pool.acquire() as conn:
+        if request_ids:
+            for rid in request_ids:
+                await conn.execute(
+                    "DELETE FROM audit_log WHERE request_id = $1", rid
+                )
+        for tid in tids:
+            await conn.execute(
+                "DELETE FROM team_role_assignments WHERE assigned_by_user_id = $1", tid
+            )
+            await conn.execute(
+                "DELETE FROM team_role_assignments "
+                "WHERE member_kind = 'user' AND member_id = $1",
+                tid,
+            )
+            await conn.execute(
+                "DELETE FROM teams WHERE created_by_tenant_id = $1", tid
+            )
+            await conn.execute(
+                "DELETE FROM tenant_identities WHERE tenant_id = $1", tid
+            )
+            await conn.execute(
+                "DELETE FROM tenant_system_roles WHERE tenant_id = $1", tid
+            )
+            await conn.execute("DELETE FROM tenants WHERE id = $1", tid)
+
+
+async def _get_audit_rows(pg_pool: Any, request_id: str) -> list[dict[str, Any]]:
+    """Fetch audit rows matching *request_id*."""
+    async with pg_pool.acquire() as conn:
+        rows = await conn.fetch(
+            "SELECT result, error_code, target_id, target_kind, details "
+            "FROM audit_log WHERE request_id = $1",
+            request_id,
+        )
+    result = []
+    for r in rows:
+        details = r["details"]
+        if isinstance(details, str):
+            details = json.loads(details)
+        result.append(
+            {
+                "result": r["result"],
+                "error_code": r["error_code"],
+                "target_id": r["target_id"],
+                "target_kind": r["target_kind"],
+                "details": details,
+            }
+        )
+    return result
+
+
+# ── Authorization tests ──────────────────────────────────────────────────────
+
+
+class TestFindUserAuthz:
+    """AdminFindUserTool authorization."""
+
+    @pytest.mark.asyncio
+    async def test_system_admin_allowed(self, pg_pool: Any) -> None:
+        """A tenant with system_admin can call find_users and get results."""
+        ctx, caller_tid = await _create_admin_caller(pg_pool)
+        marker = f"ok-{uuid4()}"
+        target_tid: UUID | None = None
+        try:
+            target_tid = await _create_target_tenant(pg_pool, marker)
+
+            inp = AdminFindUserInput(query=marker)
+            output = await AdminFindUserTool()(ctx, inp)
+
+            assert output.count >= 1
+            assert any(u.tenant_id == str(target_tid) for u in output.users)
+        finally:
+            tids = [caller_tid]
+            if target_tid:
+                tids.append(target_tid)
+            await _cleanup_tenants(pg_pool, *tids, request_ids=[ctx.request_id])
+
+    @pytest.mark.asyncio
+    async def test_non_admin_denied(self, pg_pool: Any) -> None:
+        """A tenant WITHOUT system_admin gets -32603."""
+        ctx, caller_tid = await _create_regular_caller(pg_pool)
+        try:
+            inp = AdminFindUserInput(query="ab")
+            with pytest.raises(JsonRpcError) as exc_info:
+                await AdminFindUserTool()(ctx, inp)
+            assert exc_info.value.code == -32603
+            assert "system.manage_tenants" in exc_info.value.message
+        finally:
+            await _cleanup_tenants(pg_pool, caller_tid, request_ids=[ctx.request_id])
+
+    @pytest.mark.asyncio
+    async def test_run_not_reached_on_denied(
+        self, pg_pool: Any, monkeypatch: pytest.MonkeyPatch
+    ) -> None:
+        """run() must not execute when the caller is denied."""
+        ctx, caller_tid = await _create_regular_caller(pg_pool)
+        try:
+            called = False
+
+            async def _fail_run(
+                self_tool: Any, conn: Any, ctx_arg: Any, inp: Any
+            ) -> Any:
+                nonlocal called
+                called = True
+                raise AssertionError("run() should not be called for denied caller")
+
+            monkeypatch.setattr(AdminFindUserTool, "run", _fail_run)
+
+            inp = AdminFindUserInput(query="ab")
+            with pytest.raises(JsonRpcError) as exc_info:
+                await AdminFindUserTool()(ctx, inp)
+            assert exc_info.value.code == -32603
+            assert not called, "run() was reached despite denied permission"
+        finally:
+            await _cleanup_tenants(pg_pool, caller_tid, request_ids=[ctx.request_id])
+
+
+class TestGetUserAuthz:
+    """AdminGetUserTool authorization."""
+
+    @pytest.mark.asyncio
+    async def test_system_admin_allowed(self, pg_pool: Any) -> None:
+        """A tenant with system_admin can call get_user and get results."""
+        ctx, caller_tid = await _create_admin_caller(pg_pool)
+        marker = f"get-{uuid4()}"
+        target_tid: UUID | None = None
+        try:
+            target_tid = await _create_target_tenant(pg_pool, marker)
+            inp = AdminGetUserInput(tenant_id=target_tid)
+            output = await AdminGetUserTool()(ctx, inp)
+            assert output.user.tenant_id == str(target_tid)
+        finally:
+            tids = [caller_tid]
+            if target_tid:
+                tids.append(target_tid)
+            await _cleanup_tenants(pg_pool, *tids, request_ids=[ctx.request_id])
+
+    @pytest.mark.asyncio
+    async def test_non_admin_denied(self, pg_pool: Any) -> None:
+        """A tenant WITHOUT system_admin gets -32603 for get_user."""
+        ctx, caller_tid = await _create_regular_caller(pg_pool)
+        marker = f"getdenied-{uuid4()}"
+        target_tid: UUID | None = None
+        try:
+            target_tid = await _create_target_tenant(pg_pool, marker)
+            inp = AdminGetUserInput(tenant_id=target_tid)
+            with pytest.raises(JsonRpcError) as exc_info:
+                await AdminGetUserTool()(ctx, inp)
+            assert exc_info.value.code == -32603
+        finally:
+            tids = [caller_tid]
+            if target_tid:
+                tids.append(target_tid)
+            await _cleanup_tenants(pg_pool, *tids, request_ids=[ctx.request_id])
+
+
+# ── Audit logging tests ──────────────────────────────────────────────────────
+
+
+class TestAdminAuditLogging:
+    """Verify audit rows written by AdminTool.__call__."""
+
+    @pytest.mark.asyncio
+    async def test_find_user_success_audit(self, pg_pool: Any) -> None:
+        """Success path: exactly one 'success' audit row with all details."""
+        ctx, caller_tid = await _create_admin_caller(pg_pool)
+        marker = f"audit-ok-{uuid4()}"
+        target_tid: UUID | None = None
+        try:
+            target_tid = await _create_target_tenant(pg_pool, marker)
+
+            inp = AdminFindUserInput(query=marker)
+            await AdminFindUserTool()(ctx, inp)
+
+            rows = await _get_audit_rows(pg_pool, ctx.request_id)
+            assert len(rows) == 1
+            row = rows[0]
+            assert row["result"] == "success"
+            assert row["error_code"] is None
+            d = row["details"]
+            assert d["via"] == "mcp"
+            assert d["tool"] == "memsys_admin_find_user"
+            assert d["required_permission"] == "system.manage_tenants"
+            assert d["query_length"] == len(marker)
+            assert d["result_count"] == 1
+        finally:
+            tids = [caller_tid]
+            if target_tid:
+                tids.append(target_tid)
+            await _cleanup_tenants(pg_pool, *tids, request_ids=[ctx.request_id])
+
+    @pytest.mark.asyncio
+    async def test_find_user_denied_audit(self, pg_pool: Any) -> None:
+        """Denied path: exactly one 'denied' audit row, no result_count."""
+        ctx, caller_tid = await _create_regular_caller(pg_pool)
+        try:
+            inp = AdminFindUserInput(query="ab")
+            with pytest.raises(JsonRpcError):
+                await AdminFindUserTool()(ctx, inp)
+
+            rows = await _get_audit_rows(pg_pool, ctx.request_id)
+            assert len(rows) == 1
+            row = rows[0]
+            assert row["result"] == "denied"
+            assert row["error_code"] is None
+            d = row["details"]
+            assert d["via"] == "mcp"
+            assert d["tool"] == "memsys_admin_find_user"
+            assert d["required_permission"] == "system.manage_tenants"
+            assert d["query_length"] == 2
+            assert "result_count" not in d
+        finally:
+            await _cleanup_tenants(pg_pool, caller_tid, request_ids=[ctx.request_id])
+
+    @pytest.mark.asyncio
+    async def test_find_user_error_audit(
+        self, pg_pool: Any, monkeypatch: pytest.MonkeyPatch
+    ) -> None:
+        """Error path: exactly one 'error' audit row with error_code + exc_type."""
+        ctx, caller_tid = await _create_admin_caller(pg_pool)
+        marker = f"audit-err-{uuid4()}"
+        target_tid: UUID | None = None
+        try:
+            target_tid = await _create_target_tenant(pg_pool, marker)
+
+            async def _fail_run(
+                self_tool: Any, conn: Any, ctx_arg: Any, inp: Any
+            ) -> Any:
+                raise JsonRpcError(-32602, "synthetic error from monkeypatched run")
+
+            monkeypatch.setattr(AdminFindUserTool, "run", _fail_run)
+
+            inp = AdminFindUserInput(query=marker)
+            with pytest.raises(JsonRpcError) as exc_info:
+                await AdminFindUserTool()(ctx, inp)
+            assert exc_info.value.code == -32602
+
+            rows = await _get_audit_rows(pg_pool, ctx.request_id)
+            assert len(rows) == 1
+            row = rows[0]
+            assert row["result"] == "error"
+            assert row["error_code"] == "-32602"
+            d = row["details"]
+            assert d["via"] == "mcp"
+            assert d["tool"] == "memsys_admin_find_user"
+            assert d["required_permission"] == "system.manage_tenants"
+            assert d["exc_type"] == "JsonRpcError"
+        finally:
+            tids = [caller_tid]
+            if target_tid:
+                tids.append(target_tid)
+            await _cleanup_tenants(pg_pool, *tids, request_ids=[ctx.request_id])
+
+    @pytest.mark.asyncio
+    async def test_get_user_success_audit(self, pg_pool: Any) -> None:
+        """get_user success audit has target_kind='tenant' + target_id = target."""
+        ctx, caller_tid = await _create_admin_caller(pg_pool)
+        marker = f"guest-audit-{uuid4()}"
+        target_tid: UUID | None = None
+        try:
+            target_tid = await _create_target_tenant(pg_pool, marker)
+            inp = AdminGetUserInput(tenant_id=target_tid)
+            await AdminGetUserTool()(ctx, inp)
+
+            rows = await _get_audit_rows(pg_pool, ctx.request_id)
+            assert len(rows) == 1
+            row = rows[0]
+            assert row["result"] == "success"
+            assert row["error_code"] is None
+            assert row["target_kind"] == "tenant"
+            assert UUID(str(row["target_id"])) == target_tid
+            d = row["details"]
+            assert isinstance(d, dict)
+            assert d["via"] == "mcp"
+            assert d["tool"] == "memsys_admin_get_user"
+            assert d["required_permission"] == "system.manage_tenants"
+        finally:
+            tids = [caller_tid]
+            if target_tid:
+                tids.append(target_tid)
+            await _cleanup_tenants(pg_pool, *tids, request_ids=[ctx.request_id])
+
+
+# ── ToolRegistry dispatch tests ───────────────────────────────────────────────
+
+
+class TestToolRegistryDispatch:
+    """Dispatch through ToolRegistry — scope check, permission, validation, not-found."""
+
+    def _registry(self) -> ToolRegistry:
+        reg = ToolRegistry()
+        reg.register(AdminFindUserTool)
+        return reg
+
+    @pytest.mark.asyncio
+    async def test_dispatch_success(self, pg_pool: Any) -> None:
+        """Registry dispatch with system_admin caller returns JSON-serialisable dict."""
+        ctx, caller_tid = await _create_admin_caller(pg_pool)
+        marker = f"dispatch-{uuid4()}"
+        target_tid: UUID | None = None
+        try:
+            target_tid = await _create_target_tenant(pg_pool, marker)
+
+            reg = self._registry()
