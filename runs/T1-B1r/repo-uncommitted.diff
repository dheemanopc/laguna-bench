+
+async def _create_tenant(
+    conn: Any,
+    *,
+    email: str | None = None,
+    display_name: str | None = None,
+    status: str = "active",
+    created_at: datetime | None = None,
+) -> UUID:
+    """Insert a tenant row and return its id."""
+    tid = uuid4()
+    email = email or f"test-{tid}@example.com"
+    cols = ["id", "email", "status"]
+    vals: list[Any] = [tid, email, status]
+    if display_name is not None:
+        cols.append("display_name")
+        vals.append(display_name)
+    if created_at is not None:
+        cols.append("created_at")
+        vals.append(created_at)
+    ph = ", ".join(f"${i}" for i in range(1, len(vals) + 1))
+    sql = f"INSERT INTO tenants ({', '.join(cols)}) VALUES ({ph}) RETURNING id"
+    await conn.execute(sql, *vals)
+    return tid
+
+
+async def _create_identity(
+    conn: Any,
+    *,
+    tenant_id: UUID,
+    email: str,
+    provider: str = "cognito",
+    is_primary: bool = True,
+    workspace_domain: str | None = None,
+    default_team_id: UUID | None = None,
+) -> UUID:
+    """Insert a tenant_identity row and return its id."""
+    iid = uuid4()
+    await conn.execute(
+        """
+        INSERT INTO tenant_identities
+            (id, tenant_id, cognito_sub, provider, email, is_primary,
+             workspace_domain, default_team_id)
+        VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
+        """,
+        iid,
+        tenant_id,
+        f"sub-{iid}",
+        provider,
+        email,
+        is_primary,
+        workspace_domain,
+        default_team_id,
+    )
+    return iid
+
+
+async def _cleanup_tenant(conn: Any, tenant_id: UUID) -> None:
+    """Delete all rows referencing *tenant_id* across dependent tables."""
+    # assigned_by_user_id is a RESTRICT FK → must clear before tenant
+    await conn.execute(
+        "DELETE FROM team_role_assignments WHERE assigned_by_user_id = $1",
+        tenant_id,
+    )
+    await conn.execute(
+        "DELETE FROM team_role_assignments WHERE member_kind = 'user' AND member_id = $1",
+        tenant_id,
+    )
+    await conn.execute("DELETE FROM teams WHERE created_by_tenant_id = $1", tenant_id)
+    await conn.execute("DELETE FROM tenant_identities WHERE tenant_id = $1", tenant_id)
+    await conn.execute(
+        "DELETE FROM tenant_system_roles WHERE tenant_id = $1", tenant_id
+    )
+    await conn.execute("DELETE FROM tenants WHERE id = $1", tenant_id)
+
