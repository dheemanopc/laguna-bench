+"""DB-backed tests for admin service: find_users + get_user.
+
+Live-DB tests that exercise _escape_like / _clamp_limit end-to-end through
+find_users(), plus get_user()'s system_roles / teams / soft-delete logic.
+Skips when MEM_MCP_TEST_DSN env var is not set (same as pg_pool fixture).
+"""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.admin.errors import NotFoundError
