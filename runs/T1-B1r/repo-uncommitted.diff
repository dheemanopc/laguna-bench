+
+    @pytest.mark.asyncio
+    async def test_get_user_and_find_users_after_rolled_back_tenant_tx(
+        self, pg_pool: Any
+    ) -> None:
+        """Calls BOTH find_users and get_user on the very same connection after
+        a rolled-back tenant_tx (GUC reads '') and asserts both work correctly.
+        """
+        marker = f"GUC-{uuid4()}"
+        tid: UUID | None = None
+        try:
+            async with pg_pool.acquire() as conn:
+                tid = await _create_tenant(
+                    conn, email=f"guc-{marker}@test.invalid"
+                )
+                await _create_identity(
+                    conn, tenant_id=tid, email=f"guc-{marker}@test.invalid"
+                )
+
+            # Simulate a rolled-back tenant_tx: open one, set GUC, force rollback
+            raised = False
+            try:
+                async with tenant_tx(pg_pool, tid) as tx_conn:
+                    await tx_conn.fetchval("SELECT 1")
+                    raise RuntimeError("force rollback")
+            except RuntimeError:
+                raised = True
+            assert raised
+
+            # Now on a fresh system_tx connection, verify GUC reads '' (or NULL),
+            # and BOTH find_users and get_user work correctly on the same connection.
+            async with system_tx(pg_pool) as conn:
+                guc_val = await conn.fetchval(
+                    "SELECT current_setting('app.current_tenant_id', true)"
+                )
+                # After rolled-back SET LOCAL, the GUC reads '' or NULL
+                assert guc_val in (None, "")
+
+                # find_users must work despite GUC being ''
+                results = await find_users(conn, query=marker)
+                assert len(results) == 1
+                assert results[0].tenant_id == str(tid)
+
+                # get_user must work despite GUC being ''
+                detail = await get_user(conn, tenant_id=tid)
+                assert detail.tenant_id == str(tid)
+                assert detail.email == f"guc-{marker}@test.invalid"
+        finally:
+            if tid:
+                async with pg_pool.acquire() as conn:
+                    await _cleanup_tenant(conn, tid)
