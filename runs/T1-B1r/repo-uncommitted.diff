+"""DB-free unit tests for admin service helpers and tool contract.
+
+Tests ``_escape_like``, ``_clamp_limit``, the ``AdminTool`` subclass contract
+(``__init_subclass__`` enforcement), input-model validation, and the
+``ROLE_PERMISSIONS`` invariant that team roles never grant system perms.
+"""
+
+from __future__ import annotations
+
+from typing import Any, ClassVar
+from uuid import uuid4
+
+import pytest
+from pydantic import BaseModel, ValidationError
+
+from mem_mcp.admin.service import (
+    DEFAULT_LIMIT,
+    MAX_LIMIT,
+    _clamp_limit,
+    _escape_like,
+)
+from mem_mcp.auth.permissions import Permission, ROLE_PERMISSIONS
+from mem_mcp.mcp.tools._admin_base import AdminTool
+from mem_mcp.mcp.tools.admin_find_user import (
+    AdminFindUserInput,
+    AdminFindUserOutput,
+    AdminFindUserTool,
+)
+from mem_mcp.mcp.tools.admin_get_user import (
+    AdminGetUserInput,
+    AdminGetUserTool,
+)
+
+
+class TestEscapeLike:
+    """Tests for _escape_like — must backslash-escape \\, %, then _."""
+
+    def test_plain_string_unchanged(self) -> None:
+        assert _escape_like("alice") == "alice"
+
+    def test_percent_escaped(self) -> None:
+        assert _escape_like("50%off") == "50\\%off"
+
+    def test_underscore_escaped(self) -> None:
+        assert _escape_like("user_name") == "user\\_name"
+
+    def test_backslash_escaped(self) -> None:
+        # A literal backslash becomes an escaped backslash.
+        assert _escape_like("back\\slash") == "back\\\\slash"
+
+    def test_all_three_escaped_in_order(self) -> None:
+        # Combined: input contains \, %, _ — all must be escaped.
+        result = _escape_like("a\\b%c_d")
+        assert result == "a\\\\b\\%c\\_d"
+
+    def test_empty_string(self) -> None:
+        assert _escape_like("") == ""
+
+    def test_only_special_chars(self) -> None:
+        assert _escape_like("\\%_") == "\\\\\\%\\_"
+
+    def test_backslash_then_percent_not_double_escaped(self) -> None:
+        # Escaping backslash first means the \% we add for % is not
+        # double-escaped (no \\\\%).
+        result = _escape_like("%")
+        assert result == "\\%"
+        # The result has exactly one backslash before the %, not two.
+        assert result.count("\\") == 1
+
+    def test_backslash_percent_literal(self) -> None:
+        # Input chars: a \ %  →  output chars: a \ \ \ %
+        # Python literal "a\\%" is chars [a, \, %].
+        # Python literal "a\\\\\\%" is chars [a, \, \, \, %].
+        assert _escape_like("a\\%") == "a\\\\\\%"
+
+    def test_double_percent_literal(self) -> None:
+        # Input chars: % %  →  output chars: \ % \ %
+        assert _escape_like("%%") == "\\%\\%"
+
+
+class TestClampLimit:
+    """Tests for _clamp_limit — None→20, else max(1, min(100, limit))."""
+
+    def test_none_is_default(self) -> None:
+        assert _clamp_limit(None) == DEFAULT_LIMIT
+
+    def test_zero_clamped_to_one(self) -> None:
+        assert _clamp_limit(0) == 1
+
+    def test_negative_clamped_to_one(self) -> None:
+        assert _clamp_limit(-5) == 1
+
+    def test_huge_clamped_to_max(self) -> None:
+        assert _clamp_limit(9999) == MAX_LIMIT
+
+    def test_normal_value_passes_through(self) -> None:
+        assert _clamp_limit(50) == 50
+
+    def test_one_passes_through(self) -> None:
+        assert _clamp_limit(1) == 1
+
+    def test_max_passes_through(self) -> None:
+        assert _clamp_limit(MAX_LIMIT) == MAX_LIMIT
+
+
+class TestAdminToolInitSubclass:
+    """Tests for AdminTool.__init_subclass__ enforcement."""
+
+    def test_subclass_defining_call_raises(self) -> None:
+        """An AdminTool subclass that defines __call__ must raise TypeError."""
+        with pytest.raises(TypeError, match="run"):
+
+            class BadCallTool(AdminTool):  # type: ignore[misc, abstract]
+                name: ClassVar[str] = "test_bad_call"
+                required_permission: ClassVar[Permission] = Permission.SYSTEM_MANAGE_TENANTS
+                audit_action: ClassVar[str] = "admin.test"
+
+                async def __call__(self, ctx: Any, inp: BaseModel) -> BaseModel:  # type: ignore[override]
+                    raise NotImplementedError
+
+    def test_concrete_non_system_permission_raises(self) -> None:
+        """A concrete tool with a non-system permission must raise TypeError."""
+        with pytest.raises(TypeError, match="system"):
+
+            class BadPermTool(AdminTool):  # type: ignore[misc, abstract]
+                name: ClassVar[str] = "test_bad_perm"
+                required_permission: ClassVar[Permission] = Permission.TEAM_VIEW
+                audit_action: ClassVar[str] = "admin.test"
+
+                async def run(
+                    self, conn: Any, ctx: Any, inp: BaseModel
+                ) -> BaseModel:
+                    raise NotImplementedError
+
+    def test_concrete_bad_audit_action_raises(self) -> None:
+        """A concrete tool with a non-admin audit_action must raise TypeError."""
+        with pytest.raises(TypeError, match="admin"):
+
+            class BadActionTool(AdminTool):  # type: ignore[misc, abstract]
+                name: ClassVar[str] = "test_bad_action"
+                required_permission: ClassVar[Permission] = Permission.SYSTEM_MANAGE_TENANTS
+                audit_action: ClassVar[str] = "memory.get"
+
+                async def run(
+                    self, conn: Any, ctx: Any, inp: BaseModel
+                ) -> BaseModel:
+                    raise NotImplementedError
+
+    def test_concrete_without_run_raises(self) -> None:
+        """A concrete tool that doesn't override run must raise TypeError."""
+        with pytest.raises(TypeError, match="run"):
+
+            class NoRunTool(AdminTool):  # type: ignore[misc, abstract]
+                name: ClassVar[str] = "test_no_run"
+                required_permission: ClassVar[Permission] = Permission.SYSTEM_MANAGE_TENANTS
+                audit_action: ClassVar[str] = "admin.test"
+
+    def test_intermediate_abstract_base_ok(self) -> None:
+        """An abstract base (no name) that sets required_permission is fine."""
+        # No 'name' in __dict__ → concrete checks are skipped.
+        class AbstractBase(AdminTool):
+            required_permission: ClassVar[Permission] = Permission.SYSTEM_MANAGE_TENANTS
+            audit_action: ClassVar[str] = "admin.abstract"
+
+
+class TestAdminToolConcreteContract:
+    """Verify the shipped tools satisfy the contract."""
+
+    def test_find_user_tool(self) -> None:
+        assert AdminFindUserTool.required_permission is Permission.SYSTEM_MANAGE_TENANTS
+        assert AdminFindUserTool.required_scope == "memory.read"
+        assert "__call__" not in AdminFindUserTool.__dict__
+
+    def test_get_user_tool(self) -> None:
+        assert AdminGetUserTool.required_permission is Permission.SYSTEM_MANAGE_TENANTS
+        assert AdminGetUserTool.required_scope == "memory.read"
+        assert "__call__" not in AdminGetUserTool.__dict__
+
+    def test_find_user_output_has_count(self) -> None:
+        # The output model must have a 'count' field.
+        assert "count" in AdminFindUserOutput.model_fields
+
+    def test_find_user_audit_target_is_none(self) -> None:
+        assert AdminFindUserTool.audit_target is None
+
+    def test_get_user_audit_target_is_tenant(self) -> None:
+        assert AdminGetUserTool.audit_target == "tenant"
+
+
+class TestRolePermissionsInvariant:
+    """Team roles must never grant system.* permissions."""
+
+    def test_team_roles_dont_grant_system_perms(self) -> None:
+        for role_key, perms in ROLE_PERMISSIONS.items():
+            if role_key in ("system_admin", "system_support"):
+                continue
+            for perm in perms:
+                assert not perm.value.startswith("system."), (
+                    f"team role {role_key} should not grant system permission "
+                    f"{perm.value}"
+                )
+
+
+class TestAdminFindUserInputValidation:
+    """Pydantic validation on AdminFindUserInput."""
+
+    def test_query_too_short(self) -> None:
+        with pytest.raises(ValidationError):
+            AdminFindUserInput(query="a")
+
+    def test_query_too_long(self) -> None:
+        with pytest.raises(ValidationError):
+            AdminFindUserInput(query="a" * 256)
+
+    def test_query_two_chars_ok(self) -> None:
+        inp = AdminFindUserInput(query="ab")
+        assert inp.query == "ab"
+
+    def test_query_255_chars_ok(self) -> None:
+        inp = AdminFindUserInput(query="a" * 255)
+        assert len(inp.query) == 255
+
+    def test_limit_zero_rejected(self) -> None:
+        with pytest.raises(ValidationError):
+            AdminFindUserInput(query="ab", limit=0)
+
+    def test_limit_too_big_rejected(self) -> None:
+        with pytest.raises(ValidationError):
+            AdminFindUserInput(query="ab", limit=101)
+
+    def test_limit_one_ok(self) -> None:
+        inp = AdminFindUserInput(query="ab", limit=1)
+        assert inp.limit == 1
+
+    def test_limit_100_ok(self) -> None:
+        inp = AdminFindUserInput(query="ab", limit=100)
+        assert inp.limit == 100
+
+    def test_extra_field_rejected(self) -> None:
+        with pytest.raises(ValidationError):
+            AdminFindUserInput(query="ab", extra="field")  # type: ignore[call-arg]
+
+    def test_default_limit(self) -> None:
+        inp = AdminFindUserInput(query="ab")
+        assert inp.limit == 20
+
+
+class TestAdminGetUserInputValidation:
+    """Pydantic validation on AdminGetUserInput."""
+
+    def test_missing_tenant_id_rejected(self) -> None:
+        with pytest.raises(ValidationError):
+            AdminGetUserInput()  # type: ignore[call-arg]
+
+    def test_extra_field_rejected(self) -> None:
+        with pytest.raises(ValidationError):
+            AdminGetUserInput(tenant_id=uuid4(), extra="field")  # type: ignore[call-arg]
+
+    def test_valid_input(self) -> None:
+        tid = uuid4()
+        inp = AdminGetUserInput(tenant_id=tid)
+        assert inp.tenant_id == tid
