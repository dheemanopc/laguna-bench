+"""memsys_admin_find_user — cross-tenant tenant search (system_admin only).
+
+Search tenants by email or display name across all tenants. Gated by the
+``system.manage_tenants`` permission (checked in AdminTool.__call__).
+"""
+
+from __future__ import annotations
+
+from typing import Any, ClassVar
+
+from pydantic import BaseModel, ConfigDict, Field
+
+from mem_mcp.admin.service import AdminUserSummary, find_users
+from mem_mcp.auth.permissions import Permission
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tool_descriptions import TOOL_DESCRIPTIONS
+from mem_mcp.mcp.tools._admin_base import AdminTool
+from mem_mcp.mcp.tools._base import ToolContext
+
+
+class AdminFindUserInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    query: str = Field(..., min_length=2, max_length=255)
+    limit: int = Field(default=20, ge=1, le=100)
+
+
+class AdminFindUserOutput(BaseModel):
+    users: list[AdminUserSummary]
+    count: int
+    request_id: str
+
+
+class AdminFindUserTool(AdminTool):
+    """Search tenants across all tenants (system_admin only)."""
+
+    name: ClassVar[str] = "memsys_admin_find_user"
+    description: ClassVar[str] = TOOL_DESCRIPTIONS["memsys_admin_find_user"]
+    required_scope: ClassVar[str] = "memory.read"
+    InputModel: ClassVar[type[BaseModel]] = AdminFindUserInput
+    OutputModel: ClassVar[type[BaseModel]] = AdminFindUserOutput
+    required_permission: ClassVar[Permission] = Permission.SYSTEM_MANAGE_TENANTS
+    audit_action: ClassVar[str] = "admin.find_user"
+
+    def audit_details(
+        self, inp: BaseModel, out: BaseModel | None
+    ) -> dict[str, Any]:
+        """Add query_length (always) and result_count (success only)."""
+        if not isinstance(inp, AdminFindUserInput):
+            return {}
+        details: dict[str, Any] = {"query_length": len(inp.query)}
+        if out is not None and isinstance(out, AdminFindUserOutput):
+            details["result_count"] = out.count
+        return details
+
+    async def run(
+        self, conn: Any, ctx: ToolContext, inp: BaseModel
+    ) -> BaseModel:
+        assert isinstance(inp, AdminFindUserInput)
+        try:
+            users = await find_users(
+                conn, query=inp.query, limit=inp.limit
+            )
+        except ValueError as exc:
+            raise JsonRpcError(
+                -32602,
+                "invalid search query",
+                data={"errors": [{"path": "query", "message": str(exc)}]},
+            ) from exc
+        return AdminFindUserOutput(
+            users=users, count=len(users), request_id=ctx.request_id
+        )
