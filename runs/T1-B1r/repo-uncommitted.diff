diff --git a/src/mem_mcp/mcp/tools/_admin_base.py b/src/mem_mcp/mcp/tools/_admin_base.py
new file mode 100644
index 0000000..7381cb2
--- /dev/null
+++ b/src/mem_mcp/mcp/tools/_admin_base.py
@@ -0,0 +1,249 @@
+"""AdminTool base — read-only cross-tenant admin tools for system_admin operators.
+
+This base class enforces a uniform authorization + audit contract for every
+admin tool:
+
+1. PERMISSION CHECK — a ``has_permission`` call against the caller's OWN
+   tenant (``ctx.tenant_id``) under ``system_tx``. If the caller lacks the
+   ``required_permission`` (a ``system.*`` perm), the denied audit is written
+   **in the same** ``system_tx`` (so it commits), then a ``JsonRpcError(-32603,
+   missing_permission=...)`` is raised **after** the block exits.
+
+2. AUTHORIZED EXECUTION — ``run(conn, ctx, inp)`` is invoked under a fresh
+   ``system_tx``; on success a single ``success`` audit row is written on the
+   SAME connection and commits with the result.
+
+3. ERROR PATH — if ``run()`` raises (any exception, including ``JsonRpcError``
+   from a domain mapping), a fresh ``system_tx`` opens to commit an ``error``
+   audit row (with ``error_code``), then the exception is re-raised.
+
+Each call produces exactly ONE audit row: denied OR success OR error.
+
+``NotFoundError`` from the service layer is caught in each concrete tool's
+``run()`` and mapped to ``JsonRpcError(-32602)`` there; the error-audit path in
+``__call__`` handles the rest.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any, ClassVar, final
+
+from pydantic import BaseModel
+
+from mem_mcp.audit.logger import AuditAction, DbAuditLogger
+from mem_mcp.auth.permissions import Permission
+from mem_mcp.auth.rbac import has_permission
+from mem_mcp.db import system_tx
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import BaseTool, ToolContext
+
+if TYPE_CHECKING:
+    import asyncpg  # type: ignore[import-untyped]
+
+
+def _resolve_audit_logger(ctx: ToolContext) -> Any:
+    """Return the audit logger from deps, or a bare DbAuditLogger fallback.
+
+    Mirrors the test-fixture pattern where tool_ctx fixtures don't wire
+    ``deps`` (ctx.deps is None). When deps is None or deps.audit is None,
+    fall back to a direct DbAuditLogger() so audit rows still hit the DB.
+    """
+    if ctx.deps is not None and ctx.deps.audit is not None:
+        return ctx.deps.audit
+    return DbAuditLogger()
+
+
+async def _write_audit(
+    ctx: ToolContext,
+    conn: "asyncpg.Connection",
+    action: AuditAction,
+    result: str,
+    target_id: Any,
+    target_kind: str | None,
+    details: dict[str, Any] | None,
+    error_code: str | None = None,
+) -> None:
+    """Delegate to the resolved audit logger (async, must be awaited)."""
+    audit = _resolve_audit_logger(ctx)
+    await audit.audit(
+        conn,
+        action=action,
+        result=result,
+        tenant_id=ctx.tenant_id,
+        identity_id=ctx.identity_id,
+        client_id=ctx.client_id,
+        target_id=target_id,
+        target_kind=target_kind,
+        request_id=ctx.request_id,
+        details=details,
+        error_code=error_code,
+    )
+
+
+class AdminTool(BaseTool):
+    """Base class for system_admin-only cross-tenant admin MCP tools.
+
+    Subclasses declare (as ClassVars):
+
+    - ``required_permission``: a ``Permission`` enum value whose ``.value``
+      starts with ``"system."`` (e.g. ``Permission.SYSTEM_MANAGE_TENANTS``).
+      Checked via ``has_permission(conn, ctx.tenant_id, ...)``.
+    - ``audit_action``: a member of the ``AuditAction`` Literal (e.g.
+      ``"admin.find_user"``).
+    - ``run``: the async body. Receives ``(conn, ctx, inp)`` where ``conn``
+      is a ``system_tx`` connection; returns a ``BaseModel``.
+
+    ``audit_target`` defaults to ``None`` and may be overridden as a ClassVar
+    or via the ``_audit_target_id`` hook for per-instance target resolution.
+    """
+
+    required_permission: ClassVar[Permission]
+    audit_action: ClassVar[AuditAction]
+    audit_target: ClassVar[str | None] = None
+
+    # Hook defaults — subclasses override to enrich audit rows.
+    def _audit_target_id(
+        self, ctx: ToolContext, inp: BaseModel, exc: BaseException | None = None
+    ) -> Any:
+        """Override to return the target UUID/identity for audit rows, if any."""
+        return None
+
+    def audit_details(self, inp: BaseModel, out: BaseModel | None) -> dict[str, Any]:
+        """Override to add audit details computed from input/output.
+
+        ``out`` is None on denied/error paths. Base returns ``{}``.
+        """
+        return {}
+
+    def __init_subclass__(cls, **kwargs: Any) -> None:
+        super().__init_subclass__(**kwargs)
+        # No subclass may override __call__ — they implement run() instead.
+        if "__call__" in cls.__dict__:
+            raise TypeError(
+                "admin tools implement run(), not __call__"
+            )
+
+        # Concrete tools (those declaring a name) must satisfy full contract.
+        if "name" in cls.__dict__:
+            # run must be overridden.
+            if cls.run is AdminTool.run:
+                raise TypeError(
+                    f"{cls.__name__} must define run()"
+                )
+            # required_permission must be a Permission with system.* prefix.
+            perm = getattr(cls, "required_permission", None)
+            if perm is None:
+                raise TypeError(
+                    f"{cls.__name__} must define required_permission"
+                )
+            if not isinstance(perm, Permission):
+                raise TypeError(
+                    f"{cls.__name__}.required_permission must be a Permission enum value"
+                )
+            if not perm.value.startswith("system."):
+                raise TypeError(
+                    f"{cls.__name__}.required_permission must be a system.* permission"
+                )
+            # audit_action must be a str with admin.* prefix.
+            action = getattr(cls, "audit_action", None)
+            if action is None:
+                raise TypeError(
+                    f"{cls.__name__} must define audit_action"
+                )
+            if not isinstance(action, str) or not action.startswith("admin."):
+                raise TypeError(
+                    f"{cls.__name__}.audit_action must be a string starting with 'admin.'"
+                )
+
+    def _base_audit_details(self) -> dict[str, Any]:
+        """Base audit details present on EVERY admin audit row."""
+        return {
+            "via": "mcp",
+            "tool": self.name,
+            "required_permission": self.required_permission.value,
+        }
+
+    async def run(
+        self, conn: "asyncpg.Connection", ctx: ToolContext, inp: BaseModel
+    ) -> BaseModel:
+        """Override in subclass. Default raises to satisfy the contract."""
+        raise NotImplementedError
+
+    @final
+    async def __call__(self, ctx: ToolContext, inp: BaseModel) -> BaseModel:
+        """Three-phase: permission check → run+success-audit / denied / error."""
+        perm = self.required_permission.value
+
+        # Phase 1 — permission check + denied audit in the SAME system_tx.
+        # Write the audit inside the async with so it commits when the block
+        # exits normally; raise AFTER the block so the tx is not rolled back.
+        denied = False
+        async with system_tx(ctx.db_pool) as conn:
+            allowed = await has_permission(conn, ctx.tenant_id, perm)
+            if not allowed:
+                await _write_audit(
+                    ctx,
+                    conn,
+                    action=self.audit_action,
+                    result="denied",
+                    target_id=self._audit_target_id(ctx, inp),
+                    target_kind=self.audit_target,
+                    details=self._base_audit_details() | self.audit_details(inp, None),
+                )
+                denied = True
+
+        if denied:
+            raise JsonRpcError(
+                -32603,
+                f"caller lacks required permission: {perm}",
+                data={"missing_permission": perm},
+            )
+
+        # Phase 2 — authorized execution. run() + success audit ride the same
+        # system_tx connection, so they commit or roll back together.
+        try:
+            async with system_tx(ctx.db_pool) as conn:
+                result = await self.run(conn, ctx, inp)
+                await _write_audit(
+                    ctx,
+                    conn,
+                    action=self.audit_action,
+                    result="success",
+                    target_id=self._audit_target_id(ctx, inp),
+                    target_kind=self.audit_target,
+                    details=self._base_audit_details() | self.audit_details(inp, result),
+                )
+            return result
+        except JsonRpcError as exc:
+            # run() mapped a domain exception to JsonRpcError (-32602).
+            # Error audit on a fresh tx so it survives the run-tx rollback.
+            async with system_tx(ctx.db_pool) as conn:
+                await _write_audit(
+                    ctx,
+                    conn,
+                    action=self.audit_action,
+                    result="error",
+                    target_id=self._audit_target_id(ctx, inp),
+                    target_kind=self.audit_target,
+                    error_code=str(exc.code),
+                    details=self._base_audit_details()
+                    | self.audit_details(inp, None)
+                    | {"exc_type": type(exc).__name__},
+                )
+            raise
+        except Exception as exc:
+            # Unexpected exception from run() or the audit call itself.
+            async with system_tx(ctx.db_pool) as conn:
+                await _write_audit(
+                    ctx,
+                    conn,
+                    action=self.audit_action,
+                    result="error",
+                    target_id=self._audit_target_id(ctx, inp),
+                    target_kind=self.audit_target,
+                    error_code=type(exc).__name__,
+                    details=self._base_audit_details()
+                    | self.audit_details(inp, None)
+                    | {"exc_type": type(exc).__name__},
+                )
+            raise
