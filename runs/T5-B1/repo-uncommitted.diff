+# --------------------------------------------------------------------------- #
+# (a) concurrent tags_op=add/remove → no lost updates
+# --------------------------------------------------------------------------- #
+async def test_concurrent_tags_add_remove_no_lost_updates(big_pool: Any) -> None:
+    """8 concurrent tag writes (4 add, 4 remove) on one note must all land.
+
+    Under the row lock every writer re-reads the latest tag set before merging,
+    so the final set is the full union of adds minus the removed tags. Without
+    ``FOR UPDATE`` the read-modify-write is non-atomic and writes are lost.
+    """
+    async with big_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(big_pool, tenant, client_id)
+    try:
+        async with big_pool.acquire() as conn:
+            async with conn.transaction():
+                mid, _, _ = await _insert_memory(
+                    conn,
+                    tenant,
+                    team,
+                    "taggable note",
+                    "note",
+                    tags=["base", "t0", "t1", "t2", "t3"],
+                )
+
+        async def call(i: int) -> Any:
+            if i < 4:
+                inp = MemoryUpdateInput(id=mid, tags=[f"t{4 + i}"], tags_op="add")
+            else:
+                # remove the tags that started on the note
+                inp = MemoryUpdateInput(id=mid, tags=[f"t{i - 4}"], tags_op="remove")
+            return await MemoryUpdateTool()(ctx, inp)
+
+        results = await asyncio.gather(
+            *(call(i) for i in range(CONCURRENCY)), return_exceptions=True
+        )
+
+        successes = [r for r in results if not isinstance(r, BaseException)]
+        assert len(successes) == CONCURRENCY, (
+            f"every concurrent tag write must commit under the lock; "
+            f"got {len(successes)} successes, "
+            f"errors={[repr(r) for r in results if isinstance(r, BaseException)]}"
+        )
+
+        # base survives; t0..t3 removed by the remove batch; t4..t7 added.
+        final_tags = await _read_tags(big_pool, tenant, mid)
+        assert set(final_tags) == {"base", "t4", "t5", "t6", "t7"}, final_tags
+    finally:
+        await _cleanup(big_pool, tenant, team, client_id)
+
