+# --------------------------------------------------------------------------- #
+# (c) concurrent same expected_revision → exactly one winner (in-place path)
+# --------------------------------------------------------------------------- #
+async def test_concurrent_same_expected_revision_one_winner(big_pool: Any) -> None:
+    """8 concurrent in-place content edits on a note, all stamped with the SAME
+    stale expected_revision: exactly 1 succeeds and rotates the revision; the
+    other 7 are rejected as ``update_conflict`` carrying the winner's new
+    ``current_revision``.
+
+    Without ``FOR UPDATE`` the optimistic check is racy — multiple writers read
+    the same pre-update revision, all pass the check, and all commit (lost
+    updates / revision token defeated).
+    """
+    async with big_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(big_pool, tenant, client_id)
+    try:
+        async with big_pool.acquire() as conn:
+            async with conn.transaction():
+                mid, _, _ = await _insert_memory(
+                    conn, tenant, team, "original note content", "note", tags=["n"]
+                )
+        r0 = await _read_revision(big_pool, tenant, mid)
+
+        async def call(i: int) -> Any:
+            return await MemoryUpdateTool()(
+                ctx,
+                MemoryUpdateInput(
+                    id=mid,
+                    content=f"note content edit {i}",
+                    expected_revision=r0,  # stale on every non-winner
+                ),
+            )
+
+        results = await asyncio.gather(
+            *(call(i) for i in range(CONCURRENCY)), return_exceptions=True
+        )
+
+        successes = [r for r in results if not isinstance(r, BaseException)]
+        conflicts = [
+            r
+            for r in results
+            if isinstance(r, JsonRpcError)
+            and r.data is not None
+            and r.data.get("code") == "update_conflict"
+        ]
+        assert len(successes) == 1, f"expected exactly 1 winner, got {len(successes)}"
+        assert len(conflicts) == CONCURRENCY - 1
+
+        winner = successes[0]
+        assert isinstance(winner, MemoryUpdateOutput)
+        assert winner.id == mid  # in-place: same row
+        assert winner.is_new_version is False
+        assert winner.revision != r0
+
+        # All losers collide on the winner's fresh revision.
+        for c in conflicts:
+            assert c.data is not None
+            assert c.data["current_id"] == str(mid)
+            assert c.data["current_revision"] == winner.revision, c.data
+
+        # Ground truth: the row now carries the winner's revision.
+        assert await _read_revision(big_pool, tenant, mid) == winner.revision
+    finally:
+        await _cleanup(big_pool, tenant, team, client_id)
+
