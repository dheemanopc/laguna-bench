diff --git a/tests/integration/test_update_concurrency.py b/tests/integration/test_update_concurrency.py
new file mode 100644
index 0000000..3444c5f
--- /dev/null
+++ b/tests/integration/test_update_concurrency.py
@@ -0,0 +1,688 @@
+"""Integration concurrency tests for ``memory_update`` optimistic locking.
+
+Per order-1.md "Tests to add §2" + Order 3 spec. Exercises the real MCP tools
+against a live Postgres pool, mirroring the setup/cleanup style of
+``tests/integration/test_mindmap_e2e.py``.
+
+Each concurrency test fans out >= 8 simultaneous ``memory_update`` calls
+(``asyncio.gather`` with ``return_exceptions=True``) against the same memory
+and asserts the Postgres ``SELECT ... FOR UPDATE`` serialisation produces the
+correct outcome:
+
+  (a) concurrent tags_op=add/remove → no lost writes (all tags land)
+  (b) concurrent decision content updates → exactly 1 winner, the rest
+      ``update_conflict`` naming the winner's id as ``current_id``
+  (c) concurrent same expected_revision → exactly 1 winner, the rest
+      ``update_conflict`` naming ``current_revision``
+  (d) sequential stale-token + superseded-id + note→decision-promotion conflicts
+  (e) revision semantics: rotates on every update (incl. tags-only / no-op),
+      ``update.revision == memory_get.revision`` on both paths, revision
+      unchanged after an access bump, history carries per-version revisions.
+
+The bug-demonstration (Order 3 P3) is performed by hand against this file:
+drop ``FOR UPDATE`` + the ``is_current`` check in ``update.py``, re-run, and
+(a)/(b)/(c) must fail while (d)/(e) stay green.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+from typing import Any
+from uuid import UUID, uuid4
+
+import asyncpg  # type: ignore[import-untyped]
+import pytest
+
+from mem_mcp.audit.logger import NoopAuditLogger
+from mem_mcp.db import tenant_tx
+from mem_mcp.embeddings.bedrock import EmbedResult
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.get import MemoryGetInput, MemoryGetOutput, MemoryGetTool
+from mem_mcp.mcp.tools.update import (
+    MemoryUpdateInput,
+    MemoryUpdateOutput,
+    MemoryUpdateTool,
+)
+from mem_mcp.memory import access_tracking
+from mem_mcp.memory.normalize import hash_content
+from mem_mcp.teams.assignments import assign_role
+
+pytestmark = pytest.mark.asyncio
