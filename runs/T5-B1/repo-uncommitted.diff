+# --------------------------------------------------------------------------- #
+# Fixture: dedicated, larger pool (the shared pg_pool fixture caps at 4, which
+# is too small to host 8 simultaneous FOR UPDATE waiters + the readers).
+# --------------------------------------------------------------------------- #
<email>
+async def big_pool() -> Any:
+    dsn = os.environ.get("MEM_MCP_TEST_DSN")
+    if not dsn:
+        pytest.skip("MEM_MCP_TEST_DSN env not set; skipping live-DB test")
+    pool = await _new_pool(dsn)
+    try:
+        yield pool
+    finally:
+        await _drain_bumps()
+        await pool.close()
+
