+# --------------------------------------------------------------------------- #
+# (e) revision semantics
+# --------------------------------------------------------------------------- #
+async def test_revision_semantics(big_pool: Any) -> None:
+    """Revision rotates on every update, matches memory_get on both paths, is
+    untouched by an access bump (trigger guard), and survives into history.
+    """
+    async with big_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(big_pool, tenant, client_id)
+    try:
+        async with big_pool.acquire() as conn:
+            async with conn.transaction():
+                note_id, _, r0 = await _insert_memory(
+                    conn,
+                    tenant,
+                    team,
+                    "rev semantics",
+                    "note",
+                    tags=["a"],
+                )
+                dec_id, _, _ = await _insert_memory(
+                    conn,
+                    tenant,
+                    team,
+                    "versioned sem",
+                    "decision",
+                    tags=["v"],
+                )
+
+        # (e.1a) tags-only update rotates the revision.
+        out = await MemoryUpdateTool()(
+            ctx, MemoryUpdateInput(id=note_id, tags=["a", "b"], tags_op="add")
+        )
+        assert isinstance(out, MemoryUpdateOutput)
+        assert out.revision != r0
+        r1 = out.revision
+        # (e.1b) a no-op update (identical content + tags via replace) STILL
+        # rotates, because every in-place UPDATE sets revision = gen_random_uuid().
+        out2 = await MemoryUpdateTool()(
+            ctx,
+            MemoryUpdateInput(
+                id=note_id,
+                content="rev semantics",
+                tags_op="replace",
+                tags=["a", "b"],
+            ),
+        )
+        assert isinstance(out2, MemoryUpdateOutput)
+        assert out2.revision != r1
+
+        # (e.2a) in-place path: memory_get revision matches the update's token.
+        g = await MemoryGetTool()(ctx, MemoryGetInput(id=note_id))
+        await _drain_bumps()
+        assert isinstance(g, MemoryGetOutput)
+        assert g.memory.revision == out2.revision
+        assert g.memory.revision != r0
+
+        # (e.2b) versioned path: memory_get on the NEW row matches the update.
+        d0 = await _read_revision(big_pool, tenant, dec_id)
+        vout = await MemoryUpdateTool()(
+            ctx,
+            MemoryUpdateInput(id=dec_id, content="v2 sem", expected_revision=d0),
+        )
+        assert isinstance(vout, MemoryUpdateOutput)
+        assert vout.is_new_version is True
+        vget = await MemoryGetTool()(ctx, MemoryGetInput(id=vout.id))
+        await _drain_bumps()
+        assert isinstance(vget, MemoryGetOutput)
+        assert vget.memory.revision == vout.revision
+
+        # (e.3) access bump (last_accessed_at/access_count) must NOT rotate the
+        # revision — the trigger guard excludes those columns.
+        before = await _read_revision(big_pool, tenant, vout.id)
+        await MemoryGetTool()(ctx, MemoryGetInput(id=vout.id))
+        await _drain_bumps()
+        after = await _read_revision(big_pool, tenant, vout.id)
+        assert before == after, "access bump must not invalidate the revision"
+
+        # (e.4) history carries per-version revisions.
+        hist = await MemoryGetTool()(
+            ctx, MemoryGetInput(id=vout.id, include_history=True)
+        )
+        await _drain_bumps()
+        assert isinstance(hist, MemoryGetOutput)
+        assert len(hist.history) == 1  # one predecessor (the original v1)
+        for h in hist.history:
+            assert isinstance(h.revision, str)
+            assert h.revision != ""
+        # current + the single history entry have distinct, non-empty,
+        # per-version revisions; history[0] is the superseded predecessor.
+        assert str(hist.history[0].id) == str(dec_id)
+        assert hist.memory.revision != hist.history[0].revision
+    finally:
+        await _cleanup(big_pool, tenant, team, client_id)
