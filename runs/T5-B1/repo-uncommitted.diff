+def _build_deps() -> ToolDeps:
+    """ToolDeps with a stub embedder so no Bedrock/AWS is needed at runtime."""
+
+    class _StubEmbed:
+        async def embed(self, content: str) -> EmbedResult:
+            return EmbedResult(
+                vector=[0.0] * 1024, input_tokens=max(1, len(content) // 4)
+            )
+
+    return ToolDeps(
+        embeddings=_StubEmbed(), audit=NoopAuditLogger(), quotas=NoopQuotas()
+    )
