+async def _setup(conn: asyncpg.Connection) -> dict[str, Any]:
+    """Create a tenant + team + member-role + identity + oauth_client.
+
+    Mirrors ``test_mindmap_e2e._setup``. The owning tenant reads its own
+    memories via the ``tenant_id =`` clause of ``memories_select`` (no
+    ``team_members`` membership required for self-access).
+    """
+    tenant = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"uc-{uuid4()}@example.test",
+    )
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+        f"uc-team-{uuid4().hex[:8]}",
+        tenant,
+    )
+    await assign_role(
+        conn,
+        parent_team_id=team,
+        member_kind="user",
+        member_id=tenant,
+        role_key="member",
+        assigned_by_user_id=tenant,
+    )
+    await conn.execute(
+        """
+        INSERT INTO tenant_identities
+            (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+        VALUES ($1, $2, 'cognito', $3, true, $4)
+        """,
+        tenant,
+        f"sub-{uuid4()}",
+        f"uc-{tenant}@example.test",
+        team,
+    )
+    client_id = f"client:uc-{uuid4().hex[:8]}"
+    await conn.execute(
+        """
+        INSERT INTO oauth_clients
+            (id, redirect_uris, scope, registration_payload, review_status)
+        VALUES ($1, ARRAY[]::text[], 'memory.read memory.write', '{}'::jsonb, 'auto_allowed')
+        """,
+        client_id,
+    )
+    return {"tenant": tenant, "team": team, "client_id": client_id}
+
+
+async def _cleanup(
+    pool: asyncpg.Pool, tenant: UUID, team: UUID, client_id: str
+) -> None:
+    """Tear down test rows in FK-safe order (refs → slugs → memories → … → tenant)."""
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute(
+                "DELETE FROM memory_references WHERE source_memory_id IN "
+                "(SELECT id FROM memories WHERE tenant_id = $1) "
+                "OR target_memory_id IN (SELECT id FROM memories WHERE tenant_id = $1)",
+                tenant,
+            )
+            await conn.execute("DELETE FROM slugs WHERE team_id = $1", team)
+            await conn.execute("DELETE FROM memories WHERE tenant_id = $1", tenant)
+            await conn.execute(
+                "DELETE FROM team_role_assignments WHERE parent_team_id = $1", team
+            )
+            await conn.execute(
+                "DELETE FROM tenant_identities WHERE tenant_id = $1", tenant
+            )
+            await conn.execute("DELETE FROM teams WHERE id = $1", team)
+            await conn.execute("DELETE FROM tenants WHERE id = $1", tenant)
+            await conn.execute("DELETE FROM oauth_clients WHERE id = $1", client_id)
+
+
+def _ctx(pool: asyncpg.Pool, tenant: UUID, client_id: str) -> ToolContext:
+    return ToolContext(
+        request_id=f"req-{uuid4().hex[:8]}",
+        tenant_id=tenant,
+        identity_id=tenant,
+        client_id=client_id,
+        scopes=frozenset({"memory.read", "memory.write"}),
+        db_pool=pool,
+        deps=_build_deps(),
+    )
+
+
+async def _insert_memory(
+    conn: asyncpg.Connection,
+    tenant: UUID,
+    team: UUID,
+    content: str,
+    mtype: str = "note",
+    tags: list[str] | None = None,
+    metadata: dict[str, Any] | None = None,
+) -> tuple[UUID, int, str]:
+    """Insert a memory directly (no dedupe) and return (id, version, revision)."""
+    row = await conn.fetchrow(
+        """
+        INSERT INTO memories
+            (tenant_id, team_id, content, content_hash, embedding, source_kind,
+             type, tags, metadata, visibility, embedding_status, indexable)
+        VALUES ($1, $2, $3, $4, array_fill(0::real, ARRAY[1024])::vector, 'api',
+                $5, $6, $7::jsonb, 'team', 'ok', true)
+        RETURNING id, version, revision
+        """,
+        tenant,
+        team,
+        content,
+        hash_content(content),
+        mtype,
+        tags or [],
+        json.dumps(metadata or {}),
+    )
+    assert row is not None
+    return row["id"], int(row["version"]), _coerce(row["revision"])
+
+
+async def _read_revision(pool: asyncpg.Pool, tenant: UUID, mid: UUID) -> str:
+    """Read a row's revision directly (no access bump) — the caller's ground truth."""
+    async with tenant_tx(pool, tenant) as conn:
+        rev = await conn.fetchval(
+            "SELECT revision FROM memories WHERE id = $1 AND tenant_id = $2",
+            mid,
+            tenant,
+        )
+    return _coerce(rev)
+
+
+async def _read_tags(pool: asyncpg.Pool, tenant: UUID, mid: UUID) -> list[str]:
+    async with tenant_tx(pool, tenant) as conn:
+        tags = await conn.fetchval(
+            "SELECT tags FROM memories WHERE id = $1 AND tenant_id = $2",
+            mid,
+            tenant,
+        )
+    return list(tags)
+
+
+async def _read_row(
+    pool: asyncpg.Pool, tenant: UUID, mid: UUID
+) -> dict[str, Any]:
+    async with tenant_tx(pool, tenant) as conn:
+        return dict(
+            await conn.fetchrow(
+                "SELECT id, is_current, superseded_by, version, type "
+                "FROM memories WHERE id = $1 AND tenant_id = $2",
+                mid,
+                tenant,
+            )
+        )
+
+
+def _coerce(value: Any) -> str:
+    """Normalise a DB revision (UUID | str | None) to a plain str."""
+    if isinstance(value, str):
+        return value
+    if isinstance(value, UUID):
+        return str(value)
+    return ""
+
+
+async def _drain_bumps() -> None:
+    """Let any in-flight access-bump tasks (from memory_get) commit before close."""
+    if access_tracking._inflight_tasks:
+        await asyncio.gather(*access_tracking._inflight_tasks, return_exceptions=True)
+
+
+async def _new_pool(dsn: str) -> asyncpg.Pool:
+    from mem_mcp.db.pool import _init_connection
+
+    return await asyncpg.create_pool(
+        dsn=dsn,
+        min_size=2,
+        # Order-3 spec: >= 10, sized for 8 concurrent writers + readers.
+        max_size=16,
+        init=_init_connection,
+    )
+
