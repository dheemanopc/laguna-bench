+# --------------------------------------------------------------------------- #
+# (d) sequential stale-token + superseded-id + note→decision promotion
+# --------------------------------------------------------------------------- #
+async def test_sequential_stale_and_superseded_conflicts(big_pool: Any) -> None:
+    """Stale-token and superseded-target conflicts are detected in sequence
+    (no concurrency required) so the contract can be exercised deterministically.
+    """
+    async with big_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(big_pool, tenant, client_id)
+    try:
+        async with big_pool.acquire() as conn:
+            async with conn.transaction():
+                # (d.1) stale-token: a note edited once, then a stale token is rejected.
+                note_id, _, r0 = await _insert_memory(
+                    conn, tenant, team, "seq note", "note", tags=["x"]
+                )
+                # (d.2) superseded-id: a decision that will be superseded by v2.
+                dec_id, _, d0 = await _insert_memory(
+                    conn,
+                    tenant,
+                    team,
+                    "orig decision",
+                    "decision",
+                    tags=["d"],
+                )
+
+        # --- stale token -----------------------------------------------------
+        ok = await MemoryUpdateTool()(
+            ctx, MemoryUpdateInput(id=note_id, content="v1", expected_revision=r0)
+        )
+        assert isinstance(ok, MemoryUpdateOutput)
+        r1 = ok.revision
+        assert r1 != r0
+
+        with pytest.raises(JsonRpcError) as exc:
+            await MemoryUpdateTool()(
+                ctx,
+                MemoryUpdateInput(id=note_id, content="v2", expected_revision=r0),
+            )
+        assert exc.value.code == -32000
+        assert exc.value.data is not None
+        assert exc.value.data["code"] == "update_conflict"
+        assert exc.value.data["current_id"] == str(note_id)
+        assert exc.value.data["current_revision"] == r1
+
+        # --- superseded id ---------------------------------------------------
+        win = await MemoryUpdateTool()(
+            ctx,
+            MemoryUpdateInput(
+                id=dec_id, content="v2 decision", expected_revision=d0
+            ),
+        )
+        assert isinstance(win, MemoryUpdateOutput)
+        assert win.is_new_version is True
+        assert win.version == 2
+
+        # Editing the now-superseded v1 must point at the live tip (the winner).
+        with pytest.raises(JsonRpcError) as exc:
+            await MemoryUpdateTool()(ctx, MemoryUpdateInput(id=dec_id))
+        assert exc.value.code == -32000
+        assert exc.value.data is not None
+        assert exc.value.data["code"] == "update_conflict"
+        assert exc.value.data["current_id"] == str(win.id)
+
+        # DB: v1 superseded by winner; winner is the only current decision.
+        v1 = await _read_row(big_pool, tenant, dec_id)
+        assert v1["is_current"] is False
+        assert v1["superseded_by"] == win.id
+        winner_row = await _read_row(big_pool, tenant, win.id)
+        assert winner_row["is_current"] is True
+    finally:
+        await _cleanup(big_pool, tenant, team, client_id)
+
