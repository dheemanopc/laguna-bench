@@ -0,0 +1,94 @@
+"""Optimistic-concurrency revision token + row-lock safety for memory_update.
+
+Adds a `revision` uuid column to `memories` and a `BEFORE UPDATE` row trigger
+that regenerates it whenever a *semantic* mutation happens. The trigger
+deliberately ignores columns mutated by read-path bookkeeping (last_accessed_at,
+access_count) and by embedding backfill, so a `memory_get` access-bump never
+invalidates the revision the caller just received.
+
+Callers pass `expected_revision` (from a prior `memory_get` or `memory_update`)
+to `memory_update`; read-committed `SELECT ... FOR UPDATE` serialises concurrent
+editors so exactly one wins and the rest get `-32000 update_conflict` with the
+current revision / current id to re-merge against — instead of silently losing
+tag adds or forking versioned chains (see order-1.md).
+
+Revision ID: 0046_memory_revision
+Revises: 0045_fix_turn_backfill
+Create Date: 2026-10-15
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0046_memory_revision"
+down_revision = "0045_fix_turn_backfill"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    # Add the column first with a per-row default so existing rows each get a
+    # DISTINCT uuid (gen_random_uuid() is volatile -> evaluated per row).
+    op.execute(
+        sa.text(
+            "ALTER TABLE memories ADD COLUMN revision UUID NOT NULL DEFAULT gen_random_uuid()"
+        )
+    )
+
+    # Trigger: regenerate revision only on *semantic* mutations. The guard set
+    # (content, type, tags, metadata, is_current, superseded_by, deleted_at)
+    # intentionally excludes last_accessed_at/access_count (touched by the
+    # read-path access bump in access_tracking.py) and embedding/embedding_status
+    # (touched by the embedding backfill job), so those writers do NOT bump the
+    # revision a caller is racing on.
+    op.execute(
+        sa.text("""
+CREATE OR REPLACE FUNCTION memories_bump_revision()
+RETURNS TRIGGER
+LANGUAGE plpgsql
+AS $$
+BEGIN
+    IF NEW.revision IS NOT DISTINCT FROM OLD.revision
+       AND (
+            NEW.content        IS DISTINCT FROM OLD.content
+         OR NEW.type           IS DISTINCT FROM OLD.type
+         OR NEW.tags           IS DISTINCT FROM OLD.tags
+         OR NEW.metadata       IS DISTINCT FROM OLD.metadata
+         OR NEW.is_current     IS DISTINCT FROM OLD.is_current
+         OR NEW.superseded_by  IS DISTINCT FROM OLD.superseded_by
+         OR NEW.deleted_at     IS DISTINCT FROM OLD.deleted_at
+       )
+    THEN
+        NEW.revision := gen_random_uuid();
+    END IF;
+    RETURN NEW;
+END;
+$$;
+        """)
+    )
+
+    op.execute(
+        sa.text("""
+CREATE TRIGGER memories_bump_revision_trg
+BEFORE UPDATE ON memories
+FOR EACH ROW EXECUTE FUNCTION memories_bump_revision()
+        """)
+    )
+
+    # The trigger function is invoked indirectly by the trigger, but grant
+    # explicit EXECUTE to mem_app to mirror the SECURITY DEFINER-function grant
+    # pattern (0016) and stay usable if we ever attach it manually.
+    op.execute(sa.text("GRANT EXECUTE ON FUNCTION memories_bump_revision() TO mem_app"))
+
+
+def downgrade() -> None:
+    op.execute(
+        sa.text("DROP TRIGGER IF EXISTS memories_bump_revision_trg ON memories")
+    )
+    op.execute(
+        sa.text("DROP FUNCTION IF EXISTS memories_bump_revision() CASCADE")
+    )
+    op.execute(sa.text("ALTER TABLE memories DROP COLUMN IF EXISTS revision"))
