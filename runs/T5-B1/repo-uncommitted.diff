+"""Mock-based unit tests for memory_update optimistic-concurrency (revision tokens).
+
+Per order-1.md Tests §1. These are DB-free (AsyncMock conn) and assert:
+  - expected_revision mismatch -> -32000 / update_conflict with current_revision,
+    and crucially that NOTHING is written (no INSERT/UPDATE).
+  - not-current target -> update_conflict with current_id naming the live tip.
+  - MemoryRecord built without a revision still reports a non-empty str revision
+    (incl. in model_dump()), and coerces UUID input to str.
+"""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from typing import Any
+from unittest.mock import AsyncMock, MagicMock
+from uuid import uuid4
+
+import pytest
+
+from mem_mcp.audit.logger import NoopAuditLogger
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.get import MemoryRecord
+from mem_mcp.mcp.tools.update import (
+    MemoryUpdateInput,
+    MemoryUpdateTool,
+)
+
+
+def _patch_tenant_tx(monkeypatch: pytest.MonkeyPatch, conn: AsyncMock) -> None:
+    """Patch tenant_tx to yield our fake conn."""
+    from contextlib import asynccontextmanager
+
+    @asynccontextmanager
+    async def fake_tx(pool: Any, tenant_id: Any) -> Any:
+        yield conn
+
+    monkeypatch.setattr("mem_mcp.mcp.tools.update.tenant_tx", fake_tx)
+
+
+class _StubEmbeddings:
+    async def embed(self, text: str) -> Any:
+        from mem_mcp.embeddings.bedrock import EmbedResult
+
+        return EmbedResult(vector=[0.1] * 1024, input_tokens=len(text.split()))
+
+
+def _build_ctx() -> ToolContext:
+    deps = ToolDeps(
+        embeddings=_StubEmbeddings(),
+        audit=NoopAuditLogger(),
+        quotas=NoopQuotas(),
+    )
+    return ToolContext(
+        request_id=str(uuid4()),
+        tenant_id=uuid4(),
+        identity_id=uuid4(),
+        client_id="client-1",
+        scopes=frozenset(["memory.write"]),
+        db_pool=MagicMock(),
+        deps=deps,
+    )
+
+
+class _Tool:
+    """Regression: expected_revision mismatch must -32000 and write nothing.
+
+    A caller that observed revision R1 but the row moved to R2 (another writer
+    beat them) must get update_conflict carrying R2's revision — and must NOT
+    see any INSERT/UPDATE side effects, so there is nothing to roll back.
+    """
+
+    @pytest.mark.asyncio
+    async def test_expected_revision_mismatch_raises_conflict_and_writes_nothing(
+        self, monkeypatch: pytest.MonkeyPatch
+    ) -> None:
+        tool = MemoryUpdateTool()
+        ctx = _build_ctx()
+        target_id = uuid4()
+        current_revision = str(uuid4())
+
+        conn = AsyncMock()
+        conn.fetchrow.return_value = {
+            "id": target_id,
+            "type": "note",
+            "content": "old content",
+            "version": 1,
+            "tags": [],
+            "metadata": {},
+            "deleted_at": None,
+            "is_current": True,
+            "superseded_by": None,
+            "revision": current_revision,
+        }
+        _patch_tenant_tx(monkeypatch, conn)
+
+        inp = MemoryUpdateInput(
+            id=target_id,
+            content="new content",
+            expected_revision="stale-token",  # deliberately not current_revision
+        )
+
+        with pytest.raises(JsonRpcError) as exc:
+            await tool(ctx, inp)
+
+        assert exc.value.code == -32000
+        data = exc.value.data
+        assert data is not None
+        assert data["code"] == "update_conflict"
+        assert data["current_revision"] == current_revision
+        assert data["current_id"] == str(target_id)
+        # Nothing must be written — no INSERT, no UPDATE execute/fetchval.
+        conn.execute.assert_not_called()
+        conn.fetchval.assert_not_called()
+        # Only the single locked lookup ran.
+        assert conn.fetchrow.await_count == 1
+
+    @pytest.mark.asyncio
+    async def test_expected_revision_matches_proceeds_to_update(
+        self, monkeypatch: pytest.MonkeyPatch
+    ) -> None:
+        """A matching expected_revision clears the guard and proceeds normally."""
+        tool = MemoryUpdateTool()
+        ctx = _build_ctx()
+        target_id = uuid4()
+        rev = str(uuid4())
+
+        conn = AsyncMock()
+        conn.fetchrow.return_value = {
+            "id": target_id,
+            "type": "note",
+            "content": "old content",
+            "version": 1,
+            "tags": [],
+            "metadata": {},
+            "deleted_at": None,
+            "is_current": True,
+            "superseded_by": None,
+            "revision": rev,
+        }
+        conn.fetchval.return_value = rev  # RETURNING revision for the in-place UPDATE
+        _patch_tenant_tx(monkeypatch, conn)
+
+        inp = MemoryUpdateInput(
+            id=target_id,
+            content="new content",
+            expected_revision=rev,
+        )
+
+        from mem_mcp.mcp.tools.update import MemoryUpdateOutput
+
+        output = await tool(ctx, inp)
+        assert isinstance(output, MemoryUpdateOutput)
+        assert output.is_new_version is False
+        assert output.revision == rev
+
+
+class TestNotCurrentConflict:
+    """Regression: updating a superseded (is_current=false) target must surface
+    the live current_id rather than forking a new version off stale history."""
+
+    @pytest.mark.asyncio
+    async def test_not_current_target_raises_with_current_id(
+        self, monkeypatch: pytest.MonkeyPatch
+    ) -> None:
+        tool = MemoryUpdateTool()
+        ctx = _build_ctx()
+        target_id = uuid4()
+        tip_id = uuid4()
+        tip_revision = str(uuid4())
+
+        conn = AsyncMock()
+        # fetchrow.side_effect: [initial locked lookup, recursive-CTE tip lookup]
+        conn.fetchrow.side_effect = [
+            {
+                "id": target_id,
+                "type": "fact",
+                "content": "stale",
+                "version": 1,
+                "tags": [],
+                "metadata": {},
+                "deleted_at": None,
+                "is_current": False,
+                "superseded_by": tip_id,
+                "revision": str(uuid4()),
+            },
+            {"id": tip_id, "revision": tip_revision},
+        ]
+        _patch_tenant_tx(monkeypatch, conn)
+
+        inp = MemoryUpdateInput(id=target_id, content="stale")
+
+        with pytest.raises(JsonRpcError) as exc:
+            await tool(ctx, inp)
+
+        assert exc.value.code == -32000
+        data = exc.value.data
+        assert data is not None
+        assert data["code"] == "update_conflict"
+        assert data["current_id"] == str(tip_id)
+        assert data["current_revision"] == tip_revision
+        # No writes attempted.
+        conn.execute.assert_not_called()
+        conn.fetchval.assert_not_called()
+
+    @pytest.mark.asyncio
+    async def test_not_current_no_tip_still_conflicts(
+        self, monkeypatch: pytest.MonkeyPatch
+    ) -> None:
+        """If the recursive walk finds no current tip (chain head deleted) we
+        still raise update_conflict with what we have."""
+        tool = MemoryUpdateTool()
+        ctx = _build_ctx()
+        target_id = uuid4()
+
+        conn = AsyncMock()
+        conn.fetchrow.side_effect = [
+            {
+                "id": target_id,
+                "type": "note",
+                "content": "x",
+                "version": 1,
+                "tags": [],
+                "metadata": {},
+                "deleted_at": None,
+                "is_current": False,
+                "superseded_by": uuid4(),
+                "revision": str(uuid4()),
+            },
+            None,  # no current tip found
+        ]
+        _patch_tenant_tx(monkeypatch, conn)
+
+        with pytest.raises(JsonRpcError) as exc:
+            await tool(ctx, MemoryUpdateInput(id=target_id, content="y"))
+        assert exc.value.code == -32000
+        data = exc.value.data
+        assert data is not None
+        assert data["code"] == "update_conflict"
+        assert data["current_id"] == str(target_id)
+        conn.execute.assert_not_called()
+
+
+class TestMemoryRecordRevision:
+    """MemoryRecord.revision must always be a non-empty str, even when the row
+    dict omits it (e.g. pre-migration test fixtures) — and must round-trip via
+    model_dump()."""
+
+    def _base_kwargs(self) -> dict[str, Any]:
+        return {
+            "id": uuid4(),
+            "content": "c",
+            "type": "note",
+            "tags": [],
+            "metadata": {},
+            "version": 1,
+            "is_current": True,
+            "supersedes": None,
+            "superseded_by": None,
+            "created_at": datetime.now(UTC),
+            "updated_at": datetime.now(UTC),
+            "deleted_at": None,
+            "expires_at": None,
+            "indexable": True,
+            "embedding_status": "ok",
+        }
+
+    def test_built_without_revision_has_nonempty_str(self) -> None:
+        rec = MemoryRecord(**self._base_kwargs())
+        assert isinstance(rec.revision, str)
+        assert rec.revision != ""
+        assert rec.revision == f"{rec.id}:{rec.updated_at.isoformat()}"
+
+    def test_revision_appears_in_model_dump(self) -> None:
+        rec = MemoryRecord(**self._base_kwargs())
+        dumped = rec.model_dump()
+        assert "revision" in dumped
+        assert isinstance(dumped["revision"], str)
+        assert dumped["revision"] != ""
+
+    def test_revision_appears_in_json_model_dump(self) -> None:
+        rec = MemoryRecord(**self._base_kwargs())
+        dumped = rec.model_dump(mode="json")
+        assert isinstance(dumped["revision"], str)
+        assert dumped["revision"] != ""
+
+    def test_uuid_input_coerced_to_str(self) -> None:
+        # Passing a raw UUID exercises the mode="before" validator that
+        # normalises asyncpg UUID objects to str.
+        u = uuid4()
+        rec = MemoryRecord(**self._base_kwargs(), revision=u)  # type: ignore[arg-type]
+        assert rec.revision == str(u)
+        assert rec.revision != f"{rec.id}:{rec.updated_at.isoformat()}"
