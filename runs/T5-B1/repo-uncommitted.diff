+# --------------------------------------------------------------------------- #
+# (b) concurrent decision content updates → exactly one winner
+# --------------------------------------------------------------------------- #
+async def test_concurrent_decision_content_updates_exactly_one_winner(
+    big_pool: Any,
+) -> None:
+    """8 concurrent content edits on a versioned decision: exactly 1 commits a
+    new version; the rest raise ``update_conflict`` naming the winner as
+    ``current_id``.
+
+    Without the ``SELECT ... FOR UPDATE`` + ``is_current`` guard the losers
+    would read the still-current v1, each INSERT their own version, and fork the
+    chain (multiple ``is_current = true`` rows, multiple "winners").
+    """
+    async with big_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(big_pool, tenant, client_id)
+    try:
+        async with big_pool.acquire() as conn:
+            async with conn.transaction():
+                mid, _, _ = await _insert_memory(
+                    conn, tenant, team, "original decision content", "decision", tags=["d"]
+                )
+
+        async def call(i: int) -> Any:
+            return await MemoryUpdateTool()(
+                ctx,
+                MemoryUpdateInput(id=mid, content=f"updated decision content {i}"),
+            )
+
+        results = await asyncio.gather(
+            *(call(i) for i in range(CONCURRENCY)), return_exceptions=True
+        )
+
+        successes = [r for r in results if not isinstance(r, BaseException)]
+        conflicts = [
+            r
+            for r in results
+            if isinstance(r, JsonRpcError)
+            and r.data is not None
+            and r.data.get("code") == "update_conflict"
+        ]
+        assert len(successes) == 1, f"expected exactly 1 winner, got {len(successes)}"
+        assert len(conflicts) == CONCURRENCY - 1
+
+        winner = successes[0]
+        assert isinstance(winner, MemoryUpdateOutput)
+        assert winner.is_new_version is True
+        assert winner.version == 2
+        assert winner.revision != ""  # fresh token rotated
+
+        # Every loser must be told to re-merge against the winner's new row.
+        for c in conflicts:
+            assert c.data is not None
+            assert c.data["current_id"] == str(winner.id), c.data
+
+        # DB-level ground truth: the original v1 is superseded by the winner.
+        orig = await _read_row(big_pool, tenant, mid)
+        assert orig["is_current"] is False
+        assert orig["superseded_by"] == winner.id
+        winner_row = await _read_row(big_pool, tenant, winner.id)
+        assert winner_row["is_current"] is True
+        assert winner_row["version"] == 2
+    finally:
+        await _cleanup(big_pool, tenant, team, client_id)
+
