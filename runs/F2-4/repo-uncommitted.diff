+_TW, _STAGES, _TRANSITIONS, _SIGREQ, _SIGNUPS = NEW_TABLES
+
+# asyncpg raises InsufficientPrivilegeError for BOTH "permission denied for
+# table" (missing GRANT) and "new row violates row-level security policy"
+# (INSERT WITH CHECK) — both are SQLSTATE 42501. So it is the single exception
+# to assert in the mem_app behavioural tests below.
+InsufficientPermissionError = asyncpg.InsufficientPrivilegeError
