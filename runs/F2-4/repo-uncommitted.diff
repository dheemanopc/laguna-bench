+async def _ensure_work_item(
+    conn: Any, t_id: UUID, team_id: UUID, mem_id: UUID
+) -> UUID:
+    """Insert a work_items row for mem_id (the FK target for signoff_requests).
+
+    _seed_workflow_base only creates a memories row; workflow_signoff_requests
+    references work_items(memory_id), so callers must materialise the work item
+    first (mirrors TestDeletionBlocked.test_blocked_by_work_items_reference).
+    """
+    await conn.execute(
+        "INSERT INTO work_items "
+        "(memory_id, root_memory_id, tenant_id, team_id, kind, status, created_by) "
+        "VALUES ($1, $1, $2, $3, 'story', 'todo', $2)",
+        mem_id,
+        t_id,
+        team_id,
+    )
+    return mem_id
+
+
+async def _as_mem_app(conn: Any, tenant_id: UUID) -> None:
+    """Assume the mem_app role in tenant_id context for the current tx.
+
+    set_config(..., true) and SET LOCAL ROLE are both transaction-local and
+    revert on ROLLBACK, so no pool contamination can leak (verified by probe).
+    """
+    await conn.execute(
+        "SELECT set_config('app.current_tenant_id', $1, true)", str(tenant_id)
+    )
+    await conn.execute("SET LOCAL ROLE mem_app")
+
+
+async def _insert_signoff_requests_row(
+    conn: Any, t_id: UUID, team_id: UUID, mem_id: UUID
+) -> UUID:
+    """Insert a workflow_signoff_requests row, returning its request_id."""
+    return await conn.fetchval(
+        "INSERT INTO workflow_signoff_requests "
+        "(tenant_id, work_item_memory_id, from_stage, to_stage, proposer_tenant_id) "
+        "VALUES ($1, $2, $3, $4, $1) RETURNING request_id",
+        t_id,
+        mem_id,
+        "todo",
+        "done",
+    )
