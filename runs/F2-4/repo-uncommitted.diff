+    async def test_update_and_delete_refused_on_immutable_tables(
+        self, pg_pool: Any, table: str, col: str
+    ) -> None:
+        """mem_app is refused UPDATE + DELETE on the immutable tables (no grants).
+
+        The grant layer refuses before the policy/row layer is consulted, so no
+        seed rows are needed: UPDATE/DELETE privilege is checked at statement
+        start and the grant is absent on these three tables.
+        """
+        async with pg_pool.acquire() as conn:
+            tx = conn.transaction()
+            await tx.start()
+            try:
+                t_id_a = await conn.fetchval(
+                    "INSERT INTO tenants (email, status) VALUES ($1, 'active') RETURNING id",
+                    f"rls-immut-{uuid4()}@x.test",
+                )
+                await _as_mem_app(conn, t_id_a)
+                with pytest.raises(InsufficientPermissionError):
+                    async with conn.transaction():
+                        await conn.execute(
+                            f"UPDATE {table} SET {col} = {col} WHERE FALSE"
+                        )
+                with pytest.raises(InsufficientPermissionError):
+                    async with conn.transaction():
+                        await conn.execute(f"DELETE FROM {table} WHERE FALSE")
+            finally:
+                await conn.execute("RESET ROLE")
+                await tx.rollback()
