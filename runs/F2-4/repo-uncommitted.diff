+                t_id, team_id, wf_id, mem_id = await _seed_workflow_base(conn)
+                await _ensure_work_item(conn, t_id, team_id, mem_id)
+                first = await _insert_signoff_requests_row(conn, t_id, team_id, mem_id)
+                # 2nd pending proposal on the same item violates the partial unique.
+                with pytest.raises(Exception) as exc:
+                    async with conn.transaction():
+                        await _insert_signoff_requests_row(conn, t_id, team_id, mem_id)
+                assert "unique" in str(exc.value).lower() or "duplicate" in str(
+                    exc.value
+                ).lower()
+                # Resolving the first moves it out of 'pending', freeing the slot.
+                await conn.execute(
+                    "UPDATE workflow_signoff_requests SET status = 'approved' "
+                    "WHERE request_id = $1",
+                    first,
+                )
+                second = await _insert_signoff_requests_row(conn, t_id, team_id, mem_id)
+                assert second is not None
+            finally:
+                await tx.rollback()
