+class TestConstraintsBehavioural:
+    """Constraint / index enforcement (runs as owner — constraints are not RLS).
+
+    RLS is the only thing the superuser pool owner bypasses; CHECK constraints,
+    UNIQUE / partial-UNIQUE indexes, and foreign keys apply to every role. These
+    tests run as the owner and are contained in savepoints so a violating INSERT
+    does not abort the outer transaction.
+    """
+
+    async def test_active_per_team_allows_one_active_rejects_second(self, pg_pool: Any) -> None:
+        """team_workflows_active_per_team: 2nd active per team rejected, inactive allowed."""
+        async with pg_pool.acquire() as conn:
+            tx = conn.transaction()
+            await tx.start()
+            try:
+                t_id, team_id, wf_id, _ = await _seed_workflow_base(conn)
+                # _seed_workflow_base inserts an *inactive* workflow (default), so
+                # insert a first *active* one as the baseline (the team's only
+                # active workflow so far) before testing the partial-unique refusal.
+                first = await conn.fetchval(
+                    "INSERT INTO team_workflows "
+                    "(tenant_id, team_id, name, is_active, version, created_by) "
+                    "VALUES ($1, $2, $3, TRUE, 1, $1) RETURNING workflow_id",
+                    t_id,
+                    team_id,
+                    f"act1-{uuid4().hex}",
+                )
+                assert first is not None
+                # A 2nd active workflow for the same team violates the partial
+                # unique index (team_id) WHERE is_active.
+                with pytest.raises(Exception) as exc:
+                    async with conn.transaction():
+                        await conn.execute(
+                            "INSERT INTO team_workflows "
+                            "(tenant_id, team_id, name, is_active, version, created_by) "
+                            "VALUES ($1, $2, $3, TRUE, 1, $1)",
+                            t_id,
+                            team_id,
+                            f"act2-{uuid4().hex}",
+                        )
+                assert "unique" in str(exc.value).lower() or "duplicate" in str(
+                    exc.value
+                ).lower(), f"unexpected: {exc.value!r}"
+                # An *inactive* workflow for the same team is allowed.
+                inactive = await conn.fetchval(
+                    "INSERT INTO team_workflows "
+                    "(tenant_id, team_id, name, is_active, version, created_by) "
+                    "VALUES ($1, $2, $3, FALSE, 1, $1) RETURNING workflow_id",
+                    t_id,
+                    team_id,
+                    f"inact-{uuid4().hex}",
+                )
+                assert inactive is not None
+            finally:
+                await tx.rollback()
