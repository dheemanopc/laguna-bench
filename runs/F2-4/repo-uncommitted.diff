+    @pytest.mark.parametrize("table,col", [
+        (_STAGES, "name"),                 # SELECT+INSERT only -> no UPDATE/DELETE
+        (_TRANSITIONS, "signoff_min"),     # SELECT+INSERT only -> no UPDATE/DELETE
