+class TestRlsAsMemApp:
+    """Behavioural RLS/grant checks that RUN AS the mem_app role.
+
+    The superuser pool owner bypasses RLS, so the existing TestPerTableGrants /
+    TestDeletionBlocked tests pass even with the grants stripped. These tests
+    assume mem_app inside an explicit transaction (SET LOCAL ROLE) so the
+    policies and GRANTs are actually exercised.
+    """
+
+    async def test_tenant_a_cannot_select_tenant_b_rows(self, pg_pool: Any) -> None:
+        """mem_app in tenant A's context must see 0 rows of tenant B in all 5 tables."""
+        async with pg_pool.acquire() as conn:
+            tx = conn.transaction()
+            await tx.start()
+            try:
+                t_id_a = await conn.fetchval(
+                    "INSERT INTO tenants (email, status) VALUES ($1, 'active') RETURNING id",
+                    f"rls-a-{uuid4()}@x.test",
+                )
+                t_id_b = await conn.fetchval(
+                    "INSERT INTO tenants (email, status) VALUES ($1, 'active') RETURNING id",
+                    f"rls-b-{uuid4()}@x.test",
+                )
+                team_b = await conn.fetchval(
+                    "INSERT INTO teams (name, created_by_tenant_id, team_type) "
+                    "VALUES ($1, $2, 'personal') RETURNING id",
+                    f"rls-b-{uuid4().hex}",
+                    t_id_b,
+                )
+                # Seed a row in every new table for tenant B.
+                ids = await _seed_tenant_b_rows(conn, t_id_b, team_b)
+                await _seed_signups_row(conn, t_id_b, ids["rq_b"])
+
+                # (owner) rows are present for tenant B in every table.
+                for table in NEW_TABLES:
+                    own = await conn.fetchval(
+                        f"SELECT count(*) FROM {table} WHERE tenant_id = $1", t_id_b
+                    )
+                    assert own >= 1, f"{table}: no seed row for tenant B"
+
+                # (mem_app, tenant A context) all tenant-B rows are filtered out.
+                await _as_mem_app(conn, t_id_a)
+                for table in NEW_TABLES:
+                    hidden = await conn.fetchval(f"SELECT count(*) FROM {table}")
+                    assert hidden == 0, (
+                        f"{table}: mem_app(tenant A) saw {hidden} tenant-B rows"
+                    )
+            finally:
+                await conn.execute("RESET ROLE")
+                await tx.rollback()
