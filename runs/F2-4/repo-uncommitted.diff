+class TestDowngradeUpgradeRoundTrip:
+    """0048 downgrade -> upgrade must be a clean round-trip on an empty schema.
+
+    Guarded by try/finally ``upgrade head`` so the shared DB is always restored
+    to HEAD even if an assertion fails mid-test. Empty schema is required because
+    downgrade re-adds the 4-value change_type CHECK, which rejects any row that
+    uses an 0048-only change_type (see the CAUTION comment in downgrade()). Lives
+    last so the schema-level behavioural tests run at HEAD first.
+    """
+
+    async def test_roundtrip_restores_head_with_all_objects(self, pg_pool: Any) -> None:
+        import alembic.command as alembic_command
+        from alembic.config import Config as AlembicConfig
+
+        cfg = AlembicConfig("alembic.ini")
+        try:
+            # Downgrade one step (0048 -> 0047), then climb back to HEAD.
+            alembic_command.downgrade(cfg, "0047_work_item_history_rls_fix")
+            alembic_command.upgrade(cfg, "head")
+            # Assert the 0048 objects are present again after the round-trip.
+            async with pg_pool.acquire() as conn:
+                for table in NEW_TABLES:
+                    exists = await conn.fetchval(
+                        "SELECT EXISTS (SELECT 1 FROM information_schema.tables "
+                        "WHERE table_name = $1 AND table_type = 'BASE TABLE')",
+                        table,
+                    )
+                    assert exists, f"{table} missing after round-trip"
+                idx = await conn.fetchval(
+                    "SELECT EXISTS (SELECT 1 FROM pg_indexes "
+                    "WHERE indexname = $1)",
+                    "workflow_signoff_requests_one_pending_per_item",
+                )
+                assert idx is True, "one-pending-per-item index missing after round-trip"
+        finally:
+            # Guarantee the shared DB is back at HEAD regardless of outcome.
+            alembic_command.upgrade(cfg, "head")
+
