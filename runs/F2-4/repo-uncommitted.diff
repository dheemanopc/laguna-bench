+async def _seed_tenant_b_rows(
+    conn: Any, t_id_b: UUID, team_b: UUID
+) -> dict[str, UUID]:
+    """As the superuser pool owner, seed one row per new table for tenant B.
+
+    The chain respects the FK graph: team_workflows -> workflow_stages /
+    workflow_transitions -> workflow_signoff_requests (needs a work_items row)
+    -> workflow_signups. Returns the inserted ids so behavioural tests can both
+    prove the rows exist (as owner) and prove they are invisible (as mem_app).
+    Identifiers are UUID-suffixed; nothing is cleaned up — the outer tx rolls
+    back.
+    """
+    out: dict[str, UUID] = {}
+    out["wf_b"] = await conn.fetchval(
+        "INSERT INTO team_workflows "
+        "(tenant_id, team_id, name, is_active, version, created_by) "
+        "VALUES ($1, $2, $3, TRUE, 1, $1) RETURNING workflow_id",
+        t_id_b,
+        team_b,
+        f"wf-b-{uuid4().hex}",
+    )
+    out["stage_b"] = await conn.fetchval(
+        "INSERT INTO workflow_stages (tenant_id, workflow_id, name, ordinal) "
+        "VALUES ($1, $2, $3, 1) RETURNING stage_id",
+        t_id_b,
+        out["wf_b"],
+        f"stage-b-{uuid4().hex}",
+    )
+    # from_stage NULL is allowed (CHECK is from OR to non-null).
+    out["tr_b"] = await conn.fetchval(
+        "INSERT INTO workflow_transitions (tenant_id, workflow_id, to_stage_id) "
+        "VALUES ($1, $2, $3) RETURNING transition_id",
+        t_id_b,
+        out["wf_b"],
+        out["stage_b"],
+    )
+    # workflow_signoff_requests FKs work_items(memory_id): seed a work item.
+    mem_b = await conn.fetchval(
+        "INSERT INTO memories (tenant_id, team_id, content, content_hash, source_kind) "
+        "VALUES ($1, $2, 'c', $3, 'api') RETURNING id",
+        t_id_b,
+        team_b,
+        f"hash-{uuid4().hex}",
+    )
+    await conn.execute(
+        "INSERT INTO memory_maps (root_memory_id, tenant_id, team_id, title) "
+        "VALUES ($1, $2, $3, 'seed-b')",
+        mem_b,
+        t_id_b,
+        team_b,
+    )
+    wi_mem = await conn.fetchval(
+        "INSERT INTO work_items "
+        "(memory_id, root_memory_id, tenant_id, team_id, kind, status, created_by) "
+        "VALUES ($1, $1, $2, $3, 'story', 'todo', $2) RETURNING memory_id",
+        mem_b,
+        t_id_b,
+        team_b,
+    )
+    out["wi_mem"] = wi_mem
+    out["rq_b"] = await conn.fetchval(
+        "INSERT INTO workflow_signoff_requests "
+        "(tenant_id, work_item_memory_id, from_stage, to_stage, proposer_tenant_id) "
+        "VALUES ($1, $2, $3, $4, $1) RETURNING request_id",
+        t_id_b,
+        wi_mem,
+        "todo",
+        "done",
+    )
+    return out
+
