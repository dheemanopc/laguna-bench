+async def _seed_signups_row(
+    conn: Any, t_id_b: UUID, rq_b: UUID
+) -> UUID:
+    """Seed one row in the signups table for tenant B (needs a request_id)."""
+    return await conn.fetchval(
+        f"INSERT INTO {_SIGNUPS} (tenant_id, request_id, signatory_tenant_id) "
+        "VALUES ($1, $2, $1) RETURNING signoff_id",
+        t_id_b,
+        rq_b,
+    )
