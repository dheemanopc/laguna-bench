+"""Unit tests for memory.update optimistic-concurrency and conflict paths.
+
+Regression coverage for the three concurrency bugs fixed in revision 0046:
+  1. Tag add/remove merges lost concurrent updates (no FOR UPDATE).
+  2. Versioned path created duplicate current rows on concurrent updates.
+  3. No optimistic-concurrency token.
+
+These tests use AsyncMock to verify the branching logic without a real DB;
+the real-Postgres concurrency behaviour lives in
+tests/integration/test_memory_update_concurrency.py.
+"""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from typing import Any
+from unittest.mock import AsyncMock, MagicMock
+from uuid import uuid4
+
+import pytest
+
+from mem_mcp.audit.logger import NoopAuditLogger
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.get import MemoryRecord
+from mem_mcp.mcp.tools.update import (
+    MemoryUpdateInput,
+    MemoryUpdateOutput,
+    MemoryUpdateTool,
+)
+
+
+class _StubEmbeddings:
+    """Stub embeddings client that returns a valid EmbedResult."""
+
+    async def embed(self, text: str) -> Any:
+        from mem_mcp.embeddings.bedrock import EmbedResult
+
+        return EmbedResult(vector=[0.1] * 1024, input_tokens=len(text.split()))
+
+
+def _patch_tenant_tx(monkeypatch: pytest.MonkeyPatch, conn: AsyncMock) -> None:
+    from contextlib import asynccontextmanager
+
+    @asynccontextmanager
+    async def fake_tx(pool: Any, tenant_id: Any) -> Any:
+        yield conn
+
+    monkeypatch.setattr("mem_mcp.mcp.tools.update.tenant_tx", fake_tx)
+
+
+def _build_ctx(scopes: tuple[str, ...] = ("memory.write",)) -> ToolContext:
+    deps = ToolDeps(
+        embeddings=_StubEmbeddings(),
+        audit=NoopAuditLogger(),
+        quotas=NoopQuotas(),
+    )
+    return ToolContext(
+        request_id=str(uuid4()),
+        tenant_id=uuid4(),
+        identity_id=uuid4(),
+        client_id="client-1",
+        scopes=frozenset(scopes),
+        db_pool=MagicMock(),
+        deps=deps,
+    )
+
+
+class TestUpdateConflicts:
+    """Optimistic-concurrency and conflict-path unit tests."""
+
+    # ── 1. Stale revision token ──────────────────────────────────────────
+
+    @pytest.mark.asyncio
+    async def test_stale_revision_token_raises_conflict(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        """expected_revision that doesn't match the row's revision → -32000."""
+        tool = MemoryUpdateTool()
+        ctx = _build_ctx()
+        target_id = uuid4()
+        row_revision = "abc123"
+
+        inp = MemoryUpdateInput(
+            id=target_id,
+            content="new content",
+            expected_revision="deadbeef",  # deliberately wrong
+        )
+
+        conn = AsyncMock()
+        conn.fetchrow.return_value = {
+            "id": target_id,
+            "type": "note",
+            "content": "old content",
+            "tags": [],
+            "metadata": {},
+            "deleted_at": None,
+            "is_current": True,
+            "superseded_by": None,
+            "revision": row_revision,
+        }
+        _patch_tenant_tx(monkeypatch, conn)
+
+        with pytest.raises(JsonRpcError) as exc:
+            await tool(ctx, inp)
+
+        assert exc.value.code == -32000
+        assert exc.value.data is not None
+        assert exc.value.data["code"] == "update_conflict"
+        assert exc.value.data["current_revision"] == row_revision
+        assert exc.value.data["current_id"] == str(target_id)
+
+    # ── 2. Superseded target ─────────────────────────────────────────────
+
+    @pytest.mark.asyncio
+    async def test_superseded_target_raises_conflict(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        """Row is_current=False → -32000 update_conflict with current_id."""
+        tool = MemoryUpdateTool()
+        ctx = _build_ctx()
+        target_id = uuid4()
+        current_id = uuid4()
+
+        inp = MemoryUpdateInput(id=target_id, content="new content")
+
+        conn = AsyncMock()
+        # Two fetchrow calls: (1) initial lookup finds superseded row,
+        # (2) chain-walk finds the current version.
+        conn.fetchrow.side_effect = [
+            {
+                "id": target_id,
+                "type": "note",
+                "content": "old content",
+                "version": 1,
+                "tags": [],
+                "metadata": {},
+                "deleted_at": None,
+                "is_current": False,
+                "superseded_by": current_id,
+                "revision": "old-revision",
+            },
+            # chain-walk result
+            {
+                "id": current_id,
+                "revision": "current-revision",
+            },
+        ]
+        _patch_tenant_tx(monkeypatch, conn)
+
+        with pytest.raises(JsonRpcError) as exc:
+            await tool(ctx, inp)
+
+        assert exc.value.code == -32000
+        assert exc.value.data is not None
+        assert exc.value.data["code"] == "update_conflict"
+        assert exc.value.data["current_id"] == str(current_id)
+        assert exc.value.data["current_revision"] == "current-revision"
