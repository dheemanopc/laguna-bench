@@ -0,0 +1,43 @@
+"""Add revision column to memories for optimistic concurrency.
+
+Revision ID: 0046_memory_revision
+Revises: 0045_fix_turn_backfill
+Create Date: 2026-10-16
+
+Adds a ``revision`` UUID column to the ``memories`` table. Each row in the
+versioning chain (both the current row and superseded predecessors) gets its
+own revision value, generated via ``gen_random_uuid()`` at the DB level for
+INSERTs that don't explicitly set it, and explicitly set by ``memory_update``
+for optimistic-concurrency checks.
+
+This fixes three concurrency bugs in ``memory.update``:
+  1. Tag add/remove merges lost concurrent updates (no row lock on lookup).
+  2. Versioned path created duplicate current rows on concurrent updates to
+     the same target (no conditional guard on the supersede UPDATE).
+  3. No optimistic-concurrency token — callers couldn't detect stale reads.
+
+See ``src/mem_mcp/mcp/tools/update.py`` for the locking + conditional-write
+logic and ``tests/`` for the concurrency tests.
+"""
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0046_memory_revision"
+down_revision = "0045_fix_turn_backfill"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    op.execute(
+        sa.text(
+            "ALTER TABLE memories "
+            "ADD COLUMN revision UUID NOT NULL DEFAULT gen_random_uuid()"
+        )
+    )
+
+
+def downgrade() -> None:
+    op.execute(sa.text("ALTER TABLE memories DROP COLUMN IF EXISTS revision"))
