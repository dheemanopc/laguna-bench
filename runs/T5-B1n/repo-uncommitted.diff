+async def test_concurrent_tag_add_preserves_all_tags(wide_pool: Any) -> None:
+    """N concurrent tag-add operations must not lose any tags (FOR UPDATE fix).
+
+    Bug: without FOR UPDATE, concurrent reads see the same stale tags list,
+    each appends its tag, and last-writer-wins overwrites — losing tags.
+    """
+    async with wide_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, client_id = s["tenant"], s["client_id"]
+    ctx = _ctx(wide_pool, tenant, client_id)
+    try:
+        mem_id = await _insert_memory(wide_pool, tenant, "base note", "note", tags=["base"])
+
+        async def add_tag(tag: str) -> None:
+            await MemoryUpdateTool()(
+                ctx, MemoryUpdateInput(id=mem_id, tags=[tag], tags_op="add")
+            )
+
+        await asyncio.gather(*[add_tag(f"t{i}") for i in range(N)])
+
+        tags = await _read_tags(wide_pool, tenant, mem_id)
+        expected = {"base"} | {f"t{i}" for i in range(N)}
+        assert set(tags) == expected, f"lost tags: got {set(tags)}, expected {expected}"
+    finally:
