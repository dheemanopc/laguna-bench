diff --git a/tests/integration/test_memory_update_concurrency.py b/tests/integration/test_memory_update_concurrency.py
new file mode 100644
index 0000000..2e63741
--- /dev/null
+++ b/tests/integration/test_memory_update_concurrency.py
@@ -0,0 +1,639 @@
+"""Integration tests for memory.update concurrency safety (revision 0046).
+
+Real-Postgres tests verifying:
+  1. Tag add/remove under concurrent access preserves all tags (FOR UPDATE).
+  2. Versioned content updates: 1 winner, N-1 conflicts with correct current_id.
+  3. In-place content without expected_revision: last-writer-wins (no conflict).
+  4. In-place content with expected_revision: stale token → conflict.
+  5. Sequential superseded: updating an old version → conflict.
+  6. Type promotion + updating old (superseded) id → conflict.
+  7. Revision roundtrip: get → update with matching token → success; stale token → conflict.
+  8. Two successive updates yield different revisions.
+  9. Access-bump (memory_get) does not change the revision.
+ 10. History records carry revisions.
+
+Concurrency tests use a dedicated ``wide_pool`` (12 connections) so that N=8
+concurrent coroutines are not serialised on pool checkout — the race is forced
+at the DB level via FOR UPDATE / conditional UPDATEs, not at the pool level.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import os
+from collections.abc import AsyncIterator
+from typing import Any
+from uuid import UUID, uuid4
+
+import asyncpg  # type: ignore[import-untyped]
+import pytest
+
+from mem_mcp.audit.logger import NoopAuditLogger
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.get import MemoryGetInput, MemoryGetOutput, MemoryGetTool
+from mem_mcp.mcp.tools.update import (
+    MemoryUpdateInput,
+    MemoryUpdateOutput,
+    MemoryUpdateTool,
+)
+from mem_mcp.memory.access_tracking import _inflight_tasks
+from mem_mcp.memory.normalize import hash_content
+
+pytestmark = pytest.mark.asyncio
+
+# Number of concurrent updaters in stress tests.
+N = 8
+
+
+# ── Wide connection pool fixture ──────────────────────────────────────────────
+
+
<email>
+async def wide_pool() -> AsyncIterator[Any]:
+    """Live Postgres pool with 12 connections for concurrency stress tests.
+
+    Same init/codec setup as the ``pg_pool`` fixture in conftest (``_init_connection``
+    from ``mem_mcp.db.pool``), but with a larger pool so N concurrent coroutines
+    are not blocked on pool checkout — the race is engineered at the SQL level.
+
+    Skips when ``MEM_MCP_TEST_DSN`` is unset. Before closing, drains any
+    outstanding background ``bump_access`` tasks so they don't get GC'd mid-flight
+    on a closing pool.
+    """
+    dsn = os.environ.get("MEM_MCP_TEST_DSN")
+    if not dsn:
+        pytest.skip("MEM_MCP_TEST_DSN env not set; skipping live-DB test")
+
+    from mem_mcp.db.pool import _init_connection
+
+    pool = await asyncpg.create_pool(
+        dsn=dsn,
+        min_size=12,
+        max_size=12,
+        init=_init_connection,
+    )
+    try:
+        yield pool
+    finally:
+        # Let any fire-and-forget bump_access tasks finish before pool teardown
+        # so they don't error on a closing pool. Only drain tasks from the
+        # current event loop — stale tasks from other test contexts (different
+        # loop) are discarded to avoid cross-loop gather errors.
+        current_loop = asyncio.get_running_loop()
+        pending = [
+            t for t in _inflight_tasks
+            if not t.done() and t.get_loop() is current_loop
+        ]
+        if pending:
+            await asyncio.gather(*pending, return_exceptions=True)
+        _inflight_tasks.clear()
+        await pool.close()
+
+
+# ── Helpers ─────────────────────────────────────────────────────────────────
+
+
+def _build_deps() -> Any:
+    class _StubEmbed:
+        async def embed(self, content: str) -> Any:
+            from mem_mcp.embeddings.bedrock import EmbedResult
+
+            return EmbedResult(vector=[0.0] * 1024, input_tokens=max(1, len(content) // 4))
+
+    return ToolDeps(embeddings=_StubEmbed(), audit=NoopAuditLogger(), quotas=NoopQuotas())
+
+
+def _ctx(pool: Any, tenant: UUID, client_id: str) -> ToolContext:
+    return ToolContext(
+        request_id=f"req-{uuid4().hex[:8]}",
+        tenant_id=tenant,
+        identity_id=tenant,
+        client_id=client_id,
+        scopes=frozenset({"memory.read", "memory.write"}),
+        db_pool=pool,
+        deps=_build_deps(),
+    )
+
+
+async def _setup(conn: asyncpg.Connection) -> dict[str, Any]:
+    """Create tenant + oauth_client. Returns dict with tenant_id, client_id."""
+    tenant = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"it046-{uuid4().hex[:12]}@example.test",
+    )
+    client_id = f"client:it046-{uuid4().hex[:12]}"
+    await conn.execute(
+        """
+        INSERT INTO oauth_clients
+            (id, redirect_uris, scope, registration_payload, review_status)
+        VALUES
+            ($1, ARRAY[]::text[], 'memory.read memory.write', '{}'::jsonb, 'auto_allowed')
+        """,
+        client_id,
+    )
+    return {"tenant": tenant, "client_id": client_id}
+
+
+async def _cleanup(pool: Any, tenant: UUID, client_id: str) -> None:
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute("DELETE FROM memories WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM oauth_clients WHERE id = $1", client_id)
+            await conn.execute("DELETE FROM tenants WHERE id = $1", tenant)
+
+
+async def _insert_memory(
+    pool: Any,
+    tenant: UUID,
+    content: str,
+    mem_type: str = "note",
+    tags: list[str] | None = None,
+    version: int | None = 1,
+) -> UUID:
+    """Insert a memory directly via SQL and return its id."""
+    async with pool.acquire() as conn:
+        mem_id: UUID = await conn.fetchval(
+            """
+            INSERT INTO memories
+                (tenant_id, content, content_hash, embedding,
+                 source_kind, type, tags, metadata, version, is_current)
+            VALUES
+                ($1, $2, $3, array_fill(0::real, ARRAY[1024])::vector,
+                 'api', $4, $5::text[], '{}'::jsonb, $6, true)
+            RETURNING id
+            """,
+            tenant,
+            content,
+            hash_content(content),
+            mem_type,
+            tags or [],
+            version,
+        )
+    assert mem_id is not None
+    return mem_id
+
+
+async def _read_revision(pool: Any, tenant: UUID, mem_id: UUID) -> str:
+    """Read the revision of a memory via SQL (bypasses bump_access)."""
+    async with pool.acquire() as conn:
+        await conn.execute(
+            "SELECT set_config('app.current_tenant_id', $1, true)", str(tenant)
+        )
+        rev: str | None = await conn.fetchval("SELECT revision::text FROM memories WHERE id = $1", mem_id)
+    return rev or ""
+
+
+async def _read_tags(pool: Any, tenant: UUID, mem_id: UUID) -> list[str]:
+    """Read the tags of a memory via SQL."""
+    async with pool.acquire() as conn:
+        await conn.execute(
+            "SELECT set_config('app.current_tenant_id', $1, true)", str(tenant)
+        )
+        tags = await conn.fetchval("SELECT tags FROM memories WHERE id = $1", mem_id)
+    return list(tags) if tags else []
+
+
+async def _assert_chain_integrity(
+    pool: Any, tenant: UUID, original_id: UUID
+) -> None:
+    """Assert exactly one is_current row and one supersedes=original in the chain."""
+    async with pool.acquire() as conn:
+        await conn.execute(
+            "SELECT set_config('app.current_tenant_id', $1, true)", str(tenant)
+        )
+        current_rows = await conn.fetch(
+            """
+            WITH RECURSIVE chain AS (
+                SELECT id, is_current, supersedes, superseded_by
+                FROM memories WHERE id = $1
+                UNION ALL
+                SELECT m.id, m.is_current, m.supersedes, m.superseded_by
+                FROM memories m JOIN chain c ON m.id = c.superseded_by
+                WHERE m.tenant_id = $2 AND c.superseded_by IS NOT NULL
+            )
+            SELECT * FROM chain
+            """,
+            original_id,
+            tenant,
+        )
+        is_current_count = sum(1 for r in current_rows if r["is_current"])
+        supersedes_count = sum(1 for r in current_rows if r["supersedes"] == original_id)
+        assert is_current_count == 1, (
+            f"expected exactly 1 is_current row in chain, got {is_current_count}"
+        )
+        assert supersedes_count == 1, (
+            f"expected exactly 1 row with supersedes={original_id}, got {supersedes_count}"
+        )
+
