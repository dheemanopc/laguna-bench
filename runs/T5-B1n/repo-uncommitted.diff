+async def test_concurrent_versioned_update_1_winner_rest_conflicts(wide_pool: Any) -> None:
+    """N concurrent decision content-updates → 1 winner, N-1 conflicts with winner id.
+
+    Also asserts via SQL that the version chain has exactly one is_current row
+    and exactly one row with supersedes = original_id (no duplicate current rows).
+    """
+    async with wide_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, client_id = s["tenant"], s["client_id"]
+    ctx = _ctx(wide_pool, tenant, client_id)
+    try:
+        # Decision: type promotion to versioned path on content change.
+        mem_id = await _insert_memory(wide_pool, tenant, "original decision", "decision")
+
+        async def try_update(i: int) -> dict[str, Any]:
+            try:
+                out = await MemoryUpdateTool()(
+                    ctx, MemoryUpdateInput(id=mem_id, content=f"decision v{i}")
+                )
+                assert isinstance(out, MemoryUpdateOutput)
+                return {"status": "won", "id": str(out.id), "revision": out.revision}
+            except JsonRpcError as e:
+                assert e.data is not None
+                return {
+                    "status": "conflict",
+                    "current_id": e.data.get("current_id"),
+                    "current_revision": e.data.get("current_revision"),
+                }
+
+        results = await asyncio.gather(*[try_update(i) for i in range(N)])
+
+        winners = [r for r in results if r["status"] == "won"]
+        conflicts = [r for r in results if r["status"] == "conflict"]
+
+        assert len(winners) == 1, f"expected 1 winner, got {len(winners)}: {winners}"
+        assert len(conflicts) == N - 1, (
+            f"expected {N-1} conflicts, got {len(conflicts)}: {conflicts}"
+        )
+
+        winner_id = winners[0]["id"]
+        for c in conflicts:
+            assert c["status"] == "conflict"
+            assert c["current_id"] == winner_id, (
+                f"conflict current_id {c['current_id']} != winner {winner_id}"
+            )
+
+        # SQL chain-integrity assertion: exactly one is_current, exactly one
+        # supersedes=original_id — no duplicate current rows.
