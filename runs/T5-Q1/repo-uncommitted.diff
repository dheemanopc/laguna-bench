+"""Tests for MemoryRecord revision coercion and synthesis."""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from uuid import uuid4
+
+from mem_mcp.mcp.tools.get import MemoryRecord
+
+
+class TestMemoryRecordRevision:
+    """Tests for MemoryRecord.revision field and validator."""
+
+    def _sample_data(self, extra: dict | None = None) -> dict:
+        """Build a minimal dict resembling a DB row from memories."""
+        d: dict = {
+            "id": uuid4(),
+            "content": "test",
+            "type": "note",
+            "tags": [],
+            "metadata": {},
+            "version": 1,
+            "is_current": True,
+            "supersedes": None,
+            "superseded_by": None,
+            "created_at": datetime.now(UTC),
+            "updated_at": datetime.now(UTC),
+            "deleted_at": None,
+            "expires_at": None,
+            "indexable": True,
+            "embedding_status": "ready",
+        }
+        if extra:
+            d.update(extra)
+        return d
+
+    def test_uuid_revision_coerced_to_str(self) -> None:
+        """A real UUID in revision → str in model_dump()."""
+        rec = MemoryRecord(**self._sample_data({"revision": uuid4()}))
+        assert isinstance(rec.revision, str)
+        # Should be the string of the UUID.
+        assert rec.model_dump()["revision"] == str(rec.revision)
+
+    def test_str_revision_passed_through(self) -> None:
+        """A string revision → unchanged."""
+        rev = "abc-123"
+        rec = MemoryRecord(**self._sample_data({"revision": rev}))
+        assert rec.revision == rev
+
+    def test_none_revision_synthesised(self) -> None:
+        """Missing revision key → deterministic synthetic string."""
+        data = self._sample_data()
+        # Explicitly remove revision.
+        data.pop("revision", None)
+        rec = MemoryRecord(**data)
+        assert isinstance(rec.revision, str)
+        assert len(rec.revision) > 0
+        assert str(data["id"]) in rec.revision
+
+    def test_empty_string_revision_synthesised(self) -> None:
+        """Empty-string revision → same synthetic fallback as None."""
+        rec = MemoryRecord(**self._sample_data({"revision": ""}))
+        assert isinstance(rec.revision, str)
+        assert len(rec.revision) > 0
+
+    def test_revision_in_model_dump(self) -> None:
+        """revision must appear in model_dump()."""
+        rec = MemoryRecord(**self._sample_data())
+        assert "revision" in rec.model_dump()
+        assert rec.model_dump()["revision"] == rec.revision
+
+    def test_validator_does_not_mutate_input_dict(self) -> None:
+        """The validator must NOT mutate the caller's dict."""
+        data = self._sample_data()
+        assert "revision" not in data
+        MemoryRecord(**data)
+        assert "revision" not in data
