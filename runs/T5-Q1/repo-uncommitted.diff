+async def resolve_current(
+    conn: asyncpg.Connection,
+    target_id: UUID,
+    tenant_id: UUID,
+) -> dict[str, Any] | None:
+    """Return the current (is_current = true) row for the supersedes chain.
+
+    Starts from *target_id*, follows ``superseded_by`` forward via a
+    recursive CTE until reaching the row that has no successor.
+
+    Returns ``{"id": <UUID>, "revision": <UUID>}`` for the current row.
+    If *target_id* has no supersession chain, returns the target row itself.
+    Returns ``None`` only if the original row cannot be found (shouldn't happen
+    inside a live transaction).
+    """
+    row = await conn.fetchrow(
+        """
+        WITH RECURSIVE chain AS (
+            SELECT id, revision, superseded_by
+            FROM memories
+            WHERE id = $1 AND tenant_id = $2
+            UNION ALL
+            SELECT m.id, m.revision, m.superseded_by
+            FROM memories m JOIN chain c ON m.id = c.superseded_by
+            WHERE m.tenant_id = $2
+        )
+        SELECT id, revision
+        FROM chain
+        WHERE superseded_by IS NULL
+        LIMIT 1
+        """,
+        target_id,
+        tenant_id,
+    )
+    if row is None:
+        return None
+    # Return a plain dict — asyncpg Record is immutable.
+    return dict(row)
