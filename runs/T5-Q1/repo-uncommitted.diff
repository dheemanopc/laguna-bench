+class TestConcurrentExpectedRevision:
+    """Test 6: N=6 concurrent updates with same valid expected_revision → 1 success, 5 refused."""
+
+    async def test(self, big_pool: Any) -> None:
+        async with big_pool.acquire() as conn:
+            async with conn.transaction():
+                s = await _setup(conn)
+        tid, cid = s["tenant"], s["client_id"]
+        mid = await _create_memory(_ctx(big_pool, tid, cid), "revision-test note")
+        try:
+            # Read revision first.
+            get_out = await MemoryGetTool()(
+                _ctx(big_pool, tid, cid),
+                MemoryGetInput(id=mid),
+            )
+            rev = get_out.memory.revision
+            # Now 6 concurrent updates with expected_revision == rev.
+            tasks = []
+            for i in range(6):
+                ctx = ToolContext(
+                    request_id=f"req-{uuid4().hex[:8]}",
+                    tenant_id=tid,
+                    identity_id=tid,
+                    client_id=cid,
+                    scopes=frozenset({"memory.write"}),
+                    db_pool=big_pool,
+                    deps=_build_deps(),
+                )
+                tasks.append(
+                    MemoryUpdateTool()(
+                        ctx,
+                        MemoryUpdateInput(
+                            id=mid,
+                            content=f"content {i}",
+                            expected_revision=rev,
+                        ),
+                    )
+                )
+            results = await asyncio.gather(*tasks, return_exceptions=True)
+            successes = [r for r in results if isinstance(r, MemoryUpdateTool.OutputModel)]
+            refused = [r for r in results if isinstance(r, JsonRpcError)]
+            assert len(successes) == 1, f"expected 1 success, got {len(successes)}"
+            assert len(refused) == 5, f"expected 5 refused, got {len(refused)}"
+            for err in refused:
+                assert err.code == -32000
+                assert err.data.get("code") == "update_conflict"
+                # current_revision == the winner's revision (the row after the winner wrote).
+                assert err.data.get("current_revision") == successes[0].revision
+            # DB row content & revision must equal the winner's content and revision.
+            # Find the task index that produced the winning result.
+            winning_idx = results.index(successes[0])
+            winner_content = f"content {winning_idx}"
+            mem = await _get_memory(big_pool, tid, mid)
+            assert mem["content"] == winner_content
+            assert mem["revision"] == successes[0].revision
+        finally:
+            await _drain_bumps(big_pool)
+            await _cleanup(big_pool, tid, s["team"], cid)
