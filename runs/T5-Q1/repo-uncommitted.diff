+"""Concurrency tests for memory_update (T-7.2 revision).
+
+Real Postgres. Exercises row locking, revision tokens, and supersede guards
+through the memory_update tool.
+
+Each test creates its own tenant / team / oauth client with UUID-suffixed
+names so it doesn't collide with other tests in the shared DB.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import os
+from collections.abc import AsyncIterator
+from typing import Any
+from uuid import UUID, uuid4
+
+import asyncpg  # type: ignore[import-untyped]
+import pytest
+
+from mem_mcp.audit.logger import NoopAuditLogger
+from mem_mcp.embeddings.bedrock import EmbedResult
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.get import MemoryGetInput, MemoryGetTool
+from mem_mcp.mcp.tools.update import MemoryUpdateInput, MemoryUpdateTool
+from mem_mcp.memory import access_tracking
+from mem_mcp.teams.assignments import assign_role
+
+pytestmark = pytest.mark.asyncio
+
+
+# ── Fixtures ─────────────────────────────────────────────────────────────────
+
+
<email>
+async def big_pool() -> AsyncIterator[Any]:
+    """Live Postgres pool with 16 connections for true parallel concurrency tests.
+
+    Mirrors ``pg_pool`` but uses ``max_size=16`` so tests that fire 6-8
+    concurrent updates actually run them in parallel instead of serialising
+    through a 4-connection queue.
+    """
+    dsn = os.environ.get("MEM_MCP_TEST_DSN")
+    if not dsn:
+        pytest.skip("MEM_MCP_TEST_DSN env not set; skipping live-DB test")
+
+    from mem_mcp.db.pool import _init_connection
+
+    pool = await asyncpg.create_pool(
+        dsn=dsn,
+        min_size=1,
+        max_size=16,
+        init=_init_connection,
+    )
+    try:
+        yield pool
+    finally:
+        await pool.close()
+
+
+# ── Helpers ──────────────────────────────────────────────────────────────────
+
+
+class _SlowEmbed:
+    """Stub embedder that sleeps — widens the race window for decision-fork tests."""
+
+    delay: float = 0.0
+
+    def __init__(self, delay: float = 0.0) -> None:
+        self.delay = delay
+
+    async def embed(self, text: str) -> EmbedResult:
+        if self.delay > 0:
+            await asyncio.sleep(self.delay)
+        return EmbedResult(vector=[0.0] * 1024, input_tokens=max(1, len(text) // 4))
+
+
+def _build_deps(delay: float = 0.0) -> ToolDeps:
+    return ToolDeps(
+        embeddings=_SlowEmbed(delay=delay),
+        audit=NoopAuditLogger(),
+        quotas=NoopQuotas(),
+    )
+
+
+def _ctx(pool: Any, tenant_id: UUID, client_id: str) -> ToolContext:
+    return ToolContext(
+        request_id=f"req-{uuid4().hex[:8]}",
+        tenant_id=tenant_id,
+        identity_id=tenant_id,
+        client_id=client_id,
+        scopes=frozenset({"memory.read", "memory.write"}),
+        db_pool=pool,
+        deps=_build_deps(),
+    )
+
+
+async def _setup(conn: asyncpg.Connection) -> dict[str, Any]:
+    """Create tenant + team + identity + oauth client. Returns dict with ids."""
+    tenant = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"upd-{uuid4()}@example.test",
+    )
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+        f"upd-team-{uuid4().hex[:8]}",
+        tenant,
+    )
+    await assign_role(
+        conn,
+        parent_team_id=team,
+        member_kind="user",
+        member_id=tenant,
+        role_key="member",
+        assigned_by_user_id=tenant,
+    )
+    await conn.execute(
+        """
+        INSERT INTO tenant_identities
+            (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+        VALUES ($1, $2, 'cognito', $3, true, $4)
+        """,
+        tenant,
+        f"sub-{tenant}",
+        f"upd-{tenant}@example.test",
+        team,
+    )
+    client_id = f"client:upd-{uuid4().hex[:8]}"
+    await conn.execute(
+        """
+        INSERT INTO oauth_clients (id, redirect_uris, scope, registration_payload, review_status)
+        VALUES ($1, ARRAY[]::text[], 'memory.read memory.write', '{}'::jsonb, 'auto_allowed')
+        """,
+        client_id,
+    )
+    return {"tenant": tenant, "team": team, "client_id": client_id}
+
+
+async def _cleanup(pool: Any, tenant: UUID, team: UUID, client_id: str) -> None:
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute(
+                "DELETE FROM memory_references WHERE source_memory_id IN "
+                "(SELECT id FROM memories WHERE tenant_id = $1) "
+                "OR target_memory_id IN (SELECT id FROM memories WHERE tenant_id = $1)",
+                tenant,
+            )
+            await conn.execute("DELETE FROM memories WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM team_role_assignments WHERE parent_team_id = $1", team)
+            await conn.execute("DELETE FROM tenant_identities WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM teams WHERE id = $1", team)
+            await conn.execute("DELETE FROM tenants WHERE id = $1", tenant)
+            await conn.execute("DELETE FROM oauth_clients WHERE id = $1", client_id)
