+"""Add `revision` column to `memories` — optimistic-concurrency token.
+
+Concurrent ``memory_update`` calls lose data today: two concurrent tag-merges
+operate against a stale ``SELECT``, one edit is silently dropped; two concurrent
+content updates of a ``decision`` both create version-2 rows that supersede the
+same parent; sequential callers can overwrite a row that was already superseded.
+
+The fix uses ``FOR UPDATE`` row locking (already implicit in the serialised tx)
+combined with a *revision UUID* so that callers can pass back an
+``expected_revision`` and the DB rejects stale tokens — and even callers that
+don't pass a token are protected because the row-lock forces serialised execution
+while the supersede and revision checks prevent blind overwrites.
+
+``revision`` is a simple ``gen_random_uuid()`` column, NOT ``xmin`` (a concurrent
+background ``bump_access`` call updates the row, changing ``xmin``) and NOT
+``updated_at`` (not guaranteed unique under burst).
+
+Revision ID: 0046_memory_revision
+Revises: 0045_fix_turn_backfill
+Create Date: 2026-10-16
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0046_memory_revision"
+down_revision = "0045_fix_turn_backfill"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    op.execute(
+        sa.text("""
+        ALTER TABLE memories
+            ADD COLUMN revision UUID NOT NULL DEFAULT gen_random_uuid()
+    """)
+    )
+    # Existing rows get a random UUID via the DEFAULT clause — no backfill
+    # needed.  New inserts (and future upgrades) will also get one by default.
+
+
+def downgrade() -> None:
+    op.execute(sa.text("ALTER TABLE memories DROP COLUMN revision"))
