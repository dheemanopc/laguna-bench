+class TestConcurrentDecisionFork:
+    """Test 3: 6 concurrent content updates on one decision → exactly 1 success, 5 refused."""
+
+    async def test(self, big_pool: Any) -> None:
+        # Use slow embedder to widen race window.
+        async with big_pool.acquire() as conn:
+            async with conn.transaction():
+                s = await _setup(conn)
+        tid, cid = s["tenant"], s["client_id"]
+        mid = await _create_memory(
+            ToolContext(
+                request_id="req-0",
+                tenant_id=tid,
+                identity_id=tid,
+                client_id=cid,
+                scopes=frozenset(),
+                db_pool=big_pool,
+                deps=_build_deps(0.05),
+            ),
+            "initial decision",
+            memory_type="decision",
+        )
+        try:
+            tasks = []
+            for i in range(6):
+                ctx = ToolContext(
+                    request_id=f"req-{uuid4().hex[:8]}",
+                    tenant_id=tid,
+                    identity_id=tid,
+                    client_id=cid,
+                    scopes=frozenset({"memory.write"}),
+                    db_pool=big_pool,
+                    deps=_build_deps(0.05),
+                )
+                tasks.append(
+                    MemoryUpdateTool()(
+                        ctx,
+                        MemoryUpdateInput(id=mid, content=f"content v{i+1}"),
+                    )
+                )
+            results = await asyncio.gather(*tasks, return_exceptions=True)
+            successes = [r for r in results if isinstance(r, MemoryUpdateTool.OutputModel)]
+            refused = [r for r in results if isinstance(r, JsonRpcError)]
+            assert (
+                len(successes) == 1
+            ), f"expected 1 success, got {len(successes)}: {[str(r) for r in successes]}"
+            assert len(refused) == 5, f"expected 5 refused, got {len(refused)}"
+            for err in refused:
+                assert err.code == -32000
+                assert err.data.get("code") == "update_conflict"
+                assert "current_id" in err.data
+                winner = successes[0]
+                assert err.data["current_id"] == str(winner.id)
+            # Winner's revision must match what memory_get returns.
+            get_after = await _get_memory(big_pool, tid, winner.id)
+            assert get_after["revision"] == winner.revision
+            # DB has exactly one is_current row in the chain.
+            async with big_pool.acquire() as conn:
+                async with conn.transaction():
+                    await conn.execute(
+                        "SELECT set_config('app.current_tenant_id', $1, true)", str(tid)
+                    )
+                    chain_count = await conn.fetchval(
+                        """
+                        SELECT COUNT(*) FROM memories
+                        WHERE tenant_id = $1 AND (id = $2 OR supersedes = $2)
+                        """,
+                        tid,
+                        mid,
+                    )
+                    assert chain_count == 2, f"expected 2 rows in chain, got {chain_count}"
+                    current_count = await conn.fetchval(
+                        """
+                        SELECT COUNT(*) FROM memories
+                        WHERE tenant_id = $1 AND (id = $2 OR supersedes = $2)
+                          AND is_current = true
+                        """,
+                        tid,
+                        mid,
+                    )
+                    assert current_count == 1, f"expected 1 current in chain, got {current_count}"
+        finally:
+            await _drain_bumps(big_pool)
+            await _cleanup(big_pool, tid, s["team"], cid)
+
