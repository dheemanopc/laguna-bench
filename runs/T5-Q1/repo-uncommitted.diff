+async def _create_memory(
+    ctx: ToolContext,
+    content: str,
+    memory_type: str = "note",
+) -> UUID:
+    """Insert a memory row directly into the DB (bypass tools to avoid quota/embed)."""
+    async with ctx.db_pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute(
+                "SELECT set_config('app.current_tenant_id', $1, true)", str(ctx.tenant_id)
+            )
+            h = f"hash-{uuid4().hex}"
+            row = await conn.fetchrow(
+                """
+                INSERT INTO memories (
+                    tenant_id, content, content_hash, embedding,
+                    source_kind, type, visibility
+                ) VALUES ($1, $2, $3, array_fill(0::real, ARRAY[1024])::vector, 'api', $4, 'team')
+                RETURNING id, revision
+                """,
+                ctx.tenant_id,
+                content,
+                h,
+                memory_type,
+            )
+            return row["id"]  # type: ignore[return-value]
+
+
+async def _get_memory(
+    pool: Any,
+    tenant_id: UUID,
+    memory_id: UUID,
+) -> dict[str, Any]:
+    """Fetch a memory via memory_get tool and return its dict form."""
+    ctx = ToolContext(
+        request_id=f"req-get-{uuid4().hex[:8]}",
+        tenant_id=tenant_id,
+        identity_id=tenant_id,
+        client_id="get",
+        scopes=frozenset({"memory.read"}),
+        db_pool=pool,
+        deps=_build_deps(),
+    )
+    out = await MemoryGetTool()(ctx, MemoryGetInput(id=memory_id))
+    d = out.memory.model_dump(mode="json")
+    return d
+
+
+async def _drain_bumps(pool: Any) -> None:
+    """Drain background access-bump tasks (fire-and-forget from memory_get)."""
+    # Wait for any in-flight bump tasks to complete.
+    inflight = list(getattr(access_tracking, "_inflight_tasks", set()))
+    if inflight:
+        await asyncio.gather(*inflight, return_exceptions=True)
+    # Tiny sleep to let any newly-created tasks settle.
+    await asyncio.sleep(0.05)
+
