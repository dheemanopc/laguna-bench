+async def _call_tool(
+    pool: asyncpg.Pool,
+    tenant_id: UUID,
+    identity_id: UUID,
+    tool: type[MindmapWorkMarkTool]
+    | type[MindmapWorkSetStatusTool]
+    | type[MindmapWorkSetKindTool]
+    | type[MindmapWorkAssignTool],
+    input_model: MindmapWorkMarkInput
+    | MindmapWorkSetStatusInput
+    | MindmapWorkSetKindInput
+    | MindmapWorkAssignInput,
+) -> dict[str, Any]:
+    """Helper to call a work item tool as a specific user."""
+    ctx = ToolContext(
+        db_pool=pool,
+        tenant_id=tenant_id,
+        identity_id=identity_id,
+        client_id="plugin:verify-test",
+        request_id="verify-request",
+        deps=None,
+        scopes=frozenset(),
+    )
+    tool_instance = tool()
+    result = await tool_instance(ctx, input_model)
+    return result.model_dump()
+
+
+async def _get_work_items(
+    conn: asyncpg.Connection, tenant_id: UUID, node_ids: list[UUID] | None = None
+) -> list[dict[str, Any]]:
+    """Get work items from DB."""
+    query = """
+    SELECT * FROM work_items
+    WHERE tenant_id = $1 """
+    params: list[Any] = [tenant_id]
+    if node_ids:
+        query += "AND memory_id = ANY($2::uuid[])"
+        params.append(node_ids)
+    rows = await conn.fetch(query, *params)
+    return [dict(row) for row in rows]
+
+
+async def _get_work_item_history(
+    conn: asyncpg.Connection, tenant_id: UUID, node_id: UUID
+) -> list[dict[str, Any]]:
+    """Get work item history from DB."""
+    rows = await conn.fetch(
+        """
+        SELECT * FROM work_item_history
+        WHERE tenant_id = $1 AND memory_id = $2
+        ORDER BY id ASC
+        """,
+        tenant_id,
+        node_id,
+    )
+    return [dict(row) for row in rows]
+
+
+async def _get_memory_map_events(
+    conn: asyncpg.Connection, tenant_id: UUID, node_id: UUID
+) -> list[dict[str, Any]]:
+    """Get memory map events from DB."""
+    rows = await conn.fetch(
+        """
+        SELECT * FROM memory_map_events
+        WHERE tenant_id = $1 AND memory_id = $2
+        ORDER BY created_at ASC
+        """,
+        tenant_id,
+        node_id,
+    )
+    return [dict(row) for row in rows]
+
+
+async def _get_memories(
+    conn: asyncpg.Connection, tenant_id: UUID, node_ids: list[UUID]
+) -> list[dict[str, Any]]:
+    """Get memories from DB."""
+    rows = await conn.fetch(
+        """
+        SELECT * FROM memories
+        WHERE tenant_id = $1 AND id = ANY($2::uuid[])
+        ORDER BY id ASC
+        """,
+        tenant_id,
+        node_ids,
+    )
+    return [dict(row) for row in rows]
+
+
+async def _get_memberships(
+    conn: asyncpg.Connection, tenant_id: UUID, node_ids: list[UUID]
+) -> list[dict[str, Any]]:
+    """Get memory map memberships from DB."""
