+async def work_item_fixture_setup(pg_pool: asyncpg.Pool) -> dict[str, UUID]:
+    """Set up test data for work item verification tests.
+
+    Creates:
+    - Tenant T1 with users: owner_u, admin_u, member_u, bot_u, viewer_u, vendor_u, removed_u
+    - Tenant T2 with user: other_tenant_u
+    - Team in T1 with all T1 users as members (various roles)
+    - Team in T2 with other_tenant_u
+    - Map M_live in T1 with root R and nodes A, B, C, D, E
+    - Map M_arch in T1 (closed) with root and node X
+    - Map M2 in T1 with node Z
+
+    Returns dict with all UUIDs and map keys.
+    """
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            # Create tenants
+            tenant_1 = await conn.fetchval(
+                "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                f"verify-t1-{uuid4()}@example.test",
+            )
+            tenant_2 = await conn.fetchval(
+                "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                f"verify-t2-{uuid4()}@example.test",
+            )
+
+            # Create teams
+            team_1 = await conn.fetchval(
+                "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+                f"verify-team-1-{uuid4().hex[:8]}",
+                tenant_1,
+            )
+            team_2 = await conn.fetchval(
+                "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+                f"verify-team-2-{uuid4().hex[:8]}",
+                tenant_2,
+            )
+
+            # Create identities (all in T1 except other_tenant_u)
+            identities: dict[str, UUID] = {}
+            for role, _ in [
+                ("owner", "owner"),
+                ("admin", "admin"),
+                ("member", "member"),
+                ("bot", "bot"),
+                ("viewer", "viewer"),
+                ("vendor", "vendor"),
+                ("removed", "removed"),
+            ]:
+                identity_id = await conn.fetchval(
+                    """
+                    INSERT INTO tenant_identities
+                        (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+                    VALUES ($1, $2, 'cognito', $3, true, $4)
+                    RETURNING tenant_id
+                    """,
+                    tenant_1,
+                    f"sub-{role}-{uuid4()}",
+                    f"verify-{role}@{uuid4().hex[:8]}.test",
+                    team_1,
+                )
+                identities[role] = identity_id
+
+            # Create identity for T2
+            other_tenant_u = await conn.fetchval(
+                """
+                INSERT INTO tenant_identities
+                    (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+                VALUES ($1, $2, 'cognito', $3, true, $4)
+                RETURNING tenant_id
+                """,
+                tenant_2,
+                f"sub-other-{uuid4()}",
+                f"verify-other@{uuid4().hex[:8]}.test",
+                team_2,
+            )
+            identities["other_tenant"] = other_tenant_u
+
+            # Assign roles in T1 team
+            for user_role, identity_id in identities.items():
+                if user_role == "other_tenant":
+                    continue
+                role_key = {
+                    "owner": "owner",
+                    "admin": "admin",
+                    "member": "member",
+                    "bot": "member",  # bot is a member
+                    "viewer": "viewer",
+                    "vendor": "vendor",
+                    "removed": "member",  # will be removed later
+                }[user_role]
+                await assign_role(
+                    conn,
+                    parent_team_id=team_1,
+                    member_kind="user",
+                    member_id=identity_id,
+                    role_key=role_key,
+                    assigned_by_user_id=identities["owner"],
+                )
+
+            # Assign role in T2 team
+            await assign_role(
+                conn,
+                parent_team_id=team_2,
+                member_kind="user",
+                member_id=other_tenant_u,
+                role_key="member",
+                assigned_by_user_id=other_tenant_u,
+            )
+
+            # Create oauth client
+            await conn.execute(
+                """
+                INSERT INTO oauth_clients
+                    (id, redirect_uris, scope, registration_payload, review_status)
+                VALUES ($1, ARRAY[]::text[], 'memory.read memory.write',
