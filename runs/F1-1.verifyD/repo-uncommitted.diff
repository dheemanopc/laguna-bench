+class TestV1AlembicMigration:
+    """V1 [BLOCKER] Alembic single head, migration applies and reverses."""
+
+    def test_v1_alembic_single_head(self) -> None:
+        """Check there is exactly one alembic head."""
+        import subprocess
+
+        result = subprocess.run(
+            ["alembic", "heads"],
+            cwd="/home/anand/laguna-bench/runs/F1-1.verifyD/repo",
+            capture_output=True,
+            text=True,
+        )
+        heads = [line.strip() for line in result.stdout.strip().split("\n") if line.strip()]
+        assert len(heads) == 1, f"Expected 1 head, got {len(heads)}: {heads}"
+        assert heads[0].startswith(
+            "0047_work_item_history_rls_fix"
+        ), f"Head is not 0047: {heads[0]}"
+
+    def test_v1_alembic_migration_file_exists(self) -> None:
+        """Check migration 0046 file exists with proper structure."""
+        migration_path = Path(
+            "/home/anand/laguna-bench/runs/F1-1.verifyD/repo/alembic/versions/0046_2026_10_16_mindmap_work_items.py"
+        )
+        assert migration_path.exists(), "Migration 0046 file not found"
+
+        content = migration_path.read_text()
+        assert 'down_revision = "0045_fix_turn_backfill"' in content
+        assert "def downgrade()" in content
+        assert "work_items" in content
+        assert "work_item_history" in content
+
+    def test_v1_alembic_upgrade_succeeds(self) -> None:
+        """Check alembic upgrade head succeeds."""
+        import subprocess
+
+        result = subprocess.run(
+            ["alembic", "upgrade", "head"],
+            cwd="/home/anand/laguna-bench/runs/F1-1.verifyD/repo",
+            capture_output=True,
+            text=True,
+        )
+        assert result.returncode == 0, f"alembic upgrade failed: {result.stderr}"
+
