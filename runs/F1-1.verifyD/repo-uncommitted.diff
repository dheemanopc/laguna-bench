+                    tenant_1,
+                )
+
+            # Create map M_arch (closed) with root and node X
+            map_arch_root = await conn.fetchval(
+                """
+                INSERT INTO memories
+                    (tenant_id, team_id, content, content_hash, embedding, source_kind, type, visibility)
+                VALUES ($1, $2, $3, $4, array_fill(0::real, ARRAY[1024])::vector, 'api', 'question', 'team')
+                RETURNING id
+                """,
+                tenant_1,
+                team_1,
+                "Root of archived map",
+                f"hash-arch-root-{uuid4().hex}",
+            )
+
+            # Create map entry for M_arch (closed)
+            await conn.fetchval(
+                """
+                INSERT INTO memory_maps (root_memory_id, tenant_id, team_id, state)
+                VALUES ($1, $2, $3, 'closed')
+                RETURNING id
+                """,
+                map_arch_root,
+                tenant_1,
+                team_1,
+            )
+
+            # Create slug for M_arch
+            await conn.execute(
+                """
+                INSERT INTO slugs (memory_id, team_id, resource_type, slug)
+                VALUES ($1, $2, 'map', $3)
+                """,
+                map_arch_root,
+                team_1,
+                "arch-map",
+            )
+
+            # Create node X in M_arch
+            node_x = await conn.fetchval(
+                """
+                INSERT INTO memories
+                    (tenant_id, team_id, content, content_hash, embedding, source_kind, type, visibility)
+                VALUES ($1, $2, $3, $4, array_fill(0::real, ARRAY[1024])::vector, 'api', 'note', 'team')
+                RETURNING id
+                """,
+                tenant_1,
+                team_1,
+                "Node X",
+                f"hash-x-{uuid4().hex}",
+            )
+
+            # Add X to map membership
+            await conn.execute(
+                """
+                INSERT INTO memory_map_membership (memory_id, root_memory_id, tenant_id, turn, branch_status)
+                VALUES ($1, $2, $3, 1, 'trunk')
+                """,
+                node_x,
+                map_arch_root,
+                tenant_1,
+            )
+
+            # Create map M2 with node Z
+            map2_root = await conn.fetchval(
+                """
+                INSERT INTO memories
+                    (tenant_id, team_id, content, content_hash, embedding, source_kind, type, visibility)
+                VALUES ($1, $2, $3, $4, array_fill(0::real, ARRAY[1024])::vector, 'api', 'question', 'team')
+                RETURNING id
+                """,
+                tenant_1,
+                team_1,
+                "Root of map 2",
+                f"hash-map2-root-{uuid4().hex}",
+            )
+
+            # Create map entry for M2
+            await conn.fetchval(
+                """
+                INSERT INTO memory_maps (root_memory_id, tenant_id, team_id, state)
+                VALUES ($1, $2, $3, 'live')
+                RETURNING id
+                """,
+                map2_root,
+                tenant_1,
+                team_1,
