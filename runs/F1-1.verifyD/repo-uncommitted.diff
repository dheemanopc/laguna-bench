+                ON CONFLICT (id) DO NOTHING
+                """,
+                "plugin:verify-test",
+            )
+
+            # Create map M_live with root and nodes A-E
+            map_live_root = await conn.fetchval(
+                """
+                INSERT INTO memories
+                    (tenant_id, team_id, content, content_hash, embedding, source_kind, type, visibility)
+                VALUES ($1, $2, $3, $4, array_fill(0::real, ARRAY[1024])::vector, 'api', 'question', 'team')
+                RETURNING id
+                """,
+                tenant_1,
+                team_1,
+                "Root of live map",
+                f"hash-live-root-{uuid4().hex}",
+            )
+
+            # Create map entry for M_live
+            await conn.fetchval(
+                """
+                INSERT INTO memory_maps (root_memory_id, tenant_id, team_id, state)
+                VALUES ($1, $2, $3, 'live')
