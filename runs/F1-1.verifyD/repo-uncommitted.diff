+                """,
+                map_live_root,
+                tenant_1,
+                team_1,
+            )
+
+            # Create slug for M_live
+            await conn.execute(
+                """
+                INSERT INTO slugs (memory_id, team_id, resource_type, slug)
+                VALUES ($1, $2, 'map', $3)
+                """,
+                map_live_root,
+                team_1,
+                "live-map",
+            )
+
+            # Create nodes A-E in M_live
+            nodes: dict[str, UUID] = {}
+            for node_name in ["A", "B", "C", "D", "E"]:
+                node_id = await conn.fetchval(
+                    """
+                    INSERT INTO memories
+                        (tenant_id, team_id, content, content_hash, embedding, source_kind, type, visibility)
+                    VALUES ($1, $2, $3, $4, array_fill(0::real, ARRAY[1024])::vector, 'api', 'note', 'team')
+                    RETURNING id
+                    """,
+                    tenant_1,
