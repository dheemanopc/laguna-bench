+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { serverApiFetchResult } from "@/lib/server-api";
+import { BoardRefreshProvider } from "./BoardContext";
+import { BoardView, type BoardItem, type BoardStage } from "./BoardView";
+
+export const dynamic = "force-dynamic";
+
+interface WorkListPayload {
+  team_id?: string | null;
+  items: BoardItem[];
+}
+
+interface WorkflowPayload {
+  stages: BoardStage[];
+}
+
+export default async function MindmapBoardPage({
+  params,
+}: {
+  params: Promise<{ key: string }>;
+}) {
+  const { key } = await params;
+  const mapKey = decodeURIComponent(key);
+  const redirectTo = `/mindmaps/${key}/board`;
+
+  const list = await serverApiFetchResult<WorkListPayload>(
+    `/api/web/mindmaps/${encodeURIComponent(mapKey)}/work-items`,
+    { redirectTo },
+  );
+  if (!list.ok || !list.data) {
+    if (list.status === 404) notFound();
+    throw new Error(`Failed to load work items (HTTP ${list.status})`);
+  }
+
+  const teamId = list.data.team_id ?? list.data.items[0]?.team_id ?? null;
+  let stages: BoardStage[] = [];
+  if (teamId) {
+    const wf = await serverApiFetchResult<WorkflowPayload>(
+      `/api/web/teams/${encodeURIComponent(teamId)}/workflow`,
+      { redirectTo },
+    );
+    // No active workflow (400 WorkflowNotFoundError, or 404) is a valid state:
+    // render a legacy board with no transitions.
+    if (wf.ok && wf.data) stages = wf.data.stages;
+    else if (wf.status !== 400 && wf.status !== 404) throw new Error(`Failed to load workflow (HTTP ${wf.status})`);
+  }
+
+  return (
+    <main className="mx-auto max-w-[1400px] px-4 py-6">
+      <nav className="mb-4">
+        <Link
+          href={`/mindmaps/${key}`}
+          className="text-sm text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200"
+        >
+          ← Map
+        </Link>
+      </nav>
+      <BoardRefreshProvider>
+        <BoardView mapKey={mapKey} teamId={teamId} items={list.data.items} stages={stages} />
+      </BoardRefreshProvider>
+    </main>
+  );
+}
diff --git a/web/app/teams/[team_id]/workflow/WorkflowEditor.tsx b/web/app/teams/[team_id]/workflow/WorkflowEditor.tsx
