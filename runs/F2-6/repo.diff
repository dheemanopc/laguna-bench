<email>
+async def env(pg_pool: Any) -> Any:
+    e = Env()
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            e.owner = await _tenant(conn)
+            e.member = await _tenant(conn)
+            e.team = UUID(
+                str(
+                    await conn.fetchval(
+                        "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) "
+                        "RETURNING id",
+                        f"ui-shapes-team-{uuid4().hex[:8]}",
+                        e.owner,
+                    )
+                )
+            )
+            for tid, role in ((e.owner, "owner"), (e.member, "member")):
+                await conn.execute(
+                    "INSERT INTO team_role_assignments (parent_team_id, member_kind, member_id, "
+                    "role_id, status, assigned_by_user_id) SELECT $1, 'user', $2, "
+                    "(SELECT id FROM roles_catalog WHERE role_key = $3 ORDER BY id LIMIT 1), "
+                    "'active', $4",
+                    e.team,
+                    tid,
+                    role,
+                    e.owner,
+                )
+                await conn.execute(
+                    "INSERT INTO tenant_identities (tenant_id, cognito_sub, provider, email, "
+                    "is_primary, default_team_id) VALUES ($1, $2, 'cognito', $3, true, $4)",
+                    tid,
+                    f"sub-ui-shapes-{tid}",
+                    f"ui-shapes-id-{tid}@example.test",
+                    e.team,
+                )
+            e.root = await _memory(conn, e.owner, e.team, "root")
+            await conn.execute(
+                "INSERT INTO memory_maps (root_memory_id, tenant_id, team_id, title, state) "
+                "VALUES ($1, $2, $3, 'M', 'live')",
+                e.root,
+                e.owner,
+                e.team,
+            )
+            e.map_key = f"ui-map-{uuid4().hex[:8]}"
+            await conn.execute(
+                "INSERT INTO slugs (memory_id, team_id, resource_type, slug, title) "
+                "VALUES ($1, $2, 'map', $3, 'M')",
+                e.root,
+                e.team,
+                e.map_key,
+            )
+
+            # Workflow: open -> review (reason required) -> shipped (1 sign-off); dropped is
+            # a terminal stage with no transitions at all (no_transition).
+            e.workflow_id = UUID(
+                str(
+                    await conn.fetchval(
+                        "INSERT INTO team_workflows (tenant_id, team_id, name, is_active, "
+                        "created_by) VALUES ($1, $2, $3, true, $1) RETURNING workflow_id",
+                        e.owner,
+                        e.team,
+                        f"ui-flow-{uuid4().hex[:8]}",
+                    )
+                )
+            )
+            ids: dict[str, UUID] = {}
+            # Insert out of ordinal order on purpose: the API must order by ordinal.
+            for ordinal in (3, 1, 0, 2):
+                name = _STAGES[ordinal]
+                ids[name] = UUID(
+                    str(
+                        await conn.fetchval(
+                            "INSERT INTO workflow_stages (tenant_id, workflow_id, name, ordinal, "
+                            "is_initial, is_terminal) VALUES ($1, $2, $3, $4, $5, $6) "
+                            "RETURNING stage_id",
+                            e.owner,
+                            e.workflow_id,
+                            name,
+                            ordinal,
+                            ordinal == 0,
+                            name in ("shipped", "dropped"),
+                        )
+                    )
+                )
+            await conn.execute(
+                "INSERT INTO workflow_transitions (tenant_id, workflow_id, from_stage_id, "
+                "to_stage_id, requires_reason) VALUES ($1, $2, $3, $4, true)",
+                e.owner,
+                e.workflow_id,
+                ids["open"],
+                ids["review"],
+            )
+            await conn.execute(
+                "INSERT INTO workflow_transitions (tenant_id, workflow_id, from_stage_id, "
+                "to_stage_id, requires_signoff, signoff_min) VALUES ($1, $2, $3, $4, true, 2)",
+                e.owner,
+                e.workflow_id,
+                ids["review"],
+                ids["shipped"],
+            )
+
+            e.reason_node = await _work_item(conn, e, "reason", "open")
+            e.signoff_node = await _work_item(conn, e, "signoff", "review")
+            e.dead_end_node = await _work_item(conn, e, "deadend", "dropped")
+            await conn.execute(
+                "INSERT INTO workflow_signoff_requests (tenant_id, work_item_memory_id, "
+                "from_stage, to_stage, proposer_tenant_id, reason, status) "
+                "VALUES ($1, $2, 'review', 'shipped', $1, 'ship it', 'pending')",
+                e.owner,
+                e.signoff_node,
+            )
+    yield e
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute(
+                "DELETE FROM workflow_signoff_requests WHERE tenant_id = $1", e.owner
+            )
+            await conn.execute("DELETE FROM work_item_history WHERE tenant_id = $1", e.owner)
+            await conn.execute("DELETE FROM work_items WHERE tenant_id = $1", e.owner)
+            await conn.execute("DELETE FROM team_workflows WHERE tenant_id = $1", e.owner)
+            await conn.execute("DELETE FROM memory_map_membership WHERE tenant_id = $1", e.owner)
+            await conn.execute("DELETE FROM slugs WHERE team_id = $1", e.team)
+            await conn.execute("DELETE FROM memory_maps WHERE tenant_id = $1", e.owner)
+            await conn.execute("DELETE FROM memories WHERE tenant_id = $1", e.owner)
