+async def test_concurrent_signs_commit_exactly_once(pg_pool: Pool, env: Env) -> None:
+    await _item_at(pg_pool, env, "review")
+    req = await _propose(pg_pool, env, env.member, "shipped")
+    results = await asyncio.gather(
+        _sign(pg_pool, env, req.request_id, env.admin),
+        _sign(pg_pool, env, req.request_id, env.admin2),
+        _sign(pg_pool, env, req.request_id, env.owner),
+        return_exceptions=True,
+    )
+    committed = [r for r in results if isinstance(r, WorkItem)]
+    pending = [r for r in results if r is None]
+    rejected = [r for r in results if isinstance(r, SignoffCompleteError)]
+    assert len(committed) == 1
+    assert len(committed) + len(pending) + len(rejected) == 3
+    assert await _request_status(pg_pool, env, req.request_id) == "committed"
+    assert (await _row(pg_pool, env))["current_stage"] == "shipped"
+    assert len(await _history(pg_pool, env, "stage")) == 1
