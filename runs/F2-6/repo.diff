+async def _add_member(conn: Any, team: UUID, tenant: UUID, role_key: str, label: str) -> None:
+    await conn.execute(
+        """
+        INSERT INTO team_role_assignments (parent_team_id, member_kind, member_id, role_id, status, assigned_by_user_id)
+        SELECT $1, 'user', $2, (SELECT id FROM roles_catalog WHERE role_key = $3 ORDER BY id LIMIT 1), 'active', $2
+        """,
+        team,
+        tenant,
+        role_key,
+    )
+    await conn.execute(
+        """
+        INSERT INTO tenant_identities
+            (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+        VALUES ($1, $2, 'cognito', $3, true, $4)
+        """,
+        tenant,
+        f"sub-wf-{label}-{tenant}",
+        f"wf-{label}-{tenant}@example.test",
+        team,
+    )
+
+
+async def _setup(conn: Any) -> dict[str, Any]:
+    """Tenants a (owner), b (member), c (member), one team, one oauth client."""
+    tenants = {}
+    for label in ("a", "b", "c", "x"):
+        tenants[label] = await conn.fetchval(
+            "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+            f"wf-{label}-{uuid4()}@example.test",
+        )
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+        f"wf-team-{uuid4().hex[:8]}",
+        tenants["a"],
+    )
+    await _add_member(conn, team, tenants["a"], "owner", "a")
+    await _add_member(conn, team, tenants["b"], "member", "b")
+    await _add_member(conn, team, tenants["c"], "member", "c")
+    client_id = f"client:wf-{uuid4().hex[:8]}"
+    await conn.execute(
+        """
+        INSERT INTO oauth_clients (id, redirect_uris, scope, registration_payload, review_status)
+        VALUES ($1, ARRAY[]::text[], 'memory.read memory.write', '{}'::jsonb, 'auto_allowed')
+        """,
+        client_id,
+    )
+    return {
+        "tenant_a": tenants["a"],
+        "tenant_b": tenants["b"],
+        "tenant_c": tenants["c"],
+        "tenant_x": tenants["x"],  # not a member of the team
+        "team": team,
+        "client_id": client_id,
+    }
+
+
+async def _cleanup(pool: Any, s: dict[str, Any]) -> None:
+    tenants = [s["tenant_a"], s["tenant_b"], s["tenant_c"], s["tenant_x"]]
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            for stmt in (
+                "DELETE FROM workflow_signoffs WHERE tenant_id = ANY($1::uuid[])",
+                "DELETE FROM workflow_signoff_requests WHERE tenant_id = ANY($1::uuid[])",
+                "DELETE FROM work_item_history WHERE tenant_id = ANY($1::uuid[])",
+                "DELETE FROM work_items WHERE tenant_id = ANY($1::uuid[])",
+                "DELETE FROM workflow_transitions WHERE tenant_id = ANY($1::uuid[])",
+                "DELETE FROM workflow_stages WHERE tenant_id = ANY($1::uuid[])",
+                "DELETE FROM team_workflows WHERE tenant_id = ANY($1::uuid[])",
+                "DELETE FROM memory_map_events WHERE tenant_id = ANY($1::uuid[])",
+                "DELETE FROM memory_map_membership WHERE tenant_id = ANY($1::uuid[])",
+                "DELETE FROM memory_maps WHERE tenant_id = ANY($1::uuid[])",
+            ):
+                await conn.execute(stmt, tenants)
+            await conn.execute(
+                "DELETE FROM memory_references WHERE source_memory_id IN "
+                "(SELECT id FROM memories WHERE tenant_id = ANY($1::uuid[])) "
+                "OR target_memory_id IN (SELECT id FROM memories WHERE tenant_id = ANY($1::uuid[]))",
+                tenants,
+            )
+            await conn.execute("DELETE FROM slugs WHERE team_id = $1", s["team"])
+            await conn.execute("DELETE FROM memories WHERE tenant_id = ANY($1::uuid[])", tenants)
+            await conn.execute("DELETE FROM team_role_assignments WHERE parent_team_id = $1", s["team"])
+            await conn.execute("DELETE FROM tenant_identities WHERE tenant_id = ANY($1::uuid[])", tenants)
+            await conn.execute("DELETE FROM teams WHERE id = $1", s["team"])
+            await conn.execute("DELETE FROM tenants WHERE id = ANY($1::uuid[])", tenants)
+            await conn.execute("DELETE FROM oauth_clients WHERE id = $1", s["client_id"])
+
+
+def _ctx(pool: Any, tenant: UUID, client_id: str) -> ToolContext:
+    return ToolContext(
+        request_id=f"req-{uuid4().hex[:8]}",
+        tenant_id=tenant,
+        identity_id=tenant,
+        client_id=client_id,
+        scopes=frozenset({"memory.read", "memory.write"}),
+        db_pool=pool,
+        deps=_build_deps(),
+    )
+
+
+class _World:
+    def __init__(self, pool: Any, s: dict[str, Any]) -> None:
+        self.pool = pool
+        self.s = s
+        self.owner = _ctx(pool, s["tenant_a"], s["client_id"])
+        self.b = _ctx(pool, s["tenant_b"], s["client_id"])
+        self.c = _ctx(pool, s["tenant_c"], s["client_id"])
+        self.x = _ctx(pool, s["tenant_x"], s["client_id"])
+        self.map_key = ""
+
+    async def open_map(self) -> None:
+        opened = await MindmapOpenTool()(
+            self.owner, MindmapOpenInput(title="Delivery plan", root_question="What ships?")
+        )
+        self.map_key = opened.map_key
+
+    async def new_item(self, label: str = "Task") -> UUID:
+        node = await MindmapWriteNodeTool()(
+            self.owner,
+            MindmapWriteNodeInput(map_key=self.map_key, content=f"{label} {uuid4().hex[:6]}", node_role="position"),
+        )
+        await MindmapWorkMarkTool()(
+            self.owner, MindmapWorkMarkInput(map_key=self.map_key, node_id=node.node_id, kind="story")
+        )
+        return UUID(str(node.node_id))
+
+    async def define_and_activate(self, stages: list[WorkflowStageInput], transitions: list[WorkflowTransitionInput]) -> UUID:
+        wf = await MindmapWorkflowCreateTool()(
+            self.owner,
+            MindmapWorkflowCreateInput(name=f"wf-{uuid4().hex[:8]}", stages=stages, transitions=transitions),
+        )
+        assert wf.is_active is False
+        activated = await MindmapWorkflowActivateTool()(
+            self.owner, MindmapWorkflowActivateInput(workflow_id=wf.workflow_id)
+        )
+        assert activated.is_active is True
+        return UUID(str(wf.workflow_id))
+
+    async def propose(self, ctx: ToolContext, node_id: UUID, to_stage: str, reason: str | None = None) -> ProposeMoveOutput:
+        out = await MindmapWorkflowProposeMoveTool()(
+            ctx,
+            MindmapWorkflowProposeMoveInput(
+                map_key=self.map_key, node_id=node_id, to_stage=to_stage, reason=reason
+            ),
+        )
+        assert isinstance(out, ProposeMoveOutput)
+        return out
+
+    async def sign(self, ctx: ToolContext, request_id: UUID | None) -> Any:
+        assert request_id is not None
+        return await MindmapWorkflowSignoffTool()(ctx, MindmapWorkflowSignoffInput(request_id=request_id))
+
+    async def list_items(self, ctx: ToolContext) -> dict[UUID, Any]:
+        out = await MindmapWorkListTool()(ctx, MindmapWorkListInput(map_key=self.map_key))
+        return {UUID(str(i.node_id)): i for i in out.items}
+
+    async def moves(self, ctx: ToolContext, node_id: UUID) -> dict[str, Any]:
+        item = (await self.list_items(ctx))[node_id]
+        return {m.to_stage: m for m in item.allowed_moves}
+
+    async def pending(self, ctx: ToolContext) -> list[Any]:
+        out = await MindmapWorkflowPendingSignoffsTool()(ctx, MindmapWorkflowPendingSignoffsInput())
+        return list(out.requests)
+
+    async def stage(self, node_id: UUID) -> str | None:
+        async with self.pool.acquire() as conn:
+            stage = await conn.fetchval("SELECT current_stage FROM work_items WHERE memory_id = $1", node_id)
+        return None if stage is None else str(stage)
+
+    async def history(self, node_id: UUID) -> list[tuple[str, str | None, str | None]]:
+        async with self.pool.acquire() as conn:
+            rows = await conn.fetch(
+                "SELECT change_type, stage_before, stage_after FROM work_item_history "
+                "WHERE memory_id = $1 ORDER BY id",
+                node_id,
+            )
+        return [(r["change_type"], r["stage_before"], r["stage_after"]) for r in rows]
+
+    async def request_rows(self, node_id: UUID) -> list[Any]:
+        async with self.pool.acquire() as conn:
+            return list(
+                await conn.fetch(
+                    "SELECT request_id, status FROM workflow_signoff_requests "
+                    "WHERE work_item_memory_id = $1 ORDER BY created_at",
+                    node_id,
+                )
+            )
+
+
+@asynccontextmanager
+async def _world(pool: Any) -> AsyncIterator[_World]:
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    w = _World(pool, s)
+    try:
+        await w.open_map()
+        yield w
+    finally:
+        await _cleanup(pool, s)
+
+
+def _data(e: JsonRpcError) -> dict[str, Any]:
+    assert e.data is not None
+    return e.data
+
+
+def _stages() -> list[WorkflowStageInput]:
+    return [
+        WorkflowStageInput(name="todo", is_initial=True),
+        WorkflowStageInput(name="in_progress"),
+        WorkflowStageInput(name="done", is_terminal=True),
+    ]
+
+
+def _transitions(*, roles: list[str] | None = None) -> list[WorkflowTransitionInput]:
+    return [
+        WorkflowTransitionInput(from_stage="todo", to_stage="in_progress", requires_reason=True),
+        WorkflowTransitionInput(
+            from_stage="in_progress", to_stage="done", requires_signoff=True, signoff_min=2
+        ),
+        WorkflowTransitionInput(
+            from_stage="in_progress",
+            to_stage="todo",
+            requires_signoff=True,
+            signoff_min=1,
+            signoff_roles=roles or ["admin"],
+        ),
+    ]
+
+
+async def _to_in_progress(w: _World, node_id: UUID) -> None:
+    out = await w.propose(w.owner, node_id, "in_progress", reason="starting")
+    assert out.awaiting_signoff is False
+    assert out.current_stage == "in_progress"
