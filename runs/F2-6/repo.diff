+"""Shape contract for the WP3 web endpoints the WP4 UI reads.
+
+Seeds with raw asyncpg against the 0048 schema (no MCP tools) so the test depends on the
+HTTP layer only, then pins the response field names the board / settings / pending-signoffs
+components consume.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+from unittest.mock import AsyncMock, MagicMock, patch
+from uuid import UUID, uuid4
+
+import httpx
+import pytest
+from fastapi import FastAPI
+
+from mem_mcp.web.handlers.mindmaps import make_mindmaps_router
+from mem_mcp.web.handlers.workflows import make_workflows_router
+
+pytestmark = pytest.mark.asyncio
+
+_SESSION_MOD = "mem_mcp.web.handlers.mindmaps"
+_STAGES = ["open", "review", "shipped", "dropped"]
+
+
+class Env:
+    owner: UUID
+    member: UUID
+    team: UUID
+    root: UUID
+    map_key: str
+    workflow_id: UUID
+    reason_node: UUID
+    signoff_node: UUID
+    dead_end_node: UUID
+
+
+async def _tenant(conn: Any) -> UUID:
+    return UUID(
+        str(
+            await conn.fetchval(
+                "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                f"ui-shapes-{uuid4()}@example.test",
+            )
+        )
+    )
+
+
+async def _memory(conn: Any, tenant: UUID, team: UUID, label: str) -> UUID:
+    return UUID(
+        str(
+            await conn.fetchval(
+                """
+                INSERT INTO memories (tenant_id, team_id, content, content_hash,
+                                      embedding, source_kind, type, visibility)
+                VALUES ($1, $2, $3, $4, array_fill(0::real, ARRAY[1024])::vector,
+                        'api', 'note', 'team') RETURNING id
+                """,
+                tenant,
+                team,
+                f"{label} {uuid4().hex[:6]}",
+                f"hash-{label}-{uuid4().hex}",
+            )
+        )
+    )
+
+
+async def _work_item(conn: Any, e: Env, label: str, stage: str) -> UUID:
+    node = await _memory(conn, e.owner, e.team, label)
+    await conn.execute(
+        "INSERT INTO memory_map_membership "
+        "(memory_id, root_memory_id, tenant_id, node_role, turn, authored_by) "
+        "VALUES ($1, $2, $3, 'position', 'owner', 'owner')",
+        node,
+        e.root,
+        e.owner,
+    )
+    await conn.execute(
+        "INSERT INTO work_items (memory_id, root_memory_id, tenant_id, team_id, kind, status, "
+        "created_by, workflow_id, current_stage) "
+        "VALUES ($1, $2, $3, $4, 'story', 'todo', $3, $5, $6)",
+        node,
+        e.root,
+        e.owner,
+        e.team,
+        e.workflow_id,
+        stage,
+    )
+    return node
+
