+async def _get(pg_pool: Any, viewer: UUID, path: str, expect: int = 200) -> Any:
+    sess = MagicMock()
+    sess.tenant_id = viewer
+    sess.identity_id = viewer
+    app = FastAPI()
+    app.include_router(make_mindmaps_router(pool=pg_pool, deps=MagicMock()))
+    app.include_router(make_workflows_router(pool=pg_pool, deps=MagicMock()))
+    with patch(f"{_SESSION_MOD}.lookup_session", AsyncMock(return_value=sess)):
+        async with httpx.AsyncClient(
+            transport=httpx.ASGITransport(app=app), base_url="http://t"
+        ) as ac:
+            res = await ac.get(path, cookies={"mem_session": "good"})
+    assert res.status_code == expect, res.text
+    return res.json()
+
+
+async def _board(pg_pool: Any, e: Env, viewer: UUID) -> Any:
