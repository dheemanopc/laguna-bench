+    items = _by_node(body)
+    assert {str(env.reason_node), str(env.signoff_node), str(env.dead_end_node)} <= set(items)
+    for item in items.values():
+        for key in (
+            "node_id",
+            "team_id",
+            "current_stage",
+            "allowed_moves",
+            "blocked_reason",
+            "pending_signoff",
+        ):
+            assert key in item, f"board item missing {key}"
+        assert item["team_id"] == str(env.team)
+        assert isinstance(item["allowed_moves"], list)
+
+
+async def test_board_reason_required_shape(pg_pool: Any, env: Env) -> None:
+    item = _by_node(await _board(pg_pool, env, env.owner))[str(env.reason_node)]
