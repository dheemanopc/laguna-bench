+async def _create(e: Env, name: str | None = None, **kw: Any) -> Any:
+    async with tenant_tx(e.pool, e.owner) as conn:
+        return await create_team_workflow(
+            conn,
+            tenant_id=e.owner,
+            team_id=e.team,
+            name=name or f"wf-{uuid4().hex[:8]}",
+            stages=kw.get("stages", STAGES),
+            transitions=kw.get("transitions", TRANSITION_SPECS),
+            created_by=e.owner,
+        )
+
+
+async def _activate(e: Env, wid: UUID) -> Any:
+    async with tenant_tx(e.pool, e.owner) as conn:
+        return await activate_workflow(
+            conn, tenant_id=e.owner, team_id=e.team, workflow_id=wid, actor_tenant_id=e.owner
+        )
+
+
+async def _make_item(e: Env, *, kind: str = "story") -> tuple[str, UUID]:
+    """Open a map, write a node and mark it through the real tool/domain layer."""
+    ctx = ToolContext(
+        request_id=f"req-{uuid4().hex[:8]}",
+        tenant_id=e.owner,
+        identity_id=e.owner,
+        client_id=e.client_id,
+        scopes=frozenset({"memory.read", "memory.write"}),
+        db_pool=e.pool,
+        deps=_build_deps(),
+    )
+    opened: Any = await MindmapOpenTool()(ctx, MindmapOpenInput(title="wf", root_question="What?"))
+    node: Any = await MindmapWriteNodeTool()(
+        ctx,
+        MindmapWriteNodeInput(map_key=opened.map_key, content="Do the thing", node_role="position"),
+    )
+    node_id = UUID(str(node.node_id))
+    async with tenant_tx(e.pool, e.owner) as conn:
+        await mark_work_item(
+            conn,
+            tenant_id=e.owner,
+            team_id=e.team,
+            map_key=opened.map_key,
+            node_id=node_id,
+            kind=kind,
+        )
+    return str(opened.map_key), node_id
+
+
+async def _move(e: Env, map_key: str, node_id: UUID, to_stage: str) -> Any:
+    async with tenant_tx(e.pool, e.owner) as conn:
+        return await move_work_item(
+            conn,
+            tenant_id=e.owner,
+            team_id=e.team,
+            map_key=map_key,
+            node_id=node_id,
+            to_stage=to_stage,
+            reason="because",
+        )
+
+
+async def _item_row(e: Env, node_id: UUID) -> Any:
+    async with e.pool.acquire() as conn:
+        return await conn.fetchrow(
+            "SELECT workflow_id, current_stage, status FROM work_items "
+            "WHERE tenant_id = $1 AND memory_id = $2",
+            e.owner,
+            node_id,
+        )
