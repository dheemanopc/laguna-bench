+async def test_compute_item_moves_blocked_reasons(pg_pool: Pool, env: Env) -> None:
+    await _item_at(pg_pool, env, "review", assignee=env.owner)
+    moves = await _moves(pg_pool, env, env.admin)
+    assert moves["dropped"].blocked_reason == "reason_required"
+    assert moves["open"].blocked_reason == "no_transition"
+    shipped = moves["shipped"]
+    assert shipped.blocked_reason is None
+    assert shipped.signoff_min == 2
+    assert shipped.signatory_count == 0 and shipped.remaining == 0  # no request yet
+
+    await _propose(pg_pool, env, env.member, "shipped")
+    admin = (await _moves(pg_pool, env, env.admin))["shipped"]
+    assert admin.blocked_reason == "awaiting 2 sign-offs"
+    assert (admin.signatory_count, admin.signoff_min, admin.remaining) == (0, 2, 2)
+    req_id = admin.request_id
+    assert req_id is not None
+    await _sign(pg_pool, env, req_id, env.admin)
+    after = await _moves(pg_pool, env, env.admin2)
+    assert after["shipped"].blocked_reason == "awaiting 1 sign-offs"
+    assert (after["shipped"].signatory_count, after["shipped"].remaining) == (1, 1)
+    assert after["shipped"].eligible_to_sign is True
+    assert (await _moves(pg_pool, env, env.admin))["shipped"].eligible_to_sign is False
+    assert admin.eligible_to_sign is True
+    assert admin.request_id is not None
+    # assignee (owner) and proposer (member) are not eligible
+    assert (await _moves(pg_pool, env, env.owner))["shipped"].eligible_to_sign is False
+    assert (await _moves(pg_pool, env, env.member))["shipped"].eligible_to_sign is False
