+        # The signatory is the session identity (ctx), never a body field.
+        ctx = await _ctx_from_session(pool, mem_session, deps, scopes=_WRITE)
+        try:
+            out = await MindmapWorkflowSignoffTool()(
+                ctx,
+                MindmapWorkflowSignoffInput(request_id=body.request_id, team_id=body.team_id),
+            )
+        except JsonRpcError as exc:
+            raise _http_from_jsonrpc(exc) from exc
+        return out.model_dump(mode="json")
+
     return router
