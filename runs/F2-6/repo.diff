+TRANSITION_SPECS = [
+    TransitionSpec(from_stage="backlog", to_stage="review"),
+    TransitionSpec(from_stage="review", to_stage="shipped", requires_reason=True),
+    TransitionSpec(to_stage="backlog", allowed_kinds=("story",)),
