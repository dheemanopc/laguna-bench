+async def test_sign_commits_only_at_min_eligible_signatories(pg_pool: Pool, env: Env) -> None:
+    await _item_at(pg_pool, env, "review", assignee=env.admin)
+    req = await _propose(pg_pool, env, env.member, "shipped")
+
+    # assignee and proposer never count (proposer also fails the role restriction)
+    with pytest.raises(SignoffNotAllowedError):
+        await _sign(pg_pool, env, req.request_id, env.admin)
+    with pytest.raises(SignoffNotAllowedError):
