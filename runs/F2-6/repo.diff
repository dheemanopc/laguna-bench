+        assert all(m.blocked_reason == "no_transition" for m in item.allowed_moves)
+        assert not any(m.blocked_reason is None for m in item.allowed_moves)
+
+        out = await MindmapWorkflowRemapTool()(
+            w.owner, MindmapWorkflowRemapInput(map_key=w.map_key, mappings={"todo": "backlog"})
+        )
+        assert out.updated_count == 2
+        assert await w.stage(node) == "backlog"
+        assert await w.stage(other) == "backlog"
+        # The unmapped item keeps its stage and still appears on the board with no moves.
+        assert await w.stage(unmapped) is None  # untouched: legacy item, current_stage never set
+        after = (await w.list_items(w.owner))[unmapped]
+        assert after.current_stage == "in_progress"
+        assert all(m.blocked_reason == "no_transition" for m in after.allowed_moves)
+        moves = await w.moves(w.owner, node)
+        assert moves["shipped"].blocked_reason is None
+
+        # Unknown target stage is rejected and leaves items untouched.
+        with pytest.raises(JsonRpcError) as exc:
+            await MindmapWorkflowRemapTool()(
+                w.owner, MindmapWorkflowRemapInput(map_key=w.map_key, mappings={"backlog": "ghost"})
+            )
+        assert exc.value.code == -32602
+        assert _data(exc.value)["code"] == "stage_not_found"
+        assert await w.stage(node) == "backlog"
