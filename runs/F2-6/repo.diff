+from mem_mcp.teams.assignments import assign_role
+from tests.conftest import TenantPair
+
+pytestmark = pytest.mark.asyncio
+
+Pool = Any
+
+STAGES = [
+    StageSpec("open", is_initial=True),
+    StageSpec("review"),
+    StageSpec("shipped", is_terminal=True),
+    StageSpec("dropped", is_terminal=True),
+]
+TRANS = [
+    TransitionSpec(from_stage="open", to_stage="review"),
+    TransitionSpec(
+        from_stage="review",
+        to_stage="shipped",
+        requires_signoff=True,
+        signoff_min=2,
+        signoff_roles=("owner", "admin"),
+    ),
+    TransitionSpec(from_stage="review", to_stage="dropped", requires_reason=True),
+]
+
+
+async def _tenant(pg_pool: Pool) -> UUID:
+    async with pg_pool.acquire() as conn:
+        return UUID(
+            str(
+                await conn.fetchval(
+                    "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                    f"wfso-{uuid4()}@example.test",
+                )
+            )
+        )
+
+
+class Env:
+    owner: UUID
+    admin: UUID
+    admin2: UUID
+    member: UUID
+    team: UUID
+    node: UUID
+    root: UUID
+    map_key: str
+    workflow_id: UUID
+
+
<email>
+async def env(pg_pool: Pool, setup_two_tenants: TenantPair) -> Env:
+    e = Env()
+    e.owner = setup_two_tenants.a.tenant_id  # owner = tenant_a
+    e.admin = setup_two_tenants.b.tenant_id  # signatory = tenant_b
+    e.admin2 = await _tenant(pg_pool)
+    e.member = await _tenant(pg_pool)
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            e.team = UUID(
+                str(
+                    await conn.fetchval(
+                        "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) "
+                        "RETURNING id",
+                        f"team-{uuid4().hex[:8]}",
+                        e.owner,
+                    )
+                )
+            )
+            for tid, role in (
+                (e.owner, "owner"),
+                (e.admin, "admin"),
+                (e.admin2, "admin"),
+                (e.member, "member"),
+            ):
+                await assign_role(
+                    conn,
+                    parent_team_id=e.team,
+                    member_kind="user",
+                    member_id=tid,
+                    role_key=role,
+                    assigned_by_user_id=e.owner,
+                )
+            mems = []
+            for label in ("root", "child"):
+                mems.append(
+                    await conn.fetchval(
+                        """
+                        INSERT INTO memories (tenant_id, team_id, content, content_hash,
+                                              embedding, source_kind, type, visibility)
+                        VALUES ($1, $2, $3, $4, array_fill(0::real, ARRAY[1024])::vector,
+                                'api', 'note', 'team') RETURNING id
+                        """,
+                        e.owner,
+                        e.team,
+                        f"{label} node",
+                        f"hash-{label}-{uuid4().hex}",
+                    )
+                )
+            e.root, e.node = mems
+            await conn.execute(
+                "INSERT INTO memory_maps (root_memory_id, tenant_id, team_id, title, state) "
+                "VALUES ($1, $2, $3, 'M', 'live')",
+                e.root,
+                e.owner,
+                e.team,
+            )
+            await conn.execute(
+                "INSERT INTO memory_map_membership "
+                "(memory_id, root_memory_id, tenant_id, node_role, turn, authored_by) "
+                "VALUES ($1, $2, $3, 'position', 'owner', 'owner')",
+                e.node,
+                e.root,
+                e.owner,
+            )
+            e.map_key = f"map-{uuid4().hex[:8]}"
+            await conn.execute(
+                "INSERT INTO slugs (memory_id, team_id, resource_type, slug, title) "
+                "VALUES ($1, $2, 'map', $3, 'M')",
+                e.root,
+                e.team,
+                e.map_key,
