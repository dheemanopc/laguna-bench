index 0000000..4f5beee
--- /dev/null
+++ b/web/app/teams/[team_id]/workflow/WorkflowSettingsClient.tsx
@@ -0,0 +1,422 @@
+"use client";
+
+// Workflow settings shell: active view, create form (via WorkflowEditor),
+// activate button for the new workflow, and the remap form.
+
+import { useEffect, useState } from "react";
+import { usePathname, useRouter, useSearchParams } from "next/navigation";
+import { csrfHeaders } from "@/lib/csrf";
+import { WorkflowEditor, type StageDraft, type TransitionDraft } from "./WorkflowEditor";
+
+export interface WorkflowDetail {
+  workflow_id: string;
+  name: string;
+  is_active: boolean;
+  version: number;
+  stages: { stage_id: string; name: string; ordinal: number; is_initial: boolean; is_terminal: boolean }[];
+  transitions: {
+    transition_id: string;
+    from_stage_id: string | null;
+    to_stage_id: string;
+    requires_reason: boolean;
+    requires_signoff: boolean;
+    signoff_min: number;
+    signoff_roles: string[] | null;
+    allowed_kinds: string[] | null;
+  }[];
+}
+
+const WORK_KINDS = ["story", "epic", "milestone"] as const;
+
+interface Props {
+  teamId: string;
+  workflow: WorkflowDetail | null;
+  roleKeys: string[];
+}
+
+interface ErrorBody {
+  detail?: string | { loc?: (string | number)[]; msg?: string }[] | { message?: string; code?: number; data?: unknown };
+}
+
+async function errorMessages(res: Response): Promise<{ banner: string | null; fields: string[] }> {
+  let body: ErrorBody = {};
+  try {
+    body = (await res.json()) as ErrorBody;
+  } catch {
+    // non-JSON error body: fall through to the generic banner
+  }
+  if (res.status === 422 && Array.isArray(body.detail)) {
+    return {
+      banner: null,
+      fields: body.detail.map((d) => `${(d.loc ?? []).slice(1).join(".")}: ${d.msg ?? "invalid"}`),
+    };
+  }
+  const d = body.detail;
+  const banner =
+    typeof d === "string"
+      ? d
+      : d && !Array.isArray(d) && typeof d.message === "string"
+        ? d.message
+        : `Request failed (${res.status})`;
+  return { banner, fields: [] };
+}
+
+export function WorkflowSettingsClient({ teamId, workflow, roleKeys }: Props) {
+  const router = useRouter();
+  const base = `/api/web/teams/${encodeURIComponent(teamId)}/workflow`;
+
+  const [name, setName] = useState("");
+  const [stages, setStages] = useState<StageDraft[]>([
+    { name: "todo", is_initial: true, is_terminal: false },
+    { name: "done", is_initial: false, is_terminal: true },
+  ]);
+  const [transitions, setTransitions] = useState<TransitionDraft[]>([]);
+  const [banner, setBanner] = useState<string | null>(null);
+  const [fieldErrors, setFieldErrors] = useState<string[]>([]);
+  // The draft workflow id lives in the URL (?wf=<id>) so a reload keeps it reachable;
+  // its stages are always fetched from the server, never taken from the URL.
+  const pathname = usePathname();
+  const search = useSearchParams();
+  const createdId = search.get("wf");
+  const [draftStageNames, setDraftStageNames] = useState<string[] | null>(null);
+  const [stageCounts, setStageCounts] = useState<Record<string, number> | null>(null);
+  const [anyMapKey, setAnyMapKey] = useState<string | null>(null);
+  const [actMappings, setActMappings] = useState<Record<string, string>>({});
+  const [pendingRemap, setPendingRemap] = useState<{ map_key: string; mappings: Record<string, string> } | null>(null);
+  const [toast, setToast] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  const [mapKey, setMapKey] = useState("");
+  const [pairs, setPairs] = useState<{ from: string; to: string }[]>([{ from: "", to: "" }]);
+
+  const stageName = new Map(workflow?.stages.map((s) => [s.stage_id, s.name]) ?? []);
+
+  async function post(url: string, payload?: unknown): Promise<Response | null> {
+    setBanner(null);
+    setFieldErrors([]);
+    setToast(null);
+    setBusy(true);
+    try {
+      const res = await fetch(url, {
+        method: "POST",
+        credentials: "include",
+        headers: csrfHeaders(payload === undefined ? {} : { "Content-Type": "application/json" }),
+        body: payload === undefined ? undefined : JSON.stringify(payload),
+      });
+      if (!res.ok) {
+        const e = await errorMessages(res);
+        setBanner(e.banner);
+        setFieldErrors(e.fields);
+        return null;
+      }
+      return res;
+    } catch {
+      setBanner("Network error; please try again.");
+      return null;
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function onCreate(e: React.FormEvent) {
+    e.preventDefault();
+    const res = await post(base, {
+      name,
+      stages,
+      transitions: transitions.map((t) => ({
+        from_stage: t.from_stage === "any" ? null : t.from_stage,
+        to_stage: t.to_stage,
+        requires_reason: t.requires_reason,
+        requires_signoff: t.requires_signoff,
+        signoff_min: t.signoff_min,
+        signoff_roles: t.signoff_roles.length > 0 ? t.signoff_roles : null,
+        allowed_kinds: t.allowed_kinds.length > 0 ? t.allowed_kinds : null,
+      })),
+    });
+    if (!res) return;
+    const created = (await res.json()) as { workflow_id: string };
+    router.replace(`${pathname}?${new URLSearchParams({ wf: created.workflow_id }).toString()}`);
+    setActMappings({});
+    router.refresh();
+  }
+
+  // Load the draft's real stages from the server.
+  useEffect(() => {
+    setDraftStageNames(null);
+    if (!createdId) return;
+    let cancelled = false;
+    (async () => {
+      try {
+        const res = await fetch(`${base}?workflow_id=${encodeURIComponent(createdId)}`, { credentials: "include" });
+        if (!res.ok) {
+          if (!cancelled) setBanner(`Could not load the draft workflow (HTTP ${res.status}).`);
+          return;
+        }
+        const wf = (await res.json()) as WorkflowDetail;
+        if (!cancelled) setDraftStageNames(wf.stages.map((s) => s.name));
+      } catch {
+        if (!cancelled) setBanner("Network error; please try again.");
+      }
+    })();
+    return () => {
+      cancelled = true;
+    };
+  }, [createdId, base]);
+
+  // Count items per position (current_stage, else legacy status) across every map of the team,
+  // since the workflow and its remap are team-wide.
+  useEffect(() => {
+    setStageCounts(null);
+    if (!createdId) return;
+    let cancelled = false;
+    (async () => {
+      try {
+        const lr = await fetch(`/api/web/mindmaps?team_id=${encodeURIComponent(teamId)}&state=all`, { credentials: "include" });
+        if (!lr.ok) throw new Error(String(lr.status));
+        const maps = ((await lr.json()) as { maps: { map_key: string }[] }).maps;
+        const counts: Record<string, number> = {};
+        let truncated = false;
+        for (const m of maps) {
+          const res = await fetch(
+            `/api/web/mindmaps/${encodeURIComponent(m.map_key)}/work-items?team_id=${encodeURIComponent(teamId)}&limit=500`,
+            { credentials: "include" },
+          );
+          if (!res.ok) throw new Error(String(res.status));
+          const data = (await res.json()) as { items: { current_stage: string | null; status?: string | null }[] };
+          if (data.items.length >= 500) truncated = true;
+          for (const it of data.items) {
+            const pos = it.current_stage ?? it.status ?? null;
+            if (pos) counts[pos] = (counts[pos] ?? 0) + 1;
+          }
+        }
+        if (cancelled) return;
+        if (truncated) {
+          setBanner("A map has 500+ items; cannot verify all stages. Remap manually first.");
+        } else {
+          setAnyMapKey(maps[0]?.map_key ?? null);
+          setStageCounts(counts);
+        }
+      } catch {
+        if (!cancelled) setBanner("Could not load team items to check for removed stages.");
+      }
+    })();
+    return () => {
+      cancelled = true;
+    };
+  }, [createdId, teamId]);
+
+  // Positions that hold items but are not stages of the draft: each needs a target.
+  const populatedRemoved = Object.keys(stageCounts ?? {})
+    .filter((n) => (stageCounts?.[n] ?? 0) > 0 && !(draftStageNames ?? []).includes(n))
+    .sort();
+  const mappingsComplete = populatedRemoved.every((n) => !!actMappings[n]);
+  const canActivate =
+    !!draftStageNames && stageCounts !== null && mappingsComplete && (populatedRemoved.length === 0 || !!anyMapKey);
+
+  async function doRemap(p: { map_key: string; mappings: Record<string, string> }): Promise<boolean> {
+    const rm = await post(`${base}/remap`, p);
+    if (!rm) {
+      setPendingRemap(p);
+      return false;
+    }
+    setPendingRemap(null);
+    return true;
+  }
+
+  // Remap validates targets against the ACTIVE workflow, so it can only run after activation;
+  // on failure the mappings are kept and offered for retry.
+  async function onActivate() {
+    if (!createdId || !canActivate) return;
+    const res = await post(`${base}/${encodeURIComponent(createdId)}/activate`);
+    if (!res) return;
+    const mappings: Record<string, string> = {};
+    for (const n of populatedRemoved) mappings[n] = actMappings[n];
+    if (Object.keys(mappings).length > 0 && anyMapKey) {
+      const ok = await doRemap({ map_key: anyMapKey, mappings });
+      if (!ok) {
+        router.replace(pathname);
+        router.refresh();
+        return;
+      }
+    }
+    router.replace(pathname);
+    setToast("Workflow activated.");
+    router.refresh();
+  }
+
+  async function onRetryRemap() {
+    if (!pendingRemap) return;
+    if (await doRemap(pendingRemap)) setToast("Items remapped.");
+  }
+
+  async function onRemap(e: React.FormEvent) {
+    e.preventDefault();
+    const mappings: Record<string, string> = {};
+    for (const p of pairs) if (p.from.trim() && p.to.trim()) mappings[p.from.trim()] = p.to.trim();
+    const res = await post(`${base}/remap`, { map_key: mapKey, mappings });
+    if (!res) return;
+    const out = (await res.json()) as { updated_count: number };
+    setToast(`Remapped ${out.updated_count} item(s).`);
+    router.refresh();
+  }
+
+  return (
+    <div className="space-y-8">
+      {banner && <p role="alert" className="text-red-600">{banner}</p>}
+      {fieldErrors.length > 0 && (
+        <ul role="alert" className="text-red-600 list-disc pl-5 text-sm">
+          {fieldErrors.map((m) => <li key={m}>{m}</li>)}
+        </ul>
+      )}
+      {toast && <p role="status" className="text-green-700">{toast}</p>}
+
+      <section className="space-y-3">
+        <h2 className="text-xl font-semibold">Active workflow</h2>
+        {!workflow ? (
+          <p className="text-gray-500">No workflow defined for this team.</p>
+        ) : (
+          <>
+            <p>
+              <span className="font-medium">{workflow.name}</span>{" "}
+              <span className="text-sm text-gray-500">v{workflow.version}</span>
+            </p>
+            <ol className="list-decimal pl-5">
+              {[...workflow.stages].sort((a, b) => a.ordinal - b.ordinal).map((s) => (
+                <li key={s.stage_id}>
+                  {s.name}
+                  {s.is_initial && " (initial)"}
+                  {s.is_terminal && " (terminal)"}
+                </li>
+              ))}
+            </ol>
+            <table className="w-full text-sm border-collapse">
+              <thead>
+                <tr className="text-left border-b">
+                  <th>From → To</th><th>Reason</th><th>Signoff</th><th>Min</th><th>Roles</th><th>Kinds</th>
+                </tr>
+              </thead>
+              <tbody>
+                {workflow.transitions.map((t) => (
+                  <tr key={t.transition_id} className="border-b">
+                    <td>
+                      {t.from_stage_id ? stageName.get(t.from_stage_id) ?? "?" : "any"} →{" "}
+                      {stageName.get(t.to_stage_id) ?? "?"}
+                    </td>
+                    <td>{t.requires_reason ? "yes" : "no"}</td>
+                    <td>{t.requires_signoff ? "yes" : "no"}</td>
+                    <td>{t.requires_signoff ? t.signoff_min : "-"}</td>
+                    <td>{t.signoff_roles?.join(", ") ?? "-"}</td>
+                    <td>{t.allowed_kinds?.join(", ") ?? "all"}</td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </>
+        )}
+      </section>
+
+      <section className="space-y-3">
+        <h2 className="text-xl font-semibold">Create workflow</h2>
+        <form onSubmit={onCreate} className="space-y-3">
+          <input
+            className="border rounded px-2 py-1 w-full"
+            placeholder="Workflow name"
+            value={name}
+            onChange={(e) => setName(e.target.value)}
+            required
+            maxLength={128}
+          />
+          <WorkflowEditor
+            stages={stages}
+            transitions={transitions}
+            teamRoles={roleKeys}
+            workKinds={WORK_KINDS}
+            onStagesChange={setStages}
+            onTransitionsChange={setTransitions}
+          />
+          <button type="submit" disabled={busy} className="bg-blue-600 text-white rounded px-3 py-1.5 disabled:opacity-50">
+            Create workflow
+          </button>
+        </form>
+        {createdId && (
+          <div className="border rounded p-3 space-y-2">
+            <p className="text-sm">Created workflow <code className="font-mono">{createdId}</code></p>
+            {stageCounts === null && <p className="text-sm text-gray-500">Checking team items…</p>}
+            {populatedRemoved.length > 0 && (
+              <div className="space-y-2 text-sm">
+                <p>Items sit on stages this workflow does not have. Map each to a stage of the new workflow:</p>
+                {populatedRemoved.map((n) => (
+                  <div key={n} className="flex items-center gap-2">
+                    <span className="w-40">{n} ({stageCounts?.[n] ?? 0} items)</span>
+                    <select
+                      className="border rounded px-2 py-1"
+                      value={actMappings[n] ?? ""}
+                      onChange={(e) => setActMappings({ ...actMappings, [n]: e.target.value })}
+                    >
+                      <option value="">Move to…</option>
+                      {(draftStageNames ?? []).map((t) => (
+                        <option key={t} value={t}>{t}</option>
+                      ))}
+                    </select>
+                  </div>
+                ))}
+              </div>
+            )}
+            <button type="button" onClick={onActivate} disabled={busy || !canActivate} className="bg-green-600 text-white rounded px-3 py-1.5 disabled:opacity-50">
+              Activate
+            </button>
+          </div>
+        )}
+        {pendingRemap && (
+          <div role="alert" className="border border-red-300 rounded p-3 text-sm space-y-2">
+            <p>
+              The workflow is active, but items on removed stages ({Object.keys(pendingRemap.mappings).join(", ")}) were
+              not moved. Retry before anything else.
+            </p>
+            <button type="button" onClick={onRetryRemap} disabled={busy} className="border rounded px-3 py-1">
+              Retry remap
+            </button>
+          </div>
+        )}
+      </section>
+
+      <section className="space-y-3">
+        <h2 className="text-xl font-semibold">Remap items</h2>
+        <form onSubmit={onRemap} className="space-y-2">
+          <input
+            className="border rounded px-2 py-1 w-full"
+            placeholder="Map key"
+            value={mapKey}
+            onChange={(e) => setMapKey(e.target.value)}
+            required
+            maxLength={64}
+          />
+          {pairs.map((p, i) => (
+            <div key={i} className="flex gap-2">
+              <input
+                className="border rounded px-2 py-1 flex-1"
+                placeholder="Old stage / status"
+                value={p.from}
+                onChange={(e) => setPairs(pairs.map((q, j) => (j === i ? { ...q, from: e.target.value } : q)))}
+              />
+              <input
+                className="border rounded px-2 py-1 flex-1"
+                placeholder="New stage"
+                value={p.to}
+                onChange={(e) => setPairs(pairs.map((q, j) => (j === i ? { ...q, to: e.target.value } : q)))}
+              />
+            </div>
+          ))}
+          <div className="flex gap-2">
+            <button type="button" onClick={() => setPairs([...pairs, { from: "", to: "" }])} className="border rounded px-3 py-1">
+              Add mapping
+            </button>
+            <button type="submit" disabled={busy} className="bg-blue-600 text-white rounded px-3 py-1.5 disabled:opacity-50">
+              Remap
+            </button>
+          </div>
+        </form>
+      </section>
+    </div>
+  );
+}
