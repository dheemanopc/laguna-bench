+async def test_role_restricted_signer_rejected(client: TestClient, pg_pool: Any, env: Env) -> None:
+    await _define(client, env)
+    node = await _item(pg_pool, env, "review")
+    body = _move(client, env, node, "archived").json()
+    assert body["awaiting_signoff"] is True
+    assert body["signoff_roles"] == ["admin"]
+    request_id = body["request_id"]
+
+    # The proposer sees the gated move as awaiting a sign-off, not eligible to sign it.
+    owner_move = _move_to(_board(client, env)[str(node)], "archived")
+    assert owner_move["blocked_reason"] == "awaiting 1 sign-offs"
+    assert owner_move["eligible_to_sign"] is False
+
+    # The board is per-tenant (each viewer sees its own items), so a read-only member sees the
+    # restriction on its own item, whose moves it cannot take.
+    v1_node = await _item(pg_pool, env, "todo", workflow=False, tenant=env.members["v1"][0])
+    v1_item = _board(client, env, env.members["v1"][1]).get(str(v1_node))
+    assert v1_item is not None
+    reasons = {m["blocked_reason"] for m in v1_item["allowed_moves"]}
+    assert "role_restricted" in reasons
+    assert reasons <= {"role_restricted", "no_transition"}
+    assert v1_item["blocked_reason"] == "role_restricted"
+
+    resp = _sign(client, env, node, request_id, env.members["m1"][1])
+    assert resp.status_code == 400
+    assert resp.json()["detail"]["code"] == "role_restricted"
+    assert not await _signoff_count(pg_pool, request_id)
+    assert await _stage(pg_pool, env, node) == "review"
+
+    # The admin is offered it; the out-of-role member is not offered the request in pending-signoffs either.
+    resp = client.get(_wf_url(env, "/pending-signoffs"), cookies=_ck(env.members["m1"][1]))
+    assert resp.status_code == 200, resp.text
+    assert request_id not in [r["request_id"] for r in resp.json()["requests"]]
+
+    resp = client.get(_wf_url(env, "/pending-signoffs"), cookies=_ck(env.members["admin"][1]))
+    assert request_id in [r["request_id"] for r in resp.json()["requests"]]
+
+    resp = _sign(client, env, node, request_id, env.members["admin"][1])
+    assert resp.status_code == 200, resp.text
+    assert resp.json()["committed"] is True
+    assert await _stage(pg_pool, env, node) == "archived"
+    assert [r["status"] for r in await _requests(pg_pool, node)] == ["committed"]
+
