+/**
+ * Team workflow settings page — active workflow view, create, activate, remap.
+ * Server component: fetches the active workflow and the member roles.
+ */
+
+import { notFound } from "next/navigation";
+import { serverApiFetchResult } from "@/lib/server-api";
+import { WorkflowSettingsClient, type WorkflowDetail } from "./WorkflowSettingsClient";
+
+interface MembersResponse {
+  members: { role: string }[];
+}
+
+export default async function TeamWorkflowPage({
+  params,
+}: {
+  params: Promise<{ team_id: string }>;
+}) {
+  const { team_id } = await params;
+  const redirectTo = `/teams/${team_id}/workflow`;
+  const base = `/api/web/teams/${encodeURIComponent(team_id)}`;
+
+  const [wf, members] = await Promise.all([
+    serverApiFetchResult<WorkflowDetail>(`${base}/workflow`, { redirectTo }),
+    serverApiFetchResult<MembersResponse>(`${base}/members`, { redirectTo }),
+  ]);
+
+  if (wf.status === 404 || members.status === 404) notFound();
+
+  if (!members.ok) {
+    return (
+      <main className="mx-auto max-w-4xl px-4 py-12">
+        <h1 className="text-3xl font-bold">Team workflow</h1>
+        <p className="text-red-600 mt-4">Could not load team members. Please try again.</p>
+      </main>
+    );
+  }
+
+  // No active workflow → backend answers 400; anything else non-OK is a real error.
+  if (!wf.ok && wf.status !== 400) {
+    return (
+      <main className="mx-auto max-w-4xl px-4 py-12">
+        <h1 className="text-3xl font-bold">Team workflow</h1>
+        <p className="text-red-600 mt-4">Could not load the team workflow. Please try again.</p>
+      </main>
+    );
+  }
+
+  const roleKeys =Array.from(new Set(members.data?.members.map((m) => m.role) ?? [])).sort();
+
+  return (
+    <main className="mx-auto max-w-4xl px-4 py-12 space-y-8">
+      <h1 className="text-3xl font-bold">Team workflow</h1>
+      <WorkflowSettingsClient teamId={team_id} workflow={wf.data} roleKeys={roleKeys} />
+    </main>
+  );
+}
