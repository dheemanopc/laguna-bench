+    assert (await _row(pg_pool, env))["current_stage"] == "review"
+    assert await _request_status(pg_pool, env, req.request_id) == "pending"
+
+    assert await _sign(pg_pool, env, req.request_id, env.admin2) is None  # 1 of 2
+    assert (await _row(pg_pool, env))["current_stage"] == "review"
+    assert await _request_status(pg_pool, env, req.request_id) == "pending"
+
+    done = await _sign(pg_pool, env, req.request_id, env.owner)  # 2 of 2
+    assert isinstance(done, WorkItem)
+    assert done.current_stage == "shipped"
