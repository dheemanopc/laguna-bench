+async def test_define_propose_sign_commit(pg_pool: Any) -> None:
+    async with _world(pg_pool) as w:
+        await w.define_and_activate(_stages(), _transitions())
+        node = await w.new_item()
+        assert await w.stage(node) == "todo"
+
+        # No-sign-off move commits immediately: stage history row, no request row.
+        await _to_in_progress(w, node)
+        assert await w.stage(node) == "in_progress"
+        assert await w.request_rows(node) == []
+        assert ("stage", "todo", "in_progress") in await w.history(node)
+
+        # Sign-off-gated move: pending request, stage does not advance.
+        out = await w.propose(w.owner, node, "done")
+        assert out.awaiting_signoff is True
+        assert out.request_id is not None
+        assert out.signoff_min == 2
+        assert out.current_stage == "in_progress"
+        assert await w.stage(node) == "in_progress"
+        rows = await w.request_rows(node)
+        assert [r["status"] for r in rows] == ["pending"]
+        moves = await w.moves(w.owner, node)
+        assert moves["done"].blocked_reason == "awaiting 2 sign-offs"
+
+        # Sign-off exclusion: the proposer (and item owner) cannot sign.
+        with pytest.raises(JsonRpcError) as exc:
+            await w.sign(w.owner, out.request_id)
+        assert exc.value.code == -32000
+        assert _data(exc.value)["code"] == "role_restricted"
+        assert await w.pending(w.owner) == []
+
+        # Pending-signoffs read for eligible signatories.
+        pend = await w.pending(w.b)
+        assert [(p.request_id, p.to_stage, p.signoff_min, p.signatory_count, p.remaining) for p in pend] == [
+            (out.request_id, "done", 2, 0, 2)
+        ]
+
+        first = await w.sign(w.b, out.request_id)
+        assert (first.signed_count, first.signoff_min, first.committed) == (1, 2, False)
+        assert await w.stage(node) == "in_progress"
+        assert [r["status"] for r in await w.request_rows(node)] == ["pending"]
+        remaining = await w.pending(w.c)
+        assert [(p.signatory_count, p.remaining) for p in remaining] == [(1, 1)]
+        assert await w.pending(w.b) == []  # already signed
+
+        with pytest.raises(JsonRpcError) as exc:
+            await w.sign(w.b, out.request_id)
+        assert exc.value.code == -32602
+        assert _data(exc.value)["code"] == "signoff_already_signed"
+
+        second = await w.sign(w.c, out.request_id)
+        assert (second.signed_count, second.committed) == (2, True)
+        assert await w.stage(node) == "done"
+        assert [r["status"] for r in await w.request_rows(node)] == ["committed"]
+        hist = await w.history(node)
+        assert [h[0] for h in hist].count("signoff_approved") >= 1
+        assert ("stage", "in_progress", "done") in hist
+
+        # Terminal stage: every move is no_transition; already-complete request is rejected.
+        moves = await w.moves(w.owner, node)
+        assert {m.blocked_reason for m in moves.values()} == {"no_transition"}
+        with pytest.raises(JsonRpcError) as exc:
+            await w.sign(w.c, out.request_id)
+        assert exc.value.code == -32602
+        assert _data(exc.value)["code"] == "signoff_complete"
+
+
