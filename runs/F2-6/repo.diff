+            name="flow",
+            stages=STAGES,
+            transitions=TRANS,
+            created_by=e.owner,
+        )
+        await activate_workflow(
+            conn,
+            tenant_id=e.owner,
+            team_id=e.team,
+            workflow_id=wf.workflow_id,
+            actor_tenant_id=e.owner,
+        )
+        e.workflow_id = wf.workflow_id
+    return e
