+async def resolve_team_tenant(ctx: ToolContext, explicit: UUID | None) -> tuple[UUID, UUID]:
+    """Return (team_id, team_tenant_id) for a team the caller belongs to.
+
+    The team's tenant (its creator) owns workflows, requests and work items. Non-members
+    get the same "team not found" error as a missing team.
+    """
+    async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+        team_id = await resolve_team_id(conn, ctx, explicit)
+        role = await get_team_role(conn, ctx.tenant_id, team_id)
+        team_tenant = (
+            await conn.fetchval(
+                "SELECT created_by_tenant_id FROM teams WHERE id = $1 AND deleted_at IS NULL",
+                team_id,
+            )
+            if role is not None
+            else None
+        )
+    if team_tenant is None:
+        raise JsonRpcError(-32602, "team not found", data={"errors": [{"path": "team_id"}]})
+    return team_id, UUID(str(team_tenant))
+
