+async def test_propose_without_signoff_commits_stage_and_history(pg_pool: Pool, env: Env) -> None:
+    await _item_at(pg_pool, env, "open")
+    item = await _propose(pg_pool, env, env.member, "review")
+    assert isinstance(item, WorkItem)
+    assert item.current_stage == "review"
+    assert (await _row(pg_pool, env))["current_stage"] == "review"
+    hist = await _history(pg_pool, env, "stage")
+    assert len(hist) == 1
+    assert (hist[0]["stage_before"], hist[0]["stage_after"]) == ("open", "review")
+    assert hist[0]["workflow_id"] == env.workflow_id
+
+
+async def test_propose_gated_writes_pending_request_without_advancing(
+    pg_pool: Pool, env: Env
+) -> None:
+    await _item_at(pg_pool, env, "review")
+    req = await _propose(pg_pool, env, env.member, "shipped", reason="ready")
+    assert isinstance(req, WorkflowSignoffRequest)
+    assert req.status == "pending"
+    assert (req.from_stage, req.to_stage, req.signoff_min) == ("review", "shipped", 2)
+    assert (await _row(pg_pool, env))["current_stage"] == "review"
+    assert await _request_status(pg_pool, env, req.request_id) == "pending"
+    assert len(await _history(pg_pool, env, "signoff_requested")) == 1
+    assert await _history(pg_pool, env, "stage") == []
