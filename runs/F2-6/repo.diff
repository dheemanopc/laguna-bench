+"""Web-path e2e for team workflows: client + session cookies through /api/web/*.
+
+Parity with the MCP-path e2e: the web handlers run the same tools, so the same
+inputs must produce the same DB state, output fields and error code+data. Errors
+surface as 400 {detail: {message, code, data}}; a missing cookie is 401.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import secrets
+from collections.abc import AsyncIterator
+from datetime import UTC, datetime, timedelta
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+from fastapi.testclient import TestClient
+
+from mem_mcp.teams.assignments import assign_role
+
+pytestmark = [pytest.mark.asyncio]
+
+_STAGES = [
+    {"name": "open", "is_initial": True},
+    {"name": "review"},
+    {"name": "shipped", "is_terminal": True},
+    {"name": "dropped", "is_terminal": True},
+    {"name": "archived", "is_terminal": True},
+]
+_TRANSITIONS = [
+    {"from_stage": "open", "to_stage": "review", "requires_reason": True},
+    {"from_stage": "review", "to_stage": "open"},
+    {"from_stage": "review", "to_stage": "shipped", "requires_signoff": True, "signoff_min": 2},
+    {"from_stage": "review", "to_stage": "dropped", "requires_signoff": True, "signoff_min": 1},
+    {
+        "from_stage": "review",
+        "to_stage": "archived",
+        "requires_signoff": True,
+        "signoff_min": 1,
+        "signoff_roles": ["admin"],
+    },
+]
+
+
+class Env:
+    owner: UUID
+    owner_raw: str
+    team: UUID
+    root: UUID
+    map_key: str
+    workflow_id: UUID
+    members: dict[str, tuple[UUID, str]]  # name -> (tenant_id, raw session)
+    tenants: list[UUID]
+
+
+async def _tenant(conn: Any, label: str) -> UUID:
+    return UUID(
+        str(
+            await conn.fetchval(
+                "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                f"wfweb-{label}-{uuid4()}@example.test",
+            )
+        )
+    )
+
+
+async def _memory(conn: Any, tenant: UUID, team: UUID, label: str) -> UUID:
+    return UUID(
+        str(
+            await conn.fetchval(
+                """
+                INSERT INTO memories (tenant_id, team_id, content, content_hash,
+                                      embedding, source_kind, type, visibility)
+                VALUES ($1, $2, $3, $4, array_fill(0::real, ARRAY[1024])::vector,
+                        'api', 'note', 'team') RETURNING id
+                """,
+                tenant,
+                team,
+                f"{label} {uuid4().hex[:6]}",
+                f"hash-{label}-{uuid4().hex}",
+            )
+        )
+    )
+
+
<email>
+async def env(pg_pool: Any, user_with_workspace: Any) -> AsyncIterator[Env]:
+    e = Env()
+    e.owner = user_with_workspace["tenant_id"]
+    e.owner_raw = user_with_workspace["session"]
+    e.members = {}
+    e.tenants = []
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            e.team = UUID(
+                str(
+                    await conn.fetchval(
+                        "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) "
+                        "RETURNING id",
+                        f"wfweb-team-{uuid4().hex[:8]}",
+                        e.owner,
+                    )
+                )
+            )
+            await conn.execute(
+                "UPDATE tenant_identities SET default_team_id = $1 WHERE id = $2",
+                e.team,
+                user_with_workspace["identity_id"],
+            )
+            await assign_role(
+                conn,
+                parent_team_id=e.team,
+                member_kind="user",
+                member_id=e.owner,
+                role_key="owner",
+                assigned_by_user_id=e.owner,
+            )
+            for name, role in (("m1", "member"), ("m2", "member"), ("admin", "admin"), ("v1", "viewer")):
+                tid = await _tenant(conn, name)
+                e.tenants.append(tid)
+                iid = uuid4()
+                await assign_role(
+                    conn,
+                    parent_team_id=e.team,
+                    member_kind="user",
+                    member_id=tid,
+                    role_key=role,
+                    assigned_by_user_id=e.owner,
+                )
+                await conn.execute(
+                    "INSERT INTO tenant_identities (id, tenant_id, cognito_sub, provider, email, "
+                    "is_primary, default_team_id) VALUES ($1, $2, $3, 'cognito', $4, true, $5)",
+                    iid,
+                    tid,
+                    f"sub-wfweb-{tid}",
+                    f"wfweb-id-{tid}@example.test",
+                    e.team,
+                )
+                raw = secrets.token_urlsafe(32)
+                await conn.execute(
+                    "INSERT INTO web_sessions (session_hash, tenant_id, identity_id, expires_at) "
+                    "VALUES ($1, $2, $3, $4)",
+                    hashlib.sha256(raw.encode()).hexdigest(),
+                    tid,
+                    iid,
+                    datetime.now(tz=UTC) + timedelta(days=1),
+                )
+                e.members[name] = (tid, raw)
+            e.root = await _memory(conn, e.owner, e.team, "root")
+            await conn.execute(
+                "INSERT INTO memory_maps (root_memory_id, tenant_id, team_id, title, state) "
+                "VALUES ($1, $2, $3, 'M', 'live')",
+                e.root,
+                e.owner,
+                e.team,
+            )
+            e.map_key = f"wfweb-map-{uuid4().hex[:8]}"
+            await conn.execute(
+                "INSERT INTO slugs (memory_id, team_id, resource_type, slug, title) "
+                "VALUES ($1, $2, 'map', $3, 'M')",
+                e.root,
+                e.team,
+                e.map_key,
+            )
+    yield e
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            for stmt in (
+                "DELETE FROM workflow_signoff_requests WHERE tenant_id = $1",
+                "DELETE FROM work_item_history WHERE tenant_id = $1",
+                "DELETE FROM work_items WHERE tenant_id = $1",
+                "DELETE FROM team_workflows WHERE tenant_id = $1",
+                "DELETE FROM memory_map_membership WHERE tenant_id = $1",
+                "DELETE FROM memory_maps WHERE tenant_id = $1",
+            ):
+                await conn.execute(stmt, e.owner)
+            await conn.execute("DELETE FROM slugs WHERE team_id = $1", e.team)
+            await conn.execute("DELETE FROM memories WHERE tenant_id = $1", e.owner)
+            await conn.execute(
+                "DELETE FROM audit_log WHERE actor_identity_id = $1",
+                user_with_workspace["identity_id"],
+            )
+            await conn.execute(
+                "UPDATE tenant_identities SET default_team_id = NULL WHERE id = $1",
+                user_with_workspace["identity_id"],
+            )
+            for tid in e.tenants:
+                await conn.execute("DELETE FROM web_sessions WHERE tenant_id = $1", tid)
+
+
+def _ck(raw: str) -> dict[str, str]:
+    return {"mem_session": raw}
+
+
+def _wf_url(e: Env, tail: str = "") -> str:
+    return f"/api/web/teams/{e.team}/workflow{tail}"
+
+
+def _item_url(e: Env, node: UUID, tail: str = "") -> str:
+    return f"/api/web/mindmaps/{e.map_key}/work-items/{node}{tail}"
+
+
+async def _define(client: TestClient, e: Env) -> None:
+    """Create + activate the workflow through the WP3 endpoints."""
+    resp = client.post(
+        _wf_url(e),
+        json={"name": "flow", "stages": _STAGES, "transitions": _TRANSITIONS},
+        cookies=_ck(e.owner_raw),
+    )
+    assert resp.status_code == 200, resp.text
+    body = resp.json()
+    assert body["team_id"] == str(e.team)
+    assert body["is_active"] is False
+    assert body["version"] == 1
+    e.workflow_id = UUID(body["workflow_id"])
+    resp = client.post(_wf_url(e, f"/{e.workflow_id}/activate"), cookies=_ck(e.owner_raw))
+    assert resp.status_code == 200, resp.text
+
+
+async def _item(
+    pg_pool: Any, e: Env, stage: str, *, workflow: bool = True, tenant: UUID | None = None
+) -> UUID:
+    owner = tenant or e.owner
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            node = await _memory(conn, owner, e.team, f"item-{stage}")
+            await conn.execute(
+                "INSERT INTO memory_map_membership "
+                "(memory_id, root_memory_id, tenant_id, node_role, turn, authored_by) "
+                "VALUES ($1, $2, $3, 'position', 'owner', 'owner')",
+                node,
+                e.root,
+                owner,
+            )
+            await conn.execute(
+                "INSERT INTO work_items (memory_id, root_memory_id, tenant_id, team_id, kind, "
+                "status, created_by, workflow_id, current_stage) "
+                "VALUES ($1, $2, $3, $4, 'story', 'todo', $3, $5, $6)",
+                node,
+                e.root,
+                owner,
+                e.team,
+                e.workflow_id if workflow else None,
+                stage,
+            )
+    return node
+
+
+async def _stage(pg_pool: Any, e: Env, node: UUID) -> str:
+    async with pg_pool.acquire() as conn:
+        return str(
+            await conn.fetchval(
+                "SELECT current_stage FROM work_items WHERE memory_id = $1 AND tenant_id = $2",
+                node,
+                e.owner,
+            )
+        )
+
+
+async def _requests(pg_pool: Any, node: UUID) -> list[Any]:
+    async with pg_pool.acquire() as conn:
+        return list(
+            await conn.fetch(
+                "SELECT request_id, status, from_stage, to_stage FROM workflow_signoff_requests "
+                "WHERE work_item_memory_id = $1",
+                node,
+            )
+        )
+
+
+async def _history(pg_pool: Any, node: UUID) -> list[Any]:
+    async with pg_pool.acquire() as conn:
+        return list(
+            await conn.fetch(
+                "SELECT change_type, stage_before, stage_after, workflow_id FROM "
+                "work_item_history WHERE memory_id = $1 ORDER BY id",
+                node,
+            )
+        )
+
+
+async def _signoff_count(pg_pool: Any, request_id: str) -> int:
+    async with pg_pool.acquire() as conn:
+        return int(
+            await conn.fetchval(
+                "SELECT COUNT(*) FROM workflow_signoffs WHERE request_id = $1", UUID(request_id)
+            )
+        )
+
+
+def _board(client: TestClient, e: Env, raw: str | None = None) -> dict[str, dict[str, Any]]:
+    resp = client.get(f"/api/web/mindmaps/{e.map_key}/work-items", cookies=_ck(raw or e.owner_raw))
+    assert resp.status_code == 200, resp.text
+    body = resp.json()
+    assert body["team_id"] == str(e.team)
+    return {i["node_id"]: i for i in body["items"]}
+
+
+def _move_to(item: dict[str, Any], to_stage: str) -> dict[str, Any]:
+    return next(m for m in item["allowed_moves"] if m["to_stage"] == to_stage)
+
+
+def _move(client: TestClient, e: Env, node: UUID, to: str, reason: str | None = None) -> Any:
+    return client.post(
+        _item_url(e, node, "/move"),
+        json={"to_stage": to, "reason": reason},
+        cookies=_ck(e.owner_raw),
+    )
+
+
+def _sign(client: TestClient, e: Env, node: UUID, request_id: Any, raw: str) -> Any:
+    return client.post(
+        _item_url(e, node, "/signoff"), json={"request_id": str(request_id)}, cookies=_ck(raw)
+    )
+
+
+async def test_requires_session_cookie(client: TestClient, env: Env) -> None:
+    node = uuid4()
+    calls = [
+        client.get(_wf_url(env)),
+        client.post(_wf_url(env), json={"name": "x", "stages": _STAGES}),
+        client.post(_wf_url(env, "/remap"), json={"map_key": env.map_key, "mappings": {}}),
+        client.get(_wf_url(env, "/pending-signoffs")),
+        client.get(f"/api/web/mindmaps/{env.map_key}/work-items"),
+        client.get(_item_url(env, node)),
+        client.get(_item_url(env, node, "/history")),
+        client.post(_item_url(env, node, "/move"), json={"to_stage": "review"}),
+        client.post(_item_url(env, node, "/signoff"), json={"request_id": str(uuid4())}),
+    ]
+    assert [r.status_code for r in calls] == [401] * len(calls)
+
