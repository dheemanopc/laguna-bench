+async def test_no_signoff_move_commits(client: TestClient, pg_pool: Any, env: Env) -> None:
+    await _define(client, env)
+    node = await _item(pg_pool, env, "open")
+    resp = _move(client, env, node, "review", "ready for review")
+    assert resp.status_code == 200, resp.text
+    body = resp.json()
+    assert body["awaiting_signoff"] is False
+    assert body["current_stage"] == "review"
+    assert body["request_id"] is None
+    assert await _stage(pg_pool, env, node) == "review"
+    assert await _requests(pg_pool, node) == []
+    hist = await _history(pg_pool, node)
+    assert [(h["change_type"], h["stage_before"], h["stage_after"]) for h in hist] == [
+        ("stage", "open", "review")
+    ]
+    assert hist[0]["workflow_id"] == env.workflow_id
