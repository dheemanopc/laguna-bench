+async def test_remap_and_unmapped_items(client: TestClient, pg_pool: Any, env: Env) -> None:
+    await _define(client, env)
+    mapped = await _item(pg_pool, env, "wip")
+    unmapped = await _item(pg_pool, env, "zzz")
+    resp = client.post(
