index 0000000..cac6901
--- /dev/null
+++ b/web/app/teams/[team_id]/workflow/WorkflowEditor.tsx
@@ -0,0 +1,302 @@
+/**
+ * Pure presentational stages/transitions editor for team workflows.
+ * No fetch, no writes, no router: the parent owns state and submission.
+ */
+"use client";
+
+export interface StageDraft {
+  name: string;
+  is_initial: boolean;
+  is_terminal: boolean;
+}
+
+export interface TransitionDraft {
+  from_stage: string; // stage name or "any"
+  to_stage: string;
+  requires_reason: boolean;
+  requires_signoff: boolean;
+  signoff_min: number;
+  signoff_roles: string[];
+  allowed_kinds: string[];
+}
+
+interface WorkflowEditorProps {
+  stages: StageDraft[];
+  transitions: TransitionDraft[];
+  teamRoles: string[];
+  workKinds: readonly string[];
+  onStagesChange: (stages: StageDraft[]) => void;
+  onTransitionsChange: (transitions: TransitionDraft[]) => void;
+}
+
+const ANY_STAGE = "any";
+
+function toggle(list: string[], value: string): string[] {
+  return list.includes(value) ? list.filter((v) => v !== value) : [...list, value];
+}
+
+export function WorkflowEditor({
+  stages,
+  transitions,
+  teamRoles,
+  workKinds,
+  onStagesChange,
+  onTransitionsChange,
+}: WorkflowEditorProps) {
+  const stageNames = stages.map((s) => s.name).filter((n) => n.trim() !== "");
+
+  function patchStage(i: number, patch: Partial<StageDraft>) {
+    onStagesChange(stages.map((s, idx) => (idx === i ? { ...s, ...patch } : s)));
+  }
+
+  // Rename keeps transitions pointing at the renamed stage.
+  function renameStage(i: number, name: string) {
+    const old = stages[i].name;
+    patchStage(i, { name });
+    if (old.trim() === "" || old === name) return;
+    const rename = (v: string) => (v === old ? name : v);
+    onTransitionsChange(
+      transitions.map((t) => ({
+        ...t,
+        from_stage: rename(t.from_stage),
+        to_stage: rename(t.to_stage),
+      })),
+    );
+  }
+
+  // Exactly one initial stage: selecting one clears the others.
+  function setInitial(i: number) {
+    onStagesChange(stages.map((s, idx) => ({ ...s, is_initial: idx === i })));
+  }
+
+  // Remove drops transitions that reference the stage; keeps an initial stage.
+  function removeStage(i: number) {
+    const gone = stages[i].name;
+    const rest = stages.filter((_, idx) => idx !== i);
+    if (rest.length > 0 && !rest.some((s) => s.is_initial)) {
+      rest[0] = { ...rest[0], is_initial: true };
+    }
+    onStagesChange(rest);
+    if (gone.trim() !== "") {
+      onTransitionsChange(
+        transitions.filter((t) => t.from_stage !== gone && t.to_stage !== gone),
+      );
+    }
+  }
+
+  function patchTransition(i: number, patch: Partial<TransitionDraft>) {
+    onTransitionsChange(
+      transitions.map((t, idx) => (idx === i ? { ...t, ...patch } : t)),
+    );
+  }
+
+  function addTransition() {
+    onTransitionsChange([
+      ...transitions,
+      {
+        from_stage: ANY_STAGE,
+        to_stage: stageNames[0] ?? "",
+        requires_reason: false,
+        requires_signoff: false,
+        signoff_min: 1,
+        signoff_roles: [],
+        allowed_kinds: [],
+      },
+    ]);
+  }
+
+  return (
+    <div className="space-y-6">
+      <section className="space-y-2">
+        <h3 className="text-sm font-semibold">Stages (in order)</h3>
+        {stages.map((s, i) => (
+          <div key={i} className="flex items-center gap-3">
+            <span className="w-6 text-xs text-gray-500">{i + 1}</span>
+            <input
+              type="text"
+              value={s.name}
+              placeholder="Stage name"
+              aria-label={`Stage ${i + 1} name`}
+              onChange={(e) => renameStage(i, e.target.value)}
+              className="rounded border px-2 py-1 text-sm"
+            />
+            <label className="flex items-center gap-1 text-xs">
+              <input
+                type="radio"
+                name="initial-stage"
+                checked={s.is_initial}
+                onChange={() => setInitial(i)}
+              />
+              initial
+            </label>
+            <label className="flex items-center gap-1 text-xs">
+              <input
+                type="checkbox"
+                checked={s.is_terminal}
+                onChange={(e) => patchStage(i, { is_terminal: e.target.checked })}
+              />
+              terminal
+            </label>
+            <button
+              type="button"
+              onClick={() => removeStage(i)}
+              className="text-xs text-red-600"
+            >
+              Remove
+            </button>
+          </div>
+        ))}
+        {stages.length > 0 && !stages.some((s) => s.is_initial) && (
+          <p role="alert" className="text-xs text-red-600">
+            Select an initial stage.
+          </p>
+        )}
+        <button
+          type="button"
+          onClick={() =>
+            onStagesChange([
+              ...stages,
+              { name: "", is_initial: stages.length === 0, is_terminal: false },
+            ])
+          }
+          className="text-sm underline"
+        >
+          Add stage
+        </button>
+      </section>
+
+      <section className="space-y-3">
+        <h3 className="text-sm font-semibold">Transitions</h3>
+        {transitions.map((t, i) => (
+          <div key={i} className="space-y-2 rounded border p-3">
+            <div className="flex flex-wrap items-center gap-3">
+              <select
+                value={t.from_stage}
+                aria-label={`Transition ${i + 1} from stage`}
+                onChange={(e) => patchTransition(i, { from_stage: e.target.value })}
+                className="rounded border px-2 py-1 text-sm"
+              >
+                <option value={ANY_STAGE}>any</option>
+                {t.from_stage !== ANY_STAGE && !stageNames.includes(t.from_stage) && (
+                  <option value={t.from_stage}>{`${t.from_stage} (missing)`}</option>
+                )}
+                {stageNames.map((n) => (
+                  <option key={n} value={n}>
+                    {n}
+                  </option>
+                ))}
+              </select>
+              <span aria-hidden="true">→</span>
+              <select
+                value={t.to_stage}
+                aria-label={`Transition ${i + 1} to stage`}
+                onChange={(e) => patchTransition(i, { to_stage: e.target.value })}
+                className="rounded border px-2 py-1 text-sm"
+              >
+                {!stageNames.includes(t.to_stage) && (
+                  <option value={t.to_stage}>
+                    {t.to_stage === "" ? "Select…" : `${t.to_stage} (missing)`}
+                  </option>
+                )}
+                {stageNames.map((n) => (
+                  <option key={n} value={n}>
+                    {n}
+                  </option>
+                ))}
+              </select>
+              <label className="flex items-center gap-1 text-xs">
+                <input
+                  type="checkbox"
+                  checked={t.requires_reason}
+                  onChange={(e) =>
+                    patchTransition(i, { requires_reason: e.target.checked })
+                  }
+                />
+                requires reason
+              </label>
+              <label className="flex items-center gap-1 text-xs">
+                <input
+                  type="checkbox"
+                  checked={t.requires_signoff}
+                  onChange={(e) =>
+                    patchTransition(i, {
+                      requires_signoff: e.target.checked,
+                      signoff_min: e.target.checked
+                        ? Math.max(1, t.signoff_min)
+                        : t.signoff_min,
+                    })
+                  }
+                />
+                requires signoff
+              </label>
+              {t.requires_signoff && (
+                <label className="flex items-center gap-1 text-xs">
+                  min
+                  <input
+                    type="number"
+                    min={1}
+                    value={t.signoff_min}
+                    onChange={(e) =>
+                      patchTransition(i, {
+                        signoff_min: Math.max(1, Number(e.target.value) || 1),
+                      })
+                    }
+                    className="w-16 rounded border px-1 py-0.5 text-sm"
+                  />
+                </label>
+              )}
+              <button
+                type="button"
+                onClick={() =>
+                  onTransitionsChange(transitions.filter((_, idx) => idx !== i))
+                }
+                className="text-xs text-red-600"
+              >
+                Remove
+              </button>
+            </div>
+            {t.requires_signoff && (
+              <fieldset className="flex flex-wrap gap-3 text-xs">
+                <legend className="mb-1 font-medium">Signoff roles</legend>
+                {teamRoles.map((r) => (
+                  <label key={r} className="flex items-center gap-1">
+                    <input
+                      type="checkbox"
+                      checked={t.signoff_roles.includes(r)}
+                      onChange={() =>
+                        patchTransition(i, {
+                          signoff_roles: toggle(t.signoff_roles, r),
+                        })
+                      }
+                    />
+                    {r}
+                  </label>
+                ))}
+              </fieldset>
+            )}
+            <fieldset className="flex flex-wrap gap-3 text-xs">
+              <legend className="mb-1 font-medium">Allowed kinds (none = all)</legend>
+              {workKinds.map((k) => (
+                <label key={k} className="flex items-center gap-1">
+                  <input
+                    type="checkbox"
+                    checked={t.allowed_kinds.includes(k)}
+                    onChange={() =>
+                      patchTransition(i, {
+                        allowed_kinds: toggle(t.allowed_kinds, k),
+                      })
+                    }
+                  />
+                  {k}
+                </label>
+              ))}
+            </fieldset>
+          </div>
+        ))}
+        <button type="button" onClick={addTransition} className="text-sm underline">
+          Add transition
+        </button>
+      </section>
+    </div>
+  );
+}
diff --git a/web/app/teams/[team_id]/workflow/WorkflowSettingsClient.tsx b/web/app/teams/[team_id]/workflow/WorkflowSettingsClient.tsx
