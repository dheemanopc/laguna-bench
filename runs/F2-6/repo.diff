@@ -0,0 +1,185 @@
+"use client";
+
+import { useCallback, useEffect, useMemo, useState } from "react";
+import { csrfHeaders } from "@/lib/csrf";
+import { useBoardRefresh } from "./BoardContext";
+import type { BoardItem } from "./BoardView";
+
+export interface WaitingOnYouProps {
+  mapKey: string;
+  teamId: string;
+  items: BoardItem[];
+}
+
+interface PendingRow {
+  request_id: string;
+  node_id: string; // the work item's node id
+  from_stage: string;
+  to_stage: string;
+  reason: string | null;
+  signoff_min: number;
+  signatory_count: number;
+  remaining: number;
+}
+
+function loginRedirect(): void {
+  window.location.href = `/login?next=${encodeURIComponent(window.location.pathname)}`;
+}
+
+async function errorMessage(res: Response): Promise<string> {
+  const body = await res.json().catch(() => ({}));
+  const detail = body?.detail;
+  if (typeof detail === "string") return detail;
+  return detail?.message ?? detail?.code ?? res.statusText;
+}
+
+export function WaitingOnYou({ mapKey, teamId, items }: WaitingOnYouProps) {
+  const { boardRefreshKey, bumpRefresh } = useBoardRefresh();
+  const [open, setOpen] = useState(true);
+  const [rows, setRows] = useState<PendingRow[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [otherCount, setOtherCount] = useState(0);
+  const [busyId, setBusyId] = useState<string | null>(null);
+
+  const itemsByNode = useMemo(() => new Map(items.map((i) => [i.node_id, i])), [items]);
+
+  const load = useCallback(async () => {
+    try {
+      const res = await fetch(
+        `/api/web/teams/${encodeURIComponent(teamId)}/workflow/pending-signoffs`,
+        { credentials: "include" },
+      );
+      if (res.status === 401) {
+        loginRedirect();
+        return;
+      }
+      if (!res.ok) {
+        setError(await errorMessage(res));
+        return;
+      }
+      const data = await res.json();
+      const all: PendingRow[] = data.requests ?? [];
+      // The list covers the whole team; Sign is routed via this map's URL, so
+      // only rows whose node is on this board may be shown.
+      const here = all.filter((r) => itemsByNode.has(r.node_id));
+      setRows(here);
+      setOtherCount(all.length - here.length);
+      setError(null);
+    } catch {
+      setError("Failed to load pending sign-offs");
+    } finally {
+      setLoading(false);
+    }
+  }, [teamId, itemsByNode]);
+
+  useEffect(() => {
+    void load();
+  }, [load, boardRefreshKey]);
+
+  async function sign(row: PendingRow) {
+    setBusyId(row.request_id);
+    setError(null);
+    try {
+      const res = await fetch(
+        `/api/web/mindmaps/${encodeURIComponent(mapKey)}/work-items/${encodeURIComponent(row.node_id)}/signoff`,
+        {
+          method: "POST",
+          credentials: "include",
+          headers: csrfHeaders({ "content-type": "application/json" }),
+          body: JSON.stringify({ request_id: row.request_id }),
+        },
+      );
+      if (res.status === 401) {
+        loginRedirect();
+        return;
+      }
+      if (!res.ok) {
+        // 400 (e.g. signoff_complete): show banner and resync the list.
+        setError(await errorMessage(res));
+        void load();
+        return;
+      }
+      const data = await res.json();
+      if (data.committed === true) {
+        setRows((prev) => prev.filter((r) => r.request_id !== row.request_id));
+        bumpRefresh();
+      } else {
+        const count: number = data.signed_count;
+        const min: number = data.signoff_min;
+        setRows((prev) =>
+          prev.map((r) =>
+            r.request_id === row.request_id
+              ? { ...r, signatory_count: count, signoff_min: min, remaining: Math.max(min - count, 0) }
+              : r,
+          ),
+        );
+      }
+    } catch {
+      setError("Sign-off failed");
+    } finally {
+      setBusyId(null);
+    }
+  }
+
+  return (
+    <section className="mt-6 rounded border border-slate-200 dark:border-slate-700">
+      <button
+        type="button"
+        onClick={() => setOpen((o) => !o)}
+        aria-expanded={open}
+        className="flex w-full items-center justify-between px-3 py-2 text-left text-sm font-medium"
+      >
+        <span>Waiting on you ({rows.length})</span>
+        <span aria-hidden>{open ? "−" : "+"}</span>
+      </button>
+      {open && (
+        <div className="space-y-2 px-3 pb-3">
+          {error && (
+            <div role="alert" className="rounded bg-red-100 px-2 py-1 text-sm text-red-800">
+              {error}
+            </div>
+          )}
+          {loading && <p className="text-sm text-slate-500">Loading…</p>}
+          {!loading && rows.length === 0 && (
+            <p className="text-sm text-slate-500">Nothing is waiting on your sign-off on this map.</p>
+          )}
+          {otherCount > 0 && (
+            <p className="text-sm text-slate-500">
+              {otherCount} more sign-off{otherCount === 1 ? "" : "s"} waiting on other maps.
+            </p>
+          )}
+          {rows.map((row) => {
+            const item = itemsByNode.get(row.node_id);
+            const title = item?.title ?? row.node_id;
+            return (
+              <div
+                key={row.request_id}
+                className="flex items-center justify-between gap-3 rounded border border-slate-200 px-2 py-1.5 text-sm dark:border-slate-700"
+              >
+                <div className="min-w-0">
+                  <div className="truncate font-medium">
+                    {title.length > 80 ? `${title.slice(0, 80)}…` : title}
+                  </div>
+                  <div className="text-xs text-slate-500">
+                    {row.from_stage} → {row.to_stage}
+                    {row.reason ? ` · ${row.reason}` : ""} · {row.signatory_count}/{row.signoff_min}{" "}
+                    signed, {row.remaining} remaining
+                  </div>
+                </div>
+                <button
+                  type="button"
+                  disabled={busyId === row.request_id}
+                  onClick={() => void sign(row)}
+                  className="shrink-0 rounded bg-blue-600 px-2 py-1 text-xs text-white disabled:opacity-50"
+                >
+                  {busyId === row.request_id ? "Signing…" : "Sign"}
+                </button>
+              </div>
+            );
+          })}
+        </div>
+      )}
+    </section>
+  );
+}
