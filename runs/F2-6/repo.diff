+async def test_signoff_flow_propose_sign_commit(client: TestClient, pg_pool: Any, env: Env) -> None:
+    await _define(client, env)
+    node = await _item(pg_pool, env, "review")
+    resp = _move(client, env, node, "shipped")
+    assert resp.status_code == 200, resp.text
+    body = resp.json()
+    assert body["awaiting_signoff"] is True
+    assert body["request_id"]
+    assert body["current_stage"] == "review"
+    assert body["signoff_min"] == 2
+    assert await _stage(pg_pool, env, node) == "review"
+    reqs = await _requests(pg_pool, node)
+    assert [r["status"] for r in reqs] == ["pending"]
+    request_id = body["request_id"]
+
+    item = _board(client, env)[str(node)]
+    assert _move_to(item, "shipped")["blocked_reason"] == "awaiting 2 sign-offs"
+    pending = item["pending_signoff"]
+    assert (pending["signoff_min"], pending["signatory_count"], pending["remaining"]) == (2, 0, 2)
+    assert pending["request_id"] == request_id
+
+    # Proposer/owner signoff never counts: item stays pending.
+    resp = _sign(client, env, node, request_id, env.owner_raw)
+    assert resp.status_code == 400
+    assert resp.json()["detail"]["code"] == "role_restricted"
+    assert not await _signoff_count(pg_pool, request_id)
+    assert await _stage(pg_pool, env, node) == "review"
+
+    resp = _sign(client, env, node, request_id, env.members["m1"][1])
+    assert resp.status_code == 200, resp.text
+    out = resp.json()
+    assert (out["signed_count"], out["signoff_min"], out["committed"]) == (1, 2, False)
+    assert await _stage(pg_pool, env, node) == "review"
+    item = _board(client, env)[str(node)]
+    assert _move_to(item, "shipped")["blocked_reason"] == "awaiting 1 sign-offs"
+    assert (
+        _move_to(item, "shipped")["signatory_count"],
+        _move_to(item, "shipped")["remaining"],
+    ) == (1, 1)
+    assert item["pending_signoff"]["signatory_count"] == 1
+    assert item["pending_signoff"]["remaining"] == 1
+
+    resp = _sign(client, env, node, request_id, env.members["m2"][1])
+    assert resp.status_code == 200, resp.text
+    out = resp.json()
+    assert (out["signed_count"], out["committed"]) == (2, True)
+    assert await _stage(pg_pool, env, node) == "shipped"
+    assert [r["status"] for r in await _requests(pg_pool, node)] == ["committed"]
+    hist = await _history(pg_pool, node)
+    types = [h["change_type"] for h in hist]
+    assert "signoff_requested" in types
+    assert "signoff_approved" in types
+    stage_rows = [h for h in hist if h["change_type"] == "stage"]
+    assert [(h["stage_before"], h["stage_after"]) for h in stage_rows] == [("review", "shipped")]
+    assert stage_rows[0]["workflow_id"] == env.workflow_id
+
+    resp = client.get(_item_url(env, node, "/history"), cookies=_ck(env.owner_raw))
+    assert resp.status_code == 200, resp.text
+    entries = resp.json()["entries"]
+    assert any(x["stage_before"] == "review" and x["stage_after"] == "shipped" for x in entries)
+
