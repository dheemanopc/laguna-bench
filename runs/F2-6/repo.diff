@@ -0,0 +1,27 @@
+"use client";
+
+import { createContext, useCallback, useContext, useMemo, useState } from "react";
+import type { ReactNode } from "react";
+
+interface BoardRefreshValue {
+  boardRefreshKey: number;
+  bumpRefresh: () => void;
+}
+
+const BoardRefreshContext = createContext<BoardRefreshValue | null>(null);
+
+export function BoardRefreshProvider({ children }: { children: ReactNode }) {
+  const [boardRefreshKey, setKey] = useState(0);
+  const bumpRefresh = useCallback(() => setKey((k) => k + 1), []);
+  const value = useMemo(
+    () => ({ boardRefreshKey, bumpRefresh }),
+    [boardRefreshKey, bumpRefresh],
+  );
+  return <BoardRefreshContext.Provider value={value}>{children}</BoardRefreshContext.Provider>;
+}
+
+export function useBoardRefresh(): BoardRefreshValue {
+  const ctx = useContext(BoardRefreshContext);
+  if (!ctx) throw new Error("useBoardRefresh must be used inside <BoardRefreshProvider>");
+  return ctx;
+}
diff --git a/web/app/mindmaps/[key]/board/BoardView.tsx b/web/app/mindmaps/[key]/board/BoardView.tsx
