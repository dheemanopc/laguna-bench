@@ -0,0 +1,192 @@
+"use client";
+
+import { useEffect, useMemo, useRef, useState } from "react";
+import { useRouter } from "next/navigation";
+import { useBoardRefresh } from "./BoardContext";
+import { ItemDetail } from "./ItemDetail";
+import { WaitingOnYou } from "./WaitingOnYou";
+
+export const WORK_STATUSES = ["todo", "in_progress", "blocked", "done", "cancelled"] as const;
+
+export interface BoardStage {
+  stage_id: string;
+  name: string;
+  ordinal: number;
+  is_initial: boolean;
+  is_terminal: boolean;
+}
+
+export interface AllowedMove {
+  to_stage: string;
+  blocked_reason: string | null;
+  request_id: string | null;
+  signatory_count: number;
+  signoff_min: number | null;
+  remaining: number;
+  eligible_to_sign: boolean;
+}
+
+export interface PendingSignoff {
+  request_id: string;
+  to_stage: string;
+  signoff_min: number;
+  signatory_count: number;
+  remaining: number;
+  eligible_to_sign: boolean;
+}
+
+export interface BoardItem {
+  node_id: string;
+  team_id?: string | null;
+  title: string;
+  status: string;
+  kind: string;
+  current_stage: string | null;
+  allowed_moves: AllowedMove[];
+  blocked_reason: string | null;
+  pending_signoff: PendingSignoff | null;
+}
+
+const UNMAPPED = "unmapped";
+
+const STATUS_STYLE: Record<string, string> = {
+  todo: "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300",
+  in_progress: "bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-200",
+  blocked: "bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-200",
+  done: "bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-200",
+  cancelled: "bg-slate-200 text-slate-500 dark:bg-slate-800 dark:text-slate-500",
+};
+
+function blockedLabel(item: BoardItem): string | null {
+  const p = item.pending_signoff;
+  if (p) return `awaiting ${p.signatory_count} of ${p.signoff_min}`;
+  return item.blocked_reason;
+}
+
+function ItemCard({
+  item,
+  onMove,
+}: {
+  item: BoardItem;
+  onMove: (item: BoardItem, toStage: string) => void;
+}) {
+  const blocked = blockedLabel(item);
+  const known = (WORK_STATUSES as readonly string[]).includes(item.status);
+  return (
+    <li className="rounded border border-slate-200 bg-white p-2 text-sm dark:border-slate-700 dark:bg-slate-900">
+      <p className="truncate font-medium" title={item.title}>
+        {item.title}
+      </p>
+      <div className="mt-1 flex flex-wrap items-center gap-1 text-xs">
+        <span
+          className={`rounded px-1.5 py-0.5 ${known ? STATUS_STYLE[item.status] : STATUS_STYLE.todo}`}
+        >
+          {item.status}
+        </span>
+        <span className="text-slate-500 dark:text-slate-400">{item.current_stage ?? UNMAPPED}</span>
+        {blocked && (
+          <span className="rounded bg-amber-100 px-1.5 py-0.5 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200">
+            {blocked}
+          </span>
+        )}
+      </div>
+      {item.allowed_moves.length > 0 && (
+        <select
+          aria-label={`Move ${item.title}`}
+          className="mt-2 w-full rounded border border-slate-300 bg-transparent px-1 py-0.5 text-xs dark:border-slate-600"
+          value=""
+          onChange={(e) => {
+            if (e.target.value) onMove(item, e.target.value);
+          }}
+        >
+          <option value="">Move to…</option>
+          {item.allowed_moves.map((m) => (
+            <option key={m.to_stage} value={m.to_stage}>
+              {m.to_stage}
+              {m.blocked_reason ? ` (${m.blocked_reason})` : ""}
+            </option>
+          ))}
+        </select>
+      )}
+    </li>
+  );
+}
+
+export function BoardView({
+  mapKey,
+  teamId,
+  items,
+  stages,
+}: {
+  mapKey: string;
+  teamId: string | null;
+  items: BoardItem[];
+  stages: BoardStage[];
+}) {
+  const router = useRouter();
+  const { boardRefreshKey } = useBoardRefresh();
+  const [selected, setSelected] = useState<{ nodeId: string; toStage: string } | null>(null);
+
+  // Writes (ItemDetail / WaitingOnYou) bump the key; re-run the server page.
+  const firstRun = useRef(true);
+  useEffect(() => {
+    if (firstRun.current) {
+      firstRun.current = false;
+      return;
+    }
+    router.refresh();
+  }, [boardRefreshKey, router]);
+
+  const columns = useMemo(() => {
+    const ordered = [...stages].sort((a, b) => a.ordinal - b.ordinal).map((s) => s.name);
+    const known = new Set(ordered);
+    const byCol = new Map<string, BoardItem[]>(ordered.map((n) => [n, []]));
+    const unmapped: BoardItem[] = [];
+    for (const it of items) {
+      const col =
+        it.current_stage && known.has(it.current_stage) ? byCol.get(it.current_stage) : undefined;
+      (col ?? unmapped).push(it);
+    }
+    const cols = ordered.map((name) => ({ name, items: byCol.get(name) ?? [] }));
+    if (unmapped.length > 0 || cols.length === 0) cols.push({ name: UNMAPPED, items: unmapped });
+    return cols;
+  }, [items, stages]);
+
+  const selectedItem = selected ? items.find((i) => i.node_id === selected.nodeId) : undefined;
+
+  return (
+    <div>
+      <div className="flex gap-3 overflow-x-auto pb-2">
+        {columns.map((col) => (
+          <section
+            key={col.name}
+            className="w-64 shrink-0 rounded bg-slate-50 p-2 dark:bg-slate-950"
+            aria-label={col.name}
+          >
+            <h2 className="mb-2 text-sm font-semibold">
+              {col.name} <span className="font-normal text-slate-500">({col.items.length})</span>
+            </h2>
+            <ul className="space-y-2">
+              {col.items.map((it) => (
+                <ItemCard
+                  key={it.node_id}
+                  item={it}
+                  onMove={(item, toStage) => setSelected({ nodeId: item.node_id, toStage })}
+                />
+              ))}
+            </ul>
+          </section>
+        ))}
+      </div>
+      {teamId && <WaitingOnYou mapKey={mapKey} teamId={teamId} items={items} />}
+      {selectedItem && selected && (
+        <ItemDetail
+          mapKey={mapKey}
+          item={selectedItem}
+          initialToStage={selected.toStage}
+          onClose={() => setSelected(null)}
+        />
+      )}
+    </div>
+  );
+}
