@@ -0,0 +1,295 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { csrfHeaders } from "@/lib/csrf";
+import { useBoardRefresh } from "./BoardContext";
+import type { BoardItem, PendingSignoff } from "./BoardView";
+
+export interface ItemDetailProps {
+  mapKey: string;
+  item: BoardItem;
+  /** Stage preselected from the card's move dropdown, if any. */
+  initialToStage: string | null;
+  onClose: () => void;
+}
+
+interface HistoryEntry {
+  id: number;
+  change_type: string;
+  stage_before: string | null;
+  stage_after: string | null;
+  workflow_id: string | null;
+  status_before: string | null;
+  status_after: string;
+  reason: string | null;
+  created_at: string;
+}
+
+interface ApiError {
+  code: string;
+  message: string;
+}
+
+async function readError(res: Response): Promise<ApiError> {
+  const body = await res.json().catch(() => null);
+  const d = body?.detail;
+  if (d && typeof d === "object") {
+    return { code: String(d.code ?? res.status), message: String(d.message ?? "Request failed") };
+  }
+  return { code: String(res.status), message: typeof d === "string" ? d : `Failed (${res.status})` };
+}
+
+function describeEntry(e: HistoryEntry): string {
+  const wf = e.workflow_id ? ` (workflow ${e.workflow_id.slice(0, 8)})` : "";
+  const stages = `${e.stage_before ?? "—"} → ${e.stage_after ?? "—"}`;
+  switch (e.change_type) {
+    case "stage":
+      return `${stages}${wf}`;
+    case "signoff_requested":
+      return `requested move ${stages}${wf}`;
+    case "signoff_approved":
+      return `approved move ${stages}${wf}`;
+    case "created":
+      return `created in ${e.stage_after ?? e.status_after}${wf}`;
+    default:
+      return `${e.status_before ?? "—"} → ${e.status_after}`;
+  }
+}
+
+export function ItemDetail({ mapKey, item, initialToStage, onClose }: ItemDetailProps) {
+  const { bumpRefresh } = useBoardRefresh();
+  const base = `/api/web/mindmaps/${encodeURIComponent(mapKey)}/work-items/${encodeURIComponent(item.node_id)}`;
+
+  const [toStage, setToStage] = useState(initialToStage ?? "");
+  const [reason, setReason] = useState("");
+  const [confirming, setConfirming] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<ApiError | null>(null);
+  const [pending, setPending] = useState<PendingSignoff | null>(item.pending_signoff);
+  const [history, setHistory] = useState<HistoryEntry[] | null>(null);
+  const [historyError, setHistoryError] = useState<string | null>(null);
+  const [historyKey, setHistoryKey] = useState(0);
+
+  useEffect(() => {
+    let cancelled = false;
+    (async () => {
+      try {
+        const res = await fetch(`${base}/history${item.team_id ? `?team_id=${item.team_id}` : ""}`, {
+          credentials: "same-origin",
+        });
+        if (!res.ok) {
+          if (!cancelled) setHistoryError((await readError(res)).message);
+          return;
+        }
+        const body = await res.json();
+        if (!cancelled) setHistory(body.entries ?? []);
+      } catch {
+        if (!cancelled) setHistoryError("Network error loading history.");
+      }
+    })();
+    return () => {
+      cancelled = true;
+    };
+  }, [base, item.team_id, historyKey]);
+
+  const move = item.allowed_moves.find((m) => m.to_stage === toStage);
+  const reasonRequired = move?.blocked_reason === "reason_required";
+  const needsSignoff = move?.signoff_min != null;
+  const blocked = pending
+    ? `awaiting ${pending.signatory_count} of ${pending.signoff_min}`
+    : item.blocked_reason;
+
+  async function post(path: string, payload: Record<string, unknown>): Promise<Response | null> {
+    setBusy(true);
+    setError(null);
+    try {
+      const res = await fetch(`${base}/${path}`, {
+        method: "POST",
+        credentials: "same-origin",
+        headers: csrfHeaders({ "Content-Type": "application/json" }),
+        body: JSON.stringify({ ...payload, ...(item.team_id ? { team_id: item.team_id } : {}) }),
+      });
+      if (!res.ok) {
+        const err = await readError(res);
+        setError(err);
+        return null;
+      }
+      return res;
+    } catch {
+      setError({ code: "network", message: "Network error — nothing was written." });
+      return null;
+    } finally {
+      setBusy(false);
+      setConfirming(false);
+    }
+  }
+
+  async function submitMove() {
+    const res = await post("move", {
+      to_stage: toStage,
+      reason: reason.trim() || undefined,
+      expected_stage: item.current_stage ?? undefined,
+    });
+    if (!res) return;
+    const out = await res.json();
+    setHistoryKey((k) => k + 1);
+    if (out.awaiting_signoff) {
+      setPending({
+        request_id: out.request_id,
+        to_stage: out.to_stage,
+        signoff_min: out.signoff_min ?? 1,
+        signatory_count: 0,
+        remaining: out.signoff_min ?? 1,
+        eligible_to_sign: false,
+      });
+      bumpRefresh();
+    } else {
+      bumpRefresh();
+      onClose();
+    }
+  }
+
+  async function sign() {
+    if (!pending) return;
+    const res = await post("signoff", { request_id: pending.request_id });
+    if (!res) return;
+    const out = await res.json();
+    setHistoryKey((k) => k + 1);
+    bumpRefresh();
+    if (out.committed) {
+      setPending(null);
+      onClose();
+    } else {
+      setPending({
+        ...pending,
+        signatory_count: out.signed_count,
+        signoff_min: out.signoff_min,
+        remaining: Math.max(0, out.signoff_min - out.signed_count),
+        eligible_to_sign: false,
+      });
+    }
+  }
+
+  const canSubmit = !!toStage && !busy && (!reasonRequired || reason.trim().length > 0);
+
+  return (
+    <div
+      role="dialog"
+      aria-modal="true"
+      aria-label={`Work item ${item.title}`}
+      className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4"
+    >
+      <div className="max-h-full w-full max-w-lg overflow-y-auto rounded bg-white p-4 text-sm shadow-lg dark:bg-slate-900">
+        <div className="flex items-start justify-between gap-2">
+          <h2 className="text-base font-semibold">{item.title}</h2>
+          <button type="button" onClick={onClose} aria-label="Close" className="px-1">
+            ✕
+          </button>
+        </div>
+        <p className="mt-1 text-xs text-slate-500 dark:text-slate-400">
+          {item.kind} · {item.status} · {item.current_stage ?? "unmapped"}
+        </p>
+        {blocked && (
+          <p className="mt-2 inline-block rounded bg-amber-100 px-1.5 py-0.5 text-xs text-amber-800 dark:bg-amber-900/40 dark:text-amber-200">
+            {blocked}
+          </p>
+        )}
+
+        {error && (
+          <div role="alert" className="mt-3 rounded bg-red-100 p-2 text-xs text-red-800 dark:bg-red-900/40 dark:text-red-200">
+            <strong>{error.code}</strong>: {error.message}
+          </div>
+        )}
+
+        {pending && (
+          <section className="mt-3" aria-label="Sign-off">
+            <h3 className="font-medium">Sign-off for {pending.to_stage}</h3>
+            <p className="text-xs">
+              {pending.signatory_count} of {pending.signoff_min} signed · {pending.remaining} remaining
+            </p>
+            <button
+              type="button"
+              disabled={busy || !pending.eligible_to_sign}
+              onClick={sign}
+              className="mt-1 rounded border border-slate-300 px-2 py-0.5 disabled:opacity-50 dark:border-slate-600"
+            >
+              Sign
+            </button>
+          </section>
+        )}
+
+        {!pending && item.allowed_moves.length > 0 && (
+          <section className="mt-3" aria-label="Move">
+            <h3 className="font-medium">Move</h3>
+            <select
+              aria-label="Move to stage"
+              value={toStage}
+              onChange={(e) => {
+                setToStage(e.target.value);
+                setConfirming(false);
+              }}
+              className="mt-1 w-full rounded border border-slate-300 bg-transparent px-1 py-0.5 dark:border-slate-600"
+            >
+              <option value="">Move to…</option>
+              {item.allowed_moves.map((m) => (
+                <option key={m.to_stage} value={m.to_stage}>
+                  {m.to_stage}
+                  {m.blocked_reason ? ` (${m.blocked_reason})` : ""}
+                </option>
+              ))}
+            </select>
+            <textarea
+              aria-label="Reason"
+              value={reason}
+              required={reasonRequired}
+              placeholder={reasonRequired ? "Reason (required)" : "Reason (optional)"}
+              onChange={(e) => setReason(e.target.value)}
+              className="mt-2 w-full rounded border border-slate-300 bg-transparent p-1 dark:border-slate-600"
+              rows={2}
+            />
+            {confirming ? (
+              <div className="mt-2 rounded border border-amber-300 p-2 text-xs">
+                Moving to {toStage} requires sign-off ({move?.signoff_min} needed). Create the request?
+                <div className="mt-1 flex gap-2">
+                  <button type="button" disabled={!canSubmit} onClick={submitMove} className="rounded border px-2 py-0.5">
+                    Confirm
+                  </button>
+                  <button type="button" onClick={() => setConfirming(false)} className="rounded border px-2 py-0.5">
+                    Cancel
+                  </button>
+                </div>
+              </div>
+            ) : (
+              <button
+                type="button"
+                disabled={!canSubmit}
+                onClick={() => (needsSignoff ? setConfirming(true) : submitMove())}
+                className="mt-2 rounded border border-slate-300 px-2 py-0.5 disabled:opacity-50 dark:border-slate-600"
+              >
+                Move
+              </button>
+            )}
+          </section>
+        )}
+
+        <section className="mt-3" aria-label="History">
+          <h3 className="font-medium">History</h3>
+          {historyError && <p className="text-xs text-red-600">{historyError}</p>}
+          {!history && !historyError && <p className="text-xs">Loading…</p>}
+          {history && history.length === 0 && <p className="text-xs">No history.</p>}
+          {history && history.length > 0 && (
+            <ol className="mt-1 space-y-1 text-xs">
+              {history.map((e) => (
+                <li key={e.id}>
+                  <span className="font-medium">{e.change_type}</span> {describeEntry(e)}
+                  {e.reason ? ` — ${e.reason}` : ""}{" "}
+                  <span className="text-slate-500">{new Date(e.created_at).toLocaleString()}</span>
+                </li>
+              ))}
+            </ol>
+          )}
+        </section>
+      </div>
+    </div>
+  );
+}
