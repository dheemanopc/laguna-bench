+
+async def _item_at(pg_pool: Pool, e: Env, stage: str, assignee: UUID | None = None) -> None:
+    async with tenant_tx(pg_pool, e.owner) as conn:
+        await work_items.mark_work_item(
+            conn,
+            tenant_id=e.owner,
+            team_id=e.team,
+            map_key=e.map_key,
+            node_id=e.node,
+            kind="story",
+            assignee_id=assignee,
+        )
+        await conn.execute(
+            "UPDATE work_items SET workflow_id = $1, current_stage = $2 "
+            "WHERE memory_id = $3 AND tenant_id = $4",
+            e.workflow_id,
+            stage,
+            e.node,
+            e.owner,
+        )
+
+
+async def _propose(pg_pool: Pool, e: Env, who: UUID, to: str, **kw: Any) -> Any:
+    async with tenant_tx(pg_pool, e.owner) as conn:
+        return await propose_move(
+            conn,
+            tenant_id=e.owner,
+            team_id=e.team,
+            map_key=e.map_key,
+            node_id=e.node,
+            to_stage=to,
+            reason=kw.pop("reason", None),
+            proposer_tenant_id=who,
+            **kw,
+        )
+
+
+async def _sign(
+    pg_pool: Pool, e: Env, request_id: UUID, who: UUID
+) -> WorkItem | SignoffVoided | None:
+    async with tenant_tx(pg_pool, e.owner) as conn:
+        return await sign_workflow_move(
+            conn,
+            tenant_id=e.owner,
+            team_id=e.team,
+            request_id=request_id,
+            signatory_tenant_id=who,
+        )
+
+
+async def _row(pg_pool: Pool, e: Env) -> Any:
+    async with tenant_tx(pg_pool, e.owner) as conn:
+        return await conn.fetchrow("SELECT * FROM work_items WHERE memory_id = $1", e.node)
+
+
+async def _history(pg_pool: Pool, e: Env, change_type: str) -> list[Any]:
+    async with tenant_tx(pg_pool, e.owner) as conn:
+        return list(
+            await conn.fetch(
+                "SELECT * FROM work_item_history WHERE memory_id = $1 AND tenant_id = $2 "
+                "AND change_type = $3 ORDER BY id",
+                e.node,
+                e.owner,
+                change_type,
+            )
+        )
+
+
+async def _request_status(pg_pool: Pool, e: Env, request_id: UUID) -> str:
+    async with tenant_tx(pg_pool, e.owner) as conn:
+        return str(
+            await conn.fetchval(
+                "SELECT status FROM workflow_signoff_requests WHERE request_id = $1", request_id
+            )
+        )
+
+
+async def _moves(pg_pool: Pool, e: Env, viewer: UUID) -> dict[str, AllowedMove]:
+    async with tenant_tx(pg_pool, e.owner) as conn:
+        res = await compute_item_moves(
+            conn,
+            tenant_id=e.owner,
+            team_id=e.team,
+            map_key=e.map_key,
+            node_id=e.node,
+            viewing_tenant_id=viewer,
+        )
+    return {m.to_stage: m for m in res}
+
+
+async def _pending(pg_pool: Pool, e: Env, who: UUID) -> list[PendingSignoff]:
+    async with tenant_tx(pg_pool, e.owner) as conn:
+        return await list_pending_signoffs_for_user(
+            conn, tenant_id=e.owner, team_id=e.team, signatory_tenant_id=who
+        )
+
