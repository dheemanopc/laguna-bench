+                    node_id=info["n1"],
+                    disposition="resolved",
+                    resolution_summary="Confirmed by model.",
+                ),
+            )
+
+            # include="open" (default): n1 gone from nodes, in resolved
+            got_open = await _get(ctx, MindmapGetInput(map_key=info["map_key"], include="open"))
+            open_ids = {n.memory_id for n in got_open.nodes}
+            assert info["n1"] not in open_ids
+            assert info["n1"] in {r.memory_id for r in got_open.resolved}
+
+            # include="all": n1 in nodes with status + resolution_summary, resolved empty
+            got_all = await _get(ctx, MindmapGetInput(map_key=info["map_key"], include="all"))
+            all_ids = {n.memory_id for n in got_all.nodes}
+            assert info["n1"] in all_ids
+            assert len(got_all.resolved) == 0
+            n1_node = next(n for n in got_all.nodes if n.memory_id == info["n1"])
+            assert n1_node.status == "resolved"
+            assert n1_node.resolution_summary == "Confirmed by model."
+        finally:
+            await _cleanup(pg_pool, s["tenant"], s["team"], s["client_id"])
+
+    async def test_depth_full_not_truncated(self, pg_pool: Any) -> None:
