+        ctx = _ctx(pg_pool, s["tenant"], s["client_id"])
+        try:
+            info = await _open_populated_map(ctx)
+
+            got1 = await _get(ctx, MindmapGetInput(map_key=info["map_key"]))
+            cursor = got1.cursor
+
+            # Resolve n1
+            resolve_out = await _resolve(
+                ctx,
+                MindmapResolveInput(
+                    map_key=info["map_key"],
+                    node_id=info["n1"],
+                    disposition="resolved",
+                    resolution_summary="done",
+                ),
+            )
+            assert resolve_out.cursor > cursor
+
+            # Cheap read: only n1 changed
+            got2 = await _get(ctx, MindmapGetInput(map_key=info["map_key"], since=cursor))
+            assert len(got2.nodes) == 0  # n1 is settled, not in open nodes
+            assert len(got2.resolved) == 1
+            assert got2.resolved[0].memory_id == info["n1"]
+            assert got2.resolved[0].status == "resolved"
+            assert got2.cursor == resolve_out.cursor
+
+            # Re-reading with the new cursor → no changes
+            got3 = await _get(ctx, MindmapGetInput(map_key=info["map_key"], since=got2.cursor))
+            assert got3.nodes == []
+            assert got3.resolved == []
+        finally:
+            await _cleanup(pg_pool, s["tenant"], s["team"], s["client_id"])
+
+    async def test_include_all_shows_settled_nodes(self, pg_pool: Any) -> None:
+        async with pg_pool.acquire() as conn:
