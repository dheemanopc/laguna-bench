+"""Integration tests for mindmap_resolve + cheap reads on mindmap_get.
+
+Exercises the real MCP tools against a live Postgres pool:
+  - resolve (resolved / dropped / re-settle / edge drawing / party tracking)
+  - open_loops fix (owner AND model responsible_party; settled nodes excluded)
+  - cheap reads (since / include / depth)
+  - error paths (map not found, archived, unknown node, root node, self-ref,
+    inaccessible resolver — both not-found and cross-tenant no-access)
+  - get on an archived map still works
+
+Setup/cleanup mirrors tests/integration/test_mindmap_e2e.py.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID, uuid4
+
+import asyncpg  # type: ignore[import-untyped]
+import pytest
+
+from mem_mcp.audit.logger import NoopAuditLogger
+from mem_mcp.embeddings.bedrock import EmbedResult
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.mindmap_close import (
+    MindmapCloseInput,
+    MindmapCloseOutput,
+    MindmapCloseTool,
+)
+from mem_mcp.mcp.tools.mindmap_get import (
+    MindmapGetInput,
+    MindmapGetOutput,
+    MindmapGetTool,
+)
+from mem_mcp.mcp.tools.mindmap_open import MindmapOpenInput, MindmapOpenOutput, MindmapOpenTool
+from mem_mcp.mcp.tools.mindmap_resolve import (
+    MindmapResolveInput,
+    MindmapResolveOutput,
+    MindmapResolveTool,
+)
+from mem_mcp.mcp.tools.mindmap_write_node import (
+    MindmapWriteNodeInput,
+    MindmapWriteNodeOutput,
+    MindmapWriteNodeTool,
+)
+from mem_mcp.mindmap import SUMMARY_CONTENT_CHARS
+from mem_mcp.teams.assignments import assign_role
+
+pytestmark = pytest.mark.asyncio
+
+
+# ── helpers ──────────────────────────────────────────────────────────────────
+
+
+def _build_deps() -> ToolDeps:
+    class _StubEmbed:
+        async def embed(self, content: str) -> Any:
+            return EmbedResult(vector=[0.0] * 1024, input_tokens=max(1, len(content) // 4))
+
+    return ToolDeps(embeddings=_StubEmbed(), audit=NoopAuditLogger(), quotas=NoopQuotas())
+
+
+# ── typed tool wrappers (narrow BaseModel → concrete output for mypy) ──────────
+
+
+async def _open(ctx: ToolContext, inp: MindmapOpenInput) -> MindmapOpenOutput:
+    out = await MindmapOpenTool()(ctx, inp)
+    assert isinstance(out, MindmapOpenOutput)
+    return out
+
+
+async def _write_node(ctx: ToolContext, inp: MindmapWriteNodeInput) -> MindmapWriteNodeOutput:
+    out = await MindmapWriteNodeTool()(ctx, inp)
+    assert isinstance(out, MindmapWriteNodeOutput)
+    return out
+
+
+async def _resolve(ctx: ToolContext, inp: MindmapResolveInput) -> MindmapResolveOutput:
+    out = await MindmapResolveTool()(ctx, inp)
+    assert isinstance(out, MindmapResolveOutput)
+    return out
+
+
+async def _get(ctx: ToolContext, inp: MindmapGetInput) -> MindmapGetOutput:
+    out = await MindmapGetTool()(ctx, inp)
+    assert isinstance(out, MindmapGetOutput)
+    return out
+
+
+async def _close(ctx: ToolContext, inp: MindmapCloseInput) -> MindmapCloseOutput:
+    out = await MindmapCloseTool()(ctx, inp)
+    assert isinstance(out, MindmapCloseOutput)
+    return out
+
+
+async def _setup(conn: asyncpg.Connection) -> dict[str, Any]:
+    """Create a single tenant + team + identity + oauth client."""
+    tenant = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"mr-{uuid4()}@example.test",
+    )
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+        f"mr-team-{uuid4().hex[:8]}",
+        tenant,
+    )
+    await assign_role(
+        conn,
+        parent_team_id=team,
+        member_kind="user",
+        member_id=tenant,
+        role_key="member",
+        assigned_by_user_id=tenant,
+    )
+    await conn.execute(
+        """
+        INSERT INTO tenant_identities
+            (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+        VALUES ($1, $2, 'cognito', $3, true, $4)
+        """,
+        tenant,
+        f"sub-{tenant}",
+        f"mr-{tenant}@example.test",
+        team,
+    )
+    client_id = f"client:mr-{uuid4().hex[:8]}"
+    await conn.execute(
+        """
+        INSERT INTO oauth_clients
+            (id, redirect_uris, scope, registration_payload, review_status)
+        VALUES ($1, ARRAY[]::text[], 'memory.read memory.write', '{}'::jsonb, 'auto_allowed')
+        """,
+        client_id,
+    )
+    return {"tenant": tenant, "team": team, "client_id": client_id}
+
+
+async def _cleanup(pool: Any, tenant: UUID, team: UUID, client_id: str) -> None:
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute(
+                "DELETE FROM memory_references WHERE source_memory_id IN "
+                "(SELECT id FROM memories WHERE tenant_id = $1) "
+                "OR target_memory_id IN (SELECT id FROM memories WHERE tenant_id = $1)",
+                tenant,
+            )
+            await conn.execute("DELETE FROM memory_map_events WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM memory_map_membership WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM memory_maps WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM slugs WHERE team_id = $1", team)
+            await conn.execute("DELETE FROM memories WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM team_role_assignments WHERE parent_team_id = $1", team)
+            await conn.execute("DELETE FROM tenant_identities WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM teams WHERE id = $1", team)
+            await conn.execute("DELETE FROM tenants WHERE id = $1", tenant)
+            await conn.execute("DELETE FROM oauth_clients WHERE id = $1", client_id)
