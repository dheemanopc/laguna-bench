+"""mindmap branch status — stored settlement state per node.
+
+Per the mind-map v1 follow-up (work order: branch status, mindmap_resolve):
+a node's settlement is now a *stored column* on memory_map_membership — the
+single source of truth for "settled". An `edge` row in memory_references is
+only a *link*, never a settlement signal; only `status` settles a branch.
+
+This fixes two problems:
+  1. `open_loops` only ever grew — `mindmap_close` settles the whole map, but
+     nothing settled a *branch*, so abandoned/answered branches stayed in the
+     open-loop set indefinitely. Now `mindmap_resolve` records resolved/dropped
+     in place and the get tool can read the open set cheaply.
+  2. `mindmap_get` returned every node in full every time; with a stored status
+     and a cursor index it can return only the open set / changed nodes since a
+     cursor.
+
+Existing rows default to 'open' (unsettled) — the DEFAULT makes every
+pre-existing row 'open' with NULL resolution fields, which satisfies the
+consistency CHECK, so no data migration is needed.
+
+The existing RLS policies on memory_map_membership already filter on
+tenant_id (USING / WITH CHECK); the new columns ride the same row, so no new
+policy is required.
+
+Revision ID: 0044_mindmap_branch_status
+Revises: 0043_backfill_personal_teams
+Create Date: 2026-10-16
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0044_mindmap_branch_status"
+down_revision = "0043_backfill_personal_teams"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    # Add settlement columns. DEFAULT 'open' makes pre-existing rows unsettled;
+    # the consistency CHECK below is satisfied by (open, NULLs) for those rows.
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+            ADD COLUMN status TEXT NOT NULL DEFAULT 'open',
+            ADD COLUMN resolution_summary TEXT NULL,
+            ADD COLUMN resolved_by_memory_id UUID NULL REFERENCES memories(id) ON DELETE SET NULL,
+            ADD COLUMN resolved_by_party TEXT NULL,
+            ADD COLUMN resolved_at TIMESTAMPTZ NULL
+        """)
+    )
+
+    # Named constraints (work-order: name explicitly).
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+            ADD CONSTRAINT memory_map_membership_status_check
+                CHECK (status IN ('open', 'resolved', 'dropped')),
+            ADD CONSTRAINT memory_map_membership_resolution_summary_len
+                CHECK (resolution_summary IS NULL OR char_length(resolution_summary) BETWEEN 1 AND 500),
+            ADD CONSTRAINT memory_map_membership_resolved_by_party_check
+                CHECK (resolved_by_party IN ('owner', 'model')),
+            ADD CONSTRAINT memory_map_membership_settlement_consistency CHECK (
+                (status = 'open'
+                 AND resolution_summary IS NULL
+                 AND resolved_by_memory_id IS NULL
+                 AND resolved_by_party IS NULL
+                 AND resolved_at IS NULL)
+                OR
+                (status <> 'open'
+                 AND resolution_summary IS NOT NULL
+                 AND resolved_by_party IS NOT NULL
+                 AND resolved_at IS NOT NULL)
+            )
+        """)
+    )
+
+    # Cursor-read index: cheap `mindmap_get(since=<cursor>)` event-range scans
+    # over a single map's events ordered by id.
+    op.execute(
+        sa.text(
+            "CREATE INDEX IF NOT EXISTS memory_map_events_cursor_idx "
+            "ON memory_map_events(root_memory_id, id)"
+        )
+    )
+
+
+def downgrade() -> None:
+    op.execute(sa.text("DROP INDEX IF EXISTS memory_map_events_cursor_idx"))
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership "
+            "DROP CONSTRAINT IF EXISTS memory_map_membership_settlement_consistency, "
+            "DROP CONSTRAINT IF EXISTS memory_map_membership_resolved_by_party_check, "
+            "DROP CONSTRAINT IF EXISTS memory_map_membership_resolution_summary_len, "
+            "DROP CONSTRAINT IF EXISTS memory_map_membership_status_check"
+        )
+    )
+    # Dropping resolved_by_memory_id also drops its FK to memories(id).
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership "
+            "DROP COLUMN IF EXISTS resolved_at, "
+            "DROP COLUMN IF EXISTS resolved_by_party, "
+            "DROP COLUMN IF EXISTS resolved_by_memory_id, "
+            "DROP COLUMN IF EXISTS resolution_summary, "
+            "DROP COLUMN IF EXISTS status"
+        )
+    )
