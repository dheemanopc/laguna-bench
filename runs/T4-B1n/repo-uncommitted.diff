+"""Unit tests for mindmap_get cheap-read helpers and input validation.
+
+Tests the pure-Python pieces of the cheap-read algorithm that don't need a DB:
+the ``_truncate_content`` helper (boundary char counts), ``MindmapGetInput``
+field validation (since/include/depth defaults + constraints), and
+``MindmapResolveInput`` validation (resolution_summary length, extra forbid,
+self-reference is caught in the tool not the model).
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import uuid4
+
+import pytest
+from pydantic import ValidationError
+
+from mem_mcp.mcp.tools.mindmap_get import (
+    MindmapGetInput,
+    MindmapNode,
+    MindmapResolvedEntry,
+    _truncate_content,
+)
+from mem_mcp.mcp.tools.mindmap_resolve import (
+    MindmapResolveInput,
+    MindmapResolveOutput,
+)
+from mem_mcp.mindmap import RESOLUTION_SUMMARY_MAX_CHARS, SUMMARY_CONTENT_CHARS
+
+# ---------------------------------------------------------------------------
+# _truncate_content
+# ---------------------------------------------------------------------------
+
+
+class TestTruncateContent:
+    def test_empty_string(self) -> None:
+        content, truncated = _truncate_content("")
+        assert content == ""
+        assert truncated is False
+
+    def test_short_string_unchanged(self) -> None:
+        content, truncated = _truncate_content("hello world")
+        assert content == "hello world"
+        assert truncated is False
+
+    def test_exactly_at_limit_unchanged(self) -> None:
+        """A string of exactly SUMMARY_CONTENT_CHARS (200) is not truncated."""
+        s = "x" * SUMMARY_CONTENT_CHARS
+        content, truncated = _truncate_content(s)
+        assert content == s
+        assert truncated is False
+
+    def test_one_over_limit_truncated(self) -> None:
+        """201 chars → 200 chars + '…' = 201 total, truncated=True."""
+        s = "x" * (SUMMARY_CONTENT_CHARS + 1)
+        content, truncated = _truncate_content(s)
+        assert len(content) == SUMMARY_CONTENT_CHARS + 1  # 200 + ellipsis
+        assert content.endswith("…")
+        assert truncated is True
+
+    def test_way_over_limit_truncated(self) -> None:
+        s = "x" * 5000
+        content, truncated = _truncate_content(s)
+        assert len(content) == SUMMARY_CONTENT_CHARS + 1
+        assert content.startswith("x" * SUMMARY_CONTENT_CHARS)
+        assert content.endswith("…")
+        assert truncated is True
+
+    def test_custom_max_chars(self) -> None:
+        content, truncated = _truncate_content("hello", max_chars=3)
+        assert content == "hel…"
+        assert truncated is True
+
+    def test_custom_max_chars_exact(self) -> None:
+        content, truncated = _truncate_content("hello", max_chars=5)
+        assert content == "hello"
+        assert truncated is False
+
+
+# ---------------------------------------------------------------------------
+# MindmapGetInput validation
+# ---------------------------------------------------------------------------
+
+
+class TestMindmapGetInput:
+    def test_defaults(self) -> None:
+        inp = MindmapGetInput(map_key="caching-strategy")
+        assert inp.since is None
+        assert inp.include == "open"
+        assert inp.depth == "summary"
+        assert inp.team_id is None
+
+    def test_required_map_key(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapGetInput()  # type: ignore[call-arg]
+
+    def test_map_key_min_length(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapGetInput(map_key="")
+
+    def test_map_key_max_length(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapGetInput(map_key="x" * 65)
+
+    def test_since_ge_zero(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapGetInput(map_key="m", since=-1)
+
+    def test_since_zero_allowed(self) -> None:
+        inp = MindmapGetInput(map_key="m", since=0)
+        assert inp.since == 0
+
+    def test_include_values(self) -> None:
+        assert MindmapGetInput(map_key="m", include="open").include == "open"
+        assert MindmapGetInput(map_key="m", include="all").include == "all"
+        with pytest.raises(ValidationError):
+            MindmapGetInput(map_key="m", include="bogus")  # type: ignore[arg-type]
+
+    def test_depth_values(self) -> None:
+        assert MindmapGetInput(map_key="m", depth="summary").depth == "summary"
+        assert MindmapGetInput(map_key="m", depth="full").depth == "full"
+        with pytest.raises(ValidationError):
+            MindmapGetInput(map_key="m", depth="verbose")  # type: ignore[arg-type]
+
+    # Note: MindmapGetInput does NOT set extra="forbid" — existing callers may
+    # pass passthrough kwargs (e.g. logging metadata). extra field handling is
+    # tested only for MindmapResolveInput (a new tool) which enforces extra="forbid".
+
+
+# ---------------------------------------------------------------------------
+# MindmapResolveInput validation
+# ---------------------------------------------------------------------------
+
+
+class TestMindmapResolveInput:
+    def _base(self, **overrides: Any) -> dict[str, Any]:
+        base: dict[str, Any] = {
+            "map_key": "caching-strategy",
+            "node_id": uuid4(),
+            "resolution_summary": "Addressed in spec review.",
+        }
+        base.update(overrides)
+        return base
+
+    def test_defaults(self) -> None:
+        inp = MindmapResolveInput(**self._base())
+        assert inp.disposition == "resolved"
+        assert inp.resolved_by_party == "model"
+        assert inp.resolved_by_memory_id is None
+        assert inp.team_id is None
+
+    def test_required_fields(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(map_key="m", node_id=uuid4())  # type: ignore[call-arg]  # resolution_summary missing
+
+    def test_resolution_summary_min_length(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(**self._base(resolution_summary=""))
+
+    def test_resolution_summary_max_length(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(
+                **self._base(resolution_summary="x" * (RESOLUTION_SUMMARY_MAX_CHARS + 1))
+            )
+
+    def test_resolution_summary_max_length_boundary(self) -> None:
+        """Exactly RESOLUTION_SUMMARY_MAX_CHARS chars is allowed."""
+        inp = MindmapResolveInput(
+            **self._base(resolution_summary="x" * RESOLUTION_SUMMARY_MAX_CHARS)
+        )
+        assert len(inp.resolution_summary) == RESOLUTION_SUMMARY_MAX_CHARS
+
+    def test_disposition_values(self) -> None:
+        assert MindmapResolveInput(**self._base(disposition="resolved")).disposition == "resolved"
+        assert MindmapResolveInput(**self._base(disposition="dropped")).disposition == "dropped"
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(**self._base(disposition="maybe"))
+
+    def test_resolved_by_party_values(self) -> None:
+        assert (
+            MindmapResolveInput(**self._base(resolved_by_party="owner")).resolved_by_party
+            == "owner"
+        )
+        assert (
+            MindmapResolveInput(**self._base(resolved_by_party="model")).resolved_by_party
+            == "model"
+        )
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(**self._base(resolved_by_party="system"))
+
+    def test_extra_fields_forbidden(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(**self._base(bogus=True))
+
+
+# ---------------------------------------------------------------------------
+# MindmapGetOutput model construction (no DB)
+# ---------------------------------------------------------------------------
+
+
+class TestMindmapGetOutput:
+    def test_resolved_entry(self) -> None:
+        entry = MindmapResolvedEntry(
+            memory_id=uuid4(),
+            resolution_summary="done",
+            status="resolved",
+            resolved_by_party="model",
+        )
+        assert entry.status == "resolved"
+        assert entry.resolved_by_party == "model"
+
+    def test_node_has_new_fields(self) -> None:
+        from datetime import datetime
+
+        from mem_mcp.mindmap import BRANCH_STATUSES
+
+        node = MindmapNode(
+            memory_id=uuid4(),
+            node_role="position",
+            type="position",
+            content="hello",
+            metadata={},
+            created_at=datetime.now(),
+            status="open",
+            truncated=False,
+        )
+        assert node.status == "open"
+        assert node.truncated is False
+        assert node.resolution_summary is None
+        # BRANCH_STATUSES should include all three statuses.
+        assert set(BRANCH_STATUSES) == {"open", "resolved", "dropped"}
+
+
+# ---------------------------------------------------------------------------
+# MindmapResolveOutput model construction (no DB)
+# ---------------------------------------------------------------------------
+
+
+class TestMindmapResolveOutput:
+    def test_output_shape(self) -> None:
+        node_id = uuid4()
+        out = MindmapResolveOutput(
+            node_id=node_id,
+            status="resolved",
+            resolution_summary="Addressed.",
+            cursor=42,
+            request_id="req-1",
+        )
+        assert out.node_id == node_id
+        assert out.status == "resolved"
+        assert out.cursor == 42
