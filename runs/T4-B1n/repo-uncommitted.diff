index 0000000..6d75b4c
--- /dev/null
+++ b/src/mem_mcp/mcp/tools/mindmap_resolve.py
@@ -0,0 +1,208 @@
+"""mindmap_resolve — settle a single branch as resolved or dropped.
+
+Per the mind-map v1 build design (docs/mindmap-v1-build-design.md): a branch
+(settled or not) is recorded on the membership row's ``status`` column (migration
+0044), the ONLY source of truth for "settled". An edge in memory_references
+(e.g. ``resolves-under``) is a *link*, never a settlement signal.
+
+This tool records the settlement in place. When a resolving node is named, it
+additionally draws a ``resolves-under`` / ``dropped-under`` edge from the
+resolver to the settled node, so the rationale is graph-linkable.
+
+Re-settling an already-settled branch (e.g. resolved→dropped, or a new summary)
+is allowed: it overwrites the settlement and logs a new event. There is no path
+back to ``open`` via this tool — use mindmap_close to settle the whole map.
+"""
+
+from __future__ import annotations
+
+from typing import ClassVar, Literal
+from uuid import UUID
+
+from pydantic import BaseModel, ConfigDict, Field
+
+from mem_mcp.db import system_tx, tenant_tx
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tool_descriptions import TOOL_DESCRIPTIONS
+from mem_mcp.mcp.tools._base import BaseTool, ToolContext
+from mem_mcp.mcp.tools._mindmap_common import resolve_team_id
+from mem_mcp.mindmap import RESOLUTION_REFERENCE_KINDS, RESOLUTION_SUMMARY_MAX_CHARS, service
+from mem_mcp.teams.references import (
+    ReferenceTargetNotFoundError,
+    insert_reference,
+    resolve_reference_target,
+)
+
+
+class MindmapResolveInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    map_key: str = Field(..., min_length=1, max_length=64)
+    node_id: UUID
+    disposition: Literal["resolved", "dropped"] = "resolved"
+    resolution_summary: str = Field(..., min_length=1, max_length=RESOLUTION_SUMMARY_MAX_CHARS)
+    resolved_by_memory_id: UUID | None = None
+    resolved_by_party: Literal["owner", "model"] = "model"
+    team_id: UUID | None = None
+
+
+class MindmapResolveOutput(BaseModel):
+    node_id: UUID
+    status: str
+    resolution_summary: str
+    cursor: int
+    request_id: str
+
+
+class MindmapResolveTool(BaseTool):
+    name: ClassVar[str] = "mindmap_resolve"
+    description: ClassVar[str] = TOOL_DESCRIPTIONS["mindmap_resolve"]
+    required_scope: ClassVar[str] = "memory.write"
+    InputModel: ClassVar[type[BaseModel]] = MindmapResolveInput
+    OutputModel: ClassVar[type[BaseModel]] = MindmapResolveOutput
+
+    async def __call__(self, ctx: ToolContext, inp: BaseModel) -> BaseModel:
+        assert isinstance(inp, MindmapResolveInput)
+
+        # Self-reference guard (no DB needed — cheapest fail).
+        if inp.resolved_by_memory_id is not None and inp.resolved_by_memory_id == inp.node_id:
+            raise JsonRpcError(
+                -32602,
+                "resolved_by_memory_id must differ from node_id",
+                data={"errors": [{"path": "resolved_by_memory_id"}]},
+            )
+
+        # Steps 1-4: resolve the map + validate node membership. Read-only checks
+        # in their own tx so they surface clean 400s before any write is
+        # attempted. (Step 6 re-checks inside the write tx for lock safety.)
+        async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+            team_id = await resolve_team_id(conn, ctx, inp.team_id)
+            root_id = await service.resolve_map_root(conn, team_id=team_id, map_key=inp.map_key)
+            if root_id is None:
+                raise JsonRpcError(-32602, "map not found", data={"errors": [{"path": "map_key"}]})
+            row = await service.get_map_row(conn, root_memory_id=root_id)
+            if row is None or row["state"] != "live":
+                raise JsonRpcError(
+                    -32602,
+                    "map already archived (no-reopen)",
+                    data={"code": "map_not_live"},
+                )
+            member = await service.get_member(
+                conn,
+                root_memory_id=root_id,
+                memory_id=inp.node_id,
+                tenant_id=ctx.tenant_id,
+            )
+            if member is None:
+                raise JsonRpcError(
+                    -32602,
+                    "node not found in map",
+                    data={"errors": [{"path": "node_id"}]},
+                )
+            if inp.node_id == root_id:
+                raise JsonRpcError(
+                    -32602,
+                    "root node is the map itself, not a branch; use mindmap_close",
+                    data={"errors": [{"path": "node_id"}]},
+                )
+
+        # Step 5: access-check the resolver BEFORE any write (system_tx, like
+        # mindmap_link). Maps ReferenceTargetNotFoundError to an opaque -32602
+        # so "not found" and "no access" are indistinguishable.
+        if inp.resolved_by_memory_id is not None:
+            async with system_tx(ctx.db_pool) as sys_conn:
+                try:
+                    await resolve_reference_target(
+                        sys_conn,
+                        target_uuid=inp.resolved_by_memory_id,
+                        caller_user_id=ctx.tenant_id,
+                    )
+                except ReferenceTargetNotFoundError as exc:
+                    raise JsonRpcError(
+                        -32602,
+                        "reference target not found or not accessible",
+                        data={"code": "memory_not_accessible"},
+                    ) from exc
+
+        # Step 6: settle in ONE tenant_tx. Re-check map live + node membership
+        # (lock-safe: lookup and UPDATE in the same tx). Then settle, draw the
+        # edge (if a resolver was named), and log the event.
+        async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+            team_id = await resolve_team_id(conn, ctx, inp.team_id)
+            root_id = await service.resolve_map_root(conn, team_id=team_id, map_key=inp.map_key)
+            if root_id is None:
+                raise JsonRpcError(-32602, "map not found", data={"errors": [{"path": "map_key"}]})
+            # Lock the map row (FOR UPDATE) so a concurrent mindmap_close cannot
+            # archive the map between this check and the settle_branch UPDATE.
+            row = await service.lock_map_row(
+                conn,
+                root_memory_id=root_id,
+                tenant_id=ctx.tenant_id,
+            )
+            if row is None or row["state"] != "live":
+                raise JsonRpcError(
+                    -32602,
+                    "map already archived (no-reopen)",
+                    data={"code": "map_not_live"},
+                )
+            member = await service.get_member(
+                conn,
+                root_memory_id=root_id,
+                memory_id=inp.node_id,
+                tenant_id=ctx.tenant_id,
+            )
+            if member is None or inp.node_id == root_id:
+                raise JsonRpcError(
+                    -32602,
+                    "node not found in map",
+                    data={"errors": [{"path": "node_id"}]},
+                )
+
+            await service.settle_branch(
+                conn,
+                root_memory_id=root_id,
+                memory_id=inp.node_id,
+                tenant_id=ctx.tenant_id,
+                status=inp.disposition,
+                resolution_summary=inp.resolution_summary,
+                resolved_by_memory_id=inp.resolved_by_memory_id,
+                resolved_by_party=inp.resolved_by_party,
+            )
+
+            reference_kind: str | None = None
+            if inp.resolved_by_memory_id is not None:
+                reference_kind = RESOLUTION_REFERENCE_KINDS[inp.disposition]
+                await insert_reference(
+                    conn,
+                    source_memory_id=inp.resolved_by_memory_id,
+                    target_memory_id=inp.node_id,
+                    target_team_id=row["team_id"],
+                    reference_kind=reference_kind,
+                )
+
+            event = "resolve" if inp.disposition == "resolved" else "drop"
+            cursor = await service.log_event(
+                conn,
+                root_memory_id=root_id,
+                tenant_id=ctx.tenant_id,
+                event=event,
+                actor=inp.resolved_by_party,
+                memory_id=inp.node_id,
+                payload={
+                    "disposition": inp.disposition,
+                    "resolved_by_memory_id": (
+                        str(inp.resolved_by_memory_id)
+                        if inp.resolved_by_memory_id is not None
+                        else None
+                    ),
+                    "reference_kind": reference_kind,
+                },
+            )
+
+        return MindmapResolveOutput(
+            node_id=inp.node_id,
+            status=inp.disposition,
+            resolution_summary=inp.resolution_summary,
+            cursor=cursor,
+            request_id=ctx.request_id,
+        )
