+
+def _ctx(pool: Any, tenant: UUID, client_id: str) -> ToolContext:
+    return ToolContext(
+        request_id=f"req-{uuid4().hex[:8]}",
+        tenant_id=tenant,
+        identity_id=tenant,
+        client_id=client_id,
+        scopes=frozenset({"memory.read", "memory.write"}),
+        db_pool=pool,
+        deps=_build_deps(),
+    )
+
+
+async def _open_populated_map(ctx: ToolContext, *, threshold: int = 100) -> dict[str, Any]:
+    """Open a map with 4 working nodes (root + n1..n4).
+
+    Layout:
+      root — the map's root question (auto)
+      n1   — position, responsible_party="owner"  (open loop, owner's turn)
+      n2   — challenge, responsible_party="model" (open loop, model's turn)
+      n3   — note, no responsible_party           (NOT an open loop)
+      n4   — position, content "x"*300            (truncation test target)
+    """
+    opened = await _open(
+        ctx,
+        MindmapOpenInput(
+            title="Test map",
+            root_question="How should we cache?",
+            review_threshold=threshold,
+        ),
+    )
+    map_key = opened.map_key
+
+    n1 = await _write_node(
+        ctx,
+        MindmapWriteNodeInput(
+            map_key=map_key,
+            content="Use Redis for the hot read path",
+            node_role="position",
+            responsible_party="owner",
+        ),
+    )
+    n2 = await _write_node(
+        ctx,
+        MindmapWriteNodeInput(
+            map_key=map_key,
+            content="Cache invalidation is hard",
+            node_role="challenge",
+            responsible_party="model",
+        ),
+    )
+    await _write_node(
+        ctx,
+        MindmapWriteNodeInput(
+            map_key=map_key,
+            content="Consider TTL settings",
+            node_role="note",
+        ),
+    )
+    n4 = await _write_node(
+        ctx,
+        MindmapWriteNodeInput(
+            map_key=map_key,
+            content="x" * 300,
+            node_role="position",
+        ),
+    )
+
+    return {
+        "map_key": map_key,
+        "root_id": opened.root_memory_id,
+        "n1": n1.node_id,
+        "n2": n2.node_id,
+        "n4": n4.node_id,
+    }
+
