+class TestRefsInTool:
+    async def test_own_citer_accessible_raw_sql_owner(self, pg_pool: Any) -> None:
+        """Raw-SQL owner (no UEA rows): own M2 citing own M1 → memsys_refs_in(M1)
+        reports M2 as accessible (owner reads own memory via tenant_id)."""
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                s = await _provision_raw_user(conn, "refs-in-a")
+                m1 = await _mk_mem(conn, s["tenant"], s["team"])
+                m2 = await _mk_mem(conn, s["tenant"], s["team"])
+            # Reference is inserted outside the tx above (committed) so the tool
+            # (running on its own connection) sees it.
+            async with pg_pool.acquire() as conn2:
+                await insert_reference(
+                    conn2,
+                    source_memory_id=m2,
+                    target_memory_id=m1,
+                    target_team_id=s["team"],
+                    reference_kind="cites",
+                )
+            try:
+                ctx = _ctx(s["tenant"], pg_pool)
+                out = await RefsInTool()(ctx, RefsInInput(memory_id=m1))
+                assert isinstance(out, RefsInOutput)
+                assert out.accessible_count == 1
+                assert out.inaccessible_count == 0
+                assert out.refs[0].source_memory_id == str(m2)
+                assert out.refs[0].target_memory_id == str(m1)
+            finally:
+                await _cleanup_tenants(pg_pool, [s["tenant"]])
+
+    async def test_foreign_citer_only_counted(self, pg_pool: Any) -> None:
+        """A foreign-tenant citer (no access) is hidden from `refs` and only
+        counted in `inaccessible_count`."""
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                a = await _provision_raw_user(conn, "refs-in-f")
+                b = await _provision_raw_user(conn, "refs-in-fb")
+                target = await _mk_mem(conn, a["tenant"], a["team"])
+                foreign = await _mk_mem(conn, b["tenant"], b["team"])
+            async with pg_pool.acquire() as conn2:
+                await insert_reference(
+                    conn2,
+                    source_memory_id=foreign,
+                    target_memory_id=target,
+                    target_team_id=a["team"],
+                    reference_kind="cites",
+                )
+            try:
+                ctx = _ctx(a["tenant"], pg_pool)
+                out = await RefsInTool()(ctx, RefsInInput(memory_id=target))
+                assert isinstance(out, RefsInOutput)
+                # Foreign citer has no access → not in refs, only counted.
+                assert out.accessible_count == 0
+                assert out.inaccessible_count == 1
+                assert out.refs == []
+            finally:
+                await _cleanup_tenants(pg_pool, [a["tenant"], b["tenant"]])
+
