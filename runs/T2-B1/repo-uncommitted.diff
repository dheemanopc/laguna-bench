+"""Regression tests for the memory_not_accessible bug: a raw-SQL-provisioned user
+(owner of a personal team, with NO `user_effective_team_access` row) must be able
+to reference their OWN memory.
+
+Root cause being guarded: the per-memory access check consulted ONLY the
+materialised `user_effective_team_access` view-table. UEA is populated by Python
+sync/refresh paths, so raw-SQL-provisioned accounts (the 0026 personal-team
+backfill pattern) had no UEA row for their own personal team and were rejected
+even for their own memories — diverging from `memory_get` (tenant_tx / RLS
+`tenant_id = caller`).
+
+The fix unifies all four sites behind the SQL function `memory_readable_by`
++migration 0035 + the Python helper `can_read_memory`.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+from uuid import uuid4
+
+import pytest
+
+from mem_mcp.teams.references import (
+    HardDeleteBlockedError,
+    ReferenceTargetNotFoundError,
+    can_read_memory,
+    can_read_memory_bulk,
+    check_hard_delete_with_filtered_citers,
+    insert_reference,
+    resolve_reference_target,
+)
+
+if TYPE_CHECKING:
+    import asyncpg  # type: ignore[import-untyped]
+
+pytestmark = pytest.mark.asyncio
+
+
+def _mem_insert_sql() -> str:
+    # visibility='team' so a UEA-row holder can also read it; owner reads via
+    # tenant_id regardless of visibility.
+    return (
+        "INSERT INTO memories (tenant_id, team_id, content, content_hash, embedding, "
+        "source_kind, type, visibility) "
+        "VALUES ($1, $2, 'c', $3, array_fill(0::real, ARRAY[1024])::vector, "
+        "'api', 'decision', 'team') RETURNING id"
+    )
+
+
+async def _owner_no_uea(conn: asyncpg.Connection) -> dict[str, Any]:
+    """Provision a user the way the 0026 personal-team backfill did: tenant +
+    personal team + owner row in team_role_assignments + primary tenant_identity,
+    but deliberately WITHOUT running the Python UEA sync (so no UEA row exists).
+
+    This is the exact profile that triggered the original memory_not_accessible bug.
+    """
+    tenant = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"t2b-{uuid4()}@example.test",
+    )
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id, team_type) "
+        "VALUES ($1, $2, 'personal') RETURNING id",
+        f"t2b-{uuid4().hex[:8]}",
+        tenant,
+    )
+    owner_role_id = await conn.fetchval(
+        "SELECT id FROM roles_catalog WHERE role_key = 'owner' AND plugin_id IS NULL"
+    )
+    await conn.execute(
+        "INSERT INTO team_role_assignments "
+        "(parent_team_id, member_kind, member_id, role_id, status, assigned_by_user_id) "
+        "VALUES ($1, 'user', $2, $3, 'active', $2)",
+        team,
+        tenant,
+        owner_role_id,
+    )
+    await conn.execute(
+        "INSERT INTO tenant_identities (tenant_id, cognito_sub, provider, email, "
+        "is_primary, default_team_id) VALUES ($1, $2, 'cognito', $3, true, $4)",
+        tenant,
+        f"sub-t2b-{tenant}",
+        f"t2b-{tenant}@example.test",
+        team,
+    )
+    # Sanity: no UEA row exists for this owner+team (the precondition of the bug).
+    has_uea = await conn.fetchval(
+        "SELECT 1 FROM user_effective_team_access " "WHERE user_id = $1 AND resource_team_id = $2",
+        tenant,
+        team,
+    )
+    assert has_uea is None, "test precondition: owner must have NO UEA row"
+    return {"tenant": tenant, "team": team}
+
+
+class TestCanReadMemory:
+    async def test_owner_own_memory_readable_without_uea(self, pg_pool: Any) -> None:
+        """The core regression: owner reads own memory despite no UEA row."""
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                s = await _owner_no_uea(conn)
+                mem = await conn.fetchval(
+                    _mem_insert_sql(), s["tenant"], s["team"], f"h-{uuid4().hex}"
+                )
+                assert await can_read_memory(conn, memory_id=mem, user_id=s["tenant"]) is True
+
+    async def test_stranger_no_uea_cannot_read(self, pg_pool: Any) -> None:
+        """A different tenant with no UEA row for the team cannot read."""
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                s = await _owner_no_uea(conn)
+                mem = await conn.fetchval(
+                    _mem_insert_sql(), s["tenant"], s["team"], f"h-{uuid4().hex}"
+                )
+                stranger = await conn.fetchval(
+                    "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                    f"str-{uuid4()}@example.test",
+                )
+                assert await can_read_memory(conn, memory_id=mem, user_id=stranger) is False
+
+    async def test_stranger_with_uea_can_read_team_memory(self, pg_pool: Any) -> None:
+        """A stranger WITH a UEA row for the team can read a team-visibility memory."""
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                from mem_mcp.teams.assignments import assign_role
+
+                s = await _owner_no_uea(conn)
+                mem = await conn.fetchval(
+                    _mem_insert_sql(), s["tenant"], s["team"], f"h-{uuid4().hex}"
+                )
+                stranger = await conn.fetchval(
+                    "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                    f"str-{uuid4()}@example.test",
+                )
+                # Grant stranger access to the personal team via the normal API
+                # (which DOES sync UEA).
+                await assign_role(
+                    conn,
+                    parent_team_id=s["team"],
+                    member_kind="user",
+                    member_id=stranger,
+                    role_key="member",
+                    assigned_by_user_id=s["tenant"],
+                )
+                assert await can_read_memory(conn, memory_id=mem, user_id=stranger) is True
+
+    async def test_deleted_memory_access_predicate_is_true_for_owner(self, pg_pool: Any) -> None:
+        """`memory_readable_by` is a pure access predicate — it does NOT filter on
+        `deleted_at`. The owner can still "read" their own soft-deleted memory
+        here; soft-deletion is handled at the query layer instead."""
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                s = await _owner_no_uea(conn)
+                mem = await conn.fetchval(
+                    _mem_insert_sql(), s["tenant"], s["team"], f"h-{uuid4().hex}"
+                )
+                await conn.execute("UPDATE memories SET deleted_at = now() WHERE id = $1", mem)
+                # Access predicate: owner still readable (no deleted_at filter in the fn).
+                assert await can_read_memory(conn, memory_id=mem, user_id=s["tenant"]) is True
+
+    async def test_resolve_reference_target_rejects_deleted_opaque(self, pg_pool: Any) -> None:
+        """Soft-deletion IS enforced by resolve_reference_target's own lookup query
+        (the access predicate is deleted_at-agnostic, so the query filters it).
+        A deleted target surfaces the same opaque error as a missing one."""
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                s = await _owner_no_uea(conn)
+                mem = await conn.fetchval(
+                    _mem_insert_sql(), s["tenant"], s["team"], f"h-{uuid4().hex}"
+                )
+                await conn.execute("UPDATE memories SET deleted_at = now() WHERE id = $1", mem)
+                with pytest.raises(ReferenceTargetNotFoundError) as exc:
+                    await resolve_reference_target(
+                        conn, target_uuid=mem, caller_user_id=s["tenant"]
+                    )
+                assert "not found or not accessible" in str(exc.value)
+                # Identical to a totally nonexistent UUID.
+                err_other = None
+                try:
+                    await resolve_reference_target(
+                        conn, target_uuid=uuid4(), caller_user_id=s["tenant"]
+                    )
+                except ReferenceTargetNotFoundError as e:
+                    err_other = str(e)
+                assert str(exc.value) == err_other
+
+    async def test_nonexistent_memory_not_readable(self, pg_pool: Any) -> None:
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
