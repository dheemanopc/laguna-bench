+"""Integration regression tests for the memory_references access fix.
+
+Covers the Tool/SDK-level behaviour that the unit tests in
+`tests/unit/test_references_own_memory.py` can't:
+  - `memsys_refs_in` / `memsys_refs_out` tools filter by the unified
+    `memory_readable_by` predicate (own citer/target shown; foreign collapsed
+    into `inaccessible_count`), including for raw-SQL-provisioned owners with
+    NO `user_effective_team_access` rows.
+  - Write path: referencing another tenant's memory is rejected with the
+    opaque `memory_not_accessible` envelope, IDENTICAL to referencing a random
+    nonexistent UUID (IT-08), and no memory row is created for the rejected
+    write.
+  - Write path: granting tenant B a UEA row on tenant A's team lets B cite A.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.refs_in import RefsInInput, RefsInOutput, RefsInTool
+from mem_mcp.mcp.tools.refs_out import RefsOutInput, RefsOutOutput, RefsOutTool
+from mem_mcp.mcp.tools.write import ReferenceInput
+from mem_mcp.plugins.contract import PluginValidationError
+from mem_mcp.teams.assignments import assign_role
+from mem_mcp.teams.references import insert_reference
+
+pytestmark = pytest.mark.asyncio
+
+
+OWNER_ROLE_KEY = "owner"
+PLUGIN_CLIENT_ID = "plugin:repro-own-ref"
+
+
+def _mem_sql() -> str:
+    return (
+        "INSERT INTO memories (tenant_id, team_id, content, content_hash, "
+        "embedding, source_kind, type, visibility) "
+        "VALUES ($1, $2, 'c', $3, array_fill(0::real, ARRAY[1024])::vector, "
+        "'api', 'decision', 'team') RETURNING id"
+    )
+
+
+def _stub_deps() -> ToolDeps:
+    from mem_mcp.audit.logger import NoopAuditLogger
+    from mem_mcp.embeddings.bedrock import EmbedResult
+
+    class _StubEmbed:
+        async def embed(self, content: str) -> Any:
+            return EmbedResult(vector=[0.0] * 1024, input_tokens=max(1, len(content) // 4))
+
+    return ToolDeps(embeddings=_StubEmbed(), audit=NoopAuditLogger(), quotas=NoopQuotas())
+
+
+def _ctx(tenant_id: UUID, pool: Any, scopes: frozenset[str] | None = None) -> ToolContext:
+    return ToolContext(
+        request_id=str(uuid4()),
+        tenant_id=tenant_id,
+        identity_id=tenant_id,
+        client_id="client-1",
+        scopes=scopes or frozenset(["memory.read"]),
+        db_pool=pool,
+        deps=_stub_deps(),
+    )
+
+
+async def _provision_raw_user(conn: Any, email_local: str) -> dict[str, UUID]:
+    """Raw-SQL provisioned account (no Python UEA sync) — the raw-SQL-provisioned profile.
+
+    tenant + personal team + owner row in team_role_assignments + primary
+    identity (default_team_id set) + the plugin oauth_clients row. Deliberately
+    does NOT call assign_role/refresh, so NO user_effective_team_access row
+    exists for the owner's own personal team.
+    """
+    tenant = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"{email_local}-{uuid4()}@example.test",
+    )
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id, team_type) VALUES ($1, $2, 'personal') RETURNING id",
+        f"{email_local}-{uuid4().hex[:8]}",
+        tenant,
+    )
+    owner_role_id = await conn.fetchval(
+        "SELECT id FROM roles_catalog WHERE role_key = $1 AND plugin_id IS NULL",
+        OWNER_ROLE_KEY,
+    )
+    await conn.execute(
+        "INSERT INTO team_role_assignments "
+        "(parent_team_id, member_kind, member_id, role_id, status, assigned_by_user_id) "
+        "VALUES ($1, 'user', $2, $3, 'active', $2)",
+        team,
+        tenant,
+        owner_role_id,
+    )
+    await conn.execute(
+        "INSERT INTO tenant_identities (tenant_id, cognito_sub, provider, email, "
+        "is_primary, default_team_id) VALUES ($1, $2, 'cognito', $3, true, $4)",
+        tenant,
+        f"sub-{email_local}-{tenant}",
+        f"{email_local}-{tenant}@example.test",
+        team,
+    )
+    # Plugin client row so SDK writes (source_client_id FK) succeed.
+    await conn.execute(
+        "INSERT INTO oauth_clients (id, redirect_uris, scope, registration_payload, review_status) "
+        "VALUES ($1, ARRAY[]::text[], 'memory.read memory.write', '{}'::jsonb, 'auto_allowed') "
+        "ON CONFLICT (id) DO NOTHING",
+        PLUGIN_CLIENT_ID,
+    )
+    # Precondition of the bug: no UEA row for the owner's own personal team.
+    has_uea = await conn.fetchval(
+        "SELECT 1 FROM user_effective_team_access WHERE user_id = $1 AND resource_team_id = $2",
+        tenant,
+        team,
+    )
+    assert has_uea is None
+    return {"tenant": tenant, "team": team}
+
+
+async def _cleanup_tenants(pool: Any, tenant_ids: list[UUID]) -> None:
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            tids = tenant_ids
+            await conn.execute(
+                "DELETE FROM memory_references WHERE source_memory_id IN "
+                "(SELECT id FROM memories WHERE tenant_id = ANY($1::uuid[])) "
+                "OR target_memory_id IN (SELECT id FROM memories WHERE tenant_id = ANY($1::uuid[]))",
+                tids,
+            )
+            await conn.execute(
+                "DELETE FROM slugs WHERE team_id IN "
+                "(SELECT id FROM teams WHERE created_by_tenant_id = ANY($1::uuid[]))",
+                tids,
+            )
+            await conn.execute("DELETE FROM memories WHERE tenant_id = ANY($1::uuid[])", tids)
+            await conn.execute(
+                "DELETE FROM team_role_assignments WHERE parent_team_id IN "
+                "(SELECT id FROM teams WHERE created_by_tenant_id = ANY($1::uuid[]))",
+                tids,
+            )
+            await conn.execute(
+                "DELETE FROM user_effective_team_access WHERE user_id = ANY($1::uuid[])", tids
+            )
+            await conn.execute(
+                "DELETE FROM tenant_identities WHERE tenant_id = ANY($1::uuid[])", tids
+            )
+            await conn.execute(
+                "DELETE FROM teams WHERE created_by_tenant_id = ANY($1::uuid[])", tids
+            )
+            await conn.execute("DELETE FROM tenants WHERE id = ANY($1::uuid[])", tids)
+
+
+async def _mk_mem(conn: Any, tenant: UUID, team: UUID) -> UUID:
+    mem_id = await conn.fetchval(_mem_sql(), tenant, team, f"h-{uuid4().hex}")
+    assert isinstance(mem_id, UUID)
+    return mem_id
+
+
+async def _count_memories(pool: Any, tenant: UUID) -> int:
+    async with pool.acquire() as conn:
+        count = await conn.fetchval("SELECT count(*) FROM memories WHERE tenant_id = $1", tenant)
+        assert isinstance(count, int)
+        return count
+
