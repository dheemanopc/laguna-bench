@@ -0,0 +1,101 @@
+"""Add memory_readable_by() — unified read-access predicate for the references graph.
+
+Bug: `memory_not_accessible` when a user references their OWN memory for an
+account provisioned via raw SQL (the 0026 personal-team backfill pattern).
+
+Root cause: the write-time / references access checks consulted ONLY the
+materialised view-table `user_effective_team_access` (UEA). UEA is populated by
+Python code paths (teams/effective_access.py sync refresh + the periodic
+jobs/refresh_team_access.py reconciler). Accounts provisioned by raw SQL (tenant
++ personal team + owner row in team_role_assignments + primary identity) have NO
+UEA row for their own personal team, so the check rejected a user citing their
+OWN memory — even though `memory_get` by id (tenant_tx / RLS: `tenant_id =
+caller`) happily returns it. The read path (`memory_get`) and the write/reference
+path disagreed on what "can read" means.
+
+This function is the single source of truth used by all four reference sites. It
+is a *pure access* predicate — it does NOT filter on `deleted_at`: soft-deletion
+is a separate concern handled at the query layer (e.g. `resolve_reference_target`
+excludes deleted targets in its own lookup query). Filtering deleted rows inside
+the predicate would make the caller's own soft-deleted citers look "inaccessible",
+regressing the access-only semantics that existed before:
+
+    memory M is readable by user U  iff  M exists AND (
+        M.tenant_id = U                                                    -- own memory
+        OR ( M.team_id IS NOT NULL
+             AND EXISTS (SELECT 1 FROM user_effective_team_access
+                         WHERE user_id = U AND resource_team_id = M.team_id) -- share
+        )
+    )
+
+A NULL user always yields FALSE (defensive; all real callers pass a UUID).
+A NULL team_id memory is readable only by its owning tenant (no team to share
+through).
+
+SECURITY DEFINER is required: callers run this under system_tx (no tenant GUC),
+and under a mem_app connection the memories RLS policy (tenant_id =
+safe_current_tenant_id()) would otherwise hide every row because no GUC is set.
+The function owner is the migration role (mem_maint in prod, mem_test in CI);
+mem_maint carries BYPASSRLS, so the SECURITY DEFINER switch lets mem_app read
+memories across tenants and implement the access rule in SQL itself.
+
+Revision ID: 0035_memory_readable_by
+Revises: 0034_safe_current_tenant_id
+Create Date: 2026-10-15
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0035_memory_readable_by"
+down_revision = "0034_safe_current_tenant_id"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    # STABLE: the result depends only on row data (not the GUC), so it can sit
+    # in a larger expression. SECURITY DEFINER so mem_app connections — which run
+    # this under system_tx without a tenant GUC — can read `memories` past its
+    # tenant_id RLS policy and apply the rule in SQL. SET search_path=public
+    # guards against a caller's search_path shadowing our table names.
+    op.execute(
+        sa.text("""
+CREATE OR REPLACE FUNCTION memory_readable_by(p_memory_id UUID, p_user_id UUID)
+RETURNS BOOLEAN
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = public
+AS $$
+    SELECT CASE
+        WHEN p_user_id IS NULL THEN FALSE
+        ELSE EXISTS (
+            SELECT 1 FROM memories m
+            WHERE m.id = p_memory_id
+              AND (
+                  m.tenant_id = p_user_id
+                  OR (
+                      m.team_id IS NOT NULL
+                      AND EXISTS (
+                          SELECT 1 FROM user_effective_team_access uea
+                          WHERE uea.user_id = p_user_id
+                            AND uea.resource_team_id = m.team_id
+                      )
+                  )
+              )
+        )
+    END
+$$;
+        """)
+    )
+    # mem_app is the only role that needs to call this directly (from the
+    # references helpers). Mirrors 0016's grant style for SECURITY DEFINER fns.
+    op.execute(sa.text("GRANT EXECUTE ON FUNCTION memory_readable_by(uuid, uuid) TO mem_app"))
+
+
+def downgrade() -> None:
+    op.execute(sa.text("DROP FUNCTION IF EXISTS memory_readable_by(uuid, uuid) CASCADE"))
