+
+    async def test_foreign_target_only_counted(self, pg_pool: Any) -> None:
+        """Edge from M2 (own) to a foreign memory (no access) → only counted."""
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                a = await _provision_raw_user(conn, "refs-out-f")
+                b = await _provision_raw_user(conn, "refs-out-fb")
+                m2 = await _mk_mem(conn, a["tenant"], a["team"])
+                foreign = await _mk_mem(conn, b["tenant"], b["team"])
+            async with pg_pool.acquire() as conn2:
+                # M2 → own target (accessible) and M2 → foreign target (not).
+                own_target = await _mk_mem(conn2, a["tenant"], a["team"])
+                await insert_reference(
+                    conn2,
+                    source_memory_id=m2,
+                    target_memory_id=own_target,
+                    target_team_id=a["team"],
+                    reference_kind="cites",
+                )
+                await insert_reference(
+                    conn2,
+                    source_memory_id=m2,
+                    target_memory_id=foreign,
+                    target_team_id=b["team"],
+                    reference_kind="cites",
+                )
+            try:
+                ctx = _ctx(a["tenant"], pg_pool)
+                out = await RefsOutTool()(ctx, RefsOutInput(memory_id=m2))
+                assert isinstance(out, RefsOutOutput)
+                assert out.accessible_count == 1
+                assert out.inaccessible_count == 1
+                assert out.refs[0].target_memory_id == str(own_target)
+                assert foreign not in {UUID(r.target_memory_id) for r in out.refs}
+            finally:
+                await _cleanup_tenants(pg_pool, [a["tenant"], b["tenant"]])
+
