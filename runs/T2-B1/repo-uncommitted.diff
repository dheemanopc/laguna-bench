+class TestRefsOutTool:
+    async def test_own_target_accessible_raw_sql_owner(self, pg_pool: Any) -> None:
+        """Raw-SQL owner's own M2 → own M1 edge is accessible."""
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
