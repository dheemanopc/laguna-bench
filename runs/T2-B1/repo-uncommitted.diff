+async def can_read_memory(
+    conn: asyncpg.Connection,
+    *,
+    memory_id: UUID,
+    user_id: UUID,
+) -> bool:
+    """Single source of truth for "can `user_id` read `memory_id` (references)?".
+
+    Delegates to the SQL function `memory_readable_by` (migration 0035) so the
+    rule is identical everywhere it is applied. NULL ``user_id`` yields FALSE.
+    Queries `memories` + `user_effective_team_access`; the SECURITY DEFINER
+    switch lets it see `memories` past RLS even when called under system_tx
+    (no tenant GUC) — which is exactly the cross-tenant context all callers
+    here run in.
+    """
+    readable = await conn.fetchval(
+        "SELECT memory_readable_by($1, $2)",
+        memory_id,
+        user_id,
+    )
+    return bool(readable)
+
+
+async def can_read_memory_bulk(
+    conn: asyncpg.Connection,
+    *,
+    memory_ids: list[UUID],
+    user_id: UUID,
+) -> set[UUID]:
+    """Return the subset of ``memory_ids`` that ``user_id`` can read.
+
+    One round-trip for an arbitrary list — used by the graph tools
+    (`memsys_refs_in` / `memsys_refs_out`) and the filtered-citer check.
+    Empty list → empty set (keeps the single-SELECT batch shape).
+    """
+    if not memory_ids:
+        return set()
+    rows = await conn.fetch(
+        """
+        SELECT v.memory_id
+        FROM unnest($1::uuid[]) AS v(memory_id)
+        WHERE memory_readable_by(v.memory_id, $2)
+        """,
+        memory_ids,
+        user_id,
+    )
+    return {r["memory_id"] for r in rows}
