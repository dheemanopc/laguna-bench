+    assert s.to_stage == "done"
+    assert s.proposer_tenant_id == tenant_a
+    assert s.reason == "finishing up"
+    assert s.signoff_min == 2
+    assert s.signatory_count == 0
+    assert s.remaining == 2
+    assert s.role_restricted is False
