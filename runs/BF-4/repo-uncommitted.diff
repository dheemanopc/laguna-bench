+# ------------------------------------------------------------------------- #
+# Spec helpers                                                              #
+# ------------------------------------------------------------------------- #
+
+
+def _signoff_stages() -> list[StageSpec]:
+    """Stages matching the legacy WORK_STATUSES subset used in tests."""
+    return [
+        StageSpec(name="todo", ordinal=0, is_initial=True),
+        StageSpec(name="in_progress", ordinal=1),
+        StageSpec(name="blocked", ordinal=2),
+        StageSpec(name="done", ordinal=3, is_terminal=True),
+    ]
+
+
+def _signoff_transitions() -> list[TransitionSpec]:
+    """Transitions with signoff on in_progress->done (min=2, any role)."""
+    return [
+        TransitionSpec(from_stage=None, to_stage="todo"),
+        TransitionSpec(from_stage="todo", to_stage="in_progress"),
+        TransitionSpec(
+            from_stage="in_progress",
+            to_stage="done",
+            requires_signoff=True,
+            signoff_min=2,
+        ),
+        TransitionSpec(
+            from_stage="in_progress",
+            to_stage="blocked",
+            requires_reason=True,
+        ),
+    ]
+
+
+def _restricted_signoff_transitions() -> list[TransitionSpec]:
+    """Like _signoff_transitions but in_progress->done requires admin signoff."""
+    return [
+        TransitionSpec(from_stage=None, to_stage="todo"),
+        TransitionSpec(from_stage="todo", to_stage="in_progress"),
+        TransitionSpec(
+            from_stage="in_progress",
+            to_stage="done",
+            requires_signoff=True,
+            signoff_min=1,
+            signoff_roles=("admin",),
+        ),
+        TransitionSpec(
+            from_stage="in_progress",
+            to_stage="blocked",
+            requires_reason=True,
+        ),
+    ]
+
+
+async def _setup_workflow(
+    conn: Any,
+    tenant_id: UUID,
+    team_id: UUID,
+    stages: list[StageSpec],
+    transitions: list[TransitionSpec],
+    name: str,
+    activate: bool = True,
+) -> UUID:
+    """Create a team workflow, optionally activate it. Returns workflow_id."""
+    from mem_mcp.mindmap.workflow_crud import activate_workflow
+
+    wf = await create_team_workflow(
+        conn,
+        tenant_id=tenant_id,
+        team_id=team_id,
+        name=name,
+        stages=stages,
+        transitions=transitions,
+        created_by=tenant_id,
+    )
+    if activate:
+        await activate_workflow(
+            conn,
+            tenant_id=tenant_id,
+            team_id=team_id,
+            workflow_id=wf.workflow_id,
+            actor_tenant_id=tenant_id,
+        )
+    return wf.workflow_id
+
+
+async def _setup_work_item(
+    conn: Any,
+    tenant_id: UUID,
+    team_id: UUID,
+    root_mem_id: UUID,
+    node_id: UUID,
+    map_key: str,
+    kind: str = "story",
+    assignee_id: UUID | None = None,
+    set_workflow_id: UUID | None = None,
+    set_current_stage: str | None = None,
+) -> work_items.WorkItem:
+    """Create a work item via mark_work_item, optionally tagging workflow_id
+    and/or current_stage directly on the row."""
+    from mem_mcp.teams.assignments import assign_role
+
+    item = await work_items.mark_work_item(
+        conn,
+        tenant_id=tenant_id,
+        team_id=team_id,
+        map_key=map_key,
+        node_id=node_id,
+        kind=kind,
+        assignee_id=assignee_id,
+    )
+    if set_workflow_id is not None or set_current_stage is not None:
+        await conn.execute(
+            """
+            UPDATE work_items
+            SET workflow_id = $1, current_stage = $2
+            WHERE memory_id = $3 AND tenant_id = $4 AND team_id = $5
+            """,
+            set_workflow_id,
+            set_current_stage,
+            node_id,
+            tenant_id,
+            team_id,
+        )
+        # Re-read so the returned item reflects the updated columns.
+        item = await work_items.get_work_item(
+            conn,
+            tenant_id=tenant_id,
+            team_id=team_id,
+            map_key=map_key,
+            node_id=node_id,
+        )
+    return item
+
+
+async def _setup_signoff_item(
+    conn: Any,
+    *,
+    tenant_id: UUID,
+    team_id: UUID,
+    root_mem_id: UUID,
+    node_id: UUID,
+    map_key: str,
+    transitions: list[TransitionSpec] | None = None,
+    current_stage: str = "in_progress",
+    assignee_id: UUID | None = None,
+) -> UUID:
+    """Create a workflow + work item at ``current_stage`` via the active workflow.
+
+    Returns the workflow_id. The item resolves its workflow through the team's
+    active workflow (workflow_id NULL on the row → _resolve_workflow picks it up).
+    """
+    wf_id = await _setup_workflow(
+        conn, tenant_id, team_id,
+        _signoff_stages(),
+        transitions or _signoff_transitions(),
+        f"ReadWf-{uuid4().hex[:6]}",
+        activate=True,
+    )
+    await _setup_work_item(
+        conn, tenant_id, team_id, root_mem_id, node_id, map_key,
+        assignee_id=assignee_id,
+        set_current_stage=current_stage,
+    )
+    return wf_id
