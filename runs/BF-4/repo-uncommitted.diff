+    assert by_stage["done"].signatory_count == 0
+    assert by_stage["done"].remaining == 2
+    assert by_stage["done"].signoff_min == 2
+
+    # in_progress -> todo: no transition rule → no_transition.
+    assert by_stage["todo"].blocked_reason == "no_transition"
