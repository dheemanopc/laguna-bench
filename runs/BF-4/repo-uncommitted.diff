+async def test_moves_direct_commit_available(
+    pg_pool: Any,
+    tenant_a: UUID,
+    team_a: UUID,
+    map_setup: tuple[UUID, UUID, str],
+) -> None:
+    """A no-signoff transition (todo->in_progress) is open for the owner too."""
+    root_mem_id, node_id, map_key = map_setup
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        await _setup_signoff_item(
+            conn, tenant_id=tenant_a, team_id=team_a,
+            root_mem_id=root_mem_id, node_id=node_id, map_key=map_key,
+            current_stage="todo",
+        )
+        moves = await workflow_reads.compute_item_moves(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            map_key=map_key,
+            node_id=node_id,
+            viewing_tenant_id=tenant_a,
+        )
+    ip_move = next(m for m in moves if m.to_stage == "in_progress")
+    assert ip_move.blocked_reason is None
+    assert ip_move.transition_id is not None
+    assert ip_move.request_id is None
+    assert ip_move.signoff_min == 0
+    assert ip_move.remaining == 0
+    # Not a signoff-required move, so even the owner isn't "eligible to sign".
+    assert ip_move.eligible_to_sign is False
