+"""DB-backed tests for the workflow read-only module (WP1-T4).
+
+Covers ``compute_item_moves`` and ``list_pending_signoffs_for_user``:
+blocked-reason matrix, pending sign-off state, per-viewer eligibility
+(owner/proposer exclusion + ``signoff_roles``), and the pending-signoffs
+for-user list with the same exclusion rules.
+
+Mirrors the fixture style of ``test_workflow_moves.py``.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.db import tenant_tx
+from mem_mcp.mindmap import work_items, workflow_reads
+from mem_mcp.mindmap.workflow_crud import (
+    StageSpec,
+    TransitionSpec,
+    create_team_workflow,
+)
+from mem_mcp.mindmap.workflow_moves import propose_move, sign_workflow_move
+from mem_mcp.teams.assignments import assign_role
+from mem_mcp.mindmap.workflow_errors import WorkItemMapNotFoundError
+
+pytestmark = pytest.mark.asyncio
+
+
+# ------------------------------------------------------------------------- #
+# Fixtures                                                                  #
+# ------------------------------------------------------------------------- #
+
+
<email>
+async def tenant_a(pg_pool: Any) -> UUID:
+    """Team owner."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            tid = await conn.fetchval(
+                "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                f"tenant-a-{uuid4()}@example.test",
+            )
+            return UUID(str(tid))
+
+
<email>
+async def team_a(pg_pool: Any, tenant_a: UUID) -> UUID:
+    """Team owned by tenant_a."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            tid = await conn.fetchval(
+                "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+                f"team-a-{uuid4().hex[:8]}",
+                tenant_a,
+            )
+            await assign_role(
+                conn,
+                parent_team_id=tid,
+                member_kind="user",
+                member_id=tenant_a,
+                role_key="owner",
+                assigned_by_user_id=tenant_a,
+            )
+            return UUID(str(tid))
+
+
<email>
+async def member1(pg_pool: Any, team_a: UUID) -> UUID:
+    """First member tenant (member role)."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            tid = await conn.fetchval(
+                "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                f"member1-{uuid4()}@example.test",
+            )
+            await assign_role(
+                conn,
+                parent_team_id=team_a,
+                member_kind="user",
+                member_id=tid,
+                role_key="member",
+                assigned_by_user_id=tid,
+            )
+            return UUID(str(tid))
+
+
<email>
+async def member2(pg_pool: Any, team_a: UUID) -> UUID:
+    """Second member tenant (member role)."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            tid = await conn.fetchval(
+                "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                f"member2-{uuid4()}@example.test",
+            )
+            await assign_role(
+                conn,
+                member_kind="user",
+                member_id=tid,
+                parent_team_id=team_a,
+                role_key="member",
+                assigned_by_user_id=tid,
+            )
+            return UUID(str(tid))
+
+
<email>
+async def admin_tenant(pg_pool: Any, team_a: UUID) -> UUID:
+    """Admin tenant on team_a."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            tid = await conn.fetchval(
+                "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                f"admin-{uuid4()}@example.test",
