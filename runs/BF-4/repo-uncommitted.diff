+async def test_moves_at_todo_stages(
+    pg_pool: Any,
+    tenant_a: UUID,
+    team_a: UUID,
+    map_setup: tuple[UUID, UUID, str],
+) -> None:
+    """Item at 'todo': todo->in_progress is open, others are no_transition."""
+    root_mem_id, node_id, map_key = map_setup
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        await _setup_signoff_item(
+            conn, tenant_id=tenant_a, team_id=team_a,
+            root_mem_id=root_mem_id, node_id=node_id, map_key=map_key,
+            current_stage="todo",
+        )
+        moves = await workflow_reads.compute_item_moves(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            map_key=map_key,
+            node_id=node_id,
+            viewing_tenant_id=tenant_a,
+        )
+    by_stage = {m.to_stage: m for m in moves}
+    assert "todo" not in by_stage  # current stage excluded
+
+    # todo -> in_progress: no signoff, no reason → open.
+    assert by_stage["in_progress"].blocked_reason is None
+    assert by_stage["in_progress"].transition_id is not None
+    assert by_stage["in_progress"].request_id is None
+    assert by_stage["in_progress"].signoff_min == 0
+    assert by_stage["in_progress"].eligible_to_sign is False  # not a signoff move
+
+    # todo -> blocked: no transition rule → no_transition.
+    assert by_stage["blocked"].blocked_reason == "no_transition"
+    assert by_stage["blocked"].transition_id is None
+
+    # todo -> done: no transition rule → no_transition.
+    assert by_stage["done"].blocked_reason == "no_transition"
+    assert by_stage["done"].transition_id is None
+
