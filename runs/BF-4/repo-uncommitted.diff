@@ -0,0 +1,519 @@
+"""Team-workflow read-only queries: per-item allowed moves + pending sign-offs.
+
+Owns the *read* side of the workflow rule set: given a work item on a team
+workflow, compute the set of candidate destination stages together with the
+reason each one is (or is not) available right now, and surface the pending
+sign-off requests a given tenant can sign.
+
+Takes an ``asyncpg.Connection`` from ``tenant_tx``; never imports FastAPI or
+``JsonRpcError``. All SQL carries an explicit ``tenant_id = $n`` predicate in
+addition to RLS, matching the 0046/0048 convention.
+
+``tenant_id`` is the data / RLS scope (the tenant under whose data the item
+lives); ``viewing_tenant_id`` / ``signatory_tenant_id`` is the tenant whose
+sign-off eligibility we are computing — they differ when a team member views
+another member's item, and are equal in the common single-tenant case. This
+module reads the same tables ``workflow_moves.propose_move`` writes and reuses
+``work_items._resolve_workflow`` / ``work_items._load_map`` so the read path
+resolves a work item's governing workflow exactly as the write path does
+(custom ``workflow_id`` -> team active workflow -> lazily-materialised
+``_legacy`` workflow, the latter idempotent under concurrency).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any
+from uuid import UUID
+
+from mem_mcp.auth.rbac import get_team_role
+from mem_mcp.mindmap import work_items
+
+# A move is "awaiting N sign-offs" once a proposal exists but has not gathered
+# enough distinct eligible signatories. N is the number still required.
+
+
+# ------------------------------------------------------------------------- #
+# Dataclasses                                                               #
+# ------------------------------------------------------------------------- #
+
+
+@dataclass(frozen=True)
+class AllowedMove:
+    """A candidate destination stage for a work item and its current state.
+
+    ``blocked_reason`` is one of:
+
+    * ``None``               — the move can be committed immediately.
+    * ``"reason_required"``  — the transition needs a reason before it commits.
+    * ``"awaiting N sign-offs"`` — a sign-off-gated move still needs N signatures
+      (``request_id`` is ``None`` when the proposal has not been created yet).
+    * ``"role_restricted"``  — the transition restricts sign-off to specific
+      roles and the viewer is not in any of them, so they cannot sign.
+    * ``"no_transition"``    — no rule allows a move from the current stage to
+      ``to_stage``.
+
+    ``signoff_min`` is ``0`` for non-signoff / ``no_transition`` moves and the
+    transition's configured minimum otherwise; ``remaining`` is
+    ``signoff_min - signatory_count`` (clamped at 0) for signoff moves and ``0``
+    otherwise. ``eligible_to_sign`` is viewer-specific: it is ``True`` only when
+    the viewer is a team member, is neither the item's owner (assignee) nor the
+    request's proposer, and (if the transition restricts roles) holds one of the
+    allowed roles.
+    """
+
+    to_stage: str
+    transition_id: UUID | None
+    blocked_reason: str | None
+    request_id: UUID | None
+    signatory_count: int
+    signoff_min: int
+    remaining: int
+    eligible_to_sign: bool
+
+
+@dataclass(frozen=True)
+class PendingSignoff:
+    """A pending sign-off request the calling tenant is eligible to sign.
+
+    ``role_restricted`` is ``True`` when the move's transition pins sign-off to a
+    set of roles (``signoff_roles`` non-empty) — a display hint, not a statement
+    about the caller: only requests the caller *can* sign are returned, so when
+    ``role_restricted`` is ``True`` the caller's role is among the allowed set.
+    """
+
+    request_id: UUID
+    memory_id: UUID
+    from_stage: str
+    to_stage: str
+    proposer_tenant_id: UUID
+    reason: str | None
+    signoff_min: int
+    signatory_count: int
+    remaining: int
+    role_restricted: bool
+
+
+# ------------------------------------------------------------------------- #
+# Internal helpers                                                          #
+# ------------------------------------------------------------------------- #
+
+
+async def _load_stage_names(conn: Any, tenant_id: UUID, workflow_id: UUID) -> list[str]:
+    """Ordered stage names for a workflow (candidates for ``to_stage``)."""
+    rows = await conn.fetch(
+        """
+        SELECT name
+        FROM workflow_stages
+        WHERE tenant_id = $1 AND workflow_id = $2
+        ORDER BY ordinal ASC, name ASC
+        """,
+        tenant_id,
+        workflow_id,
+    )
+    return [str(r["name"]) for r in rows]
+
+
+async def _load_transitions(conn: Any, tenant_id: UUID, workflow_id: UUID) -> list[dict[str, Any]]:
+    """Transition rules for a workflow as plain dicts.
+
+    Includes ``transition_id`` (which the shared ``workflow_crud`` loader omits)
+    and resolves stage *names* rather than ids; ``from_stage`` is ``None`` for
+    the "any entry" rule (``from_stage_id IS NULL``).
+    """
+    rows = await conn.fetch(
+        """
+        SELECT wt.transition_id,
+               wt.requires_reason,
+               wt.requires_signoff,
+               wt.signoff_min,
+               wt.signoff_roles,
+               wt.allowed_kinds,
+               ts.name  AS to_stage,
+               fs.name  AS from_stage
+        FROM workflow_transitions wt
+        JOIN workflow_stages ts ON ts.stage_id = wt.to_stage_id
+        LEFT JOIN workflow_stages fs ON fs.stage_id = wt.from_stage_id
+        WHERE wt.tenant_id = $1 AND wt.workflow_id = $2
+        ORDER BY wt.transition_id ASC
+        """,
+        tenant_id,
+        workflow_id,
+    )
+    transitions: list[dict[str, Any]] = []
+    for r in rows:
+        transitions.append(
+            {
+                "transition_id": UUID(str(r["transition_id"])),
+                "to_stage": str(r["to_stage"]),
+                "from_stage": str(r["from_stage"]) if r["from_stage"] is not None else None,
+                "requires_reason": bool(r["requires_reason"]),
+                "requires_signoff": bool(r["requires_signoff"]),
+                "signoff_min": int(r["signoff_min"]),
+                "signoff_roles": list(r["signoff_roles"]) if r["signoff_roles"] else None,
+                "allowed_kinds": list(r["allowed_kinds"]) if r["allowed_kinds"] else None,
+            }
+        )
+    return transitions
+
+
+def _match_transition(
+    transitions: list[dict[str, Any]], from_stage: str, to_stage: str
+) -> dict[str, Any] | None:
+    """Find the transition applicable to ``(from_stage, to_stage)``.
+
+    A specific ``from_stage`` rule wins over an "any entry" (``from_stage IS
+    NULL``) rule, matching :func:`workflow_moves._find_transition`.
+    """
+    for t in transitions:
+        if t["to_stage"] == to_stage and t["from_stage"] == from_stage:
+            return t
+    for t in transitions:
+        if t["to_stage"] == to_stage and t["from_stage"] is None:
+            return t
+    return None
+
+
+def _signoff_eligibility(
+    *,
+    viewer_role: str | None,
+    assignee_id: UUID | None,
+    proposer: UUID | None,
+    signoff_roles: list[str] | None,
+    viewer_tenant_id: UUID,
+) -> tuple[bool, bool]:
+    """Compute viewer sign-off eligibility for a request.
+
+    Returns ``(eligible_to_sign, role_restricted)``. ``role_restricted`` is True
+    when the transition restricts sign-off to certain roles and the viewer's role
+    is absent from them; owner/proposer exclusion never counts as a role
+    restriction — it is reflected only in ``eligible_to_sign``.
+    """
+    role_restricted = bool(signoff_roles) and (
+        viewer_role is None or viewer_role not in signoff_roles
+    )
+    owner_excluded = assignee_id is not None and viewer_tenant_id == assignee_id
+    proposer_excluded = proposer is not None and viewer_tenant_id == proposer
+    eligible = (
+        viewer_role is not None
+        and not role_restricted
+        and not owner_excluded
+        and not proposer_excluded
+    )
+    return eligible, role_restricted
+
+
+async def _signoff_counts_batch(
+    conn: Any, tenant_id: UUID, request_ids: list[UUID]
+) -> dict[UUID, int]:
+    """Map request_id -> distinct signatory count, for the given requests."""
+    if not request_ids:
+        return {}
+    rows = await conn.fetch(
+        """
+        SELECT request_id, COUNT(*) AS n
+        FROM workflow_signoffs
+        WHERE tenant_id = $1 AND request_id = ANY($2::uuid[])
+        GROUP BY request_id
+        """,
+        tenant_id,
+        request_ids,
+    )
+    return {UUID(str(r["request_id"])): int(r["n"]) for r in rows}
+
+
+async def _load_pending_requests(
+    conn: Any, tenant_id: UUID, memory_id: UUID
+) -> dict[tuple[str, str], dict[str, Any]]:
+    """Pending sign-off requests for one item, keyed by ``(from_stage, to_stage)``.
+
+    The most recent proposal wins when more than one exists for the same move
+    (rare: a cancelled proposal re-filed); older stale rows are ignored.
+    """
+    rows = await conn.fetch(
+        """
+        SELECT request_id, from_stage, to_stage, proposer_tenant_id
+        FROM workflow_signoff_requests
+        WHERE tenant_id = $1
+          AND work_item_memory_id = $2
+          AND status = 'pending'
+        ORDER BY created_at DESC, request_id DESC
+        """,
+        tenant_id,
+        memory_id,
+    )
+    by_move: dict[tuple[str, str], dict[str, Any]] = {}
+    for r in rows:
+        key = (str(r["from_stage"]), str(r["to_stage"]))
+        if key not in by_move:
+            by_move[key] = {
+                "request_id": UUID(str(r["request_id"])),
+                "proposer": UUID(str(r["proposer_tenant_id"])),
+            }
+    return by_move
+
+
+# ------------------------------------------------------------------------- #
+# compute_item_moves                                                        #
+# ------------------------------------------------------------------------- #
+
+
+async def compute_item_moves(
+    conn: Any,
+    *,
+    tenant_id: UUID,
+    team_id: UUID,
+    map_key: str,
+    node_id: UUID,
+    viewing_tenant_id: UUID,
+) -> list[AllowedMove]:
+    """Compute the candidate destination stages for a work item.
+
+    For every stage of the item's governing workflow other than the item's
+    current stage, returns an :class:`AllowedMove` describing whether the move is
+    available, blocked, or awaits sign-off — with the per-viewer sign-off
+    eligibility baked in so callers can render a single "waiting on me" filter.
+
+    The item's workflow is resolved exactly as the write path does (item's own
+    ``workflow_id``, else the team's active workflow, else the lazily
+    materialised ``_legacy`` workflow). For legacy items (``current_stage``
+    column NULL) the stage is read from ``status``.
+    """
+    # Access control: the viewer must be a team member and the map must exist.
+    root_memory_id, _map_row = await work_items._load_map(
+        conn, viewing_tenant_id, team_id, map_key
+    )
+
+    wi_row = await conn.fetchrow(
+        """
+        SELECT *
+        FROM work_items
+        WHERE memory_id = $1 AND tenant_id = $2 AND team_id = $3 AND root_memory_id = $4
+        """,
+        node_id,
+        tenant_id,
+        team_id,
+        root_memory_id,
+    )
+    if wi_row is None:
+        # Match get_work_item: if the node simply isn't a work item here, tell
+        # the caller which kind of failure it is (cross-map or not-a-work-item).
+        await work_items._check_node_membership(conn, node_id, root_memory_id, tenant_id)
+        raise work_items.NotAWorkItemError()
+
+    # Resolve the governing workflow (lazy _legacy materialisation is idempotent).
+    resolved_workflow_id = await work_items._resolve_workflow(
+        conn,
+        tenant_id=tenant_id,
+        team_id=team_id,
+        workflow_id=wi_row["workflow_id"],
+    )
+
+    current_stage: str = (
+        wi_row["current_stage"]
+        if wi_row["current_stage"] is not None
+        else wi_row["status"]
+    )
+    assignee_id = wi_row["assignee_id"]
+
+    stages = await _load_stage_names(conn, tenant_id, resolved_workflow_id)
+    transitions = await _load_transitions(conn, tenant_id, resolved_workflow_id)
+
+    pending = await _load_pending_requests(conn, tenant_id, node_id)
+    request_ids = [req["request_id"] for req in pending.values()]
+    signoff_counts = await _signoff_counts_batch(conn, tenant_id, request_ids)
+
+    viewer_role = await get_team_role(conn, viewing_tenant_id, team_id)
+
+    moves: list[AllowedMove] = []
+    for to_stage in stages:
+        if to_stage == current_stage:
+            # You cannot move to the stage you are already on.
+            continue
+
+        transition = _match_transition(transitions, current_stage, to_stage)
+        if transition is None:
+            moves.append(
+                AllowedMove(
+                    to_stage=to_stage,
+                    transition_id=None,
+                    blocked_reason="no_transition",
+                    request_id=None,
+                    signatory_count=0,
+                    signoff_min=0,
+                    remaining=0,
+                    eligible_to_sign=False,
+                )
+            )
+            continue
+
+        requires_signoff = transition["requires_signoff"]
+        if requires_signoff:
+            signoff_min = transition["signoff_min"]
+            req = pending.get((current_stage, to_stage))
+            if req is not None:
+                request_id = req["request_id"]
+                proposer = req["proposer"]
+                signatory_count = signoff_counts.get(request_id, 0)
+            else:
+                request_id = None
+                proposer = None
+                signatory_count = 0
+            remaining = max(0, signoff_min - signatory_count)
+
+            eligible, role_restricted = _signoff_eligibility(
+                viewer_role=viewer_role,
+                assignee_id=assignee_id,
+                proposer=proposer,
+                signoff_roles=transition["signoff_roles"],
+                viewer_tenant_id=viewing_tenant_id,
+            )
+
+            if remaining <= 0:
+                # Enough signatories already: the move is ready to commit, there
+                # is nothing for the viewer to sign.
+                blocked_reason: str | None = None
+                eligible = False
+            elif role_restricted:
+                blocked_reason = "role_restricted"
+            else:
+                blocked_reason = f"awaiting {remaining} sign-offs"
+        else:
+            # Not a signoff-gated move: nothing is pending and there is no
+            # signatory state to report.
+            signoff_min = 0
+            request_id = None
+            signatory_count = 0
+            remaining = 0
+            eligible = False
+            blocked_reason = "reason_required" if transition["requires_reason"] else None
+
+        moves.append(
+            AllowedMove(
+                to_stage=to_stage,
+                transition_id=transition["transition_id"],
+                blocked_reason=blocked_reason,
+                request_id=request_id,
+                signatory_count=signatory_count,
+                signoff_min=signoff_min,
+                remaining=remaining,
+                eligible_to_sign=eligible,
+            )
+        )
+
+    return moves
+
+
+# ------------------------------------------------------------------------- #
+# list_pending_signoffs_for_user                                            #
+# ------------------------------------------------------------------------- #
+
+
+async def list_pending_signoffs_for_user(
+    conn: Any,
+    *,
+    tenant_id: UUID,
+    team_id: UUID,
+    signatory_tenant_id: UUID,
+) -> list[PendingSignoff]:
+    """Return the pending sign-off requests the calling tenant can sign.
+
+    A request is returned only when the caller is an eligible signatory: a team
+    member who is neither the item's owner (``work_items.assignee_id``) nor the
+    request's proposer, and — if the transition restricts roles via
+    ``signoff_roles`` — whose role is among the allowed set. Requests whose
+    matching transition no longer exists (the team's workflow was changed after
+    the proposal) are skipped: a sign-off can no longer land on it.
+    """
+    # The caller must be a team member at all. team_role_assignments carries no
+    # tenant_id RLS, so this resolves under the tenant_tx scope (tenant_id).
+    viewer_role = await get_team_role(conn, signatory_tenant_id, team_id)
+    if viewer_role is None:
+        return []
+
+    rows = await conn.fetch(
+        """
+        SELECT r.request_id,
+               r.work_item_memory_id        AS memory_id,
+               r.from_stage,
+               r.to_stage,
+               r.proposer_tenant_id,
+               r.reason,
+               wi.assignee_id               AS assignee_id,
+               wi.workflow_id               AS workflow_id
+        FROM workflow_signoff_requests r
+        JOIN work_items wi
+          ON wi.memory_id = r.work_item_memory_id
+         AND wi.tenant_id = r.tenant_id
+        WHERE r.tenant_id = $1
+          AND wi.team_id = $2
+          AND r.status = 'pending'
+        ORDER BY r.created_at ASC, r.request_id ASC
+        """,
+        tenant_id,
+        team_id,
+    )
+
+    request_ids = [UUID(str(r["request_id"])) for r in rows]
+    signoff_counts = await _signoff_counts_batch(conn, tenant_id, request_ids)
+
+    # Cache workflow resolution + transitions: many requests may share a workflow.
+    wf_cache: dict[UUID | None, UUID] = {}
+    trans_cache: dict[UUID, list[dict[str, Any]]] = {}
+
+    results: list[PendingSignoff] = []
+    for r in rows:
+        request_id = UUID(str(r["request_id"]))
+        item_wf_id = r["workflow_id"]
+
+        if item_wf_id not in wf_cache:
+            resolved = await work_items._resolve_workflow(
+                conn,
+                tenant_id=tenant_id,
+                team_id=team_id,
+                workflow_id=item_wf_id,
+            )
+            wf_cache[item_wf_id] = resolved
+        resolved_wf = wf_cache[item_wf_id]
+
+        if resolved_wf not in trans_cache:
+            trans_cache[resolved_wf] = await _load_transitions(conn, tenant_id, resolved_wf)
+        transition = _match_transition(
+            trans_cache[resolved_wf], str(r["from_stage"]), str(r["to_stage"])
+        )
+        if transition is None:
+            # Workflow changed after the proposal: the move can no longer be
+            # signed on this request. Skip it rather than fabricate a sign-off.
+            continue
+
+        signoff_min = transition["signoff_min"]
+        signatory_count = signoff_counts.get(request_id, 0)
+        remaining = max(0, signoff_min - signatory_count)
+
+        assignee_id = r["assignee_id"]
+        proposer = UUID(str(r["proposer_tenant_id"]))
+        owner_excluded = assignee_id is not None and signatory_tenant_id == assignee_id
+        proposer_excluded = signatory_tenant_id == proposer
+        signoff_roles = transition["signoff_roles"]
+        role_restricted = bool(signoff_roles) and (viewer_role not in (signoff_roles or []))
+        eligible = (
+            not owner_excluded and not proposer_excluded and not role_restricted
+        )
+        if not eligible:
+            continue
+
+        results.append(
+            PendingSignoff(
+                request_id=request_id,
+                memory_id=UUID(str(r["memory_id"])),
+                from_stage=str(r["from_stage"]),
+                to_stage=str(r["to_stage"]),
+                proposer_tenant_id=proposer,
+                reason=r["reason"],
+                signoff_min=signoff_min,
+                signatory_count=signatory_count,
+                remaining=remaining,
+                role_restricted=bool(signoff_roles),
+            )
+        )
+    return results
