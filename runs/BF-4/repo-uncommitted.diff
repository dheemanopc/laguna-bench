+async def test_pending_signoffs_multiple_requests(
+    pg_pool: Any,
+    tenant_a: UUID,
+    team_a: UUID,
+    map_setup: tuple[UUID, UUID, str],
+    member1: UUID,
+) -> None:
+    """Two items, each with a pending signoff → both appear, ordered by creation."""
+    root_mem_id, node_id, map_key = map_setup
+    # Second node for a second work item.
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            node2 = await conn.fetchval(
+                """
+                INSERT INTO memories (tenant_id, team_id, content, content_hash,
+                                     embedding, source_kind, type, visibility)
+                VALUES ($1, $2, 'Second node', $3,
+                        array_fill(0::real, ARRAY[1024])::vector, 'api', 'note', 'team')
+                RETURNING id
+                """,
+                tenant_a,
+                team_a,
+                f"hash-child2-{uuid4().hex}",
+            )
+            await conn.execute(
+                """
+                INSERT INTO memory_map_membership
+                    (memory_id, root_memory_id, tenant_id, node_role, turn, authored_by)
+                VALUES ($1, $2, $3, 'position', 'owner', 'owner')
+                """,
+                node2,
+                root_mem_id,
+                tenant_a,
+            )
+            node2 = UUID(str(node2))
+
+    async with tenant_tx(pg_pool, tenant_a) as conn:
+        await _setup_signoff_item(
+            conn, tenant_id=tenant_a, team_id=team_a,
+            root_mem_id=root_mem_id, node_id=node_id, map_key=map_key,
+            current_stage="in_progress",
+        )
+        await work_items.mark_work_item(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            map_key=map_key,
+            node_id=node2,
+            kind="story",
+        )
+        # Set current_stage for the second item.
+        await conn.execute(
+            "UPDATE work_items SET current_stage = $1 WHERE memory_id = $2",
+            "in_progress",
+            node2,
+        )
+        await propose_move(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            map_key=map_key,
+            node_id=node_id,
+            to_stage="done",
+            reason="first",
+            proposer_tenant_id=tenant_a,
+        )
+        await propose_move(
+            conn,
+            tenant_id=tenant_a,
+            team_id=team_a,
+            map_key=map_key,
+            node_id=node2,
+            to_stage="done",
+            reason="second",
+            proposer_tenant_id=tenant_a,
+        )
+    async with tenant_tx(pg_pool, member1) as conn:
+        signoffs = await workflow_reads.list_pending_signoffs_for_user(
+            conn,
+            tenant_id=member1,
+            team_id=team_a,
+            signatory_tenant_id=member1,
+        )
+    assert len(signoffs) == 2
+    # Ordered by created_at ASC — first proposal first.
+    assert signoffs[0].reason == "first"
+    assert signoffs[1].reason == "second"
+    assert signoffs[0].memory_id == node_id
+    assert signoffs[1].memory_id == node2
