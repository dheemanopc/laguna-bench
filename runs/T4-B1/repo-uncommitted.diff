+async def test_resolve_with_resolving_node(pg_pool: Any) -> None:
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(pg_pool, tenant, client_id)
+    try:
+        opened = await _open_map(ctx, title="Resolve With Resolver")
+        root_id = opened.root_memory_id
+        map_key = opened.map_key
+
+        n1 = await _write_node(ctx, map_key, "Use Redis for hot path", node_role="position")
+        n2 = await _write_node(ctx, map_key, "But Redis adds ops burden", node_role="challenge")
+
+        resolved = await _resolve(
+            ctx,
+            map_key,
+            n2.node_id,
+            disposition="resolved",
+            resolution_summary="Challenge discharged by the TTL plan",
+            resolved_by_memory_id=n1.node_id,
+            resolved_by_party="model",
+        )
+
+        # Output: status, summary, cursor advanced
+        assert resolved.status == "resolved"
+        assert resolved.resolution_summary == "Challenge discharged by the TTL plan"
+        assert resolved.cursor > 0
+
+        # Membership row reflects settlement
+        mem = await _get_member_status(pg_pool, root_id, n2.node_id, tenant)
+        assert mem is not None
+        assert mem["status"] == "resolved"
+        assert mem["resolution_summary"] == "Challenge discharged by the TTL plan"
+        assert mem["resolved_by_party"] == "model"
+        assert mem["resolved_by_memory_id"] == n1.node_id
+        assert mem["resolved_at"] is not None
+
+        # Edge: n1 → n2 with reference_kind='resolves-under'
+        edge = await _get_ref_edge(pg_pool, n1.node_id, n2.node_id, tenant)
+        assert edge is not None
+        assert edge["reference_kind"] == "resolves-under"
+
+        # Event logged — check via direct query (fetch_recent_events needs a
+        # connection, not the pool).
+        async with pg_pool.acquire() as conn:
+            await conn.execute("SELECT set_config('app.current_tenant_id', $1, true)", str(tenant))
+            ev = await conn.fetchrow(
+                "SELECT event, actor, memory_id, payload FROM memory_map_events "
+                "WHERE root_memory_id = $1 AND event = 'resolve' ORDER BY id DESC LIMIT 1",
+                root_id,
+            )
+            assert ev is not None
+            assert ev["memory_id"] == n2.node_id
+            assert ev["actor"] == "model"
+
+    finally:
+        await _cleanup(pg_pool, tenant, team, client_id)
