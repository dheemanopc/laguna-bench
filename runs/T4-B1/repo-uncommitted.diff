+# --------------------------------------------------------------------------- #
+# Test 6: open_loops semantics
+# --------------------------------------------------------------------------- #
+
+
+async def test_open_loops_semantics(pg_pool: Any) -> None:
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(pg_pool, tenant, client_id)
+    try:
+        opened = await _open_map(ctx, title="Open Loops")
+        map_key = opened.map_key
+
+        # owner-node → open loop
+        n_owner = await _write_node(
+            ctx,
+            map_key,
+            "Owner task",
+            node_role="position",
+            responsible_party="owner",
+        )
+        # model-node → open loop
+        n_model = await _write_node(
+            ctx,
+            map_key,
+            "Model task",
+            node_role="position",
+            responsible_party="model",
+        )
+        # no responsible_party → NOT an open loop
+        n_none = await _write_node(
+            ctx,
+            map_key,
+            "Neutral note",
+            node_role="note",
+        )
+
+        got = await _get(ctx, map_key)
+        assert n_owner.node_id in got.open_loops
+        assert n_model.node_id in got.open_loops
+        assert n_none.node_id not in got.open_loops
+
+        # Root should never be in open_loops (no responsible_party on root)
+        assert opened.root_memory_id not in got.open_loops
+
+        # Resolve the owner node → it drops from open_loops
+        await _resolve(ctx, map_key, n_owner.node_id, resolution_summary="done")
+        got2 = await _get(ctx, map_key)
+        assert n_owner.node_id not in got2.open_loops
+        assert n_model.node_id in got2.open_loops
+        assert n_none.node_id not in got2.open_loops
+    finally:
+        await _cleanup(pg_pool, tenant, team, client_id)
