+async def test_since_write_delta(pg_pool: Any) -> None:
+    """get(since=cursor) after a write returns only the new node + bumped cursor."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(pg_pool, tenant, client_id)
+    try:
+        opened = await _open_map(ctx, title="Since Write")
+        map_key = opened.map_key
+
+        got0 = await _get(ctx, map_key)
+        c0 = got0.cursor
+
+        n1 = await _write_node(ctx, map_key, "New delta node", node_role="position")
+
+        got_d = await _get(ctx, map_key, since=c0)
+        assert got_d.cursor > c0
+        node_ids = {n.memory_id for n in got_d.nodes}
+        assert n1.node_id in node_ids
+        # Root was NOT touched since c0 → not in delta nodes
+        assert opened.root_memory_id not in node_ids
+
+        # Subsequent call with the new cursor → empty
+        got_e = await _get(ctx, map_key, since=got_d.cursor)
+        assert got_e.nodes == []
+        assert got_e.cursor == got_d.cursor
+    finally:
+        await _cleanup(pg_pool, tenant, team, client_id)
