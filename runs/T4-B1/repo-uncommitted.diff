+"""mindmap_resolve — settle a single branch (resolve or drop) within a live map.
+
+Per the mind-map build design (docs/mindmap-v1-build-design.md), a map's branches
+are settled individually: closing the whole map (mindmap_close) graduates decisions
+to the KB and archives; resolving a single node closes off one line of thinking
+without retiring the entire map.
+
+Settlement is stored on memory_map_membership.status — the source of truth. A
+plain mindmap_link edge (e.g. resolves-under) never settles a branch; only this
+tool writes status. When a resolving node is named, a typed edge
+(resolves-under / dropped-under) is drawn from that node to the settled node so
+the resolution is attributable and walkable.
+
+No-reopen lifecycle: archived maps are frozen — you cannot resolve into a closed map.
+"""
+
+from __future__ import annotations
+
+from typing import ClassVar, Literal
+from uuid import UUID
+
+from pydantic import BaseModel, ConfigDict, Field
+
+from mem_mcp.db import system_tx, tenant_tx
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tool_descriptions import TOOL_DESCRIPTIONS
+from mem_mcp.mcp.tools._base import BaseTool, ToolContext
+from mem_mcp.mcp.tools._mindmap_common import resolve_team_id
+from mem_mcp.mindmap import DISPOSITION_EDGE_KIND, service
+from mem_mcp.mindmap.service import BranchAlreadySettledError
+from mem_mcp.teams.references import (
+    ReferenceTargetNotFoundError,
+    insert_reference,
+    resolve_reference_target,
+)
+
+_Disposition = Literal["resolved", "dropped"]
+_Party = Literal["owner", "model"]
+
+
+class MindmapResolveInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    map_key: str = Field(..., min_length=1, max_length=64)
+    node_id: UUID
+    disposition: _Disposition = "resolved"
+    resolution_summary: str = Field(..., min_length=1, max_length=500)
+    resolved_by_memory_id: UUID | None = None
+    resolved_by_party: _Party = "model"
+    team_id: UUID | None = None
+
+
+class MindmapResolveOutput(BaseModel):
+    node_id: UUID
+    status: str
+    resolution_summary: str
+    cursor: int
+    request_id: str
+
+
+class MindmapResolveTool(BaseTool):
+    name: ClassVar[str] = "mindmap_resolve"
+    description: ClassVar[str] = TOOL_DESCRIPTIONS["mindmap_resolve"]
+    required_scope: ClassVar[str] = "memory.write"
+    InputModel: ClassVar[type[BaseModel]] = MindmapResolveInput
+    OutputModel: ClassVar[type[BaseModel]] = MindmapResolveOutput
+
+    async def __call__(self, ctx: ToolContext, inp: BaseModel) -> BaseModel:
+        assert isinstance(inp, MindmapResolveInput)
+
+        # --- pre-checks (read-only): resolve team + map, assert map is live ----
+        async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+            team_id = await resolve_team_id(conn, ctx, inp.team_id)
+            root_id = await service.resolve_map_root(conn, team_id=team_id, map_key=inp.map_key)
+            if root_id is None:
+                raise JsonRpcError(-32602, "map not found", data={"errors": [{"path": "map_key"}]})
+            row = await service.get_map_row(conn, root_memory_id=root_id)
+            if row is None or row["state"] != "live":
+                raise JsonRpcError(
+                    -32602,
+                    "map is archived (no-reopen); closed maps do not accept changes",
+                    data={"code": "map_not_live"},
+                )
+
+            # node must be a member of THIS map
+            member = await service.get_member(
+                conn,
+                root_memory_id=root_id,
+                memory_id=inp.node_id,
+                tenant_id=ctx.tenant_id,
+            )
+            if member is None:
+                raise JsonRpcError(
+                    -32602,
+                    "node is not a member of this map",
+                    data={
+                        "errors": [
+                            {
+                                "path": "node_id",
+                                "message": "node is not a member of this map",
+                            }
+                        ]
+                    },
+                )
+
+            # member exists but status != "open" → already settled
+            if member["status"] != "open":
+                raise JsonRpcError(
+                    -32602,
+                    "branch already settled",
+                    data={"code": "branch_already_settled"},
+                )
+
+            # the root node is the map itself; settle it via mindmap_close, not here
+            if member["node_role"] == "root":
+                raise JsonRpcError(
+                    -32602,
+                    "cannot resolve the map root; close the whole map with mindmap_close",
+                    data={"errors": [{"path": "node_id", "message": "node is the map root"}]},
+                )
+
+            # self-resolution: the resolver may not BE the node being resolved
+            if inp.resolved_by_memory_id is not None and inp.resolved_by_memory_id == inp.node_id:
+                raise JsonRpcError(
+                    -32602,
+                    "a node cannot resolve itself",
+                    data={
+                        "errors": [
+                            {
+                                "path": "resolved_by_memory_id",
+                                "message": "cannot resolve itself",
+                            }
+                        ]
+                    },
+                )
+
+        # --- resolve the resolving node + settled node under system_tx ----------
+        # Both reference targets are resolved in a single opaque system_tx so the
+        # access check is consistent and we make one cross-tenant round-trip.
+        resolved_node_team_id: UUID | None = None
+        settled_node_team_id: UUID | None = None
+        if inp.resolved_by_memory_id is not None:
+            async with system_tx(ctx.db_pool) as sys_conn:
+                try:
+                    resolved_by = await resolve_reference_target(
+                        sys_conn,
+                        target_uuid=inp.resolved_by_memory_id,
+                        caller_user_id=ctx.tenant_id,
+                    )
+                except ReferenceTargetNotFoundError as exc:
+                    raise JsonRpcError(
+                        -32602,
+                        "reference target not found or not accessible",
+                        data={"code": "memory_not_accessible"},
+                    ) from exc
+                resolved_node_team_id = resolved_by["team_id"]
+
+                try:
+                    resolved_target = await resolve_reference_target(
+                        sys_conn,
+                        target_uuid=inp.node_id,
+                        caller_user_id=ctx.tenant_id,
+                    )
+                except ReferenceTargetNotFoundError as exc:
+                    # Shouldn't happen — we just fetched it as a member — but
+                    # keep the guarantee opaque and consistent.
+                    raise JsonRpcError(
+                        -32602,
+                        "reference target not found or not accessible",
+                        data={"code": "memory_not_accessible"},
+                    ) from exc
+                settled_node_team_id = resolved_target["team_id"]
+        else:
+            settled_node_team_id = None
+
+        edge_kind = DISPOSITION_EDGE_KIND[inp.disposition]
+
+        # --- one tenant_tx: re-check map live (locked), settle, edge, event ----
+        async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+            # Re-check the map is still live inside the write tx. Locking the map
+            # row prevents a concurrent close from racing between the pre-check
+            # and the settle.
+            locked_state = await service.lock_map_state(
+                conn,
+                root_memory_id=root_id,
+                tenant_id=ctx.tenant_id,
+            )
+            if locked_state is None or locked_state != "live":
+                raise JsonRpcError(
+                    -32602,
+                    "map is archived (no-reopen); closed maps do not accept changes",
+                    data={"code": "map_not_live"},
+                )
+
+            try:
+                await service.settle_branch(
+                    conn,
+                    root_memory_id=root_id,
+                    memory_id=inp.node_id,
+                    tenant_id=ctx.tenant_id,
+                    status=inp.disposition,
+                    resolution_summary=inp.resolution_summary,
+                    resolved_by_memory_id=inp.resolved_by_memory_id,
+                    resolved_by_party=inp.resolved_by_party,
+                )
+            except BranchAlreadySettledError as exc:
+                # Concurrent settle raced between pre-check and write tx — the
+                # branch was already settled by the time the UPDATE's
+                # `status = 'open'` predicate ran.
+                raise JsonRpcError(
+                    -32602,
+                    "branch already settled",
+                    data={"code": "branch_already_settled"},
+                ) from exc
+
+            # If a resolving node was named, draw the typed edge.
+            if inp.resolved_by_memory_id is not None:
+                assert resolved_node_team_id is not None
+                assert settled_node_team_id is not None
+                await insert_reference(
+                    conn,
+                    source_memory_id=inp.resolved_by_memory_id,
+                    target_memory_id=inp.node_id,
+                    target_team_id=settled_node_team_id,
+                    reference_kind=edge_kind,
+                )
+
+            # Log the event; the returned id IS the new cursor.
+            # Event name is the action verb ("resolve"/"drop"), not the disposition
+            # value ("resolved"/"dropped") — matches what touched_since() looks for.
+            event_name = "resolve" if inp.disposition == "resolved" else "drop"
+            event_id = await service.log_event(
+                conn,
+                root_memory_id=root_id,
+                tenant_id=ctx.tenant_id,
+                event=event_name,
+                actor=inp.resolved_by_party,
+                memory_id=inp.node_id,
+                payload={
+                    "disposition": inp.disposition,
+                    "resolved_by_memory_id": (
+                        str(inp.resolved_by_memory_id)
+                        if inp.resolved_by_memory_id is not None
+                        else None
+                    ),
+                    "reference_kind": edge_kind if inp.resolved_by_memory_id is not None else None,
+                    "summary_chars": len(inp.resolution_summary),
+                },
+            )
+
+        return MindmapResolveOutput(
+            node_id=inp.node_id,
+            status=inp.disposition,
+            resolution_summary=inp.resolution_summary,
+            cursor=event_id,
+            request_id=ctx.request_id,
+        )
