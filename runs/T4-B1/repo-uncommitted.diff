+    try:
+        opened = await _open_map(ctx, title="Since Resolve")
+        map_key = opened.map_key
+
+        n1 = await _write_node(ctx, map_key, "To be resolved", node_role="position")
+        got0 = await _get(ctx, map_key)
+        c0 = got0.cursor
+
+        await _resolve(ctx, map_key, n1.node_id, resolution_summary="all done")
+
+        got_d = await _get(ctx, map_key, since=c0)
+        assert got_d.cursor > c0
+        # Settled node is NOT in nodes (include="open" default)
+        node_ids = {n.memory_id for n in got_d.nodes}
+        assert n1.node_id not in node_ids
+        # It IS in resolved
+        resolved_ids = {r.memory_id for r in got_d.resolved}
+        assert n1.node_id in resolved_ids
+    finally:
+        await _cleanup(pg_pool, tenant, team, client_id)
