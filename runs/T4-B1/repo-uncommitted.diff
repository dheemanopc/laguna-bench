+# --------------------------------------------------------------------------- #
+# truncate_content helper
+# --------------------------------------------------------------------------- #
+
+
+def test_truncate_summary_short_content() -> None:
+    c, t = truncate_content("hello", "summary")
+    assert c == "hello"
+    assert t is False
+
+
+def test_truncate_summary_exactly_200_not_truncated() -> None:
+    content = "a" * SUMMARY_CONTENT_CHARS
+    c, t = truncate_content(content, "summary")
+    assert c == content
+    assert t is False
+    assert len(c) == SUMMARY_CONTENT_CHARS
+
+
+def test_truncate_summary_201_truncated() -> None:
+    content = "a" * (SUMMARY_CONTENT_CHARS + 1)
+    c, t = truncate_content(content, "summary")
+    assert t is True
+    assert len(c) == SUMMARY_CONTENT_CHARS + 1  # 200 + ellipsis
+    assert c.endswith("…")
+    assert c[:SUMMARY_CONTENT_CHARS] == "a" * SUMMARY_CONTENT_CHARS
