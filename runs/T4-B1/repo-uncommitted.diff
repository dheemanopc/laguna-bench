+"""mindmap per-branch settlement status on memory_map_membership.
+
+Per the mind-map build design (docs/mindmap-v1-build-design.md) and the v1 build
+work order: settlement is per-branch, stored, and is the single source of truth for
+"settled". An edge alone (e.g. a mindmap_link with resolves-under) never settles a
+branch — settlement only happens via mindmap_resolve, which writes a row here.
+
+Adds status-tracking columns to memory_map_membership:
+  - status            : 'open' | 'resolved' | 'dropped' (default 'open' — existing
+                        rows are open, matching the pre-existing "all open" behaviour).
+  - resolution_summary  : human-readable 1..500 char note on why the branch settled.
+  - resolved_by_memory_id : the memory that carried the user's resolution (the
+                        "resolver" node), or NULL when settling without one.
+  - resolved_by_party   : 'owner' | 'model' — who resolved (for audit / whose-turn).
+  - resolved_at         : wall-clock of resolution.
+
+A consistency CHECK enforces the invariant: while the columns describing *how* a
+branch settled (summary, party, timestamp, resolver id) are mutually consistent with
+the status — open branches have all NULLs, settled branches have all NOT NULLs. The
+store, not the application, is the final guard against a half-settled row.
+
+Revision ID: 0044_mindmap_branch_status
+Revises: 0043_backfill_personal_teams
+Create Date: 2026-10-15
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0044_mindmap_branch_status"
+down_revision = "0043_backfill_personal_teams"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    # Existing rows default to 'open' (the pre-status behaviour was "all open").
+    op.execute(
+        sa.text("ALTER TABLE memory_map_membership ADD COLUMN status TEXT NOT NULL DEFAULT 'open'")
+    )
+    op.execute(sa.text("ALTER TABLE memory_map_membership ADD COLUMN resolution_summary TEXT"))
+    op.execute(sa.text("ALTER TABLE memory_map_membership ADD COLUMN resolved_by_memory_id UUID"))
+    op.execute(sa.text("ALTER TABLE memory_map_membership ADD COLUMN resolved_by_party TEXT"))
+    op.execute(sa.text("ALTER TABLE memory_map_membership ADD COLUMN resolved_at TIMESTAMPTZ"))
+
+    # Per-value CHECKs.
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership ADD CONSTRAINT "
+            "memory_map_membership_status_check "
+            "CHECK (status IN ('open', 'resolved', 'dropped'))"
+        )
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership ADD CONSTRAINT "
+            "memory_map_membership_resolution_summary_len_check "
+            "CHECK (resolution_summary IS NULL OR length(resolution_summary) BETWEEN 1 AND 500)"
+        )
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership ADD CONSTRAINT "
+            "memory_map_membership_resolved_by_party_check "
+            "CHECK (resolved_by_party IN ('owner', 'model'))"
+        )
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership ADD CONSTRAINT "
+            "memory_map_membership_resolved_by_memory_id_fk "
+            "FOREIGN KEY (resolved_by_memory_id) REFERENCES memories(id) ON DELETE SET NULL"
+        )
+    )
+
+    # Cross-column consistency: status ↔ resolution fields.
+    #   open     → all resolution columns NULL (branch is unsettled)
+    #   settled  → all resolution columns NOT NULL (the "how" is always recorded)
+    op.execute(
+        sa.text(
+            """
+            ALTER TABLE memory_map_membership ADD CONSTRAINT
+            memory_map_membership_status_consistency_check
+            CHECK (
+                (status = 'open'
+                    AND resolution_summary IS NULL
+                    AND resolved_by_party IS NULL
+                    AND resolved_at IS NULL
+                    AND resolved_by_memory_id IS NULL)
+                OR
+                (status IN ('resolved', 'dropped')
+                    AND resolution_summary IS NOT NULL
+                    AND resolved_by_party IS NOT NULL
+                    AND resolved_at IS NOT NULL)
+            )
+            """
+        )
+    )
+
+    # The DEFAULT 'open' is retained so insert_membership (which writes the
+    # membership row without specifying status) keeps working — new nodes are
+    # open by definition. The CHECK below guarantees a settled row can never
+    # be half-populated through that default path.
+
+
+def downgrade() -> None:
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership DROP CONSTRAINT IF EXISTS "
+            "memory_map_membership_status_consistency_check"
+        )
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership DROP CONSTRAINT IF EXISTS "
+            "memory_map_membership_resolved_by_memory_id_fk"
+        )
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership DROP CONSTRAINT IF EXISTS "
+            "memory_map_membership_resolved_by_party_check"
+        )
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership DROP CONSTRAINT IF EXISTS "
+            "memory_map_membership_resolution_summary_len_check"
+        )
+    )
+    op.execute(
+        sa.text(
+            "ALTER TABLE memory_map_membership DROP CONSTRAINT IF EXISTS "
+            "memory_map_membership_status_check"
+        )
+    )
+    op.execute(sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolved_at"))
+    op.execute(sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolved_by_party"))
+    # resolved_by_memory_id is a nullable FK to memories; dropping the column
+    # removes the reference. Safe regardless of whether it was populated.
+    op.execute(
+        sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolved_by_memory_id")
+    )
+    op.execute(
+        sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS resolution_summary")
+    )
+    op.execute(sa.text("ALTER TABLE memory_map_membership DROP COLUMN IF EXISTS status"))
