@@ -0,0 +1,1065 @@
+"""Integration tests for per-branch settlement (mindmap_resolve) + cheap reads
+(mindmap_get with since/include/depth).
+
+Coverage:
+  1. resolve with resolving node → status/summary/party/resolved_by/resolved_at;
+     memory_references row (resolves-under); event logged; cursor advanced.
+  2. drop with/without resolving node → status/edge or no edge.
+  3. node of different map / random uuid → -32602 opaque, nothing changed.
+  4. archived / unknown map / root / already-settled → -32602 right data codes.
+  5. mindmap_link(resolves-under) alone does NOT settle; still in open_loops.
+  6. open_loops: owner+model nodes surface, settled/none don't.
+  7. mindmap_get defaults: settled absent from nodes, in resolved;
+     include="all" returns all with statuses; truncation 200/201/full.
+  8. since workflow: empty delta, write delta, resolve delta.
+  9. Migration CHECKs: bogus status rejected; resolved-without-summary rejected.
+
+Follows the _setup/_cleanup/_ctx/_build_deps pattern from test_mindmap_e2e.py.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID, uuid4
+
+import asyncpg  # type: ignore[import-untyped]
+import pytest
+
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.mindmap_close import MindmapCloseInput, MindmapCloseTool
+from mem_mcp.mcp.tools.mindmap_get import MindmapGetInput, MindmapGetTool
+from mem_mcp.mcp.tools.mindmap_link import MindmapLinkInput, MindmapLinkTool
+from mem_mcp.mcp.tools.mindmap_open import MindmapOpenInput, MindmapOpenTool
+from mem_mcp.mcp.tools.mindmap_resolve import (
+    MindmapResolveInput,
+    MindmapResolveTool,
+)
+from mem_mcp.mcp.tools.mindmap_write_node import (
+    MindmapWriteNodeInput,
+    MindmapWriteNodeTool,
+)
+from mem_mcp.teams.assignments import assign_role
+
+pytestmark = pytest.mark.asyncio
+
+# Use the default review_threshold (15) so no review_flag events fire in tests
+# that count cursor increments precisely.
+_DEFAULT_THRESHOLD = 15
+
+
+# --------------------------------------------------------------------------- #
+# Shared helpers (copied from test_mindmap_e2e.py)
+# --------------------------------------------------------------------------- #
+
+
+def _build_deps() -> Any:
+    from mem_mcp.audit.logger import NoopAuditLogger
+    from mem_mcp.embeddings.bedrock import EmbedResult
+
+    class _StubEmbed:
+        async def embed(self, content: str) -> Any:
+            return EmbedResult(vector=[0.0] * 1024, input_tokens=max(1, len(content) // 4))
+
+    return ToolDeps(embeddings=_StubEmbed(), audit=NoopAuditLogger(), quotas=NoopQuotas())
+
+
+async def _setup(conn: asyncpg.Connection) -> dict[str, Any]:
+    tenant = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"mindmap-{uuid4()}@example.test",
+    )
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+        f"mindmap-team-{uuid4().hex[:8]}",
+        tenant,
+    )
+    await assign_role(
+        conn,
+        parent_team_id=team,
+        member_kind="user",
+        member_id=tenant,
+        role_key="member",
+        assigned_by_user_id=tenant,
+    )
+    await conn.execute(
+        """
+        INSERT INTO tenant_identities
+            (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+        VALUES ($1, $2, 'cognito', $3, true, $4)
+        """,
+        tenant,
+        f"sub-{tenant}",
+        f"mindmap-{tenant}@example.test",
+        team,
+    )
+    client_id = f"client:mindmap-{uuid4().hex[:8]}"
+    await conn.execute(
+        """
+        INSERT INTO oauth_clients (id, redirect_uris, scope, registration_payload, review_status)
+        VALUES ($1, ARRAY[]::text[], 'memory.read memory.write', '{}'::jsonb, 'auto_allowed')
+        """,
+        client_id,
+    )
+    return {"tenant": tenant, "team": team, "client_id": client_id}
+
+
+async def _cleanup(pool: Any, tenant: UUID, team: UUID, client_id: str) -> None:
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute(
+                "DELETE FROM memory_references WHERE source_memory_id IN "
+                "(SELECT id FROM memories WHERE tenant_id = $1) "
+                "OR target_memory_id IN (SELECT id FROM memories WHERE tenant_id = $1)",
+                tenant,
+            )
+            await conn.execute("DELETE FROM memory_map_events WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM memory_map_membership WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM memory_maps WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM slugs WHERE team_id = $1", team)
+            await conn.execute("DELETE FROM memories WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM team_role_assignments WHERE parent_team_id = $1", team)
+            await conn.execute("DELETE FROM tenant_identities WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM teams WHERE id = $1", team)
+            await conn.execute("DELETE FROM tenants WHERE id = $1", tenant)
+            await conn.execute("DELETE FROM oauth_clients WHERE id = $1", client_id)
+
+
+def _ctx(pool: Any, tenant: UUID, client_id: str) -> ToolContext:
+    return ToolContext(
+        request_id=f"req-{uuid4().hex[:8]}",
+        tenant_id=tenant,
+        identity_id=tenant,
+        client_id=client_id,
+        scopes=frozenset({"memory.read", "memory.write"}),
+        db_pool=pool,
+        deps=_build_deps(),
+    )
+
+
+async def _open_map(
+    ctx: ToolContext,
+    *,
+    title: str = "Test Map",
+    review_threshold: int = _DEFAULT_THRESHOLD,
+) -> Any:
+    out = await MindmapOpenTool()(
+        ctx,
+        MindmapOpenInput(
+            title=title,
+            root_question="What is the best approach?",
+            review_threshold=review_threshold,
+        ),
+    )
+    assert out.state == "live"
+    return out
+
+
+async def _write_node(
+    ctx: ToolContext,
+    map_key: str,
+    content: str,
+    *,
+    node_role: str = "position",
+    responsible_party: str | None = None,
+) -> Any:
+    return await MindmapWriteNodeTool()(
+        ctx,
+        MindmapWriteNodeInput(
+            map_key=map_key,
+            content=content,
+            node_role=node_role,
+            responsible_party=responsible_party,
+        ),
+    )
+
+
+async def _resolve(
+    ctx: ToolContext,
+    map_key: str,
+    node_id: UUID,
+    *,
+    disposition: str = "resolved",
+    resolution_summary: str = "settled",
+    resolved_by_memory_id: UUID | None = None,
+    resolved_by_party: str = "model",
+) -> Any:
+    return await MindmapResolveTool()(
+        ctx,
+        MindmapResolveInput(
+            map_key=map_key,
+            node_id=node_id,
+            disposition=disposition,
+            resolution_summary=resolution_summary,
+            resolved_by_memory_id=resolved_by_memory_id,
+            resolved_by_party=resolved_by_party,
+        ),
+    )
+
+
+async def _get(
+    ctx: ToolContext,
+    map_key: str,
+    *,
+    since: int | None = None,
+    include: str = "open",
+    depth: str = "summary",
+) -> Any:
+    return await MindmapGetTool()(
+        ctx,
+        MindmapGetInput(
+            map_key=map_key,
+            since=since,
+            include=include,
+            depth=depth,
+        ),
+    )
+
+
+async def _get_member_status(
+    pool: Any, root_memory_id: UUID, memory_id: UUID, tenant: UUID
+) -> dict[str, Any] | None:
+    """Read the membership row directly (bypassing the tool layer)."""
+    async with pool.acquire() as conn:
+        await conn.execute("SELECT set_config('app.current_tenant_id', $1, true)", str(tenant))
+        row = await conn.fetchrow(
+            """
+            SELECT status, resolution_summary, resolved_by_party,
+                   resolved_by_memory_id, resolved_at
+            FROM memory_map_membership
+            WHERE root_memory_id = $1 AND memory_id = $2
+            """,
+            root_memory_id,
+            memory_id,
+        )
+        return dict(row) if row else None
+
+
+async def _get_ref_edge(
+    pool: Any, source: UUID, target: UUID, tenant: UUID
+) -> dict[str, Any] | None:
+    """Check for a memory_references edge between two memories."""
+    async with pool.acquire() as conn:
+        await conn.execute("SELECT set_config('app.current_tenant_id', $1, true)", str(tenant))
+        row = await conn.fetchrow(
+            """
+            SELECT source_memory_id, target_memory_id, reference_kind
+            FROM memory_references
+            WHERE source_memory_id = $1 AND target_memory_id = $2
+            """,
+            source,
+            target,
+        )
+        return dict(row) if row else None
+
