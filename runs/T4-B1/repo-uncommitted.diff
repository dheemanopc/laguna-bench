+async def test_since_resolve_delta(pg_pool: Any) -> None:
+    """get(since=cursor) after a resolve surfaces the settled node in resolved."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
