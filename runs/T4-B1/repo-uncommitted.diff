+async def test_since_with_link_edges(pg_pool: Any) -> None:
+    """Delta mode surfaces edges touching a candidate node."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(pg_pool, tenant, client_id)
+    try:
+        opened = await _open_map(ctx, title="Since Edges")
+        map_key = opened.map_key
+
+        n1 = await _write_node(ctx, map_key, "Position", node_role="position")
+        got0 = await _get(ctx, map_key)
+        assert len(got0.edges) == 0
+        c0 = got0.cursor
+
+        # Link n1 → root with a map event
+        await MindmapLinkTool()(
+            ctx,
+            MindmapLinkInput(
+                source_memory_id=n1.node_id,
+                target_memory_id=opened.root_memory_id,
+                reference_kind="open-under",
+                map_key=map_key,
+            ),
+        )
+
+        got_d = await _get(ctx, map_key, since=c0)
+        # The link event touches n1 (source) and root (target via payload.target).
+        # Both are candidates → the edge between them should appear.
+        edge_ids = {e.source_memory_id for e in got_d.edges}
+        assert n1.node_id in edge_ids or opened.root_memory_id in edge_ids
+        # Verify the edge is actually present
+        assert any(
+            (e.source_memory_id == n1.node_id and e.target_memory_id == opened.root_memory_id)
+            or (e.source_memory_id == opened.root_memory_id and e.target_memory_id == n1.node_id)
+            for e in got_d.edges
+        )
+    finally:
+        await _cleanup(pg_pool, tenant, team, client_id)
