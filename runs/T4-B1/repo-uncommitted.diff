+"""DB-free model + registration tests for mindmap_resolve + mindmap_get.
+
+Covers input validation, defaults, the truncation helper, and tool registration
+without touching Postgres.
+"""
+
+from __future__ import annotations
+
+import inspect
+from uuid import uuid4
+
+import pytest
+from pydantic import ValidationError
+
+from mem_mcp.mcp.tools.mindmap_get import (
+    MindmapGetInput,
+    MindmapGetOutput,
+    MindmapGetTool,
+    MindmapNode,
+    MindmapResolvedBranch,
+    truncate_content,
+)
+from mem_mcp.mcp.tools.mindmap_resolve import (
+    MindmapResolveInput,
+    MindmapResolveTool,
+)
+from mem_mcp.mindmap import SUMMARY_CONTENT_CHARS
+
+# --------------------------------------------------------------------------- #
+# MindmapResolveInput validation
+# --------------------------------------------------------------------------- #
+
+
+def test_resolve_input_defaults() -> None:
+    inp = MindmapResolveInput(
+        map_key="caching-strategy",
+        node_id=uuid4(),
+        resolution_summary="confirmed by user",
+    )
+    assert inp.disposition == "resolved"
+    assert inp.resolved_by_memory_id is None
+    assert inp.resolved_by_party == "model"
+    assert inp.team_id is None
+
+
+def test_resolve_input_rejects_extra_fields() -> None:
+    with pytest.raises(ValidationError):
+        MindmapResolveInput(
+            map_key="m",
+            node_id=uuid4(),
+            resolution_summary="ok",
+            bogus="nope",  # extra="forbid"
+        )
+
+
+def test_resolve_input_summary_length_bounds() -> None:
+    with pytest.raises(ValidationError):
+        MindmapResolveInput(map_key="m", node_id=uuid4(), resolution_summary="")
+    with pytest.raises(ValidationError):
+        MindmapResolveInput(map_key="m", node_id=uuid4(), resolution_summary="x" * 501)
+    # exactly 1 and exactly 500 are valid
+    MindmapResolveInput(map_key="m", node_id=uuid4(), resolution_summary="x")
+    MindmapResolveInput(map_key="m", node_id=uuid4(), resolution_summary="y" * 500)
+
+
+def test_resolve_input_disposition_literal() -> None:
+    with pytest.raises(ValidationError):
+        MindmapResolveInput(
+            map_key="m", node_id=uuid4(), disposition="done", resolution_summary="x"
+        )
+    with pytest.raises(ValidationError):
+        MindmapResolveInput(
+            map_key="m", node_id=uuid4(), disposition="resolved", resolved_by_party="someone"
+        )
+
+
