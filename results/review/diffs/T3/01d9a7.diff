--- /dev/null
+++ b/src/mem_mcp/teams/authz.py
@@ -0,0 +1,55 @@
+"""Team-level authorization helpers.
+
+Transport-agnostic: raises its own exception type
+(``TeamPermissionDeniedError``) which the MCP layer maps to JsonRpcError and
+the web layer maps to HTTPException — same layering as
+``mem_mcp.admin.errors``.
+
+This module lives in the *teams* domain (not ``mcp/``) because it is pure SQL +
+business rule and must be callable from jobs/ and web/ as well as from tools.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+from uuid import UUID
+
+if TYPE_CHECKING:
+    import asyncpg  # type: ignore[import-untyped]
+
+
+class TeamPermissionDeniedError(Exception):
+    """Raised when a caller lacks a team-scoped permission on a team.
+
+    Carries ``.permission`` so the transport layer can build the canonical
+    JsonRpcError / HTTP error payload without re-deriving the string.
+    """
+
+    def __init__(self, permission: str) -> None:
+        self.permission = permission
+        super().__init__(
+            f"caller lacks required permission: {permission}"
+        )
+
+
+async def require_team_permission(
+    conn: asyncpg.Connection,
+    caller_id: UUID,
+    team_id: UUID,
+    permission: str,
+) -> None:
+    """Require ``permission`` (e.g. ``"team.manage_members"``) on ``team_id``.
+
+    Calls ``mem_mcp.auth.rbac.has_permission`` with ``team_id=...`` and raises
+    :class:`TeamPermissionDeniedError` if the caller does not hold it.
+
+    The import of ``rbac`` is done lazily inside the function body because
+    ``rbac`` pulls in FastAPI + ``web.sessions`` for its ``require_permission``
+    dependency, which the MCP path does not need.  This mirrors the pattern in
+    ``mcp/tools/_admin_base.py`` / ``mcp/registry.py``.
+    """
+    # Imported lazily to avoid pulling FastAPI into the MCP domain path.
+    from mem_mcp.auth.rbac import has_permission
+
+    if not await has_permission(conn, caller_id, permission, team_id=team_id):
+        raise TeamPermissionDeniedError(permission)
