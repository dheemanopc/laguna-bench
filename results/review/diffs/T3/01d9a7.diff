+"""Shared team-authorization gate for the ``memsys_*_team_member*`` tools.
+
+The domain-level :func:`mem_mcp.teams.authz.require_team_permission` raises
+:class:`TeamPermissionDeniedError`.  The MCP layer needs a *single* place
+that maps that exception to the canonical ``-32603`` JSON-RPC error so that
+every tool that gates on a team permission produces the identical envelope
+(CONVENTIONS.md §Error model).
+
+Error shape (matches ``_admin_base.py`` and spec §9.4):
+
+    JsonRpcError(-32603, "caller lacks required permission: <perm>",
+                 data={"missing_permission": "<perm>"})
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+from uuid import UUID
+
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.teams.authz import TeamPermissionDeniedError, require_team_permission
+
+if TYPE_CHECKING:
+    import asyncpg  # type: ignore[import-untyped]
+
+
+#: The team-scoped permission required to add / assign / remove team members.
+TEAM_MANAGE_MEMBERS = "team.manage_members"
+
+
+async def check_team_permission(
+    conn: asyncpg.Connection,
+    caller_id: UUID,
+    team_id: UUID,
+    permission: str,
+) -> None:
+    """Enforce a team permission, raising JsonRpcError on denial.
+
+    Wraps :func:`require_team_permission` so each tool needs only a single
+    one-line call instead of repeating the try/except → JsonRpcError mapping.
+
+    Must be called *inside* a ``system_tx`` (or ``tenant_tx``) block — the
+    DB connection is used by the underlying ``has_permission`` lookup.
+    """
+    try:
+        await require_team_permission(conn, caller_id, team_id, permission)
+    except TeamPermissionDeniedError as e:
+        raise JsonRpcError(
+            -32603,
+            f"caller lacks required permission: {e.permission}",
+            data={"missing_permission": e.permission},
+        ) from e
+
+
+async def caller_has_active_team_role(
+    conn: asyncpg.Connection, caller_id: UUID, team_id: UUID
+) -> bool:
+    """True if *caller_id* has an active team role on *team_id*.
+
+    Lazy-imports ``get_team_role`` from ``mem_mcp.auth.rbac`` (same pattern as
+    :mod:`mem_mcp.mcp.tools._admin_base`) to avoid pulling FastAPI into the
+    MCP domain path.
+    """
+    from mem_mcp.auth.rbac import get_team_role
+
+    role = await get_team_role(conn, caller_id, team_id)
+    return role is not None
