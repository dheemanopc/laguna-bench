+async def team_env(pg_pool: Any) -> Any:
+    """Comprehensive team environment.
+
+    Layout:
+      * team_id     — a team created by ``owner_id``.
+      * owner_id    — tenant with role ``owner`` (has manage_members).
+      * admin_id    — tenant with role ``admin`` (has manage_members).
+      * member_id   — tenant with role ``member`` (NO manage_members).
+      * viewer_id   — tenant with role ``viewer`` (NO manage_members).
+      * vendor_id   — tenant with role ``vendor`` (NO manage_members).
+      * customer_id — tenant with role ``customer`` (NO manage_members).
+      * subject_id  — tenant with NO role on the team (target for add/remove).
+
+    All tenants have primary ``tenant_identities`` rows (needed for email-based
+    add_member lookups).  Data is committed so tools can see it via system_tx.
+    """
+    role_map = await _lookup_roles(pg_pool)
+
+    owner_id = uuid4()
+    admin_id = uuid4()
+    member_id = uuid4()
+    viewer_id = uuid4()
+    vendor_id = uuid4()
+    customer_id = uuid4()
+    subject_id = uuid4()
+    team_id = uuid4()
+
+    async with pg_pool.acquire() as conn:
+        for tid in (owner_id, admin_id, member_id, viewer_id, vendor_id, customer_id, subject_id):
+            await conn.execute(
+                "INSERT INTO tenants (id, email, status) VALUES ($1, $2, 'active')",
+                tid, f"sec-{tid}@test.invalid",
+            )
+            await conn.execute(
