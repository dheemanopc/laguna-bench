+"""Security tests for RBAC gating on team-member-management tools ([RUN]).
+
+Verifies that ``memsys_add_team_member``, ``memsys_assign_role``, and
+``memsys_remove_team_member`` correctly enforce the ``team.manage_members``
+permission instead of relying solely on the coarse OAuth scope ``memory.write``.
+
+All data is committed (no wrapping transaction) so it is visible to the tool's
+``system_tx`` / ``tenant_tx`` connections.  Teardown deletes everything in
+FK-safe order, including user_effective_team_access rows.
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Any, cast
+from uuid import uuid4
+
+import pytest
+
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools.add_team_member import (
+    AddTeamMemberInput,
+    AddTeamMemberOutput,
+    AddTeamMemberTool,
+)
+from mem_mcp.mcp.tools.assign_role import AssignRoleInput, AssignRoleOutput, AssignRoleTool
+from mem_mcp.mcp.tools.create_team import CreateTeamInput, CreateTeamOutput, CreateTeamTool
+from mem_mcp.mcp.tools.remove_team_member import (
+    RemoveTeamMemberInput,
+    RemoveTeamMemberOutput,
+    RemoveTeamMemberTool,
+)
+from mem_mcp.teams.assignments import assign_role as assign_role_fn
+
+pytestmark = pytest.mark.skipif(
+    not os.getenv("MEM_MCP_TEST_DSN"),
+    reason="MEM_MCP_TEST_DSN not set",
+)
+
+#: The permission that gates add/assign/remove operations.
+MANAGE_MEMBERS = "team.manage_members"
+
+
+def _ctx(pool: Any, tenant_id: Any, scopes: frozenset[str] | None = None) -> ToolContext:
+    """Build a ToolContext with the standard ``memory.write`` scope."""
+    return ToolContext(
+        request_id=str(uuid4()),
+        tenant_id=tenant_id,
+        identity_id=uuid4(),
+        client_id="test-client",
+        scopes=scopes or frozenset({"memory.read", "memory.write"}),
+        db_pool=pool,
+    )
+
+
+async def _lookup_roles(pg_pool: Any) -> dict[str, Any]:
+    """Return role_key → role_id for all 7 catalog roles (plugin_id IS NULL)."""
+    role_map: dict[str, Any] = {}
+    async with pg_pool.acquire() as conn:
+        for key in ("owner", "admin", "member", "viewer", "vendor", "customer", "service-bot"):
+            rid = await conn.fetchval(
+                "SELECT id FROM roles_catalog WHERE role_key=$1 AND plugin_id IS NULL",
+                key,
+            )
+            if rid is None:
+                pytest.skip(f"roles_catalog missing role '{key}'")
+            role_map[key] = rid
+    return role_map
+
+
+
