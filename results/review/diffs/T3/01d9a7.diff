+"""Tests for the expanded team-role permission matrix ([RUN]).
+
+Covers all 7 catalog roles (owner, admin, member, service-bot, viewer, vendor,
+customer) against the full set of team.* permissions declared in the
+Permission enum.  Verifies the mapping in ROLE_PERMISSIONS is complete and
+internally consistent.
+
+The DB-backed tests at the bottom require MEM_MCP_TEST_DSN and are skipped
+otherwise.
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Any
+from uuid import uuid4
+
+import pytest
+
+from mem_mcp.auth.permissions import (
+    _TEAM_ADMIN_PERMS,
+    _TEAM_MEMBER_PERMS,
+    _TEAM_VIEWER_PERMS,
+    ROLE_PERMISSIONS,
+    Permission,
+)
+
+#: The 7 core catalog roles that must appear in ROLE_PERMISSIONS.
+TEAM_ROLES = [
+    "owner",
+    "admin",
+    "member",
+    "service-bot",
+    "viewer",
+    "vendor",
+    "customer",
+]
+
+#: System roles that live in Role enum, not in roles_catalog.
+_SYSTEM_ROLE_KEYS = {"system_admin", "system_support"}
+
+# Skip DB-backed tests when no test DB is configured.
+pytestmark_db = pytest.mark.skipif(
+    not os.getenv("MEM_MCP_TEST_DSN"),
+    reason="MEM_MCP_TEST_DSN not set",
+)
+
+
+def test_all_seven_catalog_roles_present() -> None:
+    """Every catalog role must have an entry in ROLE_PERMISSIONS."""
+    for role in TEAM_ROLES:
+        assert role in ROLE_PERMISSIONS, f"Missing role '{role}' in ROLE_PERMISSIONS"
+
+
+def test_owner_has_all_team_permissions() -> None:
+    """Owner is an admin-equivalent: holds every team.* permission."""
+    perms = ROLE_PERMISSIONS["owner"]
+    for p in Permission:
+        if p.value.startswith("team."):
+            assert p in perms, f"owner missing {p}"
+
+
+def test_admin_has_all_team_permissions() -> None:
+    """Admin holds every team.* permission."""
+    perms = ROLE_PERMISSIONS["admin"]
+    for p in Permission:
+        if p.value.startswith("team."):
+            assert p in perms, f"admin missing {p}"
+
+
+def test_member_has_read_write_but_not_manage() -> None:
+    """Member has view/write/read-memory but NOT manage/delete/settings."""
+    perms = ROLE_PERMISSIONS["member"]
+    assert Permission.TEAM_VIEW in perms
+    assert Permission.TEAM_WRITE_MEMORY in perms
+    assert Permission.TEAM_READ_MEMORY in perms
+    assert Permission.TEAM_MANAGE_MEMBERS not in perms
+    assert Permission.TEAM_MANAGE_SETTINGS not in perms
+    assert Permission.TEAM_DELETE not in perms
+
+
+def test_service_bot_matches_member_permissions() -> None:
+    """service-bot is an automated agent — same perms as 'member'."""
+    assert ROLE_PERMISSIONS["service-bot"] == ROLE_PERMISSIONS["member"]
+
+
+def test_service_bot_excludes_manage_permissions() -> None:
+    """service-bot must NOT have manage_members (no human oversight)."""
+    perms = ROLE_PERMISSIONS["service-bot"]
+    assert Permission.TEAM_MANAGE_MEMBERS not in perms
+    assert Permission.TEAM_MANAGE_SETTINGS not in perms
+    assert Permission.TEAM_DELETE not in perms
+
+
+def test_viewer_vendor_customer_share_same_permissions() -> None:
+    """viewer, vendor, and customer all get the same read-only set."""
+    viewer_perms = ROLE_PERMISSIONS["viewer"]
+    vendor_perms = ROLE_PERMISSIONS["vendor"]
+    customer_perms = ROLE_PERMISSIONS["customer"]
+    assert viewer_perms == vendor_perms
+    assert viewer_perms == customer_perms
+
+
+def test_viewer_permissions_are_read_only() -> None:
+    """viewer has view + read-memory but nothing else."""
+    perms = ROLE_PERMISSIONS["viewer"]
+    assert Permission.TEAM_VIEW in perms
+    assert Permission.TEAM_READ_MEMORY in perms
+    assert Permission.TEAM_WRITE_MEMORY not in perms
+    assert Permission.TEAM_MANAGE_MEMBERS not in perms
+    assert Permission.TEAM_MANAGE_SETTINGS not in perms
+    assert Permission.TEAM_DELETE not in perms
+
+
+def test_no_team_role_has_system_permissions() -> None:
+    """No team role should implicitly hold system.* permissions."""
+    for role in TEAM_ROLES:
+        perms = ROLE_PERMISSIONS[role]
+        for p in perms:
+            assert not p.value.startswith("system."), (
+                f"Team role '{role}' should not have system permission {p}"
+            )
+
+
+def test_admin_and_owner_sets_are_equal() -> None:
+    """owner and admin must have identical permission sets."""
+    assert ROLE_PERMISSIONS["owner"] == ROLE_PERMISSIONS["admin"]
+
+
+def test_member_and_service_bot_sets_are_equal() -> None:
+    """member and service-bot must have identical permission sets."""
+    assert ROLE_PERMISSIONS["member"] == ROLE_PERMISSIONS["service-bot"]
+
+
+def test_all_team_perms_accounted_for() -> None:
+    """The union of team-role permissions must cover all team.* permissions."""
+    all_team_perms: set[Permission] = set()
+    for role in TEAM_ROLES:
+        all_team_perms |= ROLE_PERMISSIONS[role]
+
+    expected_team_perms = {
+        p for p in Permission if p.value.startswith("team.")
+    }
+    assert all_team_perms == expected_team_perms, (
+        f"Missing permissions: {expected_team_perms - all_team_perms}"
+    )
+
+
+def test_internal_sets_are_consistent() -> None:
+    """The private _TEAM_*_PERMS sets must agree with public ROLE_PERMISSIONS entries."""
+    assert ROLE_PERMISSIONS["owner"] == _TEAM_ADMIN_PERMS
+    assert ROLE_PERMISSIONS["admin"] == _TEAM_ADMIN_PERMS
+    assert ROLE_PERMISSIONS["member"] == _TEAM_MEMBER_PERMS
+    assert ROLE_PERMISSIONS["service-bot"] == _TEAM_MEMBER_PERMS
+    assert ROLE_PERMISSIONS["viewer"] == _TEAM_VIEWER_PERMS
+    assert ROLE_PERMISSIONS["vendor"] == _TEAM_VIEWER_PERMS
+    assert ROLE_PERMISSIONS["customer"] == _TEAM_VIEWER_PERMS
+
+
