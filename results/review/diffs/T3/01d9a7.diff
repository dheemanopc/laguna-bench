+async def test_has_permission_viewer_resolution(pg_pool: Any) -> None:
+    """has_permission with team_id correctly resolves via team_role_assignments:
+    a viewer can read_memory but cannot manage_members.
+    """
+    from mem_mcp.auth.rbac import has_permission
+
+    role_map: dict[str, Any] = {}
+    async with pg_pool.acquire() as conn:
+        for key in ("viewer", "owner"):
+            rid = await conn.fetchval(
+                "SELECT id FROM roles_catalog WHERE role_key=$1 AND plugin_id IS NULL",
+                key,
+            )
+            if rid is None:
+                pytest.skip(f"roles_catalog missing role '{key}'")
+            role_map[key] = rid
+
+    viewer_id = uuid4()
+    team_id = uuid4()
+    try:
+        async with pg_pool.acquire() as conn:
+            await conn.execute(
+                "INSERT INTO tenants (id, email, status) VALUES ($1, $2, 'active')",
+                viewer_id, f"mat-viewer-{viewer_id}@test.invalid",
+            )
+            await conn.execute(
+                "INSERT INTO teams (id, name, created_by_tenant_id) VALUES ($1, $2, $3)",
+                team_id, f"mat-team-{str(team_id)[:8]}", viewer_id,
+            )
+            await conn.execute(
+                """INSERT INTO team_role_assignments
+                   (parent_team_id, member_kind, member_id, role_id, assigned_by_user_id)
+                   VALUES ($1, 'user', $2, $3, $4)""",
+                team_id, viewer_id, role_map["viewer"], viewer_id,
+            )
+
+        async with pg_pool.acquire() as conn:
+            # viewer can read_memory
+            result = await has_permission(
+                conn, viewer_id, Permission.TEAM_READ_MEMORY, team_id=team_id
+            )
+            assert result is True
+
+            # viewer cannot manage_members
+            result = await has_permission(
+                conn, viewer_id, Permission.TEAM_MANAGE_MEMBERS, team_id=team_id
+            )
+            assert result is False
+
+            # viewer cannot write_memory
+            result = await has_permission(
+                conn, viewer_id, Permission.TEAM_WRITE_MEMORY, team_id=team_id
+            )
+            assert result is False
+    finally:
+        async with pg_pool.acquire() as conn:
+            await conn.execute("DELETE FROM team_role_assignments WHERE parent_team_id=$1", team_id)
+            await conn.execute("DELETE FROM teams WHERE id=$1", team_id)
+            await conn.execute("DELETE FROM tenants WHERE id=$1", viewer_id)
