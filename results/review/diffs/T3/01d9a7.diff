+async def test_roles_catalog_matches_permission_matrix(pg_pool: Any) -> None:
+    """Every non-plugin role_key in roles_catalog has an entry in ROLE_PERMISSIONS,
+    and the set of team-role keys equals that catalog set exactly.
+    """
+    async with pg_pool.acquire() as conn:
+        catalog_roles = await conn.fetch(
+            "SELECT role_key FROM roles_catalog WHERE plugin_id IS NULL"
+        )
+    catalog_keys = {r["role_key"] for r in catalog_roles}
+
+    # Every catalog role must be in ROLE_PERMISSIONS.
+    for key in catalog_keys:
+        assert key in ROLE_PERMISSIONS, f"roles_catalog role '{key}' missing from ROLE_PERMISSIONS"
+
+    # Team-role keys in ROLE_PERMISSIONS (exclude system roles) must equal catalog set.
+    matrix_team_roles = set(ROLE_PERMISSIONS.keys()) - _SYSTEM_ROLE_KEYS
+    assert matrix_team_roles == catalog_keys, (
+        f"Matrix/team-catalog mismatch:\n"
+        f"  In matrix but not catalog: {matrix_team_roles - catalog_keys}\n"
+        f"  In catalog but not matrix: {catalog_keys - matrix_team_roles}"
+    )
+
+
