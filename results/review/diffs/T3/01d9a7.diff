+        await conn.execute(
+            "DELETE FROM team_role_assignments WHERE parent_team_id=$1",
+            team_id,
+        )
+        await conn.execute("DELETE FROM teams WHERE id=$1", team_id)
+        await conn.execute(
+            "DELETE FROM tenant_identities WHERE tenant_id = ANY($1::uuid[])",
+            all_tenants,
+        )
+        await conn.execute(
+            "DELETE FROM tenants WHERE id = ANY($1::uuid[])",
