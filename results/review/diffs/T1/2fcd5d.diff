+"""Tests for mem_mcp.mcp.tools.admin_* (T-5 admin: find/get user).
+
+Covers:
+  * DB-free __init_subclass__ guards on AdminTool (permission scope,
+    audit-action scope, __call__ finality, abstract run).
+  * DB-backed authorization + audit row emission (denied / success / error).
+  * No-existence-oracle: a denied caller sees 32603 regardless of target.
+  * Transport scope gate + ToolRegistry registration.
+"""
+
+from __future__ import annotations
+
+from typing import Any, ClassVar
+from unittest.mock import MagicMock
+from uuid import uuid4
+
+import pytest
+
+from mem_mcp.audit.logger import DbAuditLogger
+from mem_mcp.auth.permissions import Permission
