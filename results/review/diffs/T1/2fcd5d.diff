+async def make_team(pg_pool: Any) -> Any:
+    """Factory creating a team owned by a given tenant (owner assignment)."""
+    async with pg_pool.acquire() as conn:
+        owner_role_id = await conn.fetchval(
+            "SELECT id FROM roles_catalog WHERE role_key='owner' AND plugin_id IS NULL"
+        )
+    if owner_role_id is None:  # pragma: no cover - seeded migration
+        pytest.skip("roles_catalog 'owner' role not seeded")
+
+    created: list[Any] = []
+
+    async def _make(owner_tenant_id: Any, *, name: str | None = None) -> dict[str, Any]:
+        team_id = uuid4()
+        name = name or f"team-{team_id}"
+        async with pg_pool.acquire() as conn:
+            await conn.execute(
+                "INSERT INTO teams (id, name, workspace_domain, created_by_tenant_id) "
+                "VALUES ($1, $2, NULL, $3)",
+                team_id,
+                name,
+                owner_tenant_id,
+            )
+            await conn.execute(
+                "INSERT INTO team_role_assignments "
+                "(parent_team_id, member_kind, member_id, role_id, status, "
+                " assigned_by_user_id) VALUES ($1, 'user', $2, $3, 'active', $2)",
+                team_id,
+                owner_tenant_id,
+                owner_role_id,
+            )
+            created.append(team_id)
+        return {"team_id": team_id, "name": name}
+
+    yield _make
+
+    async with pg_pool.acquire() as conn:
+        for team_id in created:
+            await conn.execute(
+                "DELETE FROM team_role_assignments WHERE parent_team_id=$1", team_id
+            )
+            await conn.execute("DELETE FROM teams WHERE id=$1", team_id)
