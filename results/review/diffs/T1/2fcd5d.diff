+"""Admin service package — transport-agnostic, cross-tenant user lookups.
+
+Public API:
+    AdminUserSummary, AdminUserDetail, AdminUserTeam — read models
+    find_users, get_user — service functions taking an asyncpg.Connection
+    NotFoundError, InvalidQueryError — service exception types
+"""
+
+from __future__ import annotations
+
+from mem_mcp.admin.errors import InvalidQueryError, NotFoundError
+from mem_mcp.admin.service import (
+    AdminUserDetail,
+    AdminUserSummary,
+    AdminUserTeam,
+    find_users,
+    get_user,
+)
+
+__all__ = [
+    "AdminUserDetail",
+    "AdminUserSummary",
+    "AdminUserTeam",
+    "InvalidQueryError",
