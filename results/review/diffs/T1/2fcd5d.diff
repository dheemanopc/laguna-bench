+class TestEscapeLike:
+    def test_passes_through_plain_text(self) -> None:
+        assert _escape_like("manasi") == "manasi"
+
+    def test_escapes_percent(self) -> None:
+        assert _escape_like("50%") == r"50\%"
+
+    def test_escapes_underscore(self) -> None:
+        assert _escape_like("a_b") == r"a\_b"
+
+    def test_escapes_backslash_first(self) -> None:
+        # Backslash must be escaped BEFORE the \% / \_ we add below, else we
+        # would double-escape our own escape characters.
+        assert _escape_like(r"a\b%c_d") == r"a\\b\%c\_d"
+
+    def test_idempotent_ordering(self) -> None:
+        """Re-escaping an already-escaped string must not change it again."""
+        once = _escape_like(r"a\%_")
+        twice = _escape_like(once)
+        assert once == twice
+
+
+class TestClampLimit:
+    def test_none_returns_default(self) -> None:
+        assert _clamp_limit(None) == DEFAULT_LIMIT
+
+    def test_within_range_passes_through(self) -> None:
+        assert _clamp_limit(MIN_LIMIT) == MIN_LIMIT
+        assert _clamp_limit(50) == 50
+        assert _clamp_limit(MAX_LIMIT) == MAX_LIMIT
+
+    def test_below_min_clamps_to_one(self) -> None:
+        assert _clamp_limit(0) == MIN_LIMIT
+        assert _clamp_limit(-5) == MIN_LIMIT
+
+    def test_above_max_clamps_to_max(self) -> None:
+        assert _clamp_limit(MAX_LIMIT + 1) == MAX_LIMIT
+        assert _clamp_limit(9999) == MAX_LIMIT
+
