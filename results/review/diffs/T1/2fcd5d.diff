diff --git a/src/mem_mcp/mcp/tools/_admin_base.py b/src/mem_mcp/mcp/tools/_admin_base.py
new file mode 100644
index 0000000..f54a495
--- /dev/null
+++ b/src/mem_mcp/mcp/tools/_admin_base.py
@@ -0,0 +1,177 @@
+"""AdminTool base class — RBAC-gated, cross-tenant admin tool scaffold.
+
+Every concrete admin tool subclasses ``AdminTool`` and implements
+``run()``. ``AdminTool`` owns ``__call__``, which is final: it (1) opens a
+``system_tx``, (2) checks ``has_permission`` for the tool's
+``required_permission``, (3) on denial writes a *committed* ``result=denied``
+audit row and raises ``JsonRpcError(-32603)``, (4) on grant delegates to
+``run()`` and audits ``success``/``error``.
+
+Subclassing is what enforces the gate: because ``__call__`` is final and the
+RBAC check happens before ``run()`` is ever called, no admin tool can ship
+that bypasses authorization. ``__init_subclass__`` additionally validates, at
+class creation, that:
+
+  * ``required_permission`` is a ``system.*``-scoped ``Permission``;
+  * ``audit_action`` is an ``admin.*``-scoped action string;
+  * the subclass does not override ``__call__``.
+
+Admin tools are deliberately cross-tenant (``system_tx``, no tenant GUC); the
+caller's ``tenant_id`` on ``ToolContext`` is used only to resolve their system
+roles via ``tenant_system_roles`` (tenant-filtered, RLS-less).
+"""
+
+from __future__ import annotations
+
+import abc
+from typing import TYPE_CHECKING, Any, ClassVar, cast
+
+from pydantic import BaseModel
+
+from mem_mcp.audit.logger import AuditAction
+from mem_mcp.auth.permissions import Permission
+from mem_mcp.auth.rbac import has_permission
+from mem_mcp.db import system_tx
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+
+if TYPE_CHECKING:
+    import asyncpg  # type: ignore[import-untyped]
+
+
+def _audit_error_code(exc: BaseException) -> str:
+    """Audit ``error_code``: the JsonRpcError code, else the exception type name."""
+    if isinstance(exc, JsonRpcError):
+        return str(exc.code)
+    return type(exc).__name__
+
+
+class AdminTool(abc.ABC):
+    """Base for cross-tenant, RBAC-gated admin MCP tools.
+
+    Subclasses declare the ClassVars below and implement ``run()``. They must
+    NOT override ``__call__`` — authorization is enforced there.
+    """
+
+    name: ClassVar[str]
+    description: ClassVar[str]
+    required_scope: ClassVar[str] = "memory.read"
+    required_permission: ClassVar[Permission]
+    audit_action: ClassVar[str]
+    InputModel: ClassVar[type[BaseModel]]
+    OutputModel: ClassVar[type[BaseModel]]
+
+    def __init_subclass__(cls, **kwargs: Any) -> None:
+        super().__init_subclass__(**kwargs)
+        # Validate required_permission on the subclass's OWN __dict__ so an
+        # intermediate class cannot accidentally inherit a stale value.
+        perm = cls.__dict__.get("required_permission")
+        if perm is None:
+            raise TypeError(f"{cls.__name__} must define required_permission")
+        if not isinstance(perm, Permission):
+            raise TypeError(
+                f"{cls.__name__}.required_permission must be a Permission, "
+                f"got {type(perm).__name__}"
+            )
+        if not perm.value.startswith("system."):
+            raise ValueError(
+                f"{cls.__name__}.required_permission must be system-scoped, "
+                f"got {perm.value!r}"
+            )
+
+        action = cls.__dict__.get("audit_action")
+        if action is None:
+            raise TypeError(f"{cls.__name__} must define audit_action")
+        if not isinstance(action, str) or not action.startswith("admin."):
+            raise ValueError(
+                f"{cls.__name__}.audit_action must start with 'admin.', got {action!r}"
+            )
+
+        if "__call__" in cls.__dict__:
+            raise TypeError(
+                f"{cls.__name__} must not override __call__ — authorization is "
+                f"enforced by AdminTool.__call__"
+            )
+
+    @abc.abstractmethod
+    async def run(
+        self,
+        conn: asyncpg.Connection,
+        ctx: ToolContext,
+        inp: BaseModel,
+    ) -> BaseModel:
+        """Tool-specific logic, called only after the RBAC gate passes.
+
+        Runs inside an open ``system_tx`` whose connection is cross-tenant.
+        Map domain exceptions (e.g. NotFoundError) to JsonRpcError here.
+        """
+        raise NotImplementedError
+
+    async def __call__(self, ctx: ToolContext, inp: BaseModel) -> BaseModel:
+        """Final flow: RBAC gate → run() → audit. Subclasses must not override."""
+        if ctx.deps is None:
+            raise JsonRpcError(-32603, "tool deps not wired")
+        deps = ctx.deps
+        perm = self.required_permission.value
+
+        # (1) Permission gate — system_tx, no tenant GUC (cross-tenant).
+        async with system_tx(ctx.db_pool) as conn:
+            allowed = await has_permission(conn, ctx.tenant_id, self.required_permission)
+        if not allowed:
+            # (2) Denied: commit a `result=denied` audit row on its own tx,
+            # then raise. A fresh system_tx is required because raising inside
+            # an audit-bearing tx would roll the row back.
+            async with system_tx(ctx.db_pool) as conn:
+                await deps.audit.audit(
+                    conn,
+                    action=cast(AuditAction, self.audit_action),
+                    result="denied",
+                    tenant_id=ctx.tenant_id,
+                    identity_id=ctx.identity_id,
+                    client_id=ctx.client_id,
+                    request_id=ctx.request_id,
+                    details={"missing_permission": perm},
+                )
+            raise JsonRpcError(
+                -32603,
+                f"caller lacks required permission: {perm}",
+                data={"missing_permission": perm},
+            )
+
+        # (3) Allowed — run + audit on the same conn so the audit rolls back
+        # with the operation if it fails.
+        async with system_tx(ctx.db_pool) as conn:
+            try:
+                output = await self.run(conn, ctx, inp)
+            except Exception as exc:
+                # (4) run() raised → this tx rolls back. Commit the
+                # `result=error` audit on a fresh system_tx, then re-raise
+                # the original exception unchanged.
+                error_code = _audit_error_code(exc)
+                async with system_tx(ctx.db_pool) as audit_conn:
+                    await deps.audit.audit(
+                        audit_conn,
+                        action=cast(AuditAction, self.audit_action),
+                        result="error",
+                        tenant_id=ctx.tenant_id,
+                        identity_id=ctx.identity_id,
+                        client_id=ctx.client_id,
+                        request_id=ctx.request_id,
+                        error_code=error_code,
+                        details={
+                            "error": type(exc).__name__,
+                            "message": str(exc)[:300],
+                        },
+                    )
+                raise
+            await deps.audit.audit(
+                conn,
+                action=self.audit_action,
+                result="success",
+                tenant_id=ctx.tenant_id,
+                identity_id=ctx.identity_id,
+                client_id=ctx.client_id,
+                request_id=ctx.request_id,
+                details={"tenant_id": str(ctx.tenant_id)},
+            )
+            return output
