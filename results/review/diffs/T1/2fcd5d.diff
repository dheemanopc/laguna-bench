@@ -0,0 +1,21 @@
+"""Exception types for the admin service layer.
+
+These are raised by ``mem_mcp.admin.service`` functions and mapped to
+JSON-RPC errors by the MCP tool layer (mem_mcp.mcp.tools.admin_*). Keeping
+them out of ``mem_mcp.mcp.errors`` preserves the layering rule: domain
+modules never import FastAPI / ``JsonRpcError``.
+"""
+
+from __future__ import annotations
+
+
+class NotFoundError(Exception):
+    """A tenant (user account) referenced by id does not exist."""
+
+
+class InvalidQueryError(ValueError):
+    """An admin search query is invalid (too short / whitespace-only).
+
+    Subclasses ``ValueError`` so a single ``except ValueError`` in the tool
+    layer catches it for the -32602 mapping.
+    """
diff --git a/src/mem_mcp/admin/service.py b/src/mem_mcp/admin/service.py
new file mode 100644
index 0000000..ef534a1
--- /dev/null
+++ b/src/mem_mcp/admin/service.py
@@ -0,0 +1,214 @@
+"""Admin user lookup service — cross-tenant, read-only.
+
+Transport-agnostic: pure functions taking an ``asyncpg.Connection``. The MCP
+tool layer (mem_mcp.mcp.tools.admin_find_user / admin_get_user) opens the
+``system_tx`` and calls here. No FastAPI / JsonRpcError imports (layering).
+
+Design notes
+------------
+- A "user" IS a tenant row: ``tenants.id`` is the account id. Email and
+  display_name live on ``tenants``; the primary identity
+  (workspace_domain, is_primary) lives on ``tenant_identities``.
+- Team membership for a user is resolved via
+  ``team_role_assignments(member_kind='user', member_id=<tenant>)`` joined
+  through ``roles_catalog`` and ``teams``.
+- All queries are intentionally cross-tenant by design: admin tools run under
+  ``system_tx`` (the ``mem_maint`` role, which has BYPASSRLS in prod) and the
+  system_admin permission gate is enforced by ``AdminTool`` before calling in.
+  This file is therefore listed in ``tools/lint_tenant_scope.py``'s exemption
+  list: there is no single caller tenant to filter on.
+
+Note on the ``teams`` JOIN: ``teams`` carries FORCE RLS with a
+``teams_select`` policy built on ``safe_current_tenant_id()`` (migration
+0034, NULLIF-guarded so a bare cast on the empty-string GUC no longer crashes).
+Under ``system_tx`` as ``mem_maint`` (BYPASSRLS) the policy is bypassed and
+rows are returned normally; under a rolled-back ``tenant_tx`` the GUC reads
+``''`` and ``safe_current_tenant_id()`` yields NULL without raising.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime
+from typing import TYPE_CHECKING
+from uuid import UUID
+
+from pydantic import BaseModel, ConfigDict
+
+from mem_mcp.admin.errors import InvalidQueryError, NotFoundError
+
+if TYPE_CHECKING:
+    import asyncpg  # type: ignore[import-untyped]
+
+
+DEFAULT_LIMIT = 20
+MIN_LIMIT = 1
+MAX_LIMIT = 100
+
+
+class AdminUserSummary(BaseModel):
+    """Compact user (tenant) record returned by find_users and as the header of get_user."""
+
+    model_config = ConfigDict(extra="forbid")
+    id: str
+    email: str
+    display_name: str | None = None
+    status: str | None = None
+    tier: str | None = None
+    created_at: datetime | None = None
+    workspace_domain: str | None = None
+    is_primary: bool | None = None
+
+
+class AdminUserTeam(BaseModel):
+    """A team the user belongs to, with their role in it."""
+
+    model_config = ConfigDict(extra="forbid")
+    team_id: str
+    name: str
+    role: str
+
+
+class AdminUserDetail(BaseModel):
+    """Full admin record for a single user."""
+
+    model_config = ConfigDict(extra="forbid")
+    summary: AdminUserSummary
+    system_roles: list[str]
+    teams: list[AdminUserTeam]
+
+
+def _escape_like(value: str) -> str:
+    """Escape LIKE metacharacters for a backslash-escaped ILIKE pattern.
+
+    Backslash is escaped first (otherwise the escapes we add below would
+    themselves be doubled), then ``%`` and ``_``.
+    """
+    return value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+
+
+def _clamp_limit(limit: int | None) -> int:
+    """Coerce a caller-supplied page size to [MIN_LIMIT, MAX_LIMIT]; None → default.
+
+    Never raises: out-of-range values are clamped rather than rejected so the
+    service stays usable from contexts that didn't pre-validate. The tool
+    layer independently enforces [1, 100] via the pydantic schema.
+    """
+    if limit is None:
+        return DEFAULT_LIMIT
+    return max(MIN_LIMIT, min(limit, MAX_LIMIT))
+
+
+def _row_to_summary(row: asyncpg.Record) -> AdminUserSummary:
+    return AdminUserSummary(
+        id=str(row["tenant_id"]),
+        email=row["email"],
+        display_name=row["display_name"],
+        status=row["status"],
+        tier=row["tier"],
+        created_at=row["created_at"],
+        workspace_domain=row["workspace_domain"],
+        is_primary=row["is_primary"],
+    )
+
+
+async def find_users(
+    conn: asyncpg.Connection,
+    query: str,
+    limit: int | None = None,
+) -> list[AdminUserSummary]:
+    """Search all tenants by email or display_name substring (cross-tenant).
+
+    A LEFT JOIN keeps tenants that have no primary identity so an account
+    with no identity yet is still discoverable. Matches are ILIKE with a
+    backslash escape; the pattern is built with ``_escape_like`` before being
+    wrapped in ``%...%``.
+
+    Args:
+        conn: a connection running under ``system_tx`` (cross-tenant).
+        query: email/display-name substring; must be >= 2 chars after strip.
+        limit: page size, clamped to [1, 100] (None → 20).
+
+    Raises:
+        InvalidQueryError: if ``query`` is fewer than 2 non-whitespace chars.
+    """
+    if len(query.strip()) < 2:
+        raise InvalidQueryError("query must be at least 2 characters")
+    like = "%" + _escape_like(query) + "%"
+    n = _clamp_limit(limit)
+    rows = await conn.fetch(
+        """
+        SELECT t.id AS tenant_id, t.email, t.display_name, t.status,
+               t.tier, t.created_at,
+               ti.workspace_domain, ti.is_primary
+        FROM tenants t
+        LEFT JOIN tenant_identities ti
+          ON ti.tenant_id = t.id AND ti.is_primary
+        WHERE t.email ILIKE $1 ESCAPE '\\'
+           OR t.display_name ILIKE $1 ESCAPE '\\'
+        ORDER BY t.created_at DESC, t.id
+        LIMIT $2
+        """,
+        like,
+        n,
+    )
+    return [_row_to_summary(r) for r in rows]
+
+
+async def get_user(
+    conn: asyncpg.Connection,
+    tenant_id: UUID,
+) -> AdminUserDetail:
+    """Fetch a single user's full record: summary + system roles + teams.
+
+    ``system_roles`` come from ``tenant_system_roles`` (no RLS); ``teams``
+    from ``team_role_assignments`` joined through ``roles_catalog`` and
+    ``teams`` (FILTERED to active assignments on non-deleted teams).
+
+    Args:
+        conn: a connection running under ``system_tx`` (cross-tenant).
+        tenant_id: the user's tenant/account id.
+
+    Raises:
+        NotFoundError: if no tenant row matches ``tenant_id``.
+    """
+    row = await conn.fetchrow(
+        """
+        SELECT t.id AS tenant_id, t.email, t.display_name, t.status,
+               t.tier, t.created_at,
+               ti.workspace_domain, ti.is_primary
+        FROM tenants t
+        LEFT JOIN tenant_identities ti
+          ON ti.tenant_id = t.id AND ti.is_primary
+        WHERE t.id = $1
+        """,
+        tenant_id,
+    )
+    if row is None:
+        raise NotFoundError(f"tenant not found: {tenant_id}")
+    summary = _row_to_summary(row)
+
+    sys_rows = await conn.fetch(
+        "SELECT role FROM tenant_system_roles WHERE tenant_id = $1 ORDER BY role",
+        tenant_id,
+    )
+    system_roles = [r["role"] for r in sys_rows]
+
+    team_rows = await conn.fetch(
+        """
+        SELECT t.id AS team_id, t.name, rc.role_key AS role
+        FROM team_role_assignments tra
+        JOIN roles_catalog rc ON rc.id = tra.role_id
+        JOIN teams t ON t.id = tra.parent_team_id
+        WHERE tra.member_kind = 'user'
+          AND tra.member_id = $1
+          AND tra.status = 'active'
+          AND t.deleted_at IS NULL
+        ORDER BY t.name
+        """,
+        tenant_id,
+    )
+    teams = [
+        AdminUserTeam(team_id=str(r["team_id"]), name=r["name"], role=r["role"])
+        for r in team_rows
+    ]
+    return AdminUserDetail(summary=summary, system_roles=system_roles, teams=teams)
