+
+# The stub subclasses below deliberately fail AdminTool.__init_subclass__ (or
+# abc) in a specific way. They use ClassVar[Permission] so they type-check as
+# valid attribute overrides of AdminTool's class variables; the validation
+# happens at runtime in __init_subclass__, not in mypy.
+class TestAdminToolGuards:
+    def test_requires_required_permission(self) -> None:
+        with pytest.raises(TypeError, match="must define required_permission"):
+
+            class _NoPerm(AdminTool):
+                name = "x"
+                audit_action = "admin.x"
+                InputModel = object  # type: ignore[assignment]
+                OutputModel = object  # type: ignore[assignment]
+
+    def test_rejects_team_scoped_permission(self) -> None:
+        with pytest.raises(ValueError, match="system-scoped"):
+
+            class _TeamPerm(AdminTool):
+                name = "x"
+                required_permission: ClassVar[Permission] = Permission.TEAM_VIEW
+                audit_action = "admin.x"
+                InputModel = object  # type: ignore[assignment]
+                OutputModel = object  # type: ignore[assignment]
+
+    def test_rejects_non_admin_audit_action(self) -> None:
+        with pytest.raises(ValueError, match="start with 'admin.'"):
+
+            class _BadAction(AdminTool):
+                name = "x"
+                required_permission: ClassVar[Permission] = Permission.SYSTEM_MANAGE_TENANTS
+                audit_action = "memory.write"
+                InputModel = object  # type: ignore[assignment]
+                OutputModel = object  # type: ignore[assignment]
+
+    def test_rejects_call_override(self) -> None:
+        with pytest.raises(TypeError, match="must not override __call__"):
+
+            class _CallOverride(AdminTool):
+                name = "x"
+                required_permission: ClassVar[Permission] = Permission.SYSTEM_MANAGE_TENANTS
+                audit_action = "admin.x"
+                InputModel = object  # type: ignore[assignment]
+                OutputModel = object  # type: ignore[assignment]
+
+                async def __call__(self, ctx: Any, inp: Any) -> Any:
+                    ...
+
+    def test_subclass_without_run_is_abstract(self) -> None:
+        # perm + action valid, but no run() → abc forbids instantiation.
+        with pytest.raises(TypeError, match="abstract"):
+
+            class _NoRun(AdminTool):
+                name = "x"
+                required_permission: ClassVar[Permission] = Permission.SYSTEM_MANAGE_TENANTS
+                audit_action = "admin.x"
+                InputModel = object  # type: ignore[assignment]
+                OutputModel = object  # type: ignore[assignment]
+
+            _NoRun()  # type: ignore[type-abstract]
+
+    def test_real_tools_instantiate(self) -> None:
+        assert AdminFindUserTool().name == "memsys_admin_find_user"
+        assert AdminGetUserTool().name == "memsys_admin_get_user"
+        assert AdminFindUserTool().audit_action == "admin.find_user"
+        assert AdminGetUserTool().audit_action == "admin.get_user"
+
+
+# --------------------------------------------------------------------------
+# Registration + transport scope gate
+# --------------------------------------------------------------------------
+
+
+class TestRegistration:
+    def test_tools_registered(self) -> None:
+        r = ToolRegistry()
+        r.register(AdminFindUserTool)
+        r.register(AdminGetUserTool)
+        names = r.names()
+        assert "memsys_admin_find_user" in names
+        assert "memsys_admin_get_user" in names
+
+    def test_list_definitions(self) -> None:
+        r = ToolRegistry()
+        r.register(AdminFindUserTool)
+        defs = {d["name"]: d for d in r.list_definitions()}
+        assert defs["memsys_admin_find_user"]["required_scope"] == "memory.read"
+        assert "query" in defs["memsys_admin_find_user"]["inputSchema"]["properties"]
+
+    async def test_scope_gate_fires_before_tool(self) -> None:
+        """No memory.read scope → -32000 insufficient_scope (no tool call)."""
+        r = ToolRegistry()
+        r.register(AdminFindUserTool)
+        ctx = _ctx(tenant_id=uuid4(), db_pool=MagicMock(), scopes=frozenset())
+        with pytest.raises(JsonRpcError) as exc_info:
+            await r.dispatch(ctx, "memsys_admin_find_user", {"query": "ab"})
+        assert exc_info.value.code == -32000
+        assert exc_info.value.data is not None
+        assert exc_info.value.data["code"] == "insufficient_scope"
+
+
+# --------------------------------------------------------------------------
+# DB-backed authorization + audit emission
+# --------------------------------------------------------------------------
+
+
+class TestAdminToolAuthz:
+    async def test_denied_without_system_role_audit_denied(
+        self, pg_pool: Any, admin_tenant: Any
+    ) -> None:
+        """No system_admin role → 32603 + a committed `denied` audit row."""
+        ctx = _ctx(admin_tenant, pg_pool)
+        tool = AdminFindUserTool()
+        with pytest.raises(JsonRpcError) as exc_info:
+            await tool(ctx, AdminFindUserInput(query="ab"))
+        assert exc_info.value.code == -32603
+        assert exc_info.value.data == {"missing_permission": "system.manage_tenants"}
+
+        row = await _audit_row(pg_pool, ctx)
+        assert row is not None
+        assert row["action"] == "admin.find_user"
+        assert row["result"] == "denied"
+        assert row["error_code"] is None
+
+    async def test_granted_audits_success(
+        self, pg_pool: Any, admin_tenant: Any
+    ) -> None:
+        """A system_admin caller's find succeeds + emits a `success` audit row."""
+        await _grant_system_admin(pg_pool, admin_tenant)
+        ctx = _ctx(admin_tenant, pg_pool)
+        tool = AdminFindUserTool()
+        # admin_tenant's email is `admin-tool-<tenant_id>@test.invalid`; the
+        # UUID tail is unique, so searching it matches exactly this tenant.
+        out = await tool(ctx, AdminFindUserInput(query=str(admin_tenant)[:8]))
+        assert out.count == 1  # type: ignore[attr-defined]
+        assert out.users[0].id == str(admin_tenant)  # type: ignore[attr-defined]
+        row = await _audit_row(pg_pool, ctx)
+        assert row is not None
+        assert row["action"] == "admin.find_user"
+        assert row["result"] == "success"
+
+    async def test_error_audit_on_not_found(
+        self, pg_pool: Any, admin_tenant: Any
+    ) -> None:
+        """get_user on a nonexistent tenant → 32602, with an `error` audit row."""
+        await _grant_system_admin(pg_pool, admin_tenant)
+        bogus = uuid4()
+        ctx = _ctx(admin_tenant, pg_pool)
+        tool = AdminGetUserTool()
+        with pytest.raises(JsonRpcError) as exc_info:
+            await tool(ctx, AdminGetUserInput(tenant_id=bogus))
+        assert exc_info.value.code == -32602
+        assert exc_info.value.data == {
+            "errors": [{"path": ["tenant_id"], "message": "user not found"}]
+        }
+        row = await _audit_row(pg_pool, ctx)
+        assert row is not None
+        assert row["action"] == "admin.get_user"
+        assert row["result"] == "error"
+        assert row["error_code"] == "-32602"
+
+    async def test_denied_before_lookup_no_existence_oracle(
+        self, pg_pool: Any, admin_tenant: Any
+    ) -> None:
+        """A denied caller must see 32603 regardless of whether the target exists.
+
+        Permission is checked (under system_tx) BEFORE the service lookup runs,
+        so a nonexistent tenant_id still yields `denied` (not `user not found`).
+        """
+        ctx = _ctx(admin_tenant, pg_pool)
+        tool = AdminGetUserTool()
+        with pytest.raises(JsonRpcError) as exc_info:
+            await tool(ctx, AdminGetUserInput(tenant_id=uuid4()))
+        assert exc_info.value.code == -32603
+        assert exc_info.value.data == {"missing_permission": "system.manage_tenants"}
+        row = await _audit_row(pg_pool, ctx)
+        assert row is not None
+        assert row["result"] == "denied"
