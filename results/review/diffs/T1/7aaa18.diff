+"""Security/authz tests for admin MCP tools.
+
+Verifies that:
+- Non-system-admin callers are denied with -32603 and exactly one
+  ``denied`` audit row.
+- system_admin callers succeed and get exactly one ``success`` audit row.
+- get_user on a nonexistent tenant returns -32602 and one ``error`` audit row.
+- Denied and error audit rows survive on their own system_tx (committed
+  independently of the run-tx rollback).
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.auth.rbac import has_permission
+from mem_mcp.db import system_tx
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools.admin_find_user import AdminFindUserInput, AdminFindUserTool
+from mem_mcp.mcp.tools.admin_get_user import AdminGetUserInput, AdminGetUserTool
+
+pytestmark = pytest.mark.security
+
+
+def _build_ctx(pg_pool: Any, tenant_id: UUID, identity_id: UUID, request_id: str) -> ToolContext:
+    """Build a ToolContext for a caller with memory.read scope, no deps."""
+    return ToolContext(
+        request_id=request_id,
+        tenant_id=tenant_id,
+        identity_id=identity_id,
+        client_id="test-security-client",
+        scopes=frozenset({"memory.read"}),
+        db_pool=pg_pool,
+        deps=None,  # triggers DbAuditLogger() fallback
+    )
+
+
