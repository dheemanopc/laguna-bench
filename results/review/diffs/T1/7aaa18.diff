+
+    @pytest.mark.asyncio
+    async def test_find_users_special_chars_dont_break_ilike(
+        self, pg_pool: Any
+    ) -> None:
+        """Query containing % or _ matches literally, not as LIKE wildcards."""
+        tid = uuid4()
+        iid = uuid4()
+        # The email literally contains a percent and underscore
+        raw = f"special-{uuid4()}"
+        literal_email = f"50%off_{raw}@test.invalid"
+
+        async with pg_pool.acquire() as conn:
+            try:
+                await conn.execute(
+                    "INSERT INTO tenants (id, email, status) VALUES ($1, $2, 'active')",
+                    tid, f"{tid}@test.invalid",
+                )
+                await conn.execute(
+                    """INSERT INTO tenant_identities
+                       (id, tenant_id, cognito_sub, provider, email, is_primary)
+                       VALUES ($1, $2, $3, 'cognito', $4, true)""",
+                    iid, tid, f"sub-{tid}", literal_email,
+                )
+
+                # Search for the literal email — should find exactly one.
+                async with system_tx(pg_pool) as sys_conn:
+                    results = await find_users(sys_conn, literal_email)
+
+                assert len(results) == 1
+                assert results[0].identity_email == literal_email
+
+                # A bare "%" query should NOT match everything (it's escaped).
+                # With ESCAPE '\', "%" becomes "\%", so LIKE matches only rows
+                # whose email/display_name literally contains "%". Only our
+                # inserted row has that, so exactly 1 result (not 0, not all).
+                async with system_tx(pg_pool) as sys_conn:
+                    pct_results = await find_users(sys_conn, "%")
+                assert len(pct_results) == 1
+                assert pct_results[0].identity_email == literal_email
+            finally:
+                await conn.execute("DELETE FROM tenant_identities WHERE id = $1", iid)
+                await conn.execute("DELETE FROM tenants WHERE id = $1", tid)
+
+    @pytest.mark.asyncio
+    async def test_find_users_limit_clamping(
+        self, pg_pool: Any
+    ) -> None:
+        """Limit above MAX_LIMIT is clamped; limit=1 returns at most 1."""
+        # Insert 5 matching tenants.
+        marker = f"clamp-{uuid4()}"
+        tenant_ids: list[UUID] = []
+        try:
+            for i in range(5):
+                tid = uuid4()
+                iid = uuid4()
+                tenant_ids.append(tid)
+                async with pg_pool.acquire() as conn:
+                    await conn.execute(
+                        "INSERT INTO tenants (id, email, status) VALUES ($1, $2, 'active')",
+                        tid, f"{marker}-{i}@test.invalid",
+                    )
+                    await conn.execute(
+                        """INSERT INTO tenant_identities
+                           (id, tenant_id, cognito_sub, provider, email, is_primary)
+                           VALUES ($1, $2, $3, 'cognito', $4, true)""",
+                        iid, tid, f"sub-{tid}", f"{marker}-{i}@test.invalid",
+                    )
+
+            async with system_tx(pg_pool) as conn:
+                # MAX_LIMIT + 1 should be clamped to MAX_LIMIT
+                results = await find_users(conn, marker, limit=999)
+                assert len(results) <= 100  # MAX_LIMIT
+
+                # limit=1
+                results = await find_users(conn, marker, limit=1)
+                assert len(results) == 1
+        finally:
+            for tid in tenant_ids:
+                async with pg_pool.acquire() as conn:
+                    await conn.execute("DELETE FROM tenant_identities WHERE tenant_id = $1", tid)
+                    await conn.execute("DELETE FROM tenants WHERE id = $1", tid)
+
