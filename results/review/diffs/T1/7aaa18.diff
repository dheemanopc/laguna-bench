+class TestFindUsers:
+    """Tests for find_users()."""
+
+    @pytest.mark.asyncio
+    async def test_find_users_returns_matching(self, pg_pool: Any) -> None:
+        """Search by email fragment returns matching tenants."""
+        tid1 = uuid4()
+        tid2 = uuid4()
+        iid1 = uuid4()
+        iid2 = uuid4()
+        marker = f"find-svc-{uuid4()}"
+
+        async with pg_pool.acquire() as conn:
+            try:
+                await conn.execute(
+                    "INSERT INTO tenants (id, email, status, display_name) "
+                    "VALUES ($1, $2, 'active', $3), ($4, $5, 'active', $6)",
+                    tid1, f"{marker}-a@test.invalid", f"User A {marker}",
+                    tid2, f"{marker}-b@test.invalid", f"User B {marker}",
+                )
+                await conn.execute(
+                    """INSERT INTO tenant_identities
+                       (id, tenant_id, cognito_sub, provider, email, is_primary, last_seen_at)
+                       VALUES ($1, $2, $3, 'cognito', $4, true, now()),
+                              ($5, $6, $7, 'cognito', $8, true, now())""",
+                    iid1, tid1, f"sub-{tid1}", f"{marker}-a@test.invalid",
+                    iid2, tid2, f"sub-{tid2}", f"{marker}-b@test.invalid",
+                )
+
+                async with system_tx(pg_pool) as sys_conn:
+                    results = await find_users(sys_conn, marker)
+
+                assert len(results) == 2
+                returned_ids = {r.tenant_id for r in results}
+                assert returned_ids == {tid1, tid2}
+                for r in results:
+                    assert r.is_primary is True
+                    assert r.identity_email.endswith("@test.invalid")
+            finally:
+                await conn.execute("DELETE FROM tenant_identities WHERE id IN ($1, $2)", iid1, iid2)
+                await conn.execute("DELETE FROM tenants WHERE id IN ($1, $2)", tid1, tid2)
+
+    @pytest.mark.asyncio
+    async def test_find_users_no_match_returns_empty(self, pg_pool: Any) -> None:
+        """Search with no matches returns empty list."""
+        marker = f"no-match-{uuid4()}"
