@@ -0,0 +1,71 @@
+"""memsys_admin_get_user — cross-tenant identity detail (system_admin only).
+
+Fetch full detail for one tenant by id: primary identity, system role,
+and team memberships. Gated by the ``system.manage_tenants`` permission
+(checked in AdminTool.__call__).
+"""
+
+from __future__ import annotations
+
+from typing import Any, ClassVar
+from uuid import UUID
+
+from pydantic import BaseModel, ConfigDict, Field
+
+from mem_mcp.admin.errors import AdminError, NotFoundError
+from mem_mcp.admin.service import AdminUserDetail, get_user
+from mem_mcp.auth.permissions import Permission
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tool_descriptions import TOOL_DESCRIPTIONS
+from mem_mcp.mcp.tools._admin_base import AdminTool
+from mem_mcp.mcp.tools._base import ToolContext
+
+
+class AdminGetUserInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    tenant_id: UUID = Field(...)
+
+
+class AdminGetUserOutput(BaseModel):
+    user: AdminUserDetail
+    request_id: str
+
+
+class AdminGetUserTool(AdminTool):
+    """Fetch full detail for one tenant (system_admin only)."""
+
+    name: ClassVar[str] = "memsys_admin_get_user"
+    description: ClassVar[str] = TOOL_DESCRIPTIONS["memsys_admin_get_user"]
+    required_scope: ClassVar[str] = "memory.read"
+    InputModel: ClassVar[type[BaseModel]] = AdminGetUserInput
+    OutputModel: ClassVar[type[BaseModel]] = AdminGetUserOutput
+    required_permission: ClassVar[str] = Permission.SYSTEM_MANAGE_TENANTS.value
+    audit_action: ClassVar[str] = "admin.get_user"
+    audit_target: ClassVar[str | None] = "user"
+
+    def _audit_target_id(
+        self, ctx: ToolContext, inp: BaseModel, exc: BaseException | None = None
+    ) -> UUID | None:
+        """The audited target is the tenant_id the caller asked about."""
+        if isinstance(inp, AdminGetUserInput):
+            return inp.tenant_id
+        return None
+
+    async def run(self, ctx: ToolContext, inp: BaseModel, conn: Any) -> BaseModel:
+        assert isinstance(inp, AdminGetUserInput)
+        try:
+            user = await get_user(conn, inp.tenant_id)
+        except NotFoundError as exc:
+            raise JsonRpcError(
+                -32602,
+                "tenant not found",
+                data={"errors": [{"path": "tenant_id", "message": str(exc)}]},
+            ) from exc
+        except (AdminError, ValueError) as exc:
+            raise JsonRpcError(
+                -32602,
+                "invalid tenant_id",
+                data={"errors": [{"path": "tenant_id", "message": str(exc)}]},
+            ) from exc
+        return AdminGetUserOutput(user=user, request_id=ctx.request_id)
