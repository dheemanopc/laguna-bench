+"""Exceptions raised by the admin service layer.
+
+These are domain exceptions (like ``RoleNotFoundError`` in teams/roles.py) —
+they carry NO FastAPI/JsonRpcError knowledge. The MCP tool layer maps each
+to the appropriate JSON-RPC error code.
+"""
+
+from __future__ import annotations
+
+
+class AdminError(Exception):
+    """Base exception for admin service failures (validation, bad input)."""
+
+
+class NotFoundError(AdminError):
+    """Requested resource (tenant/identity) was not found."""
diff --git a/src/mem_mcp/admin/service.py b/src/mem_mcp/admin/service.py
new file mode 100644
index 0000000..d0a8519
--- /dev/null
+++ b/src/mem_mcp/admin/service.py
@@ -0,0 +1,237 @@
+"""Cross-tenant admin lookup service.
+
+Read-only DB functions for system_admin operators to find and inspect tenant
+identities. Runs entirely under ``system_tx`` (no tenant GUC) and never reads
+``app.current_tenant_id`` — the caller's system permission is enforced at the
+tool layer (AdminTool.__call__) before any of these functions run.
+
+Tables queried (all non-RLS or queried without tenant scoping under system_tx):
+    tenants, tenant_identities, tenant_system_roles, teams,
+    team_role_assignments, roles_catalog.
+
+Design notes:
+- ``find_users`` searches tenant_identities.email ILIKE (primary lookup target)
+  plus tenants.email and tenants.display_name for cross-reference. The caller's
+  permission check guarantees they're a system_admin; no per-row ACL is applied.
+- ``get_user`` looks up a single tenant by id, returns its primary identity +
+  system role + team memberships. Nonexistent tenant → NotFoundError.
+- LIKE escape: PG LIKE with ESCAPE '\\' requires the escape char to survive
+  Python string parsing AND PG string parsing. In a normal triple-quoted
+  Python string, ``\\`` → single backslash in the SQL text; with
+  ``standard_conforming_strings=on`` (PG16 default) that backslash is the
+  escape char. _escape_like must escape backslash FIRST, then %, then _.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+from uuid import UUID
+
+from pydantic import BaseModel
+
+from mem_mcp.admin.errors import AdminError, NotFoundError
+
+if TYPE_CHECKING:
+    import asyncpg  # type: ignore[import-untyped]
+
+
+DEFAULT_LIMIT: int = 20
+MAX_LIMIT: int = 100
+
+
+class AdminUserTeam(BaseModel):
+    """A team the target tenant belongs to, with their role."""
+
+    team_id: UUID
+    name: str
+    role_key: str
+    role_display_name: str | None
+
+
+class AdminUserSummary(BaseModel):
+    """One row from find_users — a compact identity + system-role snapshot."""
+
+    tenant_id: UUID
+    display_name: str | None
+    email: str | None
+    identity_email: str
+    is_primary: bool
+    system_role: str | None
+    last_seen_at: Any | None  # TIMESTAMPTZ → datetime or None
+
+
+class AdminUserDetail(BaseModel):
+    """Full detail for a single tenant from get_user."""
+
+    tenant_id: UUID
+    display_name: str | None
+    email: str | None
+    status: str
+    tier: str
+    identity_email: str
+    identity_id: UUID
+    is_primary: bool
+    system_role: str | None
+    last_seen_at: Any | None
+    teams: list[AdminUserTeam]
+
+
+def _escape_like(value: str) -> str:
+    r"""Escape a string for use as a literal operand inside ``LIKE`` / ``ESCAPE '\\'``.
+
+    PostgreSQL LIKE treats ``\\`` as the escape character (when ESCAPE '\\' is
+    specified), so a literal backslash in the user's input must become ``\\\\``
+    (escaped backslash → matches one backslash), and literal ``%`` / ``_``
+    must become ``\%`` / ``\_``.
+
+    Order matters: backslash first (so we don't double-escape the backslashes
+    we introduce for % and _), then %, then _.
+    """
+    # Backslash first, then %, then _.  str.replace is left-to-right so escaping
+    # the backslash first prevents us from re-escaping the \% and \_ we add.
+    value = value.replace("\\", "\\\\")
+    value = value.replace("%", "\\%")
+    value = value.replace("_", "\\_")
+    return value
+
+
+def _clamp_limit(limit: int) -> int:
+    """Clamp a caller-supplied limit to [1, MAX_LIMIT]; defaults to DEFAULT_LIMIT when < 1."""
+    if limit < 1:
+        return DEFAULT_LIMIT
+    if limit > MAX_LIMIT:
+        return MAX_LIMIT
+    return limit
+
+
+async def find_users(
+    conn: asyncpg.Connection,
+    query: str,
+    *,
+    limit: int = DEFAULT_LIMIT,
+) -> list[AdminUserSummary]:
+    """Cross-tenant identity search.
+
+    Searches tenant_identities.email (ILIKE) plus tenants.email and
+    tenants.display_name as secondary signals. Returns rows ordered by
+    last_seen_at DESC (most-recently-active first), capped at the clamped limit.
+
+    Raises:
+        AdminError: if ``query`` is empty after stripping.
+    """
+    stripped = query.strip()
+    if not stripped:
+        raise AdminError("query must not be empty")
+
+    clamped = _clamp_limit(limit)
+    pattern = f"%{_escape_like(stripped)}%"
+
+    rows = await conn.fetch(
+        """
+        SELECT t.id                        AS tenant_id,
+               t.display_name              AS display_name,
+               t.email                     AS tenant_email,
+               ti.email                    AS identity_email,
+               ti.is_primary               AS is_primary,
+               ti.last_seen_at             AS last_seen_at,
+               tsr.role                    AS system_role
+        FROM tenants t
+        JOIN tenant_identities ti ON ti.tenant_id = t.id
+        LEFT JOIN tenant_system_roles tsr ON tsr.tenant_id = t.id
+        WHERE ti.email ILIKE $1 ESCAPE '\\'
+           OR t.email ILIKE $1 ESCAPE '\\'
+           OR t.display_name ILIKE $1 ESCAPE '\\'
+        ORDER BY ti.last_seen_at DESC NULLS LAST
+        LIMIT $2
+        """,
+        pattern,
+        clamped,
+    )
+
+    return [
+        AdminUserSummary(
+            tenant_id=r["tenant_id"],
+            display_name=r["display_name"],
+            email=r["tenant_email"],
+            identity_email=r["identity_email"],
+            is_primary=r["is_primary"],
+            system_role=r["system_role"],
+            last_seen_at=r["last_seen_at"],
+        )
+        for r in rows
+    ]
+
+
+async def get_user(
+    conn: asyncpg.Connection, tenant_id: UUID
+) -> AdminUserDetail:
+    """Fetch full detail for a single tenant by id.
+
+    Returns the tenant's primary identity, system role (if any), and team
+    memberships (active assignments only, joining roles_catalog for the
+    role_key/display_name). Soft-deleted teams are excluded.
+
+    Raises:
+        NotFoundError: if no tenant with the given id exists.
+    """
+    row = await conn.fetchrow(
+        """
+        SELECT t.id            AS tenant_id,
+               t.display_name  AS display_name,
+               t.email         AS tenant_email,
+               t.status        AS status,
+               t.tier          AS tier,
+               ti.id           AS identity_id,
+               ti.email        AS identity_email,
+               ti.is_primary   AS is_primary,
+               ti.last_seen_at AS last_seen_at,
+               tsr.role        AS system_role
+        FROM tenants t
+        JOIN tenant_identities ti ON ti.tenant_id = t.id AND ti.is_primary = true
+        LEFT JOIN tenant_system_roles tsr ON tsr.tenant_id = t.id
+        WHERE t.id = $1
+        """,
+        tenant_id,
+    )
+    if row is None:
+        raise NotFoundError(f"tenant not found: {tenant_id}")
+
+    team_rows = await conn.fetch(
+        """
+        SELECT t.id                               AS team_id,
+               t.name                             AS name,
+               rc.role_key                        AS role_key,
+               rc.display_name                    AS role_display_name
+        FROM team_role_assignments tra
+        JOIN teams t ON t.id = tra.parent_team_id
+        JOIN roles_catalog rc ON rc.id = tra.role_id
+        WHERE tra.member_kind = 'user'
+          AND tra.member_id = $1
+          AND tra.status = 'active'
+          AND t.deleted_at IS NULL
+        ORDER BY t.name
+        """,
+        tenant_id,
+    )
+
+    return AdminUserDetail(
+        tenant_id=row["tenant_id"],
+        display_name=row["display_name"],
+        email=row["tenant_email"],
+        status=row["status"],
+        tier=row["tier"],
+        identity_email=row["identity_email"],
+        identity_id=row["identity_id"],
+        is_primary=row["is_primary"],
+        last_seen_at=row["last_seen_at"],
+        system_role=row["system_role"],
+        teams=[
+            AdminUserTeam(
+                team_id=tr["team_id"],
+                name=tr["name"],
+                role_key=tr["role_key"],
+                role_display_name=tr["role_display_name"],
+            )
+            for tr in team_rows
+        ],
+    )
