+"""DB-free unit tests for admin service helpers (_escape_like, _clamp_limit).
+
+No database required — these test the pure-Python escaping and limit-clamping
+logic directly.
+"""
+
+from __future__ import annotations
+
+from mem_mcp.admin.service import DEFAULT_LIMIT, MAX_LIMIT, _clamp_limit, _escape_like
+
+
+class TestEscapeLike:
+    """Tests for _escape_like — must backslash-escape \\, %, then _."""
+
+    def test_plain_string_unchanged(self) -> None:
+        assert _escape_like("alice") == "alice"
+
+    def test_percent_escaped(self) -> None:
+        assert _escape_like("50%off") == "50\\%off"
+
+    def test_underscore_escaped(self) -> None:
+        assert _escape_like("user_name") == "user\\_name"
+
+    def test_backslash_escaped(self) -> None:
+        # A literal backslash becomes an escaped backslash.
+        assert _escape_like("back\\slash") == "back\\\\slash"
+
+    def test_all_three_escaped_in_order(self) -> None:
+        # Combined: input contains \, %, _ — all must be escaped.
+        result = _escape_like("a\\b%c_d")
+        assert result == "a\\\\b\\%c\\_d"
+
+    def test_empty_string(self) -> None:
+        assert _escape_like("") == ""
+
+    def test_only_special_chars(self) -> None:
+        assert _escape_like("\\%_") == "\\\\\\%\\_"
+
+    def test_backslash_then_percent_not_double_escaped(self) -> None:
+        # Escaping backslash first means the \% we add for % is not
+        # double-escaped (no \\\\%).
+        result = _escape_like("%")
+        assert result == "\\%"
+        # The result has exactly one backslash before the %, not two.
+        assert result.count("\\") == 1
+
+    def test_like_match_round_trip_semantics(self) -> None:
+        """Escaped pattern '50\\%off' used with LIKE ... ESCAPE '\\' matches literal '50%off'."""
+        # We can't test SQL here (no DB), but verify the escape produces what
+        # PG LIKE expects: \\\\ matches a literal \, \\% matches literal %.
+        # The key invariant: _escape_like(x) used as a LIKE pattern with
+        # ESCAPE '\' matches x literally.
+        escaped = _escape_like("100%_\\sure")
+        # Each special char got exactly one backslash prefix; the original
+        # backslash got doubled.
+        assert escaped == "100\\%\\_\\\\sure"
+
+
+class TestClampLimit:
+    """Tests for _clamp_limit — must clamp to [1, MAX_LIMIT]."""
+
+    def test_default_on_zero(self) -> None:
+        assert _clamp_limit(0) == DEFAULT_LIMIT
+
+    def test_default_on_negative(self) -> None:
+        assert _clamp_limit(-1) == DEFAULT_LIMIT
+        assert _clamp_limit(-100) == DEFAULT_LIMIT
+
+    def test_one_passes_through(self) -> None:
+        assert _clamp_limit(1) == 1
+
+    def test_max_passes_through(self) -> None:
+        assert _clamp_limit(MAX_LIMIT) == MAX_LIMIT
+
+    def test_above_max_clamped(self) -> None:
+        assert _clamp_limit(MAX_LIMIT + 1) == MAX_LIMIT
+
+    def test_well_above_max_clamped(self) -> None:
+        assert _clamp_limit(10000) == MAX_LIMIT
+
+    def test_default_limit_value(self) -> None:
+        assert DEFAULT_LIMIT == 20
+
+    def test_max_limit_value(self) -> None:
+        assert MAX_LIMIT == 100
+
+
+class TestModuleConstants:
+    """Sanity-check the module-level constants."""
+
+    def test_constants_are_ints(self) -> None:
+        assert isinstance(DEFAULT_LIMIT, int)
+        assert isinstance(MAX_LIMIT, int)
+
+    def test_max_ge_default(self) -> None:
+        assert MAX_LIMIT >= DEFAULT_LIMIT
+        assert DEFAULT_LIMIT >= 1
