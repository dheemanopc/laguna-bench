+class TestFindUsersGucRegression:
+    """GUC regression test (per work order spec §5.6).
+
+    After a rolled-back ``tenant_tx`` sets ``app.current_tenant_id`` to the
+    tenant UUID and then ROLLBACKs (which leaves the GUC as '' per PG
+    semantics), a subsequent ``system_tx`` query must NOT read the GUC as if
+    a tenant is set. ``find_users`` under ``system_tx`` must still work
+    correctly because it never reads ``app.current_tenant_id`` in its SQL.
+
+    This test documents the bug class: a service that used
+    ``current_setting('app.current_tenant_id')`` in SQL would break after a
+    rolled-back tenant_tx. Our service doesn't use it.
+    """
+
+    @pytest.mark.asyncio
+    async def test_find_users_survives_rolled_back_tenant_tx(
+        self, pg_pool: Any
+    ) -> None:
+        """find_users works correctly after a rolled-back tenant_tx leaves GUC=''.
+
+        We deliberately trigger the GUC-empty-on-rollback state by opening a
+        tenant_tx and rolling it back (the tx errors or is cancelled), then
+        confirm find_users still returns correct cross-tenant results.
+        """
+        tid = uuid4()
+        iid = uuid4()
+        marker = f"guc-regress-{uuid4()}"
+
+        async with pg_pool.acquire() as conn:
+            try:
+                await conn.execute(
+                    "INSERT INTO tenants (id, email, status) VALUES ($1, $2, 'active')",
+                    tid, f"{marker}@test.invalid",
+                )
+                await conn.execute(
+                    """INSERT INTO tenant_identities
+                       (id, tenant_id, cognito_sub, provider, email, is_primary)
+                       VALUES ($1, $2, $3, 'cognito', $4, true)""",
+                    iid, tid, f"sub-{tid}", f"{marker}@test.invalid",
+                )
+
+                # Simulate a rolled-back tenant_tx: open one, then roll back.
+                # The local set_config('app.current_tenant_id', ...) is discarded
+                # by ROLLBACK, and read back as '' (not NULL).
+                try:
+                    async with tenant_tx(pg_pool, tid) as tx_conn:
+                        await tx_conn.fetchval("SELECT 1")
+                        raise RuntimeError("force rollback")
+                except RuntimeError:
+                    pass
+
+                # Now call find_users under a fresh system_tx — if it reads
+                # the GUC, it would either be '' (broken cast) or the stale
+                # value. Our service never reads the GUC, so it should work.
+                async with system_tx(pg_pool) as sys_conn:
+                    results = await find_users(sys_conn, marker)
+
+                assert len(results) == 1
+                assert results[0].tenant_id == tid
+                assert results[0].identity_email == f"{marker}@test.invalid"
+            finally:
+                await conn.execute("DELETE FROM tenant_identities WHERE id = $1", iid)
+                await conn.execute("DELETE FROM tenants WHERE id = $1", tid)
