diff --git a/src/mem_mcp/mcp/tools/_admin_base.py b/src/mem_mcp/mcp/tools/_admin_base.py
new file mode 100644
index 0000000..1e11682
--- /dev/null
+++ b/src/mem_mcp/mcp/tools/_admin_base.py
@@ -0,0 +1,216 @@
+"""AdminTool base — read-only cross-tenant admin tools for system_admin operators.
+
+This base class enforces a uniform authorization + audit contract for every
+admin tool:
+
+1. PERMISSION CHECK — a ``has_permission`` call against the caller's OWN
+   tenant (``ctx.tenant_id``) under ``system_tx``. If the caller lacks the
+   ``required_permission`` (a ``system.*`` perm), a fresh ``system_tx`` is
+   opened solely to commit a ``denied`` audit row (so it survives the
+   rollback of the permission-check tx), then a ``JsonRpcError(-32603,
+   missing_permission=...)`` is raised.
+
+2. AUTHORIZED EXECUTION — ``run()`` is invoked under ``system_tx``; on
+   success a single ``success`` audit row is written on the SAME connection
+   and commits with the result.
+
+3. ERROR PATH — if ``run()`` raises any exception, a fresh ``system_tx`` is
+   opened to commit an ``error`` audit row (surviving the rollback of the
+   run-tx), then the exception is re-raised (Registry catches JsonRpcError
+   and re-raises; everything else becomes -32603).
+
+Each call produces exactly ONE audit row: denied OR success OR error. The
+denied and error audits open a fresh ``system_tx`` because the failure path
+does not have a committed transaction to ride on — they must survive.
+
+``AdminError`` / ``NotFoundError`` from the service layer are caught in
+``run()`` by each concrete tool and mapped to ``JsonRpcError(-32602)`` there
+(success-audit never fires on a mapped error — the error audit does instead).
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any, ClassVar
+from uuid import UUID
+
+from pydantic import BaseModel
+
+from mem_mcp.audit.logger import AuditAction, DbAuditLogger
+from mem_mcp.auth.rbac import has_permission
+from mem_mcp.db import system_tx
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import BaseTool, ToolContext
+
+if TYPE_CHECKING:
+    import asyncpg  # type: ignore[import-untyped]
+
+
+def _resolve_audit_logger(ctx: ToolContext) -> Any:
+    """Return the audit logger from deps, or a bare DbAuditLogger fallback.
+
+    Mirrors the test-fixture pattern where tool_ctx fixtures don't wire
+    ``deps`` (ctx.deps is None). When deps is None or deps.audit is None,
+    fall back to a direct DbAuditLogger() so audit rows still hit the DB.
+    """
+    if ctx.deps is not None and ctx.deps.audit is not None:
+        return ctx.deps.audit
+    return DbAuditLogger()
+
+
+async def _write_audit(
+    ctx: ToolContext,
+    conn: asyncpg.Connection,
+    action: AuditAction,
+    result: str,
+    target_id: UUID | None,
+    target_kind: str | None,
+    details: dict[str, Any] | None,
+) -> None:
+    """Delegate to the resolved audit logger (async, must be awaited)."""
+    audit = _resolve_audit_logger(ctx)
+    await audit.audit(
+        conn,
+        action=action,
+        result=result,
+        tenant_id=ctx.tenant_id,
+        identity_id=ctx.identity_id,
+        client_id=ctx.client_id,
+        target_id=target_id,
+        target_kind=target_kind,
+        request_id=ctx.request_id,
+        details=details,
+    )
+
+
+class AdminTool(BaseTool):
+    """Base class for system_admin-only cross-tenant admin MCP tools.
+
+    Subclasses declare (as ClassVars, present in the subclass dict via
+    ``__init_subclass__`` validation):
+
+    - ``required_permission``: a ``system.*`` permission string
+      (e.g. ``"system.manage_tenants"``). Checked via
+      ``has_permission(conn, ctx.tenant_id, ...)``.
+    - ``audit_action``: a member of the ``AuditAction`` Literal.
+    - ``run``: the async body. Receives ``(ctx, inp, conn)`` where ``conn``
+      is a ``system_tx`` connection; returns a ``BaseModel``.
+
+    ``audit_target`` defaults to ``None`` and may be overridden as a ClassVar
+    or via the ``_audit_target_id`` hook for per-instance target resolution.
+    """
+
+    required_permission: ClassVar[str]
+    audit_action: ClassVar[str]
+    audit_target: ClassVar[str | None] = None
+
+    # Hook defaults — subclasses override to enrich audit rows.
+    def _audit_target_id(
+        self, ctx: ToolContext, inp: BaseModel, exc: BaseException | None = None
+    ) -> UUID | None:
+        """Override to return the target UUID for audit rows, if any."""
+        return None
+
+    def _audit_details_denied(self, ctx: ToolContext, inp: BaseModel) -> dict[str, Any]:
+        return {}
+
+    def _audit_details_success(self, ctx: ToolContext, inp: BaseModel) -> dict[str, Any]:
+        return {}
+
+    def _audit_details_error(
+        self, ctx: ToolContext, inp: BaseModel, exc: BaseException | None
+    ) -> dict[str, Any]:
+        if exc is None:
+            return {}
+        return {"exc_type": type(exc).__name__, "exc_message": str(exc)[:300]}
+
+    def __init_subclass__(cls, **kwargs: Any) -> None:
+        super().__init_subclass__(**kwargs)
+        # Enforce that concrete subclasses declare required_permission,
+        # audit_action, and run in their OWN dict — a typo or omission must
+        # fail loudly at class-definition time rather than silently skipping
+        # authorization.
+        for attr in ("required_permission", "audit_action", "run"):
+            if attr not in cls.__dict__:
+                raise TypeError(
+                    f"{cls.__name__} must define classvar/method '{attr}' in its body"
+                )
+
+    async def run(self, ctx: ToolContext, inp: BaseModel, conn: asyncpg.Connection) -> BaseModel:
+        """Override in subclass. Default raises to satisfy __init_subclass__."""
+        raise NotImplementedError
+
+    async def __call__(self, ctx: ToolContext, inp: BaseModel) -> BaseModel:
+        """Three-phase: permission check → run+success-audit / denied / error."""
+        # Phase 1 — permission check against the CALLER's own tenant.
+        # system_tx carries no tenant GUC; has_permission reads
+        # tenant_system_roles WHERE tenant_id = ctx.tenant_id.
+        async with system_tx(ctx.db_pool) as conn:
+            allowed = await has_permission(
+                conn, ctx.tenant_id, self.required_permission
+            )
+
+        if not allowed:
+            # Denied — write audit on a FRESH system_tx so it commits
+            # independently of the permission-check tx (which has no audit
+            # row to ride on and would roll back otherwise).
+            async with system_tx(ctx.db_pool) as conn:
+                await _write_audit(
+                    ctx,
+                    conn,
+                    action=self.audit_action,  # type: ignore[arg-type]
+                    result="denied",
+                    target_id=self._audit_target_id(ctx, inp),
+                    target_kind=self.audit_target,
+                    details=self._audit_details_denied(ctx, inp),
+                )
+            raise JsonRpcError(
+                -32603,
+                "caller lacks required system permission",
+                data={"missing_permission": self.required_permission},
+            )
+
+        # Phase 2 — authorized execution. run() + success audit ride the same
+        # system_tx connection, so they commit or roll back together.
+        try:
+            async with system_tx(ctx.db_pool) as conn:
+                result = await self.run(ctx, inp, conn)
+                await _write_audit(
+                    ctx,
+                    conn,
+                    action=self.audit_action,  # type: ignore[arg-type]
+                    result="success",
+                    target_id=self._audit_target_id(ctx, inp),
+                    target_kind=self.audit_target,
+                    details=self._audit_details_success(ctx, inp),
+                )
+            return result
+        except JsonRpcError as exc:
+            # run() mapped a domain exception to JsonRpcError (-32602 for
+            # not-found / invalid params). Write an error audit on a fresh tx
+            # so it survives the rollback of the run-tx, then re-raise.
+            async with system_tx(ctx.db_pool) as conn:
+                await _write_audit(
+                    ctx,
+                    conn,
+                    action=self.audit_action,  # type: ignore[arg-type]
+                    result="error",
+                    target_id=self._audit_target_id(ctx, inp),
+                    target_kind=self.audit_target,
+                    details=self._audit_details_error(ctx, inp, exc),
+                )
+            raise
+        except Exception as exc:
+            # Unexpected exception from run() or the audit call itself.
+            # Record an error audit on a fresh tx, then let the Registry
+            # catch + convert to -32603.
+            async with system_tx(ctx.db_pool) as conn:
+                await _write_audit(
+                    ctx,
+                    conn,
+                    action=self.audit_action,  # type: ignore[arg-type]
+                    result="error",
+                    target_id=self._audit_target_id(ctx, inp),
+                    target_kind=self.audit_target,
+                    details=self._audit_details_error(ctx, inp, exc),
+                )
+            raise
