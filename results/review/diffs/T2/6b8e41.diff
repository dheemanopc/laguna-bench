+            sdk = sdk_client_factory(tenant_id=setup["tenant"], plugin_id="test-refs-in")
+            target_id = await sdk.write(content="target", type="note")
+            source_id = await sdk.write(
+                content="source with ref",
+                type="note",
+                references=[ReferenceInput(target_uuid=target_id, reference_kind="cites")],
+            )
+
+            # Build context for refs_in tool
+            ctx = ToolContext(
+                request_id="test",
+                tenant_id=setup["tenant"],
+                identity_id=setup["tenant"],
+                client_id="test-refs-in",
+                scopes=["memory.read"],
+                db_pool=pg_pool,
+                deps=ToolDeps(
+                    embeddings=None, audit=NoopAuditLogger(), quotas=NoopQuotas()
+                ),
+            )
+            tool = RefsInTool()
+            result = await tool(ctx, RefsInInput(memory_id=target_id))
+            assert result.accessible_count == 1, f"got {result.accessible_count}"
+            assert result.inaccessible_count == 0
+            assert len(result.refs) == 1
+            assert str(result.refs[0].source_memory_id) == str(source_id)
+        finally:
+            if setup:
+                await _cleanup(pg_pool, [setup["tenant"]], [setup["team"]])
