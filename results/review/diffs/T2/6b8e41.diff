+"""Introduce user_can_read_memory(p_user_id, p_memory_id) for reference access checks.
+
+Symptom: A user provisioned via raw SQL (like the 0026 backfill — no
+team-management API call, no user_effective_team_access row) could write
+and read their own memory M1, but citing M1 in a second write via
+`references=[...]` was rejected with `memory_not_accessible`.
+
+Root cause: The references machinery (resolve_reference_target,
+check_hard_delete_with_filtered_citers, memsys_refs_in, memsys_refs_out)
+checked access via the user_effective_team_access (UETA) table alone. Raw-
+SQL-provisioned users have no UETA row for their own personal team, so
+access to their own memories was denied.
+
+Fix: Introduce a single shared memory-level access rule that mirrors the
+read path (memories_select RLS policy from migration 0033). User U can
+read memory M if:
+  1. M.tenant_id = U (owner), OR
+  2. M.visibility = 'team' AND U is an active member of M.team_id, OR
+  3. A UETA row exists for (U, M.team_id) (cross-team/cross-tenant grant)
+
+The SQL function takes explicit parameters (runs under system_tx with no
+tenant GUC). The Python domain helper in teams/references.py wraps it.
+
+All four reference-access sites updated to use the shared rule:
+1. resolve_reference_target (write-time validator)
+2. check_hard_delete_with_filtered_citers (per-citer filter)
+3. memsys_refs_in (source-memory access check)
+4. memsys_refs_out (target-memory access check)
+
+Revision ID: 0035_user_can_read_memory
+Revises: 0034_safe_current_tenant_id
+Create Date: 2026-06-01
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0035_user_can_read_memory"
+down_revision = "0034_safe_current_tenant_id"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    # SQL function: user_can_read_memory(p_user_id uuid, p_memory_id uuid) -> boolean
+    # Returns true if user U can read memory M; false otherwise.
+    # SECURITY DEFINER because it's called by application code that may not own
+    # the underlying tables. SET search_path ensures no attack surface.
+    # NOTE: does NOT filter on deleted_at. The rule mirrors the read path
+    # (memories_select RLS policy and memory_get by id), which also don't filter
+    # on deleted_at. resolve_reference_target handles deleted_at itself in its
+    # own lookups. This ensures soft-deleted citers of the caller are not
+    # counted as "inaccessible" in hard-delete checks.
+    op.execute(
+        sa.text("""
+CREATE FUNCTION user_can_read_memory(p_user_id uuid, p_memory_id uuid)
+RETURNS boolean
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = public
+AS $$
+    SELECT EXISTS(
+        SELECT 1 FROM memories m
+        WHERE m.id = p_memory_id
+          AND (
+              -- Owner: tenant_id matches
+              m.tenant_id = p_user_id
+              -- Team-visible + user is a member of the team
+              OR (
+                  m.visibility = 'team'
+                  AND EXISTS (
+                      SELECT 1 FROM team_members
+                      WHERE team_members.team_id = m.team_id
+                        AND team_members.tenant_id = p_user_id
+                        AND team_members.status = 'active'
+                  )
+              )
+              -- Cross-team/cross-tenant grant via UETA
+              OR EXISTS (
+                  SELECT 1 FROM user_effective_team_access
+                  WHERE user_id = p_user_id
+                    AND resource_team_id = m.team_id
+              )
+          )
+    )
+$$;
+        """)
+    )
+    op.execute(sa.text("GRANT EXECUTE ON FUNCTION user_can_read_memory(uuid, uuid) TO mem_app"))
+
+
+def downgrade() -> None:
+    op.execute(sa.text("DROP FUNCTION IF EXISTS user_can_read_memory(uuid, uuid)"))
