+"""Regression tests for user_can_read_memory() and reference access.
+
+A user provisioned via raw SQL (no user_effective_team_access row) must have
+access to their own memories when cited via references. These tests verify
+that the shared access rule correctly implements owner/team/UETA paths.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.audit.logger import NoopAuditLogger
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.refs_in import RefsInInput, RefsInOutput, RefsInTool
+from mem_mcp.mcp.tools.refs_out import RefsOutInput, RefsOutOutput, RefsOutTool
+from mem_mcp.mcp.tools.write import ReferenceInput
+from mem_mcp.plugins.contract import PluginValidationError
+from mem_mcp.teams.assignments import assign_role
+from mem_mcp.teams.references import (
+    HardDeleteBlockedError,
+    ReferenceTargetNotFoundError,
+    check_hard_delete_with_filtered_citers,
+    insert_reference,
+    resolve_reference_target,
+)
+from mem_mcp.teams.slugs import insert_slug_with_retry
+
+pytestmark = pytest.mark.asyncio
+
+
+async def _provision_user_like_backfill(conn: Any) -> dict[str, Any]:
+    """Tenant + personal team + owner assignment, via raw SQL (no UETA)."""
+    tenant = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"user-{uuid4()}@example.test",
+    )
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id, team_type) "
+        "VALUES ($1, $2, 'personal') RETURNING id",
+        f"team-{uuid4().hex[:8]}",
+        tenant,
+    )
+    owner_role_id = await conn.fetchval(
+        "SELECT id FROM roles_catalog WHERE role_key = 'owner' " "AND plugin_id IS NULL"
+    )
+    await conn.execute(
+        """INSERT INTO team_role_assignments
+        (parent_team_id, member_kind, member_id, role_id, status,
+         assigned_by_user_id)
+        VALUES ($1, 'user', $2, $3, 'active', $2)""",
+        team,
+        tenant,
+        owner_role_id,
+    )
+    await conn.execute(
+        """INSERT INTO tenant_identities
+        (tenant_id, cognito_sub, provider, email, is_primary,
+         default_team_id)
+        VALUES ($1, $2, 'cognito', $3, true, $4)""",
+        tenant,
+        f"sub-{tenant}",
+        f"id-{tenant}@example.test",
+        team,
+    )
+    return {"tenant": tenant, "team": team}
+
+
+async def _create_memory(conn: Any, tenant_id: UUID, team_id: UUID, content: str) -> UUID:
+    """Create a team-visible memory."""
+    mem_id: UUID = await conn.fetchval(
+        """INSERT INTO memories
+        (tenant_id, team_id, content, content_hash, embedding,
+         source_kind, type, visibility)
+        VALUES ($1, $2, $3, $4, array_fill(0::real, ARRAY[1024])::vector,
+                'api', 'note', 'team')
+        RETURNING id""",
+        tenant_id,
+        team_id,
+        content,
+        f"hash-{uuid4().hex}",
+    )
+    return mem_id
+
+
+async def _cleanup(
+    pool: Any,
+    tenants: list[UUID],
+    teams: list[UUID],
+    oauth_client_ids: list[str] | None = None,
+) -> None:
+    """Clean up all test data (order matters for FK constraints)."""
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            # Delete memory_references first
+            for t in tenants:
+                await conn.execute(
+                    """DELETE FROM memory_references
+                    WHERE source_memory_id IN
+                        (SELECT id FROM memories WHERE tenant_id = $1)
+                       OR target_memory_id IN
+                        (SELECT id FROM memories WHERE tenant_id = $1)""",
+                    t,
+                )
+            # Delete slugs before memories (FK constraint)
+            for tm in teams:
+                await conn.execute("DELETE FROM slugs WHERE team_id = $1", tm)
+            # Delete memories
+            for t in tenants:
+                await conn.execute("DELETE FROM memories WHERE tenant_id = $1", t)
+            # Delete oauth_clients after memories (FK constraint)
+            if oauth_client_ids:
+                for client_id in oauth_client_ids:
+                    await conn.execute("DELETE FROM oauth_clients WHERE id = $1", client_id)
+            # Delete user/access data
+            for t in tenants:
+                await conn.execute(
+                    """DELETE FROM user_effective_team_access
+                    WHERE user_id = $1""",
+                    t,
+                )
+                await conn.execute(
+                    """DELETE FROM team_role_assignments
+                    WHERE member_id = $1""",
+                    t,
+                )
+                await conn.execute(
+                    """DELETE FROM team_members
+                    WHERE tenant_id = $1""",
+                    t,
+                )
+                await conn.execute("DELETE FROM tenant_identities WHERE tenant_id = $1", t)
+            # Delete teams
+            for tm in teams:
+                await conn.execute("DELETE FROM teams WHERE id = $1", tm)
+            # Delete tenants last
+            for t in tenants:
+                await conn.execute("DELETE FROM tenants WHERE id = $1", t)
+
+
+def _stub_embedder() -> Any:
+    """Create a stub embedder that satisfies EmbeddingClient protocol."""
+    from dataclasses import dataclass
+
+    @dataclass
+    class StubEmbeddingClient:
+        async def embed(self, text: str) -> tuple[list[float], int]:
+            return [0.0] * 1024, len(text.split())
+
+    return StubEmbeddingClient()
+
+
+def _tool_ctx(pool: Any, tenant_id: UUID, client_id: str = "test-client") -> ToolContext:
+    """Build a ToolContext with proper types for testing."""
+    return ToolContext(
+        request_id="test",
+        tenant_id=tenant_id,
+        identity_id=tenant_id,
+        client_id=client_id,
+        scopes=frozenset(["memory.read"]),
+        db_pool=pool,
+        deps=ToolDeps(
+            embeddings=_stub_embedder(),
+            audit=NoopAuditLogger(),
+            quotas=NoopQuotas(),
+        ),
+    )
+
+
+class TestSqlFunctionDirectly:
+    """Test user_can_read_memory(p_user_id, p_memory_id) SQL function."""
+
+    async def test_owner_can_read_own_memory(self, pg_pool: Any) -> None:
+        """Owner (tenant_id match) reads own memory."""
+        setup = None
+        try:
+            async with pg_pool.acquire() as conn:
+                async with conn.transaction():
+                    setup = await _provision_user_like_backfill(conn)
+                    mem = await _create_memory(conn, setup["tenant"], setup["team"], "owner memory")
+                    result = await conn.fetchval(
+                        "SELECT user_can_read_memory($1, $2)",
+                        setup["tenant"],
+                        mem,
+                    )
+            assert result is True
+        finally:
+            if setup:
+                await _cleanup(pg_pool, [setup["tenant"]], [setup["team"]])
+
+    async def test_outsider_cannot_read_memory(self, pg_pool: Any) -> None:
+        """Outsider with no team/UETA access cannot read."""
+        owner = None
+        outsider = None
+        try:
+            async with pg_pool.acquire() as conn:
+                async with conn.transaction():
+                    owner = await _provision_user_like_backfill(conn)
+                    outsider = await _provision_user_like_backfill(conn)
+                    mem = await _create_memory(
+                        conn, owner["tenant"], owner["team"], "private memory"
+                    )
+                    result = await conn.fetchval(
+                        "SELECT user_can_read_memory($1, $2)",
+                        outsider["tenant"],
+                        mem,
+                    )
+            assert result is False
+        finally:
+            if owner and outsider:
+                await _cleanup(
+                    pg_pool,
+                    [owner["tenant"], outsider["tenant"]],
+                    [owner["team"], outsider["team"]],
+                )
+
+    async def test_team_member_can_read(self, pg_pool: Any) -> None:
+        """Team member (via team_members) can read team memory."""
+        owner = None
+        member = None
+        try:
+            async with pg_pool.acquire() as conn:
+                async with conn.transaction():
+                    owner = await _provision_user_like_backfill(conn)
+                    member = await _provision_user_like_backfill(conn)
+                    mem = await _create_memory(
+                        conn, owner["tenant"], owner["team"], "shared memory"
+                    )
+
+                    # Add member to owner's team
+                    await conn.execute(
+                        """INSERT INTO team_members
+                        (team_id, tenant_id, role, status,
+                         added_by_tenant_id)
+                        VALUES ($1, $2, 'member', 'active', $3)""",
+                        owner["team"],
+                        member["tenant"],
+                        owner["tenant"],
+                    )
+
+                    result = await conn.fetchval(
+                        "SELECT user_can_read_memory($1, $2)",
+                        member["tenant"],
+                        mem,
+                    )
+            assert result is True
+        finally:
+            if owner and member:
+                await _cleanup(
+                    pg_pool,
+                    [owner["tenant"], member["tenant"]],
+                    [owner["team"], member["team"]],
+                )
+
+    async def test_inactive_team_member_cannot_read(self, pg_pool: Any) -> None:
+        """Inactive team member cannot read team memory."""
+        owner = None
+        member = None
+        try:
+            async with pg_pool.acquire() as conn:
+                async with conn.transaction():
+                    owner = await _provision_user_like_backfill(conn)
