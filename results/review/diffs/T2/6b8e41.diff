+"""Regression tests for user_can_read_memory() and reference access (incident #17-references-own-memory).
+
+Raw-SQL-provisioned users (like the 0026 backfill — no team-management API,
+no user_effective_team_access row) must have access to their own memories
+when cited via references. This module tests:
+- SQL function user_can_read_memory() directly
+- resolve_reference_target with owner / cross-tenant / team access
+- check_hard_delete_with_filtered_citers with accessible/inaccessible split
+- memsys_refs_in / memsys_refs_out tools
+- Write path end-to-end opacity (same error for not-found vs no-access)
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopAuditLogger, NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.refs_in import RefsInInput, RefsInTool
+from mem_mcp.mcp.tools.refs_out import RefsOutInput, RefsOutTool
+from mem_mcp.mcp.tools.write import ReferenceInput
+from mem_mcp.plugins.contract import PluginValidationError
+from mem_mcp.teams.references import (
+    ReferenceTargetNotFoundError,
+    check_hard_delete_with_filtered_citers,
+    insert_reference,
+    resolve_reference_target,
+)
+
+pytestmark = pytest.mark.asyncio
+
+
+async def _provision_user_like_backfill(
+    conn: Any, plugin_ids: list[str] | None = None
+) -> dict[str, Any]:
+    """Tenant + personal team + owner assignment + primary identity, all via raw SQL."""
+    tenant = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"user-{uuid4()}@example.test",
+    )
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id, team_type) "
+        "VALUES ($1, $2, 'personal') RETURNING id",
+        f"team-{uuid4().hex[:8]}",
+        tenant,
+    )
+    owner_role_id = await conn.fetchval(
+        "SELECT id FROM roles_catalog WHERE role_key = 'owner' AND plugin_id IS NULL"
+    )
+    await conn.execute(
+        """
+        INSERT INTO team_role_assignments
+            (parent_team_id, member_kind, member_id, role_id, status, assigned_by_user_id)
+        VALUES ($1, 'user', $2, $3, 'active', $2)
+        """,
+        team,
+        tenant,
+        owner_role_id,
+    )
+    await conn.execute(
+        """
+        INSERT INTO tenant_identities
+        (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+        VALUES ($1, $2, 'cognito', $3, true, $4)
+        """,
+        tenant,
+        f"sub-{tenant}",
+        f"id-{tenant}@example.test",
+        team,
+    )
+    # Register oauth_clients for plugins that will use this user
+    if plugin_ids:
+        for plugin_id in plugin_ids:
+            await conn.execute(
+                """
+                INSERT INTO oauth_clients
+                (id, redirect_uris, scope, registration_payload, review_status)
+                VALUES ($1, ARRAY[]::text[], 'memory.read memory.write',
+                        '{}'::jsonb, 'auto_allowed')
+                ON CONFLICT (id) DO NOTHING
+                """,
+                f"plugin:{plugin_id}",
+            )
+    return {"tenant": tenant, "team": team}
+
+
+async def _create_memory(
+    conn: Any, tenant_id: UUID, team_id: UUID, content: str
+) -> UUID:
+    """Create a memory for a tenant."""
+    memory_id = await conn.fetchval(
+        """
+        INSERT INTO memories
+        (tenant_id, team_id, content, content_hash, embedding,
+         source_kind, type, visibility)
+        VALUES ($1, $2, $3, $4, array_fill(0::real, ARRAY[1024])::vector,
+                'api', 'note', 'team')
+        RETURNING id
+        """,
+        tenant_id,
+        team_id,
+        content,
+        "hash-" + content[:10],
+    )
+    return memory_id
+
+
+async def _cleanup(pool: Any, tenants: list[UUID], teams: list[UUID]) -> None:
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            for t in tenants:
+                await conn.execute(
+                    """
+                    DELETE FROM memory_references
+                    WHERE source_memory_id IN (SELECT id FROM memories WHERE tenant_id = $1)
+                       OR target_memory_id IN (SELECT id FROM memories WHERE tenant_id = $1)
+                    """,
+                    t,
+                )
+                await conn.execute("DELETE FROM memories WHERE tenant_id = $1", t)
+                await conn.execute("DELETE FROM tenant_identities WHERE tenant_id = $1", t)
+                await conn.execute("DELETE FROM team_role_assignments WHERE member_id = $1", t)
+            for tm in teams:
+                await conn.execute("DELETE FROM teams WHERE id = $1", tm)
+
