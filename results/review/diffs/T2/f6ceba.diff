+# ── Case 6: refs_in / refs_out filter inaccessible edges, keep owner edges ---
+
+
+async def test_refs_in_out_filter_inaccessible_keep_owner(
+    pg_pool: Any, sdk_client_factory: Any
+) -> None:
+    """For a raw-SQL-provisioned owner, refs_out drops edges whose target is
+    an inaccessible other-tenant memory, and refs_in drops edges whose source is,
+    while still returning the owner's own edges."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            owner = await _provision_user(conn, "wo1-refs-owner")
+            other = await _provision_user(conn, "wo1-refs-other")
+
+    sdk_owner = sdk_client_factory(tenant_id=owner["tenant"], plugin_id=_PLUGIN_ID)
+    sdk_other = sdk_client_factory(tenant_id=other["tenant"], plugin_id=_PLUGIN_ID)
+    try:
+        src = await sdk_owner.write("owner source memory", type="note")
+        own_target = await sdk_owner.write("owner target (accessible)", type="note")
+        other_mem = await sdk_other.write("other tenant memory (inaccessible)", type="note")
+
+        # Inject three citation edges directly (cross-team resolution is IT-08
+        # opaque, so we can't use sdk.write(references=...)).
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                # owner source -> owner target  (accessible)
+                await conn.execute(
+                    """
+                    INSERT INTO memory_references
+                    (source_memory_id, target_memory_id, target_team_id,
+                     target_fragment, reference_kind, refs_version)
+                    VALUES ($1, $2, $3, -1, 'cites', 'pinned')
+                    """,
+                    src,
+                    own_target,
+                    owner["team"],
+                )
+                # owner source -> other-tenant target  (inaccessible)
+                await conn.execute(
+                    """
+                    INSERT INTO memory_references
+                    (source_memory_id, target_memory_id, target_team_id,
+                     target_fragment, reference_kind, refs_version)
+                    VALUES ($1, $2, $3, -1, 'cites', 'pinned')
+                    """,
+                    src,
+                    other_mem,
+                    other["team"],
+                )
+                # other-tenant source -> owner source (inaccessible inbound)
+                await conn.execute(
+                    """
+                    INSERT INTO memory_references
+                    (source_memory_id, target_memory_id, target_team_id,
+                     target_fragment, reference_kind, refs_version)
+                    VALUES ($1, $2, $3, -1, 'cites', 'pinned')
+                    """,
+                    other_mem,
+                    src,
+                    owner["team"],
+                )
+
+        # refs_out: only the owner-to-owner edge survives.
+        out_edges = await sdk_owner.refs_out(src)
+        out_targets = {e.get("target_memory_id") for e in out_edges}
+        assert str(own_target) in out_targets
+        assert str(other_mem) not in out_targets
+        assert len(out_edges) == 1
+
+        # refs_in: the other-tenant inbound edge is filtered out.
+        in_edges = await sdk_owner.refs_in(src)
+        assert in_edges == []
+    finally:
+        await _cleanup(
+            pg_pool,
+            [owner["tenant"], other["tenant"]],
+            [owner["team"], other["team"]],
+        )
+
