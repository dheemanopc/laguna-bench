+async def test_null_team_memory_not_referenceable_cross_tenant(
+    pg_pool: Any,
+) -> None:
+    """A memory with team_id IS NULL is referenceable ONLY by its owner.
+    The old ``team_id IS NULL -> skip`` hole (grant access to anyone) is gone."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            owner = await _provision_user(conn, "wo1-null-owner")
+            stranger = await _provision_user(conn, "wo1-null-stranger")
+            # team_id NULL + visibility 'external' (consistency CHECK was dropped
+            # in 0026, so this is a legal row).
+            m_null = await _insert_memory_direct(
+                conn, tenant_id=owner["tenant"], team_id=None, visibility="external"
+            )
+
+    try:
+        # Owner resolves its own null-team memory.
+        async with pg_pool.acquire() as conn:
+            resolved = await resolve_reference_target(
+                conn, target_uuid=m_null, caller_user_id=owner["tenant"]
+            )
+        assert UUID(str(resolved["memory_id"])) == m_null
+
+        # Stranger is denied (team_id IS NULL -> no UETA branch -> owner-only).
+        async with pg_pool.acquire() as conn:
+            with pytest.raises(ReferenceTargetNotFoundError) as excinfo:
+                await resolve_reference_target(
+                    conn, target_uuid=m_null, caller_user_id=stranger["tenant"]
+                )
+        assert str(excinfo.value) == _OPAQUE_MSG
+    finally:
+        await _cleanup(
+            pg_pool,
+            [owner["tenant"], stranger["tenant"]],
+            [owner["team"], stranger["team"]],
+        )
