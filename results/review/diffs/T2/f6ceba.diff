+# ── Case 4: assign_role team access still works after the fix ───────────────
+
+
+async def test_assign_role_team_access_still_resolves(
+    pg_pool: Any, sdk_client_factory: Any
+) -> None:
+    """Granting a raw-provisioned user access to another team via `assign_role`
+    (which materialises UETA) still lets them resolve a memory in that team —
+    the fix doesn't regress the team-access gate."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            owner = await _provision_user(conn, "wo1-team-owner")
+            member = await _provision_user(conn, "wo1-team-member")
+
+            # A project team owned by `owner` (team_type 'project' is a valid
+            # value; 'shared' would violate the 0022 CHECK).
+            project_team = await conn.fetchval(
+                "INSERT INTO teams (name, created_by_tenant_id, team_type) "
+                "VALUES ($1, $2, 'project') RETURNING id",
+                f"wo1-project-{uuid4().hex[:8]}",
+                owner["tenant"],
+            )
+
+            # A memory owned by `owner` living on the project team.
+            m = await _insert_memory_direct(
+                conn,
+                tenant_id=owner["tenant"],
+                team_id=project_team,
+                visibility="team",
+            )
+
+            # assign_role (member_kind='user') sync-refreshes UETA for
+            # (member, project_team) immediately, in this same transaction.
+            await assign_role(
+                conn,
+                parent_team_id=project_team,
+                member_kind="user",
+                member_id=member["tenant"],
+                role_key="member",
+                assigned_by_user_id=owner["tenant"],
+            )
+
+    try:
+        # member now carries UETA on the project team -> resolves the owner's
+        # memory there despite being a different tenant.
+        async with pg_pool.acquire() as conn:
+            resolved = await resolve_reference_target(
+                conn, target_uuid=m, caller_user_id=member["tenant"]
+            )
+        assert UUID(str(resolved["memory_id"])) == m
+        assert resolved["team_id"] == project_team
+
+        # End-to-end through the write tool: the member can cite the owner's
+        # memory (write.py's resolve_reference_target now succeeds).
+        sdk_member = sdk_client_factory(
+            tenant_id=member["tenant"], plugin_id=_PLUGIN_ID
+        )
+        citer = await sdk_member.write(
+            "member cites owner's project-team memory",
+            type="note",
+            references=[ReferenceInput(target_uuid=m, reference_kind="cites")],
+        )
+        assert citer is not None
+    finally:
+        await _cleanup(
+            pg_pool,
+            [owner["tenant"], member["tenant"]],
+            [owner["team"], member["team"], project_team],
+        )
