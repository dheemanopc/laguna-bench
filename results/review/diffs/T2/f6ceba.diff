@@ -0,0 +1,86 @@
+"""SQL access predicate `memory_accessible_to(p_user_id, p_memory_id)`.
+
+Reference-access incident — raw-SQL-provisioned users (the path the 0026
+personal-team backfill takes: tenant + personal team + owner assignment +
+primary identity, with NO `assign_role` call) can `memory_get` their own memory
+but are rejected with `memory_not_accessible` when a *second* memory cites that
+first one via `references=[...]`.
+
+Root cause: `resolve_reference_target` (teams/references.py) gated cross-tenant
+reference resolution on a `user_effective_team_access` (UETA) row, but a
+raw-SQL-provisioned owner is the *owning tenant* of its personal-team memory
+and has NO UETA row for that team. The UETA-only check thus denied the owner
+its own memory. The same hole made `refs_in`/`refs_out`/`check_hard_delete`
+drop or mis-count citers that the owner should see.
+
+Fix: a single STABLE SECURITY-DEFINER SQL predicate that encodes the real
+access rule — the caller is the memory's owning tenant (``m.tenant_id =
+p_user_id``) OR holds an effective team-access row on the target's team
+(``m.team_id IS NOT NULL AND EXISTS (UETA)``). Because it is SECURITY DEFINER
+owned by the migration role (mem_maint, BYPASSRLS in prod / mem_test
+superuser in the test container) RLS cannot hide rows from the predicate
+itself; the tenant_id / UETA filter IS the gate. It deliberately does NOT read
+or filter ``deleted_at`` — callers keep their own deletion filters so that a
+deleted target remains indistinguishable from a missed one (IT-08 opacity:
+"not found" and "no access" collapse to the same outcome).
+
+The function is consumed inline at the four reference-access call sites
+(`resolve_reference_target`, `check_hard_delete_with_filtered_citers`,
+`get_inbound_refs`/`get_outbound_refs`) rather than behind a per-call Python
+wrapper, so each query resolves + authorises in one round-trip and miss /
+no-access / deleted targets raise the identical `ReferenceTargetNotFoundError`.
+
+Revision ID: 0035_memory_accessible_to
+Revises: 0034_safe_current_tenant_id
+Create Date: 2026-06-01
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0035_memory_accessible_to"
+down_revision = "0034_safe_current_tenant_id"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    op.execute(
+        sa.text(
+            """
+            CREATE OR REPLACE FUNCTION memory_accessible_to(p_user_id uuid, p_memory_id uuid)
+            RETURNS boolean
+            LANGUAGE sql
+            STABLE
+            SECURITY DEFINER
+            SET search_path = public
+            AS $$
+                SELECT EXISTS (
+                    SELECT 1
+                    FROM memories m
+                    WHERE m.id = p_memory_id
+                      AND p_user_id IS NOT NULL
+                      AND (
+                            m.tenant_id = p_user_id
+                            OR (
+                                m.team_id IS NOT NULL
+                                AND EXISTS (
+                                    SELECT 1 FROM user_effective_team_access uea
+                                    WHERE uea.user_id = p_user_id
+                                      AND uea.resource_team_id = m.team_id
+                                )
+                            )
+                      )
+                )
+            $$;
+            GRANT EXECUTE ON FUNCTION memory_accessible_to(uuid, uuid) TO mem_app;
+            """
+        )
+    )
+
+
+def downgrade() -> None:
+    op.execute(sa.text("DROP FUNCTION IF EXISTS memory_accessible_to(uuid, uuid)"))
