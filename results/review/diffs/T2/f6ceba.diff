+# ── Case 5: check_hard_delete filtered citers, owner sees own citer ──────────
+
+
+async def test_hard_delete_sees_own_citer_counts_stranger(pg_pool: Any) -> None:
+    """check_hard_delete_with_filtered_citers, for an owner with NO UETA:
+    own citer is accessible; a stranger's citer is counted only (inaccessible).
+
+    The HardDeleteBlockedError is allowed to propagate out of the transaction
+    (catching it with pytest.raises AROUND the tx, not inside), so
+    ``async with conn.transaction()`` rolls the fixture back on the passing
+    path — there's nothing to leave behind.
+    """
+    with pytest.raises(HardDeleteBlockedError) as exc:
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                owner = await _provision_user(conn, "wo1-del-owner")
+                stranger = await _provision_user(conn, "wo1-del-stranger")
+                target = await _insert_memory_direct(
+                    conn,
+                    tenant_id=owner["tenant"],
+                    team_id=owner["team"],
+                    content="target",
+                )
+                own_citer = await _insert_memory_direct(
+                    conn,
+                    tenant_id=owner["tenant"],
+                    team_id=owner["team"],
+                    content="own citer",
+                )
+                stranger_citer = await _insert_memory_direct(
+                    conn,
+                    tenant_id=stranger["tenant"],
+                    team_id=stranger["team"],
+                    content="stranger citer",
+                )
+
+                await insert_reference(
+                    conn,
+                    source_memory_id=own_citer,
+                    target_memory_id=target,
+                    target_team_id=owner["team"],
+                    reference_kind="cites",
+                )
+                await insert_reference(
+                    conn,
+                    source_memory_id=stranger_citer,
+                    target_memory_id=target,
+                    target_team_id=owner["team"],
+                    reference_kind="cites",
+                )
+
+                await check_hard_delete_with_filtered_citers(
+                    conn,
+                    target_memory_id=target,
+                    caller_user_id=owner["tenant"],
+                )
+    assert exc.value.accessible_citers == [own_citer]
+    assert exc.value.inaccessible_count == 1
+    assert stranger_citer not in exc.value.accessible_citers
+
