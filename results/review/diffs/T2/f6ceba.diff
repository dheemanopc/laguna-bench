+# ── Case 7: deleted target rejected opaquely (domain + SDK) ─────────────────
+
+
+async def test_deleted_target_rejected_opaquely(
+    pg_pool: Any, sdk_client_factory: Any
+) -> None:
+    """Soft-deleting the owned target must still surface as the opaque
+    'not found or not accessible' error at both the domain and SDK layers."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            owner = await _provision_user(conn, "wo1-del-target")
+            target = await _insert_memory_direct(
+                conn,
+                tenant_id=owner["tenant"],
+                team_id=owner["team"],
+                content="target soon deleted",
+            )
+
+    sdk_owner = sdk_client_factory(tenant_id=owner["tenant"], plugin_id=_PLUGIN_ID)
+    try:
+        # Soft-delete the target (direct SQL — it's the owner deleting its own).
+        async with pg_pool.acquire() as conn:
+            await conn.execute("UPDATE memories SET deleted_at = now() WHERE id = $1", target)
+
+        # Domain: resolve rejects with the opaque identity-no-leak message.
+        async with pg_pool.acquire() as conn:
+            with pytest.raises(ReferenceTargetNotFoundError) as excinfo:
+                await resolve_reference_target(
+                    conn, target_uuid=target, caller_user_id=owner["tenant"]
+                )
+        assert str(excinfo.value) == _OPAQUE_MSG
+
+        # SDK: citing the deleted target is rejected identically.
+        with pytest.raises(PluginValidationError) as ei:
+            await sdk_owner.write(
+                "citer of a deleted target",
+                type="note",
+                references=[ReferenceInput(target_uuid=target, reference_kind="cites")],
+            )
+        assert ei.value.code == "memory_not_accessible"
+        assert ei.value.message == _OPAQUE_MSG
+    finally:
+        await _cleanup(pg_pool, [owner["tenant"]], [owner["team"]])
