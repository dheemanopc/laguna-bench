+# ── Case 2: cross-tenant denial == miss (opaque), domain + SDK ──────────────
+
+
+async def test_cross_tenant_denial_matches_miss(pg_pool: Any, sdk_client_factory: Any) -> None:
+    """A different tenant referencing an owner's personal-team memory is
+    denied with the SAME message as a random-UUID miss (IT-08 opacity)."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            owner = await _provision_user(conn, "wo1-deny-owner")
+            stranger = await _provision_user(conn, "wo1-deny-stranger")
+            m_owner = await _insert_memory_direct(
+                conn, tenant_id=owner["tenant"], team_id=owner["team"]
+            )
+            miss_uuid = uuid4()
+
+    sdk_stranger = sdk_client_factory(tenant_id=stranger["tenant"], plugin_id=_PLUGIN_ID)
+    try:
+        # Domain layer: no-access vs miss -> identical ReferenceTargetNotFoundError.
+        err_no_access: ReferenceTargetNotFoundError | None = None
+        err_miss: ReferenceTargetNotFoundError | None = None
+        async with pg_pool.acquire() as conn:
+            try:
+                await resolve_reference_target(
+                    conn, target_uuid=m_owner, caller_user_id=stranger["tenant"]
+                )
+            except ReferenceTargetNotFoundError as e:
+                err_no_access = e
+            try:
+                await resolve_reference_target(
+                    conn, target_uuid=miss_uuid, caller_user_id=stranger["tenant"]
+                )
+            except ReferenceTargetNotFoundError as e:
+                err_miss = e
+        assert err_no_access is not None
+        assert err_miss is not None
+        assert str(err_no_access) == _OPAQUE_MSG
+        assert str(err_miss) == _OPAQUE_MSG
+        assert err_no_access.args == err_miss.args  # identical, not just same text
+
+        # SDK layer: both raise PluginValidationError(code="memory_not_accessible")
+        # with the identical message.
+        with pytest.raises(PluginValidationError) as ei_no_access:
+            await sdk_stranger.write(
+                "stranger cites owner's memory",
+                type="note",
+                references=[ReferenceInput(target_uuid=m_owner, reference_kind="cites")],
+            )
+        with pytest.raises(PluginValidationError) as ei_miss:
+            await sdk_stranger.write(
+                "stranger cites phantom",
+                type="note",
+                references=[
+                    ReferenceInput(target_uuid=miss_uuid, reference_kind="cites")
+                ],
+            )
+        assert (
+            ei_no_access.value.code
+            == ei_miss.value.code
+            == "memory_not_accessible"
+        )
+        assert ei_no_access.value.message == ei_miss.value.message == _OPAQUE_MSG
+    finally:
+        await _cleanup(
+            pg_pool,
+            [owner["tenant"], stranger["tenant"]],
+            [owner["team"], stranger["team"]],
+        )
+
