diff --git a/tests/integration/test_references_owner_access.py b/tests/integration/test_references_owner_access.py
new file mode 100644
index 0000000..d2300e7
--- /dev/null
+++ b/tests/integration/test_references_owner_access.py
@@ -0,0 +1,613 @@
+"""Reference-access incident: a raw-SQL-provisioned owner is denied its own memory.
+
+A user provisioned the "natural" backfill way (tenant + personal team + owner
+assignment + primary identity, with NO `assign_role` call and therefore NO
+`user_effective_team_access` rows) must be able to reference its OWN memory.
+The old UETA-only access check denied such an owner its own personal-team
+memory; the `memory_accessible_to()` predicate (migration 0035, "owning tenant
+OR effective team access") fixes this.
+
+Cases covered:
+  1. own-memory resolve succeeds — UUID path AND slug-tuple path.
+  2. cross-tenant denial raises the IDENTICAL opaque error/message as a random
+     UUID miss (domain exception + SDK PluginValidationError envelope).
+  3. a memory with team_id IS NULL is NOT referenceable by another tenant
+     (the old `team_id IS NULL -> skip` hole is closed), but the owner can
+     still resolve its own.
+  4. team access granted via `assign_role` (which fills UETA) still works after
+     the fix — i.e. the fix doesn't break the team-access path.
+  5. check_hard_delete_with_filtered_citers: an owner's own citer shows up in
+     accessible_citers, a stranger's citer is counted in inaccessible_count
+     (no UETA needed for the owner).
+  6. sdk.refs_in / sdk.refs_out filter out edges to/from an inaccessible
+     other-tenant memory, while returning the owner's own edges.
+  7. a soft-deleted target is rejected opaquely (same not-found/not-accessible
+     message) at both the domain and SDK layers.
+
+All provisioning mirrors `_provision_user_like_backfill` in
+`test_references_own_memory_repro.py` (raw SQL, no UETA), so these tests
+exercise the exact bug scenario end-to-end.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.mcp.tools.write import ReferenceInput
+from mem_mcp.plugins.contract import PluginValidationError
+from mem_mcp.teams.assignments import assign_role
+from mem_mcp.teams.references import (
+    HardDeleteBlockedError,
+    ReferenceTargetNotFoundError,
+    check_hard_delete_with_filtered_citers,
+    insert_reference,
+    resolve_reference_target,
+)
+
+pytestmark = pytest.mark.asyncio
+
+# Single synthetic plugin id used by every provisioned user here so the
+# oauth_clients FK row is shared (ON CONFLICT DO NOTHING makes that safe).
+_PLUGIN_ID = "owner-access"
+_OAUTH_CLIENT_ID = f"plugin:{_PLUGIN_ID}"
+_OPAQUE_MSG = "reference target not found or not accessible"
+
+
+async def _provision_user(conn: Any, label: str) -> dict[str, Any]:
+    """Tenant + personal team + owner assignment + primary identity via raw SQL
+    (the way the 0026 backfill provisioned existing users). No `assign_role`
+    call => NO `user_effective_team_access` rows for this user."""
+    tenant = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"{label}-{uuid4()}@example.test",
+    )
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id, team_type) "
+        "VALUES ($1, $2, 'personal') RETURNING id",
+        f"{label}-{uuid4().hex[:8]}",
+        tenant,
+    )
+    owner_role_id = await conn.fetchval(
+        "SELECT id FROM roles_catalog WHERE role_key = 'owner' AND plugin_id IS NULL"
+    )
+    await conn.execute(
+        """
+        INSERT INTO team_role_assignments
+            (parent_team_id, member_kind, member_id, role_id, status, assigned_by_user_id)
+        VALUES ($1, 'user', $2, $3, 'active', $2)
+        """,
+        team,
+        tenant,
+        owner_role_id,
+    )
+    await conn.execute(
+        """
+        INSERT INTO tenant_identities
+        (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+        VALUES ($1, $2, 'cognito', $3, true, $4)
+        """,
+        tenant,
+        f"sub-{label}-{tenant}",
+        f"{label}-{tenant}@example.test",
+        team,
+    )
+    await conn.execute(
+        """
+        INSERT INTO oauth_clients
+        (id, redirect_uris, scope, registration_payload, review_status)
+        VALUES ($1, ARRAY[]::text[], 'memory.read memory.write',
+                '{}'::jsonb, 'auto_allowed')
+        ON CONFLICT (id) DO NOTHING
+        """,
+        _OAUTH_CLIENT_ID,
+    )
+    return {"tenant": tenant, "team": team}
+
+
+async def _insert_memory_direct(
+    conn: Any,
+    *,
+    tenant_id: UUID,
+    team_id: UUID | None,
+    content: str = "c",
+    type: str = "note",
+    visibility: str = "team",
+) -> UUID:
+    mid = await conn.fetchval(
+        "INSERT INTO memories (tenant_id, team_id, content, content_hash, "
+        "embedding, source_kind, type, visibility) "
+        "VALUES ($1, $2, $3, $4, array_fill(0::real, ARRAY[1024])::vector, "
+        "'api', $5, $6) RETURNING id",
+        tenant_id,
+        team_id,
+        content,
+        f"hash-{uuid4().hex}",
+        type,
+        visibility,
+    )
+    assert isinstance(mid, UUID)
+    return mid
+
+
+async def _cleanup(pool: Any, tenants: list[UUID], teams: list[UUID]) -> None:
+    """FK-safe teardown for raw-provisioned tenants/teams (one pass)."""
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute(
+                """
+                DELETE FROM memory_references
+                WHERE target_team_id = ANY($1::uuid[])
+                   OR source_memory_id IN (
+                       SELECT id FROM memories WHERE tenant_id = ANY($2::uuid[])
+                   )
+                   OR target_memory_id IN (
+                       SELECT id FROM memories WHERE tenant_id = ANY($2::uuid[])
+                   )
+                """,
+                teams,
+                tenants,
+            )
+            # Explicit UETA clearing is robust regardless of whether the
+            # teams FK cascades on delete.
+            await conn.execute(
+                "DELETE FROM user_effective_team_access WHERE resource_team_id = "
+                "ANY($1::uuid[])",
+                teams,
+            )
+            await conn.execute(
+                "DELETE FROM slugs WHERE team_id = ANY($1::uuid[])", teams
+            )
+            await conn.execute(
+                "DELETE FROM memories WHERE tenant_id = ANY($1::uuid[])", tenants
+            )
+            await conn.execute(
+                "DELETE FROM team_role_assignments WHERE parent_team_id = "
+                "ANY($1::uuid[])",
+                teams,
+            )
+            await conn.execute(
+                "DELETE FROM tenant_identities WHERE tenant_id = ANY($1::uuid[])",
+                tenants,
+            )
+            await conn.execute("DELETE FROM teams WHERE id = ANY($1::uuid[])", teams)
+            await conn.execute(
+                "DELETE FROM tenants WHERE id = ANY($1::uuid[])", tenants
+            )
+
+
+# ── Case 1: own-memory resolve succeeds (UUID + slug-tuple), no UETA ─────────
+
+
+async def test_resolve_own_memory_uuid_path(pg_pool: Any, sdk_client_factory: Any) -> None:
+    """A raw-SQL-provisioned owner resolves its OWN memory by UUID
+    (the exact repro path: sdk.write -> sdk.get -> the write tool's internal
+    resolve_reference_target succeeds)."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            setup = await _provision_user(conn, "wo1-own-uuid")
+
+    sdk = sdk_client_factory(tenant_id=setup["tenant"], plugin_id=_PLUGIN_ID)
+    try:
+        m1 = await sdk.write("target memory for ref", type="note")
+        assert m1 is not None
+
+        # The owner can read it back (mirrors the repro's pre-condition).
+        got = await sdk.get(memory_id=m1)
+        assert got is not None
+        assert UUID(str(got["id"])) == m1
+
+        # resolve_reference_target (no caller-side UETA needed — owner branch).
+        async with pg_pool.acquire() as conn:
+            resolved = await resolve_reference_target(
+                conn, target_uuid=m1, caller_user_id=setup["tenant"]
+            )
+        assert UUID(str(resolved["memory_id"])) == m1
+        assert resolved["team_id"] == setup["team"]
+    finally:
+        await _cleanup(pg_pool, [setup["tenant"]], [setup["team"]])
