+async def test_end_to_end_cross_tenant_cite_fails(pg_pool: Any, sdk_client_factory: Any) -> None:
+    """E2E: backfill user cannot cite another tenant's memory without access."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            user1 = await _provision_backfill_user(conn, plugin_id="test-cross-1")
+            user2 = await _provision_backfill_user(conn, plugin_id="test-cross-2")
+
+            # User1 creates a memory
+            target_id = await conn.fetchval(
+                "INSERT INTO memories "
+                "(tenant_id, team_id, content, content_hash, embedding, source_kind, type) "
+                "VALUES ($1, $2, 'target', $3, array_fill(0::real, ARRAY[1024])::vector, 'api', 'note') "
+                "RETURNING id",
+                user1["tenant"],
+                user1["team"],
+                f"hash-{uuid4().hex}",
+            )
+
+    try:
+        sdk = sdk_client_factory(tenant_id=user2["tenant"], plugin_id=user2["plugin_id"])
+
+        # User2 tries to cite user1's memory
+        with pytest.raises(PluginValidationError) as exc:
+            await sdk.write(
+                content="citer",
+                type="note",
+                references=[ReferenceInput(target_uuid=target_id, reference_kind="cites")],
+            )
+        assert exc.value.code == "memory_not_accessible"
+    finally:
+        await _cleanup(
+            pg_pool,
+            [user1["tenant"], user2["tenant"]],
+            [user1["team"], user2["team"]],
+        )
