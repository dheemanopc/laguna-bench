+async def test_resolve_opacity_not_found_vs_no_access(pg_pool: Any) -> None:
+    """Opacity (IT-08): not-found and no-access errors are identical."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            user1 = await _provision_backfill_user(conn, plugin_id="test-opacity-1")
+            user2 = await _provision_backfill_user(conn, plugin_id="test-opacity-2")
+
+            # Create a memory that user2 has no access to
+            actual_memory_id = await conn.fetchval(
+                "INSERT INTO memories "
+                "(tenant_id, team_id, content, content_hash, embedding, source_kind, type) "
+                "VALUES ($1, $2, 'target', $3, array_fill(0::real, ARRAY[1024])::vector, 'api', 'note') "
+                "RETURNING id",
+                user1["tenant"],
+                user1["team"],
+                f"hash-{uuid4().hex}",
+            )
+
+    try:
+        async with pg_pool.acquire() as conn:
+            # Error for actual memory with no access
+            err_no_access = None
+            try:
+                await resolve_reference_target(
+                    conn,
+                    target_uuid=actual_memory_id,
+                    caller_user_id=user2["tenant"],
+                )
+            except ReferenceTargetNotFoundError as e:
+                err_no_access = str(e)
+
+            # Error for random UUID (truly not found)
+            err_not_found = None
+            try:
+                await resolve_reference_target(
+                    conn,
+                    target_uuid=uuid4(),
+                    caller_user_id=user2["tenant"],
+                )
+            except ReferenceTargetNotFoundError as e:
+                err_not_found = str(e)
+
+            # Both errors must be identical (opaque per IT-08)
+            assert err_no_access is not None
+            assert err_not_found is not None
+            assert err_no_access == err_not_found
+            assert "not found or not accessible" in err_no_access
+    finally:
+        await _cleanup(
+            pg_pool,
+            [user1["tenant"], user2["tenant"]],
+            [user1["team"], user2["team"]],
+        )
+
