+"""Regression tests for memory-level access rule in references machinery.
+
+Bug: Raw-SQL-provisioned users (no UETA rows) couldn't reference their own
+memories, even though they could read them directly. The fix introduces a
+unified access rule across reference operations: memory M is accessible iff
+M exists AND (M.tenant_id == caller OR (M.team_id IS NOT NULL AND UETA row exists)).
+
+Test cases cover all four sites where this rule is enforced:
+1. resolve_reference_target (write-time validation)
+2. check_hard_delete_with_filtered_citers (hard-delete protection)
+3. memsys_refs_in (backward graph tool)
+4. memsys_refs_out (forward graph tool)
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.audit.logger import NoopAuditLogger
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.refs_in import RefsInInput, RefsInOutput, RefsInTool
+from mem_mcp.mcp.tools.refs_out import RefsOutInput, RefsOutOutput, RefsOutTool
+from mem_mcp.mcp.tools.write import ReferenceInput
+from mem_mcp.plugins.contract import PluginValidationError
+from mem_mcp.teams.assignments import assign_role
+from mem_mcp.teams.references import (
+    HardDeleteBlockedError,
+    ReferenceTargetNotFoundError,
+    caller_can_access_memory,
+    check_hard_delete_with_filtered_citers,
+    insert_reference,
+    resolve_reference_target,
+)
+
+pytestmark = pytest.mark.asyncio
+
+
+def _tool_ctx(tenant_id: UUID, db_pool: Any) -> ToolContext:
+    """Build a ToolContext for tool testing."""
+    deps = ToolDeps(
+        embeddings=None,  # type: ignore[arg-type]
+        audit=NoopAuditLogger(),
+        quotas=NoopQuotas(),
+    )
+    return ToolContext(
+        request_id="test",
+        tenant_id=tenant_id,
+        identity_id=uuid4(),
+        client_id="test-client",
+        scopes=frozenset(("memory.read",)),
+        db_pool=db_pool,
+        deps=deps,
+    )
+
+
+async def _provision_backfill_user(conn: Any, plugin_id: str = "test-backfill") -> dict[str, Any]:
+    """Provision a user like the 0026 backfill did: raw SQL, no assign_role.
+    Result: tenant, team, no UETA row."""
+    tenant = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"backfill-{uuid4()}@example.test",
+    )
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id, team_type) "
+        "VALUES ($1, $2, 'personal') RETURNING id",
+        f"backfill-{uuid4().hex[:8]}",
+        tenant,
+    )
+    owner_role_id = await conn.fetchval(
+        "SELECT id FROM roles_catalog WHERE role_key = 'owner' AND plugin_id IS NULL"
+    )
+    await conn.execute(
+        """
+        INSERT INTO team_role_assignments
+            (parent_team_id, member_kind, member_id, role_id, status, assigned_by_user_id)
+        VALUES ($1, 'user', $2, $3, 'active', $2)
+        """,
+        team,
+        tenant,
+        owner_role_id,
+    )
+    await conn.execute(
+        """
+        INSERT INTO tenant_identities
+        (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+        VALUES ($1, $2, 'cognito', $3, true, $4)
+        """,
+        tenant,
+        f"sub-backfill-{tenant}",
+        f"backfill-{tenant}@example.test",
+        team,
+    )
+    await conn.execute(
+        """
+        INSERT INTO oauth_clients
+        (id, redirect_uris, scope, registration_payload, review_status)
+        VALUES ($1, ARRAY[]::text[], 'memory.read memory.write',
+                '{}'::jsonb, 'auto_allowed')
+        ON CONFLICT (id) DO NOTHING
+        """,
+        f"plugin:{plugin_id}",
+    )
+    return {"tenant": tenant, "team": team, "plugin_id": plugin_id}
+
+
+async def _provision_api_user(conn: Any, plugin_id: str = "test-api") -> dict[str, Any]:
+    """Provision a user via assign_role (creates UETA rows)."""
+    tenant = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"api-{uuid4()}@example.test",
+    )
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+        f"api-{uuid4().hex[:8]}",
+        tenant,
+    )
+    await assign_role(
+        conn,
+        parent_team_id=team,
+        member_kind="user",
+        member_id=tenant,
+        role_key="admin",
+        assigned_by_user_id=tenant,
+    )
+    await conn.execute(
+        """
+        INSERT INTO oauth_clients
+        (id, redirect_uris, scope, registration_payload, review_status)
+        VALUES ($1, ARRAY[]::text[], 'memory.read memory.write',
+                '{}'::jsonb, 'auto_allowed')
+        ON CONFLICT (id) DO NOTHING
+        """,
+        f"plugin:{plugin_id}",
+    )
+    return {"tenant": tenant, "team": team, "plugin_id": plugin_id}
+
+
+async def _cleanup(pool: Any, tenants: list[UUID], teams: list[UUID]) -> None:
+    """Clean up test data."""
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            # Delete references for all test tenants
+            await conn.execute(
+                """
+                DELETE FROM memory_references
+                WHERE source_memory_id IN (SELECT id FROM memories WHERE tenant_id = ANY($1))
+                   OR target_memory_id IN (SELECT id FROM memories WHERE tenant_id = ANY($1))
+                """,
+                tenants,
+            )
+            # Delete slugs
+            await conn.execute(
+                "DELETE FROM slugs WHERE team_id = ANY($1)",
+                teams,
+            )
+            # Delete memories
+            await conn.execute(
+                "DELETE FROM memories WHERE tenant_id = ANY($1)",
+                tenants,
+            )
+            # Delete assignments
+            await conn.execute(
+                "DELETE FROM team_role_assignments WHERE parent_team_id = ANY($1)",
+                teams,
+            )
+            # Delete identities
+            await conn.execute(
+                "DELETE FROM tenant_identities WHERE tenant_id = ANY($1)",
+                tenants,
+            )
+            # Delete teams
+            await conn.execute(
+                "DELETE FROM teams WHERE id = ANY($1)",
+                teams,
+            )
+            # Delete tenants
+            await conn.execute(
+                "DELETE FROM tenants WHERE id = ANY($1)",
+                tenants,
+            )
+
+
+# ============================================================================
+# Test Case 1: resolve_reference_target — own memory, no UETA row → resolves OK
+# ============================================================================
+
+
+async def test_resolve_own_memory_backfill_user(pg_pool: Any) -> None:
+    """Backfill user (no UETA) can resolve reference to their own memory."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            user = await _provision_backfill_user(conn)
+            target_id = await conn.fetchval(
+                "INSERT INTO memories "
+                "(tenant_id, team_id, content, content_hash, embedding, source_kind, type) "
+                "VALUES ($1, $2, 'target', $3, array_fill(0::real, ARRAY[1024])::vector, 'api', 'note') "
+                "RETURNING id",
+                user["tenant"],
+                user["team"],
+                f"hash-{uuid4().hex}",
+            )
+
+    try:
+        async with pg_pool.acquire() as conn:
+            result = await resolve_reference_target(
+                conn,
+                target_uuid=target_id,
+                caller_user_id=user["tenant"],
+            )
+            assert result["memory_id"] == target_id
+    finally:
+        await _cleanup(pg_pool, [user["tenant"]], [user["team"]])
+
+
+# ============================================================================
+# Test Case 2: resolve_reference_target — cross-tenant, no access → opaque error
+# ============================================================================
+
+
+async def test_resolve_other_tenant_memory_no_access(pg_pool: Any) -> None:
+    """Cannot resolve reference to another tenant's memory without team access."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            user1 = await _provision_backfill_user(conn)
+            user2 = await _provision_backfill_user(conn)
+
+            # User1 creates a memory in their team
+            target_id = await conn.fetchval(
+                "INSERT INTO memories "
+                "(tenant_id, team_id, content, content_hash, embedding, source_kind, type) "
+                "VALUES ($1, $2, 'target', $3, array_fill(0::real, ARRAY[1024])::vector, 'api', 'note') "
+                "RETURNING id",
+                user1["tenant"],
+                user1["team"],
+                f"hash-{uuid4().hex}",
+            )
+
+    try:
+        async with pg_pool.acquire() as conn:
+            # User2 tries to reference it (no access to user1's team)
+            with pytest.raises(ReferenceTargetNotFoundError) as exc:
+                await resolve_reference_target(
+                    conn,
+                    target_uuid=target_id,
+                    caller_user_id=user2["tenant"],
+                )
+            assert "not found or not accessible" in str(exc.value)
+    finally:
+        await _cleanup(
+            pg_pool,
+            [user1["tenant"], user2["tenant"]],
+            [user1["team"], user2["team"]],
+        )
+
+
+# ============================================================================
+# Test Case 3: resolve_reference_target — team_id IS NULL → rejected (opaque)
+# ============================================================================
+
+
+async def test_resolve_other_tenant_teamless_memory(pg_pool: Any) -> None:
+    """References to other tenant's team-less memory are rejected (opaque)."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            user1 = await _provision_backfill_user(conn)
+            user2 = await _provision_backfill_user(conn)
+
+            # User1 creates a team-less memory (team_id = NULL)
+            target_id = await conn.fetchval(
+                "INSERT INTO memories "
+                "(tenant_id, content, content_hash, embedding, source_kind, type) "
+                "VALUES ($1, 'target', $2, array_fill(0::real, ARRAY[1024])::vector, 'api', 'note') "
+                "RETURNING id",
+                user1["tenant"],
+                f"hash-{uuid4().hex}",
+            )
+
+    try:
+        async with pg_pool.acquire() as conn:
+            # User2 tries to reference it
+            with pytest.raises(ReferenceTargetNotFoundError) as exc:
+                await resolve_reference_target(
+                    conn,
+                    target_uuid=target_id,
+                    caller_user_id=user2["tenant"],
+                )
+            assert "not found or not accessible" in str(exc.value)
+    finally:
+        await _cleanup(
+            pg_pool,
+            [user1["tenant"], user2["tenant"]],
+            [user1["team"], user2["team"]],
+        )
+
+
+# ============================================================================
+# Test Case 4: resolve_reference_target — cross-tenant WITH team access → OK
+# ============================================================================
+
+
+async def test_resolve_other_tenant_memory_with_access(pg_pool: Any) -> None:
+    """User can resolve reference to another tenant's memory if they have team access."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            user1 = await _provision_backfill_user(conn)
+            user2 = await _provision_api_user(conn)
+
+            # User1 creates a memory in their team
+            target_id = await conn.fetchval(
+                "INSERT INTO memories "
+                "(tenant_id, team_id, content, content_hash, embedding, source_kind, type) "
+                "VALUES ($1, $2, 'target', $3, array_fill(0::real, ARRAY[1024])::vector, 'api', 'note') "
+                "RETURNING id",
+                user1["tenant"],
+                user1["team"],
+                f"hash-{uuid4().hex}",
+            )
+
+            # Grant user2 access to user1's team
+            await assign_role(
+                conn,
+                parent_team_id=user1["team"],
+                member_kind="user",
+                member_id=user2["tenant"],
+                role_key="viewer",
+                assigned_by_user_id=user1["tenant"],
+            )
+
+    try:
+        async with pg_pool.acquire() as conn:
+            # User2 can now resolve the reference
+            result = await resolve_reference_target(
+                conn,
+                target_uuid=target_id,
+                caller_user_id=user2["tenant"],
+            )
+            assert result["memory_id"] == target_id
+    finally:
+        await _cleanup(
+            pg_pool,
+            [user1["tenant"], user2["tenant"]],
+            [user1["team"], user2["team"]],
+        )
+
+
+# ============================================================================
+# Test Case 5: check_hard_delete_with_filtered_citers — backfill citer OK
+# ============================================================================
+
+
+async def test_hard_delete_filters_backfill_citer(pg_pool: Any) -> None:
+    """Backfill user's own citer (no UETA) appears in accessible_citers."""
+    async with pg_pool.acquire() as conn:
