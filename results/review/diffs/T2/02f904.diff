+async def test_hard_delete_with_stranger_citer(pg_pool: Any) -> None:
+    """Hard-delete with accessible and inaccessible citers from different tenants."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            owner = await _provision_backfill_user(conn, plugin_id="test-delete-own")
+            stranger = await _provision_backfill_user(conn, plugin_id="test-delete-stranger")
+
+            # Owner creates target and accessible source
+            target_id = await conn.fetchval(
+                "INSERT INTO memories "
+                "(tenant_id, team_id, content, content_hash, embedding, source_kind, type) "
+                "VALUES ($1, $2, 'target', $3, array_fill(0::real, ARRAY[1024])::vector, 'api', 'note') "
+                "RETURNING id",
+                owner["tenant"],
+                owner["team"],
+                f"hash-{uuid4().hex}",
+            )
+            accessible_source_id = await conn.fetchval(
+                "INSERT INTO memories "
+                "(tenant_id, team_id, content, content_hash, embedding, source_kind, type) "
+                "VALUES ($1, $2, 'accessible-src', $3, array_fill(0::real, ARRAY[1024])::vector, 'api', 'note') "
+                "RETURNING id",
+                owner["tenant"],
+                owner["team"],
+                f"hash-{uuid4().hex}",
+            )
+
+            # Stranger creates an inaccessible source
+            inaccessible_source_id = await conn.fetchval(
+                "INSERT INTO memories "
+                "(tenant_id, team_id, content, content_hash, embedding, source_kind, type) "
+                "VALUES ($1, $2, 'inaccessible-src', $3, array_fill(0::real, ARRAY[1024])::vector, 'api', 'note') "
+                "RETURNING id",
+                stranger["tenant"],
+                stranger["team"],
+                f"hash-{uuid4().hex}",
+            )
+
+            # Both reference the target
+            await insert_reference(
+                conn,
+                source_memory_id=accessible_source_id,
+                target_memory_id=target_id,
+                target_team_id=owner["team"],
+                reference_kind="cites",
+            )
+            await insert_reference(
+                conn,
+                source_memory_id=inaccessible_source_id,
+                target_memory_id=target_id,
+                target_team_id=owner["team"],
+                reference_kind="cites",
+            )
+
+    try:
+        async with pg_pool.acquire() as conn:
+            # Owner tries hard-delete
+            with pytest.raises(HardDeleteBlockedError) as exc:
+                await check_hard_delete_with_filtered_citers(
+                    conn,
+                    target_memory_id=target_id,
+                    caller_user_id=owner["tenant"],
+                )
+
+            # Owner sees only their own source
+            assert len(exc.value.accessible_citers) == 1
+            assert exc.value.accessible_citers[0] == accessible_source_id
+            # Stranger's source is counted but UUID not exposed
+            assert exc.value.inaccessible_count == 1
+            assert inaccessible_source_id not in exc.value.accessible_citers
+    finally:
+        await _cleanup(
+            pg_pool,
+            [owner["tenant"], stranger["tenant"]],
+            [owner["team"], stranger["team"]],
+        )
