+async def test_e2e_opacity_not_found_vs_no_access(pg_pool: Any, sdk_client_factory: Any) -> None:
+    """Opacity (SDK E2E): citing nonexistent vs inaccessible memory raises same error."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            user1 = await _provision_backfill_user(conn, plugin_id="test-e2e-opacity-1")
+            user2 = await _provision_backfill_user(conn, plugin_id="test-e2e-opacity-2")
+
+            # User1 creates an inaccessible memory
+            inaccessible_id = await conn.fetchval(
+                "INSERT INTO memories "
+                "(tenant_id, team_id, content, content_hash, embedding, source_kind, type) "
+                "VALUES ($1, $2, 'inaccessible', $3, array_fill(0::real, ARRAY[1024])::vector, 'api', 'note') "
+                "RETURNING id",
+                user1["tenant"],
+                user1["team"],
+                f"hash-{uuid4().hex}",
+            )
+
+    try:
+        sdk = sdk_client_factory(tenant_id=user2["tenant"], plugin_id=user2["plugin_id"])
+
+        # Error when citing inaccessible memory
+        err_no_access = None
+        try:
+            await sdk.write(
+                content="cite inaccessible",
+                type="note",
+                references=[ReferenceInput(target_uuid=inaccessible_id, reference_kind="cites")],
+            )
+        except PluginValidationError as e:
+            err_no_access = (e.code, str(e.message))
+
+        # Error when citing nonexistent memory
+        err_not_found = None
+        try:
+            await sdk.write(
+                content="cite nonexistent",
+                type="note",
+                references=[ReferenceInput(target_uuid=uuid4(), reference_kind="cites")],
+            )
+        except PluginValidationError as e:
+            err_not_found = (e.code, str(e.message))
+
+        # Both errors must be identical (opaque per IT-08)
+        assert err_no_access is not None
+        assert err_not_found is not None
+        assert err_no_access == err_not_found
+        assert err_no_access[0] == "memory_not_accessible"
+    finally:
+        await _cleanup(
+            pg_pool,
+            [user1["tenant"], user2["tenant"]],
+            [user1["team"], user2["team"]],
+        )
