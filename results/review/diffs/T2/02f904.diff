+                "RETURNING id",
+                owner["tenant"],
+                owner["team"],
+                f"hash-{uuid4().hex}",
+            )
+
+            # Owner's accessible source
+            owner_source_id = await conn.fetchval(
+                "INSERT INTO memories "
