+async def caller_can_access_memory(
+    conn: asyncpg.Connection,
+    *,
+    caller_user_id: UUID,
+    memory_id: UUID,
+) -> bool:
+    """Check if a caller can access a specific memory.
+
+    Access rule: caller can access memory M ⇔ M exists AND (
+        M.tenant_id == caller_user_id OR (
+            M.team_id IS NOT NULL AND a UETA row exists for (caller, M.team_id)
+        )
+    )
+
+    This rule is used across the references machinery to decide visibility
+    of target and source memories in opaque-access contexts.
+
+    Does not check deleted_at — the caller is responsible for that if needed
+    (e.g., resolve_reference_target keeps its own deleted_at IS NULL lookup).
+    """
+    return bool(
+        await conn.fetchval(
+            """
+            SELECT 1
+            FROM memories m
+            WHERE m.id = $1 AND (
+                m.tenant_id = $2 OR (
+                    m.team_id IS NOT NULL AND EXISTS (
+                        SELECT 1 FROM user_effective_team_access ueta
+                        WHERE ueta.user_id = $2 AND ueta.resource_team_id = m.team_id
+                    )
+                )
+            )
+            """,
+            memory_id,
+            caller_user_id,
+        )
+    )
+
