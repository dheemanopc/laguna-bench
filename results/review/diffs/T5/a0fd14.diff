@@ -0,0 +1,891 @@
+# mypy: disable-error-code="attr-defined"
+# BaseTool.__call__ is declared to return BaseModel, so mypy cannot see the
+# concrete output models' fields. Suppressed at module level rather than with
+# dozens of inline ignores; the assertions themselves are what give these
+# tests value.
+"""Integration tests for memory.update concurrency safety (T-7.2).
+
+Real Postgres tests that exercise FOR UPDATE row locking + revision tokens
+under true concurrency. Each test creates its own tenant/identity/oauth_clients
+rows and cleans them up in a finally block.
+
+Verified:
+  - 8 concurrent tags add/remove on a note → no lost updates.
+  - 8 concurrent distinct tags_op=remove → only keeper remains.
+  - 6 concurrent content updates with same valid expected_revision → 1 success,
+    5 -32000 update_conflict with current_revision == winner.revision.
+  - 6 concurrent versioned fork on a decision → 1 success (v2), 5 refused with
+    current_id == winner.id; DB invariants hold.
+  - Sequential superseded decision update → -32000 with current_id, row count
+    unchanged by the refused call.
+  - Type promotion note→decision then stale update → -32000 with current_id.
+  - Versioned path revision: update.revision == re-getted memory.revision.
+  - Revision semantics: successive updates differ, stale token refused,
+    truly-stale concurrent (post-update) → all 6 refused.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import os
+from collections.abc import AsyncIterator
+from typing import Any
+from uuid import UUID, uuid4
+
+import asyncpg  # type: ignore[import-untyped]
+import pytest
+
+from mem_mcp.audit.logger import NoopAuditLogger
+from mem_mcp.db import tenant_tx
+from mem_mcp.embeddings.bedrock import EmbedResult
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.get import MemoryGetInput, MemoryGetTool
+from mem_mcp.mcp.tools.update import (
+    MemoryUpdateInput,
+    MemoryUpdateOutput,
+    MemoryUpdateTool,
+)
+
+pytestmark = pytest.mark.asyncio
+
+
+# Helpers -------------------------------------------------------------------
+
+
+def _build_deps() -> ToolDeps:
+    """ToolDeps with stub embedding + noop audit/quotas.
+
+    Stub embedder sleeps 0.02s to widen the race window inside the FOR UPDATE
+    lock — the in-place and versioned paths both embed while holding the lock.
+    """
+
+    class _StubEmbed:
+        async def embed(self, content: str) -> EmbedResult:
+            await asyncio.sleep(0.02)
+            return EmbedResult(
+                vector=[0.0] * 1024,
+                input_tokens=max(1, len(content) // 4),
+            )
+
+    return ToolDeps(
+        embeddings=_StubEmbed(),
+        audit=NoopAuditLogger(),
+        quotas=NoopQuotas(),
+    )
+
+
+async def _make_pool(dsn: str) -> asyncpg.Pool:
+    """Create a dedicated pool with max_size=12 for concurrent tests.
+
+    Uses the same ``_init_connection`` as ``mem_mcp.db.pool.init_pool`` so the
+    pgvector + jsonb text codecs register correctly.
+    """
+    from mem_mcp.db.pool import _init_connection
+
+    return await asyncpg.create_pool(
+        dsn=dsn,
+        min_size=2,
+        max_size=12,
+        command_timeout=30,
+        server_settings={
+            "application_name": "mem-mcp-it08-update-concurrency"
+        },
+        init=_init_connection,
+    )
+
+
+async def _setup_tenant(pool: Any) -> dict[str, Any]:
+    """Insert a tenant + identity + oauth_clients row. Returns setup dict.
+
+    Does NOT set the tenant GUC — these tables (tenants, tenant_identities,
+    oauth_clients) have no tenant-scoped RLS.
+    """
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            tenant_id = await conn.fetchval(
+                "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+                f"it08-update-{uuid4()}@example.test",
+            )
+            client_id = f"client:it08-update-{uuid4().hex[:8]}"
+            await conn.execute(
+                """
+                INSERT INTO tenant_identities
+                (tenant_id, cognito_sub, provider, email, is_primary)
+                VALUES ($1, $2, 'cognito', $3, true)
+                """,
+                tenant_id,
+                f"sub-{tenant_id}",
+                f"it08-update-{tenant_id}@example.test",
+            )
+            await conn.execute(
+                """
+                INSERT INTO oauth_clients
+                (id, redirect_uris, scope, registration_payload, review_status)
+                VALUES ($1, ARRAY[]::text[], 'memory.read memory.write',
+                        '{}'::jsonb, 'auto_allowed')
+                """,
+                client_id,
+            )
+    return {"tenant": tenant_id, "client_id": client_id}
+
+
+async def _cleanup(pool: Any, tenant_id: UUID, client_id: str) -> None:
+    """Delete all test rows in FK-safe order.
+
+    Sets the tenant GUC so the memories_delete RLS policy allows the DELETE
+    on ``memories`` (the only table with tenant-scoped RLS in this cleanup
+    path; memory_references has a permissive ``USING (true)`` policy, and
+    slugs has no RLS at all).
+    """
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute(
+                "SELECT set_config('app.current_tenant_id', $1, true)",
+                str(tenant_id),
+            )
+            # Refs first — memory_references.source_memory_id -> memories.id CASCADE,
+            # but we delete explicitly to avoid relying on CASCADE timing.
+            await conn.execute(
+                "DELETE FROM memory_references "
+                "WHERE source_memory_id IN (SELECT id FROM memories) "
+                "   OR target_memory_id IN (SELECT id FROM memories)"
+            )
+            # Slugs before memories (slugs.memory_id FK has ON DELETE RESTRICT).
+            await conn.execute(
+                "DELETE FROM slugs WHERE memory_id IN (SELECT id FROM memories)"
+            )
+            # Memories (tenant-scoped via RLS + GUC above).
+            await conn.execute(
+                "DELETE FROM memories WHERE tenant_id = $1", tenant_id
+            )
+            # Identities + oauth_clients + tenants (no tenant-scoped RLS).
+            await conn.execute(
+                "DELETE FROM tenant_identities WHERE tenant_id = $1", tenant_id
+            )
+            await conn.execute(
+                "DELETE FROM oauth_clients WHERE id = $1", client_id
+            )
+            await conn.execute(
+                "DELETE FROM tenants WHERE id = $1", tenant_id
+            )
+
+
+def _ctx(pool: Any, tenant_id: UUID, client_id: str) -> ToolContext:
+    """Build a ToolContext wired with stub deps for the given tenant."""
+    return ToolContext(
+        request_id=f"req-{uuid4().hex[:8]}",
+        tenant_id=tenant_id,
+        identity_id=tenant_id,
+        client_id=client_id,
+        scopes=frozenset({"memory.read", "memory.write"}),
+        db_pool=pool,
+        deps=_build_deps(),
+    )
+
+
+async def _drain_access_tasks() -> None:
+    """Sleep briefly to let fire-and-forget bump_access tasks drain.
+
+    ``memory_get`` schedules a background asyncio task (bump_access) that
+    acquires its own connection from the pool via ``tenant_tx``. If pool.close()
+    races against that task we get 'pool is closing' errors. A short sleep
+    lets those tasks complete before the pool is destroyed.
+    """
+    await asyncio.sleep(0.3)
+
+
+async def _create_note_direct(
+    pool: Any,
+    tenant_id: UUID,
+    content: str = "initial note",
+    tags: list[str] | None = None,
+) -> UUID:
+    """Insert a note directly into the DB and return its id.
+
+    Uses ``tenant_tx`` so the tenant GUC is set for the RLS INSERT policy.
+    """
+    async with tenant_tx(pool, tenant_id) as conn:
+        mid = await conn.fetchval(
+            """
+            INSERT INTO memories
+            (tenant_id, content, content_hash, embedding, source_kind, type,
+             tags, metadata, is_current)
+            VALUES ($1, $2, $3, array_fill(0::real, ARRAY[1024])::vector,
+                    'api', 'note', $4, '{}'::jsonb, true)
+            RETURNING id
+            """,
+            tenant_id,
+            content,
+            f"hash-{uuid4().hex}",
+            tags or [],
+        )
+    assert isinstance(mid, UUID)
+    return mid
+
+
+async def _create_decision_direct(
+    pool: Any, tenant_id: UUID, content: str = "initial decision"
+) -> UUID:
+    """Insert a decision directly into the DB and return its id.
+
+    Uses ``tenant_tx`` so the tenant GUC is set for the RLS INSERT policy.
+    """
+    async with tenant_tx(pool, tenant_id) as conn:
+        mid = await conn.fetchval(
+            """
+            INSERT INTO memories
+            (tenant_id, content, content_hash, embedding, source_kind, type,
+             tags, metadata, is_current)
+            VALUES ($1, $2, $3, array_fill(0::real, ARRAY[1024])::vector,
+                    'api', 'decision', ARRAY[]::text[], '{}'::jsonb, true)
+            RETURNING id
+            """,
+            tenant_id,
+            content,
+            f"hash-{uuid4().hex}",
+        )
+    assert isinstance(mid, UUID)
+    return mid
+
