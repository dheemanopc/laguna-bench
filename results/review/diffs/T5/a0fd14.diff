+# (c) Versioned path revision ------------------------------------------------
+
+
+class TestVersionedPathRevision:
+    """Revision token correctness on the versioned path (decision content update)."""
+
+    async def test_versioned_update_revision_matches_get(
+        self, concurrency_pool: Any
+    ) -> None:
+        """After a decision content update, update.revision == re-getted revision."""
+        setup = await _setup_tenant(concurrency_pool)
+        tenant, client_id = setup["tenant"], setup["client_id"]
+
+        try:
+            dec_id = await _create_decision_direct(
+                concurrency_pool, tenant, "v0 decision"
+            )
+            ctx = _ctx(concurrency_pool, tenant, client_id)
+            tool = MemoryUpdateTool()
+            mem_tool = MemoryGetTool()
+
+            # Get original revision
+            got_orig = await mem_tool(ctx, MemoryGetInput(id=dec_id))
+            orig_rev = got_orig.memory.revision
+
+            # Update decision content → creates new version
+            result = await tool(
+                ctx, MemoryUpdateInput(id=dec_id, content="v1 decision")
+            )
+            assert isinstance(result, MemoryUpdateOutput)
+            assert result.is_new_version is True
+            new_id = result.id
+
+            # Re-get the new version → its revision must match update's revision
+            got_new = await mem_tool(ctx, MemoryGetInput(id=new_id))
+            assert got_new.memory.revision == result.revision, (
+                f"update.revision={result.revision} "
+                f"!= get.revision={got_new.memory.revision}"
+            )
+            # And differs from the original
+            assert result.revision != orig_rev
+        finally:
+            await _cleanup(concurrency_pool, tenant, client_id)
+
