+# (f) Sequential superseded decision update -----------------------------------
+
+
+class TestSupersededSequential:
+    """Updating a superseded version → -32000 with current_id, row count check.
+
+    And: updating the current version after supersession succeeds.
+    """
+
+    async def test_update_superseded_decision(self, concurrency_pool: Any) -> None:
+        """First update creates v2; second update targeting v1 → -32000."""
+        setup = await _setup_tenant(concurrency_pool)
+        tenant, client_id = setup["tenant"], setup["client_id"]
+
+        try:
+            dec_id = await _create_decision_direct(
+                concurrency_pool, tenant, "v0 decision"
+            )
+            ctx = _ctx(concurrency_pool, tenant, client_id)
+            tool = MemoryUpdateTool()
+
+            # Record memory count before (per-tenant via GUC)
+            async with tenant_tx(concurrency_pool, tenant) as conn:
+                count_before = await conn.fetchval(
+                    "SELECT count(*) FROM memories"
+                )
+
+            # First update creates v2 (decision + content change → new version)
+            result_v2 = await tool(
+                ctx, MemoryUpdateInput(id=dec_id, content="v1 decision")
+            )
+            assert isinstance(result_v2, MemoryUpdateOutput)
+            assert result_v2.is_new_version is True
+            v2_id = result_v2.id
+
+            # Now try to update the ORIGINAL v1 → should fail with -32000
+            with pytest.raises(JsonRpcError) as exc:
+                await tool(
+                    ctx, MemoryUpdateInput(id=dec_id, content="should fail")
+                )
+            assert exc.value.code == -32000
+            assert exc.value.data is not None
+            assert exc.value.data["code"] == "update_conflict"
+            assert exc.value.data["current_id"] == str(v2_id)
+
+            # --- DB invariants ---
+            async with tenant_tx(concurrency_pool, tenant) as conn:
+                orig = await conn.fetchrow(
+                    "SELECT is_current, superseded_by FROM memories WHERE id = $1",
+                    dec_id,
+                )
+                assert orig is not None
+                assert orig["is_current"] is False
+                assert orig["superseded_by"] == v2_id
+
+                v2 = await conn.fetchrow(
+                    "SELECT is_current FROM memories WHERE id = $1",
+                    v2_id,
+                )
+                assert v2 is not None
+                assert v2["is_current"] is True
+
+                # Memory count must be unchanged by the refused call
+                count_after = await conn.fetchval(
+                    "SELECT count(*) FROM memories"
+                )
+                assert count_after == count_before + 1  # +1 for the v2 that was created
+
+                # v1 row's content must be unchanged
+                v1_content = await conn.fetchval(
+                    "SELECT content FROM memories WHERE id = $1",
+                    dec_id,
+                )
+                assert v1_content == "v0 decision"
+        finally:
+            await _cleanup(concurrency_pool, tenant, client_id)
+
+    async def test_update_current_version_works_after_supersession(
+        self, concurrency_pool: Any
+    ) -> None:
+        """After v1 is superseded by v2, updating v2 (the current) succeeds."""
+        setup = await _setup_tenant(concurrency_pool)
+        tenant, client_id = setup["tenant"], setup["client_id"]
+
+        try:
+            dec_id = await _create_decision_direct(
+                concurrency_pool, tenant, "v0"
+            )
+            ctx = _ctx(concurrency_pool, tenant, client_id)
+            tool = MemoryUpdateTool()
+
+            # Create v2 (decision + content change → new version)
+            result_v2 = await tool(ctx, MemoryUpdateInput(id=dec_id, content="v1"))
+            assert isinstance(result_v2, MemoryUpdateOutput)
+            v2_id = result_v2.id
+            assert v2_id != dec_id  # new row was inserted
+
+            # Update v2 again — should NOT get a superseded conflict
+            result_v3 = await tool(
+                ctx, MemoryUpdateInput(id=v2_id, content="v2")
+            )
+            assert isinstance(result_v3, MemoryUpdateOutput)
+            assert result_v3.is_new_version is True
+            assert result_v3.id != v2_id  # another new version
+
+            # v2_id is now superseded
+            async with tenant_tx(concurrency_pool, tenant) as conn:
+                row = await conn.fetchrow(
+                    "SELECT is_current FROM memories WHERE id = $1", v2_id
+                )
+                assert row is not None
+                assert row["is_current"] is False
+        finally:
+            await _cleanup(concurrency_pool, tenant, client_id)
+
