diff --git a/src/mem_mcp/memory/versioning.py b/src/mem_mcp/memory/versioning.py
index 0695098..82a48b8 100644
--- a/src/mem_mcp/memory/versioning.py
+++ b/src/mem_mcp/memory/versioning.py
@@ -6,7 +6,34 @@ exists so other modules can import the constants/types they'll need.
 
 from __future__ import annotations
 
+import hashlib
+from datetime import UTC, datetime, timedelta
 from typing import Final
+from uuid import UUID
 
 VERSIONED_TYPES: Final[frozenset[str]] = frozenset({"decision", "fact"})
 NON_VERSIONED_TYPES: Final[frozenset[str]] = frozenset({"note", "snippet", "question"})
+
+_EPOCH = datetime(1970, 1, 1, tzinfo=UTC)
+
+
+def compute_revision(memory_id: UUID | None, updated_at: datetime | None) -> str:
+    """Compute an opaque revision token for optimistic concurrency control.
+
+    Format: sha256("{id_or_empty}:{epoch_micros_or_empty}")[:24]
+
+    Naive datetimes are treated as UTC.  Uses exact integer timedelta division
+    (not float ``dt.timestamp()``) to avoid rounding collisions at the
+    µs=999999 boundary.
+    """
+    id_str = str(memory_id) if memory_id is not None else ""
+    if updated_at is None:
+        micros_str = ""
+    else:
+        dt = updated_at
+        if dt.tzinfo is None:
+            dt = dt.replace(tzinfo=UTC)
+        micros = int((dt - _EPOCH) // timedelta(microseconds=1))
+        micros_str = str(micros)
+    raw = f"{id_str}:{micros_str}"
+    return hashlib.sha256(raw.encode()).hexdigest()[:24]
