+# (b) Type promotion note→decision then stale update ------------------------
+
+
+class TestTypePromotionStaleUpdate:
+    """note → type=decision (new row), then update old note id → refused."""
+
+    async def test_promote_note_then_update_old_rejected(
+        self, concurrency_pool: Any
+    ) -> None:
+        setup = await _setup_tenant(concurrency_pool)
+        tenant, client_id = setup["tenant"], setup["client_id"]
+
+        try:
+            note_id = await _create_note_direct(
+                concurrency_pool, tenant, content="old note", tags=["tag1", "tag2"]
+            )
+            ctx = _ctx(concurrency_pool, tenant, client_id)
+            tool = MemoryUpdateTool()
+
+            # Count before (per-tenant via GUC)
+            async with tenant_tx(concurrency_pool, tenant) as conn:
+                count_before = await conn.fetchval(
+                    "SELECT count(*) FROM memories"
+                )
+
+            # Promote note → decision (new version row created)
+            result = await tool(ctx, MemoryUpdateInput(id=note_id, type="decision"))
+            assert isinstance(result, MemoryUpdateOutput)
+            assert result.is_new_version is True
+            promoted_id = result.id
+            assert promoted_id != note_id
+
+            # Now try to update the OLD note id (tags add) → should be refused
+            with pytest.raises(JsonRpcError) as exc:
+                await tool(
+                    ctx,
+                    MemoryUpdateInput(id=note_id, tags=["new-tag"], tags_op="add"),
+                )
+            assert exc.value.code == -32000
+            assert exc.value.data is not None
+            assert exc.value.data["code"] == "update_conflict"
+            assert exc.value.data["current_id"] == str(promoted_id)
+
+            # Memory count must be unchanged by the refused call
+            async with tenant_tx(concurrency_pool, tenant) as conn:
+                count_after = await conn.fetchval(
+                    "SELECT count(*) FROM memories"
+                )
+                assert count_after == count_before + 1  # only promotion added a row
+
+                # Old note's tags must be unchanged
+                old_tags = await conn.fetchval(
+                    "SELECT tags FROM memories WHERE id = $1", note_id
+                )
+                assert set(old_tags) == {"tag1", "tag2"}
+        finally:
+            await _cleanup(concurrency_pool, tenant, client_id)
