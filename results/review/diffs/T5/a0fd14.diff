+class TestTrulyStaleTokenConcurrent:
+    """Do one update first, then fire 6 concurrent updates with the old token.
+
+    All 6 are refused because the token is stale — the row's updated_at already
+    changed. Each refusal carries current_revision == post_rev, and the DB
+    content is unchanged.
+    """
+
+    async def test_6_concurrent_truly_stale_token(
+        self, concurrency_pool: Any
+    ) -> None:
+        setup = await _setup_tenant(concurrency_pool)
+        tenant, client_id = setup["tenant"], setup["client_id"]
+
+        try:
+            note_id = await _create_note_direct(
+                concurrency_pool, tenant, content="v0"
+            )
+            ctx = _ctx(concurrency_pool, tenant, client_id)
+            tool = MemoryUpdateTool()
+            mem_tool = MemoryGetTool()
+
+            # Get initial revision
+            got = await mem_tool(ctx, MemoryGetInput(id=note_id))
+            stale_rev = got.memory.revision
+            assert stale_rev
+
+            # Do one update first — succeeds, changes revision
+            r1 = await tool(ctx, MemoryUpdateInput(id=note_id, content="v1"))
+            assert isinstance(r1, MemoryUpdateOutput)
+            post_rev = r1.revision
+
+            # Fire 6 concurrent updates with the STALE (old) token
+            async def try_update(idx: int) -> str:
+                try:
+                    await tool(
+                        _ctx(concurrency_pool, tenant, client_id),
+                        MemoryUpdateInput(
+                            id=note_id,
+                            content=f"attempt-{idx}",
+                            expected_revision=stale_rev,
+                        ),
+                    )
+                    return "success"
+                except JsonRpcError as e:
+                    assert e.code == -32000
+                    assert e.data is not None
+                    assert e.data["code"] == "update_conflict"
+                    assert e.data["current_revision"] == post_rev
+                    return "conflict"
+
+            results = await asyncio.gather(*[try_update(i) for i in range(6)])
+
+            # All 6 must be refused
+            successes = [r for r in results if r == "success"]
+            conflicts = [r for r in results if r == "conflict"]
+            assert len(successes) == 0, f"Expected 0 successes, got {len(successes)}"
+            assert len(conflicts) == 6, f"Expected 6 conflicts, got {len(conflicts)}"
+
+            # DB content must be unchanged (still "v1")
+            async with tenant_tx(concurrency_pool, tenant) as conn:
+                content = await conn.fetchval(
+                    "SELECT content FROM memories WHERE id = $1", note_id
+                )
+                assert content == "v1", f"Expected 'v1', got {content}"
+        finally:
+            await _cleanup(concurrency_pool, tenant, client_id)
