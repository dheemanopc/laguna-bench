+# (a) 6 concurrent versioned fork on a decision -------------------------------
+
+
+class TestConcurrentVersionedFork:
+    """6 concurrent ``memory_update(content=v-{i})`` on one current decision.
+
+    Exactly 1 succeeds (creates v2, version==2, is_new_version=True); the
+    other 5 are refused with -32000, data.code='update_conflict',
+    data.current_id == winner.id, and data.current_revision == winner.revision.
+
+    DB invariants: original row has is_current=false + superseded_by=winner.id;
+    exactly 1 row has supersedes=original_id; winner is is_current=true.
+    """
+
+    async def test_6_concurrent_fork_decision(self, concurrency_pool: Any) -> None:
+        setup = await _setup_tenant(concurrency_pool)
+        tenant, client_id = setup["tenant"], setup["client_id"]
+
+        try:
+            dec_id = await _create_decision_direct(
+                concurrency_pool, tenant, "v0 decision"
+            )
+
+            async def try_update(idx: int) -> tuple[str, Any, int]:
+                try:
+                    result = await MemoryUpdateTool()(
+                        _ctx(concurrency_pool, tenant, client_id),
+                        MemoryUpdateInput(id=dec_id, content=f"v-{idx}"),
+                    )
+                    assert isinstance(result, MemoryUpdateOutput)
+                    return "success", result, idx
+                except JsonRpcError as e:
+                    assert e.code == -32000
+                    assert e.data is not None
+                    assert e.data["code"] == "update_conflict"
+                    return "conflict", e.data, idx
+
+            results = await asyncio.gather(*[try_update(i) for i in range(6)])
+
+            # --- Exactly 1 success + 5 conflicts ---
+            successes = [r for r in results if r[0] == "success"]
+            conflicts = [r for r in results if r[0] == "conflict"]
+            assert len(successes) == 1, f"Expected 1 success, got {len(successes)}"
+            assert len(conflicts) == 5, f"Expected 5 conflicts, got {len(conflicts)}"
+
+            winner: MemoryUpdateOutput = successes[0][1]
+            assert winner.is_new_version is True
+            assert winner.version == 2
+            winner_id = winner.id
+
+            # --- Each conflict must reference the winner ---
+            for _, data, _ in conflicts:
+                assert data["current_id"] == str(winner_id)
+                assert data["current_revision"] == winner.revision
+
+            # --- DB invariants ---
+            async with tenant_tx(concurrency_pool, tenant) as conn:
+                orig = await conn.fetchrow(
+                    "SELECT is_current, superseded_by FROM memories WHERE id = $1",
+                    dec_id,
+                )
+                assert orig is not None
+                assert orig["is_current"] is False
+                assert orig["superseded_by"] == winner_id
+
+                supers_count = await conn.fetchval(
+                    "SELECT count(*) FROM memories WHERE supersedes = $1",
+                    dec_id,
+                )
+                assert supers_count == 1
+
+                winner_curr = await conn.fetchval(
+                    "SELECT is_current FROM memories WHERE id = $1",
+                    winner_id,
+                )
+                assert winner_curr is True
+        finally:
+            await _cleanup(concurrency_pool, tenant, client_id)
+
+
+# (d) 8 concurrent tags add/remove + 8 concurrent distinct removes ----------
+
+
+class TestConcurrentTagsUpdate:
+    """Concurrent tags add/remove and remove-all on a note."""
+
+    async def test_8_concurrent_tags_add_remove(self, concurrency_pool: Any) -> None:
+        """8 concurrent tags add/remove on a note → no lost updates."""
+        setup = await _setup_tenant(concurrency_pool)
+        tenant, client_id = setup["tenant"], setup["client_id"]
+
+        try:
+            note_id = await _create_note_direct(
+                concurrency_pool, tenant, content="base", tags=["base"]
+            )
+            ctx = _ctx(concurrency_pool, tenant, client_id)
+            tool = MemoryUpdateTool()
+
+            # 4 add distinct tags, 4 remove "base"
+            add_tags = ["tag-a", "tag-b", "tag-c", "tag-d"]
+
+            async def add_tag(tag_name: str) -> None:
+                await tool(
+                    ctx,
+                    MemoryUpdateInput(id=note_id, tags=[tag_name], tags_op="add"),
+                )
+
+            async def remove_tag(tag_name: str) -> None:
+                await tool(
+                    ctx,
+                    MemoryUpdateInput(id=note_id, tags=[tag_name], tags_op="remove"),
+                )
+
+            tasks = [add_tag(t) for t in add_tags]
+            tasks += [remove_tag("base") for _ in range(4)]
+
+            results = await asyncio.gather(*tasks, return_exceptions=True)
+            errors = [r for r in results if isinstance(r, Exception)]
+            assert not errors, f"Unexpected errors: {errors}"
+
+            # Verify final state: all add_tags present, 'base' removed
+            mem_tool = MemoryGetTool()
+            got = await mem_tool(ctx, MemoryGetInput(id=note_id))
+            final_tags = set(got.memory.tags)
+            for t in add_tags:
+                assert t in final_tags, f"Tag {t} was lost in concurrent update"
+            assert "base" not in final_tags, "'base' should have been removed"
+        finally:
+            await _cleanup(concurrency_pool, tenant, client_id)
+
+    async def test_8_concurrent_distinct_removes(self, concurrency_pool: Any) -> None:
+        """8 concurrent distinct tags_op=remove → only keeper remains.
+
+        Note: 8 tags to remove + 1 keeper. After all 8 removes complete,
+        only the keeper tag remains.
+        """
+        setup = await _setup_tenant(concurrency_pool)
+        tenant, client_id = setup["tenant"], setup["client_id"]
+
+        try:
+            remove_tags = [f"r{i}" for i in range(8)]
+            keeper = "keeper"
+            all_tags = [*remove_tags, keeper]
+            note_id = await _create_note_direct(
+                concurrency_pool, tenant, tags=all_tags
+            )
+            ctx = _ctx(concurrency_pool, tenant, client_id)
+            tool = MemoryUpdateTool()
+
+            async def do_remove(tag_name: str) -> None:
+                await tool(
+                    ctx,
+                    MemoryUpdateInput(id=note_id, tags=[tag_name], tags_op="remove"),
+                )
+
+            # 8 concurrent removes, one per tag
+            await asyncio.gather(*[do_remove(t) for t in remove_tags])
+
+            # Only the keeper should remain
+            mem_tool = MemoryGetTool()
+            got = await mem_tool(ctx, MemoryGetInput(id=note_id))
+            final_tags = set(got.memory.tags)
+            assert final_tags == {keeper}, f"Expected only keeper, got {final_tags}"
+        finally:
+            await _cleanup(concurrency_pool, tenant, client_id)
+
