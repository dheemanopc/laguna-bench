+class TestComputeRevision:
+    """Tests for the pure compute_revision helper."""
+
+    def test_change_by_one_microsecond(self) -> None:
+        """Two timestamps differing by 1µs produce different revisions."""
+        mid = uuid4()
+        t0 = datetime(2025, 1, 1, 12, 0, 0, 0, tzinfo=UTC)
+        t1 = datetime(2025, 1, 1, 12, 0, 0, 1, tzinfo=UTC)
+        r0 = compute_revision(mid, t0)
+        r1 = compute_revision(mid, t1)
+        assert r0 != r1
+        assert len(r0) == 24
+        assert r0  # non-empty
+
+    def test_microsecond_999999_boundary(self) -> None:
+        """µs=999999 at second S vs µs=999999 at second S+1 must differ.
+
+        The old int(ts.timestamp()) impl could round up at the second boundary
+        (float precision), causing these to collide. Integer timedelta division
+        is exact.
+        """
+        mid = uuid4()
+        # Second 0, microsecond 999999
+        t_a = datetime(2025, 1, 1, 0, 0, 0, 999999, tzinfo=UTC)
+        # Second 1, microsecond 999999
+        t_b = datetime(2025, 1, 1, 0, 0, 1, 999999, tzinfo=UTC)
+        r_a = compute_revision(mid, t_a)
+        r_b = compute_revision(mid, t_b)
+        assert r_a != r_b, "µs=999999 boundary timestamps must not collide"
+
+        # Verify the exact epoch micros value
+        from datetime import timedelta
+
+        expected_a = int(
+            (t_a - datetime(1970, 1, 1, tzinfo=UTC)) // timedelta(microseconds=1)
+        )
+        expected_b = int(
+            (t_b - datetime(1970, 1, 1, tzinfo=UTC)) // timedelta(microseconds=1)
+        )
+        assert expected_b - expected_a == 1_000_000  # exactly 1 second
+
+    def test_tz_normalization(self) -> None:
+        """Equivalent timestamps in different timezones → same revision."""
+        from datetime import timedelta, timezone
+
+        mid = uuid4()
+        utc = datetime(2025, 6, 15, 10, 0, 0, 0, tzinfo=UTC)
+        # Same instant, +02:00 offset
+        plus2 = datetime(2025, 6, 15, 12, 0, 0, 0, tzinfo=timezone(timedelta(hours=2)))
+        assert compute_revision(mid, utc) == compute_revision(mid, plus2)
+
+    def test_naive_treated_as_utc(self) -> None:
+        """Naive datetime is assumed UTC."""
+        mid = uuid4()
+        naive = datetime(2025, 1, 1, 12, 0, 0, 0)
+        aware_utc = datetime(2025, 1, 1, 12, 0, 0, 0, tzinfo=UTC)
+        assert compute_revision(mid, naive) == compute_revision(mid, aware_utc)
+
+    def test_none_updated_at(self) -> None:
+        """updated_at=None still returns a non-empty string."""
+        mid = uuid4()
+        r = compute_revision(mid, None)
+        assert r and len(r) == 24
+
+    def test_none_memory_id(self) -> None:
+        """memory_id=None still returns a non-empty string."""
+        t = datetime(2025, 1, 1, 12, 0, 0, 0, tzinfo=UTC)
+        r = compute_revision(None, t)
+        assert r and len(r) == 24
+
+    def test_both_none(self) -> None:
+        """Both None → still non-empty."""
+        r = compute_revision(None, None)
+        assert r and len(r) == 24
