+# (e) 6 concurrent with same valid expected_revision --------------------------
+
+
+class TestConcurrentValidRevision:
+    """6 concurrent updates with the SAME valid expected_revision.
+
+    All 6 start with the correct revision, but only 1 wins the FOR UPDATE lock;
+    the rest are refused because the revision changed after the first commit.
+    Each refusal carries current_revision == winner.revision. DB content equals
+    the winner's content.
+    """
+
+    async def test_6_concurrent_same_valid_expected_revision(
+        self, concurrency_pool: Any
+    ) -> None:
+        setup = await _setup_tenant(concurrency_pool)
+        tenant, client_id = setup["tenant"], setup["client_id"]
+
+        try:
+            note_id = await _create_note_direct(
+                concurrency_pool, tenant, content="initial note"
+            )
+            ctx = _ctx(concurrency_pool, tenant, client_id)
+            tool = MemoryUpdateTool()
+
+            # Read revision via memory_get
+            mem_tool = MemoryGetTool()
+            got = await mem_tool(ctx, MemoryGetInput(id=note_id))
+            good_rev = got.memory.revision
+            assert good_rev
+
+            async def try_update(idx: int) -> tuple[str, Any, int]:
+                try:
+                    result = await tool(
+                        _ctx(concurrency_pool, tenant, client_id),
+                        MemoryUpdateInput(
+                            id=note_id,
+                            content=f"concurrent-{idx}",
+                            expected_revision=good_rev,
+                        ),
+                    )
+                    assert isinstance(result, MemoryUpdateOutput)
+                    return "success", result, idx
+                except JsonRpcError as e:
+                    assert e.code == -32000
+                    assert e.data is not None
+                    assert e.data["code"] == "update_conflict"
+                    return "conflict", e.data, idx
+
+            results = await asyncio.gather(*[try_update(i) for i in range(6)])
+
+            # --- Exactly 1 success + 5 conflicts ---
+            successes = [r for r in results if r[0] == "success"]
+            conflicts = [r for r in results if r[0] == "conflict"]
+            assert len(successes) == 1, f"Expected 1 success, got {len(successes)}"
+            assert len(conflicts) == 5, f"Expected 5 conflicts, got {len(conflicts)}"
+
+            winner: MemoryUpdateOutput = successes[0][1]
+            winner_idx = successes[0][2]
+
+            # --- Each conflict's current_revision must match winner's revision ---
+            for _, data, _ in conflicts:
+                assert data["current_revision"] == winner.revision, (
+                    f"Conflict current_revision {data['current_revision']} "
+                    f"!= winner {winner.revision}"
+                )
+
+            # --- DB content must equal the winner's content ---
+            async with tenant_tx(concurrency_pool, tenant) as conn:
+                db_content = await conn.fetchval(
+                    "SELECT content FROM memories WHERE id = $1",
+                    note_id,
+                )
+                assert db_content == f"concurrent-{winner_idx}", (
+                    f"Expected concurrent-{winner_idx}, got {db_content}"
+                )
+        finally:
+            await _cleanup(concurrency_pool, tenant, client_id)
