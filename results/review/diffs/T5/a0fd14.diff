+def _build_ctx(scopes: tuple[str, ...] = ("memory.write",)) -> ToolContext:
+    deps = ToolDeps(
+        embeddings=_StubEmbeddings(),
+        audit=NoopAuditLogger(),
+        quotas=NoopQuotas(),
+    )
+    return ToolContext(
+        request_id=str(uuid4()),
+        tenant_id=uuid4(),
+        identity_id=uuid4(),
+        client_id="client-1",
+        scopes=frozenset(scopes),
+        db_pool=MagicMock(),
