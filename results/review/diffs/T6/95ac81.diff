+"""DB-backed integration tests for ``memory.list`` tool behaviour.
+
+Exercises the real ``MemoryListTool.__call__`` end-to-end against a live Postgres:
+row scoping, every filter leg, keyword OR-of-lexemes (``tsvector_to_array`` is a
+pg_catalog built-in since 9.6, no helper needed), ordering, keyset cursor
+pagination, invalid-cursor error wrapping, audit-log row emission, and
+the full output-model field surface.
+
+The ``pg_pool`` / ``MEM_MCP_TEST_DSN`` fixtures skip cleanly when no live DB
+is configured.
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+from datetime import UTC, datetime, timedelta
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.audit.logger import DbAuditLogger
+from mem_mcp.embeddings.bedrock import EmbedResult
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+from mem_mcp.mcp.tools.list import (
+    MemoryListInput,
+    MemoryListOutput,
+    MemoryListTool,
+)
+from mem_mcp.memory.hybrid_query import (
+    PREVIEW_FALLBACK_CHARS,
+    PREVIEW_MAX_CHARS,
+)
+
+pytestmark = pytest.mark.asyncio
+
+
+# ---------------------------------------------------------------------------
+# DB helpers
+# ---------------------------------------------------------------------------
+
+
+async def _create_tenant(conn: Any, email: str | None = None) -> UUID:
+    """Insert a tenant and return its id."""
+    tid = uuid4()
+    await conn.execute(
+        "INSERT INTO tenants (id, email, status) VALUES ($1, $2, 'active')",
+        tid,
+        email or f"t-{uuid4()}@test.invalid",
+    )
+    return tid
+
+
+async def _create_identity(conn: Any, tenant_id: UUID) -> UUID:
+    """Insert a primary tenant identity (needed for the audit_log FK)."""
+    iid = uuid4()
+    await conn.execute(
+        """
+        INSERT INTO tenant_identities
+            (id, tenant_id, cognito_sub, provider, email, is_primary)
+        VALUES ($1, $2, $3, 'cognito', $4, true)
+        """,
+        iid,
+        tenant_id,
+        f"sub-{tenant_id}",
+        f"i-{tenant_id}@test.invalid",
+    )
+    return iid
+
+
+async def _insert_memory(
+    conn: Any,
+    tenant_id: UUID,
+    content: str,
+    *,
+    type: str = "note",
+    tags: list[str] | None = None,
+    created_at: datetime | None = None,
+    updated_at: datetime | None = None,
+    is_current: bool = True,
+    deleted_at: datetime | None = None,
+    expires_at: datetime | None = None,
+    indexable: bool = True,
+    embedding_status: str = "ok",
+    team_id: UUID | None = None,
+    parent_id: UUID | None = None,
+) -> UUID:
+    """Insert one memory row and return its id."""
+    ts = created_at or datetime.now(tz=UTC)
+    uts = updated_at or ts
+    cols = [
+        "tenant_id", "content", "content_hash", "source_kind", "type", "tags",
+        "created_at", "updated_at", "deleted_at", "expires_at", "indexable",
+        "embedding_status", "is_current",
+    ]
+    params: list[Any] = [
+        tenant_id,
+        content,
+        f"hash-{uuid4().hex}",
+        "api",
+        type,
+        tags or [],
+        ts,
+        uts,
+        deleted_at,
+        expires_at,
+        indexable,
+        embedding_status,
+        is_current,
+    ]
+    if team_id is not None:
+        cols.append("team_id")
+        params.append(team_id)
+    if parent_id is not None:
+        cols.append("parent_id")
+        params.append(parent_id)
+    placeholder_str = ", ".join(f"${i}" for i in range(1, len(params) + 1))
+    col_str = ", ".join(cols)
+    mem_id = await conn.fetchval(
+        f"INSERT INTO memories ({col_str}) VALUES ({placeholder_str}) RETURNING id",
+        *params,
+    )
+    return mem_id
+
+
+async def _create_team(conn: Any, tenant_id: UUID, name: str | None = None) -> UUID:
+    """Create a team owned by *tenant_id*."""
+    return await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+        name or f"team-{uuid4().hex[:8]}",
+        tenant_id,
+    )
+
+
+async def _cleanup_tenant(conn: Any, tenant_id: UUID) -> None:
+    """Remove everything created for a test tenant (FK-safe ordering)."""
+    await conn.execute(
+        "DELETE FROM team_role_assignments WHERE parent_team_id IN "
+        "(SELECT id FROM teams WHERE created_by_tenant_id = $1)",
+        tenant_id,
+    )
+    await conn.execute("DELETE FROM teams WHERE created_by_tenant_id = $1", tenant_id)
+    await conn.execute("DELETE FROM audit_log WHERE tenant_id = $1", tenant_id)
+    await conn.execute("DELETE FROM memories WHERE tenant_id = $1", tenant_id)
+    await conn.execute("DELETE FROM tenant_identities WHERE tenant_id = $1", tenant_id)
+    await conn.execute("DELETE FROM tenants WHERE id = $1", tenant_id)
+
+
+def _encode_cursor_raw(iso_str: str, uuid_str: str) -> str:
+    """Encode a cursor from raw strings (bypassing _encode_cursor's type checks)
+    to craft deliberately malformed cursors for xfail tests."""
+    return base64.urlsafe_b64encode(
+        json.dumps([iso_str, uuid_str]).encode()
+    ).decode()
+
+
+class _StubEmbed:
+    """Minimal stand-in; memory.list never calls the embedder."""
+
+    async def embed(self, content: str) -> Any:  # pragma: no cover
+        return EmbedResult(vector=[0.0] * 1024, input_tokens=1)
+
+
+def _build_ctx(
+    pool: Any, tenant_id: UUID, identity_id: UUID, client_id: str = "client-test"
+) -> ToolContext:
+    return ToolContext(
+        request_id=f"req-{uuid4().hex[:8]}",
+        tenant_id=tenant_id,
+        identity_id=identity_id,
+        client_id=client_id,
+        scopes=frozenset({"memory.read"}),
+        db_pool=pool,
+        deps=ToolDeps(
+            embeddings=_StubEmbed(),
+            audit=DbAuditLogger(),
+            quotas=NoopQuotas(),
+        ),
+    )
+
