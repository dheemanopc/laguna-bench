+"""Pure-unit tests for memory.list input model, cursor helpers, deps guard, audit kwargs.
+
+Covers behaviour not already exercised by ``test_tools_list.py`` (mock-based)
+and ``test_search_preview_lenient.py``:
+  - MemoryListInput full validation surface (extra=forbid, all MemoryType values,
+    keyword length bounds, limit/range bounds, order/order_by literals).
+  - _encode_cursor / _decode_cursor round-trips and every invalid-cursor path.
+  - Tool __call__ guard when ``ctx.deps is None``.
+  - Audit call kwargs (action, result, tenant_id, details) captured via a
+    recording logger + mock conn.
+"""
+
+from __future__ import annotations
+
+import base64
+import json
