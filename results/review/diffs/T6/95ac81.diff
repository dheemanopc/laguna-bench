+    async def test_filter_by_since_and_until_window(self, list_tenant: Any) -> None:
+        """since+until window: only rows whose created_at falls in [since, until]."""
+        t = list_tenant
+        base = datetime(2026, 6, 1, 12, 0, 0, tzinfo=UTC)
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                await _insert_memory(conn, t["tenant_id"], "early", created_at=base)
+                await _insert_memory(conn, t["tenant_id"], "middle", created_at=base + timedelta(days=1))
+                await _insert_memory(conn, t["tenant_id"], "late", created_at=base + timedelta(days=2))
+
+        ctx = _build_ctx(t["pool"], t["tenant_id"], t["identity_id"])
+        # Window [base+0.5d, base+1.5d] → only middle
+        out = await MemoryListTool()(
+            ctx,
+            MemoryListInput(
+                since=base + timedelta(hours=12),
+                until=base + timedelta(days=1, hours=12),
