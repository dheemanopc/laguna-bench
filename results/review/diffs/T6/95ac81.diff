+                assert contents == ["newer_created_older_updated", "older_created_newer_updated"]
+            else:
+                assert contents == ["older_created_newer_updated", "newer_created_older_updated"]
+        else:  # order_by == "updated_at"
+            if order == "desc":
+                # newer updated_at first
+                assert contents == ["older_created_newer_updated", "newer_created_older_updated"]
+            else:
+                assert contents == ["newer_created_older_updated", "older_created_newer_updated"]
