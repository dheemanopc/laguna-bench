+class TestTenantScoping:
+    async def test_list_only_returns_own_tenant_memories(self, list_tenant_two: Any) -> None:
+        """memory.list must filter to the requesting tenant only."""
+        ta, tb = list_tenant_two["a"], list_tenant_two["b"]
+        pool = list_tenant_two["pool"]
+        async with pool.acquire() as conn:
+            async with conn.transaction():
+                await _insert_memory(conn, ta["tenant_id"], "tenant A content 1")
+                await _insert_memory(conn, ta["tenant_id"], "tenant A content 2")
+                await _insert_memory(conn, tb["tenant_id"], "tenant B content 1")
+
+        ctx = _build_ctx(pool, ta["tenant_id"], ta["identity_id"])
+        out = await MemoryListTool()(ctx, MemoryListInput())
+        assert isinstance(out, MemoryListOutput)
+        assert len(out.results) == 2
+        assert all(r.content.startswith("tenant A") for r in out.results)
+        # Explicitly assert tenant B's rows are NOT visible to tenant A
+        a_contents = {r.content for r in out.results}
+        assert "tenant B content 1" not in a_contents
+
+        ctx_b = _build_ctx(pool, tb["tenant_id"], tb["identity_id"])
+        out_b = await MemoryListTool()(ctx_b, MemoryListInput())
+        assert isinstance(out_b, MemoryListOutput)
+        assert len(out_b.results) == 1
+        assert out_b.results[0].content.startswith("tenant B")
+        # Explicitly assert tenant A's rows are NOT visible to tenant B
+        b_contents = {r.content for r in out_b.results}
+        assert "tenant A content 1" not in b_contents
+        assert "tenant A content 2" not in b_contents
+
