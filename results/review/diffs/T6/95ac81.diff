+    @pytest.mark.parametrize("order_by,order", [
+        ("created_at", "desc"),
+        ("created_at", "asc"),
+        ("updated_at", "desc"),
+        ("updated_at", "asc"),
+    ])
+    async def test_conflicting_created_vs_updated_ordering(
+        self, list_tenant: Any, order_by: str, order: str
+    ) -> None:
+        """When created_at and updated_at conflict, order_by must use the
+        selected column.  Row 'newer_created_older_updated' has a newer
+        created_at but older updated_at than 'older_created_newer_updated'."""
+        t = list_tenant
