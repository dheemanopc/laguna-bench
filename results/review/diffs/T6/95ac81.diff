+"""DB-backed integration tests for plugin notice delivery.
+
+Exercises the two halves of the notice pipeline against a live Postgres:
+
+- ``NoticeClientImpl.queue`` — real INSERT into ``plugin_notices`` with
+  default and custom TTLs, payload serialization via ``_json_default``
+  (datetime → ISO string, UUID → str) so that ``json.dumps`` of payloads
+  that contain non-JSON-native types never raises.
+- ``deliver_pending`` — real ``UPDATE … RETURNING … SKIP LOCKED``,
+  template rendering, ascending ``created_at`` ordering, ``LIMIT``,
+  at-most-once semantics (delivered_at), expiry filtering (``expires_at > now()``),
+  tenant isolation, missing-key warning with 120-char truncation, and
+  ``RenderedNotice.to_dict()`` field surface.
+
+Skips cleanly when ``MEM_MCP_TEST_DSN`` is unset (via the ``pg_pool`` fixture).
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import random
+from datetime import UTC, date, datetime, timedelta
+from typing import Any
+from unittest.mock import patch
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.db.tenant_tx import system_tx
+from mem_mcp.plugins.clients.notices import NoticeClientImpl
+from mem_mcp.plugins.notice_delivery import (
+    RenderedNotice,
+    deliver_pending,
+)
+
+pytestmark = pytest.mark.asyncio
+
+_NOTICE_LOGGER = "mem_mcp.plugins.notice_delivery"
+
+
+# ---------------------------------------------------------------------------
+# DB helpers
+# ---------------------------------------------------------------------------
+
+
+async def _create_tenant(conn: Any, email: str | None = None) -> UUID:
+    return await conn.fetchval(
+        "INSERT INTO tenants (email, status) VALUES ($1, 'active') RETURNING id",
+        email or f"notices-{uuid4()}@test.invalid",
+    )
+
+
+async def _insert_notice_direct(
+    conn: Any,
+    tenant_id: UUID,
+    *,
+    plugin_id: str = "test-plugin",
+    kind: str = "alert",
+    template: str = "Hello {name}",
+    payload: dict[str, Any] | None = None,
+    expires_at: datetime | None = None,
+    created_at: datetime | None = None,
+    delivered_at: datetime | None = None,
+) -> UUID:
+    """Insert a plugin_notices row directly (bypass queue) for fine control."""
+    now = datetime.now(tz=UTC)
+    exp = expires_at if expires_at is not None else now + timedelta(hours=1)
+    created = created_at if created_at is not None else now
+    return await conn.fetchval(
+        """
+        INSERT INTO plugin_notices
+            (tenant_id, plugin_id, kind, template, payload, created_at, expires_at, delivered_at)
+        VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
+        RETURNING id
+        """,
+        tenant_id,
+        plugin_id,
+        kind,
+        template,
+        json.dumps(payload or {}),
+        created,
+        exp,
+        delivered_at,
+    )
+
+
+# ---------------------------------------------------------------------------
+# Fixtures
+# ---------------------------------------------------------------------------
+
+
<email>
+async def notices_tenant(pg_pool: Any) -> Any:
+    """Create a tenant (FK requirement for plugin_notices) and clean up."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            tenant_id = await _create_tenant(conn)
+    yield {"tenant_id": tenant_id, "pool": pg_pool}
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute(
+                "DELETE FROM plugin_notices WHERE tenant_id = $1", tenant_id
+            )
+            await conn.execute("DELETE FROM tenants WHERE id = $1", tenant_id)
+
+
<email>
+async def notices_two_tenants(pg_pool: Any) -> Any:
+    """Create two tenants for isolation tests."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            ta = await _create_tenant(conn, f"iso-a-{uuid4()}@test.invalid")
+            tb = await _create_tenant(conn, f"iso-b-{uuid4()}@test.invalid")
+    yield {
+        "a": {"tenant_id": ta, "pool": pg_pool},
+        "b": {"tenant_id": tb, "pool": pg_pool},
+    }
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute(
+                "DELETE FROM plugin_notices WHERE tenant_id = $1 OR tenant_id = $2",
+                ta,
+                tb,
+            )
+            await conn.execute("DELETE FROM tenants WHERE id = $1 OR id = $2", ta, tb)
