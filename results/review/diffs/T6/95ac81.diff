+"""Pure-unit tests for _render edge cases, _json_default, RenderedNotice.to_dict().
+
+Covers behaviour not already exercised by:
+- test_notice_delivery.py  (basic _render substitution, missing-key warning, non-string coercion)
+- test_notice_client_serialization.py  (_json_default for datetime/date/UUID through json.dumps, queue param order)
+
+Focus: edge cases, type-correctness of to_dict(), and the str() fallback path.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+from datetime import UTC, date, datetime, time, timedelta, timezone
+from typing import Any
+from uuid import uuid4
+
+import pytest
+
+from mem_mcp.plugins.clients.notices import _json_default
+from mem_mcp.plugins.notice_delivery import RenderedNotice, _render
+
+_NOTICE_LOGGER = "mem_mcp.plugins.notice_delivery"
+
+
+# ---------------------------------------------------------------------------
+# _render edge cases
+# ---------------------------------------------------------------------------
+
+
+class TestRenderEdgeCases:
+    def test_empty_template_returns_empty(self) -> None:
+        assert _render("", {"a": "b"}) == ""
+
+    def test_key_appearing_multiple_times_all_substituted(self) -> None:
+        assert _render("{a}{a}", {"a": "x"}) == "xx"
+
+    def test_none_value_coerced_via_str(self) -> None:
+        # isinstance(None, str) is False → str(None) → "None"
+        assert _render("{a}", {"a": None}) == "None"
+
+    def test_zero_integer_coerced_via_str(self) -> None:
+        # 0 is falsy but not a str → str(0) → "0"
+        assert _render("{a}", {"a": 0}) == "0"
+
+    def test_negative_integer_coerced_via_str(self) -> None:
+        assert _render("{a}", {"a": -42}) == "-42"
+
+    def test_false_boolean_coerced_via_str(self) -> None:
+        assert _render("{a}", {"a": False}) == "False"
+
+    def test_float_value_coerced_via_str(self) -> None:
+        assert _render("{a}", {"a": 3.14}) == "3.14"
+
+    def test_list_value_coerced_via_str(self) -> None:
+        assert _render("{a}", {"a": [1, 2, 3]}) == "[1, 2, 3]"
+
+    def test_dict_value_coerced_via_str(self) -> None:
+        assert _render("{a}", {"a": {"k": "v"}}) == "{'k': 'v'}"
+
+    def test_consecutive_placeholders_all_substituted(self) -> None:
+        assert _render("{a}{b}{c}", {"a": "1", "b": "2", "c": "3"}) == "123"
+
+    def test_whitespace_only_template_untouched(self) -> None:
+        assert _render("   ", {}) == "   "
+
+    def test_empty_braces_not_treated_as_placeholder(self) -> None:
+        # Regex requires [a-zA-Z_] to start the key; empty {} is literal.
+        assert _render("{}", {}) == "{}"
+
+    def test_missing_key_replaced_with_empty_and_warns(
+        self, caplog: pytest.LogCaptureFixture
+    ) -> None:
+        with caplog.at_level(logging.WARNING, logger=_NOTICE_LOGGER):
+            result = _render("Hello {missing}", {})
+        assert result == "Hello "
+        records = [r for r in caplog.records if "notice_template_missing_key" in r.message]
+        assert len(records) == 1
+        assert records[0].key == "missing"
+        # template[:120] is stored in extra
+        assert records[0].template == "Hello {missing}"
+
+    def test_multiple_missing_keys_each_warn(self, caplog: pytest.LogCaptureFixture) -> None:
+        with caplog.at_level(logging.WARNING, logger=_NOTICE_LOGGER):
+            result = _render("{a}{b}", {})
+        assert result == ""
+        records = [r for r in caplog.records if "notice_template_missing_key" in r.message]
+        assert len(records) == 2
+        assert records[0].key == "a"
+        assert records[1].key == "b"
+
+    def test_long_template_truncated_in_log(self, caplog: pytest.LogCaptureFixture) -> None:
+        template = "X" * 200 + "{missing}"
+        with caplog.at_level(logging.WARNING, logger=_NOTICE_LOGGER):
+            result = _render(template, {})
+        assert result == "X" * 200
+        records = [r for r in caplog.records if "notice_template_missing_key" in r.message]
+        assert len(records) == 1
+        # _render uses template[:120]
+        assert len(records[0].template) == 120
+        assert records[0].template == "X" * 120
+
+    def test_mixed_present_and_missing_keys(self) -> None:
+        result = _render(
+            "Hello {name}, you have {count} and {missing}",
+            {"name": "Alice", "count": 5},
+        )
+        assert result == "Hello Alice, you have 5 and "
+
+    def test_no_placeholders_ignores_payload(self) -> None:
+        assert _render("plain text", {"a": "b"}) == "plain text"
+
+    def test_key_with_underscore_and_digits(self) -> None:
+        assert _render("{user_id_2}", {"user_id_2": "ok"}) == "ok"
+
+    def test_json_like_braces_not_substituted(self) -> None:
+        # {"key": "val"} — the { is followed by " which is not [a-zA-Z_]
+        result = _render('{"key": "val"}', {"key": "val"})
+        assert result == '{"key": "val"}'
+
+    def test_placeholder_inside_braces_preserved(self) -> None:
+        # {{a}} → regex matches inner {a}, leaving outer braces
+        result = _render("{{a}}", {"a": "x"})
+        assert result == "{x}"
+
+
+# ---------------------------------------------------------------------------
+# _json_default
+# ---------------------------------------------------------------------------
+
+
+class TestJsonDefault:
+    # datetime / date → .isoformat()
+
+    def test_datetime_with_utc(self) -> None:
+        dt = datetime(2026, 6, 10, 12, 30, 0, tzinfo=UTC)
+        assert _json_default(dt) == dt.isoformat()
+        assert isinstance(_json_default(dt), str)
+
+    def test_datetime_naive_no_tz_suffix(self) -> None:
+        dt = datetime(2026, 6, 10, 12, 30, 0)
+        result = _json_default(dt)
+        assert result == "2026-06-10T12:30:00"
+        assert "+00:00" not in result
+
+    def test_datetime_with_microseconds(self) -> None:
+        dt = datetime(2026, 6, 10, 12, 30, 0, 123456, tzinfo=UTC)
+        result = _json_default(dt)
+        assert ".123456" in result
+
+    def test_datetime_with_non_utc_offset(self) -> None:
+        tz = timezone(timedelta(hours=5, minutes=30))
+        dt = datetime(2026, 6, 10, 12, 0, 0, tzinfo=tz)
+        result = _json_default(dt)
+        assert result == "2026-06-10T12:00:00+05:30"
+
+    def test_date_only(self) -> None:
+        d = date(2026, 6, 10)
+        result = _json_default(d)
+        assert result == "2026-06-10"
+        assert isinstance(result, str)
+
+    def test_datetime_uses_isoformat_not_str(self) -> None:
+        """Verify the isinstance(datetime|date) branch is taken for datetime.
+        str(dt) gives '2026-06-10 12:00:00+00:00' (space), isoformat gives 'T'.
+        """
+        dt = datetime(2026, 6, 10, 12, 0, 0, tzinfo=UTC)
+        assert _json_default(dt) == dt.isoformat()
+        assert _json_default(dt) != str(dt)
+
+    # Everything else → str(obj)
+
+    def test_uuid_uses_str_fallback(self) -> None:
+        u = uuid4()
+        assert _json_default(u) == str(u)
+
+    def test_int_uses_str_fallback(self) -> None:
+        assert _json_default(42) == "42"
+        assert _json_default(0) == "0"
+        assert _json_default(-1) == "-1"
+
+    def test_float_uses_str_fallback(self) -> None:
+        assert _json_default(3.14) == "3.14"
+
+    def test_bool_uses_str_fallback(self) -> None:
+        assert _json_default(True) == "True"
+        assert _json_default(False) == "False"
+
+    def test_none_uses_str_fallback(self) -> None:
+        assert _json_default(None) == "None"
+
+    def test_set_uses_str_fallback(self) -> None:
+        result = _json_default({1, 2, 3})
+        assert isinstance(result, str)
+        assert "{1, 2, 3}" == result or "{'1', '2', '3'}" == result or result.startswith("{")
+
+    def test_bytes_uses_str_fallback(self) -> None:
+        assert _json_default(b"hello") == str(b"hello")
+
+    def test_time_uses_str_fallback(self) -> None:
+        """time is NOT a subclass of date/datetime, so str() fallback is used."""
+        t = time(12, 30, 45)
+        assert _json_default(t) == str(t)
+
+    def test_custom_object_uses_str_fallback(self) -> None:
+        class Custom:
+            def __str__(self) -> str:
+                return "custom_result"
+
+        assert _json_default(Custom()) == "custom_result"
+
+    # Through json.dumps
+
+    def test_json_dumps_datetime(self) -> None:
+        dt = datetime(2026, 6, 10, 12, 0, 0, tzinfo=UTC)
+        dumped = json.dumps({"dt": dt}, default=_json_default)
+        assert json.loads(dumped) == {"dt": dt.isoformat()}
+
+    def test_json_dumps_date(self) -> None:
+        d = date(2026, 6, 10)
+        dumped = json.dumps({"d": d}, default=_json_default)
