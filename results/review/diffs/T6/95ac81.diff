+class TestPagination:
+    async def test_first_page_returns_next_cursor_when_overflow(
+        self, list_tenant: Any
+    ) -> None:
+        t = list_tenant
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                for i in range(40):
+                    await _insert_memory(
+                        conn,
+                        t["tenant_id"],
+                        f"item-{i:02d}",
+                        created_at=datetime(2026, 6, 1, 12, 0, 0, tzinfo=UTC)
+                        + timedelta(seconds=i),
+                    )
+
+        ctx = _build_ctx(t["pool"], t["tenant_id"], t["identity_id"])
+        out = await MemoryListTool()(ctx, MemoryListInput(limit=25))
+        assert isinstance(out, MemoryListOutput)
+        assert len(out.results) == 25
+        assert out.next_cursor is not None
+
+    async def test_exact_limit_boundaries(self, list_tenant: Any) -> None:
+        """limit==N → no cursor (no overflow).  limit==N+1 → cursor present
+        and the first N results are exactly the last-inserted N ids (desc order)."""
+        t = list_tenant
+        base = datetime(2026, 6, 1, 12, 0, 0, tzinfo=UTC)
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                for i in range(5):
+                    await _insert_memory(
+                        conn, t["tenant_id"], f"item-{i}",
+                        created_at=base + timedelta(seconds=i),
+                    )
+
+        ctx = _build_ctx(t["pool"], t["tenant_id"], t["identity_id"])
+
+        # limit == 5 (exactly N) → no overflow, no cursor
+        out_exact = await MemoryListTool()(ctx, MemoryListInput(limit=5))
+        assert len(out_exact.results) == 5
+        assert out_exact.next_cursor is None
+
+        # limit == 6 (N+1) → still only 5 rows (no overflow), no cursor
+        out_over = await MemoryListTool()(ctx, MemoryListInput(limit=6))
+        assert len(out_over.results) == 5
+        assert out_over.next_cursor is None
+
+        # Insert one more row so N+1 == 6 with limit=5 gives overflow
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                await _insert_memory(
+                    conn, t["tenant_id"], "item-5",
+                    created_at=base + timedelta(seconds=5),
+                )
+
+        out_overflow = await MemoryListTool()(ctx, MemoryListInput(limit=5))
+        assert len(out_overflow.results) == 5
+        assert out_overflow.next_cursor is not None
+        # In desc order, first 5 are item-5, item-4, item-3, item-2, item-1
+        assert [r.content for r in out_overflow.results] == [
+            "item-5", "item-4", "item-3", "item-2", "item-1",
+        ]
