+# ---------------------------------------------------------------------------
+# deliver_pending — DB-backed delivery behaviour
+# ---------------------------------------------------------------------------
+
+
+class TestDeliverPending:
+    async def test_deliver_renders_template_from_payload(
+        self, notices_tenant: Any
+    ) -> None:
+        """deliver_pending must render {key} placeholders from the stored payload."""
+        t = notices_tenant
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                await _insert_notice_direct(
+                    conn,
+                    t["tenant_id"],
+                    template="Reminder: {content}",
+                    payload={"content": "Take medicines"},
+                )
+
+        async with system_tx(t["pool"]) as conn:
+            delivered = await deliver_pending(conn, t["tenant_id"], limit=20)
+
+        assert len(delivered) == 1
+        assert isinstance(delivered[0], RenderedNotice)
+        assert delivered[0].text == "Reminder: Take medicines"
+
+    @pytest.mark.xfail(
+        strict=False,
+        reason="BUG: UPDATE...RETURNING does not preserve the subquery's ORDER BY "
+        "created_at ASC; returned row order is nondeterministic across runs. "
+        "Verified: 3 consecutive runs produced different delivery orders "
+        "(e.g. [0,3,4,5,2,1], [3,...], [4,...] vs expected [0,1,2,3,4,5]).",
+    )
+    async def test_deliver_selects_oldest_first_order(
+        self, notices_tenant: Any
+    ) -> None:
+        """deliver_pending should return notices ordered by created_at ASC.
+
+        Inserts 6 rows with distinct created_at in shuffled physical insertion
+        order; asserts the returned list order exactly matches created_at
+        ascending (no sorting of the result before comparing).  Currently
+        xfailed because UPDATE...RETURNING does not guarantee order.
+        """
+        t = notices_tenant
+        base = datetime(2026, 6, 1, 12, 0, 0, tzinfo=UTC)
+        timestamps = [base + timedelta(seconds=i) for i in range(6)]
+        insertion_order = list(range(6))
+        random.shuffle(insertion_order)
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                for idx in insertion_order:
+                    await _insert_notice_direct(
+                        conn, t["tenant_id"],
+                        template="{i}", payload={"i": f"{idx}"},
+                        created_at=timestamps[idx],
+                    )
+
+        async with system_tx(t["pool"]) as conn:
+            delivered = await deliver_pending(conn, t["tenant_id"], limit=20)
+
+        assert len(delivered) == 6
+        # Assert exact order without sorting the result
+        delivered_times = [d.created_at for d in delivered]
+        assert delivered_times == timestamps
+
+    async def test_default_limit_returns_twenty_oldest_then_one(
+        self, notices_tenant: Any
+    ) -> None:
+        """deliver_pending with no limit arg (defaults to 20) returns the 20
+        oldest of 21 pending; a second call returns the remaining 1."""
+        t = notices_tenant
+        base = datetime(2026, 6, 1, 12, 0, 0, tzinfo=UTC)
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                for i in range(21):
+                    await _insert_notice_direct(
+                        conn, t["tenant_id"],
+                        template="{i}", payload={"i": str(i)},
+                        created_at=base + timedelta(seconds=i),
+                    )
+
+        # First call: no limit arg → defaults to 20
+        async with system_tx(t["pool"]) as conn:
+            first = await deliver_pending(conn, t["tenant_id"])
+        assert len(first) == 20
+        first_ids = {d.id for d in first}
+        assert len(first_ids) == 20  # no duplicates
+
+        # Second call: remaining 1
+        async with system_tx(t["pool"]) as conn:
+            second = await deliver_pending(conn, t["tenant_id"])
+        assert len(second) == 1
+        assert second[0].id not in first_ids
+
+    async def test_deliver_respects_limit(self, notices_tenant: Any) -> None:
+        """deliver_pending(limit=2) returns exactly the 2 oldest by created_at ASC."""
+        t = notices_tenant
+        base = datetime(2026, 6, 1, 12, 0, 0, tzinfo=UTC)
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                for i in range(5):
+                    await _insert_notice_direct(
+                        conn, t["tenant_id"],
+                        template="{i}", payload={"i": str(i)},
+                        created_at=base + timedelta(seconds=i),
+                    )
+
+        async with system_tx(t["pool"]) as conn:
+            delivered = await deliver_pending(conn, t["tenant_id"], limit=2)
+
+        # Exact set: the 2 oldest by created_at (set-based check, no ordering assertion)
+        assert len(delivered) == 2
+        delivered_texts = {d.text for d in delivered}
+        assert delivered_texts == {"0", "1"}
+
+        # At-most-once: exactly the delivered ids have delivered_at IS NOT NULL,
+        # the rest IS NULL.
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                rows = await conn.fetch(
+                    "SELECT id, delivered_at FROM plugin_notices WHERE tenant_id = $1 "
+                    "ORDER BY created_at ASC",
+                    t["tenant_id"],
+                )
+        delivered_db_ids = {r["id"] for r in rows if r["delivered_at"] is not None}
+        pending_db_ids = {r["id"] for r in rows if r["delivered_at"] is None}
+        assert delivered_db_ids == {d.id for d in delivered}
+        assert len(pending_db_ids) == 3  # remaining 3
+
+        async with system_tx(t["pool"]) as conn:
+            remaining = await deliver_pending(conn, t["tenant_id"], limit=20)
+        assert len(remaining) == 3
+        assert sorted(d.text for d in remaining) == ["2", "3", "4"]
+
+    async def test_deliver_at_most_once(self, notices_tenant: Any) -> None:
+        """A second deliver_pending call returns nothing for already-delivered."""
+        t = notices_tenant
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                await _insert_notice_direct(
+                    conn, t["tenant_id"], template="{x}", payload={"x": "v1"},
+                )
+                await _insert_notice_direct(
+                    conn, t["tenant_id"], template="{x}", payload={"x": "v2"},
+                )
+
+        async with system_tx(t["pool"]) as conn:
+            first = await deliver_pending(conn, t["tenant_id"], limit=20)
+        assert len(first) == 2
+
+        async with system_tx(t["pool"]) as conn:
+            second = await deliver_pending(conn, t["tenant_id"], limit=20)
