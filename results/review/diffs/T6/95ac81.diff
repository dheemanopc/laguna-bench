+        "but not KeyError; JSON dict cursor raises KeyError that propagates "
+        "uncaught instead of being wrapped as JsonRpcError(-32602)",
+    )
+    async def test_cursor_decoding_to_json_dict_wraps_as_invalid_cursor(
