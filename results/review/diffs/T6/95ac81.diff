+class TestMalformedCursorInCall:
+    """Cursors that decode as valid base64+JSON but produce non-(JSONDecodeError,
+    IndexError, ValueError) exceptions inside _decode_cursor must still be wrapped
+    as JsonRpcError(-32602) by __call__.  These are xfail because the current
+    except-clause omits TypeError/KeyError, so the raw exception propagates."""
+
+    @pytest.mark.xfail(
+        strict=True,
+        reason="BUG: _decode_cursor catches (JSONDecodeError, IndexError, ValueError) "
+        "but not TypeError; JSON int cursor raises TypeError that propagates "
+        "uncaught instead of being wrapped as JsonRpcError(-32602)",
+    )
+    async def test_cursor_decoding_to_json_int_wraps_as_invalid_cursor(
