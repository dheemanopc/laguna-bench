+        ctx = _build_ctx(t["pool"], t["tenant_id"], t["identity_id"])
+        out = await MemoryListTool()(
+            ctx, MemoryListInput(order_by=order_by, order=order, limit=100)
+        )
+        contents = [r.content for r in out.results]
