+    @pytest.mark.xfail(
+        strict=True,
+        reason="BUG: next_cursor encodes the (limit+1)th overflow row (rows[limit]) "
+        "instead of the last RETURNED row (rows[limit-1]), so the next page would "
+        "skip one row (list.py:228).",
+    )
+    async def test_next_cursor_encodes_last_returned_row(
+        self, list_tenant: Any
+    ) -> None:
+        """With limit+1 rows fetched, next_cursor must encode the LAST returned
+        row (rows[limit-1]), not the overflow row (rows[limit])."""
+        t = list_tenant
+        base = datetime(2026, 6, 1, 12, 0, 0, tzinfo=UTC)
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                for i in range(3):
+                    await _insert_memory(
+                        conn, t["tenant_id"], f"item-{i}",
+                        created_at=base + timedelta(seconds=i),
+                    )
+
+        ctx = _build_ctx(t["pool"], t["tenant_id"], t["identity_id"])
+        out = await MemoryListTool()(ctx, MemoryListInput(limit=2))
+        assert len(out.results) == 2
+        assert out.next_cursor is not None
+
+        # Decode the cursor and verify it points to the LAST returned row,
+        # not the overflow (3rd) row.
+        # In DESC order: item-2 (newest), item-1, item-0 (oldest).
+        # limit=2 → returns [item-2, item-1], overflow is item-0.
+        # Cursor should encode item-1 (last returned), not item-0 (overflow).
+        from mem_mcp.mcp.tools.list import _decode_cursor
+
+        iso, uuid_str = _decode_cursor(out.next_cursor)
+        last_returned = out.results[-1]
+        assert iso == last_returned.created_at.isoformat()
+        assert uuid_str == str(last_returned.id)
