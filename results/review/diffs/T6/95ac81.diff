+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+
+class _RecordingAuditLogger:
+    """Captures audit() kwargs — Protocol-compatible with AuditLogger."""
+
+    def __init__(self) -> None:
+        self.calls: list[dict[str, Any]] = []
+
+    async def audit(
+        self,
+        conn: Any,
+        *,
+        action: str,
+        result: str,
+        tenant_id: UUID | None,
+        identity_id: UUID | None = None,
+        client_id: str | None = None,
+        target_id: UUID | None = None,
+        target_kind: str | None = None,
+        ip_address: str | None = None,
+        user_agent: str | None = None,
+        request_id: str | None = None,
+        error_code: str | None = None,
+        details: dict[str, Any] | None = None,
+    ) -> None:
+        self.calls.append(
+            {
+                "conn": conn,
+                "action": action,
+                "result": result,
+                "tenant_id": tenant_id,
+                "identity_id": identity_id,
+                "client_id": client_id,
+                "target_id": target_id,
+                "target_kind": target_kind,
+                "ip_address": ip_address,
+                "user_agent": user_agent,
+                "request_id": request_id,
+                "error_code": error_code,
+                "details": details,
+            }
+        )
+
+
+def _ctx(audit_logger: Any = None) -> ToolContext:
+    """Build a test ToolContext with the given audit logger."""
+    return ToolContext(
+        request_id=str(uuid4()),
+        tenant_id=uuid4(),
+        identity_id=uuid4(),
+        client_id="client-test",
+        scopes=frozenset(("memory.read",)),
+        db_pool=MagicMock(),
+        deps=ToolDeps(
+            embeddings=MagicMock(),
+            audit=audit_logger or NoopAuditLogger(),
+            quotas=NoopQuotas(),
+        ),
+    )
+
