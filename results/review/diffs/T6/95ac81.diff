+    async def test_empty_tags_list_returns_all(self, list_tenant: Any) -> None:
+        """An empty tags list means no tag filter — all current memories returned."""
+        t = list_tenant
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                await _insert_memory(conn, t["tenant_id"], "no tags", tags=[])
+                await _insert_memory(conn, t["tenant_id"], "has tag", tags=["x"])
+
