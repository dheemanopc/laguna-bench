+    async def test_filter_by_tags_intersects(self, list_tenant: Any) -> None:
+        """tags filter intersects: a memory must carry ALL requested tags."""
+        t = list_tenant
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                await _insert_memory(conn, t["tenant_id"], "both", tags=["a", "b"])
+                await _insert_memory(conn, t["tenant_id"], "only a", tags=["a"])
+                await _insert_memory(conn, t["tenant_id"], "only b", tags=["b"])
+
+        ctx = _build_ctx(t["pool"], t["tenant_id"], t["identity_id"])
+        out = await MemoryListTool()(ctx, MemoryListInput(tags=["a", "b"]))
