+# ---------------------------------------------------------------------------
+# NoticeClientImpl.queue — persistence & serialization
+# ---------------------------------------------------------------------------
+
+
+class TestQueuePersistence:
+    async def test_queue_inserts_row_with_default_ttl_exact(
+        self, notices_tenant: Any
+    ) -> None:
+        """queue() with no ttl_seconds must persist with expires_at - created_at
+        == exactly 86 400 s (one day)."""
+        t = notices_tenant
+        client = NoticeClientImpl(t["pool"], t["tenant_id"], "reminders")
+        await client.queue("reminder_fired", "Reminder: {content}", {"content": "test"})
+
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                row = await conn.fetchrow(
+                    "SELECT tenant_id, plugin_id, kind, template, payload, "
+                    "expires_at, created_at, delivered_at "
+                    "FROM plugin_notices WHERE tenant_id = $1",
+                    t["tenant_id"],
+                )
+        assert row is not None
+        assert row["tenant_id"] == t["tenant_id"]
+        assert row["plugin_id"] == "reminders"
+        assert row["kind"] == "reminder_fired"
+        assert row["template"] == "Reminder: {content}"
+        assert row["delivered_at"] is None
+        # Both created_at and expires_at use now() within the same transaction.
+        assert row["expires_at"] - row["created_at"] == timedelta(seconds=86400)
+
+    async def test_queue_custom_ttl_exact(self, notices_tenant: Any) -> None:
+        """queue(ttl_seconds=60) must set expires_at - created_at == 60 s."""
+        t = notices_tenant
+        client = NoticeClientImpl(t["pool"], t["tenant_id"], "plugin-x")
+        await client.queue("alert", "{msg}", {"msg": "hi"}, ttl_seconds=60)
+
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                row = await conn.fetchrow(
+                    "SELECT expires_at, created_at FROM plugin_notices WHERE tenant_id = $1",
+                    t["tenant_id"],
+                )
+        assert row["expires_at"] - row["created_at"] == timedelta(seconds=60)
+
+    async def test_queue_ttl_zero_expires_at_equals_created_at_and_never_delivered(
+        self, notices_tenant: Any
+    ) -> None:
+        """ttl_seconds=0 → expires_at == created_at → notice expires immediately
+        and is never delivered (expires_at > now() is false)."""
+        t = notices_tenant
+        client = NoticeClientImpl(t["pool"], t["tenant_id"], "plugin-zero")
+        await client.queue("evt", "msg={x}", {"x": "v"}, ttl_seconds=0)
+
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                row = await conn.fetchrow(
+                    "SELECT expires_at, created_at FROM plugin_notices WHERE tenant_id = $1",
+                    t["tenant_id"],
+                )
+        assert row is not None
+        assert row["expires_at"] == row["created_at"]
+
+        # expires_at == created_at → not > now() → never delivered
+        async with system_tx(t["pool"]) as conn:
+            delivered = await deliver_pending(conn, t["tenant_id"], limit=20)
+        assert delivered == []
+
+    async def test_payload_datetime_serialized_via_json_default(
+        self, notices_tenant: Any
+    ) -> None:
+        """datetime values in payload must be isoformat strings (via _json_default)."""
+        t = notices_tenant
+        fire_at = datetime(2026, 6, 10, 11, 41, 38, tzinfo=UTC)
+        item_id = uuid4()
+        client = NoticeClientImpl(t["pool"], t["tenant_id"], "reminders")
+        await client.queue(
+            "reminder_fired",
+            "Reminder: {content}",
+            {"content": "Take medicines", "fire_at": fire_at, "item_id": item_id},
+        )
+
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                row = await conn.fetchrow(
+                    "SELECT payload FROM plugin_notices WHERE tenant_id = $1",
+                    t["tenant_id"],
+                )
+        payload = row["payload"]
+        if isinstance(payload, str):
+            payload = json.loads(payload)
+        assert payload["content"] == "Take medicines"
+        assert payload["fire_at"] == "2026-06-10T11:41:38+00:00"
+        assert payload["item_id"] == str(item_id)
+
+    async def test_payload_uuid_no_payload_serialization_crash(
+        self, notices_tenant: Any
+    ) -> None:
+        """A UUID in payload (not natively JSON-serializable) must not crash queue."""
+        t = notices_tenant
+        u = uuid4()
+        client = NoticeClientImpl(t["pool"], t["tenant_id"], "plugin")
+        await client.queue("evt", "id={ref}", {"ref": u})
