+async def list_tenant_two(pg_pool: Any) -> Any:
+    """Create two tenants + identities to prove tenant isolation."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            ta = await _create_tenant(conn, f"iso-a-{uuid4()}@test.invalid")
+            ia = await _create_identity(conn, ta)
+            tb = await _create_tenant(conn, f"iso-b-{uuid4()}@test.invalid")
+            ib = await _create_identity(conn, tb)
+    yield {
+        "a": {"tenant_id": ta, "identity_id": ia},
+        "b": {"tenant_id": tb, "identity_id": ib},
+        "pool": pg_pool,
+    }
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            await _cleanup_tenant(conn, ta)
+            await _cleanup_tenant(conn, tb)
