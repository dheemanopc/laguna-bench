+
+    async def test_payload_nested_datetime(self, notices_tenant: Any) -> None:
+        """datetime nested inside a sub-dict is also serialized via _json_default."""
+        t = notices_tenant
+        when = datetime(2026, 6, 10, 9, 0, 0, tzinfo=UTC)
