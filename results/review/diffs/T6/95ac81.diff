+        assert exc_info.value.code == -32602
+        assert exc_info.value.message == "invalid cursor"
+        errors = exc_info.value.data["errors"]  # type: ignore[index]
+        assert len(errors) == 1
+        assert errors[0]["path"] == "cursor"
