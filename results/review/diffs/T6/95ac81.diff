+async def list_tenant(pg_pool: Any) -> Any:
+    """Create a tenant + identity for memory.list tests.
+
+    The setup transaction commits *before* yield so the data is visible to the
+    test body's own connections.  Everything is cleaned up on teardown.
+    """
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            tenant_id = await _create_tenant(conn)
+            identity_id = await _create_identity(conn, tenant_id)
+    yield {"tenant_id": tenant_id, "identity_id": identity_id, "pool": pg_pool}
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            await _cleanup_tenant(conn, tenant_id)
+
