+class TestKeywords:
+    async def test_matches_single_keyword(self, list_tenant: Any) -> None:
+        t = list_tenant
+        async with t["pool"].acquire() as conn:
+            async with conn.transaction():
+                await _insert_memory(conn, t["tenant_id"], "postgres is great")
+                await _insert_memory(conn, t["tenant_id"], "mysql is fine")
+
+        ctx = _build_ctx(t["pool"], t["tenant_id"], t["identity_id"])
+        out = await MemoryListTool()(ctx, MemoryListInput(keywords="postgres"))
+        assert len(out.results) == 1
+        assert out.results[0].content == "postgres is great"
+
+    async def test_or_of_lexemes_matches_any_word(self, list_tenant: Any) -> None:
+        """Lenient OR semantics: 'postgres oracle' matches rows containing
+        either word, not both."""
