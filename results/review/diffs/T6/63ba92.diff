+"""End-to-end integration tests for plugin notice delivery against live Postgres.
+
+Covers the full pipeline:
+  ``NoticeClientImpl.queue()`` → INSERT into ``plugin_notices`` →
+  ``deliver_pending()`` → UPDATE … RETURNING + ``_render()`` template
+  substitution → ``RenderedNotice`` objects.
+
+Tests:
+  - Queue + deliver a single notice (exact text, payload, created_at).
+  - Queue + deliver multiple notices: oldest-first ordering, at-most-once.
+  - Expiry filtering: expired notices are never returned.
+  - Limit parameter on deliver_pending.
+  - Cross-tenant isolation: notices for tenant A are invisible to B.
+  - Template rendering through the live pipeline (int, str, missing key).
+  - RenderedNotice.to_dict() contract.
+
+Previously-documented bugs (now fixed):
+  (BUG f) ``_render`` called ``str(payload[key])`` for a value of ``None``,
+          producing the literal string ``"None"`` instead of the empty
+          string that missing-key semantics dictate. Now treats ``None``
+          values the same as missing keys (renders as empty string).
+"""
+
+from __future__ import annotations
+
+import json
+from datetime import UTC, datetime, timedelta
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+
+from mem_mcp.plugins.clients.notices import NoticeClientImpl
+from mem_mcp.plugins.notice_delivery import (
+    RenderedNotice,
+    deliver_pending,
+)
+
+pytestmark = pytest.mark.asyncio
+
+
+# ──────────────────────────── Helpers ──────────────────────────────────
+
+
+async def _setup_tenant(conn: Any, suffix: str = "") -> UUID:
+    """Create a bare tenant row (plugin_notices only needs tenant_id FK)."""
+    return await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"notices-{suffix}-{uuid4()}@example.test",
+    )
+
+
+async def _cleanup_tenant(pool: Any, tenant: UUID) -> None:
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute(
+                "DELETE FROM plugin_notices WHERE tenant_id = $1", tenant
+            )
+            await conn.execute("DELETE FROM tenants WHERE id = $1", tenant)
+
+
+async def _insert_notice_direct(
+    conn: Any,
+    tenant: UUID,
+    *,
+    plugin_id: str = "reminders",
+    kind: str = "reminder_fired",
+    template: str = "Hello {name}",
+    payload: dict[str, Any] | None = None,
+    created_at: datetime | None = None,
+    expires_at: datetime | None = None,
+    delivered_at: datetime | None = None,
+) -> UUID:
+    """Insert a plugin_notices row directly, returning its id."""
+    base = created_at or datetime.now(tz=UTC)
+    # Default expires_at is 1h in the future from *now* (not from created_at)
+    # so that notices with past created_at values are still deliverable.
+    default_expires = datetime.now(tz=UTC) + timedelta(hours=1)
+    return await conn.fetchval(
+        """
+        INSERT INTO plugin_notices
+            (tenant_id, plugin_id, kind, template, payload, created_at, expires_at, delivered_at)
+        VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8)
+        RETURNING id
+        """,
+        tenant,
+        plugin_id,
+        kind,
+        template,
+        json.dumps(payload or {}),
+        base,
+        expires_at or default_expires,
+        delivered_at,
+    )
+
+
+# ──────────────────── Queue + deliver (single) ─────────────────────────
+
+
+async def test_queue_and_deliver_single_notice(pg_pool: Any) -> None:
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            tenant = await _setup_tenant(conn, "single")
+
+    client = NoticeClientImpl(pg_pool, tenant, plugin_id="reminders")
+    try:
+        await client.queue(
+            kind="reminder_fired",
+            template="Hey {name}, your appointment is at {time}",
+            payload={"name": "Alice", "time": "3pm"},
+        )
+
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                notices = await deliver_pending(conn, tenant, limit=20)
+
+        assert len(notices) == 1
+        n = notices[0]
+        assert isinstance(n, RenderedNotice)
+        assert n.plugin_id == "reminders"
+        assert n.kind == "reminder_fired"
+        assert n.text == "Hey Alice, your appointment is at 3pm"
+        assert n.payload == {"name": "Alice", "time": "3pm"}
+        assert n.created_at is not None
+    finally:
+        await _cleanup_tenant(pg_pool, tenant)
+
+
+async def test_deliver_when_empty_returns_empty_list(pg_pool: Any) -> None:
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            tenant = await _setup_tenant(conn, "empty")
+    try:
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                notices = await deliver_pending(conn, tenant, limit=20)
+        assert notices == []
+    finally:
+        await _cleanup_tenant(pg_pool, tenant)
+
+
+# ──────────────────── Ordering & at-most-once ──────────────────────────
+
+
+async def test_deliver_oldest_first(pg_pool: Any) -> None:
+    """deliver_pending orders by created_at ASC (oldest first)."""
+    base = datetime(2026, 6, 10, 12, 0, 0, tzinfo=UTC)
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            tenant = await _setup_tenant(conn, "order")
+            await _insert_notice_direct(
+                conn, tenant, template="third {v}", payload={"v": 3},
+                created_at=base + timedelta(hours=2),
+            )
+            await _insert_notice_direct(
+                conn, tenant, template="first {v}", payload={"v": 1},
+                created_at=base,
+            )
+            await _insert_notice_direct(
+                conn, tenant, template="second {v}", payload={"v": 2},
+                created_at=base + timedelta(hours=1),
+            )
+    try:
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                notices = await deliver_pending(conn, tenant, limit=20)
+
+        assert len(notices) == 3
+        assert [n.text for n in notices] == ["first 1", "second 2", "third 3"]
+        assert [n.payload["v"] for n in notices] == [1, 2, 3]
+    finally:
+        await _cleanup_tenant(pg_pool, tenant)
+
