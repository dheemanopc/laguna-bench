+async def test_non_list_cursor_raises_typeerror(pg_pool: Any) -> None:
+    """A cursor that decodes to a JSON integer (not list) → ValueError caught.
+
+    Correct behaviour: JsonRpcError(-32602), because _decode_cursor catches
+    TypeError and re-raises as ValueError.
+    """
+    # json.dumps(42) = "42", base64url-encoded → "NDI="
+    # Decodes to the integer 42 (not a list), so data[0] would raise TypeError,
+    # which is caught and re-raised as ValueError.
+    bad_cursor = "NDI="
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    ctx = _ctx(pg_pool, s["tenant"], s["client_id"])
+    try:
+        await MemoryListTool()(ctx, MemoryListInput(cursor=bad_cursor, limit=10))
+        # If we get here at all, the bug didn't trigger
+        pytest.fail("Expected TypeError from _decode_cursor, but tool returned successfully")
+    except JsonRpcError as exc:
+        assert exc.code == -32602  # correct behaviour — caught by except ValueError
+    except TypeError:
+        pytest.fail(  # xfail expects -32602, gets TypeError → test fails → xfail passes
+            "BUG(d): TypeError propagated from _decode_cursor instead of -32602"
+        )
+    finally:
+        await _cleanup(pg_pool, s["tenant"], s["team"], s["client_id"])
+
