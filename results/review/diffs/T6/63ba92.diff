+# ──────────────────────────── _render edge cases ─────────────────────────
+
+
+class TestRenderNoneValue:
+    """None payload values render as empty string (same as missing keys)."""
+
+    def test_none_value_renders_empty(self) -> None:
+        """A payload value of None should render as empty string, not 'None'."""
+        out = _render("Due: {date_or_none}", {"date_or_none": None})
+        assert out == "Due: "
+
+    def test_none_value_renders_empty_multiple(self) -> None:
+        """Multiple None values all render as empty."""
+        out = _render("{a}-{b}-{c}", {"a": "x", "b": None, "c": "z"})
+        assert out == "x--z"
+
+
+class TestRenderNonStringValues:
+    def test_integer_value(self) -> None:
+        assert _render("count={n}", {"n": 42}) == "count=42"
+
+    def test_float_value(self) -> None:
+        assert _render("ratio={r}", {"r": 3.14}) == "ratio=3.14"
+
+    def test_boolean_true(self) -> None:
+        assert _render("flag={f}", {"f": True}) == "flag=True"
+
+    def test_boolean_false(self) -> None:
+        assert _render("flag={f}", {"f": False}) == "flag=False"
+
+    def test_non_ascii_value(self) -> None:
+        assert _render("héllo {name}", {"name": "wörld"}) == "héllo wörld"
+
+    def test_unicode_emoji(self) -> None:
+        assert _render("status={s}", {"s": "✅ done"}) == "status=✅ done"
+
+
+class TestRenderPlaceholderVariations:
+    def test_repeated_placeholder_same_value(self) -> None:
+        out = _render("{a}-{a}", {"a": "x"})
+        assert out == "x-x"
+
+    def test_adjacent_placeholders(self) -> None:
+        out = _render("{a}{b}{c}", {"a": "1", "b": "2", "c": "3"})
+        assert out == "123"
+
+    def test_placeholder_at_start(self) -> None:
+        assert _render("{greeting} world", {"greeting": "hi"}) == "hi world"
+
+    def test_placeholder_at_end(self) -> None:
+        assert _render("hello {name}", {"name": "world"}) == "hello world"
+
+    def test_only_placeholder(self) -> None:
+        assert _render("{val}", {"val": "42"}) == "42"
+
+    def test_empty_template(self) -> None:
+        assert _render("", {}) == ""
+
+    def test_template_with_no_placeholders(self) -> None:
+        assert _render("just text", {"unused": "x"}) == "just text"
+
+    def test_curlies_without_key_ignored(self) -> None:
+        assert _render("price: {} dollars", {}) == "price: {} dollars"
+
+    def test_single_brace_ignored(self) -> None:
+        assert _render("100% {done}", {"done": "complete"}) == "100% complete"
+
+    def test_underscore_key(self) -> None:
+        assert _render("id={item_id}", {"item_id": "abc"}) == "id=abc"
+
+    def test_digit_in_key(self) -> None:
+        assert _render("v{version2}", {"version2": "2.0"}) == "v2.0"
+
+    def test_key_starting_with_digit_not_a_placeholder(self) -> None:
+        """{1abc} doesn't match the regex (must start with letter or underscore)."""
+        assert _render("ref {1abc}", {}) == "ref {1abc}"
+
+    def test_hyphen_in_key_not_a_placeholder(self) -> None:
+        assert _render("val {a-b}", {}) == "val {a-b}"
+
+
+class TestRenderMissingKey:
+    def test_missing_key_renders_empty(self) -> None:
+        assert _render("Hello {missing}", {}) == "Hello "
+
+    def test_multiple_missing_keys(self) -> None:
+        assert _render("{a}{b}{c}", {}) == ""
+
+    def test_mixed_present_missing(self) -> None:
+        assert _render("{a}-{b}-{c}", {"a": "1", "c": "3"}) == "1--3"
+
+    def test_missing_key_logs_warning(self, caplog: pytest.LogCaptureFixture) -> None:
+        import logging
+
+        with caplog.at_level(logging.WARNING):
+            _render("Hello {missing}", {"present": "x"})
+        assert any("notice_template_missing_key" in r.message for r in caplog.records)
+        # The `extra` dict keys are set directly as LogRecord attributes.
+        assert any(getattr(r, "key", "") == "missing" for r in caplog.records)
+
