+def _sample_row(**overrides: Any) -> dict[str, Any]:
+    """Canned row matching the SELECT columns in list.py."""
+    base: dict[str, Any] = {
+        "id": uuid4(),
+        "content": "test memory",
+        "preview": "test memory",
+        "type": "note",
+        "tags": ["tag1", "tag2"],
+        "version": 1,
+        "is_current": True,
+        "created_at": datetime(2025, 5, 1, 12, 0, 0, tzinfo=UTC),
+        "updated_at": datetime(2025, 5, 1, 12, 30, 0, tzinfo=UTC),
+        "deleted_at": None,
+        "expires_at": None,
+        "indexable": True,
+        "embedding_status": "ok",
+    }
+    base.update(overrides)
+    return base
+
+
+class TestMemoryListItem:
+    """MemoryListItem(**dict(r)) — maps SELECT columns 1:1."""
+
+    def test_construct_from_row(self) -> None:
+        row = _sample_row()
+        item = MemoryListItem(**row)
+        assert item.id == row["id"]
+        assert item.content == "test memory"
+        assert item.preview == "test memory"
+        assert item.type == "note"
+        assert item.tags == ["tag1", "tag2"]
+        assert item.version == 1
+        assert item.is_current is True
+        assert item.created_at == row["created_at"]
+        assert item.updated_at == row["updated_at"]
+        assert item.deleted_at is None
+        assert item.expires_at is None
+        assert item.indexable is True
+        assert item.embedding_status == "ok"
+
+    def test_deleted_at_can_be_set(self) -> None:
+        row = _sample_row(deleted_at=datetime(2025, 5, 2, tzinfo=UTC))
+        item = MemoryListItem(**row)
+        assert item.deleted_at == row["deleted_at"]
+
+    def test_expires_at_can_be_set(self) -> None:
+        row = _sample_row(expires_at=datetime(2025, 6, 1, tzinfo=UTC))
+        item = MemoryListItem(**row)
+        assert item.expires_at == row["expires_at"]
+
+    def test_content_can_be_long(self) -> None:
+        # Model itself does NOT enforce 2000-char limit; SQL truncates.
+        big = "x" * 3000
+        item = MemoryListItem(**_sample_row(content=big, preview=big[:280]))
+        assert item.content == big
+
+    def test_extra_field_ignored(self) -> None:
+        # MemoryListItem is an output model — no model_config extra='forbid'.
+        # Extra keys from the SQL row are silently dropped (Pydantic v2 default).
+        row = _sample_row()
+        row["extra"] = "surprise"
+        item = MemoryListItem(**row)
