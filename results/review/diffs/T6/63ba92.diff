+"""Unit tests for notice template rendering and RenderedNotice.to_dict().
+
+Pure unit tests — no DB. Complements `test_notice_delivery.py` (which covers
+the happy-path `_render` calls via `deliver_pending`) and focuses on:
+
+  - `RenderedNotice` construction and attribute access
+  - `RenderedNotice.to_dict()` serialization contract
+  - `_render` edge cases with non-string / None payload values
+  - Mutation-killing assertions that guard the BUG(f) and BUG(g) contracts
+
+  (f) `_render` treats a None payload value as empty string (same as missing
+       key), rather than str(None) → "None".
+  (g) `RenderedNotice.to_dict()` returns a defensive copy of `payload`,
+       so caller mutation cannot corrupt the original notice object.
+"""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from typing import Any
+from uuid import uuid4
+
+import pytest
+
+from mem_mcp.plugins.notice_delivery import (
+    RenderedNotice,
+    _render,
+)
+
+# ──────────────────────────── RenderedNotice ────────────────────────────
+
+
+class TestRenderedNoticeConstruction:
+    def test_all_fields_set(self) -> None:
+        nid = uuid4()
+        dt = datetime(2026, 6, 10, 12, 0, 0, tzinfo=UTC)
+        payload = {"count": 3, "unit": "days"}
+        rn = RenderedNotice(
+            id=nid,
+            plugin_id="reminders",
+            kind="reminder_fired",
+            text="Reminder: Take medicine",
+            payload=payload,
+            created_at=dt,
+        )
+        assert rn.id == nid
+        assert rn.plugin_id == "reminders"
+        assert rn.kind == "reminder_fired"
+        assert rn.text == "Reminder: Take medicine"
+        assert rn.payload == payload
+        assert rn.created_at == dt
+
+    def test_slots_prevents_extra_attrs(self) -> None:
+        """__slots__ means no __dict__ and no setting of undeclared attrs."""
+        rn = RenderedNotice(
+            id=uuid4(),
+            plugin_id="p",
+            kind="k",
+            text="t",
+            payload={},
+            created_at=datetime.now(tz=UTC),
+        )
+        with pytest.raises(AttributeError):
+            rn.bogus = "value"  # type: ignore[attr-defined]
+
+
+# ──────────────────────── RenderedNotice.to_dict ────────────────────────
+
+
+class TestRenderedNoticeToDict:
+    def test_all_keys_present(self) -> None:
+        nid = uuid4()
+        dt = datetime(2026, 6, 10, 12, 0, 0, tzinfo=UTC)
+        rn = RenderedNotice(
+            id=nid,
+            plugin_id="reminders",
+            kind="reminder_fired",
+            text="Take medicines",
+            payload={"content": "meds"},
+            created_at=dt,
+        )
+        d = rn.to_dict()
+        assert set(d.keys()) == {"id", "plugin_id", "kind", "text", "payload", "created_at"}
+
+    def test_id_is_string(self) -> None:
+        nid = uuid4()
+        rn = RenderedNotice(
+            id=nid,
+            plugin_id="p",
+            kind="k",
+            text="t",
+            payload={},
+            created_at=datetime.now(tz=UTC),
+        )
+        assert rn.to_dict()["id"] == str(nid)
+
+    def test_created_at_is_isoformat(self) -> None:
+        dt = datetime(2026, 6, 10, 12, 0, 0, 678901, tzinfo=UTC)
+        rn = RenderedNotice(
+            id=uuid4(),
+            plugin_id="p",
+            kind="k",
+            text="t",
+            payload={},
+            created_at=dt,
+        )
+        assert rn.to_dict()["created_at"] == dt.isoformat()
+
+    def test_created_at_naive_datetime(self) -> None:
+        """A naive datetime (no tzinfo) renders ISO without offset."""
+        dt = datetime(2026, 6, 10, 12, 0, 0)
+        rn = RenderedNotice(
+            id=uuid4(),
+            plugin_id="p",
+            kind="k",
+            text="t",
+            payload={},
+            created_at=dt,
+        )
+        assert rn.to_dict()["created_at"] == dt.isoformat()
+        assert "T" in rn.to_dict()["created_at"]
+
+    def test_payload_present_and_equal(self) -> None:
+        payload = {"fire_at": "2026-06-10T11:41:38+00:00", "count": 3}
+        rn = RenderedNotice(
+            id=uuid4(),
+            plugin_id="p",
+            kind="k",
+            text="t",
+            payload=payload,
+            created_at=datetime.now(tz=UTC),
+        )
+        assert rn.to_dict()["payload"] == payload
+
+    def test_to_dict_returns_payload_copy(self) -> None:
+        """Mutating the dict returned by to_dict() must not affect the original."""
+        payload = {"key": "value"}
+        rn = RenderedNotice(
+            id=uuid4(),
+            plugin_id="p",
+            kind="k",
+            text="t",
+            payload=payload,
+            created_at=datetime.now(tz=UTC),
+        )
+        d = rn.to_dict()
+        d["payload"]["key"] = "MUTATED"
+        assert rn.payload == {"key": "value"}, (
+            "to_dict() must return a defensive copy of payload, not a live reference"
+        )
+
+    def test_to_dict_is_idempotent(self) -> None:
+        """Calling to_dict() twice yields equal dicts (no side effects)."""
+        rn = RenderedNotice(
+            id=uuid4(),
+            plugin_id="p",
+            kind="k",
+            text="t",
+            payload={"a": 1},
+            created_at=datetime.now(tz=UTC),
+        )
+        d1 = rn.to_dict()
+        d2 = rn.to_dict()
+        assert d1 == d2
+
+    def test_nested_payload_structure_preserved(self) -> None:
+        """Nested dicts/lists in payload survive the round-trip."""
+        payload: dict[str, Any] = {
+            "user": {"name": "Alice", "id": "u_123"},
+            "tags": ["urgent", "follow-up"],
+            "meta": {"priority": 1, "flags": [True, False]},
+        }
+        rn = RenderedNotice(
+            id=uuid4(),
+            plugin_id="p",
+            kind="k",
+            text="t",
+            payload=payload,
+            created_at=datetime.now(tz=UTC),
+        )
+        assert rn.to_dict()["payload"] == payload
+
