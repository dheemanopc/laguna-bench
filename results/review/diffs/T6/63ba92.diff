+class TestRenderedNoticeIntegrationWithRender:
+    """Verify RenderedNotice carries the rendered text correctly."""
+
+    def test_text_is_rendered_content(self) -> None:
+        rn = RenderedNotice(
+            id=uuid4(),
+            plugin_id="reminders",
+            kind="reminder_fired",
+            text=_render("Reminder: {content}", {"content": "Take medicines"}),
+            payload={"content": "Take medicines"},
+            created_at=datetime.now(tz=UTC),
+        )
+        assert rn.text == "Reminder: Take medicines"
+        assert rn.to_dict()["text"] == "Reminder: Take medicines"
