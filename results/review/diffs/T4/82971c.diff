+"""Branch status tracking for mind-map nodes — resolution, dropout, and settling.
+
+Problem: `mindmap_get` returns every node in full every time, and `open_loops`
+only grows because there's no per-branch settle mechanism. This migration adds
+the status schema to track which branches are open (waiting for action) vs.
+resolved/dropped (settled, no longer on the surface), with an optional summary
+replacing the node content in cheap reads.
+
+The status is the ONLY source of truth for "is this branch settled". An edge
+alone (e.g., a `resolves-under` link via `mindmap_link`) never settles a
+branch; explicit `mindmap_resolve` call is required. This preserves the
+principle that tools never infer state from edges.
+
+Revision ID: 0044_mindmap_branch_status
+Revises: 0043_backfill_personal_teams
+Create Date: 2026-10-15
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0044_mindmap_branch_status"
+down_revision = "0043_backfill_personal_teams"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    # Add status and resolution columns to memory_map_membership.
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+        ADD COLUMN status TEXT NOT NULL DEFAULT 'open'
+            CONSTRAINT mmm_status_check CHECK (status IN ('open','resolved','dropped')),
+        ADD COLUMN resolution_summary TEXT
+            CONSTRAINT mmm_summary_length CHECK (char_length(resolution_summary) <= 500),
+        ADD COLUMN resolved_by_memory_id UUID REFERENCES memories(id) ON DELETE SET NULL,
+        ADD COLUMN resolved_by_party TEXT
+            CONSTRAINT mmm_party_check CHECK (resolved_by_party IS NULL OR resolved_by_party IN ('owner','model')),
+        ADD COLUMN resolved_at TIMESTAMPTZ,
+        ADD CONSTRAINT mmm_open_consistency_check CHECK (
+            CASE
+                WHEN status = 'open' THEN
+                    resolution_summary IS NULL AND resolved_by_party IS NULL AND resolved_at IS NULL AND resolved_by_memory_id IS NULL
+                WHEN status IN ('resolved', 'dropped') THEN
+                    resolution_summary IS NOT NULL AND resolved_by_party IS NOT NULL AND resolved_at IS NOT NULL
+                ELSE FALSE
+            END
+        )
+    """)
+    )
+
+
+def downgrade() -> None:
+    # Drop all the status-related constraints and columns.
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+        DROP CONSTRAINT IF EXISTS mmm_open_consistency_check,
+        DROP CONSTRAINT IF EXISTS mmm_party_check,
+        DROP CONSTRAINT IF EXISTS mmm_summary_length,
+        DROP CONSTRAINT IF EXISTS mmm_status_check,
+        DROP COLUMN IF EXISTS resolved_at,
+        DROP COLUMN IF EXISTS resolved_by_party,
+        DROP COLUMN IF EXISTS resolved_by_memory_id,
+        DROP COLUMN IF EXISTS resolution_summary,
+        DROP COLUMN IF EXISTS status
+    """)
+    )
