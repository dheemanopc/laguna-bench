index 0000000..aea0e4b
--- /dev/null
+++ b/src/mem_mcp/mcp/tools/mindmap_resolve.py
@@ -0,0 +1,204 @@
+"""mindmap_resolve — settle a branch (resolve or drop without closing the map).
+
+Marks a single branch as resolved or dropped, optionally recording an edge to
+the resolving node. The summary is what cheap reads show instead of the branch
+content. Does not close the map (that's mindmap_close). A resolves-under or
+dropped-under edge is created when a resolver is named.
+"""
+
+from __future__ import annotations
+
+from typing import ClassVar, Literal
+from uuid import UUID
+
+from pydantic import BaseModel, ConfigDict, Field
+
+from mem_mcp.db import system_tx, tenant_tx
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tool_descriptions import TOOL_DESCRIPTIONS
+from mem_mcp.mcp.tools._base import BaseTool, ToolContext
+from mem_mcp.mcp.tools._mindmap_common import resolve_team_id
+from mem_mcp.mindmap import DROPPED_UNDER_KIND, RESOLVES_UNDER_KIND, service
+from mem_mcp.teams.references import (
+    ReferenceTargetNotFoundError,
+    insert_reference,
+    resolve_reference_target,
+)
+
+
+class MindmapResolveInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    map_key: str = Field(..., min_length=1, max_length=64)
+    node_id: UUID
+    disposition: Literal["resolved", "dropped"] = "resolved"
+    resolution_summary: str = Field(..., min_length=1, max_length=500)
+    resolved_by_memory_id: UUID | None = None
+    resolved_by_party: Literal["owner", "model"] = "model"
+    team_id: UUID | None = None
+
+
+class MindmapResolveOutput(BaseModel):
+    node_id: UUID
+    status: str
+    resolution_summary: str
+    cursor: int
+    request_id: str
+
+
+class MindmapResolveTool(BaseTool):
+    name: ClassVar[str] = "mindmap_resolve"
+    description: ClassVar[str] = TOOL_DESCRIPTIONS["mindmap_resolve"]
+    required_scope: ClassVar[str] = "memory.write"
+    InputModel: ClassVar[type[BaseModel]] = MindmapResolveInput
+    OutputModel: ClassVar[type[BaseModel]] = MindmapResolveOutput
+
+    async def __call__(self, ctx: ToolContext, inp: BaseModel) -> BaseModel:
+        assert isinstance(inp, MindmapResolveInput)
+
+        # Validate resolved_by_memory_id if provided.
+        if inp.resolved_by_memory_id is not None and inp.resolved_by_memory_id == inp.node_id:
+            raise JsonRpcError(
+                -32602,
+                "resolved_by_memory_id cannot equal node_id",
+                data={"errors": [{"path": "resolved_by_memory_id"}]},
+            )
+
+        # Tenant-side checks first: map, membership (node_id errors must come here).
+        async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+            team_id = await resolve_team_id(conn, ctx, inp.team_id)
+            root_id = await service.resolve_map_root(conn, team_id=team_id, map_key=inp.map_key)
+            if root_id is None:
+                raise JsonRpcError(-32602, "map not found", data={"errors": [{"path": "map_key"}]})
+
+            map_row = await service.get_map_row(conn, root_memory_id=root_id)
+            if map_row is None or map_row["state"] != "live":
+                raise JsonRpcError(
+                    -32602,
+                    "map is archived; no changes allowed",
+                    data={"code": "map_not_live"},
+                )
+
+            membership = await service.fetch_membership(
+                conn,
+                memory_id=inp.node_id,
+                root_memory_id=root_id,
+                tenant_id=ctx.tenant_id,
+            )
+            if membership is None or membership["node_role"] == "root":
+                raise JsonRpcError(
+                    -32602,
+                    "node not found in this map or is the root node",
+                    data={"errors": [{"path": "node_id"}]},
+                )
+
+            if membership["status"] != "open":
+                raise JsonRpcError(
+                    -32602,
+                    "branch is already settled",
+                    data={"code": "branch_already_settled"},
+                )
+
+        # System-side checks: access control for resolver (source) and target node (if resolver named).
+        node_team_id = team_id
+        if inp.resolved_by_memory_id is not None:
+            async with system_tx(ctx.db_pool) as sys_conn:
+                # Resolve the target node (settled branch) to get its team.
+                try:
+                    node_resolved = await resolve_reference_target(
+                        sys_conn,
+                        target_uuid=inp.node_id,
+                        caller_user_id=ctx.tenant_id,
+                    )
+                    node_team_id = node_resolved["team_id"]
+                except ReferenceTargetNotFoundError as exc:
+                    raise JsonRpcError(
+                        -32602,
+                        "node not found or not accessible",
+                        data={"code": "memory_not_accessible"},
+                    ) from exc
+
+                # Validate resolver (source of edge) is accessible.
+                try:
+                    await resolve_reference_target(
+                        sys_conn,
+                        target_uuid=inp.resolved_by_memory_id,
+                        caller_user_id=ctx.tenant_id,
+                    )
+                except ReferenceTargetNotFoundError as exc:
+                    raise JsonRpcError(
+                        -32602,
+                        "resolved_by_memory_id not found or not accessible",
+                        data={"code": "memory_not_accessible"},
+                    ) from exc
+
+        # Settle + edge + event in one transaction (atomically re-assert preconditions).
+        async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+            # Re-assert map is live (with FOR UPDATE lock for atomicity).
+            map_state = await service.lock_map_state(
+                conn, root_memory_id=root_id, tenant_id=ctx.tenant_id
+            )
+            if map_state != "live":
+                raise JsonRpcError(
+                    -32602,
+                    "map is archived; no changes allowed",
+                    data={"code": "map_not_live"},
+                )
+
+            settled = await service.settle_branch(
+                conn,
+                memory_id=inp.node_id,
+                root_memory_id=root_id,
+                tenant_id=ctx.tenant_id,
+                status=inp.disposition,
+                resolution_summary=inp.resolution_summary,
+                resolved_by_memory_id=inp.resolved_by_memory_id,
+                resolved_by_party=inp.resolved_by_party,
+            )
+            if settled is None:
+                raise JsonRpcError(
+                    -32602,
+                    "branch is already settled",
+                    data={"code": "branch_already_settled"},
+                )
+
+            if inp.resolved_by_memory_id is not None:
+                reference_kind = (
+                    RESOLVES_UNDER_KIND if inp.disposition == "resolved" else DROPPED_UNDER_KIND
+                )
+                await insert_reference(
+                    conn,
+                    source_memory_id=inp.resolved_by_memory_id,
+                    target_memory_id=inp.node_id,
+                    target_team_id=node_team_id,
+                    reference_kind=reference_kind,
+                )
+
+            event_type = "resolve" if inp.disposition == "resolved" else "drop"
+            cursor = await service.log_event(
+                conn,
+                root_memory_id=root_id,
+                tenant_id=ctx.tenant_id,
+                event=event_type,
+                actor=inp.resolved_by_party,
+                memory_id=inp.node_id,
+                payload={
+                    "disposition": inp.disposition,
+                    "resolved_by_memory_id": str(inp.resolved_by_memory_id)
+                    if inp.resolved_by_memory_id
+                    else None,
+                    "reference_kind": (
+                        RESOLVES_UNDER_KIND if inp.disposition == "resolved" else DROPPED_UNDER_KIND
+                    )
+                    if inp.resolved_by_memory_id
+                    else None,
+                },
+            )
+
+        return MindmapResolveOutput(
+            node_id=inp.node_id,
+            status=inp.disposition,
+            resolution_summary=inp.resolution_summary,
+            cursor=cursor,
+            request_id=ctx.request_id,
+        )
