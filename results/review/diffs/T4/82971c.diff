+"""Unit tests for mindmap_resolve input validation and content truncation.
+
+DB-free tests covering:
+- Input validation (summary required, 1..500, disposition/party literals, defaults, extra=forbid)
+- MindmapGetInput defaults (since=None, include="open", depth="summary", since ≥ 0)
+- Content truncation helper (199/200/201 chars, exactly-200 not truncated, 201 → 200 chars + "…")
+"""
+
+from __future__ import annotations
+
+import pytest
+from pydantic import ValidationError
+
+from mem_mcp.mcp.tools.mindmap_get import _truncate_content
+from mem_mcp.mcp.tools.mindmap_resolve import MindmapResolveInput
+
+
+class TestTruncationHelper:
+    """Content truncation for summary depth."""
+
+    def test_truncate_full_depth_no_truncation(self) -> None:
+        content = "x" * 250
+        result, truncated = _truncate_content(content, "full")
+        assert result == content
+        assert truncated is False
+
+    def test_truncate_summary_depth_exactly_200_no_truncation(self) -> None:
+        content = "x" * 200
+        result, truncated = _truncate_content(content, "summary")
+        assert result == content
+        assert truncated is False
+
+    def test_truncate_summary_depth_199_no_truncation(self) -> None:
+        content = "x" * 199
