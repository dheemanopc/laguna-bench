index 0000000..f2452a1
--- /dev/null
+++ b/tests/integration/test_mindmap_resolve_e2e.py
@@ -0,0 +1,970 @@
+"""End-to-end integration tests for mindmap_resolve tool.
+
+Covers:
+- resolve with a resolving node → status `resolved` in DB, summary/party/resolved_at stored,
+  edge (source=resolver, target=node, kind='resolves-under') exists, event logged, cursor updated
+- dropped without resolver → status `dropped`, no edge, event `drop`
+- dropped with resolver → `dropped-under` edge
+- unknown map; node of a different map; random uuid; root node → -32602, DB unchanged
+- already-settled → -32602 `branch_already_settled`
+- archived map → -32602 `map_not_live`
+- resolves-under edge alone does NOT settle a node
+- open_loops: owner- and model-responsible open nodes listed; no responsible_party not listed;
+  root not listed; after resolve, node gone from open_loops
+- mindmap_get: settled node absent from nodes, in resolved with summary/status/party;
+  include="all" returns it in nodes with status
+- since: cursor increments on resolve; get(since=c) shows resolved in resolved list
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import UUID, uuid4
+
+import asyncpg  # type: ignore[import-untyped]
+import pytest
+
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tools._base import ToolContext
+from mem_mcp.mcp.tools.mindmap_get import MindmapGetInput, MindmapGetTool
+from mem_mcp.mcp.tools.mindmap_link import MindmapLinkInput, MindmapLinkTool
+from mem_mcp.mcp.tools.mindmap_open import MindmapOpenInput, MindmapOpenTool
+from mem_mcp.mcp.tools.mindmap_resolve import MindmapResolveInput, MindmapResolveTool
+from mem_mcp.mcp.tools.mindmap_write_node import (
+    MindmapWriteNodeInput,
+    MindmapWriteNodeTool,
+)
+from mem_mcp.mindmap import DROPPED_UNDER_KIND, RESOLVES_UNDER_KIND, service
+from mem_mcp.teams.assignments import assign_role
+
+pytestmark = pytest.mark.asyncio
+
+
+def _build_deps() -> Any:
+    from mem_mcp.audit.logger import NoopAuditLogger
+    from mem_mcp.mcp.tools._deps import NoopQuotas, ToolDeps
+
+    class _StubEmbed:
+        async def embed(self, content: str) -> Any:
+            from mem_mcp.embeddings.bedrock import EmbedResult
+
+            return EmbedResult(vector=[0.0] * 1024, input_tokens=max(1, len(content) // 4))
+
+    return ToolDeps(embeddings=_StubEmbed(), audit=NoopAuditLogger(), quotas=NoopQuotas())
+
+
+async def _setup(conn: asyncpg.Connection) -> dict[str, Any]:
+    tenant = await conn.fetchval(
+        "INSERT INTO tenants (email) VALUES ($1) RETURNING id",
+        f"mindmap-resolve-{uuid4()}@example.test",
+    )
+    team = await conn.fetchval(
+        "INSERT INTO teams (name, created_by_tenant_id) VALUES ($1, $2) RETURNING id",
+        f"team-{uuid4().hex[:8]}",
+        tenant,
+    )
+    await assign_role(
+        conn,
+        parent_team_id=team,
+        member_kind="user",
+        member_id=tenant,
+        role_key="member",
+        assigned_by_user_id=tenant,
+    )
+    await conn.execute(
+        """
+        INSERT INTO tenant_identities
+            (tenant_id, cognito_sub, provider, email, is_primary, default_team_id)
+        VALUES ($1, $2, 'cognito', $3, true, $4)
+        """,
+        tenant,
+        f"sub-{tenant}",
+        f"resolve-{tenant}@example.test",
+        team,
+    )
+    client_id = f"client:resolve-{uuid4().hex[:8]}"
+    await conn.execute(
+        """
+        INSERT INTO oauth_clients (id, redirect_uris, scope, registration_payload, review_status)
+        VALUES ($1, ARRAY[]::text[], 'memory.read memory.write', '{}'::jsonb, 'auto_allowed')
+        """,
+        client_id,
+    )
+    return {"tenant": tenant, "team": team, "client_id": client_id}
+
+
+async def _cleanup(pool: Any, tenant: UUID, team: UUID, client_id: str) -> None:
+    async with pool.acquire() as conn:
+        async with conn.transaction():
+            await conn.execute(
+                "DELETE FROM memory_references WHERE source_memory_id IN "
+                "(SELECT id FROM memories WHERE tenant_id = $1) "
+                "OR target_memory_id IN (SELECT id FROM memories WHERE tenant_id = $1)",
+                tenant,
+            )
+            await conn.execute("DELETE FROM memory_map_events WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM memory_map_membership WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM memory_maps WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM slugs WHERE team_id = $1", team)
+            await conn.execute("DELETE FROM memories WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM team_role_assignments WHERE parent_team_id = $1", team)
+            await conn.execute("DELETE FROM tenant_identities WHERE tenant_id = $1", tenant)
+            await conn.execute("DELETE FROM teams WHERE id = $1", team)
+            await conn.execute("DELETE FROM tenants WHERE id = $1", tenant)
+            await conn.execute("DELETE FROM oauth_clients WHERE id = $1", client_id)
+
+
+def _ctx(pool: Any, tenant: UUID, client_id: str) -> ToolContext:
+    return ToolContext(
+        request_id=f"req-{uuid4().hex[:8]}",
+        tenant_id=tenant,
+        identity_id=tenant,
+        client_id=client_id,
+        scopes=frozenset({"memory.read", "memory.write"}),
+        db_pool=pool,
+        deps=_build_deps(),
+    )
+
+
+async def test_resolve_with_resolver_node(pg_pool: Any) -> None:
+    """Resolve a branch with a resolving node → edge, event, status updated."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(pg_pool, tenant, client_id)
+
+    try:
+        # Open map and write nodes.
+        opened = await MindmapOpenTool()(
+            ctx, MindmapOpenInput(title="Test", root_question="Test?")
+        )
+        map_key = opened.map_key
+
+        n1 = await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(
+                map_key=map_key,
+                content="Test position",
+                node_role="position",
+            ),
+        )
+        node_id = n1.node_id
+
+        n2 = await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(
+                map_key=map_key,
+                content="Test challenge",
+                node_role="challenge",
+            ),
+        )
+        resolver_id = n2.node_id
+
+        # Resolve n1 with n2 as resolver.
+        resolved = await MindmapResolveTool()(
+            ctx,
+            MindmapResolveInput(
+                map_key=map_key,
+                node_id=node_id,
+                disposition="resolved",
+                resolution_summary="Resolved by challenge",
+                resolved_by_memory_id=resolver_id,
+                resolved_by_party="model",
+            ),
+        )
+
+        assert resolved.node_id == node_id
+        assert resolved.status == "resolved"
+        assert resolved.resolution_summary == "Resolved by challenge"
+        assert resolved.cursor > 0
+
+        # Verify DB state: membership updated, edge created, event logged.
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                root_id = opened.root_memory_id
+
+                # Check membership.
+                membership = await conn.fetchrow(
+                    "SELECT status, resolution_summary, resolved_by_memory_id, "
+                    "resolved_by_party, resolved_at FROM memory_map_membership "
+                    "WHERE memory_id = $1 AND root_memory_id = $2",
+                    node_id,
+                    root_id,
+                )
+                assert membership["status"] == "resolved"
+                assert membership["resolution_summary"] == "Resolved by challenge"
+                assert membership["resolved_by_memory_id"] == resolver_id
+                assert membership["resolved_by_party"] == "model"
+                assert membership["resolved_at"] is not None
+
+                # Check edge.
+                edge = await conn.fetchrow(
+                    "SELECT reference_kind FROM memory_references "
+                    "WHERE source_memory_id = $1 AND target_memory_id = $2",
+                    resolver_id,
+                    node_id,
+                )
+                assert edge is not None
+                assert edge["reference_kind"] == RESOLVES_UNDER_KIND
+
+                # Check event.
+                event = await conn.fetchrow(
+                    "SELECT event, actor FROM memory_map_events "
+                    "WHERE root_memory_id = $1 AND memory_id = $2 AND event = 'resolve'",
+                    root_id,
+                    node_id,
+                )
+                assert event is not None
+                assert event["actor"] == "model"
+    finally:
+        await _cleanup(pg_pool, tenant, team, client_id)
+
+
+async def test_drop_without_resolver(pg_pool: Any) -> None:
+    """Drop a branch without resolver → no edge, status dropped, event logged."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(pg_pool, tenant, client_id)
+
+    try:
+        opened = await MindmapOpenTool()(
+            ctx, MindmapOpenInput(title="Test", root_question="Test?")
+        )
+        map_key = opened.map_key
+
+        n1 = await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(
+                map_key=map_key, content="To be dropped", node_role="position"
+            ),
+        )
+        node_id = n1.node_id
+
+        dropped = await MindmapResolveTool()(
+            ctx,
+            MindmapResolveInput(
+                map_key=map_key,
+                node_id=node_id,
+                disposition="dropped",
+                resolution_summary="Not viable",
+                resolved_by_memory_id=None,
+            ),
+        )
+
+        assert dropped.status == "dropped"
+
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                root_id = opened.root_memory_id
+
+                membership = await conn.fetchrow(
+                    "SELECT status FROM memory_map_membership "
+                    "WHERE memory_id = $1 AND root_memory_id = $2",
+                    node_id,
+                    root_id,
+                )
+                assert membership["status"] == "dropped"
+
+                # No edge should exist (no resolver).
+                edge = await conn.fetchval(
+                    "SELECT COUNT(*) FROM memory_references "
+                    "WHERE target_memory_id = $1",
+                    node_id,
+                )
+                assert edge == 0
+    finally:
+        await _cleanup(pg_pool, tenant, team, client_id)
+
+
+async def test_dropped_with_resolver(pg_pool: Any) -> None:
+    """Drop with resolver → dropped-under edge created."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(pg_pool, tenant, client_id)
+
+    try:
+        opened = await MindmapOpenTool()(
+            ctx, MindmapOpenInput(title="Test", root_question="Test?")
+        )
+        map_key = opened.map_key
+
+        n1 = await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(map_key=map_key, content="To drop", node_role="position"),
+        )
+        node_id = n1.node_id
+
+        n2 = await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(map_key=map_key, content="Reason", node_role="challenge"),
+        )
+        resolver_id = n2.node_id
+
+        await MindmapResolveTool()(
+            ctx,
+            MindmapResolveInput(
+                map_key=map_key,
+                node_id=node_id,
+                disposition="dropped",
+                resolution_summary="Dropped per challenge",
+                resolved_by_memory_id=resolver_id,
+                resolved_by_party="owner",
+            ),
+        )
+
+        async with pg_pool.acquire() as conn:
+            async with conn.transaction():
+                edge = await conn.fetchrow(
+                    "SELECT reference_kind FROM memory_references "
+                    "WHERE source_memory_id = $1 AND target_memory_id = $2",
+                    resolver_id,
+                    node_id,
+                )
+                assert edge["reference_kind"] == DROPPED_UNDER_KIND
+    finally:
+        await _cleanup(pg_pool, tenant, team, client_id)
+
+
+async def test_unknown_map_error(pg_pool: Any) -> None:
+    """Unknown map → -32602 error."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
