+async def test_mindmap_get_cheap_reads(pg_pool: Any) -> None:
+    """since cursor, include filter, depth summary, resolved list, cursor."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    tenant, team, client_id = s["tenant"], s["team"], s["client_id"]
+    ctx = _ctx(pg_pool, tenant, client_id)
+
+    try:
+        opened = await MindmapOpenTool()(
+            ctx,
+            MindmapOpenInput(
+                title="Caching strategy",
+                root_question="What caching approach fits?",
+                review_threshold=15,
+            ),
+        )
+        map_key = opened.map_key
+        pos = await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(
+                map_key=map_key,
+                content="Use Redis for the hot read path",
+                node_role="position",
+                responsible_party="owner",
+            ),
+        )
+        chal = await MindmapWriteNodeTool()(
+            ctx,
+            MindmapWriteNodeInput(
+                map_key=map_key,
+                content="Redis adds an ops burden",
+                node_role="challenge",
+            ),
+        )
+
+        # Full read — all nodes, cursor is the high-water mark.
+        full = await MindmapGetTool()(ctx, MindmapGetInput(map_key=map_key))
+        assert len(full.nodes) == 3  # root + pos + chal
+        assert full.cursor > 0
+        cursor_before = full.cursor
+
+        # Cheap read with same cursor → nothing touched since.
+        empty = await MindmapGetTool()(
+            ctx, MindmapGetInput(map_key=map_key, since=cursor_before)
+        )
+        assert len(empty.nodes) == 0
+        assert empty.cursor == cursor_before
+
+        # Resolve chal; cheap read since cursor_before → only chal (touched).
+        await MindmapResolveTool()(
+            ctx,
+            MindmapResolveInput(
+                map_key=map_key,
+                node_id=chal.node_id,
+                disposition="resolved",
+                resolution_summary="Redis wins",
+                resolved_by_memory_id=pos.node_id,
+            ),
+        )
+        cheap = await MindmapGetTool()(
+            ctx, MindmapGetInput(map_key=map_key, since=cursor_before)
+        )
+        assert len(cheap.nodes) == 1
+        assert cheap.nodes[0].memory_id == chal.node_id
+        assert cheap.nodes[0].status == "resolved"
+        assert chal.node_id in cheap.resolved
+        assert chal.node_id not in cheap.open_loops  # settled → excluded
+        assert cheap.cursor > cursor_before
+
+        # include='open' excludes settled branches from the node set.
+        only_open = await MindmapGetTool()(
+            ctx, MindmapGetInput(map_key=map_key, include="open")
+        )
+        assert all(n.status == "open" for n in only_open.nodes)
+        assert chal.node_id not in [n.memory_id for n in only_open.nodes]
+        assert only_open.resolved == []  # filtered out before resolved computed
+
+        # depth='summary' omits content, sets truncated flag.
+        summary = await MindmapGetTool()(
+            ctx, MindmapGetInput(map_key=map_key, depth="summary")
+        )
+        assert all(n.truncated for n in summary.nodes)
+        assert all(n.content == "" for n in summary.nodes)
+        # status still present in summary mode
+        assert any(n.status == "resolved" for n in summary.nodes)
+
+        # depth='full' (default) includes content.
+        assert all(not n.truncated for n in full.nodes)
+    finally:
+        await _cleanup(pg_pool, tenant, team, client_id)
