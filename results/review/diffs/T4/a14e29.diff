+"""Unit tests for mindmap_resolve & mindmap_get input/output schemas.
+
+No DB needed — pure Pydantic validation.  These lock down field constraints,
+the extra-fields-forbid boundary, and the disposition→edge-kind vocabulary
+mapping exposed by the resolve tool.
+"""
+
+from __future__ import annotations
+
+from uuid import uuid4
+
+import pytest
+from pydantic import ValidationError
+
+from mem_mcp.mcp.tools.mindmap_get import MindmapGetInput, MindmapNode
+from mem_mcp.mcp.tools.mindmap_resolve import (
+    MindmapResolveInput,
+    MindmapResolveOutput,
+)
+
