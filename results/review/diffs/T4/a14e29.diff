+class TestResolveInput:
+    def test_defaults(self) -> None:
+        inp = MindmapResolveInput(
+            map_key="m",
+            node_id=uuid4(),
+            resolution_summary="done",
+        )
+        assert inp.disposition == "resolved"
+        assert inp.resolved_by_party == "model"
+        assert inp.resolved_by_memory_id is None
+        assert inp.team_id is None
+
+    def test_extra_fields_forbidden(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(
+                map_key="m",
+                node_id=uuid4(),
+                resolution_summary="done",
+                unexpected="x",
+            )
+
+    def test_map_key_min_length(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(map_key="", node_id=uuid4(), resolution_summary="x")
+
+    def test_map_key_max_length(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(
+                map_key="x" * 65, node_id=uuid4(), resolution_summary="x"
+            )
+
+    def test_resolution_summary_required(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(map_key="m", node_id=uuid4(), resolution_summary="")
+
+    def test_resolution_summary_max_length(self) -> None:
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(
+                map_key="m", node_id=uuid4(), resolution_summary="x" * 501
+            )
+
+    def test_disposition_must_be_literal(self) -> None:
+        with pytest.raises(ValidationError):
