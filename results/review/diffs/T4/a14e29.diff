+"""mindmap branch status — settle one branch without closing the map.
+
+Per mind-map build design (docs/mindmap-v1-build-design.md) + T4 packet:
+
+- Adds a stored status to `memory_map_membership` so individual branches
+  (member nodes) can be resolved or dropped without closing the whole map.
+  Status is the source of truth for "is this branch settled" — it must NOT
+  be inferred from memory_references.reference_kind (open text, unvalidated).
+- Settlement details: resolution_summary (one line), resolved_by_memory_id
+  (the resolving node, if any), resolved_by_party (owner|model), resolved_at.
+- No change to nodes/edges tables — edges continue to live in
+  memory_references with open-text reference_kind (design doc: zero schema
+  change for the edge vocabulary).
+
+Purely additive (new nullable columns + one non-null defaulted column);
+no rows are rewritten, existing default 'open' is backward compatible.
+
+Revision ID: 0044_mindmap_branch_status
+Revises: 0043_backfill_personal_teams
+Create Date: 2026-10-15
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0044_mindmap_branch_status"
+down_revision = "0043_backfill_personal_teams"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+            ADD COLUMN status              TEXT NOT NULL DEFAULT 'open'
+                CHECK (status IN ('open','resolved','dropped')),
+            ADD COLUMN resolution_summary  TEXT,
+            ADD COLUMN resolved_by_memory_id UUID
+                REFERENCES memories(id) ON DELETE SET NULL,
+            ADD COLUMN resolved_by_party   TEXT
+                CHECK (resolved_by_party IN ('owner','model')),
+            ADD COLUMN resolved_at         TIMESTAMPTZ
+        """)
+    )
+
+    # Index for the cheap-read cursor path: events touching a member.
+    op.execute(
+        sa.text(
+            "CREATE INDEX IF NOT EXISTS memory_map_events_root_id_idx "
+            "ON memory_map_events(root_memory_id, id)"
+        )
+    )
+
+
+def downgrade() -> None:
+    op.execute(
+        sa.text("DROP INDEX IF EXISTS memory_map_events_root_id_idx")
+    )
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+            DROP COLUMN IF EXISTS resolved_at,
+            DROP COLUMN IF EXISTS resolved_by_party,
+            DROP COLUMN IF EXISTS resolved_by_memory_id,
+            DROP COLUMN IF EXISTS resolution_summary,
+            DROP COLUMN IF EXISTS status
+        """)
+    )
