+async def fetch_member(
+    conn: asyncpg.Connection,
+    *,
+    memory_id: UUID,
+    root_memory_id: UUID,
+    tenant_id: UUID,
+) -> dict[str, Any] | None:
+    """Fetch a single member row (with its status + memory team_id) or None.
+
+    Used by mindmap_resolve to confirm a node belongs to THIS map before
+    settling it — a caller must not settle a node of a different map by id.
+    """
+    row = await conn.fetchrow(
+        """
+        SELECT mm.memory_id, mm.node_role, mm.status, mm.resolution_summary,
+               mm.resolved_by_memory_id, mm.resolved_by_party, mm.resolved_at,
+               m.team_id, m.tenant_id
+        FROM memory_map_membership mm
+        JOIN memories m ON m.id = mm.memory_id
+        WHERE mm.memory_id = $1 AND mm.root_memory_id = $2
+          AND m.tenant_id = $3 AND m.deleted_at IS NULL
+        """,
+        memory_id,
+        root_memory_id,
+        tenant_id,
+    )
+    return dict(row) if row else None
+
+
+async def set_node_status(
+    conn: asyncpg.Connection,
+    *,
+    memory_id: UUID,
+    root_memory_id: UUID,
+    tenant_id: UUID,
+    status: str,
+    resolution_summary: str,
+    resolved_by_memory_id: UUID | None = None,
+    resolved_by_party: str | None = None,
+) -> None:
+    """Settle one branch: write its stored status + settlement details.
+
+    Status is the source of truth for "is this branch settled" — it is NOT
+    inferred from memory_references.reference_kind. Idempotent: resolving an
+    already-resolved node overwrites the settlement details.
+    """
+    await conn.execute(
+        """
+        UPDATE memory_map_membership
+           SET status = $4,
+               resolution_summary = $5,
+               resolved_by_memory_id = $6,
+               resolved_by_party = $7,
+               resolved_at = now()
+         WHERE memory_id = $1 AND root_memory_id = $2 AND tenant_id = $3
+        """,
+        memory_id,
+        root_memory_id,
+        tenant_id,
+        status,
+        resolution_summary,
+        resolved_by_memory_id,
+        resolved_by_party,
+    )
+
+
+async def get_cursor(conn: asyncpg.Connection, *, root_memory_id: UUID) -> int:
+    """Return the current high-water mark (max id) of the map's event log.
+
+    This is the opaque cursor every mindmap_get returns; a caller passes it
+    back as ``since`` on the next read to get only what changed.
+    """
+    val = await conn.fetchval(
+        "SELECT MAX(id) FROM memory_map_events WHERE root_memory_id = $1",
+        root_memory_id,
+    )
+    return int(val) if val is not None else 0
+
+
+async def fetch_member_ids_touched_since(
+    conn: asyncpg.Connection, *, root_memory_id: UUID, tenant_id: UUID, since: int
+) -> list[UUID]:
+    """Member node ids touched by any map event strictly after ``since``.
+
+    A node is "touched" when its ``memory_id`` appears in
+    ``memory_map_events`` (capture, ratify, resolve, link, split_flag, …).
+    Events with a NULL memory_id (review_flag, review, close) touch no node.
+    Only members of THIS map are returned — cross-map KB ids in promote events
+    are filtered out by the join.
+    """
+    rows = await conn.fetch(
+        """
+        SELECT DISTINCT mm.memory_id
+        FROM memory_map_membership mm
+        JOIN memory_map_events ev ON ev.memory_id = mm.memory_id
+        WHERE mm.root_memory_id = $1 AND mm.tenant_id = $2 AND ev.id > $3
+        """,
+        root_memory_id,
+        tenant_id,
+        since,
+    )
+    return [r["memory_id"] for r in rows]
+
+
 async def fetch_internal_edges(
     conn: asyncpg.Connection, *, member_ids: list[UUID]
 ) -> list[dict[str, Any]]:
