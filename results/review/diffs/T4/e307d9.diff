+"""DB-free tests for mindmap_resolve input validation and mindmap_get read levers."""
+
+from __future__ import annotations
+
+from uuid import uuid4
+
+import pytest
+from pydantic import ValidationError
+
+from mem_mcp.mcp.tools.mindmap_get import MindmapGetInput, summarize_content
+from mem_mcp.mcp.tools.mindmap_resolve import MindmapResolveInput
+from mem_mcp.mindmap import SUMMARY_CHARS
+
+
+def _resolve(**kw: object) -> MindmapResolveInput:
+    base: dict[str, object] = {
+        "map_key": "m",
+        "node_id": uuid4(),
+        "resolution_summary": "done",
+    }
+    base.update(kw)
+    return MindmapResolveInput(**base)  # type: ignore[arg-type]
+
+
+def test_resolve_defaults() -> None:
+    inp = _resolve()
+    assert inp.disposition == "resolved"
+    assert inp.resolved_by_party == "model"
+    assert inp.resolved_by_memory_id is None
+    assert inp.team_id is None
+
+
+def test_resolve_summary_required() -> None:
+    with pytest.raises(ValidationError):
+        MindmapResolveInput(map_key="m", node_id=uuid4())  # type: ignore[call-arg]
+
+
<email>("summary", ["", "x" * 501])
+def test_resolve_summary_bounds_rejected(summary: str) -> None:
+    with pytest.raises(ValidationError):
+        _resolve(resolution_summary=summary)
+
+
<email>("summary", ["x", "x" * 500])
+def test_resolve_summary_bounds_accepted(summary: str) -> None:
+    assert _resolve(resolution_summary=summary).resolution_summary == summary
+
+
+def test_resolve_literals_enforced() -> None:
+    with pytest.raises(ValidationError):
+        _resolve(disposition="open")
+    with pytest.raises(ValidationError):
+        _resolve(resolved_by_party="reviewer")
+    assert _resolve(disposition="dropped", resolved_by_party="owner").disposition == "dropped"
+
+
+def test_resolve_extra_fields_rejected() -> None:
+    with pytest.raises(ValidationError):
+        _resolve(bogus=1)
+
+
+def test_resolve_map_key_length() -> None:
+    with pytest.raises(ValidationError):
+        _resolve(map_key="")
+    with pytest.raises(ValidationError):
+        _resolve(map_key="k" * 65)
+
+
+def test_get_input_defaults_are_cheap() -> None:
+    inp = MindmapGetInput(map_key="m")
+    assert inp.since is None
+    assert inp.include == "open"
+    assert inp.depth == "summary"
+
+
+def test_get_input_since_validation() -> None:
+    with pytest.raises(ValidationError):
+        MindmapGetInput(map_key="m", since=-1)
+    assert MindmapGetInput(map_key="m", since=0).since == 0
+    with pytest.raises(ValidationError):
+        MindmapGetInput(map_key="m", include="everything")  # type: ignore[arg-type]
+    with pytest.raises(ValidationError):
+        MindmapGetInput(map_key="m", depth="deep")  # type: ignore[arg-type]
+
+
+def test_summary_limit_constant() -> None:
+    assert SUMMARY_CHARS == 200
+
+
+def test_truncation_exactly_limit_unchanged() -> None:
+    text = "a" * 200
+    assert summarize_content(text, "summary") == (text, False)
+
+
+def test_truncation_over_limit_cut_with_ellipsis() -> None:
+    out, truncated = summarize_content("a" * 201, "summary")
+    assert truncated is True
+    assert out == "a" * 200 + "…"
+    assert len(out) == 201
+
+
+def test_full_depth_never_truncates() -> None:
+    text = "b" * 5000
+    assert summarize_content(text, "full") == (text, False)
