+async def test_check_constraints_reject_invalid_rows(env: _Env, pg_pool: Any) -> None:
+    n = await env.node()
+    bad_updates = [
+        "SET status = 'bogus'",
+        "SET resolution_summary = 'x'",  # open with a summary
+        "SET status = 'resolved'",  # settled without summary/party/time
+        "SET status = 'resolved', resolution_summary = 'x', resolved_by_party = 'owner'",
+        "SET status = 'resolved', resolution_summary = '', "
+        "resolved_by_party = 'owner', resolved_at = now()",
+        "SET status = 'resolved', resolution_summary = 'x', "
+        "resolved_by_party = 'nobody', resolved_at = now()",
+        f"SET status = 'resolved', resolution_summary = '{'x' * 501}', "
+        "resolved_by_party = 'owner', resolved_at = now()",
+    ]
+    for assignment in bad_updates:
+        async with pg_pool.acquire() as conn:
+            with pytest.raises(asyncpg.exceptions.CheckViolationError):
+                async with conn.transaction():
+                    await conn.execute(
+                        "SELECT set_config('app.current_tenant_id', $1, true)",
+                        str(env.ctx.tenant_id),
+                    )
+                    await conn.execute(
+                        f"UPDATE memory_map_membership {assignment} WHERE memory_id = $1", n
+                    )
+    assert (await env.membership(n))["status"] == "open"
