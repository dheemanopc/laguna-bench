+                    "INSERT INTO memories (tenant_id, team_id, content, content_hash, embedding, "
+                    "source_kind, type, visibility) VALUES ($1, $2, 'private', $3, "
+                    "array_fill(0::real, ARRAY[1024])::vector, 'api', 'note', 'team') "
+                    "RETURNING id",
+                    other["tenant"],
+                    other["team"],
+                    f"hash-{uuid4().hex}",
+                )
+    try:
+        with pytest.raises(JsonRpcError) as exc:
+            await env.resolve(n, resolved_by_memory_id=resolver)
+        assert exc.value.code == -32602
+        assert _code(exc) == "memory_not_accessible"
+        assert (await env.membership(n))["status"] == "open"
+    finally:
+        if other is not None:
+            await _cleanup(pg_pool, other["tenant"], other["team"], other["client_id"])
+
+
+async def test_resolver_equal_to_node_refused(env: _Env) -> None:
+    n = await env.node()
+    with pytest.raises(JsonRpcError) as exc:
+        await env.resolve(n, resolved_by_memory_id=n)
+    assert exc.value.code == -32602
+    assert _path(exc) == "resolved_by_memory_id"
+    assert (await env.membership(n))["status"] == "open"
+
+
+async def test_link_edge_alone_does_not_settle(env: _Env) -> None:
+    challenge = await env.node("c", node_role="challenge", responsible_party="owner")
+    answer = await env.node("a")
+    await MindmapLinkTool()(
+        env.ctx,
+        MindmapLinkInput(
+            source_memory_id=answer,
+            target_memory_id=challenge,
+            reference_kind="resolves-under",
+            map_key=env.map_key,
+        ),
+    )
+    got = await env.get()
+    assert challenge in [n.memory_id for n in got.nodes]
+    assert challenge in got.open_loops
+    assert (await env.membership(challenge))["status"] == "open"
+    assert got.resolved == []
