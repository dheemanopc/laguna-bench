+"""mindmap branch status — per-node settled state on map membership.
+
+Until now only `mindmap_close` could settle anything, and it settles the whole
+map. A long-lived map therefore only ever grew its open-loop set: there was no
+way to say "this branch is done" without archiving everything. The status is
+stored per map member, on `memory_map_membership` (a node's status is a fact
+about its place in a map, not about the memory itself):
+
+- `status`                : open | resolved | dropped (default open — every
+                            existing row stays open).
+- `resolution_summary`    : 1..500 chars, why the branch was settled.
+- `resolved_by_memory_id` : optional node that carries the resolution; SET NULL
+                            if that memory is deleted (the summary survives).
+- `resolved_by_party`     : owner | model, who settled it.
+- `resolved_at`           : when.
+
+A consistency CHECK makes the half-settled states unrepresentable: an open row
+carries no resolution data; a settled row always has summary, party and time.
+
+Status is the ONLY source of truth for "settled". It is never inferred from
+`memory_references.reference_kind` (a `resolves-under` edge drawn with
+`mindmap_link` is just an edge).
+
+Also adds an index on `memory_map_events(root_memory_id, id)` so cursor reads
+("events after id N for this map") are an index range scan.
+
+Revision ID: 0044_mindmap_branch_status
+Revises: 0043_backfill_personal_teams
+Create Date: 2026-10-15
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0044_mindmap_branch_status"
+down_revision = "0043_backfill_personal_teams"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+            ADD COLUMN status TEXT NOT NULL DEFAULT 'open',
+            ADD COLUMN resolution_summary TEXT NULL,
+            ADD COLUMN resolved_by_memory_id UUID NULL REFERENCES memories(id) ON DELETE SET NULL,
+            ADD COLUMN resolved_by_party TEXT NULL,
+            ADD COLUMN resolved_at TIMESTAMPTZ NULL
+    """)
+    )
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+            ADD CONSTRAINT memory_map_membership_status_check
+                CHECK (status IN ('open','resolved','dropped')),
+            ADD CONSTRAINT memory_map_membership_resolution_summary_len_check
+                CHECK (resolution_summary IS NULL
+                       OR char_length(resolution_summary) BETWEEN 1 AND 500),
+            ADD CONSTRAINT memory_map_membership_resolved_by_party_check
+                CHECK (resolved_by_party IS NULL OR resolved_by_party IN ('owner','model')),
+            ADD CONSTRAINT memory_map_membership_status_consistency_check
+                CHECK (
+                    (status = 'open'
+                        AND resolution_summary IS NULL
+                        AND resolved_by_party IS NULL
+                        AND resolved_at IS NULL
+                        AND resolved_by_memory_id IS NULL)
+                    OR
+                    (status <> 'open'
+                        AND resolution_summary IS NOT NULL
+                        AND resolved_by_party IS NOT NULL
+                        AND resolved_at IS NOT NULL)
+                )
+    """)
+    )
+    op.execute(
+        sa.text(
+            "CREATE INDEX memory_map_events_root_id_idx "
+            "ON memory_map_events(root_memory_id, id)"
+        )
+    )
+
+
+def downgrade() -> None:
+    op.execute(sa.text("DROP INDEX IF EXISTS memory_map_events_root_id_idx"))
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+            DROP CONSTRAINT IF EXISTS memory_map_membership_status_consistency_check,
+            DROP CONSTRAINT IF EXISTS memory_map_membership_resolved_by_party_check,
+            DROP CONSTRAINT IF EXISTS memory_map_membership_resolution_summary_len_check,
+            DROP CONSTRAINT IF EXISTS memory_map_membership_status_check
+    """)
+    )
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+            DROP COLUMN IF EXISTS resolved_at,
+            DROP COLUMN IF EXISTS resolved_by_party,
+            DROP COLUMN IF EXISTS resolved_by_memory_id,
+            DROP COLUMN IF EXISTS resolution_summary,
+            DROP COLUMN IF EXISTS status
+    """)
+    )
