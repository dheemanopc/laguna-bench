+async def test_open_loops_follow_status_and_responsible_party(env: _Env) -> None:
+    owner_n = await env.node("o", responsible_party="owner")
+    model_n = await env.node("m", responsible_party="model")
+    none_n = await env.node("n")
+    settled = await env.node("s", responsible_party="owner")
+    await env.resolve(settled)
+
+    loops = (await env.get()).open_loops
+    assert owner_n in loops
+    assert model_n in loops
+    assert none_n not in loops
+    assert settled not in loops
+
