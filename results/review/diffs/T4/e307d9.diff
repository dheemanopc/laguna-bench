+async def test_get_default_include_and_depth(env: _Env) -> None:
+    long_text = "L" * 450
+    long_n = await env.node(long_text)
+    done = await env.node("settled one")
+    await env.resolve(done, resolution_summary="all good", resolved_by_party="owner")
+
+    got = await env.get()
+    by_id = {n.memory_id: n for n in got.nodes}
+    assert done not in by_id
+    assert [r.memory_id for r in got.resolved] == [done]
+    r = got.resolved[0]
+    assert (r.status, r.resolution_summary, r.resolved_by_party) == (
+        "resolved",
+        "all good",
+        "owner",
+    )
+    assert all(n.status == "open" for n in got.nodes)
+    ln = by_id[long_n]
+    assert ln.truncated is True
+    assert ln.content == "L" * 200 + "…"
+
+    full = await env.get(depth="full")
+    fn = {n.memory_id: n for n in full.nodes}[long_n]
+    assert fn.content == long_text
+    assert fn.truncated is False
+
+    everything = await env.get(include="all")
+    all_by_id = {n.memory_id: n for n in everything.nodes}
+    assert all_by_id[done].status == "resolved"
+    assert everything.resolved == []
+    assert all(n.status in ("open", "resolved", "dropped") for n in everything.nodes)
+
+
+async def test_since_cursor_flow(env: _Env) -> None:
+    a = await env.node("first")
+    base = await env.get()
+    c = base.cursor
+    assert c > 0
+
+    idle = await env.get(since=c)
+    assert idle.nodes == []
+    assert idle.resolved == []
+    assert idle.edges == []
+    assert idle.cursor == c
+
+    b = await env.node("second")
+    after_write = await env.get(since=c)
+    assert after_write.cursor > c
+    assert [n.memory_id for n in after_write.nodes] == [b]
+
+    c2 = after_write.cursor
+    res = await env.resolve(a, resolution_summary="done")
+    assert res.cursor > c2
+    after_resolve = await env.get(since=c2)
+    assert after_resolve.cursor == res.cursor
+    assert after_resolve.nodes == []
+    assert [r.memory_id for r in after_resolve.resolved] == [a]
+    # open_loops is the resume surface: not limited by since.
+    assert isinstance(after_resolve.open_loops, list)
+
