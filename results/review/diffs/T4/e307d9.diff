diff --git a/src/mem_mcp/mcp/tools/mindmap_resolve.py b/src/mem_mcp/mcp/tools/mindmap_resolve.py
new file mode 100644
index 0000000..050a393
--- /dev/null
+++ b/src/mem_mcp/mcp/tools/mindmap_resolve.py
@@ -0,0 +1,190 @@
+"""mindmap_resolve — settle one branch of a live map (resolved or dropped).
+
+Before this tool only mindmap_close could settle anything, and it settles the
+whole map, so open loops only ever grew. Status is stored on the node's map
+membership row and is the ONLY source of truth for "settled": a `resolves-under`
+edge drawn with mindmap_link does not settle a node. When a resolving node is
+given, the matching edge is recorded as a side effect, in the same transaction.
+
+Settling is one-way and map-local: the node must be a member of THIS map, the
+map must be live, and the root cannot be resolved (that is mindmap_close).
+
+Check order matters: map and node are validated BEFORE the resolver's access
+check, so a stray resolver id can never hide a "wrong map / not a member /
+already settled" error.
+"""
+
+from __future__ import annotations
+
+from typing import Any, ClassVar, Literal
+from uuid import UUID
+
+from pydantic import BaseModel, ConfigDict, Field
+
+from mem_mcp.db import system_tx, tenant_tx
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tool_descriptions import TOOL_DESCRIPTIONS
+from mem_mcp.mcp.tools._base import BaseTool, ToolContext
+from mem_mcp.mcp.tools._mindmap_common import resolve_team_id
+from mem_mcp.mindmap import service
+from mem_mcp.teams.references import (
+    ReferenceTargetNotFoundError,
+    insert_reference,
+    resolve_reference_target,
+)
+
+_EDGE_KIND = {"resolved": "resolves-under", "dropped": "dropped-under"}
+_EVENT = {"resolved": "resolve", "dropped": "drop"}
+
+
+class MindmapResolveInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    map_key: str = Field(..., min_length=1, max_length=64)
+    node_id: UUID = Field(..., description="The branch node to settle.")
+    disposition: Literal["resolved", "dropped"] = "resolved"
+    resolution_summary: str = Field(..., min_length=1, max_length=500)
+    resolved_by_memory_id: UUID | None = Field(
+        default=None, description="Optional node that carries the resolution (drawn as an edge)."
+    )
+    resolved_by_party: Literal["owner", "model"] = "model"
+    team_id: UUID | None = None
+
+
+class MindmapResolveOutput(BaseModel):
+    node_id: UUID
+    status: str
+    resolution_summary: str
+    cursor: int
+    request_id: str
+
+
+def _bad_node(message: str) -> JsonRpcError:
+    return JsonRpcError(-32602, message, data={"errors": [{"path": "node_id", "message": message}]})
+
+
+def _not_open() -> JsonRpcError:
+    return JsonRpcError(-32602, "node is already settled", data={"code": "node_not_open"})
+
+
+async def _check_settleable(
+    conn: Any, ctx: ToolContext, inp: MindmapResolveInput
+) -> tuple[UUID, dict[str, Any]]:
+    """team → map → live → member of THIS map → not root → open. Returns (root_id, member)."""
+    team_id = await resolve_team_id(conn, ctx, inp.team_id)
+    root_id = await service.resolve_map_root(conn, team_id=team_id, map_key=inp.map_key)
+    row = None
+    if root_id is not None:
+        row = await service.get_map_row(conn, root_memory_id=root_id)
+    if root_id is None or row is None:
+        raise JsonRpcError(-32602, "map not found", data={"errors": [{"path": "map_key"}]})
+    if row["state"] != "live":
+        raise JsonRpcError(
+            -32602,
+            "map is archived; closed maps are immutable (no-reopen)",
+            data={"code": "map_not_live"},
+        )
+    member = await service.fetch_member(
+        conn, root_memory_id=root_id, memory_id=inp.node_id, tenant_id=ctx.tenant_id
+    )
+    if member is None:
+        raise _bad_node("not a member of this map")
+    if member["node_role"] == "root":
+        raise _bad_node("the root cannot be resolved; use mindmap_close to settle the map")
+    if member["status"] != "open":
+        raise _not_open()
+    return root_id, member
+
+
+class MindmapResolveTool(BaseTool):
+    name: ClassVar[str] = "mindmap_resolve"
+    description: ClassVar[str] = TOOL_DESCRIPTIONS["mindmap_resolve"]
+    required_scope: ClassVar[str] = "memory.write"
+    InputModel: ClassVar[type[BaseModel]] = MindmapResolveInput
+    OutputModel: ClassVar[type[BaseModel]] = MindmapResolveOutput
+
+    async def __call__(self, ctx: ToolContext, inp: BaseModel) -> BaseModel:
+        assert isinstance(inp, MindmapResolveInput)
+        resolver_id = inp.resolved_by_memory_id
+
+        # (a) Validate map + node first (read tx).
+        async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+            await _check_settleable(conn, ctx, inp)
+
+        # (b) Resolver checks: self-reference, then the opaque access check (as mindmap_link).
+        if resolver_id is not None:
+            if resolver_id == inp.node_id:
+                raise JsonRpcError(
+                    -32602,
+                    "a node cannot resolve itself",
+                    data={
+                        "errors": [
+                            {
+                                "path": "resolved_by_memory_id",
+                                "message": "must differ from node_id",
+                            }
+                        ]
+                    },
+                )
+            async with system_tx(ctx.db_pool) as sys_conn:
+                try:
+                    await resolve_reference_target(
+                        sys_conn, target_uuid=resolver_id, caller_user_id=ctx.tenant_id
+                    )
+                except ReferenceTargetNotFoundError as exc:
+                    raise JsonRpcError(
+                        -32602,
+                        "reference target not found or not accessible",
+                        data={"code": "memory_not_accessible"},
+                    ) from exc
+
+        # (c) One write tx: re-check (state may have changed since (a)), then the
+        # conditional UPDATE row-locks so concurrent resolves cannot both win.
+        async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+            root_id, member = await _check_settleable(conn, ctx, inp)
+            try:
+                await service.settle_member(
+                    conn,
+                    root_memory_id=root_id,
+                    memory_id=inp.node_id,
+                    tenant_id=ctx.tenant_id,
+                    status=inp.disposition,
+                    resolution_summary=inp.resolution_summary,
+                    resolved_by_memory_id=resolver_id,
+                    resolved_by_party=inp.resolved_by_party,
+                )
+            except service.NodeNotOpenError as exc:
+                raise _not_open() from exc
+
+            edge_kind: str | None = None
+            if resolver_id is not None:
+                edge_kind = _EDGE_KIND[inp.disposition]
+                await insert_reference(
+                    conn,
+                    source_memory_id=resolver_id,
+                    target_memory_id=inp.node_id,
+                    target_team_id=member["team_id"],
+                    reference_kind=edge_kind,
+                )
+
+            cursor = await service.log_event(
+                conn,
+                root_memory_id=root_id,
+                tenant_id=ctx.tenant_id,
+                event=_EVENT[inp.disposition],
+                actor=inp.resolved_by_party,
+                memory_id=inp.node_id,
+                payload={
+                    "disposition": inp.disposition,
+                    "resolved_by_memory_id": str(resolver_id) if resolver_id else None,
+                    "reference_kind": edge_kind,
+                },
+            )
+
+        return MindmapResolveOutput(
+            node_id=inp.node_id,
+            status=inp.disposition,
+            resolution_summary=inp.resolution_summary,
+            cursor=cursor,
+            request_id=ctx.request_id,
+        )
