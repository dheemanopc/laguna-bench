+async def env(pg_pool: Any) -> AsyncIterator[_Env]:
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            s = await _setup(conn)
+    ctx = _ctx(pg_pool, s["tenant"], s["client_id"])
+    opened: Any = await MindmapOpenTool()(
+        ctx,
+        MindmapOpenInput(title=f"resolve-{uuid4().hex[:6]}", root_question="What do we settle?"),
+    )
+    try:
+        yield _Env(pg_pool, ctx, opened.map_key, opened.root_memory_id)
+    finally:
+        await _cleanup(pg_pool, s["tenant"], s["team"], s["client_id"])
+
+
+def _code(exc: pytest.ExceptionInfo[JsonRpcError]) -> Any:
+    return (exc.value.data or {}).get("code")
+
+
+def _path(exc: pytest.ExceptionInfo[JsonRpcError]) -> Any:
+    """`path` of the first entry in data["errors"]."""
+    return (exc.value.data or {})["errors"][0]["path"]
+
