+async def test_resolve_with_resolving_node(env: _Env) -> None:
+    challenge = await env.node("challenge", node_role="challenge")
+    answer = await env.node("answer")
+    before = (await env.get()).cursor
+
+    out = await env.resolve(
+        challenge,
+        resolution_summary="answered by the position",
+        resolved_by_memory_id=answer,
+        resolved_by_party="owner",
+    )
+    assert out.status == "resolved"
+    assert out.cursor > before
+
+    m = await env.membership(challenge)
+    assert m["status"] == "resolved"
+    assert m["resolution_summary"] == "answered by the position"
+    assert m["resolved_by_memory_id"] == answer
+    assert m["resolved_by_party"] == "owner"
+    assert m["resolved_at"] is not None
+
+    refs = await env.row(
+        "SELECT count(*) AS n, min(reference_kind) AS kind FROM memory_references "
+        "WHERE source_memory_id = $1 AND target_memory_id = $2",
+        answer,
+        challenge,
+    )
+    assert refs["n"] == 1
+    assert refs["kind"] == "resolves-under"
+
+    ev = await env.row(
+        "SELECT id, actor, payload FROM memory_map_events "
+        "WHERE root_memory_id = $1 AND memory_id = $2 AND event = 'resolve'",
+        env.root,
+        challenge,
+    )
+    assert ev["id"] == out.cursor
+    assert ev["actor"] == "owner"
+
