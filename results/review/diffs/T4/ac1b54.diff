+            resolved_at = CASE WHEN $1 = 'open' THEN NULL ELSE now() END
+        WHERE memory_id = $5
+          AND root_memory_id = $6
+          AND tenant_id = $7
+        RETURNING *
+        """,
+        status,
+        resolution_summary,
+        resolved_by_memory_id,
