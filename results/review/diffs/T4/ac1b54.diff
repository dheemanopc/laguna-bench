diff --git a/src/mem_mcp/mcp/tools/mindmap_resolve.py b/src/mem_mcp/mcp/tools/mindmap_resolve.py
new file mode 100644
index 0000000..1858e38
--- /dev/null
+++ b/src/mem_mcp/mcp/tools/mindmap_resolve.py
@@ -0,0 +1,177 @@
+"""mindmap_resolve — settle a branch as resolved or dropped.
+
+Settlement is atomic: status row + reference edge (if resolver given) + event.
+Per-branch status is stored (not inferred from edges) because status is a
+structural fact: which nodes are settled is the resume surface, independent of
+the reasoning graph. Reopening/re-settling overwrites its disposition.
+"""
+
+from __future__ import annotations
+
+from typing import ClassVar, Literal
+from uuid import UUID
+
+from pydantic import BaseModel, ConfigDict, Field, field_validator
+
+from mem_mcp.db import tenant_tx
+from mem_mcp.mcp.errors import JsonRpcError
+from mem_mcp.mcp.tool_descriptions import TOOL_DESCRIPTIONS
+from mem_mcp.mcp.tools._base import BaseTool, ToolContext
+from mem_mcp.mcp.tools._mindmap_common import resolve_team_id
+from mem_mcp.mindmap import service
+from mem_mcp.teams.references import insert_reference
+
+
+class MindmapResolveInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    map_key: str = Field(..., min_length=1, max_length=64)
+    node_id: UUID
+    disposition: Literal["resolved", "dropped"] = "resolved"
+    resolution_summary: str = Field(..., min_length=1, max_length=500)
+    resolved_by_memory_id: UUID | None = None
+    resolved_by_party: Literal["owner", "model"] = "model"
+    team_id: UUID | None = None
+
+    @field_validator("resolution_summary")
+    @classmethod
+    def validate_resolution_summary(cls, v: str) -> str:
+        if not v or not v.strip():
+            raise ValueError("resolution_summary cannot be empty or whitespace-only")
+        return v
+
+
+class MindmapResolveOutput(BaseModel):
+    node_id: UUID
+    status: str
+    resolution_summary: str
+    cursor: int
+    request_id: str
+
+
+class MindmapResolveTool(BaseTool):
+    name: ClassVar[str] = "mindmap_resolve"
+    description: ClassVar[str] = TOOL_DESCRIPTIONS["mindmap_resolve"]
+    required_scope: ClassVar[str] = "memory.write"
+    InputModel: ClassVar[type[BaseModel]] = MindmapResolveInput
+    OutputModel: ClassVar[type[BaseModel]] = MindmapResolveOutput
+
+    async def __call__(self, ctx: ToolContext, inp: BaseModel) -> BaseModel:
+        assert isinstance(inp, MindmapResolveInput)
+
+        # Validate input: node_id differs from resolver
+        resolved_by_memory_id: UUID | None = None
+        reference_kind: str | None = None
+
+        if inp.resolved_by_memory_id is not None:
+            if inp.resolved_by_memory_id == inp.node_id:
+                raise JsonRpcError(
+                    -32602,
+                    "resolved_by_memory_id must differ from node_id",
+                    data={"errors": [{"path": "resolved_by_memory_id"}]},
+                )
+            resolved_by_memory_id = inp.resolved_by_memory_id
+            reference_kind = service.RESOLUTION_REFERENCE_KINDS[inp.disposition]
+
+        async with tenant_tx(ctx.db_pool, ctx.tenant_id) as conn:
+            team_id = await resolve_team_id(conn, ctx, inp.team_id)
+            root_id = await service.resolve_map_root(conn, team_id=team_id, map_key=inp.map_key)
+            if root_id is None:
+                raise JsonRpcError(-32602, "map not found", data={"errors": [{"path": "map_key"}]})
+
+            # Lock map row; check state
+            map_row = await service.lock_map_row(
+                conn, root_memory_id=root_id, tenant_id=ctx.tenant_id
+            )
+            if map_row is None:
+                raise JsonRpcError(-32602, "map not found", data={"errors": [{"path": "map_key"}]})
+            if map_row["state"] != "live":
+                raise JsonRpcError(
+                    -32602,
+                    "map is not live",
+                    data={"code": "map_not_live"},
+                )
+
+            # Lock and check membership (returns team_id of the node)
+            membership = await service.get_membership_for_update(
+                conn,
+                memory_id=inp.node_id,
+                root_memory_id=root_id,
+                tenant_id=ctx.tenant_id,
+            )
+            if membership is None:
+                raise JsonRpcError(
+                    -32602,
+                    "node is not a member of this map",
+                    data={"errors": [{"path": "node_id"}]},
+                )
+
+            # Root cannot be settled
+            if membership["node_role"] == "root":
+                raise JsonRpcError(
+                    -32602,
+                    "root node cannot be settled",
+                    data={"errors": [{"path": "node_id"}]},
+                )
+
+            # Check resolver visibility if given
+            if resolved_by_memory_id is not None:
+                resolver_visible = await service.memory_visible_in_tenant(
+                    conn, memory_id=resolved_by_memory_id, tenant_id=ctx.tenant_id
+                )
+                if not resolver_visible:
+                    raise JsonRpcError(
+                        -32602,
+                        "resolved_by_memory_id not accessible",
+                        data={
