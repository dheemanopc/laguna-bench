+async def touched_member_ids_since(
+    conn: asyncpg.Connection,
+    *,
+    root_memory_id: UUID,
+    tenant_id: UUID,
+    since: int,
+) -> set[UUID]:
+    """Return set of memory ids (members of this map) touched by events with id > since.
+
+    Touches include: event's memory_id (node that had the event), and target memory
+    from link events (payload->>'target' as text, cast to UUID safely). Only members
+    of this map are returned; non-UUID garbage in payload is safely skipped.
+
+    The pool's _init_connection registers a jsonb codec with encoder=json.dumps, so
+    payloads are double-encoded: stored as jsonb string scalars rather than objects.
+    This query normalizes both shapes (string-encoded and object) for compatibility.
+    """
+    rows = await conn.fetch(
+        """
+        WITH payload_normalized AS (
+            SELECT
+                mme.memory_id,
+                CASE
+                    WHEN jsonb_typeof(mme.payload) = 'string'
+                    THEN (mme.payload #>> '{}')::jsonb
+                    ELSE mme.payload
+                END AS payload_obj
+            FROM memory_map_events mme
+            WHERE mme.root_memory_id = $1
+              AND mme.tenant_id = $2
+              AND mme.id > $3
+        )
+        SELECT DISTINCT mm.memory_id
+        FROM payload_normalized pn
+        JOIN memory_map_membership mm ON (
+            mm.root_memory_id = $1
+            AND mm.tenant_id = $2
+            AND (
+                mm.memory_id = pn.memory_id
+                OR mm.memory_id::text = pn.payload_obj->>'target'
+            )
+        )
+        """,
+        root_memory_id,
+        tenant_id,
+        since,
+    )
+    return {r["memory_id"] for r in rows}
