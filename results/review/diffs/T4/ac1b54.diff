+"""Unit tests for mindmap_get input/output shaping: truncation, defaults, validation."""
+
+from __future__ import annotations
+
+from uuid import uuid4
+
+import pytest
+from pydantic import ValidationError
+
+from mem_mcp.mcp.tools.mindmap_get import (
+    SUMMARY_CONTENT_CHARS,
+    MindmapGetInput,
+    MindmapGetTool,
+)
+from mem_mcp.mcp.tools.mindmap_resolve import MindmapResolveInput
+
+
+class TestMindmapGetInputDefaults:
+    """Test input model defaults and validation."""
+
+    def test_defaults(self) -> None:
+        """Input defaults are cheap: since=None, include=open, depth=summary."""
+        inp = MindmapGetInput(map_key="test-map")
+        assert inp.since is None
+        assert inp.include == "open"
+        assert inp.depth == "summary"
+        assert inp.map_key == "test-map"
+
+    def test_since_validation_negative_rejected(self) -> None:
+        """since < 0 rejected."""
+        with pytest.raises(ValueError):
+            MindmapGetInput(map_key="test", since=-1)
+
+    def test_include_validation(self) -> None:
+        """include must be 'open' or 'all'."""
+        valid = MindmapGetInput(map_key="test", include="open")
+        assert valid.include == "open"
+
+        valid = MindmapGetInput(map_key="test", include="all")
+        assert valid.include == "all"
+
+        with pytest.raises(ValueError):
+            MindmapGetInput(map_key="test", include="invalid")  # type: ignore
+
+    def test_depth_validation(self) -> None:
+        """depth must be 'summary' or 'full'."""
+        valid = MindmapGetInput(map_key="test", depth="summary")
+        assert valid.depth == "summary"
+
+        valid = MindmapGetInput(map_key="test", depth="full")
+        assert valid.depth == "full"
+
+        with pytest.raises(ValueError):
+            MindmapGetInput(map_key="test", depth="invalid")  # type: ignore
+
+    def test_map_key_constraints(self) -> None:
+        """map_key must be 1-64 chars."""
+        with pytest.raises(ValueError):
+            MindmapGetInput(map_key="")
+
+        MindmapGetInput(map_key="x")
+        MindmapGetInput(map_key="x" * 64)
+
+        with pytest.raises(ValueError):
+            MindmapGetInput(map_key="x" * 65)
+
+
+class TestContentTruncation:
+    """Test content truncation at 200 chars in summary mode."""
+
+    def test_exactly_200_unchanged(self) -> None:
+        """Content exactly 200 chars is not truncated."""
+        content = "x" * SUMMARY_CONTENT_CHARS
+        truncated = MindmapGetTool._maybe_truncate(content, "summary")
+        assert truncated == content
+        assert len(truncated) == SUMMARY_CONTENT_CHARS
+
+    def test_201_chars_truncated(self) -> None:
+        """Content 201 chars gets truncated to 200 + "…"."""
+        content = "x" * (SUMMARY_CONTENT_CHARS + 1)
+        truncated = MindmapGetTool._maybe_truncate(content, "summary")
+        assert len(truncated) == SUMMARY_CONTENT_CHARS + 1  # 200 + "…"
+        assert truncated.endswith("…")
+        assert truncated[:-1] == "x" * SUMMARY_CONTENT_CHARS
+
+    def test_long_content_truncated(self) -> None:
+        """Long content is truncated with ellipsis."""
+        content = "a" * 500
+        truncated = MindmapGetTool._maybe_truncate(content, "summary")
+        assert truncated == "a" * SUMMARY_CONTENT_CHARS + "…"
+
+    def test_full_depth_never_truncated(self) -> None:
+        """depth='full' never truncates."""
+        content = "x" * 1000
+        truncated = MindmapGetTool._maybe_truncate(content, "full")
+        assert truncated == content
+
+    def test_short_content_unchanged_in_summary(self) -> None:
+        """Short content unchanged in summary mode."""
+        content = "short"
+        truncated = MindmapGetTool._maybe_truncate(content, "summary")
+        assert truncated == content
+        assert "…" not in truncated
+
+
+class TestMindmapResolveInputValidation:
+    """Test MindmapResolveInput validation."""
+
+    def test_resolution_summary_required(self) -> None:
+        """resolution_summary is required."""
+        with pytest.raises(ValidationError):
+            MindmapResolveInput(
+                map_key="test",
+                node_id=uuid4(),
+                # resolution_summary missing
+            )  # type: ignore
+
+    def test_empty_summary_rejected(self) -> None:
