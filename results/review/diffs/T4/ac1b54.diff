+async def env(pg_pool: Any) -> MindmapTestEnv:  # type: ignore
+    """Create test environment with cleanup."""
+    async with pg_pool.acquire() as conn:
+        async with conn.transaction():
+            setup = await _setup(conn)
+
+    tenant = setup["tenant"]
+    team = setup["team"]
+    client_id = setup["client_id"]
+
+    ctx = ToolContext(
+        request_id=str(uuid4()),
+        tenant_id=tenant,
+        identity_id=tenant,
+        client_id=client_id,
+        scopes=frozenset(["memory.read", "memory.write"]),
+        db_pool=pg_pool,
+        deps=_build_deps(),
+    )
+
+    yield MindmapTestEnv(ctx=ctx, tenant=tenant, team=team)
+
+    await _cleanup(pg_pool, tenant, team, client_id)
