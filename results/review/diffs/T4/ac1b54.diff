+"""Per-branch settlement status — mindmap_resolve stores node disposition.
+
+Design decision: Each node's status in a map (open/resolved/dropped) is a
+structural fact, not inferred from edges. Settlement is atomic: status row,
+resolves-under/dropped-under reference, and observability event all commit
+or none. When settled, resolution_summary + resolved_by_party + resolved_at
+are NOT NULL; consistency enforced by CHECK constraint.
+
+Supports cheap cursor reads (since=last_cursor) by adding an index on
+memory_map_events (root_memory_id, id).
+
+Revision ID: 0044_mindmap_branch_status
+Revises: 0043_backfill_personal_teams
+Create Date: 2026-10-15
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "0044_mindmap_branch_status"
+down_revision = "0043_backfill_personal_teams"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    # Add per-branch status columns to memory_map_membership.
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+        ADD COLUMN status TEXT NOT NULL DEFAULT 'open'
+            CHECK (status IN ('open','resolved','dropped')),
+        ADD COLUMN resolution_summary TEXT
+            CHECK (
+                resolution_summary IS NULL OR
+                char_length(resolution_summary) BETWEEN 1 AND 500
+            ),
+        ADD COLUMN resolved_by_memory_id UUID
+            REFERENCES memories(id) ON DELETE SET NULL,
+        ADD COLUMN resolved_by_party TEXT
+            CHECK (resolved_by_party IN ('owner','model')),
+        ADD COLUMN resolved_at TIMESTAMPTZ,
+        ADD CONSTRAINT resolution_consistency
+            CHECK (
+                (status = 'open' AND
+                 resolution_summary IS NULL AND
+                 resolved_by_party IS NULL AND
+                 resolved_at IS NULL) OR
+                (status IN ('resolved','dropped') AND
+                 resolution_summary IS NOT NULL AND
+                 resolved_by_party IS NOT NULL AND
+                 resolved_at IS NOT NULL)
+            )
+    """)
+    )
+
+    # Index for cheap cursor reads: find members touched since event_id X.
+    op.execute(
+        sa.text(
+            "CREATE INDEX memory_map_events_root_id_idx " "ON memory_map_events(root_memory_id, id)"
+        )
+    )
+
+
+def downgrade() -> None:
+    op.execute(sa.text("DROP INDEX IF EXISTS memory_map_events_root_id_idx"))
+    op.execute(
+        sa.text("""
+        ALTER TABLE memory_map_membership
+        DROP CONSTRAINT IF EXISTS resolution_consistency,
+        DROP COLUMN IF EXISTS status,
+        DROP COLUMN IF EXISTS resolution_summary,
+        DROP COLUMN IF EXISTS resolved_by_memory_id,
+        DROP COLUMN IF EXISTS resolved_by_party,
+        DROP COLUMN IF EXISTS resolved_at
+    """)
+    )
